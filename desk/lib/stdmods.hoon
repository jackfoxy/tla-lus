  %-  malt
  ^-  (list [@t @t])
  :~
  :-  'Bags'
  '----------------------------- MODULE Bags --------------------------------\0a(**************************************************************************)\0a(* A bag, also called a multiset, is a set that can contain multiple      *)\0a(* copies of the same element.  A bag can have infinitely many elements,  *)\0a(* but only finitely many copies of any single element.                   *)\0a(*                                                                        *)\0a(* We represent a bag in the usual way as a function whose range is a     *)\0a(* subset of the positive integers.  An element e belongs to bag B iff e  *)\0a(* is in the domain of B, in which case bag B contains B[e] copies of e.  *)\0a(**************************************************************************)\0a(**************************************************************************)\0a(* All these definitions other than SubBag are overridden by TLC in the   *)\0a(* Java class tlc2.module.Bags. Each operator is overridden by the Java   *)\0a(* method with the same name, except that the mapping for TLA+ infix      *)\0a(* operators is defined in the static block at the beginning of the Java  *)\0a(* class.                                                                 *)\0a(**************************************************************************)\0aEXTENDS TLC\0aLOCAL INSTANCE Naturals\0a\0aIsABag(B) == \0a  (************************************************************************)\0a  (* True iff B is a bag.                                                 *)\0a  (************************************************************************)\0a  B \\in [DOMAIN B -> {n \\in Nat : n > 0}]\0a\0aBagToSet(B) == DOMAIN B\0a  (************************************************************************)\0a  (* The set of elements at least one copy of which is in B.              *)\0a  (************************************************************************)\0a\0aSetToBag(S) == [e \\in S |-> 1]\0a  (************************************************************************)\0a  (* The bag that contains one copy of every element of the set S.        *)\0a  (************************************************************************)\0a  \0aBagIn(e,B) == e \\in BagToSet(B)\0a  (************************************************************************)\0a  (* The \\in operator for bags.                                           *)\0a  (************************************************************************)\0a\0aEmptyBag == SetToBag({})\0a\0aB1 (+) B2  ==\0a  (************************************************************************)\0a  (* The union of bags B1 and B2.                                         *)\0a  (************************************************************************)\0a  [e \\in (DOMAIN B1) \\cup (DOMAIN B2) |->\0a      (IF e \\in DOMAIN B1 THEN B1[e] ELSE 0) \0a    + (IF e \\in DOMAIN B2 THEN B2[e] ELSE 0) ]\0a  \0aB1 (-) B2  ==\0a  (************************************************************************)\0a  (* The bag B1 with the elements of B2 removed--that is, with one copy   *)\0a  (* of an element removed from B1 for each copy of the same element in   *)\0a  (* B2.  If B2 has at least as many copies of e as B1, then B1 (-) B2    *)\0a  (* has no copies of e.                                                  *)\0a  (************************************************************************)\0a  LET B == [e \\in DOMAIN B1 |-> IF e \\in DOMAIN B2 THEN B1[e] - B2[e]\0a                                                   ELSE B1[e]]\0a  IN  [e \\in {d \\in DOMAIN B : B[d] > 0} |-> B[e]]\0a\0aLOCAL Sum(f) ==\0a        (******************************************************************)\0a        (* The sum of f[x] for all x in DOMAIN f.  The definition assumes *)\0a        (* that f is a Nat-valued function and that f[x] equals 0 for all *)\0a        (* but a finite number of elements x in DOMAIN f.                 *)\0a        (******************************************************************)\0a        LET DSum[S \\in SUBSET DOMAIN f] ==\0a               LET elt == CHOOSE e \\in S : TRUE\0a               IN  IF S = {} THEN 0\0a                             ELSE f[elt] + DSum[S \\ {elt}]\0a        IN  DSum[DOMAIN f]\0a\0aBagUnion(S) ==\0a  (************************************************************************)\0a  (* The bag union of all elements of the set S of bags.                  *)\0a  (************************************************************************)\0a  [e \\in UNION {BagToSet(B) : B \\in S} |->\0a    Sum( [B \\in S |-> IF BagIn(e, B) THEN B[e] ELSE 0] ) ]\0a\0aB1 \\sqsubseteq B2  ==\0a  (************************************************************************)\0a  (* The subset operator for bags.  B1 \\sqsubseteq B2 iff, for all e, bag *)\0a  (* B2 has at least as many copies of e as bag B1 does.                  *)\0a  (************************************************************************)\0a  /\\ (DOMAIN B1) \\subseteq (DOMAIN B2)\0a  /\\ \\A e \\in DOMAIN B1 : B1[e] \\leq B2[e]\0a\0aSubBag(B) ==\0a  (************************************************************************)\0a  (* The set of all subbags of bag B.                                     *)\0a  (*                                                                      *)\0a  (* The following definition is not the one described in the TLA+ book,  *)\0a  (* but rather one that TLC can evaluate.                                *)\0a  (************************************************************************)\0a\0a  LET RemoveFromDom(x, f) == [y \\in (DOMAIN f) \\ {x} |-> f[y]]\0a      Combine(x, BagSet) == \0a         BagSet \\cup\0a          {[y \\in (DOMAIN f) \\cup {x} |-> IF y = x THEN i ELSE f[y]] :\0a                f \\in BagSet, i \\in 1..B[x]}\0a      Biggest == LET Range == {B[x] : x \\in DOMAIN B}\0a                 IN  IF Range = {} THEN 0\0a                                   ELSE CHOOSE r \\in Range :\0a                                           \\A s \\in Range : r \\geq s\0a      RSB[BB \\in UNION {[S -> 1..Biggest] : S \\in SUBSET DOMAIN B}] ==\0a        IF BB = << >> THEN {<< >>}\0a                      ELSE LET x == CHOOSE x \\in DOMAIN BB : TRUE\0a                           IN  Combine(x, RSB[RemoveFromDom(x, BB)])\0a  IN RSB[B]\0a\0a  (*******************  Here is the definition from the TLA+ book. ********\0a  LET AllBagsOfSubset == \0a        (******************************************************************)\0a        (* The set of all bags SB such that BagToSet(SB) \\subseteq        *)\0a        (* BagToSet(B).                                                   *)\0a        (******************************************************************)\0a        UNION {[SB -> {n \\in Nat : n > 0}] : SB \\in SUBSET BagToSet(B)}  \0a  IN  {SB \\in AllBagsOfSubset : \\A e \\in DOMAIN SB : SB[e] \\leq B[e]}\0a  ***************************************************************************)\0a\0aBagOfAll(F(_), B) ==\0a  (************************************************************************)\0a  (* The bag analog of the set {F(x) : x \\in B} for a set B. It\'s the bag *)\0a  (* that contains, for each element e of B, one copy of F(e) for every   *)\0a  (* copy of e in B. This defines a bag iff, for any value v, the set of  *)\0a  (* e in B such that F(e) = v is finite.                                 *)\0a  (************************************************************************)\0a  [e \\in {F(d) : d \\in BagToSet(B)} |-> \0a     Sum( [d \\in BagToSet(B) |-> IF F(d) = e THEN B[d] ELSE 0] ) ]\0a\0aBagCardinality(B) ==\0a  (************************************************************************)\0a  (* If B is a finite bag (one such that BagToSet(B) is a finite set),    *)\0a  (* then this is its cardinality (the total number of copies of elements *)\0a  (* in B).  Its value is unspecified if B is infinite.                   *)\0a  (************************************************************************)\0a  Sum(B)\0a\0aCopiesIn(e, B) ==\0a  (************************************************************************)\0a  (* If B is a bag, then CopiesIn(e, B) is the number of copies of e in   *)\0a  (* B. If ~BagIn(e, B), then CopiesIn(e, B) = 0.                         *)\0a  (************************************************************************)\0a  IF BagIn(e, B) THEN B[e] ELSE 0\0a=============================================================================\0a\0a(* Last modified on Fri 26 Jan 2007 at  8:45:03 PST by lamport *)\0a\0a 6 Apr 99 : Modified version for standard module set\0a 7 Dec 98 : Corrected error found by Stephan Merz.\0a 6 Dec 98 : Modified comments based on suggestions by Lyle Ramshaw.\0a 5 Dec 98 : Initial version.\0a'
  :-  'FiniteSets'
  '---------------------------- MODULE FiniteSets -----------------------------\0a(***************************************************************************)\0a(* The two definitions in this standard module are overridden by TLC in    *)\0a(* the Java class tlc2.module.FiniteSets.  Each operator is overridden by  *)\0a(* the Java method with the same name.                                     *)\0a(***************************************************************************)\0aLOCAL INSTANCE Naturals\0aLOCAL INSTANCE Sequences\0a  (*************************************************************************)\0a  (* Imports the definitions from Naturals and Sequences, but doesn\'t      *)\0a  (* export them.                                                          *)\0a  (*************************************************************************)\0a\0aIsFiniteSet(S) == \0a  (*************************************************************************)\0a  (* A set S is finite iff there is a finite sequence containing all its   *)\0a  (* elements.                                                             *)\0a  (*************************************************************************)\0a  \\E seq \\in Seq(S) : \\A s \\in S : \\E n \\in 1..Len(seq) : seq[n] = s\0a\0aCardinality(S) ==\0a  (*************************************************************************)\0a  (* Cardinality is defined only for finite sets.                          *)\0a  (*************************************************************************)\0a  LET CS[T \\in SUBSET S] == IF T = {} THEN 0\0a                                      ELSE 1 + CS[T \\ {CHOOSE x : x \\in T}]\0a  IN  CS[S]\0a=============================================================================\0a'
  :-  'Integers'
  '-------------------------------- MODULE Integers ----------------------------\0a(***************************************************************************)\0a(* This module provides dummy definitions of the operators that are        *)\0a(* defined by the real Integers module.  It is expected that any tool will *)\0a(* provide its own implementations of these operators.  See the book       *)\0a(* "Specifying Systems" for the real Integers module.                      *)\0a(***************************************************************************)\0a(***************************************************************************)\0a(* The two definitions here and the definitions imported from the Naturals *)\0a(* module are overridden by TLC in the Java class tlc2.module.Integers.    *)\0a(* Each operator is overridden by the Java method with the same name,      *)\0a(* except that the mappings for the prefix - operator and the TLA+ infix   *)\0a(* operators are defined in the static block at the beginning of the Java  *)\0a(* class.                                                                  *)\0a(***************************************************************************)\0aEXTENDS Naturals\0a\0aInt  ==  { }\0a(***************************************************************************)\0a(* This defines the prefix - operator.                                     *)\0a(***************************************************************************)\0a-. a == 0 - a\0a=============================================================================\0a'
  :-  'Json'
  '-------------------------------- MODULE Json --------------------------------\0a\0aLOCAL INSTANCE Sequences\0aLOCAL INSTANCE FiniteSets\0aLOCAL INSTANCE TLC\0a  (*************************************************************************)\0a  (* Imports the definitions from the modules, but doesn\'t export them.    *)\0a  (*************************************************************************)\0a\0a-----------------------------------------------------------------------------\0a\0aLOCAL IsSequence(F, D) == TRUE \\/ FALSE\0a\0aLOCAL ToJsonKeyValue(F, d) ==\0a  ToString(ToString(d)) \\o ":" \\o ToString(F[d])\0a\0aRECURSIVE ToJsonObjectString(_,_)\0aLOCAL ToJsonObjectString(F, D) == \\* LOCAL just a hint for humans.\0a  LET d == CHOOSE d \\in D: TRUE\0a  IN IF D = DOMAIN F\0a     THEN "{" \\o ToJsonKeyValue(F, d) \\o IF D \\ {d} = {}\0a                                         THEN "}"\0a                                         ELSE ToJsonObjectString(F, D \\ {d})\0a     ELSE ", " \\o ToJsonKeyValue(F, d) \\o IF D \\ {d} = {}\0a                                          THEN "}"\0a                                          ELSE ToJsonObjectString(F, D \\ {d})\0a\0aRECURSIVE ToJsonArrayString(_,_)\0aLOCAL ToJsonArrayString(F, D) == \\* LOCAL just a hint for humans.\0a  LET d == CHOOSE d \\in D: TRUE\0a  IN IF D = DOMAIN F\0a     THEN "[" \\o ToString(F[d]) \\o IF D \\ {d} = {}\0a                                   THEN "]"\0a                                   ELSE ToJsonArrayString(F, D \\ {d})\0a     ELSE ", " \\o ToString(F[d]) \\o IF D \\ {d} = {}\0a                                    THEN "]"\0a                                    ELSE ToJsonArrayString(F, D \\ {d})\0a\0aRECURSIVE ToJsonString(_,_)\0aLOCAL ToJsonString(F, D) == \\* LOCAL just a hint for humans.\0a  IF IsFiniteSet(F) \\/ IsSequence(F, D) THEN\0a    ToJsonArrayString(F, D)\0a  ELSE\0a    ToJsonObjectString(F, D)\0a\0aToJson(value) ==\0a  (*************************************************************************)\0a  (* Converts the given value to a JSON string. Records are converted to   *)\0a  (* JSON objects, tuples to JSON arrays, and scalar values as their JSON  *)\0a  (* representation.                                                       *)\0a  (*************************************************************************)\0a  IF DOMAIN value = {} THEN\0a    "{}"\0a  ELSE\0a    ToJsonString(value, DOMAIN value)\0a\0aToJsonArray(value) ==\0a  (*************************************************************************)\0a  (* Converts the given tuple value to a JSON array.                       *)\0a  (*************************************************************************)\0a  IF DOMAIN value = {} THEN\0a    "[]"\0a  ELSE\0a    ToJsonArrayString(value, DOMAIN value)\0a\0aToJsonObject(value) ==\0a  (*************************************************************************)\0a  (* Converts the given tuple value to a JSON object.                      *)\0a  (*************************************************************************)\0a  IF DOMAIN value = {} THEN\0a    "{}"\0a  ELSE\0a    ToJsonObjectString(value, DOMAIN value)\0a\0aJsonSerialize(absoluteFilename, value) ==\0a  (*************************************************************************)\0a  (* Serializes a tuple of values to the given file as (plain) JSON.       *)\0a  (* Records will be serialized as a JSON objects, and tuples as arrays.   *)\0a  (*************************************************************************)\0a  TRUE\0a\0aJsonDeserialize(absoluteFilename) ==\0a  (*************************************************************************)\0a  (* Deserializes JSON values from the given file. JSON objects will be    *)\0a  (* deserialized to records, and arrays will be deserialized to tuples.   *)\0a  (*************************************************************************)\0a  CHOOSE val : TRUE\0a\0andJsonSerialize(absoluteFilename, value) ==\0a  (*************************************************************************)\0a  (* Serializes a tuple of values to the given file as newline delimited   *)\0a  (* JSON. Records will be serialized as a JSON objects, and tuples as     *)\0a  (* arrays.                                                               *)\0a  (*************************************************************************)\0a  TRUE\0a\0andJsonDeserialize(absoluteFilename) ==\0a  (*************************************************************************)\0a  (* Deserializes JSON values from the given file. JSON values must be     *)\0a  (* separated by newlines. JSON objects will be deserialized to records,  *)\0a  (* and arrays will be deserialized to tuples.                            *)\0a  (*************************************************************************)\0a  CHOOSE val : TRUE\0a\0a=============================================================================\0a'
  :-  'Naturals'
  '-------------------------------- MODULE Naturals ----------------------------\0a(***************************************************************************)\0a(* This module provides dummy definitions of the operators that are        *)\0a(* defined by the real Naturals module.  It is expected that any tool will *)\0a(* provide its own implementations of these operators.  See the book       *)\0a(* "Specifying Systems" for the real Naturals module.                      *)\0a(***************************************************************************)\0a(***************************************************************************)\0a(* These definitions are all overridden by TLC in the Java class           *)\0a(* tlc2.module.Naturals. Each operator is overridden by the Java method    *)\0a(* with the same name, except that the mapping for TLA+ infix operators    *)\0a(* is defined in the static block at the beginning of the Java class.      *)\0a(***************************************************************************)\0aNat       == { }\0aa+b       == {a, b}\0a\0aa-b       == CHOOSE n : b + n = a\0aa*b       == TRUE\0aa^b       == {a, b}\0aa<b       ==  a = b\0aa>b       ==  a = b\0aa \\leq b  ==  a = b\0aa \\geq b  ==  a = b\0a(***************************************************************************)\0a(* a .. b  is defined to equal  {i \\in Int : (a \\leq i) /\\ (i \\leq b)}     *)\0a(* where  Int  is the set of all integers.                                 *)\0a(*                                                                         *)\0a(* a % b  and  a \\div b  are defined so that for any integers  a  and  b   *)\0a(* with  b > 0 , the following formula is true:                            *)\0a(*                                                                         *)\0a(*    a  =  b * (a \\div b) + (a % b)                                       *)\0a(***************************************************************************)\0aa % b     ==  {a, b}\0aa \\div b  ==  {a, b}\0aa .. b    ==  {a, b}\0a=============================================================================\0a'
  :-  'Randomization'
  '-------------------------- MODULE Randomization------------------------------\0a(***************************************************************************)\0a(* This module defines operators for choosing pseudo-random subsets of a   *)\0a(* set.  It is useful for inductive invariance checking, where the         *)\0a(* operators appear only in the initial predicate.  However, it may have   *)\0a(* other uses.                                                             *)\0a(*                                                                         *)\0a(* In breadth-first search model checking, the pseudo-random choices made  *)\0a(* when computing possible steps satisfying the next-state relation are    *)\0a(* determined by the first state of the step.  Thus, the choices made for  *)\0a(* a particular state will be the same in successive runs of TLC.  This is *)\0a(* done to permit TLC to generate an error trace if an error is found.     *)\0a(* This applies only when TLC is run in breadth-first search mode.  In     *)\0a(* particular, the choices made in simulation mode are independent of the  *)\0a(* state for which they are made.                                          *)\0a(***************************************************************************)\0a\0a(***************************************************************************)\0a(* Except for TestRandomSetOfSubsets, all these definitions are overridden *)\0a(* by TLC in the Java class tlc2.module.Randomization.  Each operator is   *)\0a(* overridden by the Java method with the same name.                       *)\0a(***************************************************************************)\0aLOCAL INSTANCE Naturals\0aLOCAL INSTANCE FiniteSets\0a\0a(***************************************************************************)\0a(* RandomSubset(k, S) equals a randomly chosen subset of S containing k    *)\0a(* elements, where 0 < k < Cardinality(S).                                 *)\0a(***************************************************************************)\0aRandomSubset(k, S) == CHOOSE T \\in SUBSET S : Cardinality(T) = k\0a\0a(***************************************************************************)\0a(* RandomSetOfSubsets(k, n, S) equals a pseudo-randomly chosen set of      *)\0a(* subsets of S -- that is, a randomly chosen subset of SUBSET S .  Thus,  *)\0a(* each element T of this set is a subset of S.  Each such T is chosen so  *)\0a(* that each element of S has a probability n / Cardinality(S) of being in *)\0a(* T.  Thus, the average number of elements in each chosen subset T is n.  *)\0a(* The set RandomSetOfSubsets(k, n, S) is obtained by making k such        *)\0a(* choices of T .  Because this can produce duplicate choices, the number  *)\0a(* of elements T in this set may be less than k.  The average number of    *)\0a(* elements in RandomSetOfSubsets(k, n, S) seems to be difficult to        *)\0a(* compute in general.  However, there is very little variation in the     *)\0a(* actual number of elements in the chosen set for fixed values of k, n,   *)\0a(* and Cardinality(S).  You can therefore use the operator                 *)\0a(* TestRandomSetOfSubsets defined below to find out approximately how      *)\0a(* close to k the cardinality of the chosen set of subsets is.             *)\0a(***************************************************************************)\0aRandomSetOfSubsets(k, n, S) == CHOOSE T \\in SUBSET SUBSET S :\0a                                              Cardinality(T) \\leq k\0a\0a(***************************************************************************)\0a(* The value of TestRandomSetOfSubsets(k, n, S) is a sequence of five      *)\0a(* values that are the cardinality of the set of subsets produced by five  *)\0a(* executions of RandomSetOfSubsets(k, n, S).  For constant values of k,   *)\0a(* n, and S, you can enter TestRandomSetOfSubsets(k, n, S) in the Evaluate *)\0a(* Constant Expression section of a TLC model in the TLA+ Toolbox.         *)\0a(* Running TLC will then tell you the approximate number of elements in    *)\0a(* the set of subsets produced by RandomSetOfSubsets for these parameters. *)\0a(* You can then choose k to obtain a set of the desired size.              *)\0a(***************************************************************************)\0aTestRandomSetOfSubsets(k, n, S) ==\0a              [i \\in 1..5 |-> Cardinality(RandomSetOfSubsets(k, n, S))]\0a\0a=============================================================================\0a'
  :-  'RealTime'
  '----------------------------- MODULE RealTime -------------------------------\0a(***************************************************************************)\0a(* This standard module is described in Chapter 9 of the book "Specifying  *)\0a(* Systems".  The type of specification described there cannot be handled  *)\0a(* by the TLC model checker.                                               *)\0a(***************************************************************************)\0aEXTENDS Reals \0aVARIABLE now\0a\0aRTBound(A, v, D, E) == \0a  LET TNext(t)  ==  t\' = IF <<A>>_v \\/ ~(ENABLED <<A>>_v)\'\0a                           THEN 0 \0a                           ELSE t + (now\'-now)\0a\0a      Timer(t) == (t=0)  /\\  [][TNext(t)]_<<t, v, now>>\0a\0a      MaxTime(t) == [](t \\leq E) \0a\0a      MinTime(t) == [][A => t \\geq D]_v \0a  IN \\EE t : Timer(t) /\\ MaxTime(t) /\\ MinTime(t)\0a-----------------------------------------------------------------------------\0aRTnow(v) == LET NowNext == /\\ now\' \\in {r \\in Real : r > now} \0a                           /\\ UNCHANGED v\0a            IN  /\\ now \\in Real \0a                /\\ [][NowNext]_now\0a                /\\ \\A r \\in Real : WF_now(NowNext /\\ (now\'>r))\0a=============================================================================\0a'
  :-  'Reals'
  '-------------------------------- MODULE Reals -------------------------------\0a(***************************************************************************)\0a(* This module provides dummy definitions of the operators that are        *)\0a(* defined by the real Reals module.  It is expected that any tool that    *)\0a(* handles specifications that use real numbers will provide its own       *)\0a(* implementations of these operators.  TLC currently does not handle real *)\0a(* numbers and produces an error if a specification requires TLC to        *)\0a(* evaluate the operators defined here or to evaluate any operator defined *)\0a(* in the Integers module that is applied to non-integer real numbers.     *)\0a(*                                                                         *)\0a(* See the book "Specifying Systems" for the real Reals module.            *)\0a(***************************************************************************)\0aEXTENDS Integers\0a\0aReal  == "Reals"\0aa / b == CHOOSE m \\in Real : m * b = a\0aInfinity == CHOOSE i : (i \\notin Real) /\\ (\\A r \\in Real : i > r)\0a=============================================================================\0a'
  :-  'Sequences'
  '------------------------------ MODULE Sequences -----------------------------\0a(***************************************************************************)\0a(* Defines operators on finite sequences, where a sequence of length n is  *)\0a(* represented as a function whose domain is the set 1..n (the set         *)\0a(* {1, 2, ... , n}).  This is also how TLA+ defines an n-tuple, so         *)\0a(* tuples are sequences.                                                   *)\0a(***************************************************************************)\0a(***************************************************************************)\0a(* These definitions are all overridden by TLC in the Java class           *)\0a(* tlc2.module.Sequences. Each operator is overridden by the Java method   *)\0a(* with the same name, except that the mapping for TLA+ infix operators    *)\0a(* is defined in the static block at the beginning of the Java class.      *)\0a(***************************************************************************)\0a\0aLOCAL INSTANCE Naturals\0a  (*************************************************************************)\0a  (* Imports the definitions from Naturals, but doesn\'t export them.       *)\0a  (*************************************************************************)\0a  \0aSeq(S) == UNION {[1..n -> S] : n \\in Nat}\0a  (*************************************************************************)\0a  (* The set of all sequences of elements in S.                            *)\0a  (*************************************************************************)\0a\0aLen(s) == CHOOSE n \\in Nat : DOMAIN s = 1..n\0a  (*************************************************************************)\0a  (* The length of sequence s.                                             *)\0a  (*************************************************************************)\0a\0as \\o t == [i \\in 1..(Len(s) + Len(t)) |-> IF i \\leq Len(s) THEN s[i]\0a                                                           ELSE t[i-Len(s)]]\0a  (*************************************************************************)\0a  (* The sequence obtained by concatenating sequences s and t.             *)\0a  (*************************************************************************)\0a\0aAppend(s, e) == s \\o <<e>>\0a  (**************************************************************************)\0a  (* The sequence obtained by appending element e to the end of sequence s. *)\0a  (**************************************************************************)\0a\0aHead(s) == s[1]\0aTail(s) == CASE s # << >> -> [i \\in 1..(Len(s)-1) |-> s[i+1]]\0a  (*************************************************************************)\0a  (* The usual head (first) and tail (rest) operators. (Definition of Tail *)\0a  (* changed on 4 Jun 2013 because original defined Tail(<< >>) = << >> .  *)\0a  (*************************************************************************)\0a\0aSubSeq(s, m, n) == [i \\in 1..(1+n-m) |-> s[i+m-1]]\0a  (*************************************************************************)\0a  (* The sequence <<s[m], s[m+1], ... , s[n]>>.                            *)\0a  (*************************************************************************)\0a  \0aSelectSeq(s, Test(_)) == \0a  (*************************************************************************)\0a  (* The subsequence of s consisting of all elements s[i] such that        *)\0a  (* Test(s[i]) is true.                                                   *)\0a  (*************************************************************************)\0a  LET F[i \\in 0..Len(s)] == \0a        (*******************************************************************)\0a        (* F[i] equals SelectSeq(SubSeq(s, 1, i), Test) .                  *)\0a        (*******************************************************************)\0a        IF i = 0 THEN << >>\0a                 ELSE IF Test(s[i]) THEN Append(F[i-1], s[i])\0a                                    ELSE F[i-1]\0a  IN F[Len(s)]\0a=============================================================================\0a'
  :-  'TLC'
  '------------------------------- MODULE TLC ----------------------------------\0a(***************************************************************************)\0a(* This is a standard module for use with the TLC model checker.           *)\0a(* Operators not explained by comments here are explained in the book      *)\0a(* "Specifying Systems".                                                   *)\0a(*                                                                         *)\0a(* The definitions of all the operators in this module are overridden by   *)\0a(* TLC with methods defined in the Java class tlc2.module.TLC.  Each       *)\0a(* definition is overridden with the method of the same name, except that  *)\0a(* the mapping from infix operators to Java methods is specified in the    *)\0a(* static block at the beginning of the Java class.                        *)\0a(***************************************************************************)\0aLOCAL INSTANCE Naturals\0aLOCAL INSTANCE Sequences\0aLOCAL INSTANCE FiniteSets\0a-----------------------------------------------------------------------------\0aPrint(out, val) == val\0aPrintT(out) == TRUE\0a   (************************************************************************)\0a   (* This expression equals TRUE, but evaluating it causes TLC to print   *)\0a   (* the value of out.                                                    *)\0a   (************************************************************************)\0a   \0aAssert(val, out) == IF val = TRUE THEN TRUE\0a                                  ELSE CHOOSE v : TRUE\0aJavaTime == CHOOSE n : n \\in Nat\0a\0a(***************************************************************************)\0a(* TLC can read and set a special list of values while evaluating          *)\0a(* expressions using the operators TLCSet and TLCGet.  When TLC evaluates  *)\0a(* TLCSet(i,v), for any positive integer i and arbitrary value v, it       *)\0a(* obtains the value TRUE and sets element number i of the list to v.      *)\0a(* When TLC evaluates TLCGet(i), the value it obtains is the current value *)\0a(* of the element number i of this list.                                   *)\0a(*                                                                         *)\0a(* One use of this feature is to check TLC\'s progress during long          *)\0a(* computations.  For example, suppose TLC is evaluating a formula         *)\0a(* \\A x \\in S : P where S is a large set, so it evaluates P many times.    *)\0a(* You can use TLCGet, TLCSet, and Print to print something after every    *)\0a(* 1000 times TLC evaluates P.                                             *)\0a(*                                                                         *)\0a(* As explained in the description of the TLCEval operator below, you may  *)\0a(* also want to use this feature to count how many times TLC is evaluating *)\0a(* an expression e.  To use value number i as the counter, just replace e  *)\0a(* by                                                                      *)\0a(*                                                                         *)\0a(*   IF TLCSet(i, TLCGet(i)+1) THEN e ELSE 42                              *)\0a(*                                                                         *)\0a(* (The ELSE expression is never evaluated.)                               *)\0a(*                                                                         *)\0a(* TLCGet accepts some pre-defined string values to query TLC state. The   *)\0a(* values are as follows:                                                  *)\0a(*                                                                         *)\0a(*   - TLCGet("distinct") evaluates to the total number of distinct states *)\0a(*     found by TLC so far, globally.                                      *)\0a(*   - TLCGet("queue") evaluates to the number of states currently in the  *)\0a(*     queue to be checked.                                                *)\0a(*   - TLCGet("duration") evaluates to the number of seconds elapsed since *)\0a(*     model checking began.                                               *)\0a(*   - TLCGet("diameter") evaluates to the length of the longest behavior  *)\0a(*     found by TLC so far, globally (equals one in the initial predicate).*)\0a(*   - TLCGet("level") is the length of the current behavior (equals zero  *)\0a(*     in the evaluation of the initial predicate).                        *)\0a(*                                                                         *)\0a(* For reasons of efficiency, TLCGet and TLCSet behave somewhat strangely  *)\0a(* when TLC is run with multiple worker threads.  Each worker thread       *)\0a(* maintains its own individual copy of the list of values on which it     *)\0a(* evaluates TLCGet and TLCSet.  The worker threads are activated only     *)\0a(* after the computation and invariance checking of the initial states.    *)\0a(* Before then, evaluating TLCSet(i,v) sets the element i of the list      *)\0a(* maintained by all threads.  Thus, the lists of all the worker threads   *)\0a(* can be initialized by putting the appropriate TLCSet expression in an   *)\0a(* ASSUME expression or in the initial predicate.                          *)\0a(***************************************************************************)\0aTLCGet(i) == CHOOSE n : TRUE\0aTLCSet(i, v) == TRUE\0a-----------------------------------------------------------------------------\0ad :> e == [x \\in {d} |-> e]\0af @@ g == [x \\in (DOMAIN f) \\cup (DOMAIN g) |->\0a            IF x \\in DOMAIN f THEN f[x] ELSE g[x]]\0aPermutations(S) == \0a   {f \\in [S -> S] : \\A w \\in S : \\E v \\in S : f[v]=w}\0a-----------------------------------------------------------------------------\0a(***************************************************************************)\0a(* In the following definition, we use Op as the formal parameter rather   *)\0a(* than \\prec because TLC Version 1 can\'t handle infix formal parameters.  *)\0a(***************************************************************************)\0aSortSeq(s, Op(_, _)) ==\0a    LET Perm == CHOOSE p \\in Permutations(1 .. Len(s)) :\0a                  \\A i, j \\in 1..Len(s) : \0a                     (i < j) => Op(s[p[i]], s[p[j]]) \\/ (s[p[i]] = s[p[j]])\0a    IN  [i \\in 1..Len(s) |-> s[Perm[i]]]\0a\0a(***************************************************************************)\0a(* TLC evaluates RandomElement(S) to be a pseudo-randomly chosen element   *)\0a(* of the set S, where each element of S is chosen with equal probability. *)\0a(* This feature was added to enable the computation of statistical         *)\0a(* properties of a specification\'s executions by running TLC in simulation *)\0a(* mode.  We don\'t know if anyone has ever done this.                      *)\0a(*                                                                         *)\0a(* In breadth-first search model checking, the pseudo-random choices made  *)\0a(* when computing possible steps satisfying the next-state relation are    *)\0a(* determined by the first state of the step.  Thus, the choices made for  *)\0a(* a particular state will be the same in successive runs of TLC.  This is *)\0a(* done to permit TLC to generate an error trace if an error is found.     *)\0a(* This applies only when TLC is run in breadth-first search mode.  The    *)\0a(* random choices made in simulation mode are independent of the state for *)\0a(* which they are made.                                                    *)\0a(***************************************************************************)\0aRandomElement(s) == CHOOSE x \\in s : TRUE\0a\0a(***************************************************************************)\0a(* The constant value Any has the special property that, for any value v,  *)\0a(* TLC evaluates the expression  v \\in Any  to equal TRUE.  The special    *)\0a(* value Any was introduced because TLA+ originally allowed only functions *)\0a(* to be defined recursively, and it was sometimes convenient to define a  *)\0a(* function with domain Any.  It is retained for backwards compatibility.  *)\0a(***************************************************************************)\0aAny == CHOOSE x : TRUE\0a\0aToString(v) == (CHOOSE x \\in [a : v, b : STRING] : TRUE).b\0a   (************************************************************************)\0a   (* This equals a string that is the TLA+ representation of the value    *)\0a   (* that TLC obtains by evaluating v.                                    *)\0a   (************************************************************************)\0a\0a(***************************************************************************)\0a(* TLC often uses lazy evaluation.  For example, it may not enumerate the  *)\0a(* elements of a set of the form {x \\in T : P(x)} unless it has to; and it *)\0a(* doesn\'t have to if it only needs to check if an element e is in that    *)\0a(* set.  (TLC can do that by evaluating x \\in T and P(e).) TLC uses        *)\0a(* heuristics to determine when it should completely evaluate an           *)\0a(* expression.  Those heuristics work well most of the time.  However,     *)\0a(* sometimes lazy evaluation can result in the expression ultimately being *)\0a(* evaluated multiple times instead of just once.  This can especially be  *)\0a(* a problem when evaluating a recursively defined operator.  You can get  *)\0a(* TLC to fully evaluate an expression exp and not use lazy evaluation by  *)\0a(* replacing exp with TLCEval(exp).                                        *)\0a(*                                                                         *)\0a(* If TLC is taking a long time to evaluate something, you can check if    *)\0a(* lazy evaluation is the source of the problem by using the TLCSet and    *)\0a(* TLCGet operators to count how many times expressions are being          *)\0a(* evaluated.                                                              *)\0a(***************************************************************************)\0aTLCEval(v) == v\0a\0a============================================================================='
  :-  'TLCExt'
  '------------------------------- MODULE TLCExt -------------------------------\0a\0aLOCAL INSTANCE TLC\0aLOCAL INSTANCE Integers\0a  (*************************************************************************)\0a  (* Imports the definitions from the modules, but doesn\'t export them.    *)\0a  (*************************************************************************)\0a\0a-----------------------------------------------------------------------------\0a\0a\\* AssertEq(a, b) is logically equivalent to the expression \'a = b\'. If a and b are not equal, \0a\\* however, AssertEq(a, b) will print out the values of \'a\' and \'b\'. If the two values are equal,\0a\\* nothing will be printed.\0aAssertEq(a, b) == \0a    IF a # b THEN\0a        /\\ PrintT("Assertion failed")\0a        /\\ PrintT(a)\0a        /\\ PrintT(b)\0a        /\\ a = b\0a    ELSE a = b\0a\0a\0aAssertError(err, exp) ==\0a    LET FailsEval(e) == CHOOSE b \\in BOOLEAN : TRUE \\* Expression failed to evaluate. \0a        TLCError     == CHOOSE s \\in STRING  : TRUE \\* TLC error string.\0a    IN IF FailsEval(exp) THEN Assert(err = TLCError, TLCError) ELSE TRUE\0a\0a-----------------------------------------------------------------------------\0a\0aTLCGetOrDefault(key, defaultVal) ==\0a  CHOOSE n : TRUE\0a\0aTLCGetAndSet(key, Op(_,_), val, defaultVal) ==\0a  LET oldVal == TLCGetOrDefault(key, defaultVal)\0a  IN CHOOSE v \\in {oldVal} : TLCSet(key, Op(oldVal, val))\0a\0a-----------------------------------------------------------------------------\0a\0a(* HERE BE DRAGONS! The operators below are experimental! You will probably not need them! *)\0a\0aTrace == \0a  (******************************************************************************)\0a  (* The sequence of states (represented as a record whose DOMAIN is the set of *)\0a  (* a spec\'s variables) from an initial state to the current state.  In other  *)\0a  (* words, a prefix - of a behavior - ending with the current state.  A way to *)\0a  (* think about this operator is to see it as an implicit history variable     *)\0a  (* that does not have to be explicitly specified at the level of the spec.    *)\0a  (*                                                                            *)\0a  (* Note that op is incompatible with TLC!RandomElement and Randomization (see *)\0a  (* tlc2.tool.TLCTrace.getTrace(LongVec)) and will cause TLC to crash.  This   *)\0a  (* technical limitation could be removed though.                              *)\0a  (*                                                                            *)\0a  (* Beware that Trace is prohibitively expensive when evaluated as part of     *)\0a  (* the next-state relation, invariants, properties, or any constraint in      *)\0a  (* model-checking mode. Consider using a real history variable instead.       *)\0a  (******************************************************************************)\0a  TRUE \\* TODO\0a\0a-----------------------------------------------------------------------------\0a\0aCounterExample ==\0a    (****************************************************************************)\0a    (* In the scope of POSTCONDITION, the operator CounterExample is equivalent *)\0a    (* to a (directed) graph represented as [state: States, action: Actions]    *)\0a    (* with                                                                     *)\0a    (*   States \\subseteq [ Variables -> Values ]                               *)\0a    (* and                                                                      *)\0a    (*  Actions \\subseteq                                                       *)\0a    (*            (CounterExample.state \\X Action \\X CounterExample.state).     *)\0a    (* If TLC found no violations, then CounterExample.states equals {} and     *)\0a    (* CounterExample.actions equals {}.  If only initial state violates a      *)\0a    (* (safety) property, CounterExample.state is a set of those states, and    *)\0a    (* CounterExample.actions = {}.                                             *)\0a    (****************************************************************************)\0a    TRUE\0a\0aToTrace(CE) ==\0a\09(* \0a\09This definition is implemented by the TLCExt#toTrace Java module override. It\0a\09is commented because FiniteSetsExt is part of the CommunityModules, but not\0a\09tla2tools.\0a\0a\09LET F == INSTANCE FiniteSetsExt\0a\09IN F!FoldSet(LAMBDA a, acc: acc @@ [n \\in {a[1]} |-> a[2]], [n \\in {} |-> n], CounterExample.state)\0a\0a\09*)\0a\09TRUE \0a\0a-----------------------------------------------------------------------------\0a\0aTLCModelValue(str) ==\0a  (******************************************************************************)\0a  (* A model value is an unspecified value that TLC considers to be unequal to  *)\0a  (* any value that you can express in TLA+.                                    *)\0a  (*                                                                            *)\0a  (* In most cases, TLC model values can and should be declared via the TLC     *)\0a  (* config file.  However, for large sets of model values, it can become       *)\0a  (* tedious to enumerate them explicitly. Large sets of model values usually   *)\0a  (* appear when simulating TLA+ specs with TLC. The following example defines  *)\0a  (* a set of 32 model values:                                                  *)\0a  (*                                                                            *)\0a  (*  SetOfModelValues == {TLCModelValue("T_MV" \\o ToString(i)) : i \\in 1..32}  *)\0a  (*                                                                            *)\0a  (* As a matter of fact, the example defines a set of "typed" model values:    *)\0a  (* TLC considers a typed model value to be unequal to any other model value   *)\0a  (* of the same type.  However, it produces an error when evaluating an        *)\0a  (* expression requires it to determine if a typed model value is equal to any *)\0a  (* value other than a model value of the same type or an ordinary model       *)\0a  (* value.                                                                     *)\0a  (*                                                                            *)\0a  (* A model-value type consists of a single letter, so there are 52 different  *)\0a  (* types because  a  and  A  are different types.  (TLC actually accepts      *)\0a  (* digits and underscore as types; don\'t use them.)  A model value has type   *)\0a  (* T  if and only if its name begins with the two characters  T_ .            *)\0a  (*                                                                            *)\0a  (* TLCModelValue may only appear in constant definitions!  Expect bogus       *)\0a  (* behavior if TLCModelValue appears in the behavior spec, constraints,       *)\0a  (* invariants, or properties.                                                 *)\0a  (******************************************************************************)\0a  CHOOSE v: ToString(v) = str\0a\0aTLCDefer(expression) ==\0a  (******************************************************************************)\0a  (* Defer evaluation of expression to some later time or never.                *)\0a  (*                                                                            *)\0a  (* For TLC\'s simulation mode, later is defined as the point of time when      *)\0a  (* simulation has chosen a successor state to extend the prefix of the        *)\0a  (* current behavior.                                                          *)\0a  (*                                                                            *)\0a  (* A use case is TLCDefer(TLCSet(42, someVal)), which sets someVal only       *)\0a  (* for the states of the behavior and not the set of all successor states     *)\0a  (* of all states in the behavior.                                             *)\0a  (******************************************************************************)\0a  TRUE\0a\0a-----------------------------------------------------------------------------\0a\0aTLCNoOp(val) ==\0a  (******************************************************************************)\0a  (* No-operation operator (does nothing).  Only useful to debug TLC\'s          *)\0a  (* evaluator that is written in Java: Insert TLCNoOp into the expression      *)\0a  (* whose evaluation you wish to debug and set a breakpoint in this            *)\0a  (* operator\'s Java module override TLCExt#tlcNoOp in TLCExt.java.             *)\0a  (******************************************************************************)\0a  val\0a\0a\0aPickSuccessor(exp) ==\0a  (******************************************************************************)\0a  (* When set as an action constraint in the configuration file, interactively  *)\0a  (* pick successor states during state exploration, iff the expression exp     *)\0a  (* evaluates to FALSE.  To always pick successor states manually, use         *)\0a  (* PickSuccessor(FALSE). To pick successor states when the current prefix of  *)\0a  (* behaviors exceeds 22 states, use PickSuccessor(TLCGet("level") < 23).      *)\0a  (* Evaluates to TRUE when evaluated in the context of a constant- or          *)\0a  (* state-level formula.  Also evaluates to TRUE if PickSuccessor appears as   *)\0a  (* part of the next-state relation and the successor state has not been       *)\0a  (* fully determined yet.                                                      *)\0a  (******************************************************************************)\0a  IF (exp)\0a  THEN TRUE\0a  ELSE CHOOSE bool \\in BOOLEAN : TRUE \0a\0a-----------------------------------------------------------------------------\0a\0aTLCCache(expression, closure) ==\0a  (******************************************************************************)\0a  (* Equals the value that an earlier evaluation of the expression evaluated to *)\0a  (* iff the closure of the earlier evaluation and this evaluation are equal.   *)\0a  (*                                                                            *)\0a  (* Works in constant and state-level contexts.                                *)\0a  (******************************************************************************)\0a  expression\0a\0aTLCFP(var) ==\0a  (******************************************************************************)\0a  (* Equals the value that TLC gives to the given input when the value is       *)\0a  (* being fingerprinted.                                                       *)\0a  (* Implementation note: Equals the lower 32 bits until TLC supports longs     *)\0a  (******************************************************************************)\0a  CHOOSE i \\in Int: TRUE\0a\0a-----------------------------------------------------------------------------\0a\0aTLCEvalDefinition(definitionName) ==\0a  (******************************************************************************)\0a  (* Equals the value of the definition with the given name.                    *)\0a  (* Throws an error if the definition cannot be found.                         *)\0a  (******************************************************************************)\0a  TRUE \\* TODO\0a\0a============================================================================\0a'
  :-  'Toolbox'
  '----------------------------- MODULE Toolbox --------------------------------\0a(***************************************************************************)\0a(*                                                                         *)\0a(***************************************************************************)\0aLOCAL INSTANCE Naturals   \\* a + b\0aLOCAL INSTANCE FiniteSets \\* Cardinality\0aLOCAL INSTANCE TLC        \\* TLCGet\0a\0a-----------------------------------------------------------------------------\0a\0a(* Trace Exploration *)\0a\0a_TETrace ==\0a    CHOOSE f \\in [ (Nat \\ {0}) -> STRING ] : TRUE\0a\0aLOCAL _TETraceLength == Cardinality(DOMAIN _TETrace)\0a\0a\\* When evaluated as part of a TLC ALIAS expression, `_TEPosition` should be\0a\\* redefined as `TLCGet("level"), or replace with `TLCGet(level)` right away.\0a\\* The definition below accounts for several "peculiarities" of the\0a\\* Toolbox\'s trace exploration.\0a_TEPosition == \0a    IF TLCGet("level") >= _TETraceLength\0a       THEN _TETraceLength\0a       ELSE IF TLCGet("level") = 0 THEN 1 ELSE TLCGet("level")\0a\0a=============================================================================\0a'
  :-  '_DotTrace'
  '------------------------------- MODULE _DotTrace -------------------------------\0aLOCAL INSTANCE TLC\0aLOCAL INSTANCE TLCExt\0aLOCAL INSTANCE GraphViz\0aLOCAL INSTANCE IOUtils\0aLOCAL INSTANCE Sequences\0aLOCAL INSTANCE Functions\0a\0aCONSTANT _DotTraceFile\0a\0a_DotTrace ==\0a    IF CounterExample.state = {} \\/ ("console" \\in DOMAIN CounterExample /\\ CounterExample["console"] = FALSE) THEN TRUE ELSE\0a        /\\ LET N == CounterExample.state\0a               E == { <<e[1], e[3], e[2]>> : e \\in CounterExample.action }\0a               G == [node |-> N, edge |-> E] IN\0a           Serialize(DotDiGraph(G, LAMBDA v: FoldFunctionOnSet(\0a           \09\09\09\09\09\09\09\09LAMBDA x, y: ToString(x) \\o "\\n" \\o y, "", v[2], DOMAIN v[2]), \0a           \09\09\09\09\09\09   LAMBDA e: e[3].name),\0a    \09\09\09_DotTraceFile,\0a    \09\09\09[\0a    \09\09\09\09format |-> "TXT",\0a    \09\09\09\09charset |-> "UTF-8",\0a    \09\09\09\09openOptions |-> <<"WRITE", "CREATE", "TRUNCATE_EXISTING">>\0a    \09\09\09]\0a           ).exitValue = 0\0a        /\\ PrintT("CounterExample written: " \\o _DotTraceFile)\0a\0a=============================================================================\0a'
  :-  '_JsonTrace'
  '------------------------------- MODULE _JsonTrace -------------------------------\0aLOCAL INSTANCE TLC\0aLOCAL INSTANCE TLCExt\0aLOCAL INSTANCE Json\0aLOCAL INSTANCE Sequences\0aLOCAL INSTANCE Naturals\0a\0aCONSTANT _JsonTraceFile\0a\0a_JsonTrace ==\0a    IF CounterExample.state = {} \\/ ("console" \\in DOMAIN CounterExample /\\ CounterExample["console"] = FALSE) THEN TRUE ELSE\0a        /\\ LET trace == ToTrace(CounterExample)\0a               vars  == UNION { DOMAIN trace[i] : i \\in DOMAIN trace }\0a           IN JsonSerialize(_JsonTraceFile, [counterexample |-> CounterExample, vars |-> vars])\0a        /\\ PrintT("CounterExample written: " \\o _JsonTraceFile)\0a\0a----------------------------------------------------------------------------\0a\\* Deserialize a trace created by _JsonTrace above.\0a\0aCONSTANT _JsonTraceInputFile   \\* Used by -loadTrace json\0a\0a\\* This operator has a Java module override (tlc2.module._JsonTrace#tlcState).\0aLOCAL _TLCState(level) ==\0a\09Trace[level]\0a\0aLOCAL _JsonTraceDump == JsonDeserialize(_JsonTraceInputFile)\0a\0a\\* A liveness counterexample\'s action graph contains a closing edge that\0a\\* completes the lasso. In a forward path s1->s2->...->sn every edge\0a\\* satisfies target[1] > source[1]; the closing edge is the unique edge\0a\\* where target[1] <= source[1] (back-to-state: <, stuttering: =).\0aLOCAL _JsonTraceLassoTarget ==\0a    LET actions == _JsonTraceDump["counterexample"]["action"]\0a    IN IF \\E i \\in DOMAIN actions : actions[i][3][1] <= actions[i][1][1]\0a       THEN LET i == CHOOSE i \\in DOMAIN actions :\0a                        actions[i][3][1] <= actions[i][1][1]\0a            IN actions[i][3][1]\0a       ELSE 0\0a\0aLOCAL _JsonTraceConstraint ==\0a    LET level == TLCGet("level")\0a        \\* DOMAIN trace is meaningful only because we serialize TLA+ sets as JSON arrays. JSON has\0a        \\* no set type---only the world\'s favorite least-common-denominator of strings, numbers,\0a        \\* and nested lists---so on the wire every set is an ordered sequence. If that encoding\0a        \\* ever changed (or JSON miraculously grew a real set type), indexing states by DOMAIN\0a        \\* would stop matching what we dump.\0a        \\* Rebuilding vars likewise assumes the array order matches TLC\'s normalized set order from\0a        \\* when the trace was written; the format does not pin down a stronger invariant.\0a        trace == _JsonTraceDump["counterexample"]["state"]\0a        \\* JSON deserializes sets as tuples, so convert back to a set\0a        vars  == {_JsonTraceDump["vars"][i] : i \\in DOMAIN _JsonTraceDump["vars"]}\0a\09\\* For liveness properties, TLC trace dumps stop at the state *before* the\0a\09\\* lasso is closed. When replaying such a trace, TLC may request a state with\0a\09\\*   level = Len(trace) + 1,\0a\09\\* which does not exist in the dump. In that case, the constraint\0a\09\\* is intentionally vacuously satisfied.\0a\09\\* Since the names of the spec\'s variables are not known, Trace[level] is\0a\09\\* used as a generic reference to the variables of the current state.\0a    IN level \\in DOMAIN trace =>\0a            \\* When loading a trace with a subset of variables, only check the variables\0a            \\* that exist in both the trace and the current state. This allows trace \0a            \\* replay with specs that have different variable sets than the original spec\0a            \\* that produced the trace. Another scenario is when the spec uses ALIAS\0a            \\* to rename, add, or remove variables.\0a            \\A v \\in vars \\cap (DOMAIN _TLCState(level)):\0a                    _TLCState(level)[v] = trace[level][2][v]\0a\0a\\* VIEW for trace replay. Includes TLCGet("level") to prevent premature\0a\\* state collapsing within the trace. For liveness traces, the level\0a\\* beyond the trace is mapped to the lasso target so the cycle can close.\0aLOCAL _JsonTraceView ==\0a    LET level       == TLCGet("level")\0a        traceLen    == Len(_JsonTraceDump["counterexample"]["state"])\0a        lassoTarget == _JsonTraceLassoTarget\0a    IN IF level <= traceLen\0a       THEN << level, _TLCState(level) >>\0a       ELSE << lassoTarget, _TLCState(level) >>\0a\0a=============================================================================\0a'
  :-  '_Possible'
  '------------------------------ MODULE _Possible ------------------------------\0aLOCAL INSTANCE TLC\0aLOCAL INSTANCE TLCExt\0aLOCAL INSTANCE Naturals\0aLOCAL INSTANCE Sequences\0a\0aLOCAL _Update(Op(_,_), val) ==\0a    TLCSet("s:_possible", Op(TLCGetOrDefault("s:_possible", <<>>), val))\0a\0a_Track(expr, name) ==\0a    _Update(LAMBDA old, b:\0a        IF b\0a        THEN\0a            IF name \\in DOMAIN old\0a            THEN [old EXCEPT ![name] = @ + 1]\0a            ELSE old @@ (name :> 1)\0a        ELSE old @@ (name :> 0), expr)\0a\0aLOCAL _Merge(a, b) ==\0a    [name \\in (DOMAIN a) \\cup (DOMAIN b) |->\0a        (IF name \\in DOMAIN a THEN a[name] ELSE 0) +\0a        (IF name \\in DOMAIN b THEN b[name] ELSE 0)]\0a\0a_Counts == \\* Java override for efficiency\0a    LET workers == TLCGet("all:named")["s:_possible"]\0a        n == Len(workers)\0a        Fold[i \\in 0..n] ==\0a            IF i = 0 THEN <<>>\0a            ELSE _Merge(Fold[i-1], workers[i])\0a    IN Fold[n]\0a\0a_CheckName(name) ==\0a    LET counts == _Counts\0a    IN (name \\notin DOMAIN counts \\/ counts[name] = 0)\0a       => (PrintT(counts) /\\ FALSE)\0a\0a_PrintCounts == PrintT(_Counts)\0a\0a=============================================================================\0a'
  :-  '_TLAPlusCounterExample'
  '----------------------- MODULE _TLAPlusCounterExample ------------------------\0aLOCAL INSTANCE IOUtils\0aLOCAL INSTANCE TLC\0aLOCAL INSTANCE TLCExt\0aLOCAL INSTANCE Sequences\0aLOCAL INSTANCE SequencesExt\0a\0aCONSTANT _TLAPlusCounterExampleFile\0a\0aLOCAL _TLAPlusCounterExampleModule ==\0a\09LET ModuleName == ReplaceFirstSubSeq("", ".tla", _TLAPlusCounterExampleFile) IN\0a\09"---- MODULE " \\o ModuleName \\o " ----\\n" \\o\0a    "LOCAL INSTANCE TLC\\n\\n" \\o\0a    "CounterExample == \\n\\t" \\o\0a    ToString(CounterExample) \\o \0a    "\\n\\n===="\0a\0a_TLAPlusCounterExample ==\0a    IF CounterExample.state = {} \\/ ("console" \\in DOMAIN CounterExample /\\ CounterExample["console"] = FALSE) THEN TRUE ELSE\0a        /\\ Serialize(_TLAPlusCounterExampleModule,\0a    \09\09\09_TLAPlusCounterExampleFile,\0a    \09\09\09[\0a    \09\09\09\09format |-> "TXT",\0a    \09\09\09\09charset |-> "UTF-8",\0a    \09\09\09\09openOptions |-> <<"WRITE", "CREATE", "TRUNCATE_EXISTING">>\0a    \09\09\09]\0a           ).exitValue = 0\0a        /\\ PrintT("CounterExample written: " \\o _TLAPlusCounterExampleFile)\0a\0a=============================================================================\0a'
  :-  '_TLCActionTrace'
  '------- MODULE _TLCActionTrace ------\0aLOCAL INSTANCE IOUtils\0aLOCAL INSTANCE TLC\0aLOCAL INSTANCE TLCExt\0aLOCAL INSTANCE Sequences\0aLOCAL INSTANCE SequencesExt\0aLOCAL INSTANCE FiniteSets\0aLOCAL INSTANCE FiniteSetsExt\0a\0aLOCAL _extends ==\0a    LET M == FoldSet(LAMBDA a, acc: acc \\cup {a[2].location.module}, {}, CounterExample.action)\0a    IN FoldSet(LAMBDA module, acc: acc \\o (IF acc = "" THEN "EXTENDS " ELSE ", ") \\o module, "", M)\0a\0aLOCAL _next ==\0a    LET Params(r) == FoldLeft(LAMBDA acc, p: acc \\o (IF acc = "" THEN "" ELSE ", ") \\o ToString(r.context[p]), \0a                              "", r.parameters)\0a        Signature(r) == IF "parameters" \\in DOMAIN r THEN r.name \\o "(" \\o Params(r) \\o ")" ELSE r.name\0a        ToDisjunct(i, r) == "\\\\/ " \\o ToString(i) \\o " = _idx /\\\\ " \\o Signature(r) \\o "\\n"\0a    IN FoldSet(LAMBDA a, acc: acc \\o ToDisjunct(a[1][1], a[2]), "", CounterExample.action)\0a\0aCONSTANT _TLCTraceFile\0a\0aLOCAL _TLCTraceModule ==\0a\09LET ModuleName == ReplaceFirstSubSeq("", ".tla", _TLCTraceFile) \0a        L == ToString(Cardinality(CounterExample.action)) IN\0a\09"---- MODULE " \\o ModuleName \\o " ----\\n" \\o\0a\09 \\*TODO callsignature symbols may not be defined in the same modules where the actions are defined.\0a\09 \\*TODO E.g., model values are typically defined in the MC file.\0a        _extends \\o "\\n\\n" \\o\0a    "_length == " \\o L \\o "\\n\\n" \\o\0a    "_next(_idx) ==\\n" \\o _next \\o "\\n" \\o\0a    "_actionConstraint ==\\n" \\o\0a    "_next(LET T == INSTANCE TLC IN T!TLCGet(\\"level\\"))\\n" \\o\0a    "\\n===="\0a\0a_TLCTrace ==\0a    IF CounterExample.action = {} \\/ ("console" \\in DOMAIN CounterExample /\\ CounterExample["console"] = FALSE) THEN TRUE ELSE\0a        /\\ Serialize(_TLCTraceModule,\0a    \09\09\09_TLCTraceFile,\0a    \09\09\09[\0a    \09\09\09\09format |-> "TXT",\0a    \09\09\09\09charset |-> "UTF-8",\0a    \09\09\09\09openOptions |-> <<"WRITE", "CREATE", "TRUNCATE_EXISTING">>\0a    \09\09\09]\0a           ).exitValue = 0\0a        /\\ PrintT("CounterExample written: " \\o _TLCTraceFile)\0a\0a======'
  :-  '_TLCTESpec'
  '----------------------- MODULE _TLCTESpec ------------------------\0aLOCAL INSTANCE IOUtils\0aLOCAL INSTANCE TLC\0aLOCAL INSTANCE TLCExt\0aLOCAL INSTANCE Sequences\0aLOCAL INSTANCE SequencesExt\0aLOCAL INSTANCE FiniteSets\0aLOCAL INSTANCE FiniteSetsExt\0a\0aLOCAL _extends ==\0a    LET M == FoldSet(LAMBDA a, acc: acc \\cup {a[2].location.module}, {}, CounterExample.action)\0a    IN FoldSet(LAMBDA module, acc: acc \\o (IF acc = "" THEN "EXTENDS " ELSE ", ") \\o module, "", M)\0a\0aLOCAL _Vars ==\0a    UNION { DOMAIN pair[2] : pair \\in CounterExample.state }\0a\0aLOCAL _ToConjunt(v, prime, idx) ==\0a    "/\\\\ " \\o v \\o prime \\o " = Trace[" \\o idx \\o "]." \\o v \\o "\\n"\0a\0aCONSTANT _TLCTraceFile\0a\0aLOCAL _conjunct(prime, idx) ==\0a    FoldSet(LAMBDA v, acc: acc \\o _ToConjunt(v, prime, idx), "", _Vars)\0a\0aLOCAL _subVars ==\0a    FoldSet(LAMBDA v, acc: acc \\o (IF acc = "" THEN "" ELSE ", ") \\o v, "", _Vars)\0a\0aLOCAL _TLCTraceModule ==\0a\09LET ModuleName == ReplaceFirstSubSeq("", ".tla", _TLCTraceFile) IN\0a\09"---- MODULE " \\o ModuleName \\o " ----\\n" \\o\0a\09 \\*TODO E.g., model values are typically defined in the MC file.\0a        _extends \\o "\\n\\n" \\o\0a    "LOCAL INSTANCE TLC\\n\\n" \\o\0a    "Trace == \\n\\t" \\o\0a\09ToString(ToTrace(CounterExample)) \\o\0a\09"\\n\\n" \\o\0a    "_init ==\\n" \\o _conjunct("", "1") \\o\0a\09"\\n" \\o\0a    "_next ==\\n\\\\E i,j \\\\in DOMAIN Trace:\\n/\\\\ i = TLCGet(\\"level\\")\\n/\\\\ j = i + 1\\n" \\o\0a    _conjunct("", "i") \\o _conjunct("\'", "j") \\o\0a    "\\n(* Allow infinite stuttering to prevent deadlock on termination. *)" \\o\0a    "\\n_terminating ==\\n\\tUNCHANGED <<" \\o _subVars \\o ">>" \\o \0a    "\\n\\n_spec == \\n\\t_init /\\\\ [][_next \\\\/ _terminating]_<<" \\o _subVars \\o ">>\\n" \\o\0a    "\\n===="\0a    \\* TODO: Append in-file config here.\0a\0a_TLCTrace ==\0a    IF CounterExample.state = {} \\/ ("console" \\in DOMAIN CounterExample /\\ CounterExample["console"] = FALSE) THEN TRUE ELSE\0a        /\\ Serialize(_TLCTraceModule,\0a    \09\09\09_TLCTraceFile,\0a    \09\09\09[\0a    \09\09\09\09format |-> "TXT",\0a    \09\09\09\09charset |-> "UTF-8",\0a    \09\09\09\09openOptions |-> <<"WRITE", "CREATE", "TRUNCATE_EXISTING">>\0a    \09\09\09]\0a           ).exitValue = 0\0a        /\\ PrintT("CounterExample written: " \\o _TLCTraceFile)\0a\0a=============================================================================\0a'
  :-  '_TLCTrace'
  '---------------------------- MODULE _TLCTrace ----------------------------\0aLOCAL INSTANCE TLC\0aLOCAL INSTANCE TLCExt\0aLOCAL INSTANCE Sequences\0aLOCAL INSTANCE Naturals\0a\0a\\* This operator has a Java module override (tlc2.module._TLCTrace#ioDeserialize).\0aLOCAL _TLCTraceDeserialize(absoluteFilename) ==\0a    TRUE\0a\0a\\* This operator has a Java module override (tlc2.module._TLCTrace#ioSerialize).\0aLOCAL _TLCTraceSerialize(val, absoluteFilename) ==\0a    TRUE\0a\0a----------------------------------------------------------------------------\0a\\* Serialize a trace to a file.\0a\0aCONSTANT _TLCTraceFile\0a\0aLOCAL _TLCTrace0(verbose) ==\0a    IF CounterExample.state = {} \\/ ("console" \\in DOMAIN CounterExample /\\ CounterExample["console"] = FALSE) THEN TRUE ELSE\0a        /\\ LET trace == ToTrace(CounterExample)\0a               vars  == UNION { DOMAIN trace[i] : i \\in DOMAIN trace }\0a           IN _TLCTraceSerialize([counterexample |-> CounterExample, vars |-> vars], _TLCTraceFile)\0a        /\\ IF verbose THEN PrintT("CounterExample written: " \\o _TLCTraceFile) ELSE TRUE\0a\0aLOCAL _TLCTraceSilent ==\0a    _TLCTrace0(FALSE)\0a\0a_TLCTrace ==\0a    _TLCTrace0(TRUE)\0a\0a----------------------------------------------------------------------------\0a\\* Deserialize a trace created by _TLCTrace above.\0a\0aCONSTANT _TLCTraceInputFile   \\* Used by -loadTrace tlc\0a\0aLOCAL _TLCTraceFileDeserialized ==\0a    _TLCTraceDeserialize(_TLCTraceInputFile)\0a\0a\\* This operator has a Java module override (tlc2.module._TLCTrace#tlcState).\0aLOCAL _TLCState(level) ==\0a\09Trace[level]\0a\0a\\* A liveness counterexample\'s action graph contains a closing edge that\0a\\* completes the lasso. In a forward path s1->s2->...->sn every edge\0a\\* satisfies target[1] > source[1]; the closing edge is the unique edge\0a\\* where target[1] <= source[1] (back-to-state: <, stuttering: =).\0aLOCAL _TLCTraceLassoTarget ==\0a    LET actions == _TLCTraceFileDeserialized["counterexample"]["action"]\0a    IN IF \\E e \\in actions : e[3][1] <= e[1][1]\0a       THEN (CHOOSE e \\in actions : e[3][1] <= e[1][1])[3][1]\0a       ELSE 0\0a\0aLOCAL _TLCTraceConstraint ==\0a    LET level == TLCGet("level")\0a        dump  == _TLCTraceFileDeserialized\0a        trace == dump["counterexample"]["state"]\0a        vars  == dump["vars"]\0a\09\\* The trace (CounterExample.state) is a set of <<level, state>> pairs,\0a\09\\* not a function/sequence.\0a\09\\* For liveness properties, TLC trace dumps stop at the state *before* the\0a\09\\* lasso is closed. When replaying such a trace, TLC may request a state with\0a\09\\* a level that does not exist in the dump. In that case, no pair matches and\0a\09\\* the implication is vacuously satisfied.\0a    IN \\A pair \\in trace:\0a            pair[1] = level =>\0a                \\* When loading a trace with a subset of variables, only check the\0a                \\* variables that exist in both the trace and the current state.\0a                \\* This allows trace replay with specs that have different variable\0a                \\* sets than the original spec that produced the trace. Another\0a                \\* scenario is when the spec uses ALIAS to rename, add, or remove\0a                \\* variables.\0a                \\A v \\in vars \\cap DOMAIN _TLCState(level):\0a                        _TLCState(level)[v] = pair[2][v]\0a\0a\\* VIEW for trace replay. Includes TLCGet("level") to prevent premature\0a\\* state collapsing within the trace. For liveness traces, the level\0a\\* beyond the trace is mapped to the lasso target so the cycle can close.\0aLOCAL _TLCTraceView ==\0a    LET level       == TLCGet("level")\0a        trace       == _TLCTraceFileDeserialized["counterexample"]["state"]\0a        lassoTarget == _TLCTraceLassoTarget\0a    IN IF \\E pair \\in trace : pair[1] = level\0a       THEN << level, _TLCState(level) >>\0a       ELSE << lassoTarget, _TLCState(level) >>\0a\0a=============================================================================\0a'
  :-  '_TLCTracePlain'
  '----------------------- MODULE _TLCTracePlain ------------------------\0aLOCAL INSTANCE IOUtils\0aLOCAL INSTANCE TLC\0aLOCAL INSTANCE TLCExt\0aLOCAL INSTANCE Sequences\0aLOCAL INSTANCE SequencesExt\0a\0aCONSTANT _TLCTraceFile\0a\0aLOCAL _TLCTraceModule ==\0a\09LET ModuleName == ReplaceFirstSubSeq("", ".tla", _TLCTraceFile) IN\0a\09"---- MODULE " \\o ModuleName \\o " ----\\n" \\o\0a    "LOCAL INSTANCE TLC\\n\\n" \\o\0a    "Trace == \\n\\t" \\o\0a\09ToString(ToTrace(CounterExample)) \\o\0a    "\\n\\n===="\0a\0a_TLCTrace ==\0a    IF CounterExample.state = {} \\/ ("console" \\in DOMAIN CounterExample /\\ CounterExample["console"] = FALSE) THEN TRUE ELSE\0a        /\\ Serialize(_TLCTraceModule,\0a    \09\09\09_TLCTraceFile,\0a    \09\09\09[\0a    \09\09\09\09format |-> "TXT",\0a    \09\09\09\09charset |-> "UTF-8",\0a    \09\09\09\09openOptions |-> <<"WRITE", "CREATE", "TRUNCATE_EXISTING">>\0a    \09\09\09]\0a           ).exitValue = 0\0a        /\\ PrintT("CounterExample written: " \\o _TLCTraceFile)\0a\0a=============================================================================\0a'
  ==
--
