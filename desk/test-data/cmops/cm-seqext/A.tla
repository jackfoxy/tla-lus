---- MODULE A ----
EXTENDS Naturals, Sequences, SequencesExt
STS == SetToSeq({3, 1, 2})
STSS == SetToSeqs({1, 2})
STSE == SetToSeq({})
Cont == Contains(<<1, 2>>, 2)
ContNo == Contains(<<1, 2>>, 3)
Pre == IsPrefix(<<1>>, <<1, 2>>)
PreNo == IsPrefix(<<2>>, <<1, 2>>)
PreEq == IsPrefix(<<1, 2>>, <<1, 2>>)
LCP == LongestCommonPrefix({<<1, 2, 3>>, <<1, 2, 4>>, <<1, 2>>})
LCPOne == LongestCommonPrefix({<<5, 6>>})
Suf == Suffixes(<<1, 2, 3>>)
ASS == AllSubSeqs(<<1, 2, 3>>)
FL == FoldLeft(LAMBDA a, b : a - b, 10, <<1, 2, 3>>)
FR == FoldRight(LAMBDA a, b : a - b, <<1, 2, 3>>, 10)
FLS == FoldLeft(LAMBDA a, b : a \o <<b>>, <<>>, <<1, 2, 3>>)
FRS == FoldRight(LAMBDA a, b : <<a>> \o b, <<1, 2, 3>>, <<>>)
FS == FoldSeq(LAMBDA x, acc : acc * 10 + x, 0, <<1, 2, 3>>)
FLD == FoldLeftDomain(LAMBDA a, i : a \o <<i>>, <<>>, <<7, 8, 9>>)
FRD == FoldRightDomain(LAMBDA i, a : <<i>> \o a, <<7, 8, 9>>, <<>>)
RF == RemoveFirst(<<1, 2, 1>>, 1)
RFNo == RemoveFirst(<<1, 2>>, 3)
RFM == RemoveFirstMatch(<<1, 2, 3>>, LAMBDA x : x > 1)
SIS == SelectInSeq(<<1, 2, 3, 2>>, LAMBDA x : x = 2)
SISNo == SelectInSeq(<<1, 2>>, LAMBDA x : x = 5)
SISS == SelectInSubSeq(<<1, 2, 3, 2>>, 3, 4, LAMBDA x : x = 2)
SLIS == SelectLastInSeq(<<1, 2, 3, 2>>, LAMBDA x : x = 2)
SLISNo == SelectLastInSeq(<<1, 2>>, LAMBDA x : x = 5)
SLISS == SelectLastInSubSeq(<<2, 1, 2, 3>>, 1, 2, LAMBDA x : x = 2)
====
