        'T number-literal 5.9 5.9 3'
        'T barelevellexeme 6.7 6.9 <+>'
        'T number-literal 6.11 6.11 4'
        'T barelevellexeme 7.7 7.9 <*>'
        'T qed 7.11 7.13 QED'
        'T barelevellexeme 8.5 8.7 <*>'
        'T qed 8.9 8.11 QED'
        'T barelevellexeme 9.3 9.5 <*>'
        'T number-literal 9.7 9.7 5'
