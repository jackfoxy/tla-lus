::  let_in.txt: Invalid Use of LOCAL in LET/IN :error
++  test-let-in-009-invalid-use-of-local-in-let-in-error
  %+  expect-eq
    !>  ^-  wain
    :~
        'ACCEPT'
        'n-module 1.1-3.4'
        '  n-beginmodule 1.1-1.29'
        '    bm1 1.1-1.11 ---- MODULE'
        '    identifier 1.13-1.24 LocalInLetIn'
        '    separator 1.26-1.29 ----'
        '  n-extends ~ N_Extends'
        '  n-body 2.1-2.33'
        '    n-operatordefinition 2.1-2.33'
        '      n-identlhs 2.1-2.3'
        '        identifier 2.1-2.3 foo'
        '      def 2.5-2.6 =='
        '      n-letin 2.8-2.33'
        '        let 2.8-2.10 LET'
        '        n-letdefinitions 2.12-2.25'
        '          n-operatordefinition 2.12-2.25'
        '            local 2.12-2.16 LOCAL'
        '            n-identlhs 2.18-2.20'
        '              identifier 2.18-2.20 bar'
        '            def 2.22-2.23 =='
        '            n-number 2.25-2.25'
        '              number-literal 2.25-2.25 5'
        '        letin 2.27-2.28 IN'
        '        n-generalid 2.30-2.33'
        '          n-idprefix ~ N_IdPrefix'
        '          identifier 2.30-2.33 TRUE'
        '  n-endmodule 3.1-3.4'
        '    end-module 3.1-3.4 ===='
    ==
