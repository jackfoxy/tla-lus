::  GENERATED by tools/gen-mc-tests.py -- do not edit.
::  Expected values are normalized tlc2.TLC output at the pinned commit.
/+  *test
/=  check  /lib/tla/check
|%
++  trim
  ::  drop blank lines; TLC's blank separators between trace states carry
  ::  no information and the captured golden has them removed
  |=  w=wain
  ^-  wain
  (skip w |=(l=@t =('' l)))
::
++  test-mc-cyc
  %+  expect-eq
    !>  ^-  wain
    :~
        'Model checking completed. No error has been found.'
        '5 states generated, 4 distinct states found, 0 states left on queue.'
        'The depth of the complete state graph search is 4.'
    ==
  !>
  %-  trim
  %+  check:check
    '---- MODULE spec ----\0aEXTENDS Naturals\0aVARIABLE x\0aInit == x = 0\0aNext == x\' = (x + 1) % 4\0aInv == x < 4\0a====\0a'
  'INIT Init\0aNEXT Next\0aINVARIANT Inv\0a'
::
++  test-mc-invfail
  %+  expect-eq
    !>  ^-  wain
    :~
        'Error: Invariant Inv is violated.'
        'Error: The behavior up to this point is:'
        'State 1: <Initial predicate>'
        'x = 0'
        'State 2: <Next line 5, col 9 to line 5, col 18 of module spec>'
        'x = 1'
        'State 3: <Next line 5, col 9 to line 5, col 18 of module spec>'
        'x = 2'
        'State 4: <Next line 5, col 9 to line 5, col 18 of module spec>'
        'x = 3'
        '4 states generated, 4 distinct states found, 0 states left on queue.'
        'The depth of the complete state graph search is 4.'
    ==
  !>
  %-  trim
  %+  check:check
    '---- MODULE spec ----\0aEXTENDS Naturals\0aVARIABLE x\0aInit == x = 0\0aNext == x\' = x + 1\0aInv == x < 3\0a====\0a'
  'INIT Init\0aNEXT Next\0aINVARIANT Inv\0a'
::
++  test-mc-live-box
  %+  expect-eq
    !>  ^-  wain
    :~
        'Error: Temporal property Prop was violated.'
        'Error: The following behavior constitutes a counter-example:'
        'State 1: <Initial predicate>'
        'x = 0'
        'State 2: Stuttering'
        '3 states generated, 2 distinct states found, 0 states left on queue.'
        'The depth of the complete state graph search is 2.'
    ==
  !>
  %-  trim
  %+  check:check
    '---- MODULE spec ----\0aEXTENDS Integers\0aVARIABLE x\0aInit == x = 0\0aNext == x\' = 1 - x\0aProp == []<>(x = 2)\0a====\0a'
  'INIT Init\0aNEXT Next\0aPROPERTY Prop\0a'
::
++  test-mc-live-diamond
  %+  expect-eq
    !>  ^-  wain
    :~
        'Error: Temporal property Prop was violated.'
        'Error: The following behavior constitutes a counter-example:'
        'State 1: <Initial predicate>'
        'x = 0'
        'State 2: Stuttering'
        '5 states generated, 2 distinct states found, 0 states left on queue.'
        'The depth of the complete state graph search is 2.'
    ==
  !>
  %-  trim
  %+  check:check
    '---- MODULE spec ----\0aEXTENDS Integers\0aVARIABLE x\0aInit == x = 0\0aNext == \\/ x\' = x\0a        \\/ x\' = 1\0aProp == <>(x = 1)\0a====\0a'
  'INIT Init\0aNEXT Next\0aPROPERTY Prop\0a'
::
++  test-mc-twobit
  %+  expect-eq
    !>  ^-  wain
    :~
        'Model checking completed. No error has been found.'
        '9 states generated, 4 distinct states found, 0 states left on queue.'
        'The depth of the complete state graph search is 3.'
    ==
  !>
  %-  trim
  %+  check:check
    '---- MODULE spec ----\0aVARIABLES a, b\0aInit == a = FALSE /\\ b = FALSE\0aNext == \\/ a\' = ~a /\\ b\' = b\0a        \\/ b\' = ~b /\\ a\' = a\0aInv == TRUE\0a====\0a'
  'INIT Init\0aNEXT Next\0aINVARIANT Inv\0a'
