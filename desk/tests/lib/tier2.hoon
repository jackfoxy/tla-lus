      ['Calculator' '------------------- MODULE Calculator ----------------------\0aEXTENDS Integers, CSV, TLC, IOUtils\0a\0aVARIABLE x\0a\0aInit ==\0a    x = 0\0a\0aInc ==\0a    x\' = x + 1\0a\0aDec ==\0a    x\' = x - 1\0a\0aMul ==\0a    x\' = x * 2\0a\0aDiv ==\0a    x\' = x \\div 2\0a\0aRst ==\0a    x\' = 0\0a\0aStutt ==\0a    x\' = x\0a\0aDis ==\0a    /\\ x < 0\0a    /\\ x\' = x * (-1)\0a    \0aNext ==\0a    \\/ Inc\0a    \\/ Dec\0a    \\/ Mul\0a    \\/ Div\0a    \\/ Rst\0a\\*    \\/ Stutt\0a\\*    \\/ Dis\0a\0a------------------------------------------------------------\0a\0aReward ==\0a\09atoi(IOEnv.R)\0a\0aStats ==\0a    LET conf   == [ e \\in {"mode", "sched", "depth"} |-> TLCGet("config")[e] ]\0a        stats  == [ e \\in {"traces", "duration", "generated", "distinct", "retries", "levelmean", "levelvariance"} |-> TLCGet("stats")[e] ]\0a        actions == TLCGet("stats").actions\0a    IN CSVWriteRecord([ts|-> JavaTime, note |-> IOEnv.N, reward |-> atoi(IOEnv.R)] @@ conf @@ stats @@ actions, "#", CSVRecords("Calculator.csv") = 0, "Calculator.csv")\0a\0a============================================================']
  ==
