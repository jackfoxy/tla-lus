      ['Github807' %accept ~[['Github807' '---------------------------- MODULE Github807 ---------------------------\0aEXTENDS Naturals, TLCExt, TLC\0aVARIABLE x\0a\0aInit == x = 0\0a\0aAdd(d,n) ==\0a    /\\ x\' = x + d\0a    /\\ x\' <= 10\0a\0aNext(r) ==\0a    LET d == IF x = x THEN 1 ELSE 1\0a    IN Add(d,r)\0a\0aIsNotTwo == x # 2\0a\0aSpec == Init /\\ [][Next(1)]_x\0a\0aPostCondition ==\0a       /\\ CounterExample =\0a                       [ action |->\0a                             { << <<1, [x |-> 0]>>,\0a                                  [ name |-> "Add",\0a                                    location |->\0a                                        [ beginLine |-> 13,\0a                                          beginColumn |-> 8,\0a                                          endLine |-> 13,\0a                                          endColumn |-> 15,\0a                                          module |-> "Github807" ] ],\0a                                  <<2, [x |-> 1]>> >>,\0a                               << <<2, [x |-> 1]>>,\0a                                  [ name |-> "Add",\0a                                    location |->\0a                                        [ beginLine |-> 13,\0a                                          beginColumn |-> 8,\0a                                          endLine |-> 13,\0a                                          endColumn |-> 15,\0a                                          module |-> "Github807" ] ],\0a                                  <<3, [x |-> 2]>> >> },\0a                         state |-> {<<1, [x |-> 0]>>, <<2, [x |-> 1]>>, <<3, [x |-> 2]>>} ]\0a       /\\ TLCGet("spec") =\0a\09\09\09\09       [ impliedinits |-> {}, impliedactions |-> {},\0a\09\09\09\09  invariants |->\0a\09\09\09\09      { [ name |-> "IsNotTwo",\0a\09\09\09\09          location |->\0a\09\09\09\09              [ beginLine |-> 15,\0a\09\09\09\09                beginColumn |-> 13,\0a\09\09\09\09                endLine |-> 15,\0a\09\09\09\09                endColumn |-> 17,\0a\09\09\09\09                module |-> "Github807" ],\0a\09\09\09\09          coverage |-> [count |-> 3] ] },\0a\09\09\09\09  impliedtemporals |-> {},\0a\09\09\09\09  temporals |-> {},\0a\09\09\09\09  actions |->\0a\09\09\09\09      { [ name |-> "Add",\0a\09\09\09\09          location |->\0a\09\09\09\09              [ beginLine |-> 13,\0a\09\09\09\09                beginColumn |-> 8,\0a\09\09\09\09                endLine |-> 13,\0a\09\09\09\09                endColumn |-> 15,\0a\09\09\09\09                module |-> "Github807" ],\0a\09\09\09\09          coverage |-> [generated |-> 6, distinct |-> 2] ] },\0a\09\09\09\09  inits |->\0a\09\09\09\09      { [ name |-> "Init",\0a\09\09\09\09          location |->\0a\09\09\09\09              [ beginLine |-> 5,\0a\09\09\09\09                beginColumn |-> 9,\0a\09\09\09\09                endLine |-> 5,\0a\09\09\09\09                endColumn |-> 13,\0a\09\09\09\09                module |-> "Github807" ],\0a\09\09\09\09          coverage |-> [generated |-> 3, distinct |-> 3] ] },\0a\09\09\09\09  variables |->\0a\09\09\09\09      { [ name |-> "x",\0a\09\09\09\09          coverage |-> [distinct |-> 1],\0a\09\09\09\09          location |->\0a\09\09\09\09              [ beginLine |-> 3,\0a\09\09\09\09                beginColumn |-> 10,\0a\09\09\09\09                endLine |-> 3,\0a\09\09\09\09                endColumn |-> 10,\0a\09\09\09\09                module |-> "Github807" ] ] },\0a\09\09\09\09  actionconstraints |-> {},\0a\09\09\09\09  constraints |-> {} ]\0a==============================================================================\0a---------------------------- CONFIG Github807 ----------------------------\0aSPECIFICATION Spec\0a\0aINVARIANT IsNotTwo\0a\0aPOSTCONDITION PostCondition\0a===========================================================================\0a']]]
      ['Github819' %accept ~[['Github819' '---------------------------- MODULE Github819 ---------------------------\0aEXTENDS Naturals\0a  \0aVARIABLES i\0a\0aInit == i = 0\0aNext == i < 5 /\\ i\' = i + 1\0a\0aSpec == Init /\\ [][Next]_i\0a\0a--------------------------\0a(*** Liveness ***)\0a\0aTestFailing ==\0a  \\A x \\in {} :\0a    []<>TRUE\0a\0aTestSucceeding ==\0a  \\A x \\in {42} :\0a    []<>TRUE\0a\0aLive ==\0a  \\* This condition causes liveness checking to fail with the error:\0a  \\*  "Temporal formulas containing actions must be of forms <>[]A or []<>A."\0a  \\* \0a  \\* If you comment this condition out, you\'ll see that liveness checking\0a  \\* succeeds.\0a  /\\ TestFailing\0a\0a  \\*/\\ TestSucceeding\0a==========================================================================\0a---------------------------- CONFIG Github819 ----------------------------\0aSPECIFICATION Spec\0a\0aPROPERTY Live\0a===========================================================================\0a']]]
      ['Github849' %accept ~[['Github849' '---------------------------- MODULE Github849 ---------------------------\0a\0aCONSTANTS\0a    Nodes\0a\0aVARIABLES\0a    n,\0a    node_set\0a\0aTypeOK ==\0a    /\\ n = 1\0a\0aInit ==\0a    /\\ n = 1\0a    /\\ node_set = {}\0a\0aNext ==\0a    /\\ n\' = 2\0a    /\\ node_set\' = {v \\in SUBSET Nodes : FALSE}\0a\0a==========================================================================\0a---------------------------- CONFIG Github849 ----------------------------\0a\0aINIT Init\0aNEXT Next\0a\0aCONSTANT Nodes = {A1}\0a\0aCHECK_DEADLOCK FALSE\0aINVARIANT TypeOK\0a\0a===========================================================================\0a']]]
      ['Github866' %accept ~[['Github866' '---------------------------- MODULE Github866 ---------------------------\0aEXTENDS Naturals, TLC\0a\0a\\* Test requires at least two workers.\0aASSUME TLCGet("config").worker > 1\0a\0ar == 0\0a\0a\\* Initialize the register to a value *outside* of X.\0aASSUME TLCSet(r, {0})\0a\0a\\* At startup, SpecProcessor evaluates X. The likelihood that two or more\0a\\* workers will evaluate X differently is proportional to the size of the\0a\\* input set provided to RandomElement.\0aX ==\0a  \\* The value that RandomElement evaluates to has to be nested in a TLC \0a  \\* IValue instance that may change its internal representation during\0a  \\* normalization/fingerprinting (see IValue#mutates). Otherwise,\0a  \\* WorkerValue#demux becomes a no-op.\0a  {RandomElement(1..10000)}\0a\0a-------------------------------------------------------------------------\0a\0aVARIABLES x\0a\0aInit ==\0a  x = 0\0a\0aNext ==\0a  \\* Keep going until all workers have evaluated next.\0a  /\\ \\E w \\in 1..TLCGet("config").worker: \0a          TLCGet("all")[r][w] = {0}\0a  /\\ x\' = x + 1\0a  \\* Set the register value r to the worker-specific value of X.\0a  /\\ TLCSet(r, X)\0a\0aSpec ==\0a  Init /\\ [][Next]_x\0a\0a-------------------------------------------------------------------------\0a\0aPostCondition ==\0a  /\\ PrintT(TLCGet("all")[r])\0a  /\\ \\A v,w \\in 1..TLCGet("config").worker:\0a       /\\ TLCGet("all")[r][v] # {0}\0a       /\\ TLCGet("all")[r][v] = TLCGet("all")[r][w]\0a  /\\ TLCGet("spec") = \0a\09\09\09\09[ impliedinits |-> {},\0a\09\09\09\09  impliedactions |-> {},\0a\09\09\09\09  invariants |-> {},\0a\09\09\09\09  impliedtemporals |-> {},\0a\09\09\09\09  temporals |-> {},\0a\09\09\09\09  actions |->\0a\09\09\09\09      { [ name |-> "Next",\0a\09\09\09\09          location |->\0a\09\09\09\09              [ beginLine |-> 31,\0a\09\09\09\09                beginColumn |-> 3,\0a\09\09\09\09                endLine |-> 35,\0a\09\09\09\09                endColumn |-> 17,\0a\09\09\09\09                module |-> "Github866" ] ] },\0a\09\09\09\09  inits |->\0a\09\09\09\09      { [ name |-> "Init",\0a\09\09\09\09          location |->\0a\09\09\09\09              [ beginLine |-> 27,\0a\09\09\09\09                beginColumn |-> 3,\0a\09\09\09\09                endLine |-> 27,\0a\09\09\09\09                endColumn |-> 7,\0a\09\09\09\09                module |-> "Github866" ] ] },\0a\09\09\09\09  variables |->\0a\09\09\09\09      { [ name |-> "x",\0a\09\09\09\09          location |->\0a\09\09\09\09              [ beginLine |-> 24,\0a\09\09\09\09                beginColumn |-> 11,\0a\09\09\09\09                endLine |-> 24,\0a\09\09\09\09                endColumn |-> 11,\0a\09\09\09\09                module |-> "Github866" ] ] },\0a\09\09\09\09  actionconstraints |->\0a\09\09\09\09      { [ name |-> "ActionConstraint",\0a\09\09\09\09          location |->\0a\09\09\09\09              [ beginLine |-> 95,\0a\09\09\09\09                beginColumn |-> 1,\0a\09\09\09\09                endLine |-> 95,\0a\09\09\09\09                endColumn |-> 30,\0a\09\09\09\09                module |-> "Github866" ] ] },\0a\09\09\09\09  constraints |->\0a\09\09\09\09      { [ name |-> "Constraint",\0a\09\09\09\09          location |->\0a\09\09\09\09              [ beginLine |-> 94,\0a\09\09\09\09                beginColumn |-> 1,\0a\09\09\09\09                endLine |-> 94,\0a\09\09\09\09                endColumn |-> 23,\0a\09\09\09\09                module |-> "Github866" ] ] } ]\0a\09\09\09\09  \0aConstraint == x \\in Nat\0aActionConstraint == x\' \\in Nat\0a\0aASSUME TLCGet("-Dfile.separator") \\in {"/", "\\\\"}\0aASSUME TLCGet("-Dasdiftb872w7t4ergvsivc") = "-Dasdiftb872w7t4ergvsivc"\0a==========================================================================\0a---------------------------- CONFIG Github866 ----------------------------\0aSPECIFICATION Spec\0aPOSTCONDITION PostCondition\0aCONSTRAINT Constraint\0aACTION_CONSTRAINT ActionConstraint\0a==========================================================================\0a']]]
      ['Github971' %accept ~[['Github971' '---- MODULE Github971 ----\0aEXTENDS Integers\0a\0aVARIABLE x\0a\0aInitA ==\0a    x = 0\0a\0aInitB ==\0a    x = -1\0a\0aNextAB ==\0a    x\' \\in {0,1} \0a\0aNextC ==\0a    NextAB \\/ x\' = 2\0a\0aAtMostOnce ==\0a    []((x=1) => []((x=0) => [](x=0)))\0a\0aAtMostOnceC ==\0a    []((x=1) => []((x=0) => [](x=2)))\0a\0aSpec ==\0a    InitA /\\ [][NextAB]_x /\\ WF_x(NextAB)\0a\0aLeadsTo ==\0a    \\* lasso shaped counterexample/liveness property\0a    x = 0 ~> [](x = 1 => [](x = 1)) \0a\0aTautology == (x = x) ~> (x = x)\0a==========================\0a\0afp(x =-1) =  3234510876920644087\0afp(x = 0) = -3406341414084290173\0afp(x = 1) =  -686636423115914061\0afp(x = 2) = -7115858903467826205']]]
      ['Github971e' %accept ~[['Github971e' '---- MODULE Github971e ----\0aEXTENDS Integers\0a\0aVARIABLE x, y\0avars == <<x, y>>\0a\0aInit ==\0a    x = 0 /\\ y = "a"\0a\0aNext ==\0a    x\' \\in {0,1} /\\ y\' \\in {"a", "b"}\0a\0aSpec ==\0a    Init /\\ [][Next]_x /\\ WF_x(Next)\0a\0aLeadsTo ==\0a    \\* lasso shaped counterexample/liveness property\0a    x = 0 ~> [](x = 1 => [](y = "a")) \0a\0aTautology == (vars = vars) ~> (vars = vars)\0a==========================\0a']]]
