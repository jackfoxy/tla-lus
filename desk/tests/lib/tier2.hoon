0a<Invariant line 111, col 1 to line 111, col 9 of module QueensPluscal>\0a@!@!@ENDMSG 2774 @!@!@\0a@!@!@STARTMSG 2221:0 @!@!@\0a  line 112, col 3 to line 113, col 42 of module QueensPluscal: 19\0a@!@!@ENDMSG 2221 @!@!@\0a@!@!@STARTMSG 2221:0 @!@!@\0a  |line 112, col 6 to line 112, col 29 of module QueensPluscal: 19\0a@!@!@ENDMSG 2221 @!@!@\0a@!@!@STARTMSG 2221:0 @!@!@\0a  |line 113, col 6 to line 113, col 42 of module QueensPluscal: 19\0a@!@!@ENDMSG 2221 @!@!@\0a@!@!@STARTMSG 2221:0 @!@!@\0a  ||line 113, col 6 to line 113, col 14 of module QueensPluscal: 19\0a@!@!@ENDMSG 2221 @!@!@\0a@!@!@STARTMSG 2221:0 @!@!@\0a  ||line 113, col 19 to line 113, col 42 of module QueensPluscal: 1\0a@!@!@ENDMSG 2221 @!@!@\0a@!@!@STARTMSG 2202:0 @!@!@\0aEnd of statistics.\0a@!@!@ENDMSG 2202 @!@!@\0a@!@!@STARTMSG 2200:0 @!@!@\0aProgress(7) at 2020-01-28 16:51:32: 33 states generated (968 s/min), 19 distinct states found (557 ds/min), 2 states left on queue.\0a@!@!@ENDMSG 2200 @!@!@\0a@!@!@STARTMSG 2199:0 @!@!@\0a33 states generated, 19 distinct states found, 2 states left on queue.\0a@!@!@ENDMSG 2199 @!@!@\0a@!@!@STARTMSG 2194:0 @!@!@\0aThe depth of the complete state graph search is 7.\0a@!@!@ENDMSG 2194 @!@!@\0a@!@!@STARTMSG 2268:0 @!@!@\0aThe average outdegree of the complete state graph is 1 (minimum is 0, the maximum 3 and the 95th percentile is 3).\0a@!@!@ENDMSG 2268 @!@!@\0a@!@!@STARTMSG 1000:0 @!@!@\0aThe model check run produced error-states - we will generate the SpecTE files now.\0a@!@!@ENDMSG 1000 @!@!@\0a@!@!@STARTMSG 1000:0 @!@!@\0aThe file /Users/loki/arbeit/microsoft/dev/tlaplus/runtime-org.lamport.tla.toolbox.product.product.product/QueensPluscal_1579286757638/QueensPluscal.toolbox/FourQueens/SpecTE.tla has been created.\0a@!@!@ENDMSG 1000 @!@!@\0a@!@!@STARTMSG 1000:0 @!@!@\0aThe file /Users/loki/arbeit/microsoft/dev/tlaplus/runtime-org.lamport.tla.toolbox.product.product.product/QueensPluscal_1579286757638/QueensPluscal.toolbox/FourQueens/SpecTE.cfg has been created.\0a@!@!@ENDMSG 1000 @!@!@\0a@!@!@STARTMSG 2186:0 @!@!@\0aFinished in 2069ms at (2020-01-28 16:51:32)\0a@!@!@ENDMSG 2186 @!@!@\0a---- MODULE SpecTE ----\0aEXTENDS Sequences, Toolbox, TLC, Naturals\0a\0a\\* \0a\\*  QueensPluscal follows\0a\\* \0a\0a(***************************************************************************)\0a(* Formulation of the N-queens problem and an iterative algorithm to solve *)\0a(* the problem in TLA+. Since there must be exactly one queen in every row *)\0a(* we represent placements of queens as functions of the form              *)\0a(*    queens \\in [ 1..N -> 1..N ]                                          *)\0a(* where queens[i] gives the column of the queen in row i. Note that such  *)\0a(* a function is just a sequence of length N.                              *)\0a(* We will also consider partial solutions, also represented as sequences  *)\0a(* of length \\leq N.                                                       *)\0a(***************************************************************************)\0a\0aCONSTANT N             \\** number of queens and size of the board\0aASSUME N \\in Nat \\ {0}\0a\0a(* The following predicate determines if queens i and j attack each other\0a   in a placement of queens (represented by a sequence as above). *)\0aAttacks(queens,i,j) ==\0a  \\/ queens[i] = queens[j]                 \\** same column\0a  \\/ queens[i] - queens[j] = i - j         \\** first diagonal\0a  \\/ queens[j] - queens[i] = i - j         \\** second diagonal\0a\0a(* A placement represents a (partial) solution if no two different queens\0a   attack each other in it. *)\0aIsSolution(queens) ==\0a  \\A i \\in 1 .. Len(queens)-1 : \\A j \\in (i - 1) .. Len(queens) : \0a       ~ Attacks(queens,i,j) \0a\0a(* Compute the set of solutions of the N-queens problem. *)\0aSolutions == { queens \\in [1..N -> 1..N] : IsSolution(queens) }\0a\0a(***************************************************************************)\0a(* We now describe an algorithm that iteratively computes the set of       *)\0a(* solutions of the N-queens problem by successively placing queens.       *)\0a(* The current state of the algorithm is given by two variables:           *)\0a(* - todo contains a set of partial solutions,                             *)\0a(* - sols contains the set of full solutions found so far.                 *)\0a(* At every step, the algorithm picks some partial solution and computes   *)\0a(* all possible extensions by the next queen. If N queens have been placed *)\0a(* these extensions are in fact full solutions, otherwise they are added   *)\0a(* to the set todo.                                                        *)\0a(***************************************************************************)\0a\0a(* --algorithm Queens\0a     variables\0a       todo = { << >> };\0a       sols = {};\0a\0a     begin\0anxtQ:  while todo # {}\0a       do\0a         with queens \\in todo,\0a              nxtQ = Len(queens) + 1,\0a              cols = { c \\in 1..N : ~ \\E i \\in 1 .. Len(queens) :\0a                                      Attacks( Append(queens, c), i, nxtQ ) },\0a              exts = { Append(queens,q) : q \\in cols }\0a         do\0a           if (nxtQ = N)\0a           then todo := todo \\ {queens}; sols := sols \\union exts;\0a           else todo := (todo \\ {queens}) \\union exts;\0a           end if;\0a         end with;\0a       end while;\0a     end algorithm\0a*)\0a\\* BEGIN TRANSLATION - the hash of the PCal code: PCal-2ed860b26a15ec8be61ed184eb8c9ae0\0aVARIABLES todo, sols, pc\0a\0avars == << todo, sols, pc >>\0a\0aInit == (* Global variables *)\0a        /\\ todo = { << >> }\0a        /\\ sols = {}\0a        /\\ pc = "nxtQ"\0a\0anxtQ == /\\ pc = "nxtQ"\0a        /\\ IF todo # {}\0a              THEN /\\ \\E queens \\in todo:\0a                        LET nxtQ == Len(queens) + 1 IN\0a                          LET cols == { c \\in 1..N : ~ \\E i \\in 1 .. Len(queens) :\0a                                                       Attacks( Append(queens, c), i, nxtQ ) } IN\0a                            LET exts == { Append(queens,q) : q \\in cols } IN\0a                              IF (nxtQ = N)\0a                                 THEN /\\ todo\' = todo \\ {queens}\0a                                      /\\ sols\' = (sols \\union exts)\0a                                 ELSE /\\ todo\' = ((todo \\ {queens}) \\union exts)\0a                                      /\\ sols\' = sols\0a                   /\\ pc\' = "nxtQ"\0a              ELSE /\\ pc\' = "Done"\0a                   /\\ UNCHANGED << todo, sols >>\0a\0a(* Allow infinite stuttering to prevent deadlock on termination. *)\0aTerminating == pc = "Done" /\\ UNCHANGED vars\0a\0aNext == nxtQ\0a           \\/ Terminating\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aTermination == <>(pc = "Done")\0a\0a\\* END TRANSLATION - the hash of the generated TLA code (remove to silence divergence warnings): TLA-fcc4c3104f960f6e4881fc76793c3cb5\0a\0aTypeInvariant ==\0a  /\\ todo \\in SUBSET Seq(1 .. N) /\\ \\A s \\in todo : Len(s) < N\0a  /\\ sols \\in SUBSET Seq(1 .. N) /\\ \\A s \\in sols : Len(s) = N\0a\0a(* The set of sols contains only solutions, and contains all solutions\0a   when todo is empty. *)\0aInvariant ==\0a  /\\ sols \\subseteq Solutions\0a  /\\ todo = {} => Solutions \\subseteq sols\0a\0a(* Assert that no solutions are ever computed so that TLC displays one *)\0aNoSolutions == sols = {}\0a\0a(* Add a fairness condition to ensure progress as long as todo is nonempty *)\0aLiveness == WF_vars(nxtQ)\0aLiveSpec == Spec /\\ Liveness\0a\0a\0a\\* \0a\\*  SpecTE follows\0a\\* \0a\0a\0a\\* CONSTANT definitions @modelParameterConstants:0N\0aconst_158025887640018000 == \0a3\0a----\0a\0a\\* TRACE Sub-Action definition 0\0aLiveSpec_sa_0 ==\0a    (\0a        /\\ todo = ({<<>>})\0a        /\\ sols = ({})\0a        /\\ pc = ("nxtQ")\0a        /\\ todo\' = ({<<1>>, <<2>>, <<3>>})\0a        /\\ sols\' = ({})\0a        /\\ pc\' = ("nxtQ")\0a    )\0a\0a\\* TRACE Sub-Action definition 1\0aLiveSpec_sa_1 ==\0a    (\0a        /\\ todo = ({<<1>>, <<2>>, <<3>>})\0a        /\\ sols = ({})\0a        /\\ pc = ("nxtQ")\0a        /\\ todo\' = ({<<2>>, <<3>>, <<1, 3>>})\0a        /\\ sols\' = ({})\0a        /\\ pc\' = ("nxtQ")\0a    )\0a\0a\\* TRACE Sub-Action definition 2\0aLiveSpec_sa_2 ==\0a    (\0a        /\\ todo = ({<<2>>, <<3>>, <<1, 3>>})\0a        /\\ sols = ({})\0a        /\\ pc = ("nxtQ")\0a        /\\ todo\' = ({<<3>>, <<1, 3>>})\0a        /\\ sols\' = ({})\0a        /\\ pc\' = ("nxtQ")\0a    )\0a\0a\\* TRACE Sub-Action definition 3\0aLiveSpec_sa_3 ==\0a    (\0a        /\\ todo = ({<<3>>, <<1, 3>>})\0a        /\\ sols = ({})\0a        /\\ pc = ("nxtQ")\0a        /\\ todo\' = ({<<1, 3>>, <<3, 1>>})\0a        /\\ sols\' = ({})\0a        /\\ pc\' = ("nxtQ")\0a    )\0a\0a\\* TRACE Sub-Action definition 4\0aLiveSpec_sa_4 ==\0a    (\0a        /\\ todo = ({<<1, 3>>, <<3, 1>>})\0a        /\\ sols = ({})\0a        /\\ pc = ("nxtQ")\0a        /\\ todo\' = ({<<3, 1>>})\0a        /\\ sols\' = ({})\0a        /\\ pc\' = ("nxtQ")\0a    )\0a\0a\\* TRACE Sub-Action definition 5\0aLiveSpec_sa_5 ==\0a    (\0a        /\\ todo = ({<<3, 1>>})\0a        /\\ sols = ({})\0a        /\\ pc = ("nxtQ")\0a        /\\ todo\' = ({})\0a        /\\ sols\' = ({})\0a        /\\ pc\' = ("nxtQ")\0a    )\0a\0a\\* TRACE Action Constraint definition traceExploreActionConstraint\0a_SpecTEActionConstraint ==\0a<<\0aLiveSpec_sa_0,\0aLiveSpec_sa_1,\0aLiveSpec_sa_2,\0aLiveSpec_sa_3,\0aLiveSpec_sa_4,\0aLiveSpec_sa_5\0a>>[TLCGet("level")]\0a----\0a\0adef_ov_15802590929252000 == \0a<<\0a([todo |-> {<<>>},sols |-> {},pc |-> "nxtQ"]),\0a([todo |-> {<<1>>, <<2>>, <<3>>},sols |-> {},pc |-> "nxtQ"]),\0a([todo |-> {<<2>>, <<3>>, <<1, 3>>},sols |-> {},pc |-> "nxtQ"]),\0a([todo |-> {<<3>>, <<1, 3>>},sols |-> {},pc |-> "nxtQ"]),\0a([todo |-> {<<1, 3>>, <<3, 1>>},sols |-> {},pc |-> "nxtQ"]),\0a([todo |-> {<<3, 1>>},sols |-> {},pc |-> "nxtQ"]),\0a([todo |-> {},sols |-> {},pc |-> "nxtQ"])\0a>>\0a----\0a\0a\0a\\* VARIABLE TraceExp\0a\0a\\* TRACE INIT definition traceExploreInit\0a_SpecTEInit ==\0a    /\\ todo = (\0a            {<<>>}\0a        )\0a    /\\ sols = (\0a            {}\0a        )\0a    /\\ pc = (\0a            "nxtQ"\0a        )\0a\\*     /\\ TraceExp = TRUE\0a\0a----\0a\0a\\* TRACE NEXT definition traceExploreNext\0a_SpecTENext ==\0a/\\  \\/ LiveSpec_sa_0\0a    \\/ LiveSpec_sa_1\0a    \\/ LiveSpec_sa_2\0a    \\/ LiveSpec_sa_3\0a    \\/ LiveSpec_sa_4\0a    \\/ LiveSpec_sa_5\0a\\* /\\ TraceExp\' = TraceExp\0a\0a\0a\0a=============================================================================\0a\\* Modification History\0a\\* Created Tue Jan 28 16:47:56 PST 2020 by loki\0a']]]
      ['PossibleFail' %accept ~[['PossibleFail' '---- MODULE PossibleFail ----\0aEXTENDS Naturals\0aVARIABLE x\0a\0aInit == x = 0\0a\0aNext == x\' = (x + 1) % 3\0a\0a\\* State-level predicates.\0aAtOne       == x = 1\0aAllDone     == x = 2\0aUnreachable == x = 5     \\* never true: reachable values of x are 0, 1, 2\0a\0a\\* Action-level predicates.\0aWrapAround == x = 2 /\\ x\' = 0\0aBigJump    == x\' = x + 2 \\* never true: Next only increments x by 1 mod 3\0a\0aSpec == Init /\\ [][Next]_x\0a\0a\\* Used by PossibleFailNoTransTest to exercise the edge case where there are\0a\\* no transitions at all (only initial states).  Action-level predicates wired\0a\\* through actionConstraints are never evaluated for such a spec, so the name\0a\\* is never inserted into _Counts -- _CheckName must still report the failure.\0aNoNext       == FALSE\0aSpecOnlyInit == Init /\\ [][NoNext]_x\0a====\0a']]]
      ['PossibleTest' %accept ~[['PossibleTest' '---- MODULE PossibleTest ----\0aEXTENDS Naturals, TLC\0aVARIABLE x\0a\0aInit == x = 0\0a\0aNext == x\' = (x + 1) % 3\0a\0aAllDone == x = 2\0a\0aAtOne == x = 1\0a\0aWrapAround == x = 2 /\\ x\' = 0\0a\0aSpec == Init /\\ [][Next]_x\0a\0aPossibleCounts ==\0a    LET p == TLCGet("all:named")["s:_possible"][1]\0a    IN /\\ p["AllDone"] = 1\0a       /\\ p["AtOne"] = 1\0a       /\\ p["WrapAround"] = 1\0a====\0a']]]
      ['PostConditionsTest' %accept ~[['PostConditionsTest' '---- MODULE PostConditionsTest ----\0aEXTENDS Naturals, TLC\0aVARIABLE x\0a\0aInit == x = 0\0a\0aNext == x < 3 /\\ x\' = x + 1\0a\0aSpec == Init /\\ [][Next]_x\0a\0aPost1 == TLCSet(100, TLCGet("generated"))\0a\0aPost2 == TLCSet(101, TLCGet("distinct"))\0a\0aPostFail == TLCGet("distinct") = 42\0a\0aAtTwo == x = 2\0a\0aLastStep == x = 2 /\\ x\' = 3\0a\0aPossibleCounts ==\0a    LET p == TLCGet("all:named")["s:_possible"][1]\0a    IN /\\ p["AtTwo"] = 1\0a       /\\ p["LastStep"] = 1\0a====\0a']]]
      ['RandomElement' %accept ~[['RandomElement' '--------------------------- MODULE RandomElement ---------------------------\0aEXTENDS Integers, TLC\0a\0aVARIABLE x, y\0a\0aInit == /\\ x = RandomElement(1..1000)\0a        /\\ y = 0\0a\0aNext == /\\ \\/ x\' = RandomElement(1..1000)\0a           \\/ x\' = x\0a        /\\ y\' = y + 1\0a        \0a\0aSpec == Init /\\ [][Next]_<<x,y>>\0a\0aInv == y < 10\0a=============================================================================\0a']]]
      ['RandomElementXandY' %accept ~[['RandomElementXandY' '--------------------------- MODULE RandomElementXandY ---------------------------\0aEXTENDS Integers, TLC\0a\0aVARIABLE x, y\0a\0aInit == /\\ x = 0\0a        /\\ y = 0\0a\0aNext == /\\ x\' = RandomElement(0..1)\0a        /\\ y\' = RandomElement(0..1)\0a        \0a\0aSpec == Init /\\ [][Next]_<<x,y>>\0a\0aInv == x = y\0a=============================================================================\0a']]]
      ['RandomSubset' %accept ~[['RandomSubset' '--------------------------- MODULE RandomSubset ---------------------------\0aEXTENDS Integers, Randomization\0a\0aVARIABLE x, y, z\0a\0aInit == /\\ x \\in RandomSubset(1001, 1..100000000)\0a        /\\ y \\in RandomSubset(2, 100000000..100000010)\0a        /\\ z = TRUE\0a\0aNext == /\\ UNCHANGED <<x, y>>\0a        /\\ z\' = FALSE\0a        \0a\0aSpec == Init /\\ [][Next]_<<x,y,z>>\0a\0aInv == z = TRUE\0a=============================================================================\0a']]]
      ['RandomSubsetNext' %accept ~[['RandomSubsetNext' '------------------------- MODULE RandomSubsetNext -------------------------\0aEXTENDS Integers, Randomization\0a\0aVARIABLE x, y\0a\0aInit == /\\ x \\in RandomSubset(10, 1..1000)\0a        /\\ y = 0\0a\0aNext == /\\ x\'\\in RandomSubset(10, 1..1000)\0a        /\\ y\' = y + 1\0a        \0aSpec == Init /\\ [][Next]_<<x,y>>\0a\0aInv == y < 10\0a=============================================================================\0a']]]
      ['RandomSubsetSetOfFcns' %accept ~[['RandomSubsetSetOfFcns' '--------------------------- MODULE RandomSubsetSetOfFcns ---------------------------\0aEXTENDS Integers, Randomization\0a\0aVARIABLE x\0a\0aS == {1,2,3,4,5,6,7,8,9}\0aT == 1..10\0a\0a\\* [S->T] has 10^8 elements of which we want 1k.\0a\\* Explicitly enumerating all 10^8 elements will\0a\\* definitely timeout the tests. |[S -> T]| of\0a\\* sizes exceeding Integer.MAX_VALUE are not yet\0a\\* supported.\0aInit == /\\ x \\in RandomSubset(1000, [ S -> T ])\0a\0aNext == /\\ UNCHANGED <<x>>\0a\0aSpec == Init /\\ [][Next]_<<x>>\0a\0aInv == TRUE\0a=============================================================================\0a']]]
      ['SetPredValue' %accept ~[['SetPredValue' '---- MODULE SetPredValue ----\0aEXTENDS TLC, FiniteSets, Integers\0a\0aRange(F) == { F[x] : x \\in DOMAIN F }\0aMin(n, m) == IF n < m THEN n ELSE m\0a\0aLP(S, T, p) == LET ss == { s \\in SUBSET S : Cardinality(s) = p}\0a                          IN { e \\in [ T -> ss ] : \0a                                Cardinality(Range(e)) = Min(Cardinality(T), Cardinality(ss)) }\0a\0aASSUME PrintT(LP(1..4, {"a","b","c"}, 2))\0a\0a=============================\0a']]]
      ['StandardModules' %accept ~[['StandardModules' '------------------------------- MODULE StandardModules -------------------------------\0aEXTENDS Bags, Sequences, FiniteSets, TLC, RealTime, Naturals, Integers, Randomization\0aVARIABLES x\0aInit == FALSE /\\ x = 0\0aNext == [][FALSE /\\ x\' = x]_<<x>>\0a============================================================================\0a']]]
      ['SubsetEq' %accept ~[['SubsetEq' '------------------------------ MODULE SubsetEq ------------------------------\0aEXTENDS Integers, FiniteSets\0a\0aVARIABLE b\0a\0aInit == b = TRUE\0a\0aNext == b\' = /\\ (SUBSET (1..23) \\subseteq SUBSET (1..42))\0a             /\\ ~(SUBSET (1..42) \\subseteq SUBSET (1..23))\0a             /\\ ~(SUBSET (1..42) \\subseteq SUBSET (2..42))\0a             /\\ (SUBSET (2..42) \\subseteq SUBSET (1..42))\0a             /\\ (SUBSET {1,2,3} \\subseteq SUBSET {1,2,3,4})\0a             /\\ (SUBSET {} \\subseteq SUBSET {})\0a             /\\ (SUBSET {} \\subseteq SUBSET {1})\0a             /\\ ~(SUBSET {1} \\subseteq SUBSET {})\0a             /\\ (SUBSET {1} \\subseteq SUBSET Int)\0a             /\\ (SUBSET {1} \\subseteq SUBSET Nat)\0a\0aSpec == Init /\\ [][Next]_<<b>>\0a\0aInv == b = TRUE /\\ b \\in BOOLEAN\0a=============================================================================\0a']]]
      ['SubseteqNextState' %accept ~[['SubseteqNextState' '---- MODULE SubseteqNextState ----\0aEXTENDS TLC\0aVARIABLES x, y\0aTypeOK == x \\subseteq {1, 2, 3}\0aInv ==\0a  /\\ ENABLED (x\' \\subseteq {1})\0a  /\\ y = {1, 2, 3}\0aInit ==\0a  /\\ x \\subseteq {1, 2}\0a  /\\ y = {1, 2, 3}\0aNext ==\0a  /\\ UNCHANGED y\0a  /\\ x\' \\subseteq y\'\0a\0aFullSet == x = {1, 2, 3}\0a\0aGainThree == 3 \\in x\' /\\ 3 \\notin x\0a\0aPossibleCounts ==\0a    LET p == TLCGet("all:named")["s:_possible"][1]\0a    IN /\\ p["FullSet"] = 8\0a       /\\ p["GainThree"] = 16\0a====\0a']]]
      ['TLACommentStyles' %accept ~[['TLACommentStyles' '------------------------- MODULE TLACommentStyles -------------------------\0a\0a(*************************************************************************)\0a(* Calculate the sum of projections of the elements in a set.            *)\0a(*                                                                       *)\0a(* Example:                                                              *)\0a(*         MapThenSumSet(                                                *)\0a(*             LAMBDA e : e.n,                                           *)\0a(*             {[n |-> 0], [n |-> 1], [n |-> 2]}                         *)\0a(*         ) = 3                                                         *)\0a(*************************************************************************)\0aCommentStyle1 == TRUE\0a\0a  (*************************************************************************)\0a  (* COMMENT STYLE 2: Indented Boxed Comment                              *)\0a  (* Used for nested or secondary explanations.                           *)\0a  (* Note the indentation at the start.                                   *)\0a  (*************************************************************************)\0aCommentStyle2 == TRUE\0a\0a(* COMMENT STYLE 3: Simple Multi-line Comment Without Box\0a   This style doesn\'t use asterisks on every line.\0a   It\'s more free-form and less structured.\0a   Often used for algorithm descriptions or citations.\0a *)\0aCommentStyle3 == TRUE\0a\0a\\* Declaring instances local causes definition overrides to be hidden. In the\0a\\* case of Toolbox, this causes the definition override of `_TETrace` to be\0a\\* invisible.  In turn, TLC will then try to evaluate the TLA+ definition of\0a\\*\0a\\* `_TETrace` as defined in Tooblox.tla:\0a\\*   Attempted to enumerate S \\ T when S:\0a\\*   Nat\0a\\*   is not enumerable.\0a\\*\0a\\* See: https://github.com/tlaplus/CommunityModules/issues/37\0aCommentStyle4 == TRUE\0a\0a-----------------------------------------------------------------------------\0a(* Horizontal dividers (shown above and below) are used to separate       *)\0a(* major sections of the specification.                                   *)\0a-----------------------------------------------------------------------------\0a\0aVARIABLE x,   \\* COMMENT STYLE 5: Inline comment after code\0a         y    \\* Explains individual variables or formula components\0a\0a=============================================================================\0a\0a']]]
      ['TLCExtTest' %accept ~[['TLCExtTest' '------------- CONFIG TLCExtTest ---------\0aSPECIFICATION Spec\0aINVARIANT Inv\0a===================\0a\0a---- MODULE TLCExtTest ----\0a\0aEXTENDS TLCExt, TLC, FiniteSets, Sequences, Naturals\0a\0aVARIABLE mvs\0a\0aInit ==\0a  mvs = { TLCModelValue("T_MV" \\o ToString(i)) : i \\in 1..3 }\0a\0aSpec == \0a  Init /\\ [][UNCHANGED mvs]_mvs\0a\0aInv ==\0a  /\\ Cardinality(mvs) = 3\0a  /\\ TLCModelValue("T_MV1") \\in mvs\0a  /\\ TLCModelValue("T_MV2") \\in mvs\0a  /\\ TLCModelValue("T_MV3") \\in mvs\0a\0a-------------------------------------------------\0a\0aASSUME ToString(TLCModelValue("T_MyMV")) = "T_MyMV"\0aASSUME ToString(TLCModelValue("T_MyMV")) # ""\0a\0aASSUME TLCModelValue("T_MyMV") = TLCModelValue("T_MyMV")\0aASSUME TLCModelValue("T_MyMV") # TLCModelValue("T_YourMV")\0aASSUME AssertError(\0a  "Attempted to check equality of the differently-typed model values T_MyMV and S_MyMV",\0a  TLCModelValue("T_MyMV") = TLCModelValue("S_MyMV"))\0a==================================\0a']]]
      ['TLCExtTrace' %accept ~[['TLCExtTrace' '------------- CONFIG TLCExtTrace ---------\0a\0aSPECIFICATION Spec\0aINVARIANT Inv\0aCONSTRAINT Inv\0a===================\0a\0a---- MODULE TLCExtTrace ----\0a\0aEXTENDS Integers, TLCExt, Sequences\0a\0aVARIABLE x\0a\0aSpec == x = 1 /\\ [][x < 10 /\\ x\' = x + 1]_x\0a\0a\\* Assert that Trace is the sequence of states up to the current value of x.\0aInv == /\\ Len(Trace) = x\0a       /\\ \\A i \\in 1..x : /\\ Trace[i].x = i\0a\0aInv2 == x < 7\0a\0aAlias ==\0a[\0a\09x |-> x,\0a\09t |-> Trace\0a]\0a==================================\0a']]]
      ['TLCGetAll' %accept ~[['TLCGetAll' '--------------------------- MODULE TLCGetAll -----------------------------\0a\\* Contrary to the hyperproperties tested by DieHardTLA, this test checks that\0a\\* basic hyperproperties work even with multiple TLC workers.  While this is not\0a\\* transparent, it is easy enough for users to aggregate the results of multiple\0a\\* TLC workers as they see fit.\0aEXTENDS Naturals, TLC, FiniteSets, Sequences\0a\0aR == 23\0a\0aASSUME TLCSet(R, 0)\0a\\* Add a second value to TLCSet that is not changed by Init/Next.\0aASSUME TLCSet(42, 0)\0a\0aVARIABLE x, y\0a\0aInit ==\0a    /\\ x = 0\0a    /\\ y = 0\0a\0aNext ==\0a    \\* If TLCSet would be moved below the other two conjuncts, TLCGet(R) in\0a    \\* Postcondition would evaluate to 10100.  This is because of TLC\'s\0a    \\* left-to-right expression evaluation.\0a    /\\ TLCSet(R, TLCGet(R) + 1)\0a    /\\ x\' \\in 1..10\0a    /\\ y\' \\in 1..10\0a\0a--------------------------------------------------------------------------------\0a\0aSum(seq) ==\0a    \\* Some might prefer folds here--me don\'t.\0a    LET S[n \\in 1..Len(seq)] ==\0a            IF n = 1\0a            THEN seq[n]\0a            ELSE seq[n] + S[n - 1]\0a    IN S[Len(seq)]\0a\0aPostCondition ==\0a /\\ TLCSet(42, TLCGet("generated"))\0a /\\ LET vals == TLCGet("all")\0a    IN /\\ DOMAIN vals = {R, 42} \0a       \\* vars[R] is a tuple with length N where N is the number of workers.\0a       \\* In other words, vars[R] has the value of TLCGet(R) for each worker.\0a       /\\ Len(vals[R]) = TLCGet("config").worker\0a       \\* What is counted explicitly with TLCGet/Set are the number of distinct\0a       \\* states.\0a       /\\ Sum(vals[R]) = TLCGet("distinct")\0a================================================================================\0a\0a--------------------------- CONFIG TLCGetAll -----------------------------\0aINIT Init\0aNEXT Next\0aPOSTCONDITION PostCondition\0a================================================================================']]]
      ['TLCGetLevel' %accept ~[['TLCGetLevel' '--------------------------- MODULE TLCGetLevel ----------------------------\0aEXTENDS Integers, TLC\0a\0aVARIABLES x, y, yb, z\0a\0aASSUME(TLCGet("level") = 0)\0a\0aInit ==\0a   /\\ TLCGet("level") = 0\0a   /\\ yb = TLCGet("level")\0a   /\\ x = 0\0a   /\\ y = TLCGet("level")\0a   /\\ z = 1\0a\0aNext == \0a   /\\ TLCGet("level") > 0\0a   /\\ Assert(TLCGet("level") + 1 = TLCGet("level")\', "Failure pre next-state")\0a   /\\ yb\' = TLCGet("level")\0a   /\\ x < 3 \0a   /\\ x\' = x + 1\0a   /\\ y\' = TLCGet("level")\0a   /\\ z\' = TLCGet("level")\'\0a   /\\ Assert(TLCGet("level") + 1 = TLCGet("level")\', "Failure post next-state")\0a\0aInv ==\0a    /\\ y = yb\0a    /\\ z = TLCGet("level")\0a    /\\ x + 1 = TLCGet("level")\0a    \\* /\\ TLCGet("level") < 4  \\* To trigger a safety violation.\0a\0aActionConstraint ==\0a    /\\ Assert(TLCGet("level") + 1 = TLCGet("level")\', "Failure action constraint")\0a\0aStateConstraint ==\0a    /\\ TLCGet("level") \\in 1..4\0a\0aProp ==\0a    /\\ <>[](x = 2)\0a    /\\ [][y\' > y /\\ yb\' > yb /\\ TLCGet("level") + 1 = TLCGet("level")\']_<<x, y, yb, z>>\0a\0aPostCondition ==\0a    TLCGet("spec") = [ impliedinits |-> {},\0a                impliedactions |-> \0a                    { [ name |-> "Prop",\0a                        location |-> \0a                            [ beginLine |-> 39,\0a                                beginColumn |-> 10,\0a                                endLine |-> 39,\0a                                endColumn |-> 87,\0a                                module |-> "TLCGetLevel" ] ] },\0a                invariants |->\0a                    { [ coverage |-> [count |-> 4],\0a                        name |-> "Inv",\0a                        location |->\0a                            [ beginLine |-> 26,\0a                                beginColumn |-> 5,\0a                                endLine |-> 28,\0a                                endColumn |-> 30,\0a                                module |-> "TLCGetLevel" ] ] },\0a                impliedtemporals |->\0a                    { [ name |-> "Prop",\0a                        location |->\0a                            [ beginLine |-> 38,\0a                                beginColumn |-> 8,\0a                                endLine |-> 38,\0a                                endColumn |-> 18,\0a                                module |-> "TLCGetLevel" ] ] ,\0a\09\09\09\09      [ name |-> "Tautology",\0a\09\09\09\09        location |->\0a\09\09\09\09            [ beginLine |-> 144,\0a\09\09\09\09                beginColumn |-> 14,\0a\09\09\09\09                endLine |-> 144,\0a\09\09\09\09                endColumn |-> 31,\0a\09\09\09\09                module |-> "TLCGetLevel" ] ] },\0a                temporals |-> {},\0a                actions |->\0a                    { [ coverage |-> [generated |-> 6, distinct |-> 3],\0a                        name |-> "Next",\0a                        location |->\0a                            [ beginLine |-> 16,\0a                                beginColumn |-> 4,\0a                                endLine |-> 23,\0a                                endColumn |-> 79,\0a                                module |-> "TLCGetLevel" ] ] },\0a                inits |->\0a                    { [ coverage |-> [generated |-> 2, distinct |-> 2],\0a                        name |-> "Init",\0a                        location |->\0a                            [ beginLine |-> 9,\0a                                beginColumn |-> 4,\0a                                endLine |-> 13,\0a                                endColumn |-> 11,\0a                                module |-> "TLCGetLevel" ] ] },\0a                variables |->\0a                    { [ coverage |-> [distinct |-> 3],\0a                        name |-> "x",\0a                        location |->\0a                            [ beginLine |-> 4,\0a                                beginColumn |-> 11,\0a                                endLine |-> 4,\0a                                endColumn |-> 11,\0a                                module |-> "TLCGetLevel" ] ],\0a                        [ coverage |-> [distinct |-> 3],\0a                        name |-> "y",\0a                        location |->\0a                            [ beginLine |-> 4,\0a                                beginColumn |-> 14,\0a                                endLine |-> 4,\0a                                endColumn |-> 14,\0a                                module |-> "TLCGetLevel" ] ],\0a                        [ coverage |-> [distinct |-> 3],\0a                        name |-> "yb",\0a                        location |->\0a                            [ beginLine |-> 4,\0a                                beginColumn |-> 17,\0a                                endLine |-> 4,\0a                                endColumn |-> 18,\0a                                module |-> "TLCGetLevel" ] ],\0a                        [ coverage |-> [distinct |-> 3],\0a                        name |-> "z",\0a                        location |->\0a                            [ beginLine |-> 4,\0a                                beginColumn |-> 21,\0a                                endLine |-> 4,\0a                                endColumn |-> 21,\0a                                module |-> "TLCGetLevel" ] ] },\0a                actionconstraints |->\0a                    { [ name |-> "ActionConstraint",\0a                        location |->\0a                            [ beginLine |-> 32,\0a                                beginColumn |-> 5,\0a                                endLine |-> 32,\0a                                endColumn |-> 82,\0a                                module |-> "TLCGetLevel" ] ] },\0a                constraints |->\0a                    { [ name |-> "StateConstraint",\0a                        location |->\0a                            [ beginLine |-> 35,\0a                                beginColumn |-> 5,\0a                                endLine |-> 35,\0a                                endColumn |-> 31,\0a                                module |-> "TLCGetLevel" ] ] } ]\0a\0aTautology == (x = x) ~> (x = x)\0a=============================================================================\0a']]]
      ['TLCGetNamedUndefined' %accept ~[['TLCGetNamedUndefined' '------------------------ MODULE TLCGetNamedUndefined ------------------------\0aEXTENDS TLC\0a\0adiameter == TLCGet("diameter")\0adistinct == TLCGet("distinct")\0aqueue == TLCGet("queue")\0alevel == TLCGet("level")\0a\0aCONSTANT A,B,C,D\0a\0aASSUME(TRUE)\0a\0a=============================================================================\0a']]]
      ['TLCGetNonDeterminism' %accept ~[['TLCGetNonDeterminism' '--------------------------- MODULE TLCGetNonDeterminism ----------------------------\0aEXTENDS Integers, TLC\0a\0a\\* A monotonic counter:\0a\0aVARIABLES x,y\0a\0aInit == /\\ TLCSet(1, 0)\0a        /\\ x = 0\0a        /\\ y = TLCGet(1)\0a\0a\\* Replacing "TLCGet(1) + 1" with "x\'" does not trigger the TLC bug.\0a\\* "x\'" is clearly defined but TLCGet(1) returns the local value of \0a\\* a non-deterministically chosen worker from the set of TLC workers\0a\\* (the local values are inconsistent and depend on worker threading).\0a\\*\0a\\* In other words, this next-state relation does not correspond to a\0a\\* single behavior <x=1,y=1>, <x=2,y=2>, <x=3,y=3> but to a set of\0a\\* behaviors where the value of y \\in 1..3 depends on the actual\0a\\* worker schedule. E.g. with three workers, the behavior might be:\0a\\* <x=1,y=1-a>, <x=2,y=1-b>, <x=3,y=1-c> with 1-a being the local value\0a\\* of worker a, 1-b the local value of worker b, ...\0aNext == /\\ x < 3\0a        /\\ TLCSet(1, TLCGet(1) + 1) \0a        /\\ x\' = x + 1\0a        /\\ y\' = TLCGet(1)\0a\0a\\* This bug surfaces at a later stage, when TLC re-creates the error\0a\\* trace for the violation of Prop below:\0a\\*   Error: TLC threw an unexpected exception.\0a\\*   This was probably caused by an error in the spec or model.\0a\\*   The error occurred when TLC was checking liveness.\0a\\*   The exception was a tlc2.tool.EvalException\0a\\*   : Failed to recover the next state from its fingerprint.\0a\\*\0a\\* During error trace re-creation (where TLC re-creates the actual states\0a\\* from a path in the fingerprint graph, TLC always runs with a single worker.\0a\\* Consequently, it always create the expected <x=1,y=1>, <x=2,y=2>, <x=3,y=3>\0a\\* behavior.  This behavior however gets rejected because the fingerprints\0a\\* in the path do not match the fingerprint of the re-created states.\0a\0a------------------------------------------------------------------------------\0a\0a\\* Force an arbitrary liveness violation by allowing\0a\\* x to go up to 3 but expect x to remain -lt 3 forever.\0aProp == <>[](x < 3)\0a\0aTautology == (x = x) ~> (x = x)\0a=============================================================================\0a']]]
      ['TLCSet' %accept ~[['TLCSet' '--------------------------- MODULE TLCSet ---------------------------\0aEXTENDS Integers, TLC\0a\0aASSUME TLCGet("config").mode = "bfs"\0a\0aASSUME TLCGet("spec").inits = {[name |-> "Init", location |-> [beginLine |-> 15, beginColumn |-> 9, endLine |-> 26, endColumn |-> 40, module |-> "TLCSet"], coverage |-> [distinct |-> 0, generated |-> 0]]}\0a                \0aASSUME TLCGet("spec").actions = {[name |-> "Next", location |-> [beginLine |-> 28, beginColumn |-> 9, endLine |-> 45, endColumn |-> 41, module |-> "TLCSet"], coverage |-> [distinct |-> 0, generated |-> 0]]}\0a\0aASSUME TLCSet("s:counter", 0)\0aASSUME TLCSet("s:label", "hello")\0a\0aVARIABLES x\0a\0aInit == /\\ x = 0\0a        \\* Old world\0a        /\\ TLCGet("duration") >= 0 \\* Init might take more than a seconds since startup.\0a        /\\ TLCGet("diameter") = 1\0a        /\\ TLCGet("queue") = 0 \\* queue is always empty because spec is a single behavior.\0a        /\\ TLCGet("distinct") = 0\0a        \\* New world\0a        /\\ TLCGet("stats").duration >= 0\0a        /\\ TLCGet("stats").queue = 0\0a        /\\ TLCGet("stats").distinct = 0\0a        /\\ TLCGet("stats").diameter = 1\0a        /\\ TLCGet("stats").generated = 0\0a\0aNext == /\\ x\' = x + 1\0a        /\\ TLCSet("exit", x = 4223)\0a        \\* Old world\0a        /\\ TLCGet("duration") >= 0 \\* Next might evaluate within the first second of model checking.\0a        /\\ TLCGet("queue") = 0 \\* queue is always empty because spec is a single behavior.\0a        /\\ TLCGet("distinct") = x\'\0a        /\\ TLCGet("generated") = x\'\0a        /\\ TLCGet("diameter") = x\' \\* As byproduct check that trace is strictly monotonically increasing.\0a        \\* Named registers\0a        /\\ TLCGet("s:counter") = x\0a        /\\ TLCGet("s:label") = "hello"\0a        /\\ TLCSet("s:counter", x\')\0a        \\* New world\0a        /\\ TLCGet("stats").duration >= 0\0a        /\\ TLCGet("stats").queue = 0\0a        /\\ TLCGet("stats").distinct = x\' \0a        /\\ TLCGet("stats").diameter = x\'\0a        /\\ TLCGet("stats").generated = x\'\0a\0aSpec == Init /\\ [][Next]_x\0a\0aPostCondition ==\0a    /\\ TLCGet("s:label") = "hello"\0a    /\\ TLCGet("s:counter") \\in Nat\0a\0aASSUME TLCGet("config").deadlock = FALSE\0aASSUME TLCGet("config").worker = 1\0aASSUME TLCGet("config").fingerprint \\in STRING\0aASSUME TLCGet("config").seed \\in STRING\0a\0aASSUME TLCGet("spec").temporals = {}\0aASSUME TLCGet("spec").invariants = {}\0aASSUME TLCGet("spec").impliedinits = {}\0aASSUME TLCGet("spec").impliedtemporals = {}\0a\0aASSUME TLCGet("revision").tag \\in STRING\0aASSUME TLCGet("revision").count \\in Nat\0aASSUME TLCGet("revision").timestamp \\in Nat\0aASSUME TLCGet("revision").date \\in STRING\0aASSUME TLCGet("revision").calver \\in STRING\0aASSUME TLCGet("revision").calver # ""\0aASSUME TLCGet("revision").tag = "development" => TLCGet("revision").count = 0 \0aASSUME TLCGet("revision").tag # "development" => TLCGet("revision").count > 7854\0aASSUME TLCGet("revision").tag # "development" => TLCGet("revision").timestamp > 1626748578\0a=============================================================================\0a']]]
      ['TLCSetInit' %accept ~[['TLCSetInit' '----- MODULE TLCSetInit -----\0aEXTENDS Integers, TLC\0a\0aVARIABLES x\0a\0aInit == x = 1 /\\ TLCSet(1,"TLCSet works.")\0aNext == x < 10 /\\ x\' = x + 1 /\\ PrintT(TLCGet(1))\0a\0aAtFive == x = 5\0a\0aStep == x\' = x + 1\0a\0aPossibleCounts ==\0a    LET p == TLCGet("all:named")["s:_possible"][1]\0a    IN /\\ p["AtFive"] = 1\0a       /\\ p["Step"] = 9\0a\0a=====']]]
      ['TLCSetSim' %accept ~[['TLCSetSim' '--------------------------- MODULE TLCSetSim ---------------------------\0aEXTENDS Integers, TLC\0a\0aASSUME /\\ TLCGet("config").depth = 4224\0a       /\\ TLCGet("config").mode \\in {"simulate", "generate"}\0a       /\\ TLCGet("config").traces = -1\0a\0aASSUME TLCGet("spec").inits = {[name |-> "Init", location |-> [beginLine |-> 13, beginColumn |-> 9, endLine |-> 16, endColumn |-> 40, module |-> "TLCSetSim"], coverage |-> [distinct |-> 0, generated |-> 0] ]}\0aASSUME TLCGet("spec").actions = {[name |-> "Next", location |-> [beginLine |-> 18, beginColumn |-> 9, endLine |-> 22, endColumn |-> 35, module |-> "TLCSetSim"], coverage |-> [distinct |-> 0, generated |-> 0] ]}\0a\0aVARIABLES x\0a\0aInit == /\\ x = 0\0a        /\\ TLCGet("stats").duration >= 0\0a        /\\ TLCGet("stats").traces = 0\0a        /\\ TLCGet("stats").generated = 0\0a\0aNext == /\\ x\' = x + 1\0a        /\\ TLCGet("stats").duration >= 0\0a        /\\ TLCGet("stats").traces = 1\0a        /\\ TLCGet("stats").generated = x\'\0a        /\\ TLCSet("exit", x = 4223)\0a\0aSpec == Init /\\ [][Next]_x\0a    \0aASSUME TLCGet("config").deadlock = FALSE\0aASSUME TLCGet("config").worker = 1\0aASSUME TLCGet("config").aril \\in STRING\0aASSUME TLCGet("config").seed \\in STRING\0a\0aASSUME TLCGet("revision").tag \\in STRING\0aASSUME TLCGet("revision").count \\in Nat\0aASSUME TLCGet("revision").timestamp \\in Nat\0aASSUME TLCGet("revision").date \\in STRING\0aASSUME TLCGet("revision").calver \\in STRING\0aASSUME TLCGet("revision").calver # ""\0aASSUME TLCGet("revision").tag = "development" => TLCGet("revision").count = 0 \0aASSUME TLCGet("revision").tag # "development" => TLCGet("revision").count > 7854\0aASSUME TLCGet("revision").tag # "development" => TLCGet("revision").timestamp > 1626748578\0a=============================================================================\0a']]]
      ['Test2' %accept ~[['Test2' '---------- MODULE Test2 -----------\0a\0a(* This spec originates from an email conversation between Leslie and Yuan in 2009 *)\0a\0aEXTENDS Naturals, TLC\0aVARIABLE x\0aASSUME TLCSet(42, 0)\0aInit == x=0\0a\0aNext == x\' = (x+1)%5 /\\ TLCSet(42, TLCGet(42)+1)\0a\0aSpec == Init /\\ [][Next]_x /\\ WF_x(Next)\0a\0aProp1 == []<>(x=1)\0a\0aPostCondition ==\0a    PrintT(TLCGet(42)) /\\ TLCGet(42) \\in {1050,2000}\0a\0aPostConditionViolated ==\0a    TLCGet(42) = 0\0a\0a==============================================\0a']]]
      ['Test2a' %accept ~[['Test2a' '---------- MODULE Test2a -----------\0a\0a(* This spec originates from an email conversation between Leslie and Yuan in 2009 *)\0a\0aEXTENDS Naturals\0aVARIABLE x\0a\0aInit == x=0\0a\0aNext == x\' = (x+1)%5\0a\0aSpec == Init /\\ [][Next]_x /\\ WF_x(Next)\0a\0aProp1 == []<>(x=5)\0a\0aneg_Prop1 == ~(Prop1)\0a\0aXCyclesToZero == []<>(x = 0)\0a==============================================\0a']]]
      ['Test3' %accept ~[['Test3' '---------- MODULE Test3 -----------\0a\0a(* This spec originates from an email conversation between Leslie and Yuan in 2009 *)\0a\0aEXTENDS Naturals, TLC, TLCExt\0aVARIABLE x\0a\0aInit == x=0\0a\0aNext == IF x=0 THEN x\' \\in {1, 2}\0a        ELSE x\' = 0\0a\0aSpec == Init /\\ [][Next]_x /\\ WF_x(Next)\0a\0aProp1 ==  <>[](x#1) \\/ <>[](x#2)\0a\0aPostCondition ==\0a\09/\\ TLCSet(42, TLCGet("generated"))\0a\09/\\ \\/ /\\ ToTrace(CounterExample) = <<[x |-> 0], [x |-> 1], [x |-> 0], [x |-> 2]>>\0a\09   \0a\09      /\\ CounterExample =\0a\09\09\09[ action |->\0a\09\09\09      { << <<1, [x |-> 0]>>,\0a\09\09\09           [ name |-> "Next",\0a\09\09\09             location |->\0a\09\09\09                 [ beginLine |-> 10,\0a\09\09\09                   beginColumn |-> 9,\0a\09\09\09                   endLine |-> 11,\0a\09\09\09                   endColumn |-> 19,\0a\09\09\09                   module |-> "Test3" ] ],\0a\09\09\09           <<2, [x |-> 1]>> >>,\0a\09\09\09        << <<2, [x |-> 1]>>,\0a\09\09\09           [ name |-> "Next",\0a\09\09\09             location |->\0a\09\09\09                 [ beginLine |-> 10,\0a\09\09\09                   beginColumn |-> 9,\0a\09\09\09                   endLine |-> 11,\0a\09\09\09                   endColumn |-> 19,\0a\09\09\09                   module |-> "Test3" ] ],\0a\09\09\09           <<3, [x |-> 0]>> >>,\0a\09\09\09        << <<3, [x |-> 0]>>,\0a\09\09\09           [ name |-> "Next",\0a\09\09\09             location |->\0a\09\09\09                 [ beginLine |-> 10,\0a\09\09\09                   beginColumn |-> 9,\0a\09\09\09                   endLine |-> 11,\0a\09\09\09                   endColumn |-> 19,\0a\09\09\09                   module |-> "Test3" ] ],\0a\09\09\09           <<4, [x |-> 2]>> >>,\0a\09\09\09        << <<4, [x |-> 2]>>,\0a\09\09\09           [ name |-> "Next",\0a\09\09\09             location |->\0a\09\09\09                 [ beginLine |-> 10,\0a\09\09\09                   beginColumn |-> 9,\0a\09\09\09                   endLine |-> 11,\0a\09\09\09                   endColumn |-> 19,\0a\09\09\09                   module |-> "Test3" ] ],\0a\09\09\09           <<1, [x |-> 0]>> >> },\0a\09\09\09  state |->\0a\09\09\09      {<<1, [x |-> 0]>>, <<2, [x |-> 1]>>, <<3, [x |-> 0]>>, <<4, [x |-> 2]>>} ]\0a\09\0aneg_Prop1 == ~(Prop1)\0a\0aXReturnsToZero == []<>(x = 0)\0a\0aTautology == (x = x) ~> (x = x)\0a===================================\0a']]]
      ['Test4' %accept ~[['Test4' '---------- MODULE Test4 -----------\0aVARIABLE x\0a\0aASSUME TRUE = FALSE \\* No, it\'s not!\0a\0aSpec == x = 0 /\\ [][UNCHANGED x]_x\0a\0a==============================================\0a']]]
      ['TraceWithLargeSetOfInitialStatesTest' %accept ~[['TraceWithLargeSetOfInitialStatesTest' '---------------- MODULE TraceWithLargeSetOfInitialStatesTest ----------------\0aEXTENDS Integers\0a\0aVARIABLES x,y\0a\0aSpec == (x \\in 1..11 /\\ y = FALSE) /\\ [][x\' = x /\\ y\' = TRUE]_<<x,y>>\0a\0aInv == y = FALSE\0a=============================================================================']]]
      ['UserModuleOverride' %accept ~[['UserModuleOverride' '--------------------------- MODULE UserModuleOverride -----------------------\0aEXTENDS Naturals, TLC\0aVARIABLES x\0a\0aGet == FALSE\0a\0aGet2 == TRUE\0a\0aInit == x = Get\0a\0aNext == x\' = Get2\0a\0aSpec == Init /\\ [][Next]_<<x>>\0a\0aProp == <>[](Print(x, x = TRUE) /\\ TLCGet("diameter") > 0)\0a=============================================================================\0a']]]
      ['UserModuleOverrideAnnotation' %accept ~[['UserModuleOverrideAnnotation' '--------------------------- MODULE UserModuleOverrideAnnotation -----------------------\0aEXTENDS Naturals, TLC\0aVARIABLES x\0a\0aGet == FALSE\0aGet2 == FALSE\0a\0aInit == x = Get\0a\0aNext == x\' = Get2\0a\0aSpec == Init /\\ [][Next]_<<x>>\0a\0aProp == <>[](Print(x, x = TRUE) /\\ TLCGet("diameter") > 0)\0a=============================================================================\0a']]]
      ['dekker' %accept ~[['dekker' '---- CONFIG dekker ----\0aSPECIFICATION\0a    Spec\0aPROPERTIES\0a    Termination\0a    Tautology\0aCONSTANT\0a    Threads = {t1,t2,t3}\0a====\0a------------------------------- MODULE dekker -------------------------------\0aEXTENDS TLC, Integers\0aCONSTANT Threads\0a\0a(*--algorithm dekker\0a\0avariables \0a  flag = [t \\in Threads |-> FALSE],\0a  next_thread \\in Threads;\0a\0adefine\0a  \\* At most one thread is in the critical section at a time\0a  AtMostOneCritical == \\A t1, t2 \\in Threads:\0a    t1 /= t2 => ~(pc[t1] = "CS" /\\ pc[t2] = "CS")\0a  \0a  \\* All threads eventually reach the critical section\0a  Liveness == \\A t \\in Threads: <>(pc[t] = "CS")\0aend define;\0a\0afair process thread \\in Threads\0abegin\0a  P1: flag[self] := TRUE;\0a  P2:\0a    while \\E t \\in Threads \\ {self}: flag[t] do\0a      P2_1:\0a        if next_thread /= self then\0a          P2_1_1: flag[self] := FALSE;\0a          P2_1_2: await next_thread = self;\0a          P2_1_3: flag[self] := TRUE;\0a        end if;\0a    end while;\0a  CS: skip; \\* CS means "critical section"\0a  P3: with t \\in Threads \\ {self} do\0a        next_thread := t;\0a      end with;\0a  P4: goto P1;\0aend process;\0a\0aend algorithm;*)\0a\\* BEGIN TRANSLATION\0aVARIABLES flag, next_thread, pc\0a\0a(* define statement *)\0aAtMostOneCritical == \\A t1, t2 \\in Threads:\0a  t1 /= t2 => ~(pc[t1] = "CS" /\\ pc[t2] = "CS")\0a\0a\0aLiveness == \\A t \\in Threads: <>(pc[t] = "CS")\0a\0a\0avars == << flag, next_thread, pc >>\0a\0aProcSet == (Threads)\0a\0aInit == (* Global variables *)\0a        /\\ flag = [t \\in Threads |-> FALSE]\0a        /\\ next_thread \\in Threads\0a        /\\ pc = [self \\in ProcSet |-> "P1"]\0a\0aP1(self) == /\\ pc[self] = "P1"\0a            /\\ flag\' = [flag EXCEPT ![self] = TRUE]\0a            /\\ pc\' = [pc EXCEPT ![self] = "P2"]\0a            /\\ UNCHANGED next_thread\0a\0aP2(self) == /\\ pc[self] = "P2"\0a            /\\ IF \\E t \\in Threads \\ {self}: flag[t]\0a                  THEN /\\ pc\' = [pc EXCEPT ![self] = "P2_1"]\0a                  ELSE /\\ pc\' = [pc EXCEPT ![self] = "CS"]\0a            /\\ UNCHANGED << flag, next_thread >>\0a\0aP2_1(self) == /\\ pc[self] = "P2_1"\0a              /\\ IF next_thread /= self\0a                    THEN /\\ pc\' = [pc EXCEPT ![self] = "P2_1_1"]\0a                    ELSE /\\ pc\' = [pc EXCEPT ![self] = "P2"]\0a              /\\ UNCHANGED << flag, next_thread >>\0a\0aP2_1_1(self) == /\\ pc[self] = "P2_1_1"\0a                /\\ flag\' = [flag EXCEPT ![self] = FALSE]\0a                /\\ pc\' = [pc EXCEPT ![self] = "P2_1_2"]\0a                /\\ UNCHANGED next_thread\0a\0aP2_1_2(self) == /\\ pc[self] = "P2_1_2"\0a                /\\ next_thread = self\0a                /\\ pc\' = [pc EXCEPT ![self] = "P2_1_3"]\0a                /\\ UNCHANGED << flag, next_thread >>\0a\0aP2_1_3(self) == /\\ pc[self] = "P2_1_3"\0a                /\\ flag\' = [flag EXCEPT ![self] = TRUE]\0a                /\\ pc\' = [pc EXCEPT ![self] = "P2"]\0a                /\\ UNCHANGED next_thread\0a\0aCS(self) == /\\ pc[self] = "CS"\0a            /\\ TRUE\0a            /\\ pc\' = [pc EXCEPT ![self] = "P3"]\0a            /\\ UNCHANGED << flag, next_thread >>\0a\0aP3(self) == /\\ pc[self] = "P3"\0a            /\\ \\E t \\in Threads \\ {self}:\0a                 next_thread\' = t\0a            /\\ pc\' = [pc EXCEPT ![self] = "P4"]\0a            /\\ flag\' = flag\0a\0aP4(self) == /\\ pc[self] = "P4"\0a            /\\ pc\' = [pc EXCEPT ![self] = "P1"]\0a            /\\ UNCHANGED << flag, next_thread >>\0a\0athread(self) == P1(self) \\/ P2(self) \\/ P2_1(self) \\/ P2_1_1(self)\0a                   \\/ P2_1_2(self) \\/ P2_1_3(self) \\/ CS(self) \\/ P3(self)\0a                   \\/ P4(self)\0a\0a(* Allow infinite stuttering to prevent deadlock on termination. *)\0aTerminating == /\\ \\A self \\in ProcSet: pc[self] = "Done"\0a               /\\ UNCHANGED vars\0a\0aNext == (\\E self \\in Threads: thread(self))\0a           \\/ Terminating\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ \\A self \\in Threads : WF_vars(thread(self))\0a\0aTermination == <>(\\A self \\in ProcSet: pc[self] = "Done")\0a\0a\\* END TRANSLATION\0a\0aTautology == (vars = vars) ~> (vars = vars)\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Sun Sep 29 12:39:24 PDT 2019 by tony\0a\\* Created Sun Sep 29 12:18:45 PDT 2019 by tony\0a\0a\0a']]]
      ['testinvalidinvariant' %accept ~[['testinvalidinvariant' '------------------ MODULE testinvalidinvariant --------------------\0aEXTENDS Integers\0a\0aVARIABLES x\0aInit == /\\ x = 1\0aNext == /\\ x\'= x + 1 \0aSpec == Init /\\ [][Next]_<<x>>\0a\0a\\* Primed variable is invalid.\0aInvariant == x\' \\in Nat\0a\0a==================================================================\0a']]]
  ==
::
++  test-tlc-batch
  %+  expect-eq
    !>  ^-  (list @t)
    :~  'BagsTest -> Error: An assumption is false.'
    ==
  !>
  %-  tlc-batch-run
  ^-  (list [@t (list @t) @t @t])
  :~
      ['AssignmentInit' ~['Error: Deadlock reached.' '5 distinct states found, 3 states left on queue.' 'The depth of the complete state graph search is 1.' 'State 1: <Initial predicate>' 's = 2'] '--------------------------- MODULE AssignmentInit ---------------------------\0aEXTENDS Integers, TLC\0aVARIABLE s\0a\0amin(S) == CHOOSE e \\in S: \\A a \\in S: e <= a\0a\0aInitExit(var, S) == \\E val \\in S: (var = val /\\ var > min(S))\0a\0aInitAll(var, S) == \\A val \\in S: (var = val /\\ var \\in S)\0a\0aInitIn(var, S) == var \\in S /\\ var > min(S)\0a\0aInitEq(var, S, val) == var \\in S /\\ var + 1 = val\0a\0aisOdd(n) == n % 2 = 1\0aInitEven(var, S) == var \\in S /\\ isOdd(var)\0a\0a\\* With this Init(var), the test does not fail without its fix.\0a\\*Init(ignored) == \\E val \\in {0,1}: (s = val /\\ s > 0)\0a\0a\\* Init1 one state + Init3 one state\0aSpec == /\\ \\/ InitExit(s, {0,1}) \\* 1 unique state\0a           \\/ InitAll(s, {2})    \\* 1 unique state\0a           \\/ InitIn(s, {4,5})   \\* 1 unique state\0a           \\/ InitAll(s, {6,7})  \\* 0 unique states\0a           \\/ InitEq(s, {8,9}, 10) \\* 1 unique states\0a           \\/ InitEven(s, {10,11}) \\* 1 unique states\0a        /\\ [][InitExit(s, {0,1})/\\UNCHANGED s]_s\0a\0a=============================================================================\0a' 'SPECIFICATION\0aSpec\0aCONSTANT\0aN = 42\0aM = 42\0a\\*INVARIANT\0a\\*Inv']
      ['AssignmentInitNeg' ~['Model checking completed. No error has been found.' '1 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 1.'] '--------------------------- MODULE AssignmentInitNeg ---------------------------\0aEXTENDS Integers\0aVARIABLE s\0a\0aInit(var) == \\E val \\in 0..1: (var = val /\\ var < 1)\0a\0aSpec == Init(s) /\\ [][UNCHANGED s]_s\0a\0aInv == (s < 1)\0a=============================================================================\0a' 'SPECIFICATION\0aSpec\0aINVARIANT\0aInv']
      ['AssignmentNext' ~['Model checking completed. No error has been found.' '2 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 2.'] '--------------------------- MODULE AssignmentNext ---------------------------\0aEXTENDS Integers\0aVARIABLE s\0a\0aNext(var) == \\E val \\in 0..1: (var\' = val /\\ var\' > 0)\0a\0aSpec == s = 23 /\\ [][Next(s)]_s\0a\0aInv == s # 0\0a=============================================================================\0a' 'SPECIFICATION\0aSpec\0aINVARIANT\0aInv']
      ['ConstantOperatorConfiguration' ~['Error: Invariant Inv is violated.' '3 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 3.' 'State 1: <Initial predicate>' 'x = 0' 'State 2: <Next line 7, col 9 to line 7, col 17 of module ConstantOperatorConfiguration>' 'x = 1' 'State 3: <Next line 7, col 9 to line 7, col 17 of module ConstantOperatorConfiguration>' 'x = 2'] '---- MODULE ConstantOperatorConfiguration ----\0a\0aCONSTANT F(_)\0aVARIABLE x\0a\0aInit == x = 0\0aNext == x\' = F(x)\0aInv == x /= 2\0a\0a====\0a' 'INIT Init\0aNEXT Next\0a\0aCONSTANT\0a    F(0) = 1\0a    F(1) = 2\0a    F(2) = 2\0a\0aINVARIANT Inv\0a']
      ['Continue' ~['Error: Invariant Inv1 is violated.' '2 distinct states found, 1 states left on queue.' 'The depth of the complete state graph search is 2.' 'State 1: <Initial predicate>' '/\\ x = 1' '/\\ y = 1' 'State 2: <Next line 8, col 9 to line 11, col 28 of module Continue>' '/\\ x = 2' '/\\ y = 2'] '---- MODULE Continue ----\0aEXTENDS Naturals\0a\0aVARIABLES x,y\0a\0aInit == x = 1 /\\ y = 1\0a\0aNext == /\\ x\' = x + 1 \0a        /\\ \\/ /\\ x = 1\0a              /\\ y\' \\in {1,2}\0a           \\/ /\\ UNCHANGED y\0a\0a\\* For the test to meaningful, it is vital that workers\0a\\* actually continue state space exploration after the\0a\\* first invariant violation (for trace files to be written).\0aInv1 == y < 2\0aInv2 == x < 30\0a\0aConstraint == Inv1 /\\ Inv2\0a====\0a' 'INIT Init\0aNEXT Next\0a\0aCONSTRAINT Constraint\0a\0aINVARIANT Inv1\0aINVARIANT Inv2']
      ['DepthFirstErrorTrace' ~['Error: Invariant Inv is violated.' '8 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 8.' 'State 1: <Initial predicate>' 'x = 0' 'State 2: <Action line 6, col 21 to line 6, col 26 of module DepthFirstErrorTrace>' 'x = 1' 'State 3: <Action line 6, col 21 to line 6, col 26 of module DepthFirstErrorTrace>' 'x = 2' 'State 4: <Action line 6, col 21 to line 6, col 26 of module DepthFirstErrorTrace>' 'x = 3' 'State 5: <Action line 6, col 21 to line 6, col 26 of module DepthFirstErrorTrace>' 'x = 4' 'State 6: <Action line 6, col 21 to line 6, col 26 of module DepthFirstErrorTrace>' 'x = 5' 'State 7: <Action line 6, col 21 to line 6, col 26 of module DepthFirstErrorTrace>' 'x = 6' 'State 8: <Action line 6, col 21 to line 6, col 26 of module DepthFirstErrorTrace>' 'x = 7'] '--------------------------- MODULE DepthFirstErrorTrace ---------------------------\0aEXTENDS Integers\0a\0aVARIABLES x\0a\0aSpec == (x=0) /\\ [][x\'=x+1]_<<x>>\0a\0aInv == x < 7\0a=============================================================================\0a' 'SPECIFICATION\0aSpec\0aINVARIANT\0aInv']
      ['DistributedTrace' ~['Error: Invariant Inv is violated.' '20 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 11.' 'State 1: <Initial predicate>' 'x = 10' 'State 2: <Next line 9, col 9 to line 9, col 18 of module DistributedTrace>' 'x = 11' 'State 3: <Next line 9, col 9 to line 9, col 18 of module DistributedTrace>' 'x = 12' 'State 4: <Next line 9, col 9 to line 9, col 18 of module DistributedTrace>' 'x = 13' 'State 5: <Next line 9, col 9 to line 9, col 18 of module DistributedTrace>' 'x = 14' 'State 6: <Next line 9, col 9 to line 9, col 18 of module DistributedTrace>' 'x = 15' 'State 7: <Next line 9, col 9 to line 9, col 18 of module DistributedTrace>' 'x = 16' 'State 8: <Next line 9, col 9 to line 9, col 18 of module DistributedTrace>' 'x = 17' 'State 9: <Next line 9, col 9 to line 9, col 18 of module DistributedTrace>' 'x = 18' 'State 10: <Next line 9, col 9 to line 9, col 18 of module DistributedTrace>' 'x = 19' 'State 11: <Next line 9, col 9 to line 9, col 18 of module DistributedTrace>' 'x = 20'] '-------------------------- MODULE DistributedTrace --------------------------\0aEXTENDS Integers, Sequences\0a\0aVARIABLES x\0avars == <<x>>\0a\0aInit == x \\in 1..10\0a\0aNext == x\' = x + 1\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a\0aInv == x < 20\0a=============================================================================\0a' 'SPECIFICATION\0aSpec\0aINVARIANT\0aInv']
      ['Github1145b' ~['Error: Invariant Inv is violated by the initial state:' '' ''] '\\* Regression test for https://github.com/tlaplus/tlaplus/issues/1145\0a\\*\0a\\* The trailing [1] function application (OPCODE_fa) sets EvalControl.KeepLazy,\0a\\* which propagates through F\'s body into the evaluation of the EXCEPT expression.\0a\\* KeepLazy prevents OPCODE_fc from eagerly converting the FcnLambdaValue to\0a\\* FcnRcdValue, so SubSeq receives a FcnLambdaValue whose toTuple()—before the\0a\\* fix—ignores the EXCEPT and returns <<0,0,0,0>> instead of <<0,1,0,0>>.\0a\\*\0a\\* With the fix:    x = 1, Inv is violated  → TLC reports VIOLATION_SAFETY.\0a\\* Without the fix: x = 0, Inv holds        → TLC reports SUCCESS (soundness bug).\0a---- MODULE Github1145b ----\0a\0aEXTENDS Sequences, Naturals\0a\0aF(seq) == SubSeq(seq, 2, 2)\0a\0aVARIABLE x\0a\0aInit == x = F([[i \\in 1..4 |-> 0] EXCEPT ![2] = 1])[1]\0a\0aNext == UNCHANGED x\0a\0aInv == x # 1\0a\0a====\0a' 'INIT Init\0aNEXT Next\0aINVARIANT Inv\0a']
      ['Github725d' ~['Model checking completed. No error has been found.' '1 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 1.'] '---- MODULE Github725d ----\0aVARIABLE a\0a\0aInit == a = 0\0a\0aNext == UNCHANGED a\0a\0a\\* LET/IN wrapping a primed variable as the LHS of = inside ENABLED\0aInv == ENABLED ((LET y == a\' IN y) = 0)\0a====\0a' 'INIT Init\0aNEXT Next\0aINVARIANT Inv\0a']
      ['Github743' ~['Error: Invariant Inv is violated.' '9 distinct states found, 3 states left on queue.' 'The depth of the complete state graph search is 4.' 'State 1: <Initial predicate>' '/\\ x = "foo"' '/\\ y = 0' 'State 2: <Next line 11, col 8 to line 12, col 20 of module Github743>' '/\\ x = "foo"' '/\\ y = 1' 'State 3: <Next line 13, col 8 to line 14, col 20 of module Github743>' '/\\ x = TRUE' '/\\ y = 3' 'State 4: <Next line 13, col 8 to line 14, col 20 of module Github743>' '/\\ x = TRUE' '/\\ y = 5'] '---------------------------- MODULE Github743 ----------------------------\0aEXTENDS Integers\0a\0aVARIABLES x, y\0a\0aInit ==\0a\09/\\ x = "foo"\0a    /\\ y = 0\0a\09\0aNext ==\0a    \\/ /\\ x\' = "foo"\0a       /\\ y\' = y + 1\0a    \\/ /\\ x\' = TRUE\0a       /\\ y\' = y + 2\0a\09\0aSpec ==\0a\09/\\ Init\0a\09/\\ [][Next]_<<x,y>>\0a\09\0aInv ==\0a\09/\\ y < 5\0a\0a==========================================================================' 'SPECIFICATION\0a    Spec\0aINVARIANT\0a    Inv']
      ['Github746' ~['Error: Invariant Inv is violated by the initial state:' '' ''] '---------------------------- MODULE Github746 ----------------------------\0a\0aVARIABLE i\0a\0aInit == i = 1\0a\0aNext == UNCHANGED i\0a\0aSpec == Init /\\ [][Next]_i\0a\0aInv == i = 2\0a\0aAlias == [\0ai |-> i, foo |-> "bar", j |-> i = i\'\0a]\0a\0a==========================================================================' 'SPECIFICATION Spec\0aINVARIANTS Inv\0aALIAS Alias']
      ['SubsetEq' ~['Model checking completed. No error has been found.' '1 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 1.'] '------------------------------ MODULE SubsetEq ------------------------------\0aEXTENDS Integers, FiniteSets\0a\0aVARIABLE b\0a\0aInit == b = TRUE\0a\0aNext == b\' = /\\ (SUBSET (1..23) \\subseteq SUBSET (1..42))\0a             /\\ ~(SUBSET (1..42) \\subseteq SUBSET (1..23))\0a             /\\ ~(SUBSET (1..42) \\subseteq SUBSET (2..42))\0a             /\\ (SUBSET (2..42) \\subseteq SUBSET (1..42))\0a             /\\ (SUBSET {1,2,3} \\subseteq SUBSET {1,2,3,4})\0a             /\\ (SUBSET {} \\subseteq SUBSET {})\0a             /\\ (SUBSET {} \\subseteq SUBSET {1})\0a             /\\ ~(SUBSET {1} \\subseteq SUBSET {})\0a             /\\ (SUBSET {1} \\subseteq SUBSET Int)\0a             /\\ (SUBSET {1} \\subseteq SUBSET Nat)\0a\0aSpec == Init /\\ [][Next]_<<b>>\0a\0aInv == b = TRUE /\\ b \\in BOOLEAN\0a=============================================================================\0a' 'SPECIFICATION\0aSpec\0aINVARIANT\0aInv']
      ['SubseteqNextState' ~['Model checking completed. No error has been found.' '8 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 2.'] '---- MODULE SubseteqNextState ----\0aEXTENDS TLC\0aVARIABLES x, y\0aTypeOK == x \\subseteq {1, 2, 3}\0aInv ==\0a  /\\ ENABLED (x\' \\subseteq {1})\0a  /\\ y = {1, 2, 3}\0aInit ==\0a  /\\ x \\subseteq {1, 2}\0a  /\\ y = {1, 2, 3}\0aNext ==\0a  /\\ UNCHANGED y\0a  /\\ x\' \\subseteq y\'\0a\0aFullSet == x = {1, 2, 3}\0a\0aGainThree == 3 \\in x\' /\\ 3 \\notin x\0a\0aPossibleCounts ==\0a    LET p == TLCGet("all:named")["s:_possible"][1]\0a    IN /\\ p["FullSet"] = 8\0a       /\\ p["GainThree"] = 16\0a====\0a' 'INIT Init\0aNEXT Next\0aINVARIANTS TypeOK Inv\0a_POSSIBLE FullSet GainThree\0aPOSTCONDITION PossibleCounts\0a']
      ['TraceWithLargeSetOfInitialStatesTest' ~['Error: Invariant Inv is violated.' '12 distinct states found, 10 states left on queue.' 'The depth of the complete state graph search is 2.' 'State 1: <Initial predicate>' '/\\ x = 1' '/\\ y = FALSE' 'State 2: <Action line 6, col 42 to line 6, col 60 of module TraceWithLargeSetOfInitialStatesTest>' '/\\ x = 1' '/\\ y = TRUE'] '---------------- MODULE TraceWithLargeSetOfInitialStatesTest ----------------\0aEXTENDS Integers\0a\0aVARIABLES x,y\0a\0aSpec == (x \\in 1..11 /\\ y = FALSE) /\\ [][x\' = x /\\ y\' = TRUE]_<<x,y>>\0a\0aInv == y = FALSE\0a=============================================================================' 'SPECIFICATION\0aSpec\0aINVARIANT\0aInv']
      ['BagsTest' ~['Model checking completed. No error has been found.' '0 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 0.'] '---------------------------- MODULE BagsTest ----------------------------\0aEXTENDS Bags, TLC, Integers\0a\0aCONSTANT C\0a\0astrings == {"a","b","c","d","e","f","g","h","i","j","k","l","m","n","o"}\0a\0as == {"a","b","c"}\0a\0aa == <<>>\0ab == <<1,2,3>>\0ac == <<2,3,4>>\0ad == <<1,1,1>>\0ae == 1 :> 1\0af == 2 :> 1\0ag == [x \\in {1,2,3} |-> x * x]\0ah == [a |-> 3, b |-> 2, c |-> 1]\0a\0aASSUME(EmptyBag = <<>>)\0a\0a\\* IsABag\0aASSUME(IsABag(a))\0aASSUME(IsABag(b))\0aASSUME(IsABag(c))\0aASSUME(IsABag(d))\0aASSUME(IsABag(e))\0aASSUME(IsABag(f))\0aASSUME(IsABag(g))\0aASSUME(IsABag(h))\0a\0aASSUME(IsABag(SetToBag({})))\0a\0at == <<0>>\0au == 2 :> -1\0av == <<1,0>>\0aw == <<0,1>>\0ax == <<0,0,0>>\0ay == <<-1,-2,-3>>\0az == <<"a","b","c">>\0a\0aASSUME(~IsABag(t))\0aASSUME(~IsABag(u))\0aASSUME(~IsABag(v))\0aASSUME(~IsABag(w))\0aASSUME(~IsABag(x))\0aASSUME(~IsABag(y))\0aASSUME(~IsABag(z)) \\* With the standard module TLC fails with "Cannot decide if element "a" is element of Nat"\0a\0aASSUME(\\A bool \\in BOOLEAN : ~IsABag(bool))\0aASSUME(~IsABag(C))  \0a\0a\\* BagCardinality\0aASSUME(BagCardinality(a) = 0)\0aASSUME(BagCardinality(b) = 6)\0aASSUME(BagCardinality(c) = 9)\0aASSUME(BagCardinality(d) = 3)\0aASSUME(BagCardinality(e) = 1)\0aASSUME(BagCardinality(f) = 1)\0aASSUME(BagCardinality(g) = (1*1+2*2+3*3))\0aASSUME(BagCardinality(h) = 6)\0a\0aASSUME(BagCardinality(<<1>>) = 1)\0aASSUME(BagCardinality(<<1,3>>) = 4)\0a\0a\\* BagIn\0aASSUME(\\A elem \\in 1..10: ~BagIn(elem, a))\0aASSUME(\\A elem \\in 1..3: BagIn(elem, b))\0aASSUME(\\A elem \\in 4..10: ~BagIn(elem, b))\0aASSUME(\\A dom \\in DOMAIN c: BagIn(dom, c))\0aASSUME(\\A dom \\in DOMAIN d: BagIn(dom, d))\0aASSUME(\\A dom \\in DOMAIN e: BagIn(dom, e))\0aASSUME(\\A dom \\in DOMAIN f: BagIn(dom, f))\0aASSUME(\\A dom \\in DOMAIN f: BagIn(dom, f))\0aASSUME(\\A dom \\in DOMAIN g: BagIn(dom, g))\0aASSUME(\\A dom \\in DOMAIN h: BagIn(dom, h))\0aASSUME(\\A str \\in (strings \\ DOMAIN h): ~BagIn(str, h))\0aASSUME(\\A elem \\in s : BagIn(elem, SetToBag(s)))\0a\0a\0a\\* SetToBag and BagToSet\0aCodomain(fun) == {fun[i] : i \\in DOMAIN fun}  \0aASSUME(SetToBag(s) = [elem \\in s |-> 1])\0aASSUME(DOMAIN SetToBag(s) = s)\0aASSUME(Codomain(SetToBag(s)) = {1})\0aASSUME(BagToSet(SetToBag(s)) = s)\0a\0aASSUME(BagToSet(a) = {})\0aASSUME(BagToSet(b) = DOMAIN b)\0aASSUME(BagToSet(c) = DOMAIN c)\0aASSUME(BagToSet(d) = DOMAIN d)\0aASSUME(BagToSet(e) = {1})\0aASSUME(BagToSet(f) = {2})\0aASSUME(BagToSet(g) = DOMAIN g)\0aASSUME(BagToSet(h) = s)\0a\0a\0a\\* CopiesIn\0aASSUME(\\A str \\in strings: CopiesIn(str, a) = 0)\0a\0aASSUME(\\A dom \\in DOMAIN b: CopiesIn(dom, b) = b[dom])\0aASSUME(\\A elem \\in 5..10: CopiesIn(elem, b) = 0)\0aASSUME(\\A dom \\in DOMAIN c: CopiesIn(dom, c) = c[dom])\0aASSUME(\\A elem \\in 5..10: CopiesIn(elem, c) = 0)\0aASSUME(\\A dom \\in DOMAIN d: CopiesIn(dom, d) = d[dom])\0aASSUME(\\A elem \\in 5..10: CopiesIn(elem, d) = 0)\0a\0aASSUME(CopiesIn(1, e) = 1)\0aASSUME(CopiesIn(2, f) = 1)\0aASSUME(CopiesIn(1, f) = 0)\0aASSUME(CopiesIn(1, 1 :> 0) = 0)\0aASSUME(CopiesIn(2, 2 :> -1) = -1)\0a\0aASSUME(\\A dom \\in DOMAIN g: CopiesIn(dom, g) = dom * dom)\0a\0aASSUME(CopiesIn("a", h) = 3)\0aASSUME(CopiesIn("b", h) = 2)\0aASSUME(CopiesIn("c", h) = 1)\0aASSUME(\\A str \\in (strings \\ DOMAIN h): CopiesIn(str, h) = 0)\0a\0aASSUME(\\A aelem \\in s: CopiesIn(aelem, [elem \\in s |-> 42]) = 42)\0aASSUME(\\A aelem \\in s: CopiesIn(aelem, [elem \\in s |-> 0]) = 0)\0a\0a\0a\\* (+)\0aASSUME(EmptyBag (+) EmptyBag = EmptyBag)\0aASSUME(a (+) a = a)\0aASSUME(b (+) b = <<2,4,6>>)\0aASSUME(b (+) EmptyBag = b)\0aASSUME(c (+) c = <<4,6,8>>)\0aASSUME(d (+) d = <<2,2,2>>)\0aASSUME(e (+) e = <<2>>)\0aASSUME(b (+) c = c (+) b)\0aASSUME(b (+) c = <<3,5,7>>)\0aASSUME(h (+) h = [a |-> 6, b |-> 4, c |-> 2])\0aASSUME([c |-> 3, d |-> 2, e |-> 1] (+) h = [a |-> 3, b |-> 2, c |-> 4, d |-> 2, e |-> 1])\0a\0a\0a\\* (-)\0aASSUME(a (-) a = a)\0aASSUME(b (-) b = EmptyBag)\0aASSUME(b (-) EmptyBag = b)\0aASSUME(c (-) c = EmptyBag)\0aASSUME(d (-) d = EmptyBag)\0aASSUME(e (-) e = EmptyBag)\0aASSUME(b (-) c = b (-) c)\0aASSUME(b (-) c = EmptyBag)\0aASSUME(c (-) b = <<1,1,1>>)\0aASSUME([c |-> 3, d |-> 2, e |-> 1] (-) h = [c |-> 2, d |-> 2, e |-> 1])\0aASSUME((1:>1) (-) EmptyBag = <<1>>)\0a\0a\0a\\* BagUnion\0aASSUME(BagUnion({a,a}) = a)\0aASSUME(BagUnion({b,b}) = b)\0aASSUME(BagUnion({c,c}) = c)\0aASSUME(BagUnion({d,d}) = d)\0aASSUME(BagUnion({e,e}) = e)\0aASSUME(BagUnion({f,f}) = f)\0aASSUME(BagUnion({g,g}) = g)\0aASSUME(BagUnion({h,h}) = h)\0aASSUME(BagUnion({h,h,[c |-> 3, d |-> 2, e |-> 1]}) = h (+) [c |-> 3, d |-> 2, e |-> 1])\0aASSUME(BagUnion({a,b,c,d}) = <<4,6,8>>)\0aASSUME(BagUnion({EmptyBag, EmptyBag}) = <<>>)\0aASSUME(BagUnion({[a |-> 3, b |-> 2, c |-> 1],[c |-> 3, d |-> 2, e |-> 1]}) = [a |-> 3, b |-> 2, c |-> 4, d |-> 2, e |-> 1])\0aASSUME(BagUnion({1 :> 2, 2 :> 2, 3 :> 3}) = (1 :> 2) (+) (2 :> 2) (+) (3 :> 3))\0aASSUME(BagUnion({<<>>, <<1,1,1>>, <<1,2,3,4>>}) = (1:>2 @@ 2:>3 @@ 3:>4 @@ 4:>4))\0a\0a\0a\\* \\sqsubseteq\0aASSUME((a \\sqsubseteq a) = TRUE)\0aASSUME((a \\sqsubseteq b) = TRUE)\0aASSUME((a \\sqsubseteq c) = TRUE)\0aASSUME((a \\sqsubseteq d) = TRUE)\0aASSUME((b \\sqsubseteq b) = TRUE)\0aASSUME((c \\sqsubseteq c) = TRUE)\0aASSUME((h \\sqsubseteq [a |-> 3]) = FALSE)\0aASSUME((h \\sqsubseteq [a |-> 3, b |-> 2]) = FALSE)\0aASSUME(([a |-> 3] \\sqsubseteq h) = TRUE)\0aASSUME(([a |-> 3, b |-> 2] \\sqsubseteq h) = TRUE)\0aASSUME(([a |-> 3, c |-> 1] \\sqsubseteq h) = TRUE)\0aASSUME(([b |-> 2, c |-> 1] \\sqsubseteq h) = TRUE)\0aASSUME((h \\sqsubseteq h) = TRUE)\0a\0a\0a\\* BagOfAll\0aASSUME(BagOfAll(LAMBDA elem : elem, a) = a)\0aASSUME(BagOfAll(LAMBDA elem : TRUE, a) = a)\0aASSUME(BagOfAll(LAMBDA elem : elem, h) = h)\0aASSUME(BagOfAll(LAMBDA elem : TRUE, h) = TRUE :> 6)\0aASSUME(BagOfAll(LAMBDA elem : IF elem = "a" THEN "b" ELSE elem, [a |-> 3, b |-> 2, c |-> 1]) = [b |-> 5, c |-> 1])\0a\0a\0a\\* SubBag\0a\\* Module overwrite does not overwrite SubBag\0a\0a\\* A dummy spec to make TLC run model checking as required by BagsTest.java.\0aSpec == [][TRUE]_<<>>\0a\0a=============================================================================\0a' 'SPECIFICATION\0aSpec\0aCONSTANT\0aC = C']
  ==
::
++  test-tlc-liveness-batch
  %+  expect-eq
    !>  ^-  (list @t)
    ~
  !>
  %-  tlc-batch-run
  ^-  (list [@t (list @t) @t @t])
  :~
      ['Github1037' ~['Model checking completed. No error has been found.' '5 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 5.'] '---- MODULE Github1037 ----\0aEXTENDS Naturals\0aVARIABLE x\0aInit == x = 1\0aNext ==\0a  IF x = 5 THEN UNCHANGED x\0a  ELSE x\' = x + 1\0aSpec == Init /\\ [][Next]_x /\\ WF_x(Next)\0aLiveness == (x = 1) => <>[](x = 5)\0a====\0a' 'SPECIFICATION Spec\0aPROPERTY Liveness\0a']
      ['Github1389' ~['Model checking completed. No error has been found.' '2 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 2.'] '--------------------------- MODULE Github1389 ---------------------------\0a\\* Regression test for https://github.com/tlaplus/tlaplus/issues/1389\0a\\* Recursive operators whose body reaches temporal level were previously\0a\\* rejected by TLC with "TLC cannot handle the temporal formula".  When\0a\\* the recursion terminates during tableau construction via an IF guard\0a\\* that evaluates to a constant, the liveness translator now expands the\0a\\* operator and translates only the chosen IF branch.  Other branch-\0a\\* selection constructs (CASE, conjunction, disjunction, implication) are\0a\\* not handled; users should write recursive operators with IF/THEN/ELSE\0a\\* (the most natural form for recursion in TLA+).\0a\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0a\\* Recursive operator with a temporal body and an IF guard that\0a\\* terminates the recursion during tableau construction.  The original\0a\\* issue used [][TRUE]_x; we use a state-level <>P here because it is a\0a\\* regular temporal formula that TLC\'s tableau actually inspects (the\0a\\* [][TRUE]_x case is recognized as an action property at the\0a\\* SpecProcessor level and never reaches the liveness translator).\0aRECURSIVE ap_0(_)\0aap_0(u) == IF u THEN <>(x = TRUE) ELSE ap_0(~u)\0a\0a\\* Recursion that terminates via a constant numeric guard.  Exercises\0a\\* expansion that walks the parameter from 3 down to 0 without ever\0a\\* encountering a state-dependent guard.\0aRECURSIVE ap_2(_)\0aap_2(n) == IF n = 0 THEN <>(x = TRUE) ELSE ap_2(n - 1)\0a\0a\\* Mirror of ap_2 with the recursive call in THEN and the terminating\0a\\* branch in ELSE.  Exercises the symmetric branch of the OPCODE_ite\0a\\* handling (guard TRUE -> recurse on THEN, guard FALSE -> take ELSE).\0aRECURSIVE ap_3(_)\0aap_3(n) == IF n > 0 THEN ap_3(n - 1) ELSE <>(x = TRUE)\0a\0aSpec == x = TRUE /\\ [][x\' = ~x]_x\0a\0aPropIf      == ap_0(TRUE)\0aPropDepth   == ap_2(3)\0aPropElseRec == ap_3(3)\0a=============================================================================\0a' 'SPECIFICATION Spec\0aCHECK_DEADLOCK FALSE\0aPROPERTIES\0a    PropIf\0a    PropDepth\0a    PropElseRec\0a']
      ['Github1389Violated' ~['Error: Temporal property PropViolated was violated.' '2 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 2.' 'State 1: <Initial predicate>' 'x = 0' 'State 2: <Next line 28, col 9 to line 28, col 18 of module Github1389Violated>' 'x = 1' 'Back to state 1: <Next line 28, col 9 to line 28, col 18 of module Github1389Violated>'] '--------------------------- MODULE Github1389Violated ---------------------------\0a\\* Counterexample counterpart of Github1389.tla\0a\\* (see https://github.com/tlaplus/tlaplus/issues/1389).\0a\\*\0a\\* Github1389.tla exercises the positive case: a RECURSIVE operator that\0a\\* produces a temporal formula which holds.  This module exercises the\0a\\* inverse: the expanded property is genuinely violated, and TLC must\0a\\* yield a counterexample rather than emit TLC_LIVE_CANNOT_HANDLE_FORMULA\0a\\* or misclassify the failure.\0a\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0a\\* PropViolated reduces during tableau construction (via expansion and\0a\\* the constant-guard handling of OPCODE_ite) to <>(x = 99).  Since x\0a\\* toggles deterministically over {0, 1}, no reachable behavior ever has\0a\\* x = 99, so the property fails.  <> (rather than []) is used so\0a\\* SpecProcessor cannot route the formula to invariant checking; it must\0a\\* flow through the liveness tableau and surface as\0a\\* TLC_TEMPORAL_PROPERTY_VIOLATED.  WF_x(Next) forces progress so the\0a\\* counterexample is the deterministic two-state cycle 0 -> 1 -> 0\0a\\* rather than a trivial stuttering trace.\0aRECURSIVE Reach(_)\0aReach(n) == IF n = 0 THEN <>(x = 99) ELSE Reach(n - 1)\0a\0aInit == x = 0\0aNext == x\' = 1 - x\0aSpec == Init /\\ [][Next]_x /\\ WF_x(Next)\0a\0aPropViolated == Reach(3)\0a==================================================================\0a' 'SPECIFICATION Spec\0aCHECK_DEADLOCK FALSE\0aPROPERTY PropViolated\0a']
      ['Github1389ViolatedB' ~['Error: Temporal property PropViolated was violated.' '2 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 2.' 'State 1: <Initial predicate>' 'x = 0' 'State 2: <Next line 10, col 9 to line 10, col 18 of module Github1389ViolatedB>' 'x = 1' 'Back to state 1: <Next line 10, col 9 to line 10, col 18 of module Github1389ViolatedB>'] '--------------------------- MODULE Github1389ViolatedB ---------------------------\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aRECURSIVE Reach(_)\0aReach(n) == IF n = 0 THEN (x = 99) ELSE <>(Reach(n - 1))\0a\0aInit == x = 0\0aNext == x\' = 1 - x\0aSpec == Init /\\ [][Next]_x /\\ WF_x(Next)\0a\0aPropViolated == Reach(3)\0a==================================================================\0a' 'SPECIFICATION Spec\0aCHECK_DEADLOCK FALSE\0aPROPERTY PropViolated\0a']
      ['Github710d' ~['Error: Deadlock reached.' '4 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 4.' 'State 1: <Initial predicate>' 'x = 0' 'State 2: <Step line 7, col 9 to line 7, col 27 of module Github710d>' 'x = 1' 'State 3: <Step line 7, col 9 to line 7, col 27 of module Github710d>' 'x = 2' 'State 4: <Step line 7, col 9 to line 7, col 27 of module Github710d>' 'Error: Temporal property NeverThree was violated.' 'x = 3' 'State 1: <Initial predicate>' 'x = 0' 'State 2: <Step line 7, col 9 to line 7, col 27 of module Github710d>' 'x = 1' 'State 3: <Step line 7, col 9 to line 7, col 27 of module Github710d>' 'x = 2' 'State 4: <Step line 7, col 9 to line 7, col 27 of module Github710d>' 'x = 3'] '---- MODULE Github710d ----\0aEXTENDS Naturals\0aVARIABLE x\0a\0aInit == x = 0\0a\0aStep == x < 3 /\\ x\' = x + 1 \\* x <= 3 - see git commit msg.\0a\0aSpec == Init /\\ [][Step]_x\0a\0aFairSpec == Spec /\\ WF_x(Step)\0a\0aNeverThree == [](x = 1 => [](x # 3))\0a\0aneg_NeverThree == ~(NeverThree)\0a\0aEventuallyThree == <>(x = 3)\0a\0aTautology == (x = x) ~> (x = x)\0a====\0a' 'SPECIFICATION Spec\0aPROPERTY NeverThree\0aPROPERTY Tautology\0a']
      ['Github710e' ~['Error: Deadlock reached.' '3 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 3.' 'State 1: <Initial predicate>' 'x = 0' 'State 2: <Inc line 7, col 8 to line 7, col 26 of module Github710e>' 'x = 1' 'State 3: <Inc line 7, col 8 to line 7, col 26 of module Github710e>' 'x = 2'] '---- MODULE Github710e ----\0aEXTENDS Naturals\0aVARIABLE x\0a\0aInit == x = 0\0a\0aInc == x < 2 /\\ x\' = x + 1 \\* x <= 2 - see git commit msg.\0aNext == Inc\0a\0aSpec == Init /\\ [][Next]_x\0a\0aFairSpec == Spec /\\ WF_x(Next)\0a\0aVisitsTwoThenStaysSmall == <>(x = 1 /\\ <>(x = 2)) => <>[](x < 2)\0a\0aneg_VisitsTwoThenStaysSmall == ~(VisitsTwoThenStaysSmall)\0a\0aEventuallyZero == <>(x = 0)\0aEventuallyTwo == <>(x = 2)\0a\0aTautology == (x = x) ~> (x = x)\0a====\0a' 'SPECIFICATION Spec\0aPROPERTY VisitsTwoThenStaysSmall\0aPROPERTY neg_VisitsTwoThenStaysSmall\0aPROPERTY EventuallyZero\0aPROPERTY Tautology\0a']
      ['Github715' ~['Model checking completed. No error has been found.' '2 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 2.'] '---- MODULE Github715 ----\0aVARIABLE x\0a\0aInit == x = TRUE\0a\0aNext == x\' = ~x\0a\0aSpec == Init /\\ [][Next]_x\0a\0aProp == x\0a\0aProp2 == x = TRUE\0a\0aProp3 == TRUE\0a\0aSpecVar == x\0a====\0a' 'SPECIFICATION Spec\0aPROPERTY Prop\0a']
      ['LivenessConstraintWarning' ~['Model checking completed. No error has been found.' '5 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 5.'] '----------------------------- MODULE LivenessConstraintWarning -----------------------------\0aEXTENDS Integers, Sequences\0a\0aVARIABLES pc, history\0avars == <<pc, history>>\0a\0aInit == /\\ pc = "A" \0a        /\\ history = <<>>\0a\0aA == /\\ pc  = "A"\0a     /\\ pc\' = "B"\0a     /\\ history\' = history \\o <<pc>>\0a\0aB == /\\ pc  = "B"\0a     /\\ pc\' = "A"\0a     /\\ UNCHANGED history \0a\0aSpec == Init /\\ [][A \\/ B]_vars /\\ WF_vars(A \\/ B)\0a\0aConstraint == Len(history) < 3\0a\0aProp == <>(pc = "Done")\0a\0a==============================================================================\0a' 'CONSTRAINT\0aConstraint\0a\0aSPECIFICATION\0aSpec\0a\0aPROPERTY\0aProp']
      ['Test2a' ~['Error: Temporal property Prop1 was violated.' '5 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 5.' 'State 1: <Initial predicate>' 'x = 0' 'State 2: <Next line 10, col 9 to line 10, col 20 of module Test2a>' 'x = 1' 'State 3: <Next line 10, col 9 to line 10, col 20 of module Test2a>' 'x = 2' 'State 4: <Next line 10, col 9 to line 10, col 20 of module Test2a>' 'x = 3' 'State 5: <Next line 10, col 9 to line 10, col 20 of module Test2a>' 'x = 4' 'Back to state 1: <Next line 10, col 9 to line 10, col 20 of module Test2a>'] '---------- MODULE Test2a -----------\0a\0a(* This spec originates from an email conversation between Leslie and Yuan in 2009 *)\0a\0aEXTENDS Naturals\0aVARIABLE x\0a\0aInit == x=0\0a\0aNext == x\' = (x+1)%5\0a\0aSpec == Init /\\ [][Next]_x /\\ WF_x(Next)\0a\0aProp1 == []<>(x=5)\0a\0aneg_Prop1 == ~(Prop1)\0a\0aXCyclesToZero == []<>(x = 0)\0a==============================================\0a' '\\* SPECIFICATION definition\0aSPECIFICATION\0aSpec\0a\\* PROPERTY definition\0aPROPERTY\0aProp1\0aPROPERTY neg_Prop1\0aPROPERTY XCyclesToZero\0a']
  ==
::
++  test-tlc-examples-batch
  %+  expect-eq
    !>  ^-  (list @t)
    ~
  !>
  %-  tlc-batch-run
  ^-  (list [@t (list @t) @t @t])
  :~
      ['Channel' ~['Model checking completed. No error has been found.' '12 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 2.'] '-------------------------- MODULE Channel -----------------------------\0aEXTENDS Naturals\0aCONSTANT Data\0aVARIABLE chan \0a\0aTypeInvariant  ==  chan \\in [val : Data,  rdy : {0, 1},  ack : {0, 1}]\0a-----------------------------------------------------------------------\0aInit  ==  /\\ TypeInvariant\0a          /\\ chan.ack = chan.rdy \0a\0aSend(d) ==  /\\ chan.rdy = chan.ack\0a            /\\ chan\' = [chan EXCEPT !.val = d, !.rdy = 1 - @]\0a\0aRcv     ==  /\\ chan.rdy # chan.ack\0a            /\\ chan\' = [chan EXCEPT !.ack = 1 - @]\0a\0aNext  ==  (\\E d \\in Data : Send(d)) \\/ Rcv\0a\0aSpec  ==  Init /\\ [][Next]_chan\0a-----------------------------------------------------------------------\0aTHEOREM Spec => []TypeInvariant\0a=======================================================================\0a' '(***************************************************************************)\0a(* This is a configuration file for testing the specification Spec of      *)\0a(* module AsynchInterface.  It checks that TypeInvariant is an invariant   *)\0a(* of Spec.                                                                *)\0a(***************************************************************************)\0a\0aSPECIFICATION Spec\0a   \\* This statement tells TLC that Spec is the specification to be\0a   \\* checked.\0a\0aINVARIANT TypeInvariant\0a   \\* This statement tells TLC to check that TypeInvariant is an\0a   \\* invariant of the specification.\0a\0a(***************************************************************************)\0a(* TLC requires that every declared constant in the specification be       *)\0a(* assigned a value by a CONSTANT statement in the configuration file.     *)\0a(***************************************************************************)\0aCONSTANT\0a  Data = {d1, d2, d3}\0a    \\* This assigns to the declared constant Data the set consisting of\0a    \\* the three unspecified values d1, d2, d3.\0a']
      ['SimpleMath' ~['Model checking completed. No error has been found.' '0 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 0.'] '----------------------------- MODULE SimpleMath ----------------------------- \0a\0a(***************************************************************************)\0a(* This is a TLA+ module that asserts some simple mathematical formulas    *)\0a(* to be true.  Each formula is preceded by the TLA+ keyword ASSUME,       *)\0a(* which means that it is to be taken as an assumption.  TLC checks that   *)\0a(* assumptions are valid, so it can be used to check the truth of          *)\0a(* formulas.                                                               *)\0a(*                                                                         *)\0a(* You can modify this file and run TLC to check your own formulas.        *)\0a(* However, observe the following constraints:                             *)\0a(*                                                                         *)\0a(*  - Use only the built-in TLA operators, which are listed in Tables 1    *)\0a(*    and 2 of the book.  (To use others, you either have to add their     *)\0a(*    definitions or the TLA+ statements that import their definitions     *)\0a(*    from other modules.)                                                 *)\0a(*                                                                         *)\0a(*  - The only variables you should use are bound variables--for example,  *)\0a(*    the ones introduced by existential quantification.                   *)\0a(*                                                                         *)\0a(*  - In your formulas, you can use natural numbers (0, 1, 2, ...  ),      *)\0a(*    strings like "abc", and the values a, b, c, d, e, f, and g, which    *)\0a(*    TLC will interpret as arbitrary values that are unequal to each      *)\0a(*    other and to any other value.                                        *)\0a(*                                                                         *)\0a(*  - Use only bounded quantifiers; TLC cannot handle the unbounded        *)\0a(*    quantifiers.  (It also cannot handle the unbounded CHOOSE operator). *)\0a(*                                                                         *)\0a(* This file contains a number of ASSUME statements.  They could be        *)\0a(* replaced by a single ASSUME that assumes the conjunction of all the     *)\0a(* formulas, but using separate ASSUMEs makes it easier to locate an       *)\0a(* error.                                                                  *)\0a(*                                                                         *)\0a(* Note: Table 8 tells you how to type all the symbols that do not have    *)\0a(* obvious ASCII equivalents.                                              *)\0a(***************************************************************************)\0a\0aCONSTANTS a, b, c, d, e, f, g\0a  (*************************************************************************)\0a  (* This statement declares the values a, ... , g so they can be used in  *)\0a  (* formulas.                                                             *)\0a  (*************************************************************************)\0a\0a\0a(***************************************************************************)\0a(* This example shows how you can check propositional logic tautologies.   *)\0a(***************************************************************************)\0aASSUME\0a  \\A F, G \\in {TRUE, FALSE} : (F => G) <=> ~F \\/ G\0a  \0a\0a(***************************************************************************)\0a(* Here is an example showing how you can check that a formula is NOT a    *)\0a(* tautology of propositional logic.                                       *)\0a(***************************************************************************)\0aASSUME\0a  ~ \\A F, G \\in {TRUE, FALSE} : (F \\/ G) => (F /\\ G)\0a\0a\0a(***************************************************************************)\0a(* The following examples illustrate the operators of set theory.          *)\0a(***************************************************************************)\0aASSUME\0a  {1, 2, 2, 3, 3, 3} = {3, 1, 1, 2}\0a\0aASSUME\0a  {1, 2} \\cup {2, 3, 4} = {5, 4, 3, 2, 1} \\cap {1, 2, 3, 4}\0a\0aASSUME \0a  {1, 3} \\subseteq {3, 2, 1}\0a\0aASSUME\0a  {a, b, c} \\ {c} = {a, b}\0a\0aASSUME\0a  {a, b} \\in {{a, b}, c, {d, e}}\0a\0a\0a(***************************************************************************)\0a(* The following defines SomeSets to be the set of all subsets of the set  *)\0a(* {a, b, c, d, e}.  The ASSUME that follows shows how you can use this    *)\0a(* set to have TLC check that a property of sets hold for all the sets in  *)\0a(* SomeSets.  (This doesn\'t imply that the property is valid for all sets, *)\0a(* but it\'s likely to discover if the property is not valid.)              *)\0a(***************************************************************************)\0aSomeSets == SUBSET {a, b, c, d, e}\0a\0aASSUME\0a  \\A S, T \\in SomeSets : (S \\subseteq T) <=> S = (S \\cap T)\0a\0a=============================================================================\0a' '\\* This is a configuration file for running TLC.  At this point,\0a\\* you shouldn\'t worry about it.\0a\0aCONSTANTS \0a   a = a \0a   b = b \0a   c = c \0a   d = d \0a   e = e \0a   f = f \0a   g = g\0a']
      ['CigaretteSmokers' ~['Model checking completed. No error has been found.' '6 distinct states found, 0 states left on queue.' 'The depth of the complete state graph search is 2.'] '-------------------------- MODULE CigaretteSmokers --------------------------\0a(***************************************************************************)\0a(* A specification of the cigarette smokers problem, originally            *)\0a(* described in 1971 by Suhas Patil.                                       *)\0a(* https://en.wikipedia.org/wiki/Cigarette_smokers_problem                 *)\0a(***************************************************************************)\0aEXTENDS Integers, FiniteSets\0a\0aCONSTANT Ingredients, Offers\0aVARIABLE smokers, dealer\0a\0a(***************************************************************************)\0a(* \'Ingredients\' is a set of ingredients, originally                       *)\0a(* {matches, paper, tobacco}. \'Offers\' is a subset of subsets of           *)\0a(* ingredients, each missing just one ingredient                           *)\0a(***************************************************************************)\0aASSUME OffersAssumption ==\0a       /\\ Offers \\subseteq (SUBSET Ingredients)\0a       /\\ \\A n \\in Offers : Cardinality(n) = Cardinality(Ingredients) - 1\0a\0a(***************************************************************************)\0a(* \'smokers\' is a function from the ingredient the smoker has              *)\0a(* infinite supply of, to a BOOLEAN flag signifying smoker\'s state         *)\0a(* (smoking/not smoking)                                                   *)\0a(* \'dealer\' is an element of \'Offers\', or an empty set                     *)\0a(***************************************************************************)\0aTypeOK == /\\ smokers \\in [Ingredients -> [smoking: BOOLEAN]]\0a          /\\ dealer  \\in Offers \\/ dealer = {}\0a          \0avars == <<smokers, dealer>>\0a\0aChooseOne(S, P(_)) == CHOOSE x \\in S : P(x) /\\ \\A y \\in S : P(y) => y = x\0a\0aInit == /\\ smokers = [r \\in Ingredients |-> [smoking |-> FALSE]]\0a        /\\ dealer \\in Offers\0a        \0astartSmoking == /\\ dealer /= {}\0a                /\\ smokers\' = [r \\in Ingredients |-> [smoking |-> {r} \\cup \0a                                                      dealer = Ingredients]]\0a                /\\ dealer\' = {}\0a                \0astopSmoking == /\\ dealer = {}\0a               /\\ LET r == ChooseOne(Ingredients,\0a                                     LAMBDA x : smokers[x].smoking)\0a                  IN smokers\' = [smokers EXCEPT ![r].smoking = FALSE] \0a               /\\ dealer\' \\in Offers\0a\0aNext == startSmoking \\/ stopSmoking\0a\0aSpec == Init /\\ [][Next]_vars\0aFairSpec == Spec /\\ WF_vars(Next)\0a\0a(***************************************************************************)\0a(* An invariant checking that at most one smoker smokes at any particular  *)\0a(* moment                                                                  *)\0a(***************************************************************************)\0aAtMostOne == Cardinality({r \\in Ingredients : smokers[r].smoking}) <= 1\0a=============================================================================\0a' 'CONSTANTS\0a  Ingredients = {matches, paper, tobacco}\0a  Offers = {{matches, paper}, {matches, tobacco}, {paper, tobacco}}\0aINVARIANTS TypeOK AtMostOne\0aSPECIFICATION Spec\0a\0a']
