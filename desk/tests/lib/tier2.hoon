++  test-tlc-tcommit
  %+  expect-eq
    !>  ^-  (list @t)
    :~  'Model checking completed. No error has been found.'
        '34 distinct states found, 0 states left on queue.'
        'The depth of the complete state graph search is 7.'
    ==
  !>
  %-  tlc-sum
  %+  check:check  '------------------------------- MODULE TCommit ------------------------------\0aCONSTANT RM       \\* The set of participating resource managers\0aVARIABLE rmState  \\* `rmState[rm]\' is the state of resource manager rm.\0a-----------------------------------------------------------------------------\0aTCTypeOK == \0a  (*************************************************************************)\0a  (* The type-correctness invariant                                        *)\0a  (*************************************************************************)\0a  rmState \\in [RM -> {"working", "prepared", "committed", "aborted"}]\0a\0aTCInit ==   rmState = [rm \\in RM |-> "working"]\0a  (*************************************************************************)\0a  (* The initial predicate.                                                *)\0a  (*************************************************************************)\0a\0acanCommit == \\A rm \\in RM : rmState[rm] \\in {"prepared", "committed"}\0a  (*************************************************************************)\0a  (* True iff all RMs are in the "prepared" or "committed" state.          *)\0a  (*************************************************************************)\0a\0anotCommitted == \\A rm \\in RM : rmState[rm] # "committed" \0a  (*************************************************************************)\0a  (* True iff neither no resource manager has decided to commit.           *)\0a  (*************************************************************************)\0a-----------------------------------------------------------------------------\0a(***************************************************************************)\0a(* We now define the actions that may be performed by the RMs, and then    *)\0a(* define the complete next-state action of the specification to be the    *)\0a(* disjunction of the possible RM actions.                                 *)\0a(***************************************************************************)\0aPrepare(rm) == /\\ rmState[rm] = "working"\0a               /\\ rmState\' = [rmState EXCEPT ![rm] = "prepared"]\0a\0aDecide(rm)  == \\/ /\\ rmState[rm] = "prepared"\0a                  /\\ canCommit\0a                  /\\ rmState\' = [rmState EXCEPT ![rm] = "committed"]\0a               \\/ /\\ rmState[rm] \\in {"working", "prepared"}\0a                  /\\ notCommitted\0a                  /\\ rmState\' = [rmState EXCEPT ![rm] = "aborted"]\0a\0aTCNext == \\E rm \\in RM : Prepare(rm) \\/ Decide(rm)\0a  (*************************************************************************)\0a  (* The next-state action.                                                *)\0a  (*************************************************************************)\0a-----------------------------------------------------------------------------\0aTCSpec == TCInit /\\ [][TCNext]_rmState\0a  (*************************************************************************)\0a  (* The complete specification of the protocol.                           *)\0a  (*************************************************************************)\0a-----------------------------------------------------------------------------\0a(***************************************************************************)\0a(* We now assert invariance properties of the specification.               *)\0a(***************************************************************************)\0aTCConsistent ==  \0a  (*************************************************************************)\0a  (* A state predicate asserting that two RMs have not arrived at          *)\0a  (* conflicting decisions.                                                *)\0a  (*************************************************************************)\0a  \\A rm1, rm2 \\in RM : ~ /\\ rmState[rm1] = "aborted"\0a                         /\\ rmState[rm2] = "committed"\0a\0aTHEOREM TCSpec => [](TCTypeOK /\\ TCConsistent)\0a  (*************************************************************************)\0a  (* Asserts that TCTypeOK and TCConsistent are invariants of the protocol. *)\0a  (*************************************************************************)\0a=============================================================================\0a'
  'CONSTANT RM = {r1, r2, r3}\0aINVARIANTS TCTypeOK TCConsistent\0aSPECIFICATION TCSpec\0aCHECK_DEADLOCK FALSE\0a\0a'
::
++  test-sany-batch
  %+  expect-eq
    !>  ^-  (list @t)
    ~
  !>
  %-  sany-batch-run
  ^-  (list [@t ?(%accept %reject) (list [@t @t])])
  :~
      ['ActionLevelProp' %accept ~[['ActionLevelProp' '---- MODULE ActionLevelProp ----\0aEXTENDS Naturals\0a\0aVARIABLE x\0avars == x\0a\0aInit ==\0a    x = 0\0a\0aNext ==\0a    /\\ x < 5\0a    /\\ x\' = x + 1\0a\0aSpec ==\0a    Init /\\ [][Next]_vars\0a\0a------\0a\0aActionLivePropA ==\0a    x\' > x\0a\0aActionLivePropB ==\0a\09Next\0a\0aActionLivePropC ==\0a    Next \\/ UNCHANGED vars\0a\0aActionLivePropD ==\0a    [Next]_vars\0a\0aActionLivePropE ==\0a    <<Next>>_vars\0a\0a=============================================================================\0aThe following formulas are state level and, thus, out of scope.\0a    ENABLED Next\0a    ENABLED [Next]_vars\0a    ENABLED <<Next>>_vars\0a']]]
      ['Alias' %accept ~[['Alias' '\0a\0a\0a\0a\0a\0a\0a---- MODULE Alias ----\0aEXTENDS Integers, TLC, Sequences, TLCExt\0a\0aVARIABLES x, y\0avars == <<x,y>>\0a\0aA ==\0a/\\ y\' = ~y\0a/\\ x < 4\0a/\\ x\' = x + 1\0a\0aB ==\0a/\\ y\' = ~y\0a/\\ x = 4\0a/\\ x\' = 1             \0a\0aNext == A \\/ B\0a\0aSpec == x = 1 /\\ y = FALSE /\\ [][Next]_vars\0a\0aFairSpec == Spec /\\ WF_vars(Next)\0a\0aInv == x < 4\0a\0aProp == <>(x > 4)\0a\0aAnimation(e1,e2) == "e1: " \\o ToString(e1) \\o " e2: " \\o ToString(e2)\0a\0a\\* An expression that is evaluated on the pair of states\0a\\* s and t and printed in place of s in an error trace.\0a\\* Useful to:\0a\\* - filter out variables (not shown below)\0a\\* - rename variables\0a\\* - map variables (e.g. animation)\0a\\* - additional trace expressions\0a\\* TLC ignores the original state if the evaluation of\0a\\* Alias fails.\0aAlias == IF TLCGet("config").mode = "simulate" THEN\0a         [y |-> y, \\* x and y reordered.\0a          x |-> x, \0a          a |-> x\' - x, \0a          b |-> x\' = x,\0a          anim |-> Animation(x, y), \\* Animation\0a          te |-> ENABLED Next,      \\* Trace Expression\0a          TLCGetAction |-> TLCGet("action"),\0a          lvl |-> [ i \\in {1,2} |-> TLCGet("level")]]\0a         ELSE IF TLCGet("spec").impliedtemporals # {} THEN\0a         [yy |-> y, \\* x and y reordered.\0a          x |-> x, \0a          a |-> x\' - x, \0a          b |-> x\' = x,\0a          anim |-> Animation(x, y), \\* Animation\0a          te |-> ENABLED Next,      \\* Trace Expression\0a          lvl |-> [ i \\in {1,2} |-> TLCGet("level")],\0a          trc |-> Trace]\0a         ELSE\0a         [yy |-> y, \\* x and y reordered.\0a          x |-> x, \0a          a |-> x\' - x, \0a          b |-> x\' = x,\0a          anim |-> Animation(x, y), \\* Animation\0a          te |-> ENABLED Next,      \\* Trace Expression\0a          lvl |-> [ i \\in {1,2} |-> TLCGet("level")]]\0a\0aPostCondition ==\0a\09/\\ TLCGet("config").mode = "bfs" => TLCSet(42, TLCGet("generated"))\0a  \09/\\ CounterExample = \0a  \09   IF TLCGet("config").mode = "simulate" THEN\0a  \09   \09[ action |->\0a\09      { << << 1,\0a\09              [ x |-> 1,\0a\09                y |-> FALSE,\0a\09                a |-> 1,\0a\09                b |-> FALSE,\0a\09                anim |-> "e1: 1 e2: FALSE",\0a\09                te |-> TRUE,\0a\09                TLCGetAction |->\0a\09                    [ name |-> "UnnamedAction",\0a\09                      location |->\0a\09                          [ beginLine |-> 26,\0a\09                            beginColumn |-> 18,\0a\09                            endLine |-> 26,\0a\09                            endColumn |-> 26,\0a\09                            module |-> "Alias" ] ],\0a\09                lvl |-> <<1, 1>> ] >>,\0a\09           [ name |-> "A",\0a\09             location |->\0a\09                 [ beginLine |-> 15,\0a\09                   beginColumn |-> 1,\0a\09                   endLine |-> 17,\0a\09                   endColumn |-> 13,\0a\09                   module |-> "Alias" ] ],\0a\09           << 2,\0a\09              [ x |-> 2,\0a\09                y |-> TRUE,\0a\09                a |-> 1,\0a\09                b |-> FALSE,\0a\09                anim |-> "e1: 2 e2: TRUE",\0a\09                te |-> TRUE,\0a\09                TLCGetAction |->\0a\09                    [ name |-> "A",\0a\09                      location |->\0a\09                          [ beginLine |-> 15,\0a\09                            beginColumn |-> 1,\0a\09                            endLine |-> 17,\0a\09                            endColumn |-> 13,\0a\09                            module |-> "Alias" ] ],\0a\09                lvl |-> <<2, 2>> ] >> >>,\0a\09        << << 2,\0a\09              [ x |-> 2,\0a\09                y |-> TRUE,\0a\09                a |-> 1,\0a\09                b |-> FALSE,\0a\09                anim |-> "e1: 2 e2: TRUE",\0a\09                te |-> TRUE,\0a\09                TLCGetAction |->\0a\09                    [ name |-> "A",\0a\09                      location |->\0a\09                          [ beginLine |-> 15,\0a\09                            beginColumn |-> 1,\0a\09                            endLine |-> 17,\0a\09                            endColumn |-> 13,\0a\09                            module |-> "Alias" ] ],\0a\09                lvl |-> <<2, 2>> ] >>,\0a\09           [ name |-> "A",\0a\09             location |->\0a\09                 [ beginLine |-> 15,\0a\09                   beginColumn |-> 1,\0a\09                   endLine |-> 17,\0a\09                   endColumn |-> 13,\0a\09                   module |-> "Alias" ] ],\0a\09           << 3,\0a\09              [ x |-> 3,\0a\09                y |-> FALSE,\0a\09                a |-> 1,\0a\09                b |-> FALSE,\0a\09                anim |-> "e1: 3 e2: FALSE",\0a\09                te |-> TRUE,\0a\09                TLCGetAction |->\0a\09                    [ name |-> "A",\0a\09                      location |->\0a\09                          [ beginLine |-> 15,\0a\09                            beginColumn |-> 1,\0a\09                            endLine |-> 17,\0a\09                            endColumn |-> 13,\0a\09                            module |-> "Alias" ] ],\0a\09                lvl |-> <<3, 3>> ] >> >>,\0a\09        << << 3,\0a\09              [ x |-> 3,\0a\09                y |-> FALSE,\0a\09                a |-> 1,\0a\09                b |-> FALSE,\0a\09                anim |-> "e1: 3 e2: FALSE",\0a\09                te |-> TRUE,\0a\09                TLCGetAction |->\0a\09                    [ name |-> "A",\0a\09                      location |->\0a\09                          [ beginLine |-> 15,\0a\09                            beginColumn |-> 1,\0a\09                            endLine |-> 17,\0a\09                            endColumn |-> 13,\0a\09                            module |-> "Alias" ] ],\0a\09                lvl |-> <<3, 3>> ] >>,\0a\09           [ name |-> "A",\0a\09             location |->\0a\09                 [ beginLine |-> 15,\0a\09                   beginColumn |-> 1,\0a\09                   endLine |-> 17,\0a\09                   endColumn |-> 13,\0a\09                   module |-> "Alias" ] ],\0a\09           << 4,\0a\09              [ x |-> 4,\0a\09                y |-> TRUE,\0a\09                a |-> 0,\0a\09                b |-> TRUE,\0a\09                anim |-> "e1: 4 e2: TRUE",\0a\09                te |-> TRUE,\0a\09                TLCGetAction |->\0a\09                    [ name |-> "A",\0a\09                      location |->\0a\09                          [ beginLine |-> 15,\0a\09                            beginColumn |-> 1,\0a\09                            endLine |-> 17,\0a\09                            endColumn |-> 13,\0a\09                            module |-> "Alias" ] ],\0a\09                lvl |-> <<4, 4>> ] >> >> },\0a\09\09  state |->\0a\09\09      { << 1,\0a\09\09           [ x |-> 1,\0a\09\09             y |-> FALSE,\0a\09\09             a |-> 1,\0a\09\09             b |-> FALSE,\0a\09\09             anim |-> "e1: 1 e2: FALSE",\0a\09\09             te |-> TRUE,\0a\09\09             TLCGetAction |->\0a\09\09                 [ name |-> "UnnamedAction",\0a\09\09                   location |->\0a\09\09                       [ beginLine |-> 26,\0a\09\09                         beginColumn |-> 18,\0a\09\09                         endLine |-> 26,\0a\09\09                         endColumn |-> 26,\0a\09\09                         module |-> "Alias" ] ],\0a\09\09             lvl |-> <<1, 1>> ] >>,\0a\09\09        << 2,\0a\09\09           [ x |-> 2,\0a\09\09             y |-> TRUE,\0a\09\09             a |-> 1,\0a\09\09             b |-> FALSE,\0a\09\09             anim |-> "e1: 2 e2: TRUE",\0a\09\09             te |-> TRUE,\0a\09\09             TLCGetAction |->\0a\09\09                 [ name |-> "A",\0a\09\09                   location |->\0a\09\09                       [ beginLine |-> 15,\0a\09\09                         beginColumn |-> 1,\0a\09\09                         endLine |-> 17,\0a\09\09                         endColumn |-> 13,\0a\09\09                         module |-> "Alias" ] ],\0a\09\09             lvl |-> <<2, 2>> ] >>,\0a\09\09        << 3,\0a\09\09           [ x |-> 3,\0a\09\09             y |-> FALSE,\0a\09\09             a |-> 1,\0a\09\09             b |-> FALSE,\0a\09\09             anim |-> "e1: 3 e2: FALSE",\0a\09\09             te |-> TRUE,\0a\09\09             TLCGetAction |->\0a\09\09                 [ name |-> "A",\0a\09\09                   location |->\0a\09\09                       [ beginLine |-> 15,\0a\09\09                         beginColumn |-> 1,\0a\09\09                         endLine |-> 17,\0a\09\09                         endColumn |-> 13,\0a\09\09                         module |-> "Alias" ] ],\0a\09\09             lvl |-> <<3, 3>> ] >>,\0a\09\09        << 4,\0a\09\09           [ x |-> 4,\0a\09\09             y |-> TRUE,\0a\09\09             a |-> 0,\0a\09\09             b |-> TRUE,\0a\09\09             anim |-> "e1: 4 e2: TRUE",\0a\09\09             te |-> TRUE,\0a\09\09             TLCGetAction |->\0a\09\09                 [ name |-> "A",\0a\09\09                   location |->\0a\09\09                       [ beginLine |-> 15,\0a\09\09                         beginColumn |-> 1,\0a\09\09                         endLine |-> 17,\0a\09\09                         endColumn |-> 13,\0a\09\09                         module |-> "Alias" ] ],\0a\09\09             lvl |-> <<4, 4>> ] >> } ]\0a  \09   ELSE\0a\09\09[ action |->\0a            { << << 1,\0a                    [ x |-> 1,\0a                      a |-> 1,\0a                      b |-> FALSE,\0a                      anim |-> "e1: 1 e2: FALSE",\0a                      te |-> TRUE,\0a                      lvl |-> <<1, 1>>,\0a\09\09                yy |-> FALSE ] >>,\0a                [ name |-> "A",\0a                  location |->\0a                      [ beginLine |-> 15,\0a                        beginColumn |-> 1,\0a                        endLine |-> 17,\0a                        endColumn |-> 13,\0a                        module |-> "Alias" ] ],\0a                << 2,\0a                    [ x |-> 2,\0a                      a |-> 1,\0a                      b |-> FALSE,\0a                      anim |-> "e1: 2 e2: TRUE",\0a                      te |-> TRUE,\0a                      lvl |-> <<2, 2>>,\0a\09\09                yy |-> TRUE ] >> >>,\0a              << << 2,\0a                    [ x |-> 2,\0a                      a |-> 1,\0a                      b |-> FALSE,\0a                      anim |-> "e1: 2 e2: TRUE",\0a                      te |-> TRUE,\0a                      lvl |-> <<2, 2>>,\0a\09\09                yy |-> TRUE ] >>,\0a                [ name |-> "A",\0a                  location |->\0a                      [ beginLine |-> 15,\0a                        beginColumn |-> 1,\0a                        endLine |-> 17,\0a                        endColumn |-> 13,\0a                        module |-> "Alias" ] ],\0a                << 3,\0a                    [ x |-> 3,\0a                      a |-> 1,\0a                      b |-> FALSE,\0a                      anim |-> "e1: 3 e2: FALSE",\0a                      te |-> TRUE,\0a                      lvl |-> <<3, 3>>,\0a\09\09                yy |-> FALSE ] >> >>,\0a              << << 3,\0a                    [ x |-> 3,\0a                      a |-> 1,\0a                      b |-> FALSE,\0a                      anim |-> "e1: 3 e2: FALSE",\0a                      te |-> TRUE,\0a                      lvl |-> <<3, 3>>,\0a\09\09                yy |-> FALSE ] >>,\0a                [ name |-> "A",\0a                  location |->\0a                      [ beginLine |-> 15,\0a                        beginColumn |-> 1,\0a                        endLine |-> 17,\0a                        endColumn |-> 13,\0a                        module |-> "Alias" ] ],\0a\09\09           << 4,\0a\09\09              [ x |-> 4,\0a\09\09                a |-> 0,\0a\09\09                b |-> TRUE,\0a\09\09                anim |-> "e1: 4 e2: TRUE",\0a\09\09                te |-> TRUE,\0a\09\09                lvl |-> <<4, 4>>,\0a\09\09                yy |-> TRUE ] >> >> },\0a\09        state |->\0a\09            { << 1,\0a\09                [ x |-> 1,\0a\09                  a |-> 1,\0a\09                  b |-> FALSE,\0a\09                  anim |-> "e1: 1 e2: FALSE",\0a\09                  te |-> TRUE,\0a\09                  lvl |-> <<1, 1>>,\0a\09\09             yy |-> FALSE ] >>,\0a\09              << 2,\0a\09                [ x |-> 2,\0a\09                  a |-> 1,\0a\09                  b |-> FALSE,\0a\09                  anim |-> "e1: 2 e2: TRUE",\0a\09                  te |-> TRUE,\0a\09                  lvl |-> <<2, 2>>,\0a\09\09             yy |-> TRUE ] >>,\0a\09              << 3,\0a\09                [ x |-> 3,\0a\09                  a |-> 1,\0a\09                  b |-> FALSE,\0a\09                  anim |-> "e1: 3 e2: FALSE",\0a\09                  te |-> TRUE,\0a\09                  lvl |-> <<3, 3>>,\0a\09\09             yy |-> FALSE ] >>,\0a\09\09        << 4,\0a\09\09           [ x |-> 4,\0a\09\09             a |-> 0,\0a\09\09             b |-> TRUE,\0a\09\09             anim |-> "e1: 4 e2: TRUE",\0a\09\09             te |-> TRUE,\0a\09\09             lvl |-> <<4, 4>>,\0a\09\09             yy |-> TRUE ] >> } ]\0a\09\0aPostConditionLasso ==\0a  \09/\\ IF CounterExample.state = {} THEN TRUE ELSE CounterExample = \0a\09\09\09[ action |->\0a\09\09\09      { << <<1, [x |-> 1, y |-> FALSE]>>,\0a\09\09\09           [ name |-> "A",\0a\09\09\09             location |->\0a\09\09\09                 [ beginLine |-> 15,\0a\09\09\09                   beginColumn |-> 1,\0a\09\09\09                   endLine |-> 17,\0a\09\09\09                   endColumn |-> 13,\0a\09\09\09                   module |-> "Alias" ] ],\0a\09\09\09           <<2, [x |-> 2, y |-> TRUE]>> >>,\0a\09\09\09        << <<2, [x |-> 2, y |-> TRUE]>>,\0a\09\09\09           [ name |-> "A",\0a\09\09\09             location |->\0a\09\09\09                 [ beginLine |-> 15,\0a\09\09\09                   beginColumn |-> 1,\0a\09\09\09                   endLine |-> 17,\0a\09\09\09                   endColumn |-> 13,\0a\09\09\09                   module |-> "Alias" ] ],\0a\09\09\09           <<3, [x |-> 3, y |-> FALSE]>> >>,\0a\09\09\09        << <<3, [x |-> 3, y |-> FALSE]>>,\0a\09\09\09           [ name |-> "A",\0a\09\09\09             location |->\0a\09\09\09                 [ beginLine |-> 15,\0a\09\09\09                   beginColumn |-> 1,\0a\09\09\09                   endLine |-> 17,\0a\09\09\09                   endColumn |-> 13,\0a\09\09\09                   module |-> "Alias" ] ],\0a\09\09\09           <<4, [x |-> 4, y |-> TRUE]>> >>,\0a\09\09\09        << <<4, [x |-> 4, y |-> TRUE]>>,\0a\09\09\09           [ name |-> "B",\0a\09\09\09             location |->\0a\09\09\09                 [ beginLine |-> 20,\0a\09\09\09                   beginColumn |-> 1,\0a\09\09\09                   endLine |-> 22,\0a\09\09\09                   endColumn |-> 9,\0a\09\09\09                   module |-> "Alias" ] ],\0a\09\09\09           <<1, [x |-> 1, y |-> FALSE]>> >> },\0a\09\09\09  state |->\0a\09\09\09      { <<1, [x |-> 1, y |-> FALSE]>>,\0a\09\09\09        <<2, [x |-> 2, y |-> TRUE]>>,\0a\09\09\09        <<3, [x |-> 3, y |-> FALSE]>>,\0a\09\09\09        <<4, [x |-> 4, y |-> TRUE]>> } ]\0a\0aTautology == (vars = vars) ~> (vars = vars)\0a\0aPostConditionStuttering ==\0a  \09/\\ IF CounterExample.state = {} THEN TRUE ELSE CounterExample = \0a\09\09\09[ action |->\0a\09\09\09      { << <<1, [x |-> 1, y |-> FALSE]>>,\0a\09\09\09           [ name |-> "UnnamedAction",\0a\09\09\09             location |->\0a\09\09\09                 [ beginLine |-> 26,\0a\09\09\09                   beginColumn |-> 18,\0a\09\09\09                   endLine |-> 26,\0a\09\09\09                   endColumn |-> 26,\0a\09\09\09                   module |-> "Alias" ] ],\0a\09\09\09           <<1, [x |-> 1, y |-> FALSE]>> >> },\0a\09\09\09  state |->\0a\09\09\09      { <<1, [x |-> 1, y |-> FALSE]>> } ]\0a\0a=======================\0a\0a---- CONFIG Alias ----\0aSPECIFICATION FairSpec\0aINVARIANT Inv\0aALIAS Alias\0aPOSTCONDITION PostCondition\0a======================\0a\0a\0a\\* FairSpec => []Inv\0aError: Invariant Inv is violated.\0aError: The behavior up to this point is:\0aState 1: <Initial predicate>\0a/\\ y = FALSE\0a/\\ x = 1\0a/\\ a = 1\0a/\\ b = FALSE\0a\0aState 2: <Action line 11, col 34 to line 11, col 46 of module Alias>\0a/\\ y = TRUE\0a/\\ x = 2\0a/\\ a = 1\0a/\\ b = FALSE\0a\0aState 3: <Action line 11, col 34 to line 11, col 46 of module Alias>\0a/\\ y = FALSE\0a/\\ x = 3\0a/\\ a = 1\0a/\\ b = FALSE\0a\0aState 4: <Action line 11, col 34 to line 11, col 46 of module Alias>\0a/\\ y = TRUE\0a/\\ x = 4\0a/\\ a = 0     \\* Stuttering\0a/\\ b = TRUE  \\* Stuttering\0a\0a-------------------------------\0a\\* Spec => Prop\0aError: Temporal properties were violated.\0aError: The following behavior constitutes a counter-example:\0a\0aState 1: <Initial predicate>\0a/\\ y = FALSE\0a/\\ x = 1\0a/\\ a = 0     \\* Stuttering\0a/\\ b = TRUE  \\* Stuttering\0a\0aState 2: Stuttering\0a\0a-------------------------------\0a\\* FairSpec => Prop\0aError: Temporal properties were violated.\0aError: The following behavior constitutes a counter-example:\0a\0aState 1: <Initial predicate>\0a/\\ y = FALSE\0a/\\ x = 1\0a/\\ a = 1\0a/\\ b = FALSE\0a\0aState 2: <Next line 17, col 9 to line 21, col 23 of module Alias>\0a/\\ y = TRUE\0a/\\ x = 2\0a/\\ a = 1\0a/\\ b = FALSE\0a\0aState 3: <Next line 17, col 9 to line 21, col 23 of module Alias>\0a/\\ y = FALSE\0a/\\ x = 3\0a/\\ a = 1\0a/\\ b = FALSE\0a\0aState 4: <Next line 17, col 9 to line 21, col 23 of module Alias>\0a/\\ y = TRUE\0a/\\ x = 4\0a/\\ a = -3      \\* State 1 is successor\0a/\\ b = FALSE   \\* State 1 is successor\0a\0aBack to state 1: <Next line 17, col 9 to line 21, col 23 of module Alias>\0a\0a-------------------------------\0a\0a']]]
      ['AssertExpressionStack' %accept ~[['AssertExpressionStack' '------------------------------ MODULE AssertExpressionStack ------------------------------\0aEXTENDS Naturals, TLC\0a\0aVARIABLES x\0a\0aSpec == x = 0 /\\ [][x\'=1/\\Assert(x=0, "Fails after initial state")]_x\0a=============================================================================\0a']]]
      ['AssignmentInit' %accept ~[['AssignmentInit' '--------------------------- MODULE AssignmentInit ---------------------------\0aEXTENDS Integers, TLC\0aVARIABLE s\0a\0amin(S) == CHOOSE e \\in S: \\A a \\in S: e <= a\0a\0aInitExit(var, S) == \\E val \\in S: (var = val /\\ var > min(S))\0a\0aInitAll(var, S) == \\A val \\in S: (var = val /\\ var \\in S)\0a\0aInitIn(var, S) == var \\in S /\\ var > min(S)\0a\0aInitEq(var, S, val) == var \\in S /\\ var + 1 = val\0a\0aisOdd(n) == n % 2 = 1\0aInitEven(var, S) == var \\in S /\\ isOdd(var)\0a\0a\\* With this Init(var), the test does not fail without its fix.\0a\\*Init(ignored) == \\E val \\in {0,1}: (s = val /\\ s > 0)\0a\0a\\* Init1 one state + Init3 one state\0aSpec == /\\ \\/ InitExit(s, {0,1}) \\* 1 unique state\0a           \\/ InitAll(s, {2})    \\* 1 unique state\0a           \\/ InitIn(s, {4,5})   \\* 1 unique state\0a           \\/ InitAll(s, {6,7})  \\* 0 unique states\0a           \\/ InitEq(s, {8,9}, 10) \\* 1 unique states\0a           \\/ InitEven(s, {10,11}) \\* 1 unique states\0a        /\\ [][InitExit(s, {0,1})/\\UNCHANGED s]_s\0a\0a=============================================================================\0a']]]
      ['AssignmentInitExpensive' %accept ~[['AssignmentInitExpensive' '--------------------------- MODULE AssignmentInitExpensive ---------------------------\0aEXTENDS Integers\0aVARIABLE s\0a\0a\\* expensiveOp takes ~10 seconds wallclock time on a modern day machine.\0a\\* The point is, that doing 10k times will make the test time out.\0aexpensiveOp == CHOOSE e \\in SUBSET (1..18) : TRUE\0a\0a\\* This variant (with an unused parameter) causes TLC to reevaluate \0a\\* CHOOSE ... SUBSET 10k times.\0a\\*expensiveOpParam(ignored) == CHOOSE e \\in SUBSET (1..18) : TRUE\0a\0aInit(var) == \\E val \\in 0..10000: var = expensiveOp\0a\0aSpec == Init(s) /\\ [][UNCHANGED s]_s\0a\0a=============================================================================\0a']]]
      ['AssignmentInitNeg' %accept ~[['AssignmentInitNeg' '--------------------------- MODULE AssignmentInitNeg ---------------------------\0aEXTENDS Integers\0aVARIABLE s\0a\0aInit(var) == \\E val \\in 0..1: (var = val /\\ var < 1)\0a\0aSpec == Init(s) /\\ [][UNCHANGED s]_s\0a\0aInv == (s < 1)\0a=============================================================================\0a']]]
      ['AssignmentNext' %accept ~[['AssignmentNext' '--------------------------- MODULE AssignmentNext ---------------------------\0aEXTENDS Integers\0aVARIABLE s\0a\0aNext(var) == \\E val \\in 0..1: (var\' = val /\\ var\' > 0)\0a\0aSpec == s = 23 /\\ [][Next(s)]_s\0a\0aInv == s # 0\0a=============================================================================\0a']]]
      ['AssignmentNext2' %accept ~[['AssignmentNext2' '--------------------------- MODULE AssignmentNext2 ---------------------------\0aEXTENDS Integers\0aVARIABLE s\0a\0aNext(var) == \\E val \\in 0..1: (var = val /\\ var > 0)\0a\0aSpec == s = "" /\\ [][Next(s\')]_s\0a\0a=============================================================================\0a']]]
      ['AssignmentNext3' %accept ~[['AssignmentNext3' '--------------------------- MODULE AssignmentNext3 ---------------------------\0aEXTENDS Integers\0aVARIABLE s\0a\0aF(var) == (var \\in 0..9 /\\ (var % 2 = 0))\0a\0aSpec == s=0 /\\ [][F(s\')]_s\0a\0a=============================================================================\0a']]]
      ['BagsTest' %accept ~[['BagsTest' '---------------------------- MODULE BagsTest ----------------------------\0aEXTENDS Bags, TLC, Integers\0a\0aCONSTANT C\0a\0astrings == {"a","b","c","d","e","f","g","h","i","j","k","l","m","n","o"}\0a\0as == {"a","b","c"}\0a\0aa == <<>>\0ab == <<1,2,3>>\0ac == <<2,3,4>>\0ad == <<1,1,1>>\0ae == 1 :> 1\0af == 2 :> 1\0ag == [x \\in {1,2,3} |-> x * x]\0ah == [a |-> 3, b |-> 2, c |-> 1]\0a\0aASSUME(EmptyBag = <<>>)\0a\0a\\* IsABag\0aASSUME(IsABag(a))\0aASSUME(IsABag(b))\0aASSUME(IsABag(c))\0aASSUME(IsABag(d))\0aASSUME(IsABag(e))\0aASSUME(IsABag(f))\0aASSUME(IsABag(g))\0aASSUME(IsABag(h))\0a\0aASSUME(IsABag(SetToBag({})))\0a\0at == <<0>>\0au == 2 :> -1\0av == <<1,0>>\0aw == <<0,1>>\0ax == <<0,0,0>>\0ay == <<-1,-2,-3>>\0az == <<"a","b","c">>\0a\0aASSUME(~IsABag(t))\0aASSUME(~IsABag(u))\0aASSUME(~IsABag(v))\0aASSUME(~IsABag(w))\0aASSUME(~IsABag(x))\0aASSUME(~IsABag(y))\0aASSUME(~IsABag(z)) \\* With the standard module TLC fails with "Cannot decide if element "a" is element of Nat"\0a\0aASSUME(\\A bool \\in BOOLEAN : ~IsABag(bool))\0aASSUME(~IsABag(C))  \0a\0a\\* BagCardinality\0aASSUME(BagCardinality(a) = 0)\0aASSUME(BagCardinality(b) = 6)\0aASSUME(BagCardinality(c) = 9)\0aASSUME(BagCardinality(d) = 3)\0aASSUME(BagCardinality(e) = 1)\0aASSUME(BagCardinality(f) = 1)\0aASSUME(BagCardinality(g) = (1*1+2*2+3*3))\0aASSUME(BagCardinality(h) = 6)\0a\0aASSUME(BagCardinality(<<1>>) = 1)\0aASSUME(BagCardinality(<<1,3>>) = 4)\0a\0a\\* BagIn\0aASSUME(\\A elem \\in 1..10: ~BagIn(elem, a))\0aASSUME(\\A elem \\in 1..3: BagIn(elem, b))\0aASSUME(\\A elem \\in 4..10: ~BagIn(elem, b))\0aASSUME(\\A dom \\in DOMAIN c: BagIn(dom, c))\0aASSUME(\\A dom \\in DOMAIN d: BagIn(dom, d))\0aASSUME(\\A dom \\in DOMAIN e: BagIn(dom, e))\0aASSUME(\\A dom \\in DOMAIN f: BagIn(dom, f))\0aASSUME(\\A dom \\in DOMAIN f: BagIn(dom, f))\0aASSUME(\\A dom \\in DOMAIN g: BagIn(dom, g))\0aASSUME(\\A dom \\in DOMAIN h: BagIn(dom, h))\0aASSUME(\\A str \\in (strings \\ DOMAIN h): ~BagIn(str, h))\0aASSUME(\\A elem \\in s : BagIn(elem, SetToBag(s)))\0a\0a\0a\\* SetToBag and BagToSet\0aCodomain(fun) == {fun[i] : i \\in DOMAIN fun}  \0aASSUME(SetToBag(s) = [elem \\in s |-> 1])\0aASSUME(DOMAIN SetToBag(s) = s)\0aASSUME(Codomain(SetToBag(s)) = {1})\0aASSUME(BagToSet(SetToBag(s)) = s)\0a\0aASSUME(BagToSet(a) = {})\0aASSUME(BagToSet(b) = DOMAIN b)\0aASSUME(BagToSet(c) = DOMAIN c)\0aASSUME(BagToSet(d) = DOMAIN d)\0aASSUME(BagToSet(e) = {1})\0aASSUME(BagToSet(f) = {2})\0aASSUME(BagToSet(g) = DOMAIN g)\0aASSUME(BagToSet(h) = s)\0a\0a\0a\\* CopiesIn\0aASSUME(\\A str \\in strings: CopiesIn(str, a) = 0)\0a\0aASSUME(\\A dom \\in DOMAIN b: CopiesIn(dom, b) = b[dom])\0aASSUME(\\A elem \\in 5..10: CopiesIn(elem, b) = 0)\0aASSUME(\\A dom \\in DOMAIN c: CopiesIn(dom, c) = c[dom])\0aASSUME(\\A elem \\in 5..10: CopiesIn(elem, c) = 0)\0aASSUME(\\A dom \\in DOMAIN d: CopiesIn(dom, d) = d[dom])\0aASSUME(\\A elem \\in 5..10: CopiesIn(elem, d) = 0)\0a\0aASSUME(CopiesIn(1, e) = 1)\0aASSUME(CopiesIn(2, f) = 1)\0aASSUME(CopiesIn(1, f) = 0)\0aASSUME(CopiesIn(1, 1 :> 0) = 0)\0aASSUME(CopiesIn(2, 2 :> -1) = -1)\0a\0aASSUME(\\A dom \\in DOMAIN g: CopiesIn(dom, g) = dom * dom)\0a\0aASSUME(CopiesIn("a", h) = 3)\0aASSUME(CopiesIn("b", h) = 2)\0aASSUME(CopiesIn("c", h) = 1)\0aASSUME(\\A str \\in (strings \\ DOMAIN h): CopiesIn(str, h) = 0)\0a\0aASSUME(\\A aelem \\in s: CopiesIn(aelem, [elem \\in s |-> 42]) = 42)\0aASSUME(\\A aelem \\in s: CopiesIn(aelem, [elem \\in s |-> 0]) = 0)\0a\0a\0a\\* (+)\0aASSUME(EmptyBag (+) EmptyBag = EmptyBag)\0aASSUME(a (+) a = a)\0aASSUME(b (+) b = <<2,4,6>>)\0aASSUME(b (+) EmptyBag = b)\0aASSUME(c (+) c = <<4,6,8>>)\0aASSUME(d (+) d = <<2,2,2>>)\0aASSUME(e (+) e = <<2>>)\0aASSUME(b (+) c = c (+) b)\0aASSUME(b (+) c = <<3,5,7>>)\0aASSUME(h (+) h = [a |-> 6, b |-> 4, c |-> 2])\0aASSUME([c |-> 3, d |-> 2, e |-> 1] (+) h = [a |-> 3, b |-> 2, c |-> 4, d |-> 2, e |-> 1])\0a\0a\0a\\* (-)\0aASSUME(a (-) a = a)\0aASSUME(b (-) b = EmptyBag)\0aASSUME(b (-) EmptyBag = b)\0aASSUME(c (-) c = EmptyBag)\0aASSUME(d (-) d = EmptyBag)\0aASSUME(e (-) e = EmptyBag)\0aASSUME(b (-) c = b (-) c)\0aASSUME(b (-) c = EmptyBag)\0aASSUME(c (-) b = <<1,1,1>>)\0aASSUME([c |-> 3, d |-> 2, e |-> 1] (-) h = [c |-> 2, d |-> 2, e |-> 1])\0aASSUME((1:>1) (-) EmptyBag = <<1>>)\0a\0a\0a\\* BagUnion\0aASSUME(BagUnion({a,a}) = a)\0aASSUME(BagUnion({b,b}) = b)\0aASSUME(BagUnion({c,c}) = c)\0aASSUME(BagUnion({d,d}) = d)\0aASSUME(BagUnion({e,e}) = e)\0aASSUME(BagUnion({f,f}) = f)\0aASSUME(BagUnion({g,g}) = g)\0aASSUME(BagUnion({h,h}) = h)\0aASSUME(BagUnion({h,h,[c |-> 3, d |-> 2, e |-> 1]}) = h (+) [c |-> 3, d |-> 2, e |-> 1])\0aASSUME(BagUnion({a,b,c,d}) = <<4,6,8>>)\0aASSUME(BagUnion({EmptyBag, EmptyBag}) = <<>>)\0aASSUME(BagUnion({[a |-> 3, b |-> 2, c |-> 1],[c |-> 3, d |-> 2, e |-> 1]}) = [a |-> 3, b |-> 2, c |-> 4, d |-> 2, e |-> 1])\0aASSUME(BagUnion({1 :> 2, 2 :> 2, 3 :> 3}) = (1 :> 2) (+) (2 :> 2) (+) (3 :> 3))\0aASSUME(BagUnion({<<>>, <<1,1,1>>, <<1,2,3,4>>}) = (1:>2 @@ 2:>3 @@ 3:>4 @@ 4:>4))\0a\0a\0a\\* \\sqsubseteq\0aASSUME((a \\sqsubseteq a) = TRUE)\0aASSUME((a \\sqsubseteq b) = TRUE)\0aASSUME((a \\sqsubseteq c) = TRUE)\0aASSUME((a \\sqsubseteq d) = TRUE)\0aASSUME((b \\sqsubseteq b) = TRUE)\0aASSUME((c \\sqsubseteq c) = TRUE)\0aASSUME((h \\sqsubseteq [a |-> 3]) = FALSE)\0aASSUME((h \\sqsubseteq [a |-> 3, b |-> 2]) = FALSE)\0aASSUME(([a |-> 3] \\sqsubseteq h) = TRUE)\0aASSUME(([a |-> 3, b |-> 2] \\sqsubseteq h) = TRUE)\0aASSUME(([a |-> 3, c |-> 1] \\sqsubseteq h) = TRUE)\0aASSUME(([b |-> 2, c |-> 1] \\sqsubseteq h) = TRUE)\0aASSUME((h \\sqsubseteq h) = TRUE)\0a\0a\0a\\* BagOfAll\0aASSUME(BagOfAll(LAMBDA elem : elem, a) = a)\0aASSUME(BagOfAll(LAMBDA elem : TRUE, a) = a)\0aASSUME(BagOfAll(LAMBDA elem : elem, h) = h)\0aASSUME(BagOfAll(LAMBDA elem : TRUE, h) = TRUE :> 6)\0aASSUME(BagOfAll(LAMBDA elem : IF elem = "a" THEN "b" ELSE elem, [a |-> 3, b |-> 2, c |-> 1]) = [b |-> 5, c |-> 1])\0a\0a\0a\\* SubBag\0a\\* Module overwrite does not overwrite SubBag\0a\0a\\* A dummy spec to make TLC run model checking as required by BagsTest.java.\0aSpec == [][TRUE]_<<>>\0a\0a=============================================================================\0a']]]
      ['BidirectionalTransitions' %accept ~[['BidirectionalTransitions' '-------- MODULE BidirectionalTransitions --------\0aEXTENDS Naturals\0aVARIABLE x\0a\0a-------------------------------------------------\0a\0aA == \\/ x\' = (x + 1) % 3\0aB == x\' \\in 0..2\0aSpec1A == (x=0) /\\ [][A \\/ B]_x/\\ WF_x(A)\0aProp1A == Spec1A /\\ WF_x(A) /\\ []<><<A>>_x\0a\0aFair1B == WF_x(B)\0aSpec1B == (x=0) /\\ [][A \\/ B]_x/\\ Fair1B\0aProp1Bx == WF_x(A)\0aProp1By == []<><<A>>_x\0a\0a-------------------------------------------------\0a\0aC == x\' = (x + 1) % 4\0aD == IF x = 0 THEN x\' = 3 ELSE  x\' = x - 1 \0aSpec2 == (x=0) /\\ [][C \\/ D]_x/\\ WF_x(D)\0aProp2 == Spec2 /\\ WF_x(D) /\\ []<><<D>>_x\0a\0aFair2C == WF_x(C)\0aSpec2C == (x=0) /\\ [][C \\/ D]_x/\\ Fair2C\0aProp2Cx == WF_x(D)\0aProp2Cy == []<><<D>>_x\0a\0aneg_Prop1Bx == ~(Prop1Bx)\0aneg_Prop1By == ~(Prop1By)\0aneg_Prop2Cx == ~(Prop2Cx)\0aneg_Prop2Cy == ~(Prop2Cy)\0a\0aXChanges == (x = 1) ~> (x # 1)\0aXCyclesToZero == []<>(x = 0)\0a\0aTautology == (x = x) ~> (x = x)\0a=================================================\0a']]]
      ['CallGotoUnlabeledTest' %reject ~[['CallGotoUnlabeledTest' '---- MODULE CallGotoUnlabeledTest ----\0a\0a(* --algorithm CallGotoUnlabeledTest\0a\0avariable x = 0;\0a\0aprocedure Foo()\0abegin\0a\\*Q: \\* Not needed anymore.\0a  x := x + 1;\0a  return;\0aend procedure;\0a\0abegin\0aA:\0a  call Foo();\0a  goto C;\0a\\*B: \\* Not needed anymore.\0a  x := 13;\0aC:\0a  x := x - 1;\0a  goto A;\0a\0aend algorithm *)\0a\\* BEGIN TRANSLATION (chksum(pcal) = "1fe457ba" /\\ chksum(tla) = "a7227a89")\0aVARIABLES pc, x, stack\0a\0avars == << pc, x, stack >>\0a\0aInit == (* Global variables *)\0a        /\\ x = 0\0a        /\\ stack = << >>\0a        /\\ pc = "A"\0a\0aLbl_1 == /\\ pc = "Lbl_1"\0a         /\\ x\' = x + 1\0a         /\\ pc\' = Head(stack).pc\0a         /\\ stack\' = Tail(stack)\0a\0aFoo == Lbl_1\0a\0aA == /\\ pc = "A"\0a     /\\ stack\' = << [ procedure |->  "Foo",\0a                      pc        |->  "C" ] >>\0a                  \\o stack\0a     /\\ pc\' = "Lbl_1"\0a     /\\ x\' = x\0a\0aLbl_2 == /\\ pc = "Lbl_2"\0a         /\\ x\' = 13\0a         /\\ pc\' = "C"\0a         /\\ stack\' = stack\0a\0aC == /\\ pc = "C"\0a     /\\ x\' = x - 1\0a     /\\ pc\' = "A"\0a     /\\ stack\' = stack\0a\0a(* Allow infinite stuttering to prevent deadlock on termination. *)\0aTerminating == pc = "Done" /\\ UNCHANGED vars\0a\0aNext == Foo \\/ A \\/ Lbl_2 \\/ C\0a           \\/ Terminating\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aTermination == <>(pc = "Done")\0a\0a\\* END TRANSLATION\0a\0a====\0a']]]
      ['CaseOtherXml' %accept ~[['CaseOtherXml' '---- MODULE CaseOtherXml ----\0aop == CASE TRUE -> FALSE [] OTHER -> TRUE\0a====\0a']]]
      ['CodePlexBug21' %accept ~[['CodePlexBug21' '--------------------------- MODULE CodePlexBug21 ---------------------------\0aEXTENDS Naturals, TLC\0a\0afunc1 == [x \\in 1..3 |-> x]\0afunc2 == <<1,2,3>>\0a\0aASSUME func1 = func2 \\* evaluated to TRUE\0aASSUME 3 :> 11 @@ func1 = <<1,2,11>> \\* evaluated to TRUE\0a\0aASSUME 3 :> 11 @@ func2 = <<1,2,11>> \\* erroneously evaluated to FALSE\0a\0aASSUME 4 :> 11 @@ func2 = <<1,2,3,11>> \\* throws a TLC error\0a=============================================================================\0a']]]
      ['ConstLevelInvariant' %accept ~[['ConstLevelInvariant' '---- MODULE ConstLevelInvariant ----\0aEXTENDS Naturals\0a\0aCONSTANT C\0a\0aVARIABLE b\0a\0aInit ==\0a    b = FALSE\0a\0aNext ==\0a    b\' = TRUE\0a\0aSpec ==\0a\09Init /\\ [][Next]_b\0a\0aConstLevelInvariant ==\0a    C \\subseteq Nat\0a\0a=============================================================================\0a---- CONFIG ConstLevelInvariant ----\0aSPECIFICATION Spec\0aCONSTANT C = {1, 2, 3}\0aINVARIANT ConstLevelInvariant\0a====']]]
      ['ConstantContextTLCCache' %accept ~[['ConstantContextTLCCache' '---- MODULE ConstantContextTLCCache ----\0aEXTENDS Integers, TLC, TLCExt\0a\0a(* Maintain a global counter, incremented whenever inc(...)\0a * is referenced. We use this to figure out how often a given\0a * expression was evaluated. *)\0a\0aCOUNT_ID == 1\0a\0aASSUME TLCSet(COUNT_ID, 0)\0a\0ainc(v) ==\0a    CASE TLCSet(COUNT_ID, TLCGet(COUNT_ID) + 1) -> v\0a\0adefn == TLCCache(inc({ x : x \\in 1 .. 5 }), {1})\0aderivedDefn == TLCCache(inc({ i \\in 1 .. 5 : i + 1 \\in defn }), {2})\0a\0a(* Below is a simple spec that references the 2 definitions, defn\0a * and derivedDefn. Both should be evaluated exactly once, regardless\0a * of being referenced by assumptions, the init state, and the next state.\0a * Note: the trick of asserting whether 5 is in the definition will catch\0a *       the case of accidentally caching one value in place of the other. *)\0a\0aVARIABLE x, y\0a\0aASSUME 5 \\in defn\0aASSUME 5 \\notin derivedDefn\0a\0aInit ==\0a    /\\ y = defn\0a    /\\ x = derivedDefn\0a\0aNext ==\0a    /\\ 1 \\in defn\0a    /\\ 1 \\in derivedDefn\0a    (* Assert the global counter here, after all defns will have been\0a     * referenced during normal evaluation order. *)\0a    /\\ Assert(TLCGet(COUNT_ID) = 2, <<"count was", TLCGet(COUNT_ID)>>)\0a    /\\ UNCHANGED <<x, y>>\0a\0a====\0a']]]
      ['ConstantOperatorConfiguration' %accept ~[['ConstantOperatorConfiguration' '---- MODULE ConstantOperatorConfiguration ----\0a\0aCONSTANT F(_)\0aVARIABLE x\0a\0aInit == x = 0\0aNext == x\' = F(x)\0aInv == x /= 2\0a\0a====\0a']]]
      ['ConstantRank1TLCEval' %accept ~[['ConstantRank1TLCEval' '---- MODULE ConstantRank1TLCEval ----\0aEXTENDS TLC\0aCONSTANT x0(_)\0aVARIABLE x\0aInit == x = TRUE\0aNext == x\' = (x0({"A"} \\union {"B"}) = {"C"})\0a====\0a---- CONFIG ConstantRank1TLCEval ----\0aINIT Init\0aNEXT Next\0aCONSTANT x0 <- TLCEval\0a====']]]
      ['ConstantRank2AssertError' %accept ~[['ConstantRank2AssertError' '---- MODULE ConstantRank2AssertError ----\0aEXTENDS TLCExt\0aCONSTANT x0(_, _)\0aVARIABLE x\0aInit == x = TRUE\0aNext == x\' = x0("no error", TRUE)\0a====\0a---- CONFIG ConstantRank2AssertError ----\0aINIT Init\0aNEXT Next\0aCONSTANT x0 <- AssertError\0a====\0a']]]
      ['Continue' %accept ~[['Continue' '---- MODULE Continue ----\0aEXTENDS Naturals\0a\0aVARIABLES x,y\0a\0aInit == x = 1 /\\ y = 1\0a\0aNext == /\\ x\' = x + 1 \0a        /\\ \\/ /\\ x = 1\0a              /\\ y\' \\in {1,2}\0a           \\/ /\\ UNCHANGED y\0a\0a\\* For the test to meaningful, it is vital that workers\0a\\* actually continue state space exploration after the\0a\\* first invariant violation (for trace files to be written).\0aInv1 == y < 2\0aInv2 == x < 30\0a\0aConstraint == Inv1 /\\ Inv2\0a====\0a']]]
      ['Decimal' %accept ~[['Decimal' '---- MODULE Decimal ----\0aop == 000123.456000\0a====\0a']]]
      ['DepthFirstErrorTrace' %accept ~[['DepthFirstErrorTrace' '--------------------------- MODULE DepthFirstErrorTrace ---------------------------\0aEXTENDS Integers\0a\0aVARIABLES x\0a\0aSpec == (x=0) /\\ [][x\'=x+1]_<<x>>\0a\0aInv == x < 7\0a=============================================================================\0a']]]
      ['DieHardAlias' %accept ~[['DieHardAlias' '---------------------------- MODULE DieHardAlias ----------------------------\0aEXTENDS DieHard\0a\0aAliasSub ==\0a[\0a    \\*bigBucket    |-> bigBucket,\0a    \\*smallBucket  |-> smallBucket,\0a    \\*action       |-> action,\0a    water_to_pour|-> water_to_pour\0a]\0aAliasSub2 ==\0a[\0a    \\*bigBucket    |-> bigBucket,\0a    \\*smallBucket  |-> smallBucket,\0a    action       |-> action\0a    \\*water_to_pour|-> water_to_pour\0a]\0aAliasSup ==\0a[\0a    bigBucket    |-> bigBucket,\0a    smallBucket  |-> smallBucket,\0a    action       |-> action,\0a    water_to_pour|-> water_to_pour,\0a    extraVar     |-> TLCGet("level")\0a]\0a=============================================================================\0a'] ['DieHard' '---------------------------- MODULE DieHard ----------------------------\0aEXTENDS TLC, Integers\0a\0aMin(m, n) == IF m < n THEN m ELSE n\0a\0aNONDET == "nondet"\0aFILL_BIG == "fill big"\0aEMPTY_BIG == "empty big"\0aFILL_SMALL == "fill small"\0aEMPTY_SMALL == "empty small"\0aBIG_TO_SMALL == "pour big to small"\0aSMALL_TO_BIG == "pour small to big"\0a\0a(***************************************************************************\0a--algorithm DieHardDemo {\0a    variables bigBucket = 0, smallBucket = 0, action = NONDET;\0a      \0a    process (FixWater = 1)\0a      variables water_to_pour = 0;\0a      {\0a        LB1: while (TRUE) \0a          {\0a            either { action := FILL_BIG; bigBucket := 5; }\0a                or { action := EMPTY_BIG; bigBucket := 0; }\0a                or { action := FILL_SMALL; smallBucket := 3; } \0a                or { action := EMPTY_SMALL; smallBucket := 0; } \0a                or { \0a                     action := BIG_TO_SMALL; \0a                     water_to_pour := Min(3 - smallBucket, bigBucket); \0a                     smallBucket := smallBucket + water_to_pour;\0a                     bigBucket := bigBucket - water_to_pour;\0a                   }\0a                or { \0a                     action := SMALL_TO_BIG; \0a                     water_to_pour := Min(5 - bigBucket, smallBucket); \0a                     smallBucket := smallBucket - water_to_pour;\0a                     bigBucket := bigBucket + water_to_pour;\0a                   }\0a          }\0a      }\0a}\0a\0a***************************************************************************)\0a\\* BEGIN TRANSLATION\0aVARIABLES bigBucket, smallBucket, action, water_to_pour\0a\0avars == << bigBucket, smallBucket, action, water_to_pour >>\0a\0aProcSet == {1}\0a\0aInit == (* Global variables *)\0a        /\\ bigBucket = 0\0a        /\\ smallBucket = 0\0a        /\\ action = NONDET\0a        (* Process FixWater *)\0a        /\\ water_to_pour = 0\0a\0aFixWater == \\/ /\\ action\' = FILL_BIG\0a               /\\ bigBucket\' = 5\0a               /\\ UNCHANGED <<smallBucket, water_to_pour>>\0a            \\/ /\\ action\' = EMPTY_BIG\0a               /\\ bigBucket\' = 0\0a               /\\ UNCHANGED <<smallBucket, water_to_pour>>\0a            \\/ /\\ action\' = FILL_SMALL\0a               /\\ smallBucket\' = 3\0a               /\\ UNCHANGED <<bigBucket, water_to_pour>>\0a            \\/ /\\ action\' = EMPTY_SMALL\0a               /\\ smallBucket\' = 0\0a               /\\ UNCHANGED <<bigBucket, water_to_pour>>\0a            \\/ /\\ action\' = BIG_TO_SMALL\0a               /\\ water_to_pour\' = Min(3 - smallBucket, bigBucket)\0a               /\\ smallBucket\' = smallBucket + water_to_pour\'\0a               /\\ bigBucket\' = bigBucket - water_to_pour\'\0a            \\/ /\\ action\' = SMALL_TO_BIG\0a               /\\ water_to_pour\' = Min(5 - bigBucket, smallBucket)\0a               /\\ smallBucket\' = smallBucket - water_to_pour\'\0a               /\\ bigBucket\' = bigBucket + water_to_pour\'\0a\0aNext == FixWater\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aInv == bigBucket # 4\0a\0a\\* END TRANSLATION\0a\0a=============================================================================\0a']]]
      ['DieHardTLA' %accept ~[['DieHardTLA' '------------------------------ MODULE DieHardTLA ------------------------------\0aEXTENDS Integers, TLC, _Possible\0a\0aVARIABLES small, big   \0a          \0aTypeOK == /\\ small \\in 0..3 \0a          /\\ big   \\in 0..5\0a\0aInit == /\\ big   = 0 \0a        /\\ small = 0\0a        /\\ TLCSet(42, 0)\0a\0a\0aFillSmall == /\\ small\' = 3 \0a             /\\ big\'   = big\0a             /\\ TLCSet(42, TLCGet(42) + 3)\0a\0aFillBig == /\\ big\'   = 5 \0a           /\\ small\' = small\0a             /\\ TLCSet(42, TLCGet(42) + 5)\0a\0aEmptySmall == /\\ small\' = 0 \0a              /\\ big\'   = big\0a\0aEmptyBig == /\\ big\'   = 0 \0a            /\\ small\' = small\0a\0aSmallToBig == IF big + small =< 5\0a               THEN /\\ big\'   = big + small\0a                    /\\ small\' = 0\0a               ELSE /\\ big\'   = 5\0a                    /\\ small\' = small - (5 - big)\0a \0aBigToSmall == IF big + small =< 3\0a               THEN /\\ big\'   = 0 \0a                    /\\ small\' = big + small\0a               ELSE /\\ big\'   = small - (3 - big)\0a                    /\\ small\' = 3\0a\0aNext == \\/ FillSmall \0a        \\/ FillBig    \0a        \\/ EmptySmall \0a        \\/ EmptyBig    \0a        \\/ SmallToBig    \0a        \\/ BigToSmall    \0a        \0aSpec == Init /\\ [][Next]_<<small, big>>   \0a\0a\0aHasFour == big = 4\0a\0aPourAction == small\' # small /\\ big\' # big\0a\0aPossibleCounts ==\0a    LET p == _Counts\0a    IN /\\ p["HasFour"] = 8\0a       /\\ p["PourAction"] = 14\0a\0aPostCondition ==\0a  \\* Evaluating the spec takes 97 states of which 16 are distinct.  The\0a  \\* diameter of the spec is 8.\0a  /\\ TLCGet("generated") = 97\0a  /\\ TLCGet("distinct") = 16\0a  /\\ TLCGet("diameter") = 8\0a  \\* Total gallons of water used by TLC to check the spec is 128. Not sure\0a  \\* if this is considered an acceptable ecological footprint. \0a  /\\ \\/ TLCGet(42) = 128\0a     \\/ Print(TLCGet(42), FALSE)\0a  \\* On average, for each distinct state of the spec, TLC pours 8 gallons\0a  \\* of water from the fountain. To check if TLC correctly reports the \0a  \\* violating of this property, we expect it to be 23.\0a  /\\ \\/ (TLCGet(42) \\div TLCGet("distinct")) = 23\0a     \\/ Print(TLCGet(42) \\div TLCGet("distinct"), FALSE)\0a\0a=============================================================================\0a']]]
      ['DistributedTrace' %accept ~[['DistributedTrace' '-------------------------- MODULE DistributedTrace --------------------------\0aEXTENDS Integers, Sequences\0a\0aVARIABLES x\0avars == <<x>>\0a\0aInit == x \\in 1..10\0a\0aNext == x\' = x + 1\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a\0aInv == x < 20\0a=============================================================================\0a']]]
      ['Empty' %accept ~[['Empty' '------------------------------- MODULE Empty -------------------------------\0a============================================================================\0a']]]
      ['EmptyExistentialQuantifier' %accept ~[['EmptyExistentialQuantifier' '--------------------------- MODULE EmptyExistentialQuantifier --------------\0aVARIABLE N\0a\0aInit == N = 1\0a\0aNext == \\E i \\in {} : UNCHANGED N             \\* \\E i \\in {}: ... <=> FALSE\0a\0aSpec == Init /\\ [][Next]_<< N >>\0a\0aTHEOREM Spec => []TRUE                        \\* Due to subscript <<N>> in [][...]_<<N>>\0a============================================================================\0a\0a---- CONFIG EmptyExistentialQuantifier ----\0aSPECIFICATION Spec\0a======\0a']]]
      ['EmptyOrderOfSolutions' %accept ~[['EmptyOrderOfSolutions' '----- MODULE EmptyOrderOfSolutions -----\0aVARIABLES x\0a\0aInit == x = 0\0a\0aNext == x\' = 1\0a\0aSpec == Init /\\ [][Next]_x\0a\0aProp == <>[]TRUE => TRUE\0a=====\0a']]]
      ['EmptySubsetEq' %accept ~[['EmptySubsetEq' '--------------------------- MODULE EmptySubsetEq --------------------------\0aEXTENDS Integers, FiniteSets\0a\0aVARIABLE b\0a\0aInit == b = TRUE\0a\0aNext == b\' = /\\ (SUBSET (1..3)) \\subseteq (1..4)\0a\0aSpec == Init /\\ [][Next]_<<b>>\0a\0aInv == b = TRUE\0a=============================================================================\0a']]]
      ['EvaluatingValueTest' %accept ~[['EvaluatingValueTest' '------------------------ MODULE EvaluatingValueTest ------------------------\0aEXTENDS Naturals\0a\0aVARIABLES x\0a\0aInit == x = 1\0a\0aA == x\' = FALSE \\* This action is replaced by the @Evaluation in EvaluatingValueTest.java\0a\0aSpec == (x = 1) /\\ [][A]_x\0a\0aInv == x \\in Nat\0a\0aTHEOREM Spec => []Inv\0a\0aProp == <>(x = 42)\0a\0a============================================================================\0a']]]
      ['FingerprintExceptionHang' %accept ~[['FingerprintExceptionHang' '---- MODULE FingerprintExceptionHang ----\0a\0aEXTENDS Naturals\0a\0aCONSTANTS\0a    Nodes\0a\0aVARIABLES\0a    node_state\0a\0avars == <<node_state>>\0a\0aLegalSets == {{}}\0a\0aTypeOK ==\0a    node_state \\in [Nodes -> [set: LegalSets]]\0a\0aInit ==\0a    \\E initial_members \\in LegalSets:\0a        node_state = [n \\in Nodes |-> [set |-> initial_members]]\0a\0aNext ==\0a    \\E n \\in Nodes, new_members \\in {1}:\0a        node_state\' = [node_state EXCEPT ![n].set = new_members]\0a\0aSpec == Init /\\ [][Next]_vars\0a\0a====\0a']]]
      ['FingerprintExceptionInit' %accept ~[['FingerprintExceptionInit' '------------------------ MODULE FingerprintExceptionInit --------------------\0a\0aEXTENDS Integers\0a\0aVARIABLE x\0a\0aInit == x = SUBSET(SUBSET(1..36))\0aNext == IF {1} \\in SUBSET(1..31) THEN x\' = SUBSET(SUBSET(1..32)) ELSE x\' = 2\0aSpec == Init /\\ [][Next]_x\0a\0a=============================================================================']]]
      ['FingerprintExceptionNext' %accept ~[['FingerprintExceptionNext' '------------------------ MODULE FingerprintExceptionNext --------------------\0a\0aEXTENDS Integers\0a\0aVARIABLE x\0a\0aInit == x = 0\0aNext == IF {1} \\in SUBSET(1..31) THEN x\' = SUBSET(SUBSET(1..32)) ELSE x\' = 2\0aSpec == Init /\\ [][Next]_x\0a\0a=============================================================================']]]
      ['FingerprintExceptionNextCallstack' %accept ~[['FingerprintExceptionNextCallstack' '--------------------- MODULE FingerprintExceptionNextCallstack ------------------ \0a\0aEXTENDS Integers\0a\0aVARIABLE x\0a\0aOp(S) == LET iter[s \\in SUBSET S] == s IN iter[S]\0aInit == x = 0\0aNext == x\' = Op(42)\0aSpec == Init /\\ [][Next]_x\0a\0a=============================================================================\0a\0a   \\* Simulates e.g. user passing 42 instead of DOMAIN <<1,2>>.\0a   MapThenFoldSet(+, 0, LAMBDA i: <<1,2>>[i], LAMBDA S: Min(S), 42)\0a']]]
      ['Github1037' %accept ~[['Github1037' '---- MODULE Github1037 ----\0aEXTENDS Naturals\0aVARIABLE x\0aInit == x = 1\0aNext ==\0a  IF x = 5 THEN UNCHANGED x\0a  ELSE x\' = x + 1\0aSpec == Init /\\ [][Next]_x /\\ WF_x(Next)\0aLiveness == (x = 1) => <>[](x = 5)\0a====\0a']]]
      ['Github1109' %accept ~[['Github1109' '---------------------------- MODULE Github1109 ---------------------------\0aEXTENDS Sequences\0a\0aPart_Funct(D, R) == UNION {[d -> R] : d \\in SUBSET D}\0a\0aS == {"s"}\0a\0aR == Seq(S) \\* Cannot be enumerated.\0a\0aCONSTANTS C\0a\0aASSUME DOMAIN C # {} \\* Evaluate C to trigger Seq(S).\0a\0aC2 == [ s \\in [S -> R], p \\in {Part_Funct(S, R)} |-> TRUE ]\0a==========================================================================\0a---------------------------- CONFIG Github1109 ---------------------------\0aCONSTANT C <- C2\0a==========================================================================\0a']]]
      ['Github1109a' %accept ~[['Github1109a' '---------------------------- MODULE Github1109a ---------------------------\0aEXTENDS Sequences\0a\0aCONSTANTS C\0a\0aVARIABLE x\0a\0aC2 == x \\* References variable, so C2 is non-constant.\0a\0aInit == x = C\0a\0aNext == UNCHANGED x\0a==========================================================================\0a---------------------------- CONFIG Github1109a ---------------------------\0aCONSTANT C <- C2\0aINIT Init\0aNEXT Next\0a==========================================================================\0a']]]
      ['Github1145' %accept ~[['Github1145' '\\* Copyright (c) 2025, Oracle and/or its affiliates.\0a---- MODULE Github1145 ----\0a\0aEXTENDS Naturals, Sequences\0a\0aF(seq) == SubSeq(seq, 2, 2)\0a\0aASSUME F([[i \\in 1..4 |-> 0] EXCEPT ![2] = 1])[1]\0a     = F(<<0, 1, 0, 0>>                      )[1]\0a\0aASSUME F([[i \\in {1, 2, 3, 4} |-> 0] EXCEPT ![2] = 1])[1]\0a     = F(<<0, 1, 0, 0>>                              )[1]\0a\0a====\0a']]]
      ['Github1145b' %accept ~[['Github1145b' '\\* Regression test for https://github.com/tlaplus/tlaplus/issues/1145\0a\\*\0a\\* The trailing [1] function application (OPCODE_fa) sets EvalControl.KeepLazy,\0a\\* which propagates through F\'s body into the evaluation of the EXCEPT expression.\0a\\* KeepLazy prevents OPCODE_fc from eagerly converting the FcnLambdaValue to\0a\\* FcnRcdValue, so SubSeq receives a FcnLambdaValue whose toTuple()—before the\0a\\* fix—ignores the EXCEPT and returns <<0,0,0,0>> instead of <<0,1,0,0>>.\0a\\*\0a\\* With the fix:    x = 1, Inv is violated  → TLC reports VIOLATION_SAFETY.\0a\\* Without the fix: x = 0, Inv holds        → TLC reports SUCCESS (soundness bug).\0a---- MODULE Github1145b ----\0a\0aEXTENDS Sequences, Naturals\0a\0aF(seq) == SubSeq(seq, 2, 2)\0a\0aVARIABLE x\0a\0aInit == x = F([[i \\in 1..4 |-> 0] EXCEPT ![2] = 1])[1]\0a\0aNext == UNCHANGED x\0a\0aInv == x # 1\0a\0a====\0a']]]
      ['Github1147' %accept ~[['Github1147' '---- MODULE Github1147 ----\0aEXTENDS FiniteSets, Naturals, TLC, TLCExt\0a\0aData == {"d1", "d2"}\0a\0aVARIABLES state\0a\0aInit == state = {}\0a\0aAct(e,f,g) ==\0a\09state\' = state \\union {<<e, f, g>>}\0a\0aNext == \0a\09\\E e \\in Data: \0a\09\09\\E f \\in {1,2,3}:\0a\09\09\09\\E g \\in [{0,1,2} -> {"a","b"}]: \0a\09\09\09\09Act(e,f,g)\0a\0aInv == Cardinality(state) < 2\0a\0aPost ==\0a\09CounterExample =\0a\09\09[ state |->\0a\09\09      { <<1, [state |-> {}]>>,\0a\09\09        <<2, [state |-> {<<"d1", 1, (0 :> "a" @@ 1 :> "a" @@ 2 :> "a")>>}]>>,\0a\09\09        << 3,\0a\09\09           [ state |->\0a\09\09                 { <<"d1", 1, (0 :> "a" @@ 1 :> "a" @@ 2 :> "a")>>,\0a\09\09                   <<"d1", 1, (0 :> "a" @@ 1 :> "a" @@ 2 :> "b")>> } ] >> },\0a\09\09  action |->\0a\09\09      { << <<1, [state |-> {}]>>,\0a\09\09           [ name |-> "Act",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 11,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 11,\0a\09\09                   endColumn |-> 43,\0a\09\09                   module |-> "Github1147" ],\0a\09\09             context |->\0a\09\09                 [ e |-> "d1",\0a\09\09                   f |-> 1,\0a\09\09                   g |-> (0 :> "a" @@ 1 :> "a" @@ 2 :> "a") ],\0a\09\09             parameters |-> <<"e", "f", "g">> ],\0a\09\09           << 2,\0a\09\09              [ state |->\0a\09\09                    {<<"d1", 1, (0 :> "a" @@ 1 :> "a" @@ 2 :> "a")>>} ] >> >>,\0a\09\09        << <<2, [state |-> {<<"d1", 1, (0 :> "a" @@ 1 :> "a" @@ 2 :> "a")>>}]>>,\0a\09\09           [ name |-> "Act",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 11,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 11,\0a\09\09                   endColumn |-> 43,\0a\09\09                   module |-> "Github1147" ],\0a\09\09             context |->\0a\09\09                 [ e |-> "d1",\0a\09\09                   f |-> 1,\0a\09\09                   g |-> (0 :> "a" @@ 1 :> "a" @@ 2 :> "b") ],\0a\09\09             parameters |-> <<"e", "f", "g">> ],\0a\09\09           << 3,\0a\09\09              [ state |->\0a\09\09                    { <<"d1", 1, (0 :> "a" @@ 1 :> "a" @@ 2 :> "a")>>,\0a\09\09                      << "d1",\0a\09\09                         1,\0a\09\09                         (0 :> "a" @@ 1 :> "a" @@ 2 :> "b") >> } ] >> >> } ]\0a\09\0a=============================================================================\0a']]]
      ['Github1191' %accept ~[['Github1191' '---- MODULE Github1191 ----\0aEXTENDS Sequences\0a\0aParties == {"A", "B"}\0aConnections == Parties \\X Parties \\ {<<x, x>> : x \\in Parties}\0a\0aVARIABLES network, pc\0a\0avars == <<network, pc>>\0a\0aProcSet == Parties\0a\0aInit ==\0a    /\\ network = [c \\in Connections |-> << >>]\0a    /\\ pc = [self \\in ProcSet |-> "Start"]\0a\0aStart(self) ==\0a    /\\ pc[self] = "Start"\0a    /\\ \\E dst \\in {p \\in Parties : p /= self} :\0a        network\' = [network EXCEPT ![<<self, dst>>] = <<[type |-> "hello"]>>]\0a    /\\ pc\' = [pc EXCEPT ![self] = "Done"]\0a\0aTerminating ==\0a    /\\ \\A self \\in ProcSet : pc[self] = "Done"\0a    /\\ UNCHANGED vars\0a\0aNext ==\0a    \\/ \\E self \\in Parties : Start(self)\0a    \\/ Terminating\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ \\A self \\in Parties : WF_vars(Start(self))\0a\0aTermination == <>(\\A self \\in ProcSet : pc[self] = "Done")\0a\0a=====\0a----- CONFIG Github1191 -----\0aSPECIFICATION Spec\0aPROPERTY Termination\0a========\0a']]]
      ['Github1191a' %accept ~[['Github1191a' '---- MODULE Github1191a ----\0a\0aP == { "A", "B" }\0aC == P \\X P\0a\0aVARIABLES var\0a\0aInit == \0a    var = [c \\in C |-> << >>]\0a\0aNext ==\0a    \\E src, dst \\in P:\0a        var\' = [var EXCEPT ![<<src, dst>>] = << [ type |-> "hello" ] >>]\0a\0aSpec == Init /\\ [][Next]_var\0a\0aTermination == <>FALSE\0a\0a====\0a---- CONFIG Github1191a ----\0aSPECIFICATION Spec\0aPROPERTY Termination\0a====']]]
      ['Github1198' %accept ~[['Github1198' '---- MODULE Github1198 ----\0a\0aVARIABLE b\0a\0aInit ==\0a    b = FALSE\0a\0aNext ==\0a    b\' = TRUE\0a\0a------\0a\\* L equiv F. Warning is raised.\0a\0aLiveA ==\0a    WF_b(Next)\0a\0aSpecA ==\0a\09Init /\\ [][Next]_b /\\ LiveA\0a\0a------\0a\\* L equiv F (Conjunction). Warning is raised.\0a\0aS1B ==\0a\09WF_b(Next)\0a\0aS2B ==\0a\09S1B\0a\0aLiveB ==\0a    /\\ S1B\0a    /\\ S2B\0a\0aSpecB ==\0a\09Init /\\ [][Next]_b /\\ LiveB\0a\0a------\0a\\* L equiv F (Quantification). Warning is raised.\0a\0aLiveC ==\0a\09\\A i \\in {1,2}: WF_b(Next)\0a\0aSpecC ==\0a\09Init /\\ [][Next]_b /\\ LiveC\0a\0a------\0a\\* F superset of L. Warning is not raised.\0a\0aLiveD ==\0a\09WF_b(Next)\0a\0aSpecD ==\0a\09Init /\\ [][Next]_b /\\ \\A i \\in {1,2}: LiveD\0a\0a------\0a\\* L1 /\\ L2 equiv F1 /\\ F2. Warning should be raised raised. Not supported yet.\0a\0aLiveE1 ==\0a\09WF_b(Next)\0a\0aLiveE2 ==\0a\09WF_b(Next)\0a\0aSpecE ==\0a\09Init /\\ [][Next]_b /\\ LiveE1 /\\ LiveE2\0a\0a------\0a\\* L superset of F. Warning is not raised.\0a\0aLiveF1 ==\0a\09WF_b(Next)\0a\0aLiveF2 ==\0a\09WF_b(Next)\0a\0aSpecF ==\0a\09Init /\\ [][Next]_b /\\ LiveF1\0a\0a------\0a\\* F superset of L. Warning should be raised. Not supported yet.\0a\0aLiveG1 ==\0a\09WF_b(Next)\0a\0aSpecG ==\0a\09Init /\\ [][Next]_b /\\ LiveG1 /\\ WF_b(Next)\0a\0a------\0a\0aAbstract == \0a\09INSTANCE Github1198abs\0a\0aSpecH ==\0a    Init /\\ [][Next]_b\0a    \0aRefinement ==\0a    Abstract!Spec\0a=============================================================================\0a'] ['Github1198abs' '---- MODULE Github1198abs ----\0a\0aVARIABLE b\0a\0aSpec ==\0a    b \\in BOOLEAN /\\ [][b\' \\in BOOLEAN]_b\0a=============================================================================\0a']]]
      ['Github1198abs' %accept ~[['Github1198abs' '---- MODULE Github1198abs ----\0a\0aVARIABLE b\0a\0aSpec ==\0a    b \\in BOOLEAN /\\ [][b\' \\in BOOLEAN]_b\0a=============================================================================\0a']]]
      ['Github1244' %accept ~[['Github1244' '---------------------------- MODULE Github1244 ----------------------------\0aVARIABLE x\0avars == <<x>>\0aInit == x = FALSE\0aNext == x\' = ~x\0a\0aMyInit(myInit) == myInit                       \\* state-level\0aSpec ==\0a  /\\ MyInit(Init)\0a  /\\ [][Next]_vars\0a\0aMyAction(myAction) == myAction                 \\* action-level\0aSpecAction ==\0a  /\\ Init\0a  /\\ [][MyAction(Next)]_vars\0a\0aMyNext(myNext) == myNext                       \\* temporal-level\0aSpecNext ==\0a  /\\ Init\0a  /\\ MyNext([][Next]_vars)\0a===========================================================================\0a\0a---------------------------- CONFIG Github1244 ----------------------------\0aSPECIFICATION Spec\0a===========================================================================\0a']]]
      ['Github1302' %accept ~[['Github1302' '---- MODULE Github1302 ----\0ar == [ i \\in {1} |-> "A"]\0a\0a\\* Changing this to {r} prevents the bug:\0a\\* {r} is a SetEnumValue but not FcnLambdaValue.\0aS == [ {1} -> {"A"} ]\0a\0aASSUME S = {r}\0a\0aVARIABLES v\0a\0aTypeOK == v \\in [S -> {1}]\0a\0aInit == v = [s \\in S |-> 1]\0a\0a\\* This is equivalent to UNCHANGED v.\0aNext == v\' = [v EXCEPT ![ r ] = @]\0a\0aSpec == Init /\\ [][Next]_v /\\ WF_v(Next)\0a\0a\\* The actual property doesn\'t matter here as long\0a\\* as it triggers the simulator\'s liveness checker.\0aProp == TRUE ~> TRUE\0a\0a=====\0a----- CONFIG Github1302 ----\0aSPECIFICATION Spec\0a\0aPROPERTY Prop\0a\0a\\* Checking the invariant causes TLC to correctly\0a\\* report stuttering.\0a\\* Hypothesis: Invariant checking causes FcnLambdaValue\0a\\* to be converted before liveness checking.\0a\\*INVARIANT TypeOK\0a========']]]
      ['Github1302b' %accept ~[['Github1302b' '---- MODULE Github1302b ----\0aEXTENDS TLC\0a\0a\\* Non-Reducible domain so the outer function stays a lazy FcnLambdaValue.\0aS == [{1} -> {1, 2}]\0aI == [s \\in S |-> 0]\0a\0ar1 == [i \\in {1} |-> 1]\0ar2 == [i \\in {1} |-> 2]\0a\0afcn == r1 :> 10\0a\0aVARIABLES x, y\0a\0aInit ==\0a    /\\ x = [I EXCEPT ![r1] = fcn] \\* (<<1>> :> (<<1>> :> 10) @@ <<2>> :> 0)\0a    /\\ y = [x EXCEPT ![r2] = 99]  \\* (<<1>> :> (<<1>> :> 10) @@ <<2>> :> 99)\0a\0aNext == UNCHANGED <<x, y>>\0a\0a\\* Without the bugfix: DOMAIN y = {<<1>>}, S = {<<1>>, <<2>>}\0aInv == PrintT(<<DOMAIN y, S>>) /\\ DOMAIN y # S\0a\0a=====\0a----- CONFIG Github1302b ----\0aINIT Init\0aNEXT Next\0aINVARIANT Inv\0a========\0a']]]
      ['Github1302c' %accept ~[['Github1302c' '---- MODULE Github1302c ----\0aEXTENDS TLC, TLCExt\0a\0a\\* Non-Reducible domain so the outer function stays a lazy FcnLambdaValue.\0aS == [{1} -> {1, 2}]\0aI == [s \\in S |-> 0]\0a\0ar1 == [i \\in {1} |-> 1]\0ar2 == [i \\in {1} |-> 2]\0a\0afcn == r1 :> 10\0a\0aVARIABLES x, y\0a\0aInit ==\0a    /\\ x = [I EXCEPT ![r1] = fcn] \\* (<<1>> :> (<<1>> :> 10) @@ <<2>> :> 0)\0a    /\\ y = [x EXCEPT ![r2] = 99]  \\* (<<1>> :> (<<1>> :> 10) @@ <<2>> :> 99)\0a\0aNext == UNCHANGED <<x, y>>\0a\0a\\* Evaluating correct from scratch creates fresh ValueExcept objects that are\0a\\* not shared with x, so no corruption occurs.\0acorrect == [([([s \\in S |-> 0]) EXCEPT ![r1] = fcn]) EXCEPT ![r2] = 99]\0a\0aInv == TLCFP(y) = TLCFP(correct)\0a\0a=====\0a----- CONFIG Github1302c ----\0aINIT Init\0aNEXT Next\0aINVARIANT Inv\0a========\0a']]]
      ['Github1389' %accept ~[['Github1389' '--------------------------- MODULE Github1389 ---------------------------\0a\\* Regression test for https://github.com/tlaplus/tlaplus/issues/1389\0a\\* Recursive operators whose body reaches temporal level were previously\0a\\* rejected by TLC with "TLC cannot handle the temporal formula".  When\0a\\* the recursion terminates during tableau construction via an IF guard\0a\\* that evaluates to a constant, the liveness translator now expands the\0a\\* operator and translates only the chosen IF branch.  Other branch-\0a\\* selection constructs (CASE, conjunction, disjunction, implication) are\0a\\* not handled; users should write recursive operators with IF/THEN/ELSE\0a\\* (the most natural form for recursion in TLA+).\0a\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0a\\* Recursive operator with a temporal body and an IF guard that\0a\\* terminates the recursion during tableau construction.  The original\0a\\* issue used [][TRUE]_x; we use a state-level <>P here because it is a\0a\\* regular temporal formula that TLC\'s tableau actually inspects (the\0a\\* [][TRUE]_x case is recognized as an action property at the\0a\\* SpecProcessor level and never reaches the liveness translator).\0aRECURSIVE ap_0(_)\0aap_0(u) == IF u THEN <>(x = TRUE) ELSE ap_0(~u)\0a\0a\\* Recursion that terminates via a constant numeric guard.  Exercises\0a\\* expansion that walks the parameter from 3 down to 0 without ever\0a\\* encountering a state-dependent guard.\0aRECURSIVE ap_2(_)\0aap_2(n) == IF n = 0 THEN <>(x = TRUE) ELSE ap_2(n - 1)\0a\0a\\* Mirror of ap_2 with the recursive call in THEN and the terminating\0a\\* branch in ELSE.  Exercises the symmetric branch of the OPCODE_ite\0a\\* handling (guard TRUE -> recurse on THEN, guard FALSE -> take ELSE).\0aRECURSIVE ap_3(_)\0aap_3(n) == IF n > 0 THEN ap_3(n - 1) ELSE <>(x = TRUE)\0a\0aSpec == x = TRUE /\\ [][x\' = ~x]_x\0a\0aPropIf      == ap_0(TRUE)\0aPropDepth   == ap_2(3)\0aPropElseRec == ap_3(3)\0a=============================================================================\0a']]]
      ['Github1389Counting' %accept ~[['Github1389Counting' '--------------------------- MODULE Github1389Counting ---------------------------\0a\\* Regression test for https://github.com/tlaplus/tlaplus/issues/1389\0a\\* exercising the "counting safety property" use case -- the primary\0a\\* motivation for permitting RECURSIVE operators at temporal level.\0a\\*\0a\\* Bound the number of times an event may occur.  The canonical example\0a\\* here is "x is TRUE in at most n disjoint intervals", equivalently \0a\\* "x becomes TRUE at most n times":\0a\\*\0a\\*   AtMost(0) == []~x                              \\* never TRUE\0a\\*   AtMost(1) == [](x => [](~x => []~x))           \\* TRUE in at most 1 interval\0a\\*   AtMost(2) == [](x => [](~x => [](x => [](~x => []~x))))\0a\\*   ...\0a\0aEXTENDS Naturals, FiniteSets, TLCExt\0a\0aVARIABLE x\0a\0aRECURSIVE AtMost(_)\0aAtMost(n) == IF n = 0 THEN []~x\0a                      ELSE [](x => [](~x => AtMost(n - 1)))\0a\0aInit == x = FALSE\0aNext == x\' \\in BOOLEAN\0aSpec == Init /\\ [][Next]_x\0a\0aCountAtMostFour == AtMost(4)\0a\0a------------------------------------------------------------------\0a\0aPostCondition ==\0a    LET S == CounterExample.state\0a        A == CounterExample.action\0a    IN\0a    /\\ Cardinality(S) = 10\0a    /\\ Cardinality(A) = 9\0a    /\\ \\A i \\in 1..10 :\0a         \\E s \\in S :\0a            /\\ s[1] = i\0a            /\\ s[2].x = (i % 2 = 0)\0a    /\\ \\A a \\in A : a[2].name = "Next"\0a==================================================================\0a']]]
      ['Github1389Loops' %accept ~[['Github1389Loops' '--------------------------- MODULE Github1389Loops ---------------------------\0a\\* Regression test for https://github.com/tlaplus/tlaplus/issues/1389 (and\0a\\* the related stack-overflow described in #720): when a RECURSIVE operator\0a\\* whose body is at temporal level does not terminate during tableau\0a\\* construction, the liveness translator expands it until the JVM raises a\0a\\* StackOverflowError, which TLC.process translates into\0a\\* EC.SYSTEM_STACK_OVERFLOW -- the same path used by every other\0a\\* non-terminating recursion in the codebase.\0a\0aVARIABLE x\0a\0a\\* The IF guard evaluates to FALSE so the ELSE branch is taken, which\0a\\* always re-invokes `bad` with the same argument; the expanded recursion\0a\\* therefore does not terminate.\0aRECURSIVE bad(_)\0abad(u) == IF u THEN [][TRUE]_x ELSE bad(u)\0a\0aSpec == x = TRUE /\\ [][x\' = ~x]_x\0a\0a\\* Pick the FALSE branch so the recursion never reaches the temporal body.\0aProp == bad(FALSE)\0a=============================================================================\0a']]]
      ['Github1389StateGuard' %accept ~[['Github1389StateGuard' '--------------------------- MODULE Github1389StateGuard ---------------------------\0a\\* Regression test for https://github.com/tlaplus/tlaplus/issues/1389\0a\\* exercising the error-handling path when a RECURSIVE operator at\0a\\* temporal level is applied to a state-level argument.\0a\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aRECURSIVE op(_)\0aop(n) == IF n = 0 THEN <>(x = 0) ELSE op(n - 1)\0a\0aInit == x = 0\0aNext == x\' \\in 0..3\0aSpec == Init /\\ [][Next]_x\0a\0a\\* op\'s parameter is bound to x (state-level); the guard `n = 0`\0a\\* therefore references a state variable and never resolves during\0a\\* tableau construction.\0aProp == op(x)\0a==================================================================\0a']]]
      ['Github1389Violated' %accept ~[['Github1389Violated' '--------------------------- MODULE Github1389Violated ---------------------------\0a\\* Counterexample counterpart of Github1389.tla\0a\\* (see https://github.com/tlaplus/tlaplus/issues/1389).\0a\\*\0a\\* Github1389.tla exercises the positive case: a RECURSIVE operator that\0a\\* produces a temporal formula which holds.  This module exercises the\0a\\* inverse: the expanded property is genuinely violated, and TLC must\0a\\* yield a counterexample rather than emit TLC_LIVE_CANNOT_HANDLE_FORMULA\0a\\* or misclassify the failure.\0a\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0a\\* PropViolated reduces during tableau construction (via expansion and\0a\\* the constant-guard handling of OPCODE_ite) to <>(x = 99).  Since x\0a\\* toggles deterministically over {0, 1}, no reachable behavior ever has\0a\\* x = 99, so the property fails.  <> (rather than []) is used so\0a\\* SpecProcessor cannot route the formula to invariant checking; it must\0a\\* flow through the liveness tableau and surface as\0a\\* TLC_TEMPORAL_PROPERTY_VIOLATED.  WF_x(Next) forces progress so the\0a\\* counterexample is the deterministic two-state cycle 0 -> 1 -> 0\0a\\* rather than a trivial stuttering trace.\0aRECURSIVE Reach(_)\0aReach(n) == IF n = 0 THEN <>(x = 99) ELSE Reach(n - 1)\0a\0aInit == x = 0\0aNext == x\' = 1 - x\0aSpec == Init /\\ [][Next]_x /\\ WF_x(Next)\0a\0aPropViolated == Reach(3)\0a==================================================================\0a']]]
      ['Github1389ViolatedB' %accept ~[['Github1389ViolatedB' '--------------------------- MODULE Github1389ViolatedB ---------------------------\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aRECURSIVE Reach(_)\0aReach(n) == IF n = 0 THEN (x = 99) ELSE <>(Reach(n - 1))\0a\0aInit == x = 0\0aNext == x\' = 1 - x\0aSpec == Init /\\ [][Next]_x /\\ WF_x(Next)\0a\0aPropViolated == Reach(3)\0a==================================================================\0a']]]
      ['Github1389ViolatedC' %accept ~[['Github1389ViolatedC' '--------------------------- MODULE Github1389ViolatedC ---------------------------\0aEXTENDS Naturals, FiniteSets, TLCExt\0a\0aVARIABLE x\0a\0aRECURSIVE Reach(_)\0aReach(n) == IF n = 0 THEN (x = 99) ELSE <>(Reach(n - 1))\0a\0aInit == x = 0\0aNext == x\' \\in 0..99\0aSpec == Init /\\ [][Next]_x /\\ WF_x(Next)\0a\0aPropViolated == Reach(3)\0a\0a\\* Postcondition asserting the shape of the counterexample.  WF_x(Next)\0a\\* forces the lasso to actually move x rather than stutter, so TLC finds a\0a\\* two-state cycle x = 0 -> x = v -> back to x = 0 for some v.  The\0a\\* specific value v depends on state-space exploration order; v must be\0a\\* in 1..98 because\0a\\*   - v # 0:  WF_x(Next) requires a non-stuttering step, so x must change,\0a\\*   - v # 99: the lasso violates <>(x = 99), so no state on it has x = 99.\0aPostCondition ==\0a    LET S == CounterExample.state\0a        A == CounterExample.action\0a        \\* x-value of the non-initial state on the lasso (varies; in 1..98).\0a        s2v == LET t == CHOOSE t \\in S : t[1] = 2 IN t[2].x\0a    IN\0a    /\\ Cardinality(S) = 2\0a    /\\ Cardinality(A) = 2\0a    /\\ <<1, [x |-> 0]>> \\in S\0a    /\\ <<2, [x |-> s2v]>> \\in S\0a    /\\ s2v \\in 1..98\0a    /\\ \\A a \\in A : a[2].name = "Next"\0a    /\\ \\E a \\in A : a[1] = <<1, [x |-> 0]>> /\\ a[3] = <<2, [x |-> s2v]>>\0a    /\\ \\E a \\in A : a[1] = <<2, [x |-> s2v]>> /\\ a[3] = <<1, [x |-> 0]>>\0a==================================================================\0a']]]
      ['Github179a' %accept ~[['Github179a' '---- MODULE Github179a ----\0aEXTENDS TLC, Naturals\0a\0aVARIABLE v\0a\0aMax(s) == { x \\in s : \\A y \\in s : x >= y}\0a\0a(* Attempted to check equality of integer 1 with non-integer: {1} *)\0asillyExpr == \0a   {s \\in SUBSET {1,2,3} : \0a               \\A x \\in s : IF x = Max(s) \0a                            THEN TRUE\0a                            ELSE (x+1) \\in s}\0a----\0a\0aASSUME PrintT(<<"$!@$!@$!@$!@$!", sillyExpr>>)\0a----\0a\0aInit ==\0aFALSE/\\v = 0\0a----\0aNext ==\0aFALSE/\\ v\'= v\0a----\0a=============================================================================\0a']]]
      ['Github179b' %accept ~[['Github179b' '---- MODULE Github179b ----\0aEXTENDS TLC, Naturals\0a\0aVARIABLE v\0a\0aMax(s) == { x \\in s : \\A y \\in s : x >= y}\0a\0asillyExpr == \0a{s \\in SUBSET {1,2,3,4} : \\A x \\in s : IF x = Max(s) THEN TRUE ELSE (x+1) \\in s}\0a----\0a\0aInit ==\0aPrint(sillyExpr, FALSE)/\\v = 0\0a----\0aNext ==\0aFALSE/\\ v\'= v\0a----\0a=============================================================================\0a']]]
      ['Github179c' %accept ~[['Github179c' '---- MODULE Github179c ----\0aEXTENDS TLC, Naturals\0a\0aVARIABLE v\0a\0aMax(s) == { x \\in s : \\A y \\in s : x >= y}\0a\0asillyExpr == \0a{s \\in SUBSET {1,2,3,4} : \0a          \\A x \\in s : IF x = Max(s) \0a                       THEN TRUE \0a                       ELSE (x+1) \\in s}\0a\0aInit == v = 0\0a\0aNext == PrintT(sillyExpr) = FALSE /\\ v\'= v\0a=====\0a']]]
      ['Github317' %accept ~[['Github317' '-------------------------------- MODULE Github317 --------------------------------\0aEXTENDS Naturals\0a\0aVARIABLES a, b\0avars == <<a,b>>\0a\0aInit == /\\ a = 0\0a        /\\ b = 0\0a        \0adisj == /\\ a\' = a + 1\0a        /\\ a\' \\in 1..10\0a\0aNext == /\\ disj\0a        /\\ UNCHANGED b \\* Moving UNCHANGED b to disj makes bug disappear (see WF_vars(...) below).\0a\0aSpec == /\\ Init\0a        /\\ [][Next]_vars\0a        /\\ WF_vars(disj) \\* disj does not define b, yet vars includes b.\0a\0aInv == ENABLED disj\0a\0aProp == <>FALSE \\* Force TLC to run liveness checking.\0a\0a=============================================================================\0a---- CONFIG Github317 ----\0aSPECIFICATION Spec\0aPROPERTY Prop\0a====']]]
      ['Github358' %accept ~[['Github358' '------------------------------ MODULE Github358 ----------------------------- \0a(*--algorithm Github358\0abegin\0a    A::\0a      skip;\0aend algorithm; *)\0a=============================================================================\0a']]]
      ['Github361' %accept ~[['Github361' '---- MODULE Github361 ----\0aEXTENDS TLC, Naturals\0a\0aNodes == {1, 2, 3, 4, 5}\0anull == 6 \\* not in Nodes\0a\0aVertices == [nodes : SUBSET Nodes, succ : Nodes \\cup {null}, dead : BOOLEAN]\0a\0aPartitions == {P \\in SUBSET Vertices :\0a                 /\\ \\A v1, v2 \\in P : \0a                       (v1 # v2) => ((v1.nodes \\cap v2.nodes) = {})\0a                 /\\ \\A v \\in P : /\\ v.nodes # {}\0a                                 /\\ \\E w \\in P : \\/ v.succ = null\0a                                                 \\/ v.succ \\in w.nodes}     \0a\0aVARIABLES partition\0a\0aTypeOK == partition \\in Partitions\0a\0aInit == partition = {}\0a\0aNext == UNCHANGED partition\0a\0a=============================================================================\0a']]]
      ['Github362' %accept ~[['Github362' '---- CONFIG Github362 ----\0aINIT Init\0aNEXT Next\0aPROPERTY Correct\0aCONSTANT overloadedConst = 4711\0a====\0a\0a---- MODULE Github362 ----\0a\0aEXTENDS TLC\0a\0aCONSTANT overloadedConst\0a\0aVARIABLES overloadedName\0a\0a\\* Github362B.tla contains the definition "overloadedName == x".  It is\0a\\* unrelated to the variable "overloadedName" defined above.\0aAbstract == INSTANCE Github362B WITH\0a    x <- "x",\0a    C <- 42\0a\0aInit ==\0a    /\\ overloadedName = "fizzbuzz"\0a    /\\ overloadedConst = 4711\0a    /\\ Print(<<"Evaluated initial state in A; overloadedName is: ", overloadedName>>, TRUE)        \\* fizzbuzz\0a    /\\ Print(<<"From A\'s perspective, B\'s overloadedName is: ", Abstract!overloadedName>>, TRUE)   \\* x\0a    /\\ Print(<<"Evaluated initial state in A; overloadedConst is: ", overloadedConst>>, TRUE)      \\* 4711\0a    /\\ Print(<<"From A\'s perspective, B\'s overloadedConst is: ", Abstract!overloadedConst>>, TRUE) \\* 42\0a\0aNext == UNCHANGED overloadedName\0a\0aCorrect == Abstract!Spec\0a\0a==================\0a'] ['Github362B' '---- MODULE Github362B ----\0a\0a\\* Auxiliary spec instantiated by Github362.tla.\0a\0aEXTENDS TLC\0a\0aCONSTANT C\0a\0aVARIABLES x\0a\0a\\* This name also exists in Github362.tla with a different definition (it is a\0a\\* variable rather than a user-defined operator).  The definition in Github362\0a\\* should not conflict with this one.\0aoverloadedName == x\0a\0aoverloadedConst == C\0a\0aInit ==\0a    /\\ Print(<<"Evaluating initial state in B; overloadedName is ", overloadedName>>, TRUE) \\* x\0a    /\\ overloadedName = "x" \\* overloadedName -> variable x -> value "x"\0a    /\\ x = "x"\0a    /\\ Print(<<"Evaluating initial state in B; overloadedConst is ", overloadedConst>>, TRUE) \\* 42\0a    /\\ overloadedConst = 42 \\* overloadedConst -> const C -> 42\0a    /\\ C = 42\0a\0aNext == UNCHANGED x\0aSpec == Init /\\ [][Next]_x\0a\0a==================\0a']]]
      ['Github362B' %accept ~[['Github362B' '---- MODULE Github362B ----\0a\0a\\* Auxiliary spec instantiated by Github362.tla.\0a\0aEXTENDS TLC\0a\0aCONSTANT C\0a\0aVARIABLES x\0a\0a\\* This name also exists in Github362.tla with a different definition (it is a\0a\\* variable rather than a user-defined operator).  The definition in Github362\0a\\* should not conflict with this one.\0aoverloadedName == x\0a\0aoverloadedConst == C\0a\0aInit ==\0a    /\\ Print(<<"Evaluating initial state in B; overloadedName is ", overloadedName>>, TRUE) \\* x\0a    /\\ overloadedName = "x" \\* overloadedName -> variable x -> value "x"\0a    /\\ x = "x"\0a    /\\ Print(<<"Evaluating initial state in B; overloadedConst is ", overloadedConst>>, TRUE) \\* 42\0a    /\\ overloadedConst = 42 \\* overloadedConst -> const C -> 42\0a    /\\ C = 42\0a\0aNext == UNCHANGED x\0aSpec == Init /\\ [][Next]_x\0a\0a==================\0a']]]
      ['Github391' %accept ~[['Github391' '---- MODULE Github391 ----\0aEXTENDS Integers\0a\0a\\* IntValue\0ax == {1157660672, -989822976}\0ay == {-989822976, 1157660672}\0a\0aASSUME x = y\0a\0a=============================================================================\0a']]]
      ['Github407' %accept ~[['Github407' '---- MODULE Github407 ----\0aData == {"d1", "d2"}\0a\0aVARIABLES state\0a\0aInit == state = {}\0a\0aNext == \\E e \\in Data: state\' = state \\union {e}\0a=============================================================================\0a']]]
      ['Github432' %accept ~[['Github432' '---- MODULE Github432 ----\0a\0aEXTENDS TLC\0a\0aCONSTANT Humans, Others\0a\0asymmetry == Permutations(Humans) \\union Permutations(Others)\0a\0aVARIABLES set\0a\0aTypeOK ==\0a    /\\ set \\subseteq Humans\0a\0aInit ==\0a    /\\ set = {}\0a\0aNext ==\0a    \\E h \\in Humans:\0a        set\' = set \\union {h}\0a\0a==================================\0a\0a']]]
      ['Github461' %accept ~[['Github461' '----------------------------- MODULE Github461 -----------------------------\0aEXTENDS Integers, TLC\0a\0aVARIABLES x\0a\0aInit == x = 0\0a\0aNext == \0a    /\\ Assert(x < 4, "Failure of assertion at line 8, column 4.")\0a    /\\ x\' = x + 1\0a\0a====\0a']]]
      ['Github525' %accept ~[['Github525' '------ MODULE Github525 ------\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aInit ==\0a    /\\  x = 1\0a    \0aNext ==\0a    /\\  x < 5\0a    /\\  x\' = x + 1\0a\0aSpec ==\0a    /\\  Init\0a    /\\ [][Next]_x\0a    \\* Weak fairness starts with a box\0a    /\\ []<>(ENABLED <<Next>>_x => []<><<Next>>_x)\0a    /\\ WF_x(Next) \0a    /\\  ~<>~(x < 3) \\* This one is not caught.\0a    \\*/\\ []FALSE\0a    /\\ [](x < 3)\0a    \0aInvariant ==\0a    x < 4\0a\0aProp == [][x\' \\in {1, 2}]_x\0a\0aTHEOREM Spec => []Invariant\0a\0a====\0a']]]
      ['Github602' %accept ~[['Github602' '------ MODULE Github602 ------\0aEXTENDS Integers, TLC, TLCExt\0a\0aVARIABLE x\0a\0aInit == x = 0\0a\0aA == /\\ x \\in Nat\0a     /\\ x\' = -x\0a\0aB == x\' = x + 1\0a\0aNext == A \\/ B\0a\0aConstraint ==  x \\in Nat\0a\0aInv == x >= 0\0a\0aActionConstraint == x\' \\in Nat\0a\0aPostCondition ==\0a\09/\\ TLCSet(42, TLCGet("generated"))\0a\09/\\ ToTrace(CounterExample) = << [x |-> 0],[x |-> 1],[x |-> -1] >> \0a\0aInit2 == x = 1\0a\0aPostCondition2 ==\0a\09/\\ TLCSet(42, TLCGet("generated"))\0a\09/\\ ToTrace(CounterExample) = << [x |-> 1],[x |-> -1] >> \0a====\0a\0a---- CONFIG Github602 ----\0aINIT Init\0aNEXT Next\0aCONSTRAINT Constraint\0a====\0a']]]
      ['Github604' %accept ~[['Github604' '------ MODULE Github604 ------\0aEXTENDS Naturals\0a\0aVARIABLE \0a    \\* @type: Int;  \\* Apalache type annotation\0a    x\0a\0aInit == x = 0\0a\0aNext == x\' \\in 0..3\0a\0aSpec == Init /\\ [][Next]_x \\* /\\ WF_x(Next)\0a\0a-----------------------------------------------\0a\0aUSE DEF Init, Next, Spec\0a\0aProp01 == <>(TRUE)\0aTHEOREM Spec => Prop01 BY DEF Prop01 \0a\0aProp02 == [](TRUE)             \\* TLC checks Prop02 as part of safety checking.\0aTHEOREM Spec => Prop02 BY DEF Prop02\0a\0aProp03 == <>[](TRUE)\0aTHEOREM Spec => Prop03 OMITTED \\* Not proved by TLAPS 1.4.5 (feels inconsistent WRT 01 & 02)\0a\0a-----------------------------------------------\0a\0a\\* Prop04 & 05 take a different code path of TLC compared to\0a\\* 06 & 07 despite being logically equivalent.\0a\0aProp04 == FALSE ~> TRUE\0aTHEOREM Spec => Prop04 OMITTED \\* Not proved by TLAPS 1.4.5\0a\0aProp05 == FALSE ~> FALSE\0aTHEOREM Spec => Prop05 OMITTED \\* Not proved by TLAPS 1.4.5\0a    \0aProp06 == TRUE ~> TRUE\0aTHEOREM Spec => Prop06 OMITTED \\* Not proved by TLAPS 1.4.5\0a\0aProp07 == [](FALSE => <>TRUE)\0aTHEOREM Spec => Prop07 OMITTED \\* Not proved by TLAPS 1.4.5\0a\0aProp08 == [](FALSE => <>FALSE)\0aTHEOREM Spec => Prop08 OMITTED \\* Not proved by TLAPS 1.4.5\0a\0a\\* state-level\0a\0aProp09 == [](FALSE => <>(x=x))\0aTHEOREM Spec => Prop09 OMITTED \\* Not proved by TLAPS 1.4.5\0a\0aProp10 == [](FALSE => <>(x#x))\0aTHEOREM Spec => Prop10 OMITTED \\* Not proved by TLAPS 1.4.5\0a\0a-----------------------------------------------\0a\0aProp11 == <>(x=x)\0aTHEOREM Spec => Prop11 OMITTED \\* Not proved by TLAPS 1.4.5\0a   \0aProp12 == [](x=x)\0aTHEOREM Spec => Prop12 OMITTED \\* Not proved by TLAPS 1.4.5\0a    \0aProp13 == <>[](x=x)\0aTHEOREM Spec => Prop13 OMITTED \\* Not proved by TLAPS 1.4.5\0a\0a-----------------------------------------------\0a\0aProp14 == TRUE ~> []TRUE /\\ (FALSE ~> []TRUE)\0a\0aProp15 == TRUE ~> <>TRUE /\\ (FALSE ~> <>TRUE)\0a\0aProp16 == TRUE ~> <>[]TRUE /\\ (FALSE ~> <>[]TRUE)\0a\0a-----------------------------------------------\0a\0aProp17 == TRUE ~> [](x=x) /\\ (FALSE ~> [](x=x))\0a\0aProp18 == TRUE ~> <>(x=x) /\\ (FALSE ~> <>(x=x))\0a\0aProp19 == TRUE ~> <>[](x=x) /\\ (FALSE ~> <>[](x=x))\0a\0aProp20 == (FALSE /\\ (x=x)) ~> (<>[](x#x))\0a\0a====\0a\0a---- CONFIG Github604 ----\0aSPECIFICATION Spec\0aPROPERTY\0a    Prop01  \\* Fixed as part of Github #604\0a    Prop02\0a    Prop03\0a    Prop04  \\* Fixed as part of Github #604\0a    Prop05  \\* Fixed as part of Github #604 \0a    Prop06\0a    Prop07  \\* Fixed as part of Github #604\0a    Prop08  \\* Fixed as part of Github #604\0a    Prop09  \\* Fixed as part of Github #604\0a    Prop10  \\* Fixed as part of Github #604\0a    Prop11\0a    Prop12\0a    Prop13\0a    Prop14 \\* Fixed as part of Github #604\0a    Prop15 \\* Fixed as part of Github #604\0a    Prop16 \\* Fixed as part of Github #604\0a    Prop17 \\* Fixed as part of Github #604\0a    Prop18 \\* Fixed as part of Github #604\0a    Prop19 \\* Fixed as part of Github #604\0a    Prop20\0a====\0a']]]
      ['Github607' %accept ~[['Github607' '---- MODULE Github607 ----\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aInit ==\0a    x = 0\0a\0aNext ==\0a    /\\ UNCHANGED x\0a\0aSpec ==\0a    Init /\\ [][Next]_x\0a\0aProp ==\0a    \\* The consequent have to be state-level. A constant-level silly\0a    \\* expression would be caught during tableau construction.\0a    \\* In pratice, this would probably something like:\0a    \\*    someSeq == <<...>>\0a    \\*    x.idx \\in DOMAIN someSeq ~> someSeq[x.idx]\0a    x \\notin Nat ~> x = "abc"\0a\0a====\0a---- CONFIG Github607 ----\0aSPECIFICATION\0a    Spec\0aPROPERTIES\0a    Prop\0a====']]]
      ['Github648' %accept ~[['Github648' '\09--------------------- MODULE Github648 -----------------------------\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aBoundedSeqTLCEval(S, n) ==\0a  \\* The TLCEval here must not cache the value, because it depends on the\0a  \\* context, ie. S and n.\0a  UNION {TLCEval([1..m -> S]) : m \\in 0..n}\0a\0aASSUME Cardinality(BoundedSeqTLCEval(BoundedSeqTLCEval({1,2}, 2), 2)) = 57\0a\0a-----------------------------------------------------------------------------\0aBoundedSeq(S, n) ==\0a  UNION {[1..m -> S] : m \\in 0..n}\0a\0a-----------------------------------------------------------------------------\0aDirectedGraphs(nodes) ==\0a    [edge : SUBSET (nodes \\X nodes)]\0a\0aTestGraph ==\0a    \\* The definition of TestGraph is evaluated multiple times.  If the def.\0a    \\* involves TLC!RandomElement or Randomization!* the invariant Inv below\0a    \\* will be violated *without* the TLCEval.\0a    TLCEval(\0a    \09LET g == RandomElement(DirectedGraphs(1..3)) \0a    \09IN [ edge |-> g.edge \\cup {<<1,1>>} ]\0a    )\0a\0a-----------------------------------------------------------------------------\0aCONSTANT Graph\0a\0aVARIABLE v, w\0avars == <<v, w>>\0a\0aInit ==\0a    /\\ v \\in Graph.edge\0a    /\\ w \\in Graph.edge\0a\0aNext ==\0a    /\\ v\' \\in Graph.edge\0a    /\\ w\' \\in Graph.edge\0a\0aInv ==\0a    /\\ v \\in Graph.edge\0a    /\\ v \\in TestGraph.edge\0a    /\\ w \\in Graph.edge\0a    /\\ w \\in TestGraph.edge\0a    /\\ TLCEval(Cardinality(\0a    \09TLCEval(BoundedSeq(\0a    \09\09TLCEval(BoundedSeq({1,2,3}, 3)), 3)))) = 65641\0a\0a=============================================================================\0a']]]
      ['Github652' %accept ~[['Github652' '------------------ MODULE Github652 -------------------\0aEXTENDS Naturals, TLCExt\0a\0a(* Causes: "Attempted to check equality of integer 1 with non-integer" *)\0a\0a\\* FcnRcdValue#equals\0aASSUME [ i \\in {1,3} |-> FALSE] # <<1,2>>\0aASSUME <<1,2>> # [ i \\in {1,3} |-> FALSE]\0aASSUME [ i \\in 1..2 |-> i ] # [ i \\in {1,3} |-> FALSE]\0aASSUME [ i \\in {1,2} |-> i ] # [ i \\in {1,3} |-> FALSE]\0a\0a\\* FcnRcdValue#compareTo\0aASSUME {[ i \\in 1..2 |-> FALSE], [ i \\in {1,3}|-> i]} # {}\0aASSUME {[ i \\in {1,3} |-> FALSE], [ i \\in 1..2|-> i]} # {}\0aASSUME {[ i \\in {1,3} |-> FALSE], [ i \\in {1,2} |-> i]} # {}\0a\0a\\* RecordValue#equals\0aASSUME [a |-> 1, b |-> 1] # [a |-> TRUE, c |-> 1]\0a\0a\\* RecordValue#compareTo\0aASSUME {[a|->1, b|->2, d|->3], [a|->1, b|->FALSE, c|->3]} # {} \0aASSUME {[a|->1, b|->FALSE, c|->3], [a|->1, b|->2, d|->3]} # {} \0a\0aASSUME \\A f \\in [ {1,2} -> {1,2} ] : \0a            \\A g \\in [ {1,3} -> BOOLEAN ] :\0a                f # g\0a\0a--------------------------------------------------------\0a\0a\\* Behaves according to "Specifying Systems".\0a\0a\\* FcnRcdValue.java\0aASSUME [ i \\in 1..2 |-> i ] # [ i \\in 1..3 |-> FALSE]\0aASSUME [ i \\in {1,2} |-> i ] # [ i \\in 1..3 |-> FALSE]\0aASSUME [ i \\in 1..2 |-> i ] # [ i \\in {1,2,3} |-> FALSE]\0aASSUME [ i \\in {1,2} |-> i ] # [ i \\in {1,2,3} |-> FALSE]\0aASSUME [ i \\in 1..2 |-> i ] # [ i \\in 2..3 |-> FALSE]\0aASSUME [ i \\in {1,2} |-> i ] # [ i \\in {2,3} |-> FALSE] \0a\0aASSUME [ i \\in (1..2) |-> i ] # [ i \\in 2..3 |-> FALSE]\0a\0a\\* RecordValue\0aASSUME [a |-> 1, b |-> 1] # [a |-> TRUE, b |-> 2, c |-> 1]\0a\0a\\* TupleValue\0aASSUME <<1,TRUE,3>> # <<1,2>>\0aASSUME <<1,2>> # <<1,TRUE,3>>\0a\0a========================================================\0a\0a\\* SetOfTupleValues.java\0aASSUME {1,2} \\X {TRUE} # {}\0aASSUME {1,2} \\X {TRUE, TRUE} # {}\0aASSUME {TRUE} \\X {1,2} # {}\0aASSUME {TRUE,TRUE} \\X {1,2} # {}\0a\0a\\* fail\0aASSUME {1,TRUE} \\X {1,2} # {}\0aASSUME {1,2} \\X {1,TRUE} # {}\0a---------------------------------------------------------\0a\0a(* Below, all must fail. *)\0a\0a\\* SetOfRcdsValue\0aASSUME AssertError("Attempted to compare boolean TRUE with non-boolean:\\n1", [ a : {1, TRUE}] # {})\0a\0a\0a---- CONFIG Github652 ----\0a====']]]
