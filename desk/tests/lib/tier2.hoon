      ['Github726' %accept ~[['Github726' '-------------------------------- MODULE Github726 --------------------------------\0aEXTENDS TLC\0a\0amsgs == [ a |-> [ data |-> 15 ] ]\0a\0aGetMsg(dst) ==\0a    [ dst |-> dst ] @@ msgs[dst]\0a\0aPair ==\0a    LET m == GetMsg("a")\0a    IN <<m, m>>\0a\0aASSUME Pair[1] = Pair[2]\0a\0aPrintPrintGetMsg ==\0a    LET m == GetMsg("a")  \\* expect: [data |-> 15, dst |-> "a"]\0a    IN <<PrintT(m) , PrintT(m)>>\0a\0aASSUME PrintPrintGetMsg = <<TRUE, TRUE>>\0a\0a=============================================================================']]]
