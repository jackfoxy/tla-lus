  %+  expect-eq
    !>  %accept
  !>
  %+  sany-verdict:semantic  'Empty'
  %-  malt
  ^-  (list [@t @t])
  :~
      ['Empty' '------------------------------- MODULE Empty -------------------------------\0a============================================================================\0a']
  ==
