      ['Github696b' %accept ~[['Github696b' '------------------ MODULE Github696b -------------------\0aEXTENDS Integers, TLCExt\0a\0aVARIABLE v\0a\0aInit == /\\ v = {TLCModelValue("A_a"), TLCModelValue("B_a")}\0a \0aNext == UNCHANGED v\0a\0aInv == TLCModelValue("B_a") \\in v\0a\0a=======================================================\0a']]]
      ['Github710b' %accept ~[['Github710b' '---- MODULE Github710b ----\0aEXTENDS Naturals, TLC, TLCExt\0a\0aVARIABLE x\0avars == <<x>>\0a\0aInit == x = 1\0a\0aNext == x\' = x + 1\0a\0aSpec == \0a    /\\ Init\0a    /\\ [][Next]_vars\0a    \\* /\\ WF_x(Next)\0a\0aStateConstraint ==\0a    x < 5\0a\0aAtMostOnce == [](x > 1 => [](x > 2)) \\* violated by x = 2\0a\0aPostCondition ==\0a\09/\\ TLCSet(42, TLCGet("generated"))\0a\09/\\ ToTrace(CounterExample) = <<[x |-> 1], [x |-> 2]>>\0a\09/\\ CounterExample =\0a\09\09\09[ action |->\0a\09\09      { << <<1, [x |-> 1]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 9,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 9,\0a\09\09                   endColumn |-> 18,\0a\09\09                   module |-> "Github710b" ] ],\0a\09\09           <<2, [x |-> 2]>> >> },\0a\09\09  state |-> {<<1, [x |-> 1]>>, <<2, [x |-> 2]>>} ]\0a\09\09\09\0aTautology == (vars = vars) ~> (vars = vars)\0a====\0a']]]
      ['Github710d' %accept ~[['Github710d' '---- MODULE Github710d ----\0aEXTENDS Naturals\0aVARIABLE x\0a\0aInit == x = 0\0a\0aStep == x < 3 /\\ x\' = x + 1 \\* x <= 3 - see git commit msg.\0a\0aSpec == Init /\\ [][Step]_x\0a\0aFairSpec == Spec /\\ WF_x(Step)\0a\0aNeverThree == [](x = 1 => [](x # 3))\0a\0aneg_NeverThree == ~(NeverThree)\0a\0aEventuallyThree == <>(x = 3)\0a\0aTautology == (x = x) ~> (x = x)\0a====\0a']]]
      ['Github710e' %accept ~[['Github710e' '---- MODULE Github710e ----\0aEXTENDS Naturals\0aVARIABLE x\0a\0aInit == x = 0\0a\0aInc == x < 2 /\\ x\' = x + 1 \\* x <= 2 - see git commit msg.\0aNext == Inc\0a\0aSpec == Init /\\ [][Next]_x\0a\0aFairSpec == Spec /\\ WF_x(Next)\0a\0aVisitsTwoThenStaysSmall == <>(x = 1 /\\ <>(x = 2)) => <>[](x < 2)\0a\0aneg_VisitsTwoThenStaysSmall == ~(VisitsTwoThenStaysSmall)\0a\0aEventuallyZero == <>(x = 0)\0aEventuallyTwo == <>(x = 2)\0a\0aTautology == (x = x) ~> (x = x)\0a====\0a']]]
      ['Github715' %accept ~[['Github715' '---- MODULE Github715 ----\0aVARIABLE x\0a\0aInit == x = TRUE\0a\0aNext == x\' = ~x\0a\0aSpec == Init /\\ [][Next]_x\0a\0aProp == x\0a\0aProp2 == x = TRUE\0a\0aProp3 == TRUE\0a\0aSpecVar == x\0a====\0a']]]
      ['Github725d' %accept ~[['Github725d' '---- MODULE Github725d ----\0aVARIABLE a\0a\0aInit == a = 0\0a\0aNext == UNCHANGED a\0a\0a\\* LET/IN wrapping a primed variable as the LHS of = inside ENABLED\0aInv == ENABLED ((LET y == a\' IN y) = 0)\0a====\0a']]]
      ['Github726' %accept ~[['Github726' '-------------------------------- MODULE Github726 --------------------------------\0aEXTENDS TLC\0a\0amsgs == [ a |-> [ data |-> 15 ] ]\0a\0aGetMsg(dst) ==\0a    [ dst |-> dst ] @@ msgs[dst]\0a\0aPair ==\0a    LET m == GetMsg("a")\0a    IN <<m, m>>\0a\0aASSUME Pair[1] = Pair[2]\0a\0aPrintPrintGetMsg ==\0a    LET m == GetMsg("a")  \\* expect: [data |-> 15, dst |-> "a"]\0a    IN <<PrintT(m) , PrintT(m)>>\0a\0aASSUME PrintPrintGetMsg = <<TRUE, TRUE>>\0a\0a=============================================================================']]]
      ['Github742' %accept ~[['Github742' '---------------------------- MODULE Github742 ----------------------------\0aEXTENDS Integers\0a\0aVARIABLES x\0a\0aInit ==\0a\09x = FALSE\0a\09\0aNext ==\0a\09x\' \\in BOOLEAN\0a\09\0aSpec ==\0a\09/\\ Init\0a\09/\\ [][Next]_x \0a\09/\\ \\A i \\in 1..6: \0a\09\09\09\\A j \\in 1..6: \0a\09\09\09\09SF_x(Next) \\*  6*6 = 36, which exceeds 32 bits. \0a\09\0aProp ==\0a\09<>[](x \\in BOOLEAN)\0a\0a==========================================================================']]]
      ['Github743' %accept ~[['Github743' '---------------------------- MODULE Github743 ----------------------------\0aEXTENDS Integers\0a\0aVARIABLES x, y\0a\0aInit ==\0a\09/\\ x = "foo"\0a    /\\ y = 0\0a\09\0aNext ==\0a    \\/ /\\ x\' = "foo"\0a       /\\ y\' = y + 1\0a    \\/ /\\ x\' = TRUE\0a       /\\ y\' = y + 2\0a\09\0aSpec ==\0a\09/\\ Init\0a\09/\\ [][Next]_<<x,y>>\0a\09\0aInv ==\0a\09/\\ y < 5\0a\0a==========================================================================']]]
      ['Github746' %accept ~[['Github746' '---------------------------- MODULE Github746 ----------------------------\0a\0aVARIABLE i\0a\0aInit == i = 1\0a\0aNext == UNCHANGED i\0a\0aSpec == Init /\\ [][Next]_i\0a\0aInv == i = 2\0a\0aAlias == [\0ai |-> i, foo |-> "bar", j |-> i = i\'\0a]\0a\0a==========================================================================']]]
      ['Github757' %accept ~[['Github757' '---------------------------- MODULE Github757 ----------------------------\0aEXTENDS Naturals, TLC, TLCExt\0a\0aVARIABLE x\0avars == <<x>>\0a\0aInit == x = 1\0a\0aNext == x\' = x + 1\0a\0aSpec == \0a    /\\ Init\0a    /\\ [][Next]_vars\0a\0aInv == x < 2\0a\0aPostCondition ==\0a  /\\ ToTrace(CounterExample) = <<[x |-> 1], [x |-> 2]>>\0a  /\\ CounterExample =\0a\09\09\09[ action |->\0a\09\09      { << <<1, [x |-> 1]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 9,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 9,\0a\09\09                   endColumn |-> 18,\0a\09\09                   module |-> "Github757" ] ],\0a\09\09           <<2, [x |-> 2]>> >> },\0a\09\09  state |-> {<<1, [x |-> 1]>>, <<2, [x |-> 2]>>} ]\0a\0a==========================================================================\0a---------------------------- CONFIG Github757 ----------------------------\0aSPECIFICATION Spec\0aINVARIANT Inv\0aPOSTCONDITION PostCondition\0a==========================================================================\0a']]]
      ['Github766' %accept ~[['Github766' '---------------------------- MODULE Github766 ----------------------------\0aEXTENDS Naturals, TLC, TLCExt\0a\0aVARIABLE x\0avars == <<x>>\0a\0aInit == x = 1\0a\0aNext == TRUE\0a\0aSpec ==\0a    /\\ Init\0a    /\\ [][Next]_vars\0a\0aInv == x < 1\0a\0a==========================================================================\0a---------------------------- CONFIG Github766 ----------------------------\0aSPECIFICATION Spec\0aINVARIANT Inv\0a==========================================================================\0a']]]
      ['Github798I' %accept ~[['Github798I' '---------------------------- MODULE Github798I ----------------------------\0aS == {"n1", "n2"}\0a\0aDirect(xx, yy) ==\0a    /\\ xx \\in [S -> {"a"}]\0a    /\\ yy \\in [S -> S]\0a    /\\ \\A s \\in S : \0a        xx[s] = "a" => yy[s] = s\0a\0aIndirect(xx, yy) == \0a    /\\ Direct(xx, yy)\0a\0aInIndirect(xx, yy) ==\0a\09LET zz == xx IN\0a    Indirect(zz, yy)\0a\0aVARIABLE x, y\0a\0avars == <<x, y>>\0a\0aInit ==\0a    InIndirect(x, y)\0a   \0aSpec == \0a    Init /\\ [][InIndirect(x\', y\')]_vars\0a\0a==========================================================================\0a---------------------------- CONFIG Github798I -----------------------------\0aSPECIFICATION\0a    Spec\0a===========================================================================\0a']]]
      ['Github798N' %accept ~[['Github798N' '---------------------------- MODULE Github798N ---------------------------\0aS == {"n1", "n2"}\0a\0aDirect(xx, yy) ==\0a    /\\ xx \\in [S -> {"a"}]\0a    /\\ yy \\in [S -> S]\0a    /\\ \\A s \\in S : \0a        xx[s] = "a" => yy[s] = s\0a\0aIndirect(xx, yy) == \0a    /\\ Direct(xx, yy)\0a\0aInIndirect(xx, yy) ==\0a\09LET zz == xx IN\0a    Indirect(zz, yy)\0a\0aVARIABLE x, y\0a\0avars == <<x, y>>\0a\0aInit == \0a\09/\\ x = {}\0a\09/\\ y = {}\0a\0aNext ==\0a    InIndirect(x\', y\')\0a   \0aSpec == \0a    Init /\\ [][Next]_vars\0a\0a==========================================================================\0a---------------------------- CONFIG Github798N ----------------------------\0aSPECIFICATION\0a    Spec\0a===========================================================================\0a']]]
      ['Github819' %accept ~[['Github819' '---------------------------- MODULE Github819 ---------------------------\0aEXTENDS Naturals\0a  \0aVARIABLES i\0a\0aInit == i = 0\0aNext == i < 5 /\\ i\' = i + 1\0a\0aSpec == Init /\\ [][Next]_i\0a\0a--------------------------\0a(*** Liveness ***)\0a\0aTestFailing ==\0a  \\A x \\in {} :\0a    []<>TRUE\0a\0aTestSucceeding ==\0a  \\A x \\in {42} :\0a    []<>TRUE\0a\0aLive ==\0a  \\* This condition causes liveness checking to fail with the error:\0a  \\*  "Temporal formulas containing actions must be of forms <>[]A or []<>A."\0a  \\* \0a  \\* If you comment this condition out, you\'ll see that liveness checking\0a  \\* succeeds.\0a  /\\ TestFailing\0a\0a  \\*/\\ TestSucceeding\0a==========================================================================\0a---------------------------- CONFIG Github819 ----------------------------\0aSPECIFICATION Spec\0a\0aPROPERTY Live\0a===========================================================================\0a']]]
      ['Github849' %accept ~[['Github849' '---------------------------- MODULE Github849 ---------------------------\0a\0aCONSTANTS\0a    Nodes\0a\0aVARIABLES\0a    n,\0a    node_set\0a\0aTypeOK ==\0a    /\\ n = 1\0a\0aInit ==\0a    /\\ n = 1\0a    /\\ node_set = {}\0a\0aNext ==\0a    /\\ n\' = 2\0a    /\\ node_set\' = {v \\in SUBSET Nodes : FALSE}\0a\0a==========================================================================\0a---------------------------- CONFIG Github849 ----------------------------\0a\0aINIT Init\0aNEXT Next\0a\0aCONSTANT Nodes = {A1}\0a\0aCHECK_DEADLOCK FALSE\0aINVARIANT TypeOK\0a\0a===========================================================================\0a']]]
      ['Github971' %accept ~[['Github971' '---- MODULE Github971 ----\0aEXTENDS Integers\0a\0aVARIABLE x\0a\0aInitA ==\0a    x = 0\0a\0aInitB ==\0a    x = -1\0a\0aNextAB ==\0a    x\' \\in {0,1} \0a\0aNextC ==\0a    NextAB \\/ x\' = 2\0a\0aAtMostOnce ==\0a    []((x=1) => []((x=0) => [](x=0)))\0a\0aAtMostOnceC ==\0a    []((x=1) => []((x=0) => [](x=2)))\0a\0aSpec ==\0a    InitA /\\ [][NextAB]_x /\\ WF_x(NextAB)\0a\0aLeadsTo ==\0a    \\* lasso shaped counterexample/liveness property\0a    x = 0 ~> [](x = 1 => [](x = 1)) \0a\0aTautology == (x = x) ~> (x = x)\0a==========================\0a\0afp(x =-1) =  3234510876920644087\0afp(x = 0) = -3406341414084290173\0afp(x = 1) =  -686636423115914061\0afp(x = 2) = -7115858903467826205']]]
      ['Github971e' %accept ~[['Github971e' '---- MODULE Github971e ----\0aEXTENDS Integers\0a\0aVARIABLE x, y\0avars == <<x, y>>\0a\0aInit ==\0a    x = 0 /\\ y = "a"\0a\0aNext ==\0a    x\' \\in {0,1} /\\ y\' \\in {"a", "b"}\0a\0aSpec ==\0a    Init /\\ [][Next]_x /\\ WF_x(Next)\0a\0aLeadsTo ==\0a    \\* lasso shaped counterexample/liveness property\0a    x = 0 ~> [](x = 1 => [](y = "a")) \0a\0aTautology == (vars = vars) ~> (vars = vars)\0a==========================\0a']]]
      ['IllegalOperatorTest' %reject ~[['IllegalOperatorTest' '------------------------- MODULE IllegalOperatorTest ------------------------\0aD(Op(_)) == Op(42)\0aFoo == D(D)\0a=============================================================================\0a']]]
      ['IncompatibleTypesLive' %accept ~[['IncompatibleTypesLive' '---- CONFIG IncompatibleTypesLive ----\0aSPECIFICATION \0a    Spec\0aPROPERTIES\0a    Prop\0a====\0a\0a---- MODULE IncompatibleTypesLive ----\0aEXTENDS Naturals\0a\0aVARIABLES x\0a\0aInit == x = 0\0a\0aNext == \0a    \\/ x\' \\in 1..100 \\* Need to create enough successors for SetOfState to exhibit collisions.\0a    \\/ x\' = FALSE \0a    \\/ x\' = "abc"\0a\0aSpec == Init /\\ [][Next]_x\0a\0aProp == <>[]TRUE\0a=====']]]
      ['IncompleteNext' %accept ~[['IncompleteNext' '--------------------------- MODULE IncompleteNext ---------------------------\0aEXTENDS Integers, TLC\0a\0aVARIABLES x, y\0a\0aSpec == (x=0) /\\ (y=0) /\\ [][x\'=x+1]_<<x,y>>\0a=============================================================================\0a']]]
      ['IncompleteNextMultipleActions' %accept ~[['IncompleteNextMultipleActions' '--------------------------- MODULE IncompleteNextMultipleActions ---------------------------\0aEXTENDS Integers, TLC\0a\0aVARIABLES x, y, z\0a\0aA1 == x\'= x + 1\0a\0aA2 == x\'= 1 /\\ y\' = 1 /\\ z\' = 1\0a\0aSpec == (x=0) /\\ (y=0) /\\ (z=0) /\\ [][A1 \\/ A2]_<<x,y,z>>\0a=============================================================================\0a']]]
      ['InvParameterizedTest' %accept ~[['InvParameterizedTest' 'This is a duplicate of DieHardTLA.tla that doesn\'t EXTEND TLC to test that this dependency is dynamically added.\0a----------------------- MODULE InvParameterizedTest ------------------------\0aEXTENDS Integers\0a\0aVARIABLES small, big   \0a          \0aTypeOK == /\\ small \\in 0..3 \0a          /\\ big   \\in 0..5\0a\0aInit == /\\ big   = 0 \0a        /\\ small = 0\0a\0aFillSmall == /\\ small\' = 3 \0a             /\\ big\'   = big\0a\0aFillBig == /\\ big\'   = 5 \0a           /\\ small\' = small\0a\0aEmptySmall == /\\ small\' = 0 \0a              /\\ big\'   = big\0a\0aEmptyBig == /\\ big\'   = 0 \0a            /\\ small\' = small\0a\0aSmallToBig == IF big + small =< 5\0a               THEN /\\ big\'   = big + small\0a                    /\\ small\' = 0\0a               ELSE /\\ big\'   = 5\0a                    /\\ small\' = small - (5 - big)\0a \0aBigToSmall == IF big + small =< 3\0a               THEN /\\ big\'   = 0 \0a                    /\\ small\' = big + small\0a               ELSE /\\ big\'   = small - (3 - big)\0a                    /\\ small\' = 3\0a\0aNext == \\/ FillSmall \0a        \\/ FillBig    \0a        \\/ EmptySmall \0a        \\/ EmptyBig    \0a        \\/ SmallToBig    \0a        \\/ BigToSmall    \0a        \0aSpec == Init /\\ [][Next]_<<small, big>>   \0a\0a=============================================================================\0a----------------------- CONFIG InvParameterizedTest -------------------------\0aSPECIFICATION Spec\0a=============================================================================']]]
      ['LetDef1Boxed' %accept ~[['LetDef1Boxed' '--------------------------- MODULE LetDef1Boxed ----------------------------\0aVARIABLE\0a    x\0avars == x\0ax0 == x\0aInit == x = TRUE\0aNext == x\' = ~x\0aSpec == Init /\\ [][Next]_vars\0a\0aProp ==\0a    LET\0a        x1(x2) == x2\0a    IN x1([][x\']_x0)\0a\0a-----\0a\0ax1(def_arg) == def_arg\0a\0aProp2 == x1([][x\']_x0)\0a\0aSpec3 ==\0a    LET\0a        id(a) == a\0a    IN id(Init /\\ [][Next]_vars)\0a\0aSpec4 == x1(Init /\\ [][Next]_vars)\0a===========================================================================\0a---- CONFIG LetDef1Boxed ----\0aSPECIFICATION Spec\0aPROPERTY Prop\0a======']]]
      ['LetDef2Boxed' %accept ~[['LetDef2Boxed' '---- MODULE LetDef2Boxed ----\0aVARIABLE\0a    x\0avars == x\0ax0 == x\0aInit == x = TRUE\0aNext == x\' = ~x\0aSpec == Init /\\ [][Next]_vars\0a\0ax3(def_arg) == def_arg\0aProp ==\0a    LET\0a        x1(x2(_)) == x2([][x\']_x0)\0a    IN x1(x3)\0a\0a-------\0a\0ax2(def_arg) == def_arg\0ax1(def_arg(_)) == def_arg([][x\']_x0)\0aProp2 == x1(x2)\0a\0as1(sa(_)) == sa(Init /\\ [][Next]_vars)\0a\0aSpec3 ==\0a    LET\0a        id(a(_)) == a(Init /\\ [][Next]_vars)\0a    IN id(x3)\0a\0aSpec4 == s1(x3)\0a\0a====\0a---- CONFIG LetDef2Boxed ----\0aSPECIFICATION Spec\0aPROPERTY Prop\0a====\0a']]]
      ['LivenessConstraintWarning' %accept ~[['LivenessConstraintWarning' '----------------------------- MODULE LivenessConstraintWarning -----------------------------\0aEXTENDS Integers, Sequences\0a\0aVARIABLES pc, history\0avars == <<pc, history>>\0a\0aInit == /\\ pc = "A" \0a        /\\ history = <<>>\0a\0aA == /\\ pc  = "A"\0a     /\\ pc\' = "B"\0a     /\\ history\' = history \\o <<pc>>\0a\0aB == /\\ pc  = "B"\0a     /\\ pc\' = "A"\0a     /\\ UNCHANGED history \0a\0aSpec == Init /\\ [][A \\/ B]_vars /\\ WF_vars(A \\/ B)\0a\0aConstraint == Len(history) < 3\0a\0aProp == <>(pc = "Done")\0a\0a==============================================================================\0a']]]
      ['MinimalSetOfInitStates' %accept ~[['MinimalSetOfInitStates' '--------- MODULE MinimalSetOfInitStates ------------\0aVARIABLE x\0a\0a\\* x = 0 true because _second_ conjunct is true.\0a\\* The allAssigned branch in Tool#getInitStates(ActionItemList, TLCState, IStateFunctor)\0a\\* prevents TLC from generating three states with x = 0.  \0aI1a == /\\ x = 0\0a       /\\ \\/ 1 = 1\0a          \\/ 2 = 2\0a          \\/ 3 = 3\0a         \0a\\* x = 1 true because _first_ conjunct is true.\0a\\* The allAssigned branch in Tool#getInitStates(ActionItemList, TLCState, IStateFunctor)\0a\\* _does not_ prevents TLC from generating three states with x = 1.\0aI1b == /\\ \\/ 1 = 1\0a          \\/ 2 = 2\0a          \\/ 3 = 3\0a       /\\ x = 1\0a\0a\\* x = 2 true because _first_ conjunct is true.\0a\\* The allAssigned branch in Tool#getInitStates(ActionItemList, TLCState, IStateFunctor)\0a\\* _does not_ prevents TLC from generating three states with x = 2. The "~~" trick prevents\0a\\* TLC from generating three states with x = 2 because the default case in Tool line 729\0a\\* simply evaluates the first conjunct without generating states.\0aI1c == /\\ ~~(\\/ 1 = 1\0a             \\/ 2 = 2\0a             \\/ 3 = 3)\0a       /\\ x = 2\0a       \0a\\* Doesn\'t assign 1 bc pred is false, thus not counted as init.\0aI2 == /\\ x = 3 \0a      /\\ \\/ 1 = 2\0a         \\/ 2 = 3\0a         \\/ 3 = 1\0a\0a\\* Doesn\'t assign 1 because pred is false,\0a\\* but counted as init because pred comes first.\0aI3 == /\\ \\/ 1 = 2\0a         \\/ 2 = 3\0a         \\/ 3 = 1\0a      /\\ x = 4\0a\0aI4 == \\/ x = 5\0a      \\/ x = 6\0a        /\\ \\/ \\/ 1 = 2\0a              \\/ 1 = 1 \0a           \\/ 2 = 3\0a           \\/ 3 = 2\0a\0aI5 == /\\ x = 7\0a\0aInit == \\/ I1a\0a        \\/ I1b\0a        \\/ I1c\0a        \\/ I2\0a        \\/ I3\0a        \\/ I4\0a        \\/ I5\0a           \0a\0aNext == UNCHANGED x\0a====================================================\0a']]]
      ['MinimalSetOfNextStates' %accept ~[['MinimalSetOfNextStates' '--------- MODULE MinimalSetOfNextStates ------------\0aEXTENDS TLC\0aVARIABLE x\0a\0aInit == x = 42\0a\0a\0a\\* x = 0 true because _second_ conjunct is true.\0a\\* The allAssigned branch in Tool#getInitStates(ActionItemList, TLCState, IStateFunctor)\0a\\* prevents TLC from generating duplicate states with x = 0.  \0aN1a == /\\ x\' = 0\0a       /\\ \\/ 1 = 1\0a          \\/ 2 = 2\0a          \\/ 3 = 3\0a         \0a\\* x = 1 true because _first_ conjunct is true.\0a\\* The allAssigned branch in Tool#getInitStates(ActionItemList, TLCState, IStateFunctor)\0a\\* _does not_ prevents TLC from generating duplicate states with x = 1.\0aN1b == /\\ \\/ 1 = 1\0a          \\/ 2 = 2\0a          \\/ 3 = 3\0a       /\\ x\' = 1\0a\0a\\* x = 2 true because _first_ conjunct is true.\0a\\* The allAssigned branch in Tool#getInitStates(ActionItemList, TLCState, IStateFunctor)\0a\\* _does not_ prevents TLC from generating three states with x = 2. The "~~" trick prevents\0a\\* TLC from generating duplicate states with x = 2 because Tool simply evaluates the first\0a\\* conjunct without generating states.\0aN1c == /\\ ~~(\\/ 1 = 1\0a             \\/ 2 = 2\0a             \\/ 3 = 3)\0a       /\\ x\' = 2\0a       \0aN2 == /\\ x\' = 3 \\* Pred FALSE\0a      /\\ \\/ 1 = 2\0a         \\/ 2 = 3\0a         \\/ 3 = 1\0a\0aN3 == /\\ \\/ 1 = 2 \\* Pred FALSE\0a         \\/ 2 = 3\0a         \\/ 3 = 1\0a      /\\ x\' = 4\0a\0aN4 == \\/ x\' = 5\0a      \\/ x\' = 6\0a        /\\ \\/ \\/ 1 = 2\0a              \\/ 1 = 1 \0a           \\/ 2 = 3\0a           \\/ 3 = 2\0a\0aN5 == /\\ x\' = 7\0a\0aNext == \\/ N1a\0a        \\/ N1b\0a        \\/ N1c\0a        \\/ N2\0a        \\/ N3\0a        \\/ N4\0a        \\/ N5\0a           \0aInv == x \\in {42,0,1,2,5,6,7}\0a\0aHasFive == x = 5\0a\0aLeaveInit == x = 42 /\\ x\' # 42\0a\0aPossibleCounts ==\0a    LET p == TLCGet("all:named")["s:_possible"][1]\0a    IN /\\ p["HasFive"] = 7\0a       /\\ p["LeaveInit"] = 8\0a====================================================\0a']]]
      ['MinimumDiameter' %accept ~[['MinimumDiameter' '--------------------------- MODULE MinimumDiameter ---------------------------\0aVARIABLES x\0a\0aSpec == (x = 0) /\\ [][UNCHANGED x]_x\0a=============================================================================\0a']]]
      ['PossibleFail' %accept ~[['PossibleFail' '---- MODULE PossibleFail ----\0aEXTENDS Naturals\0aVARIABLE x\0a\0aInit == x = 0\0a\0aNext == x\' = (x + 1) % 3\0a\0a\\* State-level predicates.\0aAtOne       == x = 1\0aAllDone     == x = 2\0aUnreachable == x = 5     \\* never true: reachable values of x are 0, 1, 2\0a\0a\\* Action-level predicates.\0aWrapAround == x = 2 /\\ x\' = 0\0aBigJump    == x\' = x + 2 \\* never true: Next only increments x by 1 mod 3\0a\0aSpec == Init /\\ [][Next]_x\0a\0a\\* Used by PossibleFailNoTransTest to exercise the edge case where there are\0a\\* no transitions at all (only initial states).  Action-level predicates wired\0a\\* through actionConstraints are never evaluated for such a spec, so the name\0a\\* is never inserted into _Counts -- _CheckName must still report the failure.\0aNoNext       == FALSE\0aSpecOnlyInit == Init /\\ [][NoNext]_x\0a====\0a']]]
      ['PossibleTest' %accept ~[['PossibleTest' '---- MODULE PossibleTest ----\0aEXTENDS Naturals, TLC\0aVARIABLE x\0a\0aInit == x = 0\0a\0aNext == x\' = (x + 1) % 3\0a\0aAllDone == x = 2\0a\0aAtOne == x = 1\0a\0aWrapAround == x = 2 /\\ x\' = 0\0a\0aSpec == Init /\\ [][Next]_x\0a\0aPossibleCounts ==\0a    LET p == TLCGet("all:named")["s:_possible"][1]\0a    IN /\\ p["AllDone"] = 1\0a       /\\ p["AtOne"] = 1\0a       /\\ p["WrapAround"] = 1\0a====\0a']]]
      ['PostConditionsTest' %accept ~[['PostConditionsTest' '---- MODULE PostConditionsTest ----\0aEXTENDS Naturals, TLC\0aVARIABLE x\0a\0aInit == x = 0\0a\0aNext == x < 3 /\\ x\' = x + 1\0a\0aSpec == Init /\\ [][Next]_x\0a\0aPost1 == TLCSet(100, TLCGet("generated"))\0a\0aPost2 == TLCSet(101, TLCGet("distinct"))\0a\0aPostFail == TLCGet("distinct") = 42\0a\0aAtTwo == x = 2\0a\0aLastStep == x = 2 /\\ x\' = 3\0a\0aPossibleCounts ==\0a    LET p == TLCGet("all:named")["s:_possible"][1]\0a    IN /\\ p["AtTwo"] = 1\0a       /\\ p["LastStep"] = 1\0a====\0a']]]
      ['RandomElement' %accept ~[['RandomElement' '--------------------------- MODULE RandomElement ---------------------------\0aEXTENDS Integers, TLC\0a\0aVARIABLE x, y\0a\0aInit == /\\ x = RandomElement(1..1000)\0a        /\\ y = 0\0a\0aNext == /\\ \\/ x\' = RandomElement(1..1000)\0a           \\/ x\' = x\0a        /\\ y\' = y + 1\0a        \0a\0aSpec == Init /\\ [][Next]_<<x,y>>\0a\0aInv == y < 10\0a=============================================================================\0a']]]
      ['RandomElementXandY' %accept ~[['RandomElementXandY' '--------------------------- MODULE RandomElementXandY ---------------------------\0aEXTENDS Integers, TLC\0a\0aVARIABLE x, y\0a\0aInit == /\\ x = 0\0a        /\\ y = 0\0a\0aNext == /\\ x\' = RandomElement(0..1)\0a        /\\ y\' = RandomElement(0..1)\0a        \0a\0aSpec == Init /\\ [][Next]_<<x,y>>\0a\0aInv == x = y\0a=============================================================================\0a']]]
      ['RandomSubset' %accept ~[['RandomSubset' '--------------------------- MODULE RandomSubset ---------------------------\0aEXTENDS Integers, Randomization\0a\0aVARIABLE x, y, z\0a\0aInit == /\\ x \\in RandomSubset(1001, 1..100000000)\0a        /\\ y \\in RandomSubset(2, 100000000..100000010)\0a        /\\ z = TRUE\0a\0aNext == /\\ UNCHANGED <<x, y>>\0a        /\\ z\' = FALSE\0a        \0a\0aSpec == Init /\\ [][Next]_<<x,y,z>>\0a\0aInv == z = TRUE\0a=============================================================================\0a']]]
      ['RandomSubsetNext' %accept ~[['RandomSubsetNext' '------------------------- MODULE RandomSubsetNext -------------------------\0aEXTENDS Integers, Randomization\0a\0aVARIABLE x, y\0a\0aInit == /\\ x \\in RandomSubset(10, 1..1000)\0a        /\\ y = 0\0a\0aNext == /\\ x\'\\in RandomSubset(10, 1..1000)\0a        /\\ y\' = y + 1\0a        \0aSpec == Init /\\ [][Next]_<<x,y>>\0a\0aInv == y < 10\0a=============================================================================\0a']]]
      ['RandomSubsetSetOfFcns' %accept ~[['RandomSubsetSetOfFcns' '--------------------------- MODULE RandomSubsetSetOfFcns ---------------------------\0aEXTENDS Integers, Randomization\0a\0aVARIABLE x\0a\0aS == {1,2,3,4,5,6,7,8,9}\0aT == 1..10\0a\0a\\* [S->T] has 10^8 elements of which we want 1k.\0a\\* Explicitly enumerating all 10^8 elements will\0a\\* definitely timeout the tests. |[S -> T]| of\0a\\* sizes exceeding Integer.MAX_VALUE are not yet\0a\\* supported.\0aInit == /\\ x \\in RandomSubset(1000, [ S -> T ])\0a\0aNext == /\\ UNCHANGED <<x>>\0a\0aSpec == Init /\\ [][Next]_<<x>>\0a\0aInv == TRUE\0a=============================================================================\0a']]]
      ['SetPredValue' %accept ~[['SetPredValue' '---- MODULE SetPredValue ----\0aEXTENDS TLC, FiniteSets, Integers\0a\0aRange(F) == { F[x] : x \\in DOMAIN F }\0aMin(n, m) == IF n < m THEN n ELSE m\0a\0aLP(S, T, p) == LET ss == { s \\in SUBSET S : Cardinality(s) = p}\0a                          IN { e \\in [ T -> ss ] : \0a                                Cardinality(Range(e)) = Min(Cardinality(T), Cardinality(ss)) }\0a\0aASSUME PrintT(LP(1..4, {"a","b","c"}, 2))\0a\0a=============================\0a']]]
      ['StandardModules' %accept ~[['StandardModules' '------------------------------- MODULE StandardModules -------------------------------\0aEXTENDS Bags, Sequences, FiniteSets, TLC, RealTime, Naturals, Integers, Randomization\0aVARIABLES x\0aInit == FALSE /\\ x = 0\0aNext == [][FALSE /\\ x\' = x]_<<x>>\0a============================================================================\0a']]]
      ['SubsetEq' %accept ~[['SubsetEq' '------------------------------ MODULE SubsetEq ------------------------------\0aEXTENDS Integers, FiniteSets\0a\0aVARIABLE b\0a\0aInit == b = TRUE\0a\0aNext == b\' = /\\ (SUBSET (1..23) \\subseteq SUBSET (1..42))\0a             /\\ ~(SUBSET (1..42) \\subseteq SUBSET (1..23))\0a             /\\ ~(SUBSET (1..42) \\subseteq SUBSET (2..42))\0a             /\\ (SUBSET (2..42) \\subseteq SUBSET (1..42))\0a             /\\ (SUBSET {1,2,3} \\subseteq SUBSET {1,2,3,4})\0a             /\\ (SUBSET {} \\subseteq SUBSET {})\0a             /\\ (SUBSET {} \\subseteq SUBSET {1})\0a             /\\ ~(SUBSET {1} \\subseteq SUBSET {})\0a             /\\ (SUBSET {1} \\subseteq SUBSET Int)\0a             /\\ (SUBSET {1} \\subseteq SUBSET Nat)\0a\0aSpec == Init /\\ [][Next]_<<b>>\0a\0aInv == b = TRUE /\\ b \\in BOOLEAN\0a=============================================================================\0a']]]
      ['SubseteqNextState' %accept ~[['SubseteqNextState' '---- MODULE SubseteqNextState ----\0aEXTENDS TLC\0aVARIABLES x, y\0aTypeOK == x \\subseteq {1, 2, 3}\0aInv ==\0a  /\\ ENABLED (x\' \\subseteq {1})\0a  /\\ y = {1, 2, 3}\0aInit ==\0a  /\\ x \\subseteq {1, 2}\0a  /\\ y = {1, 2, 3}\0aNext ==\0a  /\\ UNCHANGED y\0a  /\\ x\' \\subseteq y\'\0a\0aFullSet == x = {1, 2, 3}\0a\0aGainThree == 3 \\in x\' /\\ 3 \\notin x\0a\0aPossibleCounts ==\0a    LET p == TLCGet("all:named")["s:_possible"][1]\0a    IN /\\ p["FullSet"] = 8\0a       /\\ p["GainThree"] = 16\0a====\0a']]]
      ['TLCExtTest' %accept ~[['TLCExtTest' '------------- CONFIG TLCExtTest ---------\0aSPECIFICATION Spec\0aINVARIANT Inv\0a===================\0a\0a---- MODULE TLCExtTest ----\0a\0aEXTENDS TLCExt, TLC, FiniteSets, Sequences, Naturals\0a\0aVARIABLE mvs\0a\0aInit ==\0a  mvs = { TLCModelValue("T_MV" \\o ToString(i)) : i \\in 1..3 }\0a\0aSpec == \0a  Init /\\ [][UNCHANGED mvs]_mvs\0a\0aInv ==\0a  /\\ Cardinality(mvs) = 3\0a  /\\ TLCModelValue("T_MV1") \\in mvs\0a  /\\ TLCModelValue("T_MV2") \\in mvs\0a  /\\ TLCModelValue("T_MV3") \\in mvs\0a\0a-------------------------------------------------\0a\0aASSUME ToString(TLCModelValue("T_MyMV")) = "T_MyMV"\0aASSUME ToString(TLCModelValue("T_MyMV")) # ""\0a\0aASSUME TLCModelValue("T_MyMV") = TLCModelValue("T_MyMV")\0aASSUME TLCModelValue("T_MyMV") # TLCModelValue("T_YourMV")\0aASSUME AssertError(\0a  "Attempted to check equality of the differently-typed model values T_MyMV and S_MyMV",\0a  TLCModelValue("T_MyMV") = TLCModelValue("S_MyMV"))\0a==================================\0a']]]
      ['TLCExtTrace' %accept ~[['TLCExtTrace' '------------- CONFIG TLCExtTrace ---------\0a\0aSPECIFICATION Spec\0aINVARIANT Inv\0aCONSTRAINT Inv\0a===================\0a\0a---- MODULE TLCExtTrace ----\0a\0aEXTENDS Integers, TLCExt, Sequences\0a\0aVARIABLE x\0a\0aSpec == x = 1 /\\ [][x < 10 /\\ x\' = x + 1]_x\0a\0a\\* Assert that Trace is the sequence of states up to the current value of x.\0aInv == /\\ Len(Trace) = x\0a       /\\ \\A i \\in 1..x : /\\ Trace[i].x = i\0a\0aInv2 == x < 7\0a\0aAlias ==\0a[\0a\09x |-> x,\0a\09t |-> Trace\0a]\0a==================================\0a']]]
      ['TLCGetNamedUndefined' %accept ~[['TLCGetNamedUndefined' '------------------------ MODULE TLCGetNamedUndefined ------------------------\0aEXTENDS TLC\0a\0adiameter == TLCGet("diameter")\0adistinct == TLCGet("distinct")\0aqueue == TLCGet("queue")\0alevel == TLCGet("level")\0a\0aCONSTANT A,B,C,D\0a\0aASSUME(TRUE)\0a\0a=============================================================================\0a']]]
      ['TLCSetInit' %accept ~[['TLCSetInit' '----- MODULE TLCSetInit -----\0aEXTENDS Integers, TLC\0a\0aVARIABLES x\0a\0aInit == x = 1 /\\ TLCSet(1,"TLCSet works.")\0aNext == x < 10 /\\ x\' = x + 1 /\\ PrintT(TLCGet(1))\0a\0aAtFive == x = 5\0a\0aStep == x\' = x + 1\0a\0aPossibleCounts ==\0a    LET p == TLCGet("all:named")["s:_possible"][1]\0a    IN /\\ p["AtFive"] = 1\0a       /\\ p["Step"] = 9\0a\0a=====']]]
      ['TLCSetSim' %accept ~[['TLCSetSim' '--------------------------- MODULE TLCSetSim ---------------------------\0aEXTENDS Integers, TLC\0a\0aASSUME /\\ TLCGet("config").depth = 4224\0a       /\\ TLCGet("config").mode \\in {"simulate", "generate"}\0a       /\\ TLCGet("config").traces = -1\0a\0aASSUME TLCGet("spec").inits = {[name |-> "Init", location |-> [beginLine |-> 13, beginColumn |-> 9, endLine |-> 16, endColumn |-> 40, module |-> "TLCSetSim"], coverage |-> [distinct |-> 0, generated |-> 0] ]}\0aASSUME TLCGet("spec").actions = {[name |-> "Next", location |-> [beginLine |-> 18, beginColumn |-> 9, endLine |-> 22, endColumn |-> 35, module |-> "TLCSetSim"], coverage |-> [distinct |-> 0, generated |-> 0] ]}\0a\0aVARIABLES x\0a\0aInit == /\\ x = 0\0a        /\\ TLCGet("stats").duration >= 0\0a        /\\ TLCGet("stats").traces = 0\0a        /\\ TLCGet("stats").generated = 0\0a\0aNext == /\\ x\' = x + 1\0a        /\\ TLCGet("stats").duration >= 0\0a        /\\ TLCGet("stats").traces = 1\0a        /\\ TLCGet("stats").generated = x\'\0a        /\\ TLCSet("exit", x = 4223)\0a\0aSpec == Init /\\ [][Next]_x\0a    \0aASSUME TLCGet("config").deadlock = FALSE\0aASSUME TLCGet("config").worker = 1\0aASSUME TLCGet("config").aril \\in STRING\0aASSUME TLCGet("config").seed \\in STRING\0a\0aASSUME TLCGet("revision").tag \\in STRING\0aASSUME TLCGet("revision").count \\in Nat\0aASSUME TLCGet("revision").timestamp \\in Nat\0aASSUME TLCGet("revision").date \\in STRING\0aASSUME TLCGet("revision").calver \\in STRING\0aASSUME TLCGet("revision").calver # ""\0aASSUME TLCGet("revision").tag = "development" => TLCGet("revision").count = 0 \0aASSUME TLCGet("revision").tag # "development" => TLCGet("revision").count > 7854\0aASSUME TLCGet("revision").tag # "development" => TLCGet("revision").timestamp > 1626748578\0a=============================================================================\0a']]]
      ['Test2' %accept ~[['Test2' '---------- MODULE Test2 -----------\0a\0a(* This spec originates from an email conversation between Leslie and Yuan in 2009 *)\0a\0aEXTENDS Naturals, TLC\0aVARIABLE x\0aASSUME TLCSet(42, 0)\0aInit == x=0\0a\0aNext == x\' = (x+1)%5 /\\ TLCSet(42, TLCGet(42)+1)\0a\0aSpec == Init /\\ [][Next]_x /\\ WF_x(Next)\0a\0aProp1 == []<>(x=1)\0a\0aPostCondition ==\0a    PrintT(TLCGet(42)) /\\ TLCGet(42) \\in {1050,2000}\0a\0aPostConditionViolated ==\0a    TLCGet(42) = 0\0a\0a==============================================\0a']]]
      ['Test2a' %accept ~[['Test2a' '---------- MODULE Test2a -----------\0a\0a(* This spec originates from an email conversation between Leslie and Yuan in 2009 *)\0a\0aEXTENDS Naturals\0aVARIABLE x\0a\0aInit == x=0\0a\0aNext == x\' = (x+1)%5\0a\0aSpec == Init /\\ [][Next]_x /\\ WF_x(Next)\0a\0aProp1 == []<>(x=5)\0a\0aneg_Prop1 == ~(Prop1)\0a\0aXCyclesToZero == []<>(x = 0)\0a==============================================\0a']]]
      ['Test4' %accept ~[['Test4' '---------- MODULE Test4 -----------\0aVARIABLE x\0a\0aASSUME TRUE = FALSE \\* No, it\'s not!\0a\0aSpec == x = 0 /\\ [][UNCHANGED x]_x\0a\0a==============================================\0a']]]
      ['TraceWithLargeSetOfInitialStatesTest' %accept ~[['TraceWithLargeSetOfInitialStatesTest' '---------------- MODULE TraceWithLargeSetOfInitialStatesTest ----------------\0aEXTENDS Integers\0a\0aVARIABLES x,y\0a\0aSpec == (x \\in 1..11 /\\ y = FALSE) /\\ [][x\' = x /\\ y\' = TRUE]_<<x,y>>\0a\0aInv == y = FALSE\0a=============================================================================']]]
      ['UserModuleOverride' %accept ~[['UserModuleOverride' '--------------------------- MODULE UserModuleOverride -----------------------\0aEXTENDS Naturals, TLC\0aVARIABLES x\0a\0aGet == FALSE\0a\0aGet2 == TRUE\0a\0aInit == x = Get\0a\0aNext == x\' = Get2\0a\0aSpec == Init /\\ [][Next]_<<x>>\0a\0aProp == <>[](Print(x, x = TRUE) /\\ TLCGet("diameter") > 0)\0a=============================================================================\0a']]]
      ['UserModuleOverrideAnnotation' %accept ~[['UserModuleOverrideAnnotation' '--------------------------- MODULE UserModuleOverrideAnnotation -----------------------\0aEXTENDS Naturals, TLC\0aVARIABLES x\0a\0aGet == FALSE\0aGet2 == FALSE\0a\0aInit == x = Get\0a\0aNext == x\' = Get2\0a\0aSpec == Init /\\ [][Next]_<<x>>\0a\0aProp == <>[](Print(x, x = TRUE) /\\ TLCGet("diameter") > 0)\0a=============================================================================\0a']]]
      ['testinvalidinvariant' %accept ~[['testinvalidinvariant' '------------------ MODULE testinvalidinvariant --------------------\0aEXTENDS Integers\0a\0aVARIABLES x\0aInit == /\\ x = 1\0aNext == /\\ x\'= x + 1 \0aSpec == Init /\\ [][Next]_<<x>>\0a\0a\\* Primed variable is invalid.\0aInvariant == x\' \\in Nat\0a\0a==================================================================\0a']]]
  ==
