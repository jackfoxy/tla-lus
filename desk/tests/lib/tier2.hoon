      ['IncompleteNextMultipleActions' %accept ~[['IncompleteNextMultipleActions' '--------------------------- MODULE IncompleteNextMultipleActions ---------------------------\0aEXTENDS Integers, TLC\0a\0aVARIABLES x, y, z\0a\0aA1 == x\'= x + 1\0a\0aA2 == x\'= 1 /\\ y\' = 1 /\\ z\' = 1\0a\0aSpec == (x=0) /\\ (y=0) /\\ (z=0) /\\ [][A1 \\/ A2]_<<x,y,z>>\0a=============================================================================\0a']]]
      ['InvParameterizedTest' %accept ~[['InvParameterizedTest' 'This is a duplicate of DieHardTLA.tla that doesn\'t EXTEND TLC to test that this dependency is dynamically added.\0a----------------------- MODULE InvParameterizedTest ------------------------\0aEXTENDS Integers\0a\0aVARIABLES small, big   \0a          \0aTypeOK == /\\ small \\in 0..3 \0a          /\\ big   \\in 0..5\0a\0aInit == /\\ big   = 0 \0a        /\\ small = 0\0a\0aFillSmall == /\\ small\' = 3 \0a             /\\ big\'   = big\0a\0aFillBig == /\\ big\'   = 5 \0a           /\\ small\' = small\0a\0aEmptySmall == /\\ small\' = 0 \0a              /\\ big\'   = big\0a\0aEmptyBig == /\\ big\'   = 0 \0a            /\\ small\' = small\0a\0aSmallToBig == IF big + small =< 5\0a               THEN /\\ big\'   = big + small\0a                    /\\ small\' = 0\0a               ELSE /\\ big\'   = 5\0a                    /\\ small\' = small - (5 - big)\0a \0aBigToSmall == IF big + small =< 3\0a               THEN /\\ big\'   = 0 \0a                    /\\ small\' = big + small\0a               ELSE /\\ big\'   = small - (3 - big)\0a                    /\\ small\' = 3\0a\0aNext == \\/ FillSmall \0a        \\/ FillBig    \0a        \\/ EmptySmall \0a        \\/ EmptyBig    \0a        \\/ SmallToBig    \0a        \\/ BigToSmall    \0a        \0aSpec == Init /\\ [][Next]_<<small, big>>   \0a\0a=============================================================================\0a----------------------- CONFIG InvParameterizedTest -------------------------\0aSPECIFICATION Spec\0a=============================================================================']]]
      ['JsonTests' %accept ~[['JsonTests' '------------- CONFIG JsonTests ---------\0a\0aCONSTANT ModelValueConstant = ModelValue\0a===================\0a\0a----------------------------- MODULE JsonTests -----------------------------\0aEXTENDS Json, Integers, Sequences, TLC, TLCExt\0a\0aCONSTANT ModelValueConstant\0a\0a\\* Empty values\0aASSUME(AssertEq(ToJsonArray({}), "[]"))\0aASSUME(AssertEq(ToJsonArray(<<>>), "[]"))\0a\0a\\* Primitive values\0aASSUME(AssertEq(ToJson(FALSE), "false"))\0aASSUME(AssertEq(ToJson(1), "1"))\0aASSUME(AssertEq(ToJson("a"), "\\"a\\""))\0aASSUME(AssertEq(ToJson(ModelValueConstant), "\\"ModelValue\\""))\0aASSUME(AssertEq(ToJson({TRUE, FALSE}), "[false,true]"))\0aASSUME(AssertEq(ToJson({1}), "[1]"))\0aASSUME(AssertEq(ToJsonArray({TRUE, FALSE}), "[false,true]"))\0aASSUME(AssertEq(ToJsonArray({1}), "[1]"))\0aASSUME(AssertEq(ToJsonArray({"foo"}), "[\\"foo\\"]"))\0aASSUME(AssertEq(ToJsonObject([a |-> TRUE, b |-> FALSE]), "{\\"a\\":true,\\"b\\":false}"))\0aASSUME(AssertEq(ToJsonObject([a |-> 1]), "{\\"a\\":1}"))\0aASSUME(AssertEq(ToJsonObject([a |-> "b"]), "{\\"a\\":\\"b\\"}"))\0a\0a\\* Structural values\0aASSUME(AssertEq(ToJson({3, 2, 1}), "[1,2,3]"))\0aASSUME(AssertEq(ToJson(<<3, 2, 1>>), "[3,2,1]"))\0aASSUME(AssertEq(ToJson([x \\in {3, 2, 1} |-> 2 * x + 1]), "[3,5,7]"))\0aASSUME(AssertEq(ToJson(3 :> "c" @@ 2 :> "b" @@ 1 :> "a"), "[\\"a\\",\\"b\\",\\"c\\"]"))\0aASSUME(AssertEq(ToJson([ {2, 1} -> {"a", "b"} ]), "[[\\"a\\",\\"a\\"],[\\"a\\",\\"b\\"],[\\"b\\",\\"a\\"],[\\"b\\",\\"b\\"]]"))\0aASSUME(AssertEq(ToJson([ {1, 0} -> {"a", "b"} ]), "[{\\"0\\":\\"a\\",\\"1\\":\\"a\\"},{\\"0\\":\\"a\\",\\"1\\":\\"b\\"},{\\"0\\":\\"b\\",\\"1\\":\\"a\\"},{\\"0\\":\\"b\\",\\"1\\":\\"b\\"}]"))\0aASSUME(AssertEq(ToJson([a: {2, 1}, b: {"a", "b"}]), "[{\\"a\\":1,\\"b\\":\\"a\\"},{\\"a\\":1,\\"b\\":\\"b\\"},{\\"a\\":2,\\"b\\":\\"a\\"},{\\"a\\":2,\\"b\\":\\"b\\"}]"))\0aASSUME(AssertEq(ToJson({2, 1} \\X {"b", "a"}), "[[1,\\"a\\"],[1,\\"b\\"],[2,\\"a\\"],[2,\\"b\\"]]"))\0aASSUME(AssertEq(ToJson(SUBSET {2, 1}), "[[],[1],[2],[1,2]]"))\0aASSUME(AssertEq(ToJson(1..3), "[1,2,3]"))\0aASSUME(AssertEq(ToJsonArray({3, 2, 1}), "[1,2,3]"))\0aASSUME(AssertEq(ToJsonArray(<<3, 2, 1>>), "[3,2,1]"))\0aASSUME(AssertEq(ToJsonArray([x \\in {3, 2, 1} |-> 2 * x + 1]), "[3,5,7]"))\0aASSUME(AssertEq(ToJsonArray(3 :> "c" @@ 2 :> "b" @@ 1 :> "a"), "[\\"a\\",\\"b\\",\\"c\\"]"))\0aASSUME(AssertEq(ToJsonArray([ {2, 1} -> {"a", "b"} ]), "[[\\"a\\",\\"a\\"],[\\"a\\",\\"b\\"],[\\"b\\",\\"a\\"],[\\"b\\",\\"b\\"]]"))\0aASSUME(AssertEq(ToJsonArray([ {1, 0} -> {"a", "b"} ]), "[{\\"0\\":\\"a\\",\\"1\\":\\"a\\"},{\\"0\\":\\"a\\",\\"1\\":\\"b\\"},{\\"0\\":\\"b\\",\\"1\\":\\"a\\"},{\\"0\\":\\"b\\",\\"1\\":\\"b\\"}]"))\0aASSUME(AssertEq(ToJsonArray([a: {2, 1}, b: {"a", "b"}]), "[{\\"a\\":1,\\"b\\":\\"a\\"},{\\"a\\":1,\\"b\\":\\"b\\"},{\\"a\\":2,\\"b\\":\\"a\\"},{\\"a\\":2,\\"b\\":\\"b\\"}]"))\0aASSUME(AssertEq(ToJsonArray({2, 1} \\X {"b", "a"}), "[[1,\\"a\\"],[1,\\"b\\"],[2,\\"a\\"],[2,\\"b\\"]]"))\0aASSUME(AssertEq(ToJsonArray(SUBSET {2, 1}), "[[],[1],[2],[1,2]]"))\0aASSUME(AssertEq(ToJsonArray(1..3), "[1,2,3]"))\0aASSUME(AssertEq(ToJsonObject([a |-> FALSE, b |-> 1]), "{\\"a\\":false,\\"b\\":1}"))\0aASSUME(AssertEq(ToJsonObject("a" :> 1 @@ "b" :> 2 @@ "c" :> 3), "{\\"a\\":1,\\"b\\":2,\\"c\\":3}"))\0aASSUME(AssertEq(ToJsonObject(1 :> "b" @@ 0 :> "c"), "{\\"0\\":\\"c\\",\\"1\\":\\"b\\"}"))\0a\0a\\* Tests FcnRcdValue where the domain could be represented symbolically.\0aASSUME(AssertEq(ToJsonObject([n \\in 1..2 |-> "a"]), "[\\"a\\",\\"a\\"]"))\0a\0a\\* Nested values\0aASSUME(AssertEq(ToJsonObject([a |-> {<<1, 2>>}, b |-> [c |-> 3]]), "{\\"a\\":[[1,2]],\\"b\\":{\\"c\\":3}}"))\0a\0a\\* Serializing and deserializing objects\0andTestObjects ==\0a    LET output == <<[a |-> 1, b |-> "a"], [a |-> 2, b |-> "b"], [a |-> 3, b |-> "c"]>>\0a    IN\0a       /\\ ndJsonSerialize("target/json/test.json", output)\0a       /\\ LET input == ndJsonDeserialize("target/json/test.json")\0a          IN\0a             /\\ Len(input) = 3\0a             /\\ input[1].a = 1\0a             /\\ input[1].b = "a"\0a             /\\ input[2].a = 2\0a             /\\ input[2].b = "b"\0a             /\\ input[3].a = 3\0a             /\\ input[3].b = "c"\0aASSUME(ndTestObjects)\0a\0a\\* Serializing and deserializing arrays\0andTestArrays ==\0a    LET output == << <<1, 2, 3>>, <<4, 5, 6>>, <<7, 8, 9>> >>\0a    IN\0a       /\\ ndJsonSerialize("target/json/test.json", output)\0a       /\\ LET input == ndJsonDeserialize("target/json/test.json")\0a          IN\0a             /\\ Len(input) = 3\0a             /\\ input[1][1] = 1\0a             /\\ input[1][2] = 2\0a             /\\ input[1][3] = 3\0a             /\\ input[2][1] = 4\0a             /\\ input[2][2] = 5\0a             /\\ input[2][3] = 6\0a             /\\ input[3][1] = 7\0a             /\\ input[3][2] = 8\0a             /\\ input[3][3] = 9\0aASSUME(ndTestArrays)\0a\0a\\* Serializing and deserializing primitive values\0andTestPrimitives ==\0a    LET output == <<1, 2, 3, 4>>\0a    IN\0a       /\\ ndJsonSerialize("target/json/test.json", output)\0a       /\\ LET input == ndJsonDeserialize("target/json/test.json")\0a          IN\0a             /\\ Len(input) = 4\0a             /\\ input[1] = 1\0a             /\\ input[2] = 2\0a             /\\ input[3] = 3\0a             /\\ input[4] = 4\0aASSUME(ndTestPrimitives)\0a\0a\\* Serializing and deserializing objects\0aTestObjects ==\0a    LET output == <<[a |-> 1, b |-> "a"], [a |-> 2, b |-> "b"], [a |-> 3, b |-> "c"]>>\0a    IN\0a       /\\ JsonSerialize("target/json/test.json", output)\0a       /\\ LET input == JsonDeserialize("target/json/test.json")\0a          IN\0a             /\\ Len(input) = 3\0a             /\\ input[1].a = 1\0a             /\\ input[1].b = "a"\0a             /\\ input[2].a = 2\0a             /\\ input[2].b = "b"\0a             /\\ input[3].a = 3\0a             /\\ input[3].b = "c"\0aASSUME(TestObjects)\0a\0a\\* Serializing and deserializing arrays\0aTestArrays ==\0a    LET output == << <<1, 2, 3>>, <<4, 5, 6>>, <<7, 8, 9>> >>\0a    IN\0a       /\\ JsonSerialize("target/json/test.json", output)\0a       /\\ LET input == JsonDeserialize("target/json/test.json")\0a          IN\0a             /\\ Len(input) = 3\0a             /\\ input[1][1] = 1\0a             /\\ input[1][2] = 2\0a             /\\ input[1][3] = 3\0a             /\\ input[2][1] = 4\0a             /\\ input[2][2] = 5\0a             /\\ input[2][3] = 6\0a             /\\ input[3][1] = 7\0a             /\\ input[3][2] = 8\0a             /\\ input[3][3] = 9\0aASSUME(TestArrays)\0a\0a\\* Serializing and deserializing primitive values\0aTestPrimitives ==\0a    LET output == <<1, 2, 3, 4>>\0a    IN\0a       /\\ JsonSerialize("target/json/test.json", output)\0a       /\\ LET input == JsonDeserialize("target/json/test.json")\0a          IN\0a             /\\ Len(input) = 4\0a             /\\ input[1] = 1\0a             /\\ input[2] = 2\0a             /\\ input[3] = 3\0a             /\\ input[4] = 4\0aASSUME(TestPrimitives)\0a\0a\\* Round trip with complex object\0a\\* There is no way to encode sets in json (like in XML or EDN), this is why we don\'t use it here\0aRoundTrip ==\0a    LET output == <<[a |-> 3], 2, <<<<1, 2>>, "look">>, <<<<<<[b |-> [c |-> <<4, 5, 6>>]]>>>>>>>>\0a    IN\0a       /\\ JsonSerialize("target/json/test.json", output)\0a       /\\ output = JsonDeserialize("target/json/test.json")\0aASSUME(RoundTrip)\0a\0aRoundTrip2 ==\0a    LET output == [a |-> 3, b |-> [c |-> <<4, 5, 6>>]]\0a    IN\0a       /\\ JsonSerialize("target/json/test.json", output)\0a       /\\ output = JsonDeserialize("target/json/test.json")\0aASSUME(RoundTrip2)\0a\0a-----\0a\0aASSUME AssertError(\0a           "The second argument of JsonSerialize should be a sequence or record, but instead it is:\\n{1, 2, 3}",\0a           JsonSerialize("target/json/test.json", {1,2,3} ))\0a\0aASSUME AssertError(\0a           "The second argument of JsonSerialize should be a sequence or record, but instead it is:\\n({\\"a\\"} :> 3 @@ {\\"b\\"} :> [c |-> <<4, 5, 6>>])",\0a           JsonSerialize("target/json/test.json", [ n \\in {{"a"}} |-> 3 ] @@ [ n \\in {{"b"}} |-> [c |-> <<4, 5, 6>>]] ))\0a\0aASSUME AssertError(\0a           "The second argument of ndJsonSerialize should be a sequence, but instead it is:\\n[a |-> 1, b |-> TRUE]",\0a           ndJsonSerialize("target/json/test.json", [a |-> 1, b |-> TRUE] ))\0a\0a\0aASSUME AssertError(\0a           "The second argument of JsonSerialize should be a sequence or record, but instead it is:\\n42",\0a           JsonSerialize("target/json/test.json", 42 ))\0a\0aASSUME AssertError(\0a           "The second argument of ndJsonSerialize should be a sequence, but instead it is:\\n42",\0a           ndJsonSerialize("target/json/test.json", 42 ))\0a\0a=============================================================================\0a']]]
      ['LetDef1Boxed' %accept ~[['LetDef1Boxed' '--------------------------- MODULE LetDef1Boxed ----------------------------\0aVARIABLE\0a    x\0avars == x\0ax0 == x\0aInit == x = TRUE\0aNext == x\' = ~x\0aSpec == Init /\\ [][Next]_vars\0a\0aProp ==\0a    LET\0a        x1(x2) == x2\0a    IN x1([][x\']_x0)\0a\0a-----\0a\0ax1(def_arg) == def_arg\0a\0aProp2 == x1([][x\']_x0)\0a\0aSpec3 ==\0a    LET\0a        id(a) == a\0a    IN id(Init /\\ [][Next]_vars)\0a\0aSpec4 == x1(Init /\\ [][Next]_vars)\0a===========================================================================\0a---- CONFIG LetDef1Boxed ----\0aSPECIFICATION Spec\0aPROPERTY Prop\0a======']]]
      ['LetDef2Boxed' %accept ~[['LetDef2Boxed' '---- MODULE LetDef2Boxed ----\0aVARIABLE\0a    x\0avars == x\0ax0 == x\0aInit == x = TRUE\0aNext == x\' = ~x\0aSpec == Init /\\ [][Next]_vars\0a\0ax3(def_arg) == def_arg\0aProp ==\0a    LET\0a        x1(x2(_)) == x2([][x\']_x0)\0a    IN x1(x3)\0a\0a-------\0a\0ax2(def_arg) == def_arg\0ax1(def_arg(_)) == def_arg([][x\']_x0)\0aProp2 == x1(x2)\0a\0as1(sa(_)) == sa(Init /\\ [][Next]_vars)\0a\0aSpec3 ==\0a    LET\0a        id(a(_)) == a(Init /\\ [][Next]_vars)\0a    IN id(x3)\0a\0aSpec4 == s1(x3)\0a\0a====\0a---- CONFIG LetDef2Boxed ----\0aSPECIFICATION Spec\0aPROPERTY Prop\0a====\0a']]]
      ['LivenessConstraintWarning' %accept ~[['LivenessConstraintWarning' '----------------------------- MODULE LivenessConstraintWarning -----------------------------\0aEXTENDS Integers, Sequences\0a\0aVARIABLES pc, history\0avars == <<pc, history>>\0a\0aInit == /\\ pc = "A" \0a        /\\ history = <<>>\0a\0aA == /\\ pc  = "A"\0a     /\\ pc\' = "B"\0a     /\\ history\' = history \\o <<pc>>\0a\0aB == /\\ pc  = "B"\0a     /\\ pc\' = "A"\0a     /\\ UNCHANGED history \0a\0aSpec == Init /\\ [][A \\/ B]_vars /\\ WF_vars(A \\/ B)\0a\0aConstraint == Len(history) < 3\0a\0aProp == <>(pc = "Done")\0a\0a==============================================================================\0a']]]
      ['MinimalSetOfInitStates' %accept ~[['MinimalSetOfInitStates' '--------- MODULE MinimalSetOfInitStates ------------\0aVARIABLE x\0a\0a\\* x = 0 true because _second_ conjunct is true.\0a\\* The allAssigned branch in Tool#getInitStates(ActionItemList, TLCState, IStateFunctor)\0a\\* prevents TLC from generating three states with x = 0.  \0aI1a == /\\ x = 0\0a       /\\ \\/ 1 = 1\0a          \\/ 2 = 2\0a          \\/ 3 = 3\0a         \0a\\* x = 1 true because _first_ conjunct is true.\0a\\* The allAssigned branch in Tool#getInitStates(ActionItemList, TLCState, IStateFunctor)\0a\\* _does not_ prevents TLC from generating three states with x = 1.\0aI1b == /\\ \\/ 1 = 1\0a          \\/ 2 = 2\0a          \\/ 3 = 3\0a       /\\ x = 1\0a\0a\\* x = 2 true because _first_ conjunct is true.\0a\\* The allAssigned branch in Tool#getInitStates(ActionItemList, TLCState, IStateFunctor)\0a\\* _does not_ prevents TLC from generating three states with x = 2. The "~~" trick prevents\0a\\* TLC from generating three states with x = 2 because the default case in Tool line 729\0a\\* simply evaluates the first conjunct without generating states.\0aI1c == /\\ ~~(\\/ 1 = 1\0a             \\/ 2 = 2\0a             \\/ 3 = 3)\0a       /\\ x = 2\0a       \0a\\* Doesn\'t assign 1 bc pred is false, thus not counted as init.\0aI2 == /\\ x = 3 \0a      /\\ \\/ 1 = 2\0a         \\/ 2 = 3\0a         \\/ 3 = 1\0a\0a\\* Doesn\'t assign 1 because pred is false,\0a\\* but counted as init because pred comes first.\0aI3 == /\\ \\/ 1 = 2\0a         \\/ 2 = 3\0a         \\/ 3 = 1\0a      /\\ x = 4\0a\0aI4 == \\/ x = 5\0a      \\/ x = 6\0a        /\\ \\/ \\/ 1 = 2\0a              \\/ 1 = 1 \0a           \\/ 2 = 3\0a           \\/ 3 = 2\0a\0aI5 == /\\ x = 7\0a\0aInit == \\/ I1a\0a        \\/ I1b\0a        \\/ I1c\0a        \\/ I2\0a        \\/ I3\0a        \\/ I4\0a        \\/ I5\0a           \0a\0aNext == UNCHANGED x\0a====================================================\0a']]]
      ['MinimalSetOfNextStates' %accept ~[['MinimalSetOfNextStates' '--------- MODULE MinimalSetOfNextStates ------------\0aEXTENDS TLC\0aVARIABLE x\0a\0aInit == x = 42\0a\0a\0a\\* x = 0 true because _second_ conjunct is true.\0a\\* The allAssigned branch in Tool#getInitStates(ActionItemList, TLCState, IStateFunctor)\0a\\* prevents TLC from generating duplicate states with x = 0.  \0aN1a == /\\ x\' = 0\0a       /\\ \\/ 1 = 1\0a          \\/ 2 = 2\0a          \\/ 3 = 3\0a         \0a\\* x = 1 true because _first_ conjunct is true.\0a\\* The allAssigned branch in Tool#getInitStates(ActionItemList, TLCState, IStateFunctor)\0a\\* _does not_ prevents TLC from generating duplicate states with x = 1.\0aN1b == /\\ \\/ 1 = 1\0a          \\/ 2 = 2\0a          \\/ 3 = 3\0a       /\\ x\' = 1\0a\0a\\* x = 2 true because _first_ conjunct is true.\0a\\* The allAssigned branch in Tool#getInitStates(ActionItemList, TLCState, IStateFunctor)\0a\\* _does not_ prevents TLC from generating three states with x = 2. The "~~" trick prevents\0a\\* TLC from generating duplicate states with x = 2 because Tool simply evaluates the first\0a\\* conjunct without generating states.\0aN1c == /\\ ~~(\\/ 1 = 1\0a             \\/ 2 = 2\0a             \\/ 3 = 3)\0a       /\\ x\' = 2\0a       \0aN2 == /\\ x\' = 3 \\* Pred FALSE\0a      /\\ \\/ 1 = 2\0a         \\/ 2 = 3\0a         \\/ 3 = 1\0a\0aN3 == /\\ \\/ 1 = 2 \\* Pred FALSE\0a         \\/ 2 = 3\0a         \\/ 3 = 1\0a      /\\ x\' = 4\0a\0aN4 == \\/ x\' = 5\0a      \\/ x\' = 6\0a        /\\ \\/ \\/ 1 = 2\0a              \\/ 1 = 1 \0a           \\/ 2 = 3\0a           \\/ 3 = 2\0a\0aN5 == /\\ x\' = 7\0a\0aNext == \\/ N1a\0a        \\/ N1b\0a        \\/ N1c\0a        \\/ N2\0a        \\/ N3\0a        \\/ N4\0a        \\/ N5\0a           \0aInv == x \\in {42,0,1,2,5,6,7}\0a\0aHasFive == x = 5\0a\0aLeaveInit == x = 42 /\\ x\' # 42\0a\0aPossibleCounts ==\0a    LET p == TLCGet("all:named")["s:_possible"][1]\0a    IN /\\ p["HasFive"] = 7\0a       /\\ p["LeaveInit"] = 8\0a====================================================\0a']]]
