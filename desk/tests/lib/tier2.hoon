      ['IncompatibleTypesLive' %accept ~[['IncompatibleTypesLive' '---- CONFIG IncompatibleTypesLive ----\0aSPECIFICATION \0a    Spec\0aPROPERTIES\0a    Prop\0a====\0a\0a---- MODULE IncompatibleTypesLive ----\0aEXTENDS Naturals\0a\0aVARIABLES x\0a\0aInit == x = 0\0a\0aNext == \0a    \\/ x\' \\in 1..100 \\* Need to create enough successors for SetOfState to exhibit collisions.\0a    \\/ x\' = FALSE \0a    \\/ x\' = "abc"\0a\0aSpec == Init /\\ [][Next]_x\0a\0aProp == <>[]TRUE\0a=====']]]
