++  test-sany-tcommit
  %+  expect-eq
    !>  %accept
  !>
  %+  sany-verdict:semantic  'TCommit'
  %-  malt
  ^-  (list [@t @t])
  :~
      ['TCommit' '------------------------------- MODULE TCommit ------------------------------\0aCONSTANT RM       \\* The set of participating resource managers\0aVARIABLE rmState  \\* `rmState[rm]\' is the state of resource manager rm.\0a-----------------------------------------------------------------------------\0aTCTypeOK == \0a  (*************************************************************************)\0a  (* The type-correctness invariant                                        *)\0a  (*************************************************************************)\0a  rmState \\in [RM -> {"working", "prepared", "committed", "aborted"}]\0a\0aTCInit ==   rmState = [rm \\in RM |-> "working"]\0a  (*************************************************************************)\0a  (* The initial predicate.                                                *)\0a  (*************************************************************************)\0a\0acanCommit == \\A rm \\in RM : rmState[rm] \\in {"prepared", "committed"}\0a  (*************************************************************************)\0a  (* True iff all RMs are in the "prepared" or "committed" state.          *)\0a  (*************************************************************************)\0a\0anotCommitted == \\A rm \\in RM : rmState[rm] # "committed" \0a  (*************************************************************************)\0a  (* True iff neither no resource manager has decided to commit.           *)\0a  (*************************************************************************)\0a-----------------------------------------------------------------------------\0a(***************************************************************************)\0a(* We now define the actions that may be performed by the RMs, and then    *)\0a(* define the complete next-state action of the specification to be the    *)\0a(* disjunction of the possible RM actions.                                 *)\0a(***************************************************************************)\0aPrepare(rm) == /\\ rmState[rm] = "working"\0a               /\\ rmState\' = [rmState EXCEPT ![rm] = "prepared"]\0a\0aDecide(rm)  == \\/ /\\ rmState[rm] = "prepared"\0a                  /\\ canCommit\0a                  /\\ rmState\' = [rmState EXCEPT ![rm] = "committed"]\0a               \\/ /\\ rmState[rm] \\in {"working", "prepared"}\0a                  /\\ notCommitted\0a                  /\\ rmState\' = [rmState EXCEPT ![rm] = "aborted"]\0a\0aTCNext == \\E rm \\in RM : Prepare(rm) \\/ Decide(rm)\0a  (*************************************************************************)\0a  (* The next-state action.                                                *)\0a  (*************************************************************************)\0a-----------------------------------------------------------------------------\0aTCSpec == TCInit /\\ [][TCNext]_rmState\0a  (*************************************************************************)\0a  (* The complete specification of the protocol.                           *)\0a  (*************************************************************************)\0a-----------------------------------------------------------------------------\0a(***************************************************************************)\0a(* We now assert invariance properties of the specification.               *)\0a(***************************************************************************)\0aTCConsistent ==  \0a  (*************************************************************************)\0a  (* A state predicate asserting that two RMs have not arrived at          *)\0a  (* conflicting decisions.                                                *)\0a  (*************************************************************************)\0a  \\A rm1, rm2 \\in RM : ~ /\\ rmState[rm1] = "aborted"\0a                         /\\ rmState[rm2] = "committed"\0a\0aTHEOREM TCSpec => [](TCTypeOK /\\ TCConsistent)\0a  (*************************************************************************)\0a  (* Asserts that TCTypeOK and TCConsistent are invariants of the protocol. *)\0a  (*************************************************************************)\0a=============================================================================\0a']
  ==
::
++  test-sany-cigarettesmokers
  %+  expect-eq
    !>  %accept
  !>
  %+  sany-verdict:semantic  'CigaretteSmokers'
  %-  malt
  ^-  (list [@t @t])
  :~
      ['CigaretteSmokers' '-------------------------- MODULE CigaretteSmokers --------------------------\0a(***************************************************************************)\0a(* A specification of the cigarette smokers problem, originally            *)\0a(* described in 1971 by Suhas Patil.                                       *)\0a(* https://en.wikipedia.org/wiki/Cigarette_smokers_problem                 *)\0a(***************************************************************************)\0aEXTENDS Integers, FiniteSets\0a\0aCONSTANT Ingredients, Offers\0aVARIABLE smokers, dealer\0a\0a(***************************************************************************)\0a(* \'Ingredients\' is a set of ingredients, originally                       *)\0a(* {matches, paper, tobacco}. \'Offers\' is a subset of subsets of           *)\0a(* ingredients, each missing just one ingredient                           *)\0a(***************************************************************************)\0aASSUME OffersAssumption ==\0a       /\\ Offers \\subseteq (SUBSET Ingredients)\0a       /\\ \\A n \\in Offers : Cardinality(n) = Cardinality(Ingredients) - 1\0a\0a(***************************************************************************)\0a(* \'smokers\' is a function from the ingredient the smoker has              *)\0a(* infinite supply of, to a BOOLEAN flag signifying smoker\'s state         *)\0a(* (smoking/not smoking)                                                   *)\0a(* \'dealer\' is an element of \'Offers\', or an empty set                     *)\0a(***************************************************************************)\0aTypeOK == /\\ smokers \\in [Ingredients -> [smoking: BOOLEAN]]\0a          /\\ dealer  \\in Offers \\/ dealer = {}\0a          \0avars == <<smokers, dealer>>\0a\0aChooseOne(S, P(_)) == CHOOSE x \\in S : P(x) /\\ \\A y \\in S : P(y) => y = x\0a\0aInit == /\\ smokers = [r \\in Ingredients |-> [smoking |-> FALSE]]\0a        /\\ dealer \\in Offers\0a        \0astartSmoking == /\\ dealer /= {}\0a                /\\ smokers\' = [r \\in Ingredients |-> [smoking |-> {r} \\cup \0a                                                      dealer = Ingredients]]\0a                /\\ dealer\' = {}\0a                \0astopSmoking == /\\ dealer = {}\0a               /\\ LET r == ChooseOne(Ingredients,\0a                                     LAMBDA x : smokers[x].smoking)\0a                  IN smokers\' = [smokers EXCEPT ![r].smoking = FALSE] \0a               /\\ dealer\' \\in Offers\0a\0aNext == startSmoking \\/ stopSmoking\0a\0aSpec == Init /\\ [][Next]_vars\0aFairSpec == Spec /\\ WF_vars(Next)\0a\0a(***************************************************************************)\0a(* An invariant checking that at most one smoker smokes at any particular  *)\0a(* moment                                                                  *)\0a(***************************************************************************)\0aAtMostOne == Cardinality({r \\in Ingredients : smokers[r].smoking}) <= 1\0a=============================================================================\0a']
  ==
