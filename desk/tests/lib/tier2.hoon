++  test-sany-diehard
  %+  expect-eq
    !>  %accept
  !>
  %+  sany-verdict:semantic  'DieHard'
  %-  malt
  ^-  (list [@t @t])
  :~
      ['DieHard' '---------------------------- MODULE DieHard ----------------------------\0aEXTENDS TLC, Integers\0a\0aMin(m, n) == IF m < n THEN m ELSE n\0a\0aNONDET == "nondet"\0aFILL_BIG == "fill big"\0aEMPTY_BIG == "empty big"\0aFILL_SMALL == "fill small"\0aEMPTY_SMALL == "empty small"\0aBIG_TO_SMALL == "pour big to small"\0aSMALL_TO_BIG == "pour small to big"\0a\0a(***************************************************************************\0a--algorithm DieHardDemo {\0a    variables bigBucket = 0, smallBucket = 0, action = NONDET;\0a      \0a    process (FixWater = 1)\0a      variables water_to_pour = 0;\0a      {\0a        LB1: while (TRUE) \0a          {\0a            either { action := FILL_BIG; bigBucket := 5; }\0a                or { action := EMPTY_BIG; bigBucket := 0; }\0a                or { action := FILL_SMALL; smallBucket := 3; } \0a                or { action := EMPTY_SMALL; smallBucket := 0; } \0a                or { \0a                     action := BIG_TO_SMALL; \0a                     water_to_pour := Min(3 - smallBucket, bigBucket); \0a                     smallBucket := smallBucket + water_to_pour;\0a                     bigBucket := bigBucket - water_to_pour;\0a                   }\0a                or { \0a                     action := SMALL_TO_BIG; \0a                     water_to_pour := Min(5 - bigBucket, smallBucket); \0a                     smallBucket := smallBucket - water_to_pour;\0a                     bigBucket := bigBucket + water_to_pour;\0a                   }\0a          }\0a      }\0a}\0a\0a***************************************************************************)\0a\\* BEGIN TRANSLATION\0aVARIABLES bigBucket, smallBucket, action, water_to_pour\0a\0avars == << bigBucket, smallBucket, action, water_to_pour >>\0a\0aProcSet == {1}\0a\0aInit == (* Global variables *)\0a        /\\ bigBucket = 0\0a        /\\ smallBucket = 0\0a        /\\ action = NONDET\0a        (* Process FixWater *)\0a        /\\ water_to_pour = 0\0a\0aFixWater == \\/ /\\ action\' = FILL_BIG\0a               /\\ bigBucket\' = 5\0a               /\\ UNCHANGED <<smallBucket, water_to_pour>>\0a            \\/ /\\ action\' = EMPTY_BIG\0a               /\\ bigBucket\' = 0\0a               /\\ UNCHANGED <<smallBucket, water_to_pour>>\0a            \\/ /\\ action\' = FILL_SMALL\0a               /\\ smallBucket\' = 3\0a               /\\ UNCHANGED <<bigBucket, water_to_pour>>\0a            \\/ /\\ action\' = EMPTY_SMALL\0a               /\\ smallBucket\' = 0\0a               /\\ UNCHANGED <<bigBucket, water_to_pour>>\0a            \\/ /\\ action\' = BIG_TO_SMALL\0a               /\\ water_to_pour\' = Min(3 - smallBucket, bigBucket)\0a               /\\ smallBucket\' = smallBucket + water_to_pour\'\0a               /\\ bigBucket\' = bigBucket - water_to_pour\'\0a            \\/ /\\ action\' = SMALL_TO_BIG\0a               /\\ water_to_pour\' = Min(5 - bigBucket, smallBucket)\0a               /\\ smallBucket\' = smallBucket - water_to_pour\'\0a               /\\ bigBucket\' = bigBucket + water_to_pour\'\0a\0aNext == FixWater\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aInv == bigBucket # 4\0a\0a\\* END TRANSLATION\0a\0a=============================================================================\0a']
  ==
