      ['Github710a' %accept ~[['Github710a' '---- MODULE Github710a ----\0aEXTENDS TLC, TLCExt\0aVARIABLE x\0avars == <<x>>\0a\0aInit == x = FALSE\0a\0aNext == x\' \\in BOOLEAN \0a\0aSpec == \0a    /\\ Init\0a    /\\ [][Next]_vars\0a    \\* /\\ WF_x(Next)\0a\0aStateConstraint ==\0a    TRUE\0a\0a\\* This is property to check\0aAtMostOnce == [](x => [](~x => []~x)) \\* G(x => G(~x => G~x))\0a\0aAtMostOnceEquiv == [](~x \\/ [](x \\/ []~x)) \\* G(~x \\/ G(x \\/ G~x))\0a\0aPostCondition ==\0a\09/\\ TLCSet(42, TLCGet("generated"))\0a\09/\\ ToTrace(CounterExample) = <<[x |-> FALSE], [x |-> TRUE], [x |-> FALSE], [x |-> TRUE]>>\0a\09/\\ CounterExample =\0a\09\09\09\09[ action |->\0a\09\09\09      { << <<1, [x |-> FALSE]>>,\0a\09\09\09           [ name |-> "Next",\0a\09\09\09             location |->\0a\09\09\09                 [ beginLine |-> 8,\0a\09\09\09                   beginColumn |-> 9,\0a\09\09\09                   endLine |-> 8,\0a\09\09\09                   endColumn |-> 22,\0a\09\09\09                   module |-> "Github710a" ] ],\0a\09\09\09           <<2, [x |-> TRUE]>> >>,\0a\09\09\09        << <<2, [x |-> TRUE]>>,\0a\09\09\09           [ name |-> "Next",\0a\09\09\09             location |->\0a\09\09\09                 [ beginLine |-> 8,\0a\09\09\09                   beginColumn |-> 9,\0a\09\09\09                   endLine |-> 8,\0a\09\09\09                   endColumn |-> 22,\0a\09\09\09                   module |-> "Github710a" ] ],\0a\09\09\09           <<3, [x |-> FALSE]>> >>,\0a\09\09\09        << <<3, [x |-> FALSE]>>,\0a\09\09\09           [ name |-> "Next",\0a\09\09\09             location |->\0a\09\09\09                 [ beginLine |-> 8,\0a\09\09\09                   beginColumn |-> 9,\0a\09\09\09                   endLine |-> 8,\0a\09\09\09                   endColumn |-> 22,\0a\09\09\09                   module |-> "Github710a" ] ],\0a\09\09\09           <<4, [x |-> TRUE]>> >> },\0a\09\09\09  state |->\0a\09\09\09      { <<1, [x |-> FALSE]>>,\0a\09\09\09        <<2, [x |-> TRUE]>>,\0a\09\09\09        <<3, [x |-> FALSE]>>,\0a\09\09\09        <<4, [x |-> TRUE]>> } ]\0a\0aFairSpec == \0a    /\\ Spec\0a    /\\ WF_x(Next)\0a\0aneg_AtMostOnce == ~(AtMostOnce)\0a\0aEventuallyFlipBack == (x = TRUE) ~> (x = FALSE)\0a\0aTautology == (vars = vars) ~> (vars = vars)\0a====\0a']]]
      ['Github710b' %accept ~[['Github710b' '---- MODULE Github710b ----\0aEXTENDS Naturals, TLC, TLCExt\0a\0aVARIABLE x\0avars == <<x>>\0a\0aInit == x = 1\0a\0aNext == x\' = x + 1\0a\0aSpec == \0a    /\\ Init\0a    /\\ [][Next]_vars\0a    \\* /\\ WF_x(Next)\0a\0aStateConstraint ==\0a    x < 5\0a\0aAtMostOnce == [](x > 1 => [](x > 2)) \\* violated by x = 2\0a\0aPostCondition ==\0a\09/\\ TLCSet(42, TLCGet("generated"))\0a\09/\\ ToTrace(CounterExample) = <<[x |-> 1], [x |-> 2]>>\0a\09/\\ CounterExample =\0a\09\09\09[ action |->\0a\09\09      { << <<1, [x |-> 1]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 9,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 9,\0a\09\09                   endColumn |-> 18,\0a\09\09                   module |-> "Github710b" ] ],\0a\09\09           <<2, [x |-> 2]>> >> },\0a\09\09  state |-> {<<1, [x |-> 1]>>, <<2, [x |-> 2]>>} ]\0a\09\09\09\0aTautology == (vars = vars) ~> (vars = vars)\0a====\0a']]]
      ['Github710d' %accept ~[['Github710d' '---- MODULE Github710d ----\0aEXTENDS Naturals\0aVARIABLE x\0a\0aInit == x = 0\0a\0aStep == x < 3 /\\ x\' = x + 1 \\* x <= 3 - see git commit msg.\0a\0aSpec == Init /\\ [][Step]_x\0a\0aFairSpec == Spec /\\ WF_x(Step)\0a\0aNeverThree == [](x = 1 => [](x # 3))\0a\0aneg_NeverThree == ~(NeverThree)\0a\0aEventuallyThree == <>(x = 3)\0a\0aTautology == (x = x) ~> (x = x)\0a====\0a']]]
