::  R1.3.5.2 subexpression-selector CST coverage for forms absent from the
::  pinned upstream corpus (test/tla2sany/corpus/subexpressions.txt): a
::  trailing `!(args)` (N_OpArgs as a general-id child), a mid-chain
::  operator-symbol selector `!op(args)!`, and a mid-chain `@` (N_StructOp).
::  Expected values are Java oracle (AstDump) output at the pinned commit.
/+  *test
/=  syntax  /lib/syntax
|%
++  test-aopargs
  =/  want=@t  'ACCEPT\0an-module 1.1-3.4\0a  n-beginmodule 1.1-1.18\0a    bm1 1.1-1.11 ---- MODULE\0a    identifier 1.13-1.13 M\0a    separator 1.15-1.18 ----\0a  n-extends ~ N_Extends\0a  n-body 2.1-2.18\0a    n-operatordefinition 2.1-2.18\0a      n-identlhs 2.1-2.1\0a        identifier 2.1-2.1 X\0a      def 2.3-2.4 ==\0a      n-generalid 2.6-2.18\0a        n-idprefix 2.6-2.15\0a          n-idprefixelement 2.6-2.15\0a            identifier 2.6-2.8 COp\0a            n-opargs 2.9-2.14\0a              lbr 2.9-2.9 (\0a              n-number 2.10-2.10\0a                number-literal 2.10-2.10 1\0a              comma 2.11-2.11 ,\0a              n-number 2.13-2.13\0a                number-literal 2.13-2.13 2\0a              rbr 2.14-2.14 )\0a            bang 2.15-2.15 !\0a        n-opargs 2.16-2.18\0a          lbr 2.16-2.16 (\0a          n-number 2.17-2.17\0a            number-literal 2.17-2.17 3\0a          rbr 2.18-2.18 )\0a  n-endmodule 3.1-3.4\0a    end-module 3.1-3.4 ===='
  %+  expect-eq  !>  want
    !>  `@t`(crip (zing (join "\0a" (turn (dump:syntax '---- MODULE M ----\0aX == COp(1, 2)!(3)\0a====\0a') trip))))
