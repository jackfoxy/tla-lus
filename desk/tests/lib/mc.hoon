::  GENERATED by tools/gen-mc-tests.py -- do not edit.
::  Expected values are normalized tlc2.TLC output at the pinned commit.
/+  *test
/=  check  /lib/check
|%
++  trim
  ::  drop blank lines; TLC's blank separators between trace states carry
  ::  no information and the captured golden has them removed
  |=  w=wain
  ^-  wain
  (skip w |=(l=@t =('' l)))
::
++  test-mc-alias
  %+  expect-eq
    !>  ^-  wain
    :~
        'Error: Invariant Inv is violated.'
        'Error: The behavior up to this point is:'
        'State 1: <Initial predicate>'
        '/\\ v = 0'
        '/\\ doubled = 0'
        '/\\ moved = TRUE'
        'State 2: <Next line 5, col 9 to line 5, col 27 of module spec>'
        '/\\ v = 1'
        '/\\ doubled = 2'
        '/\\ moved = TRUE'
        'State 3: <Next line 5, col 9 to line 5, col 27 of module spec>'
        '/\\ v = 2'
        '/\\ doubled = 4'
        '/\\ moved = FALSE'
        '3 states generated, 3 distinct states found, 0 states left on queue.'
        'The depth of the complete state graph search is 3.'
    ==
  !>
  %-  trim
  %+  check:check
    '---- MODULE spec ----\0aEXTENDS Naturals\0aVARIABLE x\0aInit == x = 0\0aNext == x < 3 /\\ x\' = x + 1\0aInv == x < 2\0aAlias == [ v |-> x, doubled |-> x * 2, moved |-> x\' # x ]\0a====\0a'
  'INIT Init\0aNEXT Next\0aINVARIANT Inv\0aALIAS Alias\0a'
