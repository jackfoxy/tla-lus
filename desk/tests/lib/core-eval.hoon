    ==
  !>
  %^  project-defs:check  '---- MODULE A ----\0aEXTENDS Integers\0aS == (1..2) \\X (1..2)\0aExT == \\E <<i, j>> \\in S : i = j\0aAllT == \\A <<i, j>> \\in S : i <= j\0aFiltT == {<<i, j>> \\in S : i = j}\0aMapT == {i + j : <<i, j>> \\in S}\0aChT == CHOOSE <<i, j>> \\in S : i = j\0aFcnT == [<<i, j>> \\in S |-> i * 10 + j]\0a====\0a'  ''
  ~['FcnT' 'FiltT' 'S']
::
