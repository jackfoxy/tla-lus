        "AllF BoolValue FALSE"
        "Cas StringValue \"b\""
        "Ch IntValue 5"
        "Cond StringValue \"y\""
        "Ex BoolValue TRUE"
        "ExF BoolValue FALSE"
    ==
  !>
  %^  project-defs:check  '---- MODULE A ----\0aEXTENDS Integers\0aAll == \\A x \\in 1..3 : x > 0\0aAllF == \\A x \\in 1..3 : x > 1\0aEx == \\E x \\in 1..5 : x * x = 16\0aExF == \\E x \\in 1..3 : x = 9\0aCh == CHOOSE x \\in 1..10 : x * x = 25\0aCond == IF 3 > 2 THEN "y" ELSE "n"\0aCas == CASE 1 = 2 -> "a" [] 1 = 1 -> "b" [] OTHER -> "c"\0a====\0a'  '\0a'
  ~
