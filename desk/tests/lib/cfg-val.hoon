    %-  malt
    ^-  (list [@t @t])
    :~
      :-  'A'
      '---- MODULE A ----\0aEXTENDS Naturals\0aCONSTANT Op(_)\0aVARIABLE x\0aInit == x = 0\0aNext == x\' = x + 1\0a====\0a'
    ==
  'CONSTANT\0aOp(1) = 2\0aOp(1, 2) = 3\0aINIT Init\0aNEXT Next\0a'
