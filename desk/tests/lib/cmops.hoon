::
++  bagsext-src
  '------------------------------ MODULE BagsExt ------------------------------\0a(***************************************************************************)\0a(* Additional operators on bags (multisets).                               *)\0a(*                                                                         *)\0a(* Bags represent multisets - collections where elements can appear        *)\0a(* multiple times. In TLA+, bags are represented as functions from         *)\0a(* elements to positive natural numbers, where bag[x] gives the            *)\0a(* multiplicity (count) of element x.                                      *)\0a(*                                                                         *)\0a(* This module extends the standard Bags module with:                      *)\0a(*   - Element manipulation (add, remove individual/all occurrences)       *)\0a(*   - Folding operations (generalized aggregation over bag elements)      *)\0a(*   - Arithmetic operations (sum, product of bag elements)                *)\0a(*                                                                         *)\0a(* Example bag representation:                                             *)\0a(*   The bag {| 1, 1, 2, 3, 3, 3 |} is represented as:                     *)\0a(*   (1 :> 2) @@ (2 :> 1) @@ (3 :> 3)                                      *)\0a(***************************************************************************)\0a\0aLOCAL INSTANCE Bags\0aLOCAL INSTANCE Integers\0aLOCAL INSTANCE Folds\0a\0a(***************************************************************************)\0a(* Add one occurrence of element x to bag B.                               *)\0a(*                                                                         *)\0a(* Increases the multiplicity of x by 1. If x is not in the bag,           *)\0a(* adds it with multiplicity 1.                                            *)\0a(*                                                                         *)\0a(* This is equivalent to B (+) SetToBag({x}.                               *)\0a(*                                                                         *)\0a(* Examples:                                                               *)\0a(*   BagAdd((1 :> 2) @@ (2 :> 1), 1) = (1 :> 3) @@ (2 :> 1)                *)\0a(*   BagAdd((1 :> 2) @@ (2 :> 1), 3) = (1 :> 2) @@ (2 :> 1) @@ (3 :> 1)    *)\0a(***************************************************************************)\0aBagAdd(B, x) ==\0a   IF x \\in DOMAIN B\0a   THEN [e \\in DOMAIN B |-> IF e=x THEN B[e]+1 ELSE B[e]]\0a   ELSE [e \\in DOMAIN B \\union {x} |-> IF e=x THEN 1 ELSE B[e]]\0a\0a(***************************************************************************)\0a(* Remove one occurrence of element x from bag B.                          *)\0a(*                                                                         *)\0a(* Decreases the multiplicity of x by 1. If x has multiplicity 1,          *)\0a(* removes it entirely from the bag. If x is not in the bag, equals        *)\0a(* the bag unchanged.                                                      *)\0a(*                                                                         *)\0a(* This is equivalent to B (-) SetToBag({x}).                              *)\0a(*                                                                         *)\0a(* Examples:                                                               *)\0a(*   BagRemove((1 :> 2) @@ (2 :> 1), 1) = (1 :> 1) @@ (2 :> 1)             *)\0a(*   BagRemove((1 :> 1) @@ (2 :> 1), 1) = (2 :> 1)                         *)\0a(*   BagRemove((1 :> 2) @@ (2 :> 1), 3) = (1 :> 2) @@ (2 :> 1)             *)\0a(***************************************************************************)\0aBagRemove(B,x) ==\0a   IF x \\in DOMAIN B\0a   THEN IF B[x] = 1\0a        THEN [e \\in DOMAIN B \\ {x} |-> B[e]]\0a        ELSE [e \\in DOMAIN B |-> IF e=x THEN B[e]-1 ELSE B[e]]\0a   ELSE B\0a\0a(***************************************************************************)\0a(* Remove all occurrences of element x from bag B.                         *)\0a(*                                                                         *)\0a(* Completely removes element x from the bag, regardless of its            *)\0a(* multiplicity. If x is not in the bag, returns the bag unchanged.        *)\0a(*                                                                         *)\0a(* Examples:                                                               *)\0a(*   BagRemoveAll((1 :> 3) @@ (2 :> 1), 1) = (2 :> 1)                      *)\0a(*   BagRemoveAll((1 :> 3) @@ (2 :> 1), 3) = (1 :> 3) @@ (2 :> 1)          *)\0a(***************************************************************************)\0aBagRemoveAll(B,x) ==\0a   [e \\in DOMAIN B \\ {x} |-> B[e]]\0a \0a(***********************************************************************)\0a(* Fold operation op over the images through f of all elements of bag  *)\0a(* B, starting from base. The parameter choose indicates the order in  *)\0a(* which elements of the bag are processed; all replicas of an element *)\0a(* are processed consecutively.                                        *)\0a(*                                                                     *)\0a(* Examples:                                                           *)\0a(*    MapThenFoldBag(LAMBDA x,y : x+y,                                 *)\0a(*                   0,                                                *)\0a(*                   LAMBDA x: 1,                                      *)\0a(*                   LAMBDA B : CHOOSE x \\in DOMAIN B : TRUE,          *)\0a(*                   (1 :> 2) @@ (2 :> 1) @@ (3 :> 3)) = 6             *)\0a(*                                                                     *)\0a(*    MapThenFoldBag(LAMBDA x,y : x \\o y,                              *)\0a(*                   << >>,                                            *)\0a(*                   LAMBDA x: << x >>,                                *)\0a(*                   LAMBDA S: CHOOSE x \\in S : \\A y \\in S : x <= y,   *)\0a(*                   (1 :> 2) @@ (2 :> 1) @@ (3 :> 3))                 *)\0a(*                 = <<1,1,2,3,3,3>>                                   *)\0a(*                                                                     *)\0a(*    The fifth argument represents the bag {| 1, 1, 2, 3, 3, 3 |}.    *)\0a(*    The first example counts the elements of the bag.                *)\0a(*    The second example computes a sorted sequence of all elements    *)\0a(*    of the bag. It is brittle because concatenation of sequences is  *)\0a(*    non-commutative, and the result therefore relies on the          *)\0a(*    definition of MapThenFoldSet.                                    *)\0a(***********************************************************************)\0a MapThenFoldBag(op(_,_), base, f(_), choose(_), B) ==\0a    LET handle(x) ==  \\* handle all occurrences of x in B\0a        LET pow[n \\in Nat \\ {0}] ==\0a            op(IF n=1 THEN base ELSE pow[n-1], f(x))\0a        IN  pow[B[x]]\0a    IN  MapThenFoldSet(op, base, handle,\0a                       LAMBDA S : CHOOSE x \\in S : TRUE,\0a                       DOMAIN B)\0a\0a(************************************************************************)\0a(* Fold op over all elements of bag B, starting with value base.        *)\0a(*                                                                      *)\0a(* Example:                                                             *)\0a(*    FoldBag(LAMBDA x,y : x+y,                                         *)\0a(*            0,                                                        *)\0a(*            (1 :> 2) @@ (2 :> 1) @@ (3 :> 3)) = 13                    *)\0a(*    The third argument represents the bag {| 1, 1, 2, 3, 3, 3 |}.     *)\0a(************************************************************************)\0aFoldBag(op(_,_), base, B) ==\0a   MapThenFoldBag(op, base, LAMBDA x: x, LAMBDA S : CHOOSE x \\in S : TRUE, B)\0a\0a(************************************************************************)\0a(* Compute the sum of the elements of B.                                *)\0a(************************************************************************)\0aSumBag(B) ==\0a   FoldBag(LAMBDA x,y : x+y, 0, B)\0a\0a(************************************************************************)\0a(* Compute the product of the elements of B.                            *)\0a(************************************************************************)\0aProductBag(B) ==\0a   FoldBag(LAMBDA x,y : x*y, 1, B)\0a\0a=============================================================================\0a'
::
++  bitwise-src
  '------------------------------- MODULE Bitwise -------------------------------\0aLOCAL INSTANCE Integers\0a\0a\\* https://en.wikipedia.org/wiki/Bitwise_operation#Mathematical_equivalents\0aRECURSIVE And(_,_,_,_)\0aLOCAL And(x,y,n,m) == \0a        LET exp == 2^n\0a        IN IF m = 0 \0a           THEN 0\0a           ELSE exp * ((x \\div exp) % 2) * ((y \\div exp) % 2) \0a                    + And(x,y,n+1,m \\div 2)\0a\0a(***************************************************************************)\0a(* Bitwise AND of (non-negative) x and y (defined for Nat \\cup {0}).       *)\0a(***************************************************************************)\0ax & y == \0a    IF x >= y THEN And(x, y, 0, x) ELSE And(y, x, 0, y) \\* Infix variant of And(x,y)\0a\0a-------------------------------------------------------------------------------\0a\0aRECURSIVE Or(_,_,_,_)\0aLOCAL Or(x,y,n,m) == \0a        LET exp == 2^n\0a            xdm == (x \\div exp) % 2\0a            ydm == (y \\div exp) % 2\0a        IN IF m = 0 \0a           THEN 0\0a           ELSE exp * (((xdm + ydm) + (xdm * ydm)) % 2)\0a                        + Or(x,y,n+1,m \\div 2)\0a\0a(***************************************************************************)\0a(* Bitwise OR of (non-negative) x and y (defined for Nat \\cup {0}).        *)\0a(***************************************************************************)\0ax | y == \0a    IF x >= y THEN Or(x, y, 0, x) ELSE Or(y, x, 0, y) \\* Infix variant of Or(x,y)\0a\0a-------------------------------------------------------------------------------\0a\0aRECURSIVE Xor(_,_,_,_)\0aLOCAL Xor(x,y,n,m) == \0a        LET exp == 2^n\0a        IN IF m = 0 \0a           THEN 0\0a           ELSE exp * (((x \\div exp) + (y \\div exp)) % 2) \0a                    + Xor(x,y,n+1,m \\div 2)\0a\0a(***************************************************************************)\0a(* Bitwise XOR of (non-negative) x and y (defined for Nat \\cup {0}).       *)\0a(***************************************************************************)\0ax ^^ y ==   \\* single "^" already taken by Naturals.tla\0a    IF x >= y THEN Xor(x, y, 0, x) ELSE Xor(y, x, 0, y) \\* Infix variant of Xor(x,y)\0a\0a-------------------------------------------------------------------------------\0a\0aRECURSIVE NotR(_,_,_)\0aLOCAL NotR(x,n,m) == \0a    LET exp == 2^n\0a        xdm == (x \\div exp) % 2\0a    IN IF m = 0 \0a        THEN 0\0a        ELSE exp * ((xdm + 1) % 2)\0a                    + NotR(x,n+1,m \\div 2)\0a\0a(***************************************************************************)\0a(* Bitwise NOT of (non-negative) x (defined for Nat \\cup {0}).             *)\0a(***************************************************************************)\0aNot(a) ==\0a    NotR(a,0,a)\0a\0a-------------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Logical bit-shifting the (non-negative) n by pos positions to the right *)\0a(* shifting zeros in from the left/MSB (defined for Nat \\cup {0}).         *)\0a(***************************************************************************)\0aRECURSIVE shiftR(_,_)\0ashiftR(n,pos) == \0a    IF pos = 0 \0a    THEN n\0a    ELSE LET odd(z) == z % 2 = 1\0a             m == IF odd(n) THEN (n-1) \\div 2 ELSE n \\div 2\0a         IN shiftR(m, pos - 1)\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Thu April 25 10:56:12 CEST 2018 by markus\0a\\* Created Mon May 16 15:09:18 CEST 2016 by markus\0a'
::
++  dyadicrationals-src
  '-------------------------- MODULE DyadicRationals ---------------------------\0a\\* https://en.wikipedia.org/wiki/Dyadic_rational\0aLOCAL INSTANCE FiniteSets\0aLOCAL INSTANCE Integers\0aLOCAL INSTANCE Sequences\0aLOCAL INSTANCE FiniteSetsExt\0aLOCAL INSTANCE TLC\0a\0aLOCAL Divides(p, q) == \0a    \\E d \\in 1..q : q = p * d\0a\0aLOCAL Divisors(q) ==\0a    {d \\in 1..q : Divides(d, q)}\0a\0aLOCAL GCD(n, m) ==\0a    Max(Divisors(n) \\cap Divisors(m))\0a\0a------------------------------------------------------------------------------\0a\0aLOCAL Rational(num, den) ==\0a    [num |-> num, den |-> den]\0a\0aLOCAL Reduce(p) ==\0a    LET gcd == GCD(p.num, p.den)\0a    IN  IF gcd = 1 THEN p\0a        ELSE Rational(p.num \\div gcd, p.den \\div gcd)\0a\0aIsDyadicRational(r) ==\0a    \\E i \\in 0..r.den: 2^i = r.den \0a\0aZero == Rational(0,1)\0a\0aOne == Rational(1,1)\0a\0aAdd(p, q) ==\0a    IF p = Zero THEN q ELSE\0a    LET lcn == Max({p.den, q.den}) \\* shortcut because dyadic!\0a        qq == Rational(q.num * (lcn \\div q.den), q.den * (lcn \\div q.den))\0a        pp == Rational(p.num * (lcn \\div p.den), p.den * (lcn \\div p.den))\0a    IN Reduce(Rational(qq.num + pp.num, lcn))\0a\0aHalf(p) ==\0a    Reduce(Rational(p.num, p.den * 2))\0a\0aPrettyPrint(p) ==\0a    IF p = Zero THEN "0" ELSE\0a    IF p = One THEN "1" ELSE\0a    ToString(p.num) \\o "/" \\o ToString(p.den)\0a\0a===============================================================================\0a\\* Modification History\0a\\* Last modified Mon Dec 27 17:52:54 PST 2021 by Markus Kuppe\0a\\* Created Sun Dec 26 01:36:40 PDT 2021 by Markus Kuppe'
::
++  finitesetsext-src
  '--------------------------- MODULE FiniteSetsExt ---------------------------\0aEXTENDS Integers, FiniteSets, Folds, Functions \\* Replace with LOCAL INSTANCE when https://github.com/tlaplus/tlapm/issues/119 is resolved.\0a\\* LOCAL INSTANCE Integers\0a\\* LOCAL INSTANCE FiniteSets\0a\0a(*************************************************************************)\0a(* Fold op over the elements of set using base as starting value.        *)\0a(*                                                                       *)\0a(* Example:                                                              *)\0a(*         FoldSet(LAMBA x,y : x + y, 0, 0 .. 10) = 55                   *)\0a(*************************************************************************)\0aFoldSet(op(_,_), base, set) ==\0a   MapThenFoldSet(op, base, LAMBDA x : x, LAMBDA s : CHOOSE x \\in s : TRUE, set)\0a\0a(*************************************************************************)\0a(* Calculate the sum of the elements in set.                             *)\0a(*                                                                       *)\0a(* Example:                                                              *)\0a(*         SumSet(0 .. 10) = 55                                          *)\0a(*************************************************************************)\0aSumSet(set) ==\0a   FoldSet(+, 0, set)\0a\0a(*************************************************************************)\0a(* Calculuate the product of the elements in set.                        *)\0a(*                                                                       *)\0a(* Example:                                                              *)\0a(*         ProductSet(1 .. 3) = 6                                        *)\0a(*************************************************************************)\0aProductSet(set) ==\0a   FoldSet(LAMBDA x, y: x * y, 1, set)\0a\0a(*************************************************************************)\0a(* An alias for FoldSet. ReduceSet was used instead of FoldSet in        *)\0a(* earlier versions of the community modules.                            *)\0a(*************************************************************************)\0aReduceSet(op(_, _), set, acc) == \0a   FoldSet(op, acc, set)\0a\0a(*************************************************************************)\0a(* Calculate the sum of projections of the elements in a set.            *)\0a(*                                                                       *)\0a(* Example:                                                              *)\0a(*         MapThenSumSet(                                                *)\0a(*             LAMBDA e : e.n,                                           *)\0a(*             {[n |-> 0], [n |-> 1], [n |-> 2]}                         *)\0a(*         ) = 3                                                         *)\0a(*************************************************************************)\0aMapThenSumSet(op(_), set) ==\0a   MapThenFoldSet(+, 0, op, LAMBDA s : CHOOSE x \\in s : TRUE, set)\0a\0a(***************************************************************************)\0a(* Flattens a set of sets into a single set containing all elements.       *)\0a(*                                                                         *)\0a(* This is equivalent to TLA+ UNION operator.                              *)\0a(*                                                                         *)\0a(* NOTE: Use UNION directly instead of this operator. FlattenSet is only   *)\0a(* kept for backward compatibility.                                        *)\0a(*                                                                         *)\0a(* Example:                                                                *)\0a(*   FlattenSet({{1,2}, {2,3}, {4}}) = {1,2,3,4}                           *)\0a(*   FlattenSet({}) = {}                                                   *)\0a(*   FlattenSet({{}}) = {}                                                 *)\0a(***************************************************************************)\0aFlattenSet(S) ==\0a   UNION S\0a\0a(***************************************************************************)\0a(* The symmetric difference of two sets.                                   *)\0a(*                                                                         *)\0a(* The symmetric difference of sets A and B contains elements that are     *)\0a(* in exactly one of A or B, but not in both. This is equivalent to        *)\0a(* (A ∪ B) \\ (A ∩ B).                                                      *)\0a(*                                                                         *)\0a(* Examples:                                                               *)\0a(*   SymDiff({1,2,3}, {2,3,4}) = {1,4}                                     *)\0a(*   SymDiff({1,2}, {3,4}) = {1,2,3,4}                                     *)\0a(*   SymDiff({1,2}, {1,2}) = {}                                            *)\0a(***************************************************************************)\0aSymDiff(A, B) == (A \\ B) \\cup (B \\ A)\0a\0a-----------------------------------------------------------------------------\0a\0a(*************************************************************************)\0a(* Quantify the elements in S matching the predicate (LAMDBA) P.         *)\0a(*                                                                       *)\0a(* This operator is overridden by FiniteSetsExt#quantify whose           *)\0a(* implementation does *not* enumerate the intermediate set! This is     *)\0a(* the only advantage that Quantify(...) has over Cardinality(...).      *)\0a(*                                                                       *)\0a(* Example:                                                              *)\0a(*          Quantify(1..9, LAMBDA n : n % 2 = 0) = 4                     *)\0a(*************************************************************************)\0aQuantify(S, P(_)) ==\0a   Cardinality({s \\in S : P(s)})\0a\0a-----------------------------------------------------------------------------\0a\0a(*************************************************************************)\0a(* A k-subset ks of a set S has Cardinality(ks) = k.  The number of      *)\0a(* k-subsets of a set S with Cardinality(S) = n is given by the binomial *)\0a(* coefficients n over k.  A set S with Cardinality(S) = n has 2^n       *)\0a(* k-subsets.  \\A k \\notin 0..Cardinality(S): kSubset(k, S) = {}.        *)\0a(*                                                                       *)\0a(* This operator is overridden by FiniteSetsExt#kSubset whose            *)\0a(* implementation, contrary to  { s \\in SUBSET S : Cardinality(s) = k }, *)\0a(* only enumerates the k-subsets of S and not all subsets.               *)\0a(*                                                                       *)\0a(* Example:                                                              *)\0a(*          kSubset(2, 1..3) = {{1,2},{2,3},{3,1}}                       *)\0a(*************************************************************************)\0akSubset(k, S) == \0a   { s \\in SUBSET S : Cardinality(s) = k }\0a\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* We define Max(S) and Min(S) to be the maximum and minimum,              *)\0a(* respectively, of a finite, non-empty set S of integers.                 *)\0a(***************************************************************************)\0aMax(S) == CHOOSE x \\in S : \\A y \\in S : x >= y\0aMin(S) == CHOOSE x \\in S : \\A y \\in S : x =< y\0a\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Compute all possible choice sets from a collection of sets.             *)\0a(*                                                                         *)\0a(* Given a collection of sets, this operator equals all possible sets      *)\0a(* that can be formed by choosing exactly one element from each input set. *)\0a(* This is related to the Cartesian product.                               *)\0a(*                                                                         *)\0a(* The implementation uses choice functions: functions that map each       *)\0a(* input set to one of its elements. The range of each such function       *)\0a(* gives us one possible choice set.                                       *)\0a(*                                                                         *)\0a(* Examples:                                                               *)\0a(*   Choices({{1,2}, {3}}) = {{1,3}, {2,3}}                                *)\0a(*   Choices({{1,2}, {2,3}, {5}}) =                                        *)\0a(*     {{1,2,5}, {1,3,5}, {2,3,5}, {2,5}}                                  *)\0a(*     (Note: {2,5} appears because we choose 2 from both sets)            *)\0a(*   Choices({}) = {{}}  (empty choice from empty collection)              *)\0a(***************************************************************************)\0aChoices(Sets) == LET ChoiceFunction(Ts) == { f \\in [Ts -> UNION Ts] : \0a                                               \\A T \\in Ts : f[T] \\in T }\0a                 IN  { Range(f) : f \\in ChoiceFunction(Sets) }\0a\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Chooses unique element from the input set matching the predicate        *)\0a(* (LAMDBA) P.                                                             *)\0a(*                                                                         *)\0a(* Contrary to CHOOSE, fails with                                          *)\0a(*      "CHOOSE x \\\\in S: P, but no element of S satisfied P:              *)\0a(* not just if P(_) holds for none of the elements in S, but also if       *)\0a(* P(_) holds for more than one element in S.                              *)\0a(*                                                                         *)\0a(* Example:                                                                *)\0a(*          ChooseUnique({2, 3, 4, 5}, LAMBDA x : x % 3 = 1) = 4           *)\0a(*                                                                         *)\0a(***************************************************************************)\0aChooseUnique(S, P(_)) == CHOOSE x \\in S :\0a                              P(x) /\\ \\A y \\in S : P(y) => y = x\0a\0a=============================================================================\0a'
::
++  folds-src
  '------------------------------- MODULE Folds -------------------------------\0a(***************************************************************************)\0a(* This module provides a general framework for folding operations over    *)\0a(* sets with flexible element selection and transformation.                *)\0a(*                                                                         *)\0a(* The main operator MapThenFoldSet is the foundation for many other       *)\0a(* folding operations found in:                                            *)\0a(*   - FiniteSetsExt.FoldSet (simplified for sets)                         *)\0a(*   - Functions.FoldFunction (specialized for functions)                  *)\0a(*   - SequencesExt.FoldSeq (specialized for sequences)                    *)\0a(*                                                                         *)\0a(***************************************************************************)\0a\0aMapThenFoldSet(op(_,_), base, f(_), choose(_), S) ==\0a(******************************************************************************)\0a(* Starting from base, apply op to f(x), for all x \\in S, by choosing the set *)\0a(* elements with `choose`. If there are multiple ways for choosing an element,*)\0a(* op should be associative and commutative. Otherwise, the result may depend *)\0a(* on the concrete implementation of `choose`.                                *)\0a(*                                                                            *)\0a(* FoldSet, a simpler version for sets is contained in FiniteSetsEx.          *)\0a(* FoldFunction, a simpler version for functions is contained in Functions.   *)\0a(* FoldSequence, a simpler version for sequences is contained in SequencesExt.*)\0a(*                                                                            *)\0a(* Example:                                                                   *)\0a(*                                                                            *)\0a(*  MapThenFoldSet(LAMBDA x,y: x \\cup y,                                      *)\0a(*                 {},                                                        *)\0a(*                 LAMBDA x: {{x}},                                           *)\0a(*                 LAMBDA set: CHOOSE x \\in set: TRUE,                        *)\0a(*                 {1,2})                                                     *)\0a(*       = {{1},{2}}                                                          *)\0a(******************************************************************************)\0a  LET iter[s \\in SUBSET S] ==\0a        IF s = {} THEN base\0a        ELSE LET x == choose(s)\0a             IN  op(f(x), iter[s \\ {x}])\0a  IN  iter[S]\0a\0a\0a=============================================================================\0a'
::
++  functions-src
  '------------------------------ MODULE Functions -----------------------------\0a(***************************************************************************)\0a(* `^{\\large\\bf \\vspace{12pt}                                              *)\0a(*  Notions about functions including injection, surjection, and bijection.*)\0a(*  Originally contributed by Tom Rodeheffer, MSR.                         *)\0a(*  \\vspace{12pt}}^\'                                                       *)\0a(***************************************************************************)\0a\0aEXTENDS Integers, Folds\0a\0a(***************************************************************************)\0a(* Restriction of a function to a set (should be a subset of the domain).  *)\0a(***************************************************************************)\0aRestrict(f,S) == [ x \\in S |-> f[x] ]\0a\0a(***************************************************************************)\0a(* Restriction of a function to the subset of its domain satisfying a      *)\0a(* test predicate.                                                         *)\0a(*                                                                         *)\0a(* Example:                                                                *)\0a(*   (LET f == (0 :> "a" @@ 1 :> "b" @@ 2 :> "c")                          *)\0a(*    IN  RestrictDomain(f, LAMBDA x : x \\in {0,2}))                       *)\0a(*   = (0 :> "a" @@ 2 :> "c")                                              *)\0a(***************************************************************************)\0aRestrictDomain(f, Test(_)) == Restrict(f, {x \\in DOMAIN f : Test(x)})\0a\0a(***************************************************************************)\0a(* Restriction of a function to the subset of its domain for which the     *)\0a(* function values satisfy a test predicate.                               *)\0a(*                                                                         *)\0a(* Example:                                                                *)\0a(*   (LET f == ("a" :> 0 @@ "b" :> 1 @@ "c" :> 2)                          *)\0a(*    IN  RestrictValues(f, LAMBDA y : y \\in {0,2}))                       *)\0a(*   = ("a" :> 0 @@ "b" :> 2)                                              *)\0a(*                                                                         *)\0a(* This is similar to the operator SelectSeq from the standard Sequences   *)\0a(* module and related to standard "filter" functions in functional         *)\0a(* programming. However, SelectSeq produces sequences, whereas             *)\0a(* RestrictValues will in general not. For example,                        *)\0a(*                                                                         *)\0a(*   RestrictValues([0,1,2], LAMBDA y : y \\in {0,2})                       *)\0a(*   = (1 :> 0 @@ 3 :> 2)                                                  *)\0a(***************************************************************************)\0aRestrictValues(f, Test(_)) ==\0a  LET S == {x \\in DOMAIN f : Test(f[x])}\0a  IN  Restrict(f, S)\0a\0a(***************************************************************************)\0a(* Check if a function narrow is a restriction of a function wide, i.e.    *)\0a(* Is the domain of narrow a subset of that of wide, and does the          *)\0a(* projection of wide on the domain of narrow have the same image as       *)\0a(* narrow does.                                                            *)\0a(*                                                                         *)\0a(* Examples:                                                               *)\0a(*   IsRestriction([one |-> 1], [one |-> 1, two |-> 2])                    *)\0a(*   IsRestriction([one |-> 1], [one |-> 1])                               *)\0a(*  ~IsRestriction([one |-> 1, two |-> 2], [one |-> 1, two |-> 3])         *)\0a(*  ~IsRestriction([one |-> 1], [2 |-> two])                               *)\0a(*  ~IsRestriction([one |-> 1, two |-> 2], [two |-> 2])                    *)\0a(***************************************************************************)\0aIsRestriction(narrow, wide) ==\0a    /\\ DOMAIN narrow \\subseteq DOMAIN wide \0a    /\\ \\A x \\in DOMAIN narrow \\intersect DOMAIN wide: narrow[x] = wide[x]\0a\0a(***************************************************************************)\0a(* Range of a function.                                                    *)\0a(* Note: The image of a set under function f can be defined as             *)\0a(*       Range(Restrict(f,S)).                                             *)\0a(***************************************************************************)\0aRange(f) == { f[x] : x \\in DOMAIN f }\0a\0a(***************************************************************************)\0a(* Assuming DOMAIN f \\subseteq DOMAIN g, apply the binary operation T to   *)\0a(* the corresponding elements of the two functions f and g.                *)\0a(*                                                                         *)\0a(* Example:                                                                *)\0a(*   LET f == ("a" :> 0 @@ "b" :> 1 @@ "c" :> 2)                           *)\0a(*       g == ("a" :> 1 @@ "b" :> 1 @@ "c" :> 3)                           *)\0a(*   IN Pointwise(f,g,+) = ("a" :> 1 @@ "b" :> 2 @@ "c" :> 5 )             *)\0a(***************************************************************************)\0aPointwise(f, g, T(_,_)) == [ e \\in DOMAIN f |-> T(f[e], g[e]) ]\0a\0a(***************************************************************************)\0a(* The inverse of a function.                                              *)\0a(* Example:                                                                *)\0a(*    LET f == ("a" :> 0 @@ "b" :> 1 @@ "c" :> 2)                          *)\0a(*    IN Inverse(f, DOMAIN f, Range(f)) =                                  *)\0a(*                                 (0 :> "a" @@ 1 :> "b" @@ 2 :> "c")      *)\0a(* Example:                                                                *)\0a(*    LET f == ("a" :> 0 @@ "b" :> 1 @@ "c" :> 2)                          *)\0a(*    IN Inverse(f, DOMAIN f, {1,3}) =                                     *)\0a(*                                 1 :> "b" @@ 3 :> "a")                   *)\0a(***************************************************************************)\0aInverse(f,S,T) == [t \\in T |-> CHOOSE s \\in S : t \\in Range(f) => f[s] = t]\0a\0a(***************************************************************************)\0a(* The inverse of a function.                                              *)\0a(***************************************************************************)\0aAntiFunction(f) == Inverse(f, DOMAIN f, Range(f))\0a\0a(***************************************************************************)\0a(* A function is injective iff it maps each element in its domain to a     *)\0a(* distinct element.                                                       *)\0a(*                                                                         *)\0a(* This definition is overridden by TLC in the Java class Functions.java   *)\0a(* The operator is overridden by the Java method with the same name.       *)\0a(***************************************************************************)\0aIsInjective(f) == \\A a,b \\in DOMAIN f : f[a] = f[b] => a = b\0a\0a(***************************************************************************)\0a(* Set of injections between two sets.                                     *)\0a(***************************************************************************)\0aInjection(S,T) == { M \\in [S -> T] : IsInjective(M) }\0a\0a\0a(***************************************************************************)\0a(* A map is a surjection iff for each element in the range there is some   *)\0a(* element in the domain that maps to it.                                  *)\0a(***************************************************************************)\0aSurjection(S,T) == { M \\in [S -> T] : \\A t \\in T : \\E s \\in S : M[s] = t }\0a\0a\0a(***************************************************************************)\0a(* A map is a bijection iff it is both an injection and a surjection.      *)\0a(***************************************************************************)\0aBijection(S,T) == Injection(S,T) \\cap Surjection(S,T)\0a\0a\0a(***************************************************************************)\0a(* An injection, surjection, or bijection exists if the corresponding set  *)\0a(* is nonempty.                                                            *)\0a(***************************************************************************)\0aExistsInjection(S,T)  == Injection(S,T) # {}\0aExistsSurjection(S,T) == Surjection(S,T) # {}\0aExistsBijection(S,T)  == Bijection(S,T) # {}\0a\0a--------------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Applies the binary operator op on the elements f[i] for i \\in indices,  *)\0a(* a subset of DOMAIN f, in an unspecified order, starting from value      *)\0a(* base. The result is                                                     *)\0a(*    op(f[i],op(f[j], ..., op(f[k],base) ...))                            *)\0a(* where i,j,k range over the sets indices.                                *)\0a(*                                                                         *)\0a(* op should be associative and commutative, because we can not assume a   *)\0a(* particular ordering of i, j, and k                                      *)\0a(*                                                                         *)\0a(* Example:                                                                *)\0a(*  FoldFunctionOnSet(LAMBDA x,y: {x} \\cup y, {}, <<1,2>>, {}) = {}        *)\0a(***************************************************************************)\0aFoldFunctionOnSet(op(_,_), base, fun, indices) ==\0a  MapThenFoldSet(op, base, LAMBDA i : fun[i], LAMBDA s: CHOOSE x \\in s : TRUE, indices)\0a\0a(***************************************************************************)\0a(* Special case of the above where indices = DOMAIN fun. In other words,   *)\0a(* the values f[i] for all i \\in DOMAIN fun, are combined using the binary *)\0a(* operator op, in an unspecified order.                                   *)\0a(*                                                                         *)\0a(* Example:                                                                *)\0a(*  FoldFunction(LAMBDA x,y: {x} \\cup y, {}, <<1,2,1>>) = {1,2}            *)\0a(***************************************************************************)\0aFoldFunction(op(_,_), base, fun) ==\0a  FoldFunctionOnSet(op, base, fun, DOMAIN fun)\0a\0a(***************************************************************************)\0a(* Sum the values f[i] for i \\in indices, a subset of DOMAIN f.            *)\0a(*                                                                         *)\0a(* Example:                                                                *)\0a(*  SumFunctionOnSet(<<4,5,6>>, {1,2}) = 9                                 *)\0a(*  SumFunction(<<4,5,6>>) = 15                                            *)\0a(***************************************************************************)\0aSumFunctionOnSet(fun, indices) == FoldFunctionOnSet(+, 0, fun, indices)\0aSumFunction(fun) == SumFunctionOnSet(fun, DOMAIN fun)\0a\0a=============================================================================\0a\\* Created Thu Apr 11 10:30:48 PDT 2013 by tomr\0a'
::
++  ioutils-src
  '------------------------------ MODULE IOUtils ------------------------------\0a(***************************************************************************)\0a(* This module provides operators for input/output operations and          *)\0a(* external process execution. All operators are overridden by Java        *)\0a(* implementations that perform the actual I/O operations.                 *)\0a(*                                                                         *)\0a(* The module enables TLA+ specifications to:                              *)\0a(*   - Execute external commands and capture their output                  *)\0a(*   - Serialize/deserialize TLA+ values to/from files                     *)\0a(*   - Access environment variables                                        *)\0a(*   - Interface with external systems during model checking               *)\0a(*                                                                         *)\0a(* Note: Some operators in this module evaluate to TRUE in TLA+ but        *)\0a(* perform side effects when executed by TLC with the Java overrides.      *)\0a(***************************************************************************)\0a\0aLOCAL INSTANCE TLC\0aLOCAL INSTANCE Integers\0aLOCAL INSTANCE Sequences\0aLOCAL INSTANCE SequencesExt\0a  (*************************************************************************)\0a  (* Imports the definitions from the modules, but doesn\'t export them.    *)\0a  (*************************************************************************)\0a\0a(***************************************************************************)\0a(* Serializes the given value to the file in Java\'s object serialization   *)\0a(* format.                                                                 *)\0a(*                                                                         *)\0a(* Parameters:                                                             *)\0a(*   - val: The TLA+ value to serialize                                    *)\0a(*   - absoluteFilename: Absolute path to the output file                  *)\0a(*   - compress: Boolean indicating whether to compress the output         *)\0a(***************************************************************************)\0aIOSerialize(val, absoluteFilename, compress) == TRUE\0a\0a(***************************************************************************)\0a(* Deserializes a TLA+ value from a file in Java\'s object serialization    *)\0a(* format.                                                                 *)\0a(*                                                                         *)\0a(* Parameters:                                                             *)\0a(*   - absoluteFilename: Absolute path to the input file                   *)\0a(*   - compressed: Boolean indicating whether the file is compressed       *)\0a(*                                                                         *)\0a(* Returns the deserialized TLA+ value.                                    *)\0a(***************************************************************************)\0aIODeserialize(absoluteFilename, compressed) == CHOOSE val : TRUE\0a\0a(*******************************************************************************)\0a(* value: TLA+ value to be serialized.                                         *)\0a(* dest: Destination to serialize to such as a file or URL.                    *)\0a(* options: Record of serializer-specific options with format mandatory to     *)\0a(* identify a serializer.  Read a seriazlier\'s documentation for serializer-   *)\0a(* specific options.                                                           *)\0a(*******************************************************************************)\0aSerialize(value, dest, options) ==\0a  CHOOSE r \\in [exitValue : Int, stdout : STRING, stderr : STRING] : TRUE\0a\0a(*******************************************************************************)\0a(* src: Destination to serialize to such as a file or URL.                     *)\0a(* options: Record of serializer-specific options with format mandatory to     *)\0a(* identify a serializer.  Read a seriazlier\'s documentation for serializer-   *)\0a(* specific options.                                                           *)\0a(*******************************************************************************)\0aDeserialize(src, options) ==\0a  CHOOSE val : TRUE\0a\0a----------------------------------------------------------------------------\0a\0a(*******************************************************************************)\0a(* Spawns the given command as a sub-process of TLC.  The sequence of sequence *)\0a(* of strings `command\' signifies the external program file to be invoked and  *)\0a(* its arguments:                                                              *)\0a(*     IOExec(<<"ls", "-lah", "/tmp">>)                                        *)\0a(*     IOExec(<<"bash", "-c", "echo \\"Col1#Col2\\" > /tmp/out.csv">>            *)\0a(* see https://docs.oracle.com/javase/7/docs/api/java/lang/ProcessBuilder.html *)\0a(*******************************************************************************)\0aIOExec(command) ==\0a  CHOOSE r \\in [exitValue : Int, stdout : STRING, stderr : STRING] : TRUE\0a\0a(*******************************************************************************)\0a(* See IOExec                                                                  *)\0a(*     LET ENV = {<<"Var1", "SomeVal">>, <<"Var2", 42>>}                       *)\0a(*     IN IOEnvExec(ENV, <<"ls", "-lah", "/tmp">>)                             *)\0a(*******************************************************************************)\0aIOEnvExec(env, command) ==\0a  CHOOSE r \\in [exitValue : Int, stdout : STRING, stderr : STRING] : TRUE\0a\0a(*************************************************************************)\0a(* Spawns the given printf-style command as a sub-process of TLC.  The   *)\0a(* n-th flag in `commandTemplate\' is substituted with the n-th element   *)\0a(* of the sequence `parameters\':                                         *)\0a(*     IOExecTemplate(<<"ls", "%s" "%s">>, <<"-lah", "/tmp">>)           *)\0a(*     IOExecTemplate(<<"ls %1$s %2$s">>, <<"-lah", "/tmp">>)            *)\0a(* see http://docs.oracle.com/javase/7/docs/api/java/util/Formatter.html *)\0a(*************************************************************************)\0aIOExecTemplate(commandTemplate, parameters) ==\0a  CHOOSE r \\in [exitValue : Int, stdout : STRING, stderr : STRING] : TRUE\0a\0a(*******************************************************************************)\0a(* See IOExecTemplate                                                          *)\0a(*     LET ENV = {<<"Var1", "SomeVal">>, <<"Var2", 42>>}                       *)\0a(*     IN IOEnvExecTemplate(ENV, <<"ls", "-lah", "/tmp">>)                     *)\0a(*******************************************************************************)\0aIOEnvExecTemplate(env, commandTemplate, parameters) ==\0a  CHOOSE r \\in [exitValue : Int, stdout : STRING, stderr : STRING] : TRUE\0a\0a(*************************************************************************)\0a(* The process\' environment variables.                                   *)\0a(*************************************************************************)\0aIOEnv ==\0a  CHOOSE r \\in [STRING -> STRING] : TRUE\0a\0a(***************************************************************************)\0a(* Converts a string representation of a number to a number.               *)\0a(*                                                                         *)\0a(* This is useful for processing environment variables or command output   *)\0a(* that contains numeric values as strings.                                *)\0a(*                                                                         *)\0a(* Examples:                                                               *)\0a(*   atoi("42") = 42                                                       *)\0a(*   atoi("-17") = -17                                                     *)\0a(*   atoi("0") = 0                                                         *)\0a(*                                                                         *)\0a(* Usage with environment variables:                                       *)\0a(*   Assuming environment variable PORT is set to "8080":                  *)\0a(*   atoi(IOEnv.PORT) = 8080                                               *)\0a(***************************************************************************)\0aatoi(str) ==\0a  CHOOSE i \\in Int : ToString(i) = str\0a\0a(***************************************************************************)\0a(* Pads a natural number with leading zeros to achieve a specified width.  *)\0a(*                                                                         *)\0a(* This function converts a natural number to a string and pads it with    *)\0a(* leading zeros if necessary to reach the specified width. If the         *)\0a(* number\'s string representation is already equal to or longer than the   *)\0a(* specified width, no padding is added.                                   *)\0a(*                                                                         *)\0a(* Parameters:                                                             *)\0a(*   - n: The natural number to be padded (must be >= 0)                   *)\0a(*   - width: The desired total width of the resulting string              *)\0a(*                                                                         *)\0a(* Examples:                                                               *)\0a(*   zeroPadN(42, 5) = "00042"                                             *)\0a(*   zeroPadN(123, 3) = "123"                                              *)\0a(*   zeroPadN(7, 1) = "7"                                                  *)\0a(*   zeroPadN(0, 4) = "0000"                                               *)\0a(*                                                                         *)\0a(* Note: Negative numbers are not supported and may produce unexpected     *)\0a(* results.                                                                *)\0a(*                                                                         *)\0a(* Returns a sequence of characters representing the zero-padded number.   *)\0a(***************************************************************************)\0azeroPadN(n, width) ==\0a    LET s == ToString(n)\0a        padLen == width - Len(s)\0a        zeros == [i \\in 1..padLen |-> "0"]\0a    IN FoldLeft(LAMBDA acc, z: acc \\o z, "", zeros) \\o s\0a============================================================================\0a'
::
++  svg-src
  '----------------------------- MODULE SVG -----------------------------\0aLOCAL INSTANCE Naturals\0aLOCAL INSTANCE Sequences\0aLOCAL INSTANCE Integers\0aLOCAL INSTANCE TLC\0aLOCAL INSTANCE FiniteSets\0a\0a(******************************************************************************)\0a(* Helper Operators                                                           *)\0a(******************************************************************************)\0a\0aLOCAL Merge(r1, r2) == \0a    (**************************************************************************)\0a    (* Merge two records.                                                     *)\0a    (*                                                                        *)\0a    (* If a field appears in both records, then the value from \'r1\' is kept.  *)\0a    (**************************************************************************)\0a    LET D1 == DOMAIN r1 \0a        D2 == DOMAIN r2 IN\0a    [k \\in (D1 \\cup D2) |-> IF k \\in D1 THEN r1[k] ELSE r2[k]]\0a\0a(**************************************************************************)\0a(* SVG element constructor.                                               *)\0a(*                                                                        *)\0a(* An SVG element like:                                                   *)\0a(*                                                                        *)\0a(* [name |-> "elem", attrs |-> [k1 |-> "0", k2 |-> "1"], children |->     *)\0a(* <<>>, innerText |-> ""]                                                *)\0a(*                                                                        *)\0a(* would represent the SVG element \'<elem k1="0" k2="1"></elem>\'          *)\0a(**************************************************************************)\0aSVGElem(_name, _attrs, _children, _innerText) == \0a    [name       |-> _name, \0a     attrs      |-> _attrs, \0a     children   |-> _children,\0a     innerText  |-> _innerText ]\0a\0a(******************************************************************************)\0a(*                                                                            *)\0a(* Core Graphic Elements.                                                     *)\0a(*                                                                            *)\0a(* These primitives are TLA+ wrappers around SVG elements.  We base them on   *)\0a(* SVG since it is a widely used format and provides good features for        *)\0a(* representing and laying out vector graphics.  Each primitive below should  *)\0a(* roughly correspond to a standard SVG element type.  We represent a graphic *)\0a(* element as a record with the fields \'name\', \'attrs\', \'children\', and       *)\0a(* \'innerText\'.  \'name\' is the name of the SVG element, \'attrs\' is a record   *)\0a(* mapping SVG attribute names to values, \'children\' is a tuple containing    *)\0a(* any children elements, and \'innerText\' is a string that represents any raw *)\0a(* text that is contained directly inside the SVG element.  The \'innerText\'   *)\0a(* field is only meaningful for text elements.                                *)\0a(*                                                                            *)\0a(* All elements accept an \'attrs\' argument, which must be a function mapping  *)\0a(* string keys to string values.  These key-value pairs describe any          *)\0a(* additional SVG attributes of the element.  To pass no attributes, just     *)\0a(* pass attrs=<<>>.                                                           *)\0a(*                                                                            *)\0a(******************************************************************************)\0a\0a(**************************************************************************)\0a(* Line element.  \'x1\', \'y1\', \'x2\', and \'y2\' should be given as integers. *)\0a(**************************************************************************)\0aLine(x1, y1, x2, y2, attrs) == \0a    LET svgAttrs == [x1 |-> ToString(x1), \0a                     y1 |-> ToString(y1), \0a                     x2 |-> ToString(x2),\0a                     y2 |-> ToString(y2)] IN\0a    SVGElem("line", Merge(svgAttrs, attrs), <<>>, "")\0a\0a(**************************************************************************)\0a(* Circle element. \'cx\', \'cy\', and \'r\' should be given as integers.       *)\0a(**************************************************************************)\0aCircle(cx, cy, r, attrs) == \0a    LET svgAttrs == [cx |-> ToString(cx), \0a                     cy |-> ToString(cy), \0a                     r  |-> ToString(r)] IN\0a    SVGElem("circle", Merge(svgAttrs, attrs), <<>>, "")\0a\0a(**************************************************************************)\0a(* Rectangle element.  \'x\', \'y\', \'w\', and \'h\' should be given as          *)\0a(* integers.                                                              *)\0a(**************************************************************************)\0aRect(x, y, w, h, attrs) == \0a    LET svgAttrs == [x      |-> ToString(x), \0a                     y      |-> ToString(y), \0a                     width  |-> ToString(w), \0a                     height |-> ToString(h)] IN\0a    SVGElem("rect", Merge(svgAttrs, attrs), <<>>, "")\0a\0a(**************************************************************************)\0a(* Text element.\'x\' and \'y\' should be given as integers, and \'text\' given *)\0a(* as a string.                                                           *)\0a(**************************************************************************)\0aText(x, y, text, attrs) == \0a    LET svgAttrs == [x |-> ToString(x), \0a                     y |-> ToString(y)] IN\0a    SVGElem("text", Merge(svgAttrs, attrs), <<>>, text) \0a\0a(**************************************************************************)\0a(* Image element. \'x\', \'y\', \'width\', and \'height\' should be given as      *)\0a(* integers, and \'href\' given as a string specifying the image source.    *)\0a(**************************************************************************)\0aImage(x, y, width, height, href, attrs) == \0a    LET svgAttrs == ("xlink:href" :> href @@\0a                     "x"         :> ToString(x) @@\0a                     "y"         :> ToString(y) @@\0a                     "width"     :> ToString(width) @@\0a                     "height"    :> ToString(height)) IN\0a    SVGElem("image", Merge(svgAttrs, attrs), <<>>, "")\0a\0a(**************************************************************************)\0a(* Group element.  \'children\' is a sequence of elements that will be      *)\0a(* contained in this group.                                               *)\0a(**************************************************************************)\0aGroup(children, attrs) == \0a    SVGElem("g", attrs, children, "")\0a\0a(**************************************************************************)\0a(* Svg container.  \'children\' is a sequence of elements that will be      *)\0a(* contained in this svg container.                                       *)\0a(**************************************************************************)\0aSvg(children, attrs) == \0a    SVGElem("svg", attrs, children, "")\0a\0a(**************************************************************************)\0a(* Creates a complete SVG document with viewBox and additional attributes.*)\0a(*                                                                        *)\0a(* Parameters:                                                            *)\0a(*   children: A sequence of SVG elements to include in the document      *)\0a(*   vbX, vbY: The x,y coordinates of the top-left corner of the viewBox  *)\0a(*   vbW, vbH: The width and height of the viewBox                        *)\0a(*   attrs:    Additional attributes to merge with the SVG root element   *)\0a(*                                                                        *)\0a(* The viewBox defines the coordinate system and viewport dimensions for  *)\0a(* the SVG content. This is essential for proper scaling and positioning  *)\0a(* of elements within the document.                                       *)\0a(**************************************************************************)\0aSVGDoc(children, vbX, vbY, vbW, vbH, attrs) ==\0a    LET svgAttrs == ("xmlns:xlink" :> "http://www.w3.org/1999/xlink" @@\0a                     "xmlns"       :> "http://www.w3.org/2000/svg" @@\0a                     "viewBox" :> ToString(vbX) \\o " " \\o\0a                                  ToString(vbY) \\o " " \\o\0a                                  ToString(vbW) \\o " " \\o\0a                                  ToString(vbH)) IN\0a    Svg(<<children>>, Merge(svgAttrs, attrs))\0a\0a(**************************************************************************)\0a(* Convert an SVG element record into its string representation.          *)\0a(*                                                                        *)\0a(* This operator is expected to be replaced by a Java module override.    *)\0a(* We do not implement it in pure TLA+ because doing non-trivial string   *)\0a(* manipulation in TLA+ is tedious.  Also, the performance of             *)\0a(* implementing this in TLA+ has been demonstrated to be prohibitively    *)\0a(* slow.                                                                  *)\0a(**************************************************************************)\0aSVGElemToString(elem) == \0a    TRUE    \0a\0a-------------------------------------------------------------------------------\0a\0a(**************************************************************************)\0a(* Equals the Cartesian coordinates of the n-th of m nodes in a ring      *)\0a(* (https://en.wikipedia.org/wiki/Ring_network), such that the circle     *)\0a(* on which the nodes are placed has radius r and is centered at the      *)\0a(* coordinates cx, cy.                                                    *)\0a(*                                                                        *)\0a(* ASSUME /\\ n \\in 0..360 /\\ m \\in 0..360 /\\ n <= m                       *)\0a(*        /\\ cx \\in Nat /\\ cy \\in Nat /\\ r \\in Nat                        *)\0a(*                                                                        *)\0a(* Example to create a ring network of M nodes (Rects with dimension 15)  *)\0a(* with center (10,10) and radius 5:                                      *)\0a(*                                                                        *)\0a(*      ASSUME M \\in Nat                                                  *)\0a(*                                                                        *)\0a(*      RN[ n \\in 1..M ] ==                                               *)\0a(*           LET c == NodeOfRingNetwork(10, 10, 5, n, M)                  *)\0a(*               node == Rect(c.x, c.y, 15, 15, <<>>)                     *)\0a(*           IN Group(<<node>>,  <<>>)                                    *)\0a(*                                                                        *)\0a(* Note: It would have been more elegant to provide the basic geometric   *)\0a(*       operators, such as polar to Cartesian conversion.  However,      *)\0a(*       TLC\'s lack of floats makes this impractical due to intermediate  *)\0a(*       rounding errors.                                                 *)\0a(*                                                                        *)\0a(* For this operator\'s actual definition, please consult the Java module  *)\0a(* override at:                                                           *)\0a(*         modules/tlc2/overrides/SVG.java#ringNetwork                    *)\0a(**************************************************************************)\0aNodeOfRingNetwork(cx, cy, r, n, m) ==\0a    [ x |-> 0, y |-> 0 ]\0a\0a(**************************************************************************)\0a(* Example to layout a graph with the given Nodes and Edges:              *)\0a(*                                                                        *)\0a(*      Nodes == {"v1", "v2", "v3"}  \\* v3 is not connected               *)\0a(*      Edges == {<<"v1", "v2">>, <<"v2", "v1">>}                         *)\0a(*      Graph == NodesOfDirectedMultiGraph(Nodes, Edges, [algo |-> ...])  *)\0a(*                                                                        *)\0a(*      RN[ n \\in Nodes ] ==                                              *)\0a(*           LET c == Graph[n]                                            *)\0a(*               node == Rect(c.x, c.y, 23, 42, <<>>)                     *)\0a(*           IN Group(<<node>>,  <<>>)                                    *)\0a(*                                                                        *)\0a(* For this operator\'s actual definition, please consult the Java module  *)\0a(* override at:                                                           *)\0a(*         modules/tlc2/overrides/SVG.java#directedMultiGraph             *)\0a(**************************************************************************)\0aNodesOfDirectedMultiGraph(nodes, edges, options) ==\0a    CHOOSE f \\in [ nodes -> [x: Int, y: Int] ]: TRUE\0a\0aPointOnLine(from, to, segment) ==\0a    [x |-> from.x + ((to.x - from.x) \\div segment), \0a     y |-> from.y + ((to.y - from.y) \\div segment)]\0a\0a-------------------------------------------------------------------------------\0a\0a(**************************************************************************)\0a(* Serializes an SVG element to a file on disk.                           *)\0a(*                                                                        *)\0a(* Parameters:                                                            *)\0a(*   svg:             The SVG element/document to serialize               *)\0a(*   frameNamePrefix: String prefix for the output filename               *)\0a(*   frameNumber:     Numeric identifier appended to create unique files  *)\0a(*                                                                        *)\0a(* Creates a file named "<frameNamePrefix><frameNumber>.svg" containing   *)\0a(* the serialized SVG content. This is useful for generating animation    *)\0a(* frames or saving visualization snapshots.                              *)\0a(*                                                                        *)\0a(* Example usage:                                                         *)\0a(*   SVGSerialize(SVGDoc(myElements, 0, 0, 800, 600, <<>>),               *)\0a(*                "svg_frame_", TLCGet("level"))                          *)\0a(*                                                                        *)\0a(* This creates files like: svg_frame_001.svg,                            *)\0a(*                          svg_frame_002.svg, etc.                       *)\0a(**************************************************************************)\0aSVGSerialize(svg, frameNamePrefix, frameNumber) ==\0a    LET IO == INSTANCE IOUtils IN\0a    IO!Serialize(\0a        SVGElemToString(svg),\0a        \\* Construct the filename using the prefix and a zero-padded frame\0a        \\* number so that files sort correctly lexicographically.\0a        frameNamePrefix \\o IO!zeroPadN(frameNumber, 3) \\o ".svg",\0a        [format |-> "TXT", charset |-> "UTF-8", \0a         openOptions |-> <<"WRITE", "CREATE", "TRUNCATE_EXISTING">>])\0a\0a=============================================================================\0a'
::
++  sequencesext-src
  '---------------------------- MODULE SequencesExt ----------------------------\0aEXTENDS Sequences, Naturals, FiniteSets, FiniteSetsExt, Folds, Functions, Bags\0a\\* TLAPM does not play well with LOCAL INSTANCE, reinstate the following\0a\\* when that issue is fixed.\0a\\* LOCAL INSTANCE Sequences\0a\\* LOCAL INSTANCE Naturals\0a\\* LOCAL INSTANCE FiniteSets\0a\\* LOCAL INSTANCE FiniteSetsExt\0a\\* LOCAL INSTANCE Folds\0a\\* LOCAL INSTANCE Functions\0a\\* LOCAL INSTANCE Bags\0aLOCAL INSTANCE TLC\0a  (*************************************************************************)\0a  (* Imports the definitions from the modules, but doesn\'t export them.    *)\0a  (*************************************************************************)\0a\0a-----------------------------------------------------------------------------\0a\0a(*************************************************************************)  \0a(* Convert a sequence to the set of its elements (sequence image).       *)\0a(*                                                                       *)\0a(* Returns the set of all elements that appear in the sequence,          *)\0a(* effectively removing duplicates and order. The cardinality of the     *)\0a(* result is at most the length of the sequence.                         *)\0a(*                                                                       *)\0a(* Examples:                                                             *)\0a(*   ToSet(<<>>) = {}                                                    *)\0a(*   ToSet(<<1>>) = {1}                                                  *)\0a(*   ToSet(<<1,2,3>>) = {1,2,3}                                          *)\0a(*   ToSet(<<1,1,2>>) = {1,2}                                            *)\0a(*                                                                       *)\0a(* See: https://en.wikipedia.org/wiki/Image_(mathematics)                *)\0a(*************************************************************************)\0aToSet(s) ==\0a  { s[i] : i \\in DOMAIN s }\0a\0a(**************************************************************************)\0a(* Convert a sequence to the bag (i.e. multi-set) of its elements.        *)\0a(* Cf. standard module Bags.tla and community module BagsExt.tla.         *)\0a(**************************************************************************)\0aToBag(s) ==\0a  [x \\in Range(s) |-> Cardinality({i \\in DOMAIN s : s[i] = x})]\0a\0a(**************************************************************************)\0a(* Convert a set to some sequence that contains all the elements of the   *)\0a(* set exactly once, and contains no other elements.                      *)\0a(**************************************************************************)\0aSetToSeq(S) == \0a  CHOOSE f \\in [1..Cardinality(S) -> S] : IsInjective(f)\0a\0a(**************************************************************************)\0a(* Convert the set S to a set containing all sequences containing the     *)\0a(* elements of S exactly once and no other elements.                      *)\0a(* Example:                                                               *)\0a(*    SetToSeqs({}), {<<>>}                                               *)\0a(*    SetToSeqs({"t","l"}) = {<<"t","l">>, <<"l","t">>}                   *) \0a(**************************************************************************)\0aSetToSeqs(S) == \0a  LET D == 1..Cardinality(S)\0a  IN { f \\in [D -> S] : \\A i,j \\in D : i # j => f[i] # f[j] }\0a\0a(**************************************************************************)\0a(* Convert a set to a sorted sequence that contains all the elements of   *)\0a(* the set exactly once, and contains no other elements.                  *)\0a(**************************************************************************)\0aSetToSortSeq(S, op(_,_)) ==\0a  SortSeq(SetToSeq(S), op)\0a\0a(**************************************************************************)\0a(* Convert the set S to a set containing all k-permutations of elements   *)\0a(* of S for k \\in 0..Cardinality(S).                                      *)\0a(* Example:                                                               *)\0a(*    SetToAllKPermutations({}) = {<<>>}                                  *)\0a(*    SetToAllKPermutations({"a"}) = {<<>>, <<"a">>}                      *)\0a(*    SetToAllKPermutations({"a","b"}) =                                  *)\0a(*                    {<<>>, <<"a">>, <<"b">>,<<"a","b">>, <<"b","a">>}   *)\0a(**************************************************************************)\0aSetToAllKPermutations(S) ==\0a  UNION { SetToSeqs(s) : s \\in SUBSET S  }\0a\0a(***************************************************************************)\0a(* TupleOf(s, 3) = s \\X s \\X s                                             *)\0a(***************************************************************************)\0aTupleOf(set, n) == \0a  [1..n -> set]\0a\0a(***************************************************************************)\0a(* All sequences up to length n with all elements in set.  Includes empty  *)\0a(* sequence.                                                               *)\0a(***************************************************************************)\0aSeqOf(set, n) == \0a  UNION {[1..m -> set] : m \\in 0..n}\0a\0a(***************************************************************************)\0a(* An alias for SeqOf to make the connection to Sequences!Seq, which is    *)\0a(* the unbounded version of BoundedSeq.                                    *)\0a(***************************************************************************)\0aBoundedSeq(S, n) ==\0a  SeqOf(S, n)\0a\0a-----------------------------------------------------------------------------\0a\0a(**************************************************************************)\0a(* TRUE iff the element e \\in ToSet(s).                                   *)\0a(**************************************************************************)\0aContains(s, e) ==\0a  \\E i \\in 1..Len(s) : s[i] = e\0a\0a(**************************************************************************)\0a(* Reverse the given sequence s:  Let l be Len(s) (length of s).          *)\0a(* Equals a sequence s.t. << S[l], S[l-1], ..., S[1]>>                    *)\0a(**************************************************************************)\0aReverse(s) ==\0a  [ i \\in 1..Len(s) |-> s[(Len(s) - i) + 1] ]\0a\0a(************************************************************************)\0a(* The sequence s with e removed or s iff e \\notin Range(s)             *)\0a(************************************************************************)\0aRemove(s, e) ==\0a    SelectSeq(s, LAMBDA t: t # e)\0a\0a(*************************************************************************)\0a(* Equals the sequence s except that all occurrences of element old are  *)\0a(* replaced with the element new.                                        *)\0a(*************************************************************************)\0aReplaceAll(s, old, new) ==\0a  [i \\in 1 .. Len(s) |-> IF s[i] = old THEN new ELSE s[i]]\0a\0a-----------------------------------------------------------------------------\0a\0a(*************************************************************************)\0a(* Selects the index of the first element such that Test(seq[i]) is true *)\0a(* Equals 0 if Test(seq[i]) is FALSE for all elements.                   *)\0a(*************************************************************************)\0aSelectInSeq(seq, Test(_)) ==\0a  LET I == { i \\in 1..Len(seq) : Test(seq[i]) }\0a  IN IF I # {} THEN Min(I) ELSE 0\0a\0a(*************************************************************************)\0a(* Selects the index of the first element in seq such that Test(seq[i])  *)\0a(* is TRUE for this elements in from..to.  Equals 0 if Test(seq[i]) is   *)\0a(* FALSE for all elements.                                               *)\0a(*************************************************************************)\0aSelectInSubSeq(seq, from, to, Test(_)) ==\0a  SelectInSeq(SubSeq(seq, from, to), Test)\0a\0a(*************************************************************************)\0a(* Selects the index of the last element such that Test(seq[i]) is true  *)\0a(* Equals 0 if Test(seq[i]) is FALSE for all elements.                   *)\0a(*************************************************************************)\0aSelectLastInSeq(seq, Test(_)) ==\0a  LET I == { i \\in 1..Len(seq) : Test(seq[i]) }\0a  IN IF I # {} THEN Max(I) ELSE 0\0a\0a(*************************************************************************)\0a(* Selects the index of the last element in seq such that Test(seq[i])   *)\0a(* is TRUE for this elements in from..to.  Equals 0 if Test(seq[i]) is   *)\0a(* FALSE for all elements.                                               *)\0a(*************************************************************************)\0aSelectLastInSubSeq(seq, from, to, Test(_)) ==\0a  SelectLastInSeq(SubSeq(seq, from, to), Test)\0a\0a-----------------------------------------------------------------------------\0a\0a\\* The operators below up to including IsStrictSuffix have been extracted \0a\\* from the TLAPS module SequencesTheorems.tla as of 10/14/2019.  The original\0a\\* comments have been partially rewritten.\0a\0a(**************************************************************************)\0a(* Inserts element e at the position i moving the original element to i+1 *)\0a(* and so on.  In other words, a sequence t s.t.:                         *)\0a(*   /\\ Len(t) = Len(s) + 1                                               *)\0a(*   /\\ t[i] = e                                                          *)\0a(*   /\\ \\A j \\in 1..(i - 1): t[j] = s[j]                                  *)\0a(*   /\\ \\A k \\in (i + 1)..Len(s): t[k + 1] = s[k]                         *)\0a(**************************************************************************)\0aInsertAt(s, i, e) ==\0a  SubSeq(s, 1, i-1) \\o <<e>> \\o SubSeq(s, i, Len(s))\0a\0a(**************************************************************************)\0a(* Replaces the element at position i with the element e.                 *)\0a(**************************************************************************)\0aReplaceAt(s, i, e) ==\0a  [s EXCEPT ![i] = e]\0a  \0a(**************************************************************************)\0a(* Replaces the element at position i shortening the length of s by one.  *)\0a(**************************************************************************)\0aRemoveAt(s, i) == \0a  SubSeq(s, 1, i-1) \\o SubSeq(s, i+1, Len(s))\0a\0a(************************************************************************)\0a(* The sequence s with the first occurrence of e removed or s           *)\0a(* iff e \\notin Range(s)                                                *)\0a(************************************************************************)\0aRemoveFirst(s, e) ==\0a    IF \\E i \\in 1..Len(s): s[i] = e\0a    THEN RemoveAt(s, SelectInSeq(s, LAMBDA v: v = e))\0a    ELSE s\0a\0a(************************************************************************)\0a(* The sequence s with the first element removed s.t. Test(e) or s      *)\0a(* iff e \\notin Range(s)                                                *)\0a(************************************************************************)\0aRemoveFirstMatch(s, Test(_)) ==\0a    IF \\E i \\in 1..Len(s): Test(s[i])\0a    THEN RemoveAt(s, SelectInSeq(s, Test))\0a    ELSE s\0a\0a-----------------------------------------------------------------------------\0a\0a(************************************************************************)\0a(* Cons prepends an element at the beginning of a sequence.             *)\0a(************************************************************************)\0aCons(elt, seq) == \0a    <<elt>> \\o seq\0a\0a(************************************************************************)\0a(* Reverses the operands of Sequences!Append for better compatibility   *)\0a(* with FoldFunction below.                                             *)\0a(* Example:                                                             *)\0a(*  FoldSeq(LAMBDA x,y: {x} \\cup y, {}, <<1,2,1>>) = Range(<<1,2,1>>)   *)\0a(************************************************************************)\0aSnoc(elt, seq) == \0a    Append(seq, elt)\0a\0a(**************************************************************************)\0a(* The sequence formed by removing its last element.                      *)\0a(**************************************************************************)\0aFront(s) == \0a  SubSeq(s, 1, Len(s)-1)\0a\0a(**************************************************************************)\0a(* The last element of the sequence.                                      *)\0a(**************************************************************************)\0aLast(s) ==\0a  s[Len(s)]\0a\0a-----------------------------------------------------------------------------\0a\0a(**************************************************************************)\0a(* TRUE iff the sequence s is a prefix of the sequence t, s.t.            *)\0a(* \\E u \\in Seq(Range(t)) : t = s \\o u. In other words, there exists      *)\0a(* a suffix u that with s prepended equals t.                             *)\0a(**************************************************************************)\0aIsPrefix(s, t) ==\0a  Len(s) <= Len(t) /\\ SubSeq(s, 1, Len(s)) = SubSeq(t, 1, Len(s))\0a\0a(**************************************************************************)\0a(* TRUE iff the sequence s is a prefix of the sequence t and s # t        *)\0a(**************************************************************************)\0aIsStrictPrefix(s,t) ==\0a  IsPrefix(s, t) /\\ s # t\0a\0a(**************************************************************************)\0a(* TRUE iff the sequence s is a suffix of the sequence t, s.t.            *)\0a(* \\E u \\in Seq(Range(t)) : t = u \\o s. In other words, there exists a    *)\0a(* prefix that with s appended equals t.                                  *)\0a(**************************************************************************)\0aIsSuffix(s, t) ==\0a  IsPrefix(Reverse(s), Reverse(t))\0a\0a(**************************************************************************)\0a(* TRUE iff the sequence s is a suffix of the sequence t and s # t        *)\0a(**************************************************************************)\0aIsStrictSuffix(s, t) ==\0a  IsSuffix(s,t) /\\ s # t\0a  \0a-----------------------------------------------------------------------------\0a\0a(**************************************************************************)\0a(* The set of prefixes of the sequence s, including the empty sequence.   *)\0a(**************************************************************************)\0aPrefixes(s) ==\0a  \\* 0.. for <<>>\0a  { SubSeq(s, 1, l) : l \\in 0..Len(s) }\0a\0a(**************************************************************************)\0a(* The set of all sequences that are prefixes of the set of sequences S.  *)\0a(**************************************************************************)\0aCommonPrefixes(S) ==\0a  LET P == UNION { Prefixes(seq) : seq \\in S }\0a  IN { prefix \\in P : \\A t \\in S: IsPrefix(prefix, t) }\0a\0a(**************************************************************************)\0a(* The longest common prefix of the sequences in the set S.               *)\0a(**************************************************************************)\0aLongestCommonPrefix(S) ==\0a  CHOOSE longest \\in CommonPrefixes(S):  \\* there can only be one LCP => CHOOSE\0a          \\A other \\in CommonPrefixes(S):\0a              Len(other) <= Len(longest)\0a\0a(**************************************************************************)\0a(* The set of suffixes of the sequence s, including the empty sequence.   *)\0a(**************************************************************************)\0aSuffixes(s) ==\0a  { SubSeq(s, l, Len(s)) : l \\in 1..Len(s) } \\cup {<<>>}\0a\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(*   Range(a % b) = 0..b-1, but DOMAIN seq = 1..Len(seq).                  *)\0a(*   So to do modular arithmetic on sequences we need to                   *)\0a(*   map 0 to b.                                                           *)\0a(***************************************************************************)\0aSeqMod(a, b) == \0a  IF a % b = 0 THEN b ELSE a % b\0a\0a\0a(***************************************************************************)\0a(* An alias of FoldFunction that combines all elements of seq using op,    *)\0a(* in an unspecified order. The result is                                  *)\0a(*    op(seq[i],op(seq[j], ..., op(seq[k],base) ...))                      *)\0a(*                                                                         *)\0a(* op should be associative and commutative, because we can not assume a   *)\0a(* particular ordering of i, j, and k                                      *)\0a(*                                                                         *)\0a(* Example:                                                                *)\0a(*  FoldSeq(LAMBDA x,y: {x} \\cup y, {}, <<1,2,1>>) = Range(<<1,2,1>>)      *)\0a(***************************************************************************)\0aFoldSeq(op(_, _), base, seq) == \0a  FoldFunction(op, base, seq)\0a\0a(***************************************************************************)\0a(* FoldLeft folds op on all elements of seq from left to right, starting   *)\0a(* with the first element and base. The resulting function is:             *)\0a(*    op(op(...op(base,f[0]), ...f[n-1]), f[n])                            *)\0a(*                                                                         *)\0a(*                                                                         *)\0a(* Example:                                                                *)\0a(*    LET cons(x,y) == <<x,y>>                                             *)\0a(*    IN FoldLeft(cons, 0, <<3,1,2>>) = << << <<0,3>>, 1>>, 2>>            *)\0a(***************************************************************************)\0aFoldLeft(op(_, _), base, seq) == \0a  MapThenFoldSet(LAMBDA x,y : op(y,x), base,\0a                 LAMBDA i : seq[i],\0a                 LAMBDA S : Max(S),\0a                 DOMAIN seq)\0a\0a(***************************************************************************)\0a(* FoldRight folds op on all elements of seq from right to left, starting  *)\0a(* with the last element and base. The resulting function is:              *)\0a(*    op(f[0],op(f[1], ..., op(f[n],base) ...))                            *)\0a(*                                                                         *)\0a(*                                                                         *)\0a(* Example:                                                                *)\0a(*    LET cons(x,y) == <<x,y>>                                             *)\0a(*    IN FoldRight(cons, <<3,1,2>>, 0 ) = << 3, << 1, <<2,0>> >> >>        *)\0a(***************************************************************************)\0aFoldRight(op(_, _), seq, base) == \0a  MapThenFoldSet(op, base,\0a                 LAMBDA i : seq[i],\0a                 LAMBDA S : Min(S),\0a                 DOMAIN seq)\0a\0a(***************************************************************************)\0a(* FoldLeftDomain folds op on the domain of seq, i.e., the seq\'s indices,  *)\0a(* starting at the lowest index.                                           *) \0a(***************************************************************************)\0aFoldLeftDomain(op(_, _), base, seq) == \0a  FoldLeft(op, base, [i \\in DOMAIN seq |-> i])\0a\0a(***************************************************************************)\0a(* FoldRightDomain folds op on the domain of seq, i.e., the seq\'s indices, *)\0a(* starting at the highest index.                                          *)\0a(***************************************************************************)\0aFoldRightDomain(op(_, _), seq, base) == \0a  FoldRight(op, [i \\in DOMAIN seq |-> i], base)\0a\0a-----------------------------------------------------------------------------\0a\0a(**************************************************************************)\0a(* A sequence of all elements from all sequences in the sequence  seqs  . *)\0a(*                                                                        *)\0a(* Examples:                                                              *)\0a(*                                                                        *)\0a(*  FlattenSeq(<< <<1,2>>, <<1>> >>) = << 1, 2, 1 >>                      *)\0a(*  FlattenSeq(<< <<"a">>, <<"b">> >>) = <<"a", "b">>                     *)\0a(*  FlattenSeq(<< "a", "b" >>) = "ab"                                     *)\0a(**************************************************************************)\0aFlattenSeq(seqs) ==\0a  IF Len(seqs) = 0 THEN seqs ELSE\0a    \\* Not via  FoldSeq(\\o, <<>>, seqs)  here to support strings with TLC.\0a    LET flatten[i \\in 1..Len(seqs)] ==\0a        IF i = 1 THEN seqs[i] ELSE flatten[i-1] \\o seqs[i]\0a    IN flatten[Len(seqs)]\0a\0a(**************************************************************************)\0a(* A sequence of pairs where the i-th pair is formed from the i-th        *)\0a(* element of s and the i-th element of t. The length of the result       *)\0a(* sequence is the minimum of the lengths of s and t.                     *)\0a(*                                                                        *)\0a(* Examples:                                                              *)\0a(*                                                                        *)\0a(*  Zip(<< >>, << >>) = << >>                                             *)\0a(*  Zip(<<"a">>, <<"b">>) = << <<"a", "b">> >>                            *)\0a(*  Zip(<<1, 3>>, <<2, 4>>) = <<<<1, 2>>, <<3, 4>>>>                      *)\0a(*  FlattenSeq(Zip(<<1, 3>>, <<2, 4>>)) = <<1, 2, 3, 4>>>>                *)\0a(*  Zip(<< >>, <<1, 2, 3>>) = << >>                                       *)\0a(*  Zip(<<"a", "b", "c">>, <<1>>) = << <<"a", 1>> >>                      *)\0a(**************************************************************************)\0aZip(s, t) ==\0a  LET l == IF Len(s) <= Len(t) THEN Len(s) ELSE Len(t)\0a  IN  [ i \\in 1 .. l |-> <<s[i], t[i] >> ]\0a\0a(**************************************************************************)\0a(* A sequence where the i-th tuple contains the i-th element of  s  and   *)\0a(*   t  in this order.  Not defined for  Len(s) # Len(t)                  *)\0a(*                                                                        *)\0a(* Examples:                                                              *)\0a(*                                                                        *)\0a(*  Interleave(<< >>, << >>) = << >>                                      *)\0a(*  Interleave(<<"a">>, <<"b">>) = <<"a", "b">>                           *)\0a(*  Interleave(<<1,3>>, <<2,4>>) = <<<<1>>, <<2>>, <<3>>, <<4>>>>         *)\0a(*  FlattenSeq(Interleave(<<1,3>>,<<2,4>>)) = <<1, 2, 3, 4>>              *)\0a(**************************************************************************)\0aInterleave(s, t) ==\0a  CASE Len(s) = Len(t) /\\ Len(s) > 0 ->\0a        LET u[ i \\in 1..Len(s) ] == \0a                IF i = 1 THEN << <<s[i]>> >> \\o << <<t[i]>> >>\0a                ELSE u[i-1] \\o << <<s[i]>> >> \\o << <<t[i]>> >>\0a        IN Last(u)\0a    \\* error "Interleave: sequences must have same length"\0a    [] Len(s) = Len(t) /\\ Len(s) = 0 -> << <<>>, <<>> >>\0a\0a(**************************************************************************)\0a(* The set of all subsequences of the sequence  s  .  Note that the empty *)\0a(* sequence  <<>>  is defined to be a subsequence of any sequence.        *)\0a(**************************************************************************)\0aSubSeqs(s) ==\0a  { SubSeq(s, i+1, j) : i, j \\in 0..Len(s) }\0a\0a(**************************************************************************)\0a(* SubSeqs(s)                                                             *)\0a(*      \\cup                                                              *)\0a(*         { subsequences of s, with arbitrarily many elts removed }      *)\0a(*                                                                        *)\0a(* Example:                                                               *)\0a(*  AllSubSeqs(<<1,2,3,4>>) =                                             *)\0a(*       {<<>>, <<1>>, <<2>>, <<3>>, <<4>>,                               *)\0a(*        <<1, 2>>, <<1, 3>>, <<1, 4>>,                                   *)\0a(*        <<2, 3>>, <<2, 4>>, <<3, 4>>,                                   *)\0a(*        <<1, 2, 3>>, <<1, 2, 4>>, <<1, 3, 4>>, <<2, 3, 4>>,             *)\0a(*        <<1, 2, 3, 4>>}                                                 *)\0a(**************************************************************************)\0aAllSubSeqs(s) ==\0a  { FoldFunction(Snoc, <<>>, [ i \\in D |-> s[i] ]) : D \\in SUBSET DOMAIN s }\0a\0a(**************************************************************************)\0a(* The (1-based) index of the beginning of the subsequence  s  of the     *)\0a(* sequence  t  .  If  s  appears in  t  multiple times, this equals the  *)\0a(* lowest index.                                                          *)\0a(* For example:  IndexFirstSubSeq(<<1>>, <<1,1,1>>) = 1                   *)\0a(**************************************************************************)\0aIndexFirstSubSeq(s, t) ==\0a  LET last == CHOOSE i \\in 0..Len(t) :\0a                /\\ s \\in SubSeqs(SubSeq(t, 1, i))\0a                /\\ \\A j \\in 0..i-1 : s \\notin SubSeqs(SubSeq(t, 1, j))\0a  IN last - (Len(s) - 1)\0a\0a(**************************************************************************)\0a(* The sequence  t  with its subsequence  s  at position  i  replaced by  *)\0a(* the sequence  r  .                                                     *)\0a(**************************************************************************)\0aReplaceSubSeqAt(i, r, s, t) ==\0a  LET prefix == SubSeq(t, 1, i - 1)\0a      suffix == SubSeq(t, i + Len(s), Len(t))\0a  IN prefix \\o r \\o suffix \0a\0a(**************************************************************************)\0a(* The sequence  t  with its subsequence  s  replaced by the sequence  r  *)\0a(**************************************************************************)\0aReplaceFirstSubSeq(r, s, t) ==\0a  IF s \\in SubSeqs(t)\0a  THEN ReplaceSubSeqAt(IndexFirstSubSeq(s, t), r, s, t)\0a  ELSE t\0a\0a(**************************************************************************)\0a(* The sequence  t  with all subsequences  s  replaced by the sequence  r *)\0a(* Overlapping replacements are disambiguated by choosing the occurrence  *)\0a(* closer to the beginning of the sequence.                               *)\0a(*                                                                        *)\0a(* Examples:                                                              *)\0a(*                                                                        *)\0a(*  ReplaceAllSubSeqs(<<>>,<<>>,<<>>) = <<>>                              *)\0a(*  ReplaceAllSubSeqs(<<4>>,<<>>,<<>>) = <<4>>                            *)\0a(*  ReplaceAllSubSeqs(<<2>>,<<3>>,<<1,3>>) = <<1,2>>                      *)\0a(*  ReplaceAllSubSeqs(<<2,2>>,<<1,1>>,<<1,1,1>>) = <<2,2,1>>              *)\0a(**************************************************************************)\0aReplaceAllSubSeqs(r, s, t) ==\0a  CASE s = t -> r\0a    [] r = s -> t  \\* TLC optimization\0a    [] s # t /\\ Len(s) = 0 ->\0a        LET z == Interleave([i \\in 1..Len(t) |-> r], [i \\in 1..Len(t) |-> <<t[i]>>])\0a        IN FlattenSeq(FlattenSeq(z))\0a    [] s # t /\\ Len(s) > 0 /\\ s \\in SubSeqs(t) ->\0a        \\* Not defined recursively to avoid infinite loops.\0a        LET match(f) == { i \\in 1..Len(f) : s = f[i] }\0a            comp(p, q) == \\A i \\in 1..Len(p) : p[i] <= q[i]\0a            \\* TODO: Replace with Seq(Seq(Range(t))) once *total* Java module\0a            \\*       override in place. The current override handles only the\0a            \\*       case where the parameters are strings (hence Range("abc") \0a            \\*       not a problem with TLC).\0a            R == BoundedSeq(BoundedSeq(Range(t), Len(t)), Len(t))\0a            \\* A) Matches the input t.\0a            S == { f \\in R : FlattenSeq(f) = t }\0a            \\* B) Has the max number of matches...\0a            T == { f \\in S : \\A g \\in S : \0a                    Cardinality(match(g)) <= Cardinality(match(f)) }\0a            \\* C) ...of min (leftmost) matches.\0a            u == CHOOSE f \\in T : \0a                    \\A g \\in T : comp(\0a                        SetToSortSeq(match(f), <), SetToSortSeq(match(g), <))\0a        IN FlattenSeq([i \\in 1..Len(u) |-> IF s = u[i] THEN r ELSE u[i]])\0a    [] OTHER -> t\0a\0a=============================================================================\0a'
::
++  statistics-src
  '------------------------- MODULE Statistics -------------------------\0aEXTENDS Naturals\0a\0a(***************************************************************************)\0a(* Performs a Chi-square goodness of fit test evaluating the null          *)\0a(* hypothesis that the observed counts conform to the frequency            *)\0a(* distribution described by the expected counts, with significance level  *)\0a(* alpha.                                                                  *)\0a(* From:                                                                   *)\0a(* https://commons.apache.org/proper/commons-math/javadocs/api-3.6.1/      *)\0a(* org/apache/commons/math3/stat/inference/ChiSquareTest.html              *)\0a(***************************************************************************)\0aChiSquare(expected, actual, alpha) ==\0a    \\* TODO: specify the ChiSquare test\0a    TRUE\0a\0a=========================================================================\0a '
::
++  vectorclocks-src
  '---------------------------- MODULE VectorClocks -------------------------------\0aEXTENDS Naturals, Sequences, Functions\0a\0aLOCAL concurrent(v1, v2) ==\0a    \\E i,j \\in DOMAIN v1: i # j /\\ v1[i] < v2[i] /\\ v1[j] > v2[j]\0a\0aLOCAL happenedBefore(v1, v2) ==\0a    \\* A vector clock v1 is said to happen before v2 if for all nodes, \0a     \\*  x[n] <= y[n]  , and there exists at least one node such that\0a     \\*  x[h] < y[h].\0a    /\\ \\A i \\in DOMAIN v1: v1[i] <= v2[i]\0a    /\\ \\E i \\in DOMAIN v1: v1[i]  < v2[i]\0a\0aIsCausalOrder(log, clock(_)) ==\0a    \\A i \\in 1..Len(log) :\0a        \\A j \\in 1..(i - 1) :\0a            \\* Align the vector clocks to the same domain (mapping\0a             \\* missing values to 0).  A node gradually learns about\0a             \\* other nodes, so its clock domain expands over time.\0a            LET Fill(c, D) == \0a                    [ d \\in D |-> IF d \\in DOMAIN c THEN c[d] ELSE 0 ]\0a                D   == DOMAIN clock(log[i]) \\cup DOMAIN clock(log[j])\0a                vci == Fill(clock(log[i]), D)\0a                vcj == Fill(clock(log[j]), D)\0a            IN happenedBefore(vcj, vci) \\/ concurrent(vcj, vci)\0a\0aCausalOrder(log, clock(_), node(_), domain(_)) ==\0a    (*\0a        Sort the provided log by the vector clock values indicated on each line\0a        of the log. This operator cannot accommodate "hidden" events, meaning\0a        events that are excluded from the log. The vector clocks must be\0a        continuous without any gaps.\0a        \0a        The predicates clock, node, and domain equals the vector clock from\0a        a log entry, the node\'s clock value, and the clock\'s domain, i.e., the\0a        nodes for which the clock has values.\0a        \0a        Imagine a log containing lines such as:\0a        \0a          [pkt |-> \0a            [vc |-> \0a              [1 |-> 20, \0a               0 |-> 10,\0a               3 |-> 16, \0a               7 |-> 21, \0a               4 |-> 10, \0a               6 |-> 21]],\0a           node |-> 5,\0a       ...\0a        ]\0a     \0a     CausalOrder(log, \0a            LAMBDA line: line.pkt.vc,\0a            LAMBDA line: line.node,\0a            LAMBDA vc : DOMAIN vc)\0a    *)\0a    CHOOSE newlog \\in \0a        { f \\in \0a            [ 1..Len(log) -> Range(log)] : \0a                Range(f) = Range(log) } : \0a                    IsCausalOrder(newlog, clock)\0a\0a===============================================================================\0a'
::
--
