      ['pcal/Github776' 'Github776' %accept ~[['Github776' '------------------------------ MODULE Github776 -----------------------------\0a\0aEXTENDS Naturals, Sequences, TLC\0a\0a(*--algorithm Playground {\0a\0a    \\* PlusCal does not have return values, but we can fake them\0a    variables\0a        retval,\0a        output\0a\0a    procedure add(x, y) {\0a        do_add:\0a            retval := x + y;\0a            return;\0a    }\0a\0a    procedure to_string(int) {\0a        do_to_string:\0a            assert int = 10; \\* this model only needs to be able to convert one value to a string\0a            retval := "10";\0a            return;\0a    }\0a\0a    fair process (main = 1) {\0a        step1: call add(3, 7);\0a        step2: call to_string(retval);\0a        step3: output := retval;\0a        step4: assert output = "10";\0a    }\0a\0a}*)\0a\\* BEGIN TRANSLATION (chksum(pcal) = "90defa92" /\\ chksum(tla) = "375b0aff")\0aCONSTANT defaultInitValue\0aVARIABLES pc, retval, output, stack, x, y, int\0a\0avars == << pc, retval, output, stack, x, y, int >>\0a\0aProcSet == {1}\0a\0aInit == (* Global variables *)\0a        /\\ retval = defaultInitValue\0a        /\\ output = defaultInitValue\0a        (* Procedure add *)\0a        /\\ x = [ self \\in ProcSet |-> defaultInitValue]\0a        /\\ y = [ self \\in ProcSet |-> defaultInitValue]\0a        (* Procedure to_string *)\0a        /\\ int = [ self \\in ProcSet |-> defaultInitValue]\0a        /\\ stack = [self \\in ProcSet |-> << >>]\0a        /\\ pc = [self \\in ProcSet |-> "step1"]\0a\0ado_add(self) == /\\ pc[self] = "do_add"\0a                /\\ retval\' = x[self] + y[self]\0a                /\\ pc\' = [pc EXCEPT ![self] = Head(stack[self]).pc]\0a                /\\ x\' = [x EXCEPT ![self] = Head(stack[self]).x]\0a                /\\ y\' = [y EXCEPT ![self] = Head(stack[self]).y]\0a                /\\ stack\' = [stack EXCEPT ![self] = Tail(stack[self])]\0a                /\\ UNCHANGED << output, int >>\0a\0aadd(self) == do_add(self)\0a\0ado_to_string(self) == /\\ pc[self] = "do_to_string"\0a                      /\\ Assert(int[self] = 10, \0a                                "Failure of assertion at line 20, column 13.")\0a                      /\\ retval\' = "10"\0a                      /\\ pc\' = [pc EXCEPT ![self] = Head(stack[self]).pc]\0a                      /\\ int\' = [int EXCEPT ![self] = Head(stack[self]).int]\0a                      /\\ stack\' = [stack EXCEPT ![self] = Tail(stack[self])]\0a                      /\\ UNCHANGED << output, x, y >>\0a\0ato_string(self) == do_to_string(self)\0a\0astep1 == /\\ pc[1] = "step1"\0a         /\\ /\\ stack\' = [stack EXCEPT ![1] = << [ procedure |->  "add",\0a                                                  pc        |->  "step2",\0a                                                  x         |->  x[1],\0a                                                  y         |->  y[1] ] >>\0a                                              \\o stack[1]]\0a            /\\ x\' = [x EXCEPT ![1] = 3]\0a            /\\ y\' = [y EXCEPT ![1] = 7]\0a         /\\ pc\' = [pc EXCEPT ![1] = "do_add"]\0a         /\\ UNCHANGED << retval, output, int >>\0a\0astep2 == /\\ pc[1] = "step2"\0a         /\\ /\\ int\' = [int EXCEPT ![1] = retval]\0a            /\\ stack\' = [stack EXCEPT ![1] = << [ procedure |->  "to_string",\0a                                                  pc        |->  "step3",\0a                                                  int       |->  int[1] ] >>\0a                                              \\o stack[1]]\0a         /\\ pc\' = [pc EXCEPT ![1] = "do_to_string"]\0a         /\\ UNCHANGED << retval, output, x, y >>\0a\0astep3 == /\\ pc[1] = "step3"\0a         /\\ output\' = retval\0a         /\\ pc\' = [pc EXCEPT ![1] = "step4"]\0a         /\\ UNCHANGED << retval, stack, x, y, int >>\0a\0astep4 == /\\ pc[1] = "step4"\0a         /\\ Assert(output = "10", \0a                   "Failure of assertion at line 29, column 16.")\0a         /\\ pc\' = [pc EXCEPT ![1] = "Done"]\0a         /\\ UNCHANGED << retval, output, stack, x, y, int >>\0a\0amain == step1 \\/ step2 \\/ step3 \\/ step4\0a\0a(* Allow infinite stuttering to prevent deadlock on termination. *)\0aTerminating == /\\ \\A self \\in ProcSet: pc[self] = "Done"\0a               /\\ UNCHANGED vars\0a\0aNext == main\0a           \\/ (\\E self \\in ProcSet: add(self) \\/ to_string(self))\0a           \\/ Terminating\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ WF_vars(main) /\\ WF_vars(add(1)) /\\ WF_vars(to_string(1))\0a\0aTermination == <>(\\A self \\in ProcSet: pc[self] = "Done")\0a\0a\\* END TRANSLATION \0a\0a\0aLiveness == []<>(pc[1] = "Done")\0a=============================================================================\0a\0a------------ CONFIG Github776 -----------------\0aSPECIFICATION Spec\0aCONSTANT defaultInitValue = defaultInitValue\0aPROPERTY Liveness\0a=======================================\0a']]]
      ['pcal/NotSoSimpleLoop' 'NotSoSimpleLoop' %accept ~[['NotSoSimpleLoop' '--------------------------- MODULE NotSoSimpleLoop -------------------------- \0aEXTENDS Naturals, TLC\0a\0a(*   --algorithm NotSoSimpleLoop                                             \0a     variable x = 0;                                                     \0a     begin a : while x < 10                                              \0a                 do x := x+1 ;                                           \0a                    skip ;                                               \0a                    assert x \\in 1..10\0a               end while ;                                               \0a               x := 4*x ;                                                \0a               assert x = 40 ;                                                 \0a           b : assert 2 * x = 80;                                             \0a     end algorithm                  *)\0a\0a                    \0a\\* BEGIN TRANSLATION (chksum(pcal) = "3acbf16a" /\\ chksum(tla) = "f1d2d847")\0aVARIABLES pc, x\0a\0avars == << pc, x >>\0a\0aInit == (* Global variables *)\0a        /\\ x = 0\0a        /\\ pc = "a"\0a\0aa == /\\ pc = "a"\0a     /\\ IF x < 10\0a           THEN /\\ x\' = x+1\0a                /\\ TRUE\0a                /\\ Assert(x\' \\in 1..10, \0a                          "Failure of assertion at line 9, column 21.")\0a                /\\ pc\' = "a"\0a           ELSE /\\ x\' = 4*x\0a                /\\ Assert(x\' = 40, \0a                          "Failure of assertion at line 12, column 16.")\0a                /\\ pc\' = "b"\0a\0ab == /\\ pc = "b"\0a     /\\ Assert(2 * x = 80, "Failure of assertion at line 13, column 16.")\0a     /\\ pc\' = "Done"\0a     /\\ x\' = x\0a\0a(* Allow infinite stuttering to prevent deadlock on termination. *)\0aTerminating == pc = "Done" /\\ UNCHANGED vars\0a\0aNext == a \\/ b\0a           \\/ Terminating\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ WF_vars(Next)\0a\0aTermination == <>(pc = "Done")\0a\0a\\* END TRANSLATION\0a=============================================================================\0a']]]
      ['pcal/SBB' 'SBB' %accept ~[['SBB' '------------------------------- MODULE SBB -------------------------------\0a\0aEXTENDS Naturals, Sequences, TLC\0a\0a\0a(**************************************************************************)\0a(* The StringBuilder bug.                                                 *)\0a(**************************************************************************)\0a\0aCONSTANT Pid        \\* set of process ids\0aNoPid == CHOOSE p : p \\notin Pid\0a\0aCONSTANT Buf        \\* set of buffers\0aNoBuf == CHOOSE b : b \\notin Buf\0a\0a\0a\0a(*--algorithm sbb\0a\0a    variables\0a        sb = [ owner |-> NoPid, buf |-> CHOOSE b \\in Buf : TRUE ];\0a        availablebuffers = Buf \\ {sb.buf};\0a        publishedbuffers = {};\0a\0a\0a    process work \\in Pid\0a        variable\0a            buf = NoBuf;\0a        op = {};\0a    begin\0a      Loop:\0a        while TRUE do\0a            with lop \\in { "Publish", "Modify" } do\0a                op := lop;\0a            end with;\0a\0a        if (op = "Publish") then\0a                buf := sb.buf;          \0a              Publish1:\0a                if sb.owner # self /\\ sb.owner # NoPid then\0a                    buf := CHOOSE b \\in availablebuffers : TRUE;\0a                    availablebuffers := availablebuffers \\ {buf};\0a                else\0a                  Publish2:\0a                    sb.owner := NoPid;\0a                end if;\0a              Publish3:\0a                publishedbuffers := publishedbuffers \\cup {buf};\0a\0a\0a            else\0a                buf := sb.buf;\0a              Modify1:\0a                if sb.owner # self then\0a                    buf := CHOOSE b \\in availablebuffers : TRUE;\0a                    availablebuffers := availablebuffers \\ {buf};\0a                end if;\0a              Modify2:\0a              \\* assert buf \\notin publishedbuffers;\0a                sb.owner := self;\0a              Modify3:\0a                sb.buf := buf;\0a            end if\0a        end while;\0a    end process;\0aend algorithm\0a\0a*)    \0a\0a\0a\\* BEGIN TRANSLATION (chksum(pcal) = "a8cd067d" /\\ chksum(tla) = "17cf9c0")\0aVARIABLES pc, sb, availablebuffers, publishedbuffers, buf, op\0a\0avars == << pc, sb, availablebuffers, publishedbuffers, buf, op >>\0a\0aProcSet == (Pid)\0a\0aInit == (* Global variables *)\0a        /\\ sb = [ owner |-> NoPid, buf |-> CHOOSE b \\in Buf : TRUE ]\0a        /\\ availablebuffers = Buf \\ {sb.buf}\0a        /\\ publishedbuffers = {}\0a        (* Process work *)\0a        /\\ buf = [self \\in Pid |-> NoBuf]\0a        /\\ op = [self \\in Pid |-> {}]\0a        /\\ pc = [self \\in ProcSet |-> "Loop"]\0a\0aLoop(self) == /\\ pc[self] = "Loop"\0a              /\\ \\E lop \\in { "Publish", "Modify" }:\0a                   op\' = [op EXCEPT ![self] = lop]\0a              /\\ IF (op\'[self] = "Publish")\0a                    THEN /\\ buf\' = [buf EXCEPT ![self] = sb.buf]\0a                         /\\ pc\' = [pc EXCEPT ![self] = "Publish1"]\0a                    ELSE /\\ buf\' = [buf EXCEPT ![self] = sb.buf]\0a                         /\\ pc\' = [pc EXCEPT ![self] = "Modify1"]\0a              /\\ UNCHANGED << sb, availablebuffers, publishedbuffers >>\0a\0aPublish1(self) == /\\ pc[self] = "Publish1"\0a                  /\\ IF sb.owner # self /\\ sb.owner # NoPid\0a                        THEN /\\ buf\' = [buf EXCEPT ![self] = CHOOSE b \\in availablebuffers : TRUE]\0a                             /\\ availablebuffers\' = availablebuffers \\ {buf\'[self]}\0a                             /\\ pc\' = [pc EXCEPT ![self] = "Publish3"]\0a                        ELSE /\\ pc\' = [pc EXCEPT ![self] = "Publish2"]\0a                             /\\ UNCHANGED << availablebuffers, buf >>\0a                  /\\ UNCHANGED << sb, publishedbuffers, op >>\0a\0aPublish2(self) == /\\ pc[self] = "Publish2"\0a                  /\\ sb\' = [sb EXCEPT !.owner = NoPid]\0a                  /\\ pc\' = [pc EXCEPT ![self] = "Publish3"]\0a                  /\\ UNCHANGED << availablebuffers, publishedbuffers, buf, op >>\0a\0aPublish3(self) == /\\ pc[self] = "Publish3"\0a                  /\\ publishedbuffers\' = (publishedbuffers \\cup {buf[self]})\0a                  /\\ pc\' = [pc EXCEPT ![self] = "Loop"]\0a                  /\\ UNCHANGED << sb, availablebuffers, buf, op >>\0a\0aModify1(self) == /\\ pc[self] = "Modify1"\0a                 /\\ IF sb.owner # self\0a                       THEN /\\ buf\' = [buf EXCEPT ![self] = CHOOSE b \\in availablebuffers : TRUE]\0a                            /\\ availablebuffers\' = availablebuffers \\ {buf\'[self]}\0a                       ELSE /\\ TRUE\0a                            /\\ UNCHANGED << availablebuffers, buf >>\0a                 /\\ pc\' = [pc EXCEPT ![self] = "Modify2"]\0a                 /\\ UNCHANGED << sb, publishedbuffers, op >>\0a\0aModify2(self) == /\\ pc[self] = "Modify2"\0a                 /\\ sb\' = [sb EXCEPT !.owner = self]\0a                 /\\ pc\' = [pc EXCEPT ![self] = "Modify3"]\0a                 /\\ UNCHANGED << availablebuffers, publishedbuffers, buf, op >>\0a\0aModify3(self) == /\\ pc[self] = "Modify3"\0a                 /\\ sb\' = [sb EXCEPT !.buf = buf[self]]\0a                 /\\ pc\' = [pc EXCEPT ![self] = "Loop"]\0a                 /\\ UNCHANGED << availablebuffers, publishedbuffers, buf, op >>\0a\0awork(self) == Loop(self) \\/ Publish1(self) \\/ Publish2(self)\0a                 \\/ Publish3(self) \\/ Modify1(self) \\/ Modify2(self)\0a                 \\/ Modify3(self)\0a\0aNext == (\\E self \\in Pid: work(self))\0a\0aSpec == Init /\\ [][Next]_vars\0a\0a\\* END TRANSLATION\0a\0a\0aImmutability ==\0a    \\A self \\in ProcSet :\0a    pc[self] = "Modify2" => buf[self] \\notin publishedbuffers\0a\0aConstraint ==\0a    availablebuffers # {}\0a\0a\0a============================================================================\0a']]]
      ['sany/RecursiveDefDeclMismatch' 'RecursiveDefDeclMismatch' %reject ~[['RecursiveDefDeclMismatch' '------------------------- MODULE RecursiveDefDeclMismatch -------------------\0a\0aRECURSIVE CountDown(_,_)\0aCountDown(n) == IF n = 0 THEN TRUE ELSE CountDown(n - 1)\0a\0a=============================================================================\0a']]]
      ['simulation/BasicMultiTrace/BasicMultiTrace' 'BasicMultiTrace' %accept ~[['BasicMultiTrace' '------------------------------ MODULE BasicMultiTrace ------------------------------\0aEXTENDS Integers\0a\0a\\*\0a\\* This spec attempts to define a simple state machine that has multiple behaviors. \0a\\* Originally added to verify correctness of simulation mode in both single and multi-threaded mode.\0a\\*\0a\0aVARIABLE branch, depth\0a\0aMaxDepth == 5\0aWidth == 10\0a\0aInit == \0a    /\\ branch = 0\0a    /\\ depth = 0\0a\0aNext == \0a    \\* Pick a branch\0a    \\/ /\\ branch = 0\0a       /\\ branch\' \\in 1..Width /\\ UNCHANGED depth\0a    \\* Traverse down that branch.\0a    \\/ /\\ branch > 0 \0a       /\\ depth < MaxDepth\0a       /\\ depth\' = depth + 1 /\\ UNCHANGED branch\0a\0aSpec == Init /\\ [][Next]_<<branch, depth>>\0a\0aUnderspecifiedNext == branch\' = 0\0aUnderspecifiedInit == branch = 0\0a\0aUnderspecifiedInitSpec == UnderspecifiedInit /\\ [][Next]_<<branch, depth>>\0aUnderspecifiedNextSpec == Init /\\ [][UnderspecifiedNext]_<<branch, depth>>\0a\0a\\* A valid invariant that should be violated by the initial state.\0aInvInitState == ~(branch = 0)\0a\0a\\* A valid invariant that should be violated by the spec.\0aInv == ~(depth = 2)\0a\0a\\* A nonsensical invariant that will cause a runtime evaluation error on the initial state.\0aInvBadEvalInitState == (0 = "a")\0a\0a\\* A nonsensical invariant that will cause a runtime evaluation error on a non-initial state.\0aInvBadEvalNonInitState == IF branch = 0 THEN TRUE ELSE (0 = "a")\0a\0a\\* A valid action property that should be violated by the spec.\0aActionProp == [][branch\' > branch]_<<branch, depth>>\0a\0a\\* A nonsensical action property that will cause a runtime evaluation error.\0aActionPropBadEval == [][IF branch = 0 THEN TRUE ELSE 0 = "a"]_<<branch, depth>>\0a\0a\\* A simple state and action constraint, and an invariant that should hold true \0a\\* given either constraint.\0aStateConstraint == depth < 4\0aActionConstraint == ~(depth\' = 4 /\\ depth = 3)\0aInvConstraint   == depth <= 4\0a\0a\\* A liveness property that should be violated.\0aLivenessProp == <>(branch = -1)\0a\0a\0a=============================================================================']]]
      ['simulation/BenchmarkSpec/BenchmarkSpec' 'BenchmarkSpec' %accept ~[['BenchmarkSpec' '------------------------------ MODULE BenchmarkSpec ------------------------------\0aEXTENDS Integers, Sequences\0a\0a\\*\0a\\* This spec produces a state space with a simple tree-like structure. The maximum depth and branching\0a\\* factor of the state space tree can be controlled by setting the constant values of the spec. The goal\0a\\* is to give a spec whose state space structure is easily understandable and controllable, for the sake\0a\\* of running performance and/or correctness tests of TLC.\0a\\*\0a\0aVARIABLE hist\0a\0aInit == hist = <<>>\0a\0aCONSTANTS Depth, BranchingFactor\0a    \0aNext ==\0a    \\E e \\in 1..BranchingFactor :\0a    hist\' = Append(hist, e)    \0a\0aSpec == Init /\\ [][Next]_<<hist>>\0a\0aConstraint == Len(hist) < Depth\0a\0a\\* An arbitrary state of max length. It\'s just a sequence filled with all 1\'s.\0aInv == hist # [i \\in 1..Depth |-> 1]\0a\0a=============================================================================']]]
      ['simulation/Example1' 'Example1' %accept ~[['Example1' '------------------------------ MODULE Example1 ------------------------------\0aEXTENDS Integers, TLC, TLCExt\0a\0aVARIABLE x\0a\0aInit == x = 0\0a\0aNext == x\' = ( x + 1 ) % 10\0a\0aSpec == Init /\\ [][Next]_<<x>> /\\ []<><<TRUE>>_<<x>> \0a\0aLiveness1 == <>(x = -10)\0a\0aneg_Liveness1 == ~(Liveness1)\0a\0aXCyclesToZero == []<>(x = 0)\0a\0aAlias == [ x |-> x, l |-> TLCGet("level") ]\0a\0aPostCondition ==\0a\09CounterExample =\0a\09\09[ state |->\0a\09\09      { <<1, [x |-> 0, l |-> 1]>>,\0a\09\09        <<2, [x |-> 1, l |-> 2]>>,\0a\09\09        <<3, [x |-> 2, l |-> 3]>>,\0a\09\09        <<4, [x |-> 3, l |-> 4]>>,\0a\09\09        <<5, [x |-> 4, l |-> 5]>>,\0a\09\09        <<6, [x |-> 5, l |-> 6]>>,\0a\09\09        <<7, [x |-> 6, l |-> 7]>>,\0a\09\09        <<8, [x |-> 7, l |-> 8]>>,\0a\09\09        <<9, [x |-> 8, l |-> 9]>>,\0a\09\09        <<10, [x |-> 9, l |-> 10]>> },\0a\09\09  action |->\0a\09\09      { << <<1, [x |-> 0, l |-> 1]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<2, [x |-> 1, l |-> 2]>> >>,\0a\09\09        << <<2, [x |-> 1, l |-> 2]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<3, [x |-> 2, l |-> 3]>> >>,\0a\09\09        << <<3, [x |-> 2, l |-> 3]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<4, [x |-> 3, l |-> 4]>> >>,\0a\09\09        << <<4, [x |-> 3, l |-> 4]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<5, [x |-> 4, l |-> 5]>> >>,\0a\09\09        << <<5, [x |-> 4, l |-> 5]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<6, [x |-> 5, l |-> 6]>> >>,\0a\09\09        << <<6, [x |-> 5, l |-> 6]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<7, [x |-> 6, l |-> 7]>> >>,\0a\09\09        << <<7, [x |-> 6, l |-> 7]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<8, [x |-> 7, l |-> 8]>> >>,\0a\09\09        << <<8, [x |-> 7, l |-> 8]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<9, [x |-> 8, l |-> 9]>> >>,\0a\09\09        << <<9, [x |-> 8, l |-> 9]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<10, [x |-> 9, l |-> 10]>> >>,\0a\09\09        << <<10, [x |-> 9, l |-> 10]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<1, [x |-> 0, l |-> 1]>> >> } ]\0a\0a=============================================================================']]]
      ['simulation/Example2' 'Example2' %accept ~[['Example2' '------------------------------ MODULE Example2 ------------------------------\0aEXTENDS Integers, TLC, TLCExt\0a\0aVARIABLE x\0a\0aInit == x = 0\0a\0aNext == x\' = ( x + 1 ) % 10\0a\0aSpec == Init /\\ [][Next]_<<x>> /\\ []<><<TRUE>>_<<x>> \0a\0aLiveness2 == <>(x = 11)\0a\0aneg_Liveness2 == ~(Liveness2)\0a\0aXCyclesToZero == []<>(x = 0)\0a\0aAlias == [ x |-> x, l |-> TLCGet("level") ]\0a\0aPostCondition ==\0a\09CounterExample =\0a\09\09[ state |->\0a\09\09      { <<1, [x |-> 0, l |-> 1]>>,\0a\09\09        <<2, [x |-> 1, l |-> 2]>>,\0a\09\09        <<3, [x |-> 2, l |-> 3]>>,\0a\09\09        <<4, [x |-> 3, l |-> 4]>>,\0a\09\09        <<5, [x |-> 4, l |-> 5]>>,\0a\09\09        <<6, [x |-> 5, l |-> 6]>>,\0a\09\09        <<7, [x |-> 6, l |-> 7]>>,\0a\09\09        <<8, [x |-> 7, l |-> 8]>>,\0a\09\09        <<9, [x |-> 8, l |-> 9]>>,\0a\09\09        <<10, [x |-> 9, l |-> 10]>> },\0a\09\09  action |->\0a\09\09      { << <<1, [x |-> 0, l |-> 1]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<2, [x |-> 1, l |-> 2]>> >>,\0a\09\09        << <<2, [x |-> 1, l |-> 2]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<3, [x |-> 2, l |-> 3]>> >>,\0a\09\09        << <<3, [x |-> 2, l |-> 3]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<4, [x |-> 3, l |-> 4]>> >>,\0a\09\09        << <<4, [x |-> 3, l |-> 4]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<5, [x |-> 4, l |-> 5]>> >>,\0a\09\09        << <<5, [x |-> 4, l |-> 5]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<6, [x |-> 5, l |-> 6]>> >>,\0a\09\09        << <<6, [x |-> 5, l |-> 6]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<7, [x |-> 6, l |-> 7]>> >>,\0a\09\09        << <<7, [x |-> 6, l |-> 7]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<8, [x |-> 7, l |-> 8]>> >>,\0a\09\09        << <<8, [x |-> 7, l |-> 8]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<9, [x |-> 8, l |-> 9]>> >>,\0a\09\09        << <<9, [x |-> 8, l |-> 9]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<10, [x |-> 9, l |-> 10]>> >>,\0a\09\09        << <<10, [x |-> 9, l |-> 10]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<1, [x |-> 0, l |-> 1]>> >> } ]\0a\0a=============================================================================']]]
  ==
::
++  test-sany-sub-3
  %+  expect-eq
    !>  ^-  (list @t)
    :~  'suite/etest15 -> hoon=reject'  'suite/etest16 -> hoon=accept'  'suite/test10 -> hoon=reject'  'suite/test16 -> hoon=reject'  'suite/test201 -> hoon=reject'  'suite/test203 -> hoon=reject'  'suite/test206 -> hoon=reject'  'suite/test214 -> hoon=accept'  'suite/test216 -> hoon=reject'
    ==
  !>
  %-  sub-batch-run
  ^-  (list [@t @t ?(%accept %reject) (list [@t @t])])
  :~
      ['simulation/NQSpec/NQSpec' 'NQSpec' %accept ~[['NQSpec' '------------------------------- MODULE NQSpec -------------------------------\0aEXTENDS Integers, Sequences, TLC\0a\0aCONSTANTS EnQers, DeQers, Data, InitData, Ids, Busy, NoData\0a\0aASSUME InitData \\in Data\0a\0aDone == CHOOSE D : D \\notin Data\0a\\*Busy == CHOOSE D : D \\notin Data\0aNotAnId == CHOOSE i : i \\notin Ids\0a\\*NoData == CHOOSE D : D \\notin Data\0aElements == [data : Data, id : Ids]\0aNotAnElement == CHOOSE E : E \\notin Elements\0a\0aVARIABLES enq, deq, after, adding\0avars == <<enq, deq, after, adding>>\0a\0aelts == DOMAIN after\0a\0adoneElts == elts \\ {adding[e] : e \\in EnQers}\0a\0aTypeOK == /\\ enq \\in [EnQers -> Data \\cup {Done}]\0a          /\\ deq \\in [DeQers -> Data \\cup {Busy}]\0a          /\\ elts \\in SUBSET Elements\0a          /\\ after \\in [elts -> SUBSET doneElts]\0a          /\\ adding \\in [EnQers -> Elements \\cup {NotAnElement}]\0a\0aInit ==         \0a        /\\ TLCSet(42, 1)\0a        /\\ enq = [e \\in EnQers |-> Done]\0a        /\\ deq = [d \\in DeQers |-> InitData]\0a        /\\ after = << >>\0a        /\\ adding = [e \\in EnQers |-> NotAnElement]\0a-----------------------------------------------------------------------------\0a\0aAssign(var, idx, val) == var\' = [var EXCEPT ![idx] = val]\0a\0aIdsBeingAdded == {adding[el].id : el \\in {e \\in EnQers : adding[e] # NotAnElement}}\0a\0aUnusedIds == (Ids \\ {el.id : el \\in elts}) \\ IdsBeingAdded\0a\0a\0aAddElt(el) == \0a  after\' = [x \\in elts \\cup {el} |-> \0a                 IF x = el THEN doneElts\0a                           ELSE after[x] ]\0a                           \0aRemoveElt(el) == \0a  after\' = [x \\in elts \\ {el} |-> after[x] \\ {el}]\0a\0aMinimalElts(After) == {el \\in DOMAIN After : After[el] = {}}\0aminimalElts == MinimalElts(after)\0a      \0aBeginEnq(e) == /\\ enq[e] = Done \0a               /\\ \\E D \\in Data, id \\in UnusedIds : \0a                     LET el == [data |-> D, id |-> id]\0a                     IN  /\\ Assign(enq, e, D)\0a                         /\\ AddElt(el)\0a                         /\\ Assign(adding, e, el)\0a               /\\ UNCHANGED deq\0a                           \0aEndEnq(e) == /\\ enq[e] # Done\0a             /\\ Assign(enq, e, Done)\0a             /\\ Assign(adding, e, NotAnElement)\0a             /\\ UNCHANGED <<deq, after>>\0a\0a\\*  enq, deq, elts, after, adding\0aBeginDeq(d) == /\\ deq[d] # Busy\0a               /\\ Assign(deq, d, Busy)\0a               /\\ UNCHANGED <<enq, after, adding>>\0a               \0aEndDeq(d) == /\\ deq[d] = Busy\0a             /\\ \\E el \\in minimalElts :\0a                  /\\ RemoveElt(el)\0a                  /\\ Assign(deq, d, el.data)\0a             /\\ UNCHANGED <<enq, adding>>\0a             \0aNext == \\/ \\E e \\in EnQers : BeginEnq(e)  \\/ EndEnq(e)\0a        \\/ \\E d \\in DeQers : BeginDeq(d)  \\/ EndDeq(d)\0a\0aLiveness == /\\ \\A e \\in EnQers : WF_vars(BeginEnq(e)  \\/ EndEnq(e))\0a            /\\ \\A d \\in DeQers :  WF_vars(BeginDeq(d)  \\/ EndDeq(d))\0a            \0aSpec == Init /\\ [][Next]_vars  /\\ Liveness\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Sat Nov 14 16:00:53 PST 2015 by lamport\0a\\* Created Thu Nov 05 15:07:25 PST 2015 by lamport\0a']]]
      ['simulation/NQSpec/QSpec' 'QSpec' %accept ~[['QSpec' '------------------------------- MODULE QSpec -------------------------------\0aEXTENDS Integers, Sequences, TLC\0a\0aCONSTANTS EnQers, DeQers, Data, Done, Busy, NoData, InitData\0a\0aASSUME /\\ Done     \\notin Data\0a       /\\ Busy     \\notin Data\0a       /\\ NoData   \\notin Data\0a       /\\ InitData \\in Data\0a\0aVARIABLES enq, deq, queue, enqInner, deqInner\0avars == <<enq, deq, queue, enqInner, deqInner>>\0a\0aTypeOK == /\\ enq \\in [EnQers -> Data \\cup {Done}]\0a          /\\ deq \\in [DeQers -> Data \\cup {Busy}]\0a          /\\ queue \\in Seq(Data)\0a          /\\ enqInner \\in [EnQers -> {Done, Busy}]\0a          /\\ deqInner \\in [DeQers -> {NoData} \\cup Data]\0a\0aInit == \\* /\\ PrintT("begin")\0a        /\\ enq = [e \\in EnQers |-> Done]\0a        /\\ deq = [d \\in DeQers |-> InitData]\0a        /\\ queue = << >>\0a        /\\ enqInner = [e \\in EnQers |-> Done] \\* /\\ PrintT("foo")\0a        /\\ deqInner = [d \\in DeQers |-> InitData] \\* /\\ PrintT("bar")\0a        \0aBeginEnq(e) == /\\ enq[e] = Done \0a               /\\ \\E D \\in Data : enq\' = [enq EXCEPT ![e] = D]\0a               /\\ enqInner\' = [enqInner EXCEPT ![e] = Busy]\0a               /\\ UNCHANGED <<deq, queue, deqInner>>\0a               \0aDoEnq(e) == /\\ enqInner[e] = Busy\0a            /\\ queue\' = Append(queue, enq[e])\0a            /\\ enqInner\' = [enqInner EXCEPT ![e] = Done]\0a            /\\ UNCHANGED <<deq, enq, deqInner>>\0a            \0aEndEnq(e) == /\\ enq[e] # Done\0a             /\\ enqInner[e] = Done\0a             /\\ enq\' = [enq EXCEPT ![e] = Done]\0a             /\\ UNCHANGED <<deq, queue, enqInner, deqInner>>\0a\0aBeginDeq(d) == /\\ deq[d] # Busy\0a               /\\ deq\' = [deq EXCEPT ![d] = Busy]\0a               /\\ deqInner\' = [deqInner EXCEPT ![d] = NoData]\0a               /\\ UNCHANGED <<enq, queue, enqInner>>\0a               \0aDoDeq(d) == /\\ deq[d] = Busy\0a            /\\ deqInner[d] = NoData\0a            /\\ queue # << >>\0a            /\\ deqInner\' = [deqInner EXCEPT ![d] = Head(queue)]\0a            /\\ queue\' = Tail(queue)\0a            /\\ UNCHANGED <<enq, deq, enqInner>>\0a\0aEndDeq(d) == /\\ deq[d] = Busy\0a             /\\ deqInner[d] # NoData\0a             /\\ deq\' = [deq EXCEPT ![d] = deqInner[d]]\0a             /\\ UNCHANGED <<enq, queue, enqInner, deqInner>>\0a             \0aNext == \0a    /\\ TLCSet(42, TLCGet(42))\0a    /\\  \\/ \\E e \\in EnQers : BeginEnq(e) \\/ DoEnq(e) \\/ EndEnq(e)\0a        \\/ \\E d \\in DeQers : BeginDeq(d) \\/ DoDeq(d) \\/ EndDeq(d)\0a        \0aSpec == Init /\\ [][Next]_vars\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Sat Nov 14 12:56:11 PST 2015 by lamport\0a\\* Created Wed Nov 04 15:29:04 PST 2015 by lamport\0a']]]
      ['suite/etest1' 'etest1' %reject ~[['etest1' '--------------- MODULE etest1 -------------\0a\0a(* Test that TLC complains if an operator is called with too many arguments. *)\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == \0a  /\\ Print("Should complain that operator Foo is called with too many arguments", TRUE)\0a  /\\ x = TRUE\0a\0aNext == UNCHANGED x\0a\0a\0aFoo(a) == a \0a\0aInv ==  Foo(x, x)\0a\0a=========================================\0a']]]
      ['suite/etest10' 'etest10' %accept ~[['etest10' '--------------- MODULE etest10  -------------\0a\0a\\* Test that TLC doesn\'t accept x \\in Int if x not a number\0a\0aEXTENDS TLC, Integers\0a\0aVARIABLE x\0a\0aInit == /\\ x = "a"\0a        /\\ Print("Should report error here", TRUE)\0a        /\\ Print(x \\in Int, TRUE)\0a\0aNext == /\\ x\'=x\0a        /\\ Print("Test failed--error not reported", TRUE)\0a=========================================\0a']]]
      ['suite/etest11' 'etest11' %accept ~[['etest11' '--------------- MODULE etest11  -------------\0a\0a\\* Test that TLC doesn\'t accept x \\in STRING if x not a string\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0aInit == /\\ x = 1\0a        /\\ Print("Should report error here", TRUE)\0a        /\\ Print(x \\in STRING, TRUE)\0a\0aNext == /\\ x\'=x\0a        /\\ Print("Test failed--error not reported", TRUE)\0a=========================================\0a']]]
      ['suite/etest12' 'etest12' %accept ~[['etest12' '-------------------------- MODULE etest12 --------------------------------\0aEXTENDS Naturals, TLC, FiniteSets\0a\\* Test of error reporting when computing Cardinality of a huge set.\0a\0aASSUME\0a     IF Cardinality ([0..2 -> 1..2000]) = Cardinality ([2..4 -> 1..2000]) \0a       THEN Print("Test 22 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 22 Failed")\0a==========================================================================']]]
      ['suite/etest13' 'etest13' %accept ~[['etest13' '-------------------------- MODULE etest13 --------------------------------\0aEXTENDS Naturals, TLC, FiniteSets\0a\\* Test of error reporting when computing Cardinality of a huge set.\0a\0aASSUME\0a     IF Cardinality ([0..2 -> 1..2000]) = Cardinality ([2..4 -> 1..2000]) \0a       THEN Print("Test 22 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 22 Failed")\0a==========================================================================']]]
      ['suite/etest14' 'etest14' %accept ~[['etest14' '----------------------  MODULE etest14 -----------------------------\0a\0a\\* Test of CHOOSEing element of empty set.\0aASSUME\0a  /\\ (CHOOSE y \\in {} : TRUE) = (CHOOSE y \\in {} : TRUE)\0a=====================================================================\0a']]]
      ['suite/etest15' 'etest15' %accept ~[['etest15' '----------------------  MODULE etest15 -----------------------------\0a\\* Test that TLC distinguishes <<x>> from x in function expressions.\0a\0aEXTENDS Naturals\0a\0aS == {<<y>> : y \\in {1, 2, 3, 4}}\0a\0aASSUME  [<<y>> \\in S |-> y+1][2] = [<<y>> \\in S |-> y+1][2] \0a  \0a=====================================================================\0a']]]
      ['suite/etest16' 'etest16' %reject ~[['etest16' '--------------- MODULE etest16 -----------\0a\0a\\* Test of detecting duplicate record elements\0a\0aFoo == [a |-> 1, b |-> 2, a |-> 1]\0a\0aBar == [a : {1}, b : {2}, a : {1}]\0a=============================================================================\0a\0a\0a\0a']]]
      ['suite/etest2' 'etest2' %reject ~[['etest2' '--------------- MODULE etest2 -------------\0a\0a(* Test that TLC complains if a operator is called with too few arguments. *)\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == \0a  /\\ Print("Should complain that operator Foo is called with too few arguments", TRUE)\0a  /\\ x = TRUE\0a\0aNext == UNCHANGED x\0a\0a\0aFoo(a, b) == a /\\ b\0a\0aInv ==  Foo(x)\0a\0a=========================================\0a']]]
      ['suite/etest3' 'etest3' %accept ~[['etest3' '--------------- MODULE etest3  -------------\0a\0a(* Testing deadlock and number of states found. *)\0a\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aVARIABLE x, y, z\0a\0aInit == /\\ Print("This test should deadlock after finding two states", TRUE)\0a        /\\ x = {}\0a        /\\ y = {}\0a        /\\ z = 1\0a\0aNext == /\\ x = {}\0a        /\\ x\' = {1}        \0a        /\\ y\' \\in SUBSET x\'\0a        /\\ z\' = z\0a        /\\ y\' = {}\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/etest4' 'etest4' %accept ~[['etest4' '--------------- MODULE etest4  -------------\0a\0a(* Evaluates m[v] for model-value m. *)\0a\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aVARIABLE x\0aCONSTANT A\0a\0a\0a\0aReq == [  mask |-> A  ]\0aInit == /\\ x = 1\0a        /\\ Print("Should report error for applying model value to arg", TRUE)\0a        /\\ Req.mask[1] = 1\0a        /\\ Print("Should never get this far", TRUE)\0a\0aNext == UNCHANGED x\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/etest5' 'etest5' %reject ~[['etest5' '--------------- MODULE etest5  -------------\0a\0a(* M!Ident for nonexistent module M. *)\0a\0aEXTENDS TLC, Naturals\0a\0aVARIABLE x\0a\0aInit == /\\ x = 1\0a        /\\ Print("Should report error for nonexistent module M", TRUE)\0a\0aNext == /\\ UNCHANGED x\0a        /\\ IF M!Init THEN TRUE\0a                     ELSE TRUE\0a        /\\ Print("Should not get this far", TRUE)\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/etest6' 'etest6' %accept ~[['etest6' '--------------- MODULE etest6 -------------\0a\0a(* Defining x\' in terms of x\' *)\0a\0aEXTENDS TLC, Integers, Sequences, FiniteSets\0a\0aVARIABLE x\0a\0aInit == /\\ Print("Should complain about undefined value of x.", TRUE)\0a        /\\ x = [i \\in {1,2} |-> i]\0a\0a\0aAction(c) == c\' = [c EXCEPT ![1] = (c[2])\']\0a\0aNext ==  \\/ /\\ x[1] = 1\0a            /\\ Action(x)\0a            /\\ Print("Should not get this far", TRUE)\0a\0a         \\/ UNCHANGED x\0a\0aInv ==  TRUE\0a         \0a\0aConstraint == TRUE\0a=========================================\0a']]]
      ['suite/etest7' 'etest7' %accept ~[['etest7' '--------------- MODULE etest7  -------------\0a\0a(* Test replacement of constant with nonconstant operator. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aCONSTANT C\0a\0aVARIABLE x\0a\0aFoo == x\0a\0aNext == x\' = C\0a\0aInit == /\\ Print("TLC should complain about replacing the constant C", TRUE)\0a        /\\ Print("by the nonconstant Foo", TRUE)\0a        /\\ x = 2\0a\0aInv ==  x = 2\0a\0a=========================================\0a']]]
      ['suite/etest8' 'etest8' %accept ~[['etest8' '--------------- MODULE etest8  -------------\0a\0a(* Test that simulation mode doesn\'t check for deadlock. *)\0a\0aEXTENDS TLC\0a\0a\0aVARIABLE x\0a\0aInit == /\\ x \\in {"a", "b"}\0a        /\\ Print("This spec can deadlock, but shouldn\'t.", TRUE)\0a\0aNext == \\/ /\\ x = "b"\0a           /\\ x\' = "c"\0a        \\/ /\\ x = "c"\0a           /\\ x\' = "d"\0a        \\/ /\\ x = "d"\0a           /\\ x\' = "d"\0a           /\\ Assert(FALSE, "Test successfully completed.")\0a\0a=========================================\0a']]]
      ['suite/etest9' 'etest9' %accept ~[['etest9' '--------------- MODULE etest9  -------------\0a\0a\\* Test that TLC doesn\'t accept x \\in Nat if x not a number\0a\0aEXTENDS TLC, Naturals\0a\0aVARIABLE x\0a\0aInit == /\\ x = "a"\0a        /\\ Print("Should report error here", TRUE)\0a        /\\ Print(x \\in Nat, TRUE)\0a\0aNext == /\\ x\'=x\0a        /\\ Print("Test failed--error not reported", TRUE)\0a=========================================\0a']]]
      ['suite/test' 'test' %reject ~[['test' '------------- MODULE Foo  --------------\0aEXTENDS Naturals\0a\0aFoo == \\A x \\in {1} : lab(x) :: x = 1\0a\0aBar == Foo!lab(1)\0a\0aASSUME Bar\0a=============================================\0a']]]
      ['suite/test1' 'test1' %accept ~[['test1' '--------------- MODULE test1 -------------\0a\0a(* test equality of various representations of sets.    *)\0a\0aEXTENDS Naturals, TLC\0a\0aVARIABLE x\0a\0a\0aType == x \\in {1}\0aInv  == \0a /\\ IF {1, 2, 3} # {3, 2, 2, 1}\0a      THEN Assert(FALSE, "Failed Test 1")\0a      ELSE Print("Test 1 OK", TRUE)\0a\0a /\\ IF  {1, 2, 3} # {i \\in {5, 4, 3, 2, 1} : i < 4}\0a      THEN Assert(FALSE, "Failed Test 2")\0a      ELSE Print("Test 2 OK", TRUE)\0a\0a /\\ IF {1, 2, 3} # {i-3 : i \\in {4, 6, 5, 6, 5, 6}}\0a      THEN Assert(FALSE, "Failed Test 3")\0a      ELSE Print("Test 3 OK", TRUE)\0a\0a /\\ IF SUBSET {1, 2, 3} # {{}, {1}, {2,1,2}, {3,1}, {2}, {3}, {3,2,3}, {1,2,3}}\0a      THEN Assert(FALSE, "Failed Test 4")\0a      ELSE Print("Test 4 OK", TRUE)\0a\0a /\\ IF {1,2,3} # UNION (SUBSET {1, 2, 3})\0a      THEN Assert(FALSE, "Failed Test 5")\0a      ELSE Print("Test 5 OK", TRUE)    \0a\0a /\\ IF {1,2,3} # UNION {{1}, {2}, {3, 2, 1}}\0a      THEN Assert(FALSE, "Failed Test 6")\0a      ELSE Print("Test 6 OK", TRUE)\0a\0a /\\ IF {1,2,3} # {1} \\cup {3, 2} \\cup {}\0a      THEN Assert(FALSE, "Failed Test 7")\0a      ELSE Print("Test 7 OK", TRUE)\0a\0a /\\ IF {1,2,3} # {5, 4, 3, 2, 1} \\cap {1, 3, 0, 2}\0a      THEN Assert(FALSE, "Failed Test 8")\0a      ELSE Print("Test 8 OK", TRUE)\0a\0a /\\ IF {1,2,3} \\subseteq {5, 3, 3, 4, 2}\0a      THEN Assert(FALSE, "Failed Test 9")\0a      ELSE Print("Test 9 OK", TRUE)\0a\0a /\\ IF {1,2,3} # {5, 3, 3, 4, 2,1} \\ {4, 5}\0a      THEN Assert(FALSE, "Failed Test 10")\0a      ELSE Print("Test 10 OK", TRUE)\0a\0a /\\ IF {1,2,3} # 1..3\0a      THEN Assert(FALSE, "Failed Test 11")\0a      ELSE Print("Test 11 OK", TRUE)\0a\0a /\\ IF {1,2,3} # DOMAIN <<"a", "b", "c">>\0a      THEN Assert(FALSE, "Failed Test 12")\0a      ELSE Print("Test 12 OK", TRUE)\0a\0a /\\ IF {1,2,3} # DOMAIN [i \\in {3,2,2,1} |-> i+1]\0a      THEN Assert(FALSE, "Failed Test 13")\0a      ELSE Print("Test 13 OK", TRUE)\0a\0a /\\ IF {"a", "b", "c"} # DOMAIN [a |-> 1, b |-> 2, c |-> 3]\0a      THEN Assert(FALSE, "Failed Test 14")\0a      ELSE Print("Test 14 OK", TRUE)\0a\0a /\\ IF {} # [{1, 2, 3} -> {}]\0a      THEN Assert(FALSE, "Failed Test 15")\0a      ELSE Print("Test 15 OK", TRUE)\0a\0a /\\ Print("Test Completed", TRUE)\0a\0aInit == x = 1\0a\0aNext == UNCHANGED x\0a=========================================\0a']]]
      ['suite/test10' 'test10' %accept ~[['test10' '--------------- MODULE test10 -------------\0a\0a(* Test of function definition and application *)\0a\0aEXTENDS Integers, TLC\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0af1[i \\in Int]  == i+2\0af2[i, j \\in Int] == i+j\0af3[i, j \\in Int, <<k,l>> \\in Int \\X Int, m \\in {5, 7,8}] == \0a        i + 2*j + 3*k + 4*l + 5*m\0af4[i, j \\in Int] == [a |-> i, b |-> j]\0a\0af5[i, j, k \\in Int] == i+j+k\0a\0af6[i, j, k \\in Int, <<l, m, n>> \\in Int \\X Int \\X Int, p \\in {5,7,8}] ==\0a        i + 2*j + 3*k + 4*l + 5*m + 6*n + 7*p\0a\0aInv  ==  \0a\0aLET r1 == [a |-> f1, b |-> f2]\0a    g1 == [f4 EXCEPT ![1,2].a = 22, ![1,3].b = 33]\0a    g2 == [[<<i, j>> \\in (1..10) \\X (1..10) \0a            |-> [a |-> i, b |-> j]] EXCEPT ![1,2].a = 22, ![1,3].b = 33]\0aIN\0a  /\\ IF f1[3] # 5\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF f2[3,4] # 7\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF f2[<<3,4>>] # 7\0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF f3[1, 2, <<3, 4>>, 5] # 55\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF f3[<<1, 2, <<3, 4>>, 5>>] # 55\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a\0a  /\\ IF [i \\in Int |-> i+2][3] # 5\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF [i, j \\in Int |-> i+j][3,4] # 7\0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF [i, j \\in Int |-> i+j][<<3,4>>] # 7\0a       THEN Assert(FALSE, "Test 8 Failed")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF [i, j \\in Int, <<k,l>> \\in Int \\X Int, m \\in {5,7,8} \0a         |-> i + 2*j + 3*k + 4*l + 5*m][1, 2, <<3, 4>>, 5] # 55\0a       THEN Assert(FALSE, "Test 9 Failed")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF [i, j \\in Int, <<k,l>> \\in Int \\X Int, m \\in {5,7,8} \0a         |-> i + 2*j + 3*k + 4*l + 5*m][<<1, 2, <<3, 4>>, 5>>] # 55\0a       THEN Assert(FALSE, "Test 10 Failed")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF [f1 EXCEPT ![3] = [i \\in Int |-> @ + i]][3][7] # 12\0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF [f1 EXCEPT ![3] = [i \\in Int |-> @ + i],  ![3][6] = 44][3][6] # 44\0a       THEN Assert(FALSE, "Test 12 Failed")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF [f1 EXCEPT ![3] = [i \\in Int |-> @ + i], ![3][6] = 44][3][7] # 12\0a       THEN Assert(FALSE, "Test 13 Failed")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0a  /\\ IF f4[3,4].a # 3\0a       THEN Assert(FALSE, "Test 14 Failed")\0a       ELSE Print("Test 14 OK", TRUE)\0a\0a  /\\ IF [f4 EXCEPT ![3,4].b = 17][3,4].b # 17\0a       THEN Assert(FALSE, "Test 15 Failed")\0a       ELSE Print("Test 15 OK", TRUE)\0a\0a  /\\ IF [f4 EXCEPT ![3,4].b = 17][3,4].a # 3\0a       THEN Assert(FALSE, "Test 16 Failed")\0a       ELSE Print("Test 16 OK", TRUE)\0a\0a  /\\ IF [f4 EXCEPT ![3,4].b = 17][2,4].b # 4\0a       THEN Assert(FALSE, "Test 17 Failed")\0a       ELSE Print("Test 17 OK", TRUE)\0a\0a  /\\ IF [f4 EXCEPT ![3,4].b = 17, ![3,4].a = 18][3,4].b # 17\0a       THEN Assert(FALSE, "Test 18 Failed")\0a       ELSE Print("Test 18 OK", TRUE)\0a\0a  /\\ IF [f4 EXCEPT ![3,4].b = 17, ![3,4].a = 18][3,4].a # 18\0a       THEN Assert(FALSE, "Test 19 Failed")\0a       ELSE Print("Test 19 OK", TRUE)\0a\0a  /\\ IF [f4 EXCEPT ![3,4].b = 17, ![3,4].a = 18, ![3,4].b= @+5][3,4].b # 22\0a       THEN Assert(FALSE, "Test 20 Failed")\0a       ELSE Print("Test 20 OK", TRUE)\0a\0a  /\\ IF [f4 EXCEPT ![3,4].b = 17, ![3,4].a = 18, ![<<3,4>>].b= @+5][3,4].b # 22\0a       THEN Assert(FALSE, "Test 21 Failed")\0a       ELSE Print("Test 21 OK", TRUE)\0a\0a  /\\ IF g1[1,3].a # 1 \\/ g1[1,3].a # 1\0a       THEN Assert(FALSE, "Test 22 Failed")\0a       ELSE Print("Test 22 OK", TRUE)\0a\0a  /\\ IF g2[1,3].a # 1 \\/ g2[1,3].a # 1\0a       THEN Assert(FALSE, "Test 23 Failed")\0a       ELSE Print("Test 23 OK", TRUE)\0a\0a  /\\ IF g1[1,2].a # 22 \\/ g1[1,2].a # 22\0a       THEN Assert(FALSE, "Test 24 Failed")\0a       ELSE Print("Test 24 OK", TRUE)\0a\0a  /\\ IF g2[1,2].a # 22 \\/ g2[1,2].a # 22\0a       THEN Assert(FALSE, "Test 25 Failed")\0a       ELSE Print("Test 25 OK", TRUE)\0a\0a  /\\ IF f5[3,4,5] # 12\0a       THEN Assert(FALSE, "Test 26 Failed")\0a       ELSE Print("Test 26 OK", TRUE)\0a\0a  /\\ IF f5[<<3,4,5>>] # 12\0a       THEN Assert(FALSE, "Test 27 Failed")\0a       ELSE Print("Test 27  OK", TRUE)\0a\0a  /\\ IF f6[1, 2, 3, <<4,5,6>>, 7] # 140\0a       THEN Assert(FALSE, "Test 28 Failed")\0a       ELSE Print("Test 28 OK", TRUE)\0a\0a  /\\ IF f6[<<1, 2, 3, <<4,5,6>>, 7>>] # 140\0a       THEN Assert(FALSE, "Test 29 Failed")\0a       ELSE Print("Test 29 OK", TRUE)\0a\0a  /\\ IF [i, j, k \\in Int |-> i+j+k][3,4,5] # 12\0a       THEN Assert(FALSE, "Test 30 Failed")\0a       ELSE Print("Test 30 OK", TRUE)\0a\0a  /\\ IF [i, j, k \\in Int |-> i+j+k][<<3,4,5>>] # 12\0a       THEN Assert(FALSE, "Test 31 Failed")\0a       ELSE Print("Test 31 OK", TRUE)\0a\0a\0a\0a\0a=========================================\0a']]]
      ['suite/test11' 'test11' %accept ~[['test11' '--------------- MODULE test11 -------------\0a\0a(* Test of DOMAIN and Function Sets *)\0a\0aEXTENDS Integers, TLC, FiniteSets\0a\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0af1[i \\in Int] == i+3\0a\0aS == [1..4 -> Nat]\0a\0aInv  ==  \0a  /\\ IF 5 \\notin DOMAIN f1\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF 5 \\notin DOMAIN [i \\in Int |-> i+3]\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF {1,2,3} \\notin DOMAIN [T \\in SUBSET Int |-> T \\cup {1}]\0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF Cardinality(DOMAIN [i \\in {1,3,5} |-> i+7]) # 3\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF Cardinality(DOMAIN [f \\in [{1,3,5} -> {1,2}] |-> f[3]]) # 8\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF Cardinality(DOMAIN [f \\in {g \\in [{1,3,5} -> {1,2}] : g[3]=1} \0a                              |-> f[3]]) # 4\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF [i \\in {1,3, 5} |-> i-2] \\notin \0a            {g \\in [{1,3,5} -> -2..3] : g[3]=1}\0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF ~ ((DOMAIN [a |-> 1, b |-> 2]) \\subseteq {"a", "b", "cde"})\0a       THEN Assert(FALSE, "Test 8 Failed")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF <<1, 2, 3, 4>> \\notin S\0a       THEN Assert(FALSE, "Test 9 Failed")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF <<1, 2, -3, 4>> \\in S\0a       THEN Assert(FALSE, "Test 10 Failed")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF <<1, 2, 4>> \\in S\0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF [i \\in {1, 2} |-> i] \\in S\0a       THEN Assert(FALSE, "Test 12 Failed")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF [i \\in {1, 2, 3, 4} |-> i+1] \\notin S\0a       THEN Assert(FALSE, "Test 13 Failed")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0a  /\\ IF [i \\in {1, 2, 3, 4} |-> i-2] \\in S\0a       THEN Assert(FALSE, "Test 14 Failed")\0a       ELSE Print("Test 14 OK", TRUE)\0a\0a  /\\ IF [i \\in 1..100 |-> i+1]    \\notin [1..100 -> Nat]\0a       THEN Assert(FALSE, "Test 15 Failed")\0a       ELSE Print("Test 15 OK", TRUE)\0a\0a  /\\ IF [i \\in 1..10  |-> i+1]    \\in [1..100 -> Nat]\0a       THEN Assert(FALSE, "Test 16 Failed")\0a       ELSE Print("Test 16 OK", TRUE)\0a\0a  /\\ IF [i \\in {99, 100} |-> i+1] \\in [1..100 -> Nat]\0a       THEN Assert(FALSE, "Test 17 Failed")\0a       ELSE Print("Test 17 OK", TRUE)\0a\0a  /\\ IF [i \\in {"a", "b"} |-> i]  \\in [1..100 -> Nat]\0a       THEN Assert(FALSE, "Test 18 Failed")\0a       ELSE Print("Test 18 OK", TRUE)\0a\0a  /\\ IF [a |-> 1, b |-> 2]        \\in [1..100 -> Nat]\0a       THEN Assert(FALSE, "Test 19 Failed")\0a       ELSE Print("Test 19 OK", TRUE)\0a\0a  /\\ Print("Test 20: Enumeration of [{1+1,2} -> {3-1,2,1+1}]", TRUE)\0a  /\\ \\A f \\in [{1+1,2} -> {3-1,2,1+1}] : Print(f, TRUE)\0a\0a  /\\ Print(<<"Test 21: evaluation of [{1+1,2} -> {3-1,2,1+1}] = ", \0a                [{1+1,2} -> {3-1,2,1+1}]>>, TRUE)\0a\0a  /\\ IF /\\ Cardinality ([0..1 -> 1..2000]) = 4000000\0a        /\\ Cardinality (1..8099) = 8099\0a       THEN Print("Test 22 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 22 Failed")\0a\0a  /\\ IF DOMAIN [i \\in {1,2}, j \\in {3,4} |-> i+j] # {1,2} \\X {3, 4}\0a       THEN Assert(FALSE, "Test 23 Failed")\0a       ELSE Print("Test 23 OK", TRUE)\0a\0a  /\\ IF DOMAIN [i \\in {1,2}, j \\in {3,4}, k \\in {5,6} |-> i+j+k] \0a                    # {1,2} \\X {3, 4} \\X {5, 6}\0a       THEN Assert(FALSE, "Test 24 Failed")\0a       ELSE Print("Test 24 OK", TRUE)\0a\0a  /\\ IF <<1,3,5>> \\notin \0a           DOMAIN [i \\in {1,2}, j \\in {3,4}, k \\in {5,6} |-> i+j+k] \0a       THEN Assert(FALSE, "Test 25 Failed")\0a       ELSE Print("Test 25 OK", TRUE)\0a=========================================\0a']]]
      ['suite/test12' 'test12' %accept ~[['test12' '--------------- MODULE test12 -------------\0a\0a(* Test of Record constructs. *)\0a\0aEXTENDS Integers, TLC, FiniteSets\0a\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0a\0aInv  ==  \0aLET r1 == [l1 |-> 1, l2 |-> 2, l3 |-> 3]\0a   r2 == [l1 |-> r1, l2 |-> [r1 EXCEPT !.l2 = 22], l3 |-> [r1 EXCEPT !.l3 = 33]]\0a   r3 == [l1 |-> [i \\in Int |-> i+1], \0a          l2 |-> [i , j \\in Int |-> [m1 |->i+2, m2 |-> j+3]]]\0a   \0a   r4 == [a |-> [i \\in 1..1 |-> i],\0a          b |-> [i \\in 1..1 |-> 2]]\0a\0a   S1 == [l1 : Int, l2 : [{1,2} -> {i \\in Int : i > 5}]]\0a   S2(j) == [l1 : {1,3}, l2 : {f \\in [{1,2} -> 1..10] : f[1] > j /\\ f[2] > j}]\0a   S3 == [l1 : Int, l2 : SUBSET [{1,2} -> {2,3}]]\0a\0aIN\0a  /\\ IF r1.l1 # 1 \\/ r1.l1 # 1\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF r1["l1"] # 1 \\/ r1["l1"] # 1\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF [l1 |-> 1, l2 |-> 2, l3 |-> 3].l1 # 1\0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF [l1 |-> 1, l2 |-> 2, l3 |-> 3]["l1"] # 1\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF [1l |-> 1, 2l |-> 2, 3l |-> 3]["2l"] # 2\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF r2.l1 # r1 \\/ r2.l1 # r1\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF r2.l2.l2 # 22 \\/ r2.l2.l2 # 22\0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF r2.l2.l1 # 1 \\/ r2.l2.l1 # 1\0a       THEN Assert(FALSE, "Test 8 Failed")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF [r2 EXCEPT !.l2.l1 = 44, !.l2.l3=55].l2.l1 # 44\0a       THEN Assert(FALSE, "Test 9 Failed")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF [r2 EXCEPT !.l2.l1 = 44, !.l2.l3=55].l2.l2 # 22\0a       THEN Assert(FALSE, "Test 10 Failed")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF r3.l2[5,6].m1 # 7 \\/ r3.l2[5,6].m1 # 7\0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF [i , j \\in Int |-> [m1 |->i+2, m2 |-> j+3]][5,6].m2 # 9\0a       THEN Assert(FALSE, "Test 12 Failed")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF r3.l2[5,6].m2 # 9 \\/ r3.l2[5,6].m2 # 9\0a       THEN Assert(FALSE, "Test 14 Failed")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0a  /\\ IF [l1 |-> 1, l2 |-> [i \\in {1,2} |-> i+5]] \\notin S1\0a       THEN Assert(FALSE, "Test 14 Failed")\0a       ELSE Print("Test 14 OK", TRUE)\0a\0a  /\\ IF [l1 |-> 1, l2 |-> [i \\in {1,2} |-> i+4]] \\in S1\0a       THEN Assert(FALSE, "Test 15 Failed")\0a       ELSE Print("Test 15 OK", TRUE)\0a\0a  /\\ IF ~(S2(5) \\subseteq S1) \\/ ~(S2(5) \\subseteq S1)\0a       THEN Assert(FALSE, "Test 16 Failed")\0a       ELSE Print("Test 16 OK", TRUE)\0a\0a  /\\ IF S2(4) \\subseteq S1 \\/ S2(4) \\subseteq S1\0a       THEN Assert(FALSE, "Test 17 Failed")\0a       ELSE Print("Test 17 OK", TRUE)\0a  /\\ IF Cardinality(S2(5)) # 50 \\/ Cardinality(S2(5)) # 50\0a       THEN Assert(FALSE, "Test 18 Failed")\0a       ELSE Print("Test 18 OK", TRUE)\0a\0a  /\\ IF Cardinality([l1 : {1,2}, \0a                     l2 : {1, 2, 3, 4, 4, 4, 4}, l3 : {3, 3, 2, 1}]) # 24\0a       THEN Assert(FALSE, "Test 19 Failed")\0a       ELSE Print("Test 19 OK", TRUE)\0a\0a  /\\ IF ~(\\A r \\in S2(5) : r.l2[1] > 5) \\/ ~(\\A r \\in S2(5) : r.l2[1] > 5)\0a       THEN Assert(FALSE, "Test 20 Failed")\0a       ELSE Print("Test 20 OK", TRUE)\0a\0a  /\\ IF [l1 |-> -4, l2 |-> {<<3,2>>}] \\notin S3\0a       THEN Assert(FALSE, "Test 21 Failed")\0a       ELSE Print("Test 21 OK", TRUE)\0a\0a  /\\ IF [l1 |-> -4, l2 |-> {<<3,4>>}] \\in S3\0a       THEN Assert(FALSE, "Test 22 Failed")\0a       ELSE Print("Test 22 OK", TRUE)\0a\0a  /\\ IF [r4 EXCEPT !["a"][1] = 2]["a"][1] # 2\0a       THEN Assert(FALSE, "Test 23 Failed")\0a       ELSE Print("Test 23 OK", TRUE)\0a\0a=========================================\0a']]]
      ['suite/test13' 'test13' %accept ~[['test13' '--------------- MODULE test13 -------------\0a\0a(* Test of Tuples and Cartesian products. *)\0a\0aEXTENDS Integers, TLC, FiniteSets, Sequences\0a\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0aInv  ==  \0aLET S1 == {1,2,3} \\X {"a", "b", "c", "d"}\0a    S2 == Int \\X [{1,2,3} -> {4, 5, 6}]\0a    S3 == {1,2,3} \\X {"a", "b", "c", "d"} \\X {4,5}\0a    S4 == Int \\X [{1,2,3} -> {4, 5, 6}] \\X Seq(Int)\0a\0aIN\0a  /\\ IF Cardinality(S1) # 12 \\/ Cardinality(S3) # 24\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF \\/ <<-5, <<4,4,4>> >> \\notin S2\0a        \\/ <<-5, <<4,4,4>>, <<-1,-2,-3>> >>  \\notin S4\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF <<-5, -4>> \\notin Int \\X Int\0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF <<-5, <<4,4,3>>>> \\in S2\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF {<<"a", "b", "c">>[i] : i \\in 1..3} \0a          # DOMAIN [a |-> 1, b |-> 2, c |-> {}]\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF [i \\in {1, 2} |-> IF i = 1 THEN "a" ELSE 22] # <<"a", 22>>\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF [i \\in {1, 2} |-> IF i = 1 THEN "a" ELSE 22] =  <<"a", 23>>\0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF <<1,2>> \\notin Seq(Int)\0a       THEN Assert(FALSE, "Test 8 Failed")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF <<1,2>> \\notin Seq({n \\in Int : n < 22})\0a       THEN Assert(FALSE, "Test 9 Failed")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF <<1,2>> \\in Seq({n \\in Int : n > 22})\0a       THEN Assert(FALSE, "Test 9 Failed")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF <<-5, -4, -3>> \\notin Int \\X Int \\X Int\0a       THEN Assert(FALSE, "Test 10 Failed")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF <<-5, <<4,4,3>>, <<1,-1>> >> \\in S4\0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a =========================================\0a']]]
      ['suite/test14' 'test14' %accept ~[['test14' '--------------- MODULE test14 -------------\0a\0a(* Test of IF and CASE and nested junctions *)\0a\0aEXTENDS Integers, TLC, FiniteSets, Sequences\0a\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0aInv  ==  \0a\0a  /\\ IF (IF TRUE THEN IF FALSE THEN 3 ELSE 2 ELSE 1) # 2\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF (CASE FALSE -> 1 [] TRUE -> CASE FALSE -> 2 [] TRUE -> 3 [] OTHER -> 4)\0a          # 3\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF (CASE FALSE -> 1 [] FALSE -> CASE FALSE -> 2 [] TRUE -> 3 \0a               [] OTHER -> 4 [] TRUE -> 5) # 5\0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF (CASE FALSE -> 1 [] TRUE -> CASE FALSE -> 2 [] FALSE -> 3 \0a          [] OTHER -> 4 [] TRUE -> 5) # 4\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF (CASE FALSE -> 1 [] FALSE -> CASE TRUE -> 2 [] TRUE -> 3 \0a                 [] OTHER -> 4 [] OTHER -> 5) # 5\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF (CASE TRUE -> 1 [] TRUE -> CASE TRUE -> 2 [] TRUE -> 3 \0a            [] OTHER -> 4 [] OTHER -> 5) \\notin {1, 2, 3}\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF  ~ \\/ /\\ 1=3\0a              /\\ "a" = 1\0a           \\/ /\\ 1 = 2\0a              /\\ "b" = 1\0a           \\/ /\\ 1 = 1\0a              /\\ 2 = 2\0a           \\/ "c" = 1\0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a=========================================\0a']]]
      ['suite/test15' 'test15' %accept ~[['test15' '--------------- MODULE test15 -------------\0a(* Test of handling the empty set *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0a\0a\0aInv ==  \0a  /\\ IF SUBSET {} # {{}}\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF UNION {} # {}\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF {y \\in {} : y = y} # {}\0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF [y \\in {} |-> y] # << >>\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF (\\E S \\in {} : TRUE) # FALSE\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF (\\A S \\in {} : FALSE) # TRUE\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF DOMAIN <<>> # {}\0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF 1..0 # {}\0a       THEN Assert(FALSE, "Test 8 Failed")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF <<>> \\notin Seq({})\0a       THEN Assert(FALSE, "Test 9 Failed")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF <<{}>> \\in Seq ({})\0a       THEN Assert(FALSE, "Test 10 Failed")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF \\E S \\in SUBSET {} : S # {}\0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a  /\\ IF [{} -> {1, 2, 3}] # {<<>>}\0a       THEN Assert(FALSE, "Test 12 Failed")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF [{1, 2, 3} -> {}] # {}\0a       THEN Assert(FALSE, "Test 13 Failed")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0a\0a  /\\ IF (UNION {{1,2,3}, {}}) # (UNION {{1,2,3}}) \0a       THEN Assert(FALSE, "Test 14 Failed")\0a       ELSE Print("Test 14 OK", TRUE)\0a\0a  /\\ IF 1..0 # {}\0a       THEN Assert(FALSE, "Test 15 Failed")\0a       ELSE Print("Test 15 OK", TRUE)\0a\0a  /\\ IF 1..0 # 5..2\0a       THEN Assert(FALSE, "Test 16 Failed")\0a       ELSE Print("Test 16 OK", TRUE)\0a\0a=========================================\0a']]]
      ['suite/test16' 'test16' %accept ~[['test16' '--------------- MODULE test16 -------------\0a(* Test of handling of one-tuples *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0aS == {<<y>> : y \\in {1, 2, 3, 4}}\0a\0aInv ==  \0a\0a  /\\ IF <<1>> \\notin S\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF ~(\\E <<y>> \\in S : y = 2) \0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF ~(\\E y \\in S : y[1] = 2) \0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF {<<y>> \\in S : y > 3} # {<<4>>}\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF <<1>> \\o <<2>> # <<1, 2>>\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF [<<y>> \\in S |-> y+1][<<2>>] # 3\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a\0a=========================================\0a']]]
      ['suite/test17' 'test17' %accept ~[['test17' '--------------- MODULE test17 -------------\0a\0a(* Test of handling of handling expressions with primes. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x, y\0a\0aInit == /\\ Print("There should be two distinct states", TRUE)\0a        /\\ x = 1\0a        /\\ y = 1\0a\0af[i \\in Nat ] == x\'+ x + 2*i\0ag == [i \\in {x\'} |-> x+i]\0a\0a\0aFoo(a) == a\' = x+1\0a\0aInv == TRUE\0a\0aTNext == \0a  /\\ x\' = x+1\0a  /\\ x\' = 2\0a  /\\ \\/ UNCHANGED y\0a\0a     \\/ /\\ Print("Starting Test 1", TRUE)\0a        /\\ y\' = IF x\' = 2 \0a                  THEN 1 \0a                   ELSE Assert(FALSE, "Failed Test 1")\0a\0a     \\/ /\\ Print("Starting Test 2", TRUE)\0a        /\\ IF x\' = 2 \0a             THEN y\' = 1 \0a             ELSE Assert(FALSE, "Failed Test 2")\0a\0a     \\/ /\\ Print("Starting Test 3", TRUE)\0a        /\\ x\' # 2\0a        /\\ Assert(FALSE, "Failed Test 3")\0a\0a     \\/ /\\ Print("Starting Test 4", TRUE)\0a        /\\ ~(\\E i \\in {x\'} : i = 2)\0a        /\\ Assert(FALSE, "Failed Test 4")\0a\0a     \\/ /\\ Print("Starting Test 5", TRUE)\0a        /\\ ~ (\\A i \\in {x\'} : i = 2)\0a        /\\ Assert(FALSE, "Failed Test 5")\0a\0a     \\/ /\\ Print("Starting Test 6", TRUE)\0a        /\\ (CHOOSE i \\in {x\'} : TRUE) # 2\0a        /\\ Assert(FALSE, "Failed Test 6")\0a\0a     \\/ /\\ Print("Starting Test 7", TRUE)\0a        /\\ 2 \\notin {x\'}\0a        /\\ Assert(FALSE, "Failed Test 7")\0a\0a     \\/ /\\ Print("Starting Test 8", TRUE)\0a        /\\ {i \\in {x\'} : TRUE} # {2}\0a        /\\ Assert(FALSE, "Failed Test 8")\0a\0a     \\/ /\\ Print("Starting Test 9", TRUE)\0a        /\\ {i\' : i \\in {x\'}} # {2}\0a        /\\ Assert(FALSE, "Failed Test 9")\0a\0a     \\/ /\\ Print("Starting Test 10", TRUE)\0a        /\\ {2} \\notin SUBSET {x\'}\0a        /\\ Assert(FALSE, "Failed Test 10")\0a\0a     \\/ /\\ Print("Starting Test 11", TRUE)\0a        /\\ {2} # UNION {{x\'}, {}}\0a        /\\ Assert(FALSE, "Failed Test 11")\0a\0a     \\/ /\\ Print("Starting Test 12", TRUE)\0a        /\\ f[1] # 5\0a        /\\ Assert(FALSE, "Failed Test 12")\0a\0a     \\/ /\\ Print("Starting Test 13", TRUE)\0a        /\\ f[x\'] # 7\0a        /\\ Assert(FALSE, "Failed Test 13")\0a\0a     \\/ /\\ Print("Starting Test 14", TRUE)\0a        /\\ [f EXCEPT ![x\'] = x\'+x+3][2] # 6\0a        /\\ Assert(FALSE, "Failed Test 14")\0a\0a     \\/ /\\ Print("Starting Test 15", TRUE)\0a        /\\ [f EXCEPT ![2] = x\'+x+3][x\'] # 6\0a        /\\ Assert(FALSE, "Failed Test 15")\0a\0a     \\/ /\\ Print("Starting Test 16", TRUE)\0a        /\\ [{x\'-1} -> {x\'}] # {<<2>>}\0a        /\\ Assert(FALSE, "Failed Test 16")\0a\0a     \\/ /\\ Print("Starting Test 17", TRUE)\0a        /\\ [{x\',x} -> {x\'}] # {<<2, 2>>}\0a        /\\ Assert(FALSE, "Failed Test 17")\0a\0a     \\/ /\\ Print("Starting Test 18", TRUE)\0a        /\\ [{x\',x} -> {x}] # {<<1, 1>>}\0a        /\\ Assert(FALSE, "Failed Test 18")\0a\0a     \\/ /\\ Print("Starting Test 19", TRUE)\0a        /\\ x\'=2 => x\'=3\0a        /\\ Assert(FALSE, "Failed Test 19")\0a\0a     \\/ /\\ Print("Starting Test 20", TRUE)\0a        /\\ CASE x\'= x+1 -> FALSE\0a             [] x\'# x+1 -> TRUE\0a        /\\ Assert(FALSE, "Failed Test 20")\0a\0a     \\/ /\\ Print("Starting Test 21", TRUE)\0a        /\\ DOMAIN g # {2}\0a        /\\ Assert(FALSE, "Failed Test 21")\0a\0a     \\/ /\\ Print("Starting Test 22", TRUE)\0a        /\\ g[2] # 3\0a        /\\ Assert(FALSE, "Failed Test 22")\0a\0a     \\/ /\\ Print("Starting Test 23", TRUE)\0a        /\\ CASE x\' # 2 -> Assert(FALSE, "Failed Test 23")\0a             [] x\' = 2 -> y\' = 1\0a\0a     \\/ /\\ Print("Starting Test 24", TRUE)\0a        /\\ ~Foo(x)\0a        /\\ Assert(FALSE, "Failed Test 24")\0a\0a     \\/ /\\ Print("Starting Test 25", TRUE)\0a        /\\ ~Foo(x)\0a        /\\ Assert(FALSE, "Failed Test 25")\0a\0a\0aNext == TNext \\/ UNCHANGED <<x, y>>\0a=========================================\0a']]]
      ['suite/test18' 'test18' %accept ~[['test18' '--------------- MODULE test18 -------------\0a\0a(* Test of fingerprinting. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x, y, z, w, u\0a\0af == [i \\in {1,2}, j \\in {3,4} |-> i+j]\0ag == [p \\in {1,2} \\X {3,4} |-> p[1] + p[2]]\0am == [i \\in {3,4} |-> <<i, 7>>]\0a\0aInit == /\\ Print("There should be only one distinct state", TRUE)\0a        /\\ x = [a |-> 1, b |-> 2]\0a        /\\ y = <<3, 4>>\0a        /\\ z = {1, 2, 3}\0a        /\\ w = f\0a        /\\ u = [m EXCEPT ![4] = <<4, 8>>]\0a        /\\ IF y # [i \\in {1, 2} |-> IF i = 1 THEN 3 ELSE 4]\0a             THEN Print("Error in comparing seq and fcn", TRUE)\0a             ELSE TRUE\0a        \0a\0aInv == /\\ TRUE\0a\0aNext == \0a  \\/ UNCHANGED <<x, y, z, w, u>>\0a\0a  \\/ /\\ x\' = [i \\in {"a", "b"} |-> IF i = "a" THEN 1 ELSE 2]\0a     /\\ UNCHANGED <<y, z, w, u>>\0a\0a  \\/ /\\ y\' = [i \\in {1, 2} |-> IF i = 1 THEN 3 ELSE 4]\0a     /\\ UNCHANGED <<x, z, w, u>>\0a\0a  \\/ /\\ y\' = <<3>> \\o <<4>>\0a     /\\ UNCHANGED <<x, z, w, u>>  \0a\0a  \\/ /\\ y\' = [y EXCEPT ![2]=4]\0a     /\\ UNCHANGED <<x, z, w, u>>\0a\0a  \\/ /\\ y\' = [<<3, 7>> EXCEPT ![2]=4]\0a     /\\ UNCHANGED <<x, z, w, u>>\0a\0a  \\/ /\\ y\' = <<3>> \\o <<4>>\0a     /\\ UNCHANGED <<x, z, w, u>>\0a\0a  \\/ /\\ z\' = {3, 3, 2, 2, 1}\0a     /\\ UNCHANGED <<x, y, w, u>>\0a\0a  \\/ /\\ z\' = 1..3\0a     /\\ UNCHANGED <<x, y, w, u>>\0a\0a  \\/ /\\ z\' = {i - 3 : i \\in {4, 5, 6, 4, 5}}\0a     /\\ UNCHANGED <<x, y, w, u>>\0a\0a  \\/ /\\ z\' = DOMAIN <<"a", "b", 4>>\0a     /\\ UNCHANGED <<x, y, w, u>>\0a\0a  \\/ /\\ w\' = g\0a     /\\ UNCHANGED <<x, y, z, u>>\0a\0a  \\/ /\\ u\' = [m EXCEPT ![4][2] = @+1]\0a     /\\ UNCHANGED <<x, y, z, w>>         \0a=========================================\0a']]]
      ['suite/test19' 'test19' %accept ~[['test19' '--------------- MODULE test19 -------------\0a\0a(* Test of large initial state space *)\0a\0aEXTENDS Naturals, Sequences\0a\0aVARIABLE x, y, z \0aInit == /\\ x \\in 1..100\0a        /\\ y \\in 1..200\0a        /\\ z \\in 1..20\0a\0aNext == UNCHANGED <<x, y, z>>\0a\0aInv == TRUE\0a=========================================\0a']]]
      ['suite/test2' 'test2' %accept ~[['test2' '--------------- MODULE test2 -------------\0a\0a(* test equality of various representations of functions. *)\0a\0aEXTENDS Naturals, TLC\0a\0aVARIABLE x\0aCONSTANT a, b, c\0af == [i \\in {1,2}, j \\in {3,4} |-> i+j]\0ag == [p \\in {1,2} \\X {3,4} |-> p[1] + p[2]]\0ah == [i \\in {1,2} |-> [j \\in {3,4} |-> i+j]]\0a\0am == [i \\in {3,4} |-> <<i, 7>>]\0a\0a\0aType == x \\in {1}\0aInv  == \0a /\\ TRUE\0a\0a /\\ IF [i \\in {3, 2, 1} |-> i+2] # <<3, 4, 5>>\0a      THEN Assert(FALSE, "Failed Test 1") \0a      ELSE Print("Test 1 OK", TRUE)\0a\0a /\\ IF [i \\in {"a", "b", "c"} |-> \0a         CASE i = "a" -> 1 [] i = "b" -> 2 [] i = "c" -> 3]\0a         # [c |-> 3, a |-> 1, b |-> 2]\0a      THEN Assert(FALSE, "Failed Test 2")\0a      ELSE Print("Test 2 OK", TRUE)\0a\0a /\\ IF [c |-> 3, a |-> 1, b |-> 2] # \0a        [[a |-> 1, b |-> 3, c |-> 4] EXCEPT !.b =2 , !.c=3]\0a      THEN Assert(FALSE, "Failed Test 3") \0a      ELSE Print("Test 3 OK", TRUE)\0a\0a /\\ IF <<3, 4, 5>> # [<<3, 42, 75>> EXCEPT ![3]=5, ![2]=4]\0a      THEN Assert(FALSE, "Failed Test 4") \0a      ELSE Print("Test 4 OK", TRUE)\0a\0a /\\ IF [i \\in {3, 2, 1} |-> i+2] # [ j \\in 1..3 |-> j+2]\0a      THEN Assert(FALSE, "Failed Test 5") \0a      ELSE Print("Test 5 OK", TRUE)\0a\0a /\\ IF [i \\in {} |-> i] # <<>>\0a      THEN Assert(FALSE, "Failed Test 6") \0a      ELSE Print("Test 6 OK", TRUE)\0a\0a /\\ IF {i \\in [{1,2} -> {a, b, c}] : i[1] = a} # {<<a, a>>, <<a, b>>, <<a, c>>}\0a      THEN Assert(FALSE, "Failed Test 7") \0a      ELSE Print("Test 7 OK", TRUE)\0a\0a /\\ IF [{"a", "bc"} -> {1, 2, 3}] # [bc : {1,2,3}, a : {1,2,3}]\0a      THEN Assert(FALSE, "Failed Test 8") \0a      ELSE Print("Test 8 OK", TRUE)\0a\0a /\\ IF f # g\0a      THEN Assert(FALSE, "Test 9 Failed")\0a      ELSE Print("Test 9 OK", TRUE)\0a\0a /\\ IF f = h\0a      THEN Assert(FALSE, "Test 10 Failed")\0a      ELSE Print("Test 10 OK", TRUE)\0a\0a /\\ IF [m EXCEPT ![4] = <<4, 8>>] # [m EXCEPT ![4][2] = @+1]\0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a /\\ IF m#[m EXCEPT ![4][2] = 7]\0a       THEN Assert(FALSE, "Test 12 Failed")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a /\\ IF f # [f EXCEPT ![1,3] = 4]\0a       THEN Assert(FALSE, "Test 13 Failed")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0aInit == x = 1\0a\0aNext == UNCHANGED x\0a=========================================\0a']]]
      ['suite/test20' 'test20' %accept ~[['test20' '--------------- MODULE test20 -------------\0a\0a(* Test of ENABLED *)\0a\0aEXTENDS Naturals, Sequences, TLC\0a\0aVARIABLE x, y\0a\0aInit == x = 1 /\\ y = 1\0a\0aStep(p) == x\' = p\0a\0aFoo(A) == ENABLED((x\' = x) /\\ (A\'=x+1))\0a\0aNext == \0a  \\/ /\\ x\'=x\0a     /\\ y\'=y\0a\0a  \\/ /\\ Print("Test N1 begun", TRUE)\0a     /\\ ~ENABLED (x\'=2)\0a     /\\ Assert(FALSE, "Test N1 Failed")\0a\0a  \\/ IF ENABLED (x\'=2)\0a       THEN /\\ Print("Test N2 Passed", TRUE)\0a            /\\ UNCHANGED <<x, y>>\0a       ELSE Assert(FALSE, "Test N2 Failed")\0a  \\/ IF ENABLED Step(17)\0a       THEN /\\ Print("Test N3 Passed", TRUE)\0a            /\\  UNCHANGED <<x, y>>\0a       ELSE Assert(FALSE, "Test N3 Failed")\0a\0a  \\/ IF \\A p \\in 1..3 : ENABLED Step(p)\0a       THEN /\\ Print("Test N4 Passed", TRUE)\0a            /\\  UNCHANGED <<x, y>>\0a       ELSE Assert(FALSE, "Test N4 Failed")\0a\0aInv == \0a  /\\ IF ENABLED <<x\'=1 /\\ y\'=y>>_<<x,y>>\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF ~ ENABLED (x\'="a" /\\ y\'=y)\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF ENABLED (x > 2)\0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF ~ENABLED (x=1)\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF ENABLED ((x > 2) /\\ Next)\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF ~ENABLED ((x=1) /\\ Next)\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF ~ ENABLED (x\'=1) \0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF Foo(x)\0a       THEN Assert(FALSE, "Test 8 Failed")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ LET A == x\0a     IN  IF Foo(A) \0a           THEN Assert(FALSE, "Test 9 Failed")\0a           ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF ~Foo(y) \0a       THEN Assert(FALSE, "Test 10 Failed")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ LET A == x\0a     IN  IF ~Foo(y) \0a           THEN Assert(FALSE, "Test 11 Failed")\0a           ELSE Print("Test 11 OK", TRUE)\0a\0a\0a=========================================\0a']]]
      ['suite/test201' 'test201' %accept ~[['test201' '-------------------- MODULE test201 ----------------\0a\\* Test of lambda expressions\0a\0aEXTENDS Naturals, TLC\0aOp(A(_)) == A(4)\0a\0abar == Op(LAMBDA x : x^2)\0a\0aASSUME /\\ Op(LAMBDA x : {x,2} ) = {4,2}\0a       /\\ PrintT("Test1 OK")\0a\0aASSUME /\\ bar = 16 \0a       /\\ PrintT("Test2 OK")\0a\0afoo == INSTANCE test201a WITH A <- LAMBDA y : y^3, b <- 4\0a\0aASSUME /\\ foo!def = 64\0a       /\\ PrintT("Test201 OK")\0a=================================================\0a\0a'] ['test201a' '-------------------- MODULE test201a ----------------\0a\0aCONSTANT A(_), b\0a\0adef == A(b)\0a\0a=============================================================================']]]
      ['suite/test201a' 'test201a' %accept ~[['test201a' '-------------------- MODULE test201a ----------------\0a\0aCONSTANT A(_), b\0a\0adef == A(b)\0a\0a=============================================================================']]]
      ['suite/test202' 'test202' %accept ~[['test202' '-------------------- MODULE test202 ----------------\0a\\* Test of recursion\0a\0aEXTENDS Naturals, TLC\0a\0aRECURSIVE g(_)\0af(a) == IF a = 0 THEN 1 ELSE a * g(a-1)\0ag(a) == f(a) \0a\0a\0aASSUME /\\ f(0) = 1\0a       /\\ f(4) = 24\0a       /\\ \\A i \\in 1..5 : f(i) = i * f(i-1)\0a       /\\ PrintT("Test 1 OK")\0a\0aASSUME /\\ g(0) = 1\0a       /\\ g(4) = 24\0a       /\\ \\A i \\in 1..5 : g(i) = i * g(i-1)\0a       /\\ PrintT("Test 2 OK")\0a\0aRECURSIVE fact\0afact1[n \\in Nat] == fact[n]\0afact[n \\in Nat] == IF n = 0 THEN 1 ELSE n * fact1[n-1]\0a\0aASSUME /\\ fact1[3] = 6\0a       /\\ fact[4] = 24\0a       /\\ \\A i \\in 0..5 : fact[i] = g(i)     \0a       /\\ PrintT("Test 3 OK")\0a\0a\0a=================================================\0a\0a']]]
      ['suite/test203' 'test203' %accept ~[['test203' '-------------------- MODULE test203 ----------------\0a\\* Test of recursion\0a\0aEXTENDS Naturals, TLC\0a\0aRECURSIVE g(_)\0a\0afoo(n) == INSTANCE test203a WITH A <- g, b <- n\0a\0ag(n) == IF n = 0 THEN 1 ELSE n * foo(n-1)!h\0a\0aASSUME /\\ g(0) = 1\0a       /\\ g(4) = 24\0a       /\\ \\A i \\in 1..5 : g(i) = i * g(i-1)\0a       /\\ PrintT("Test1 OK")\0a=================================================\0a\0a'] ['test203a' '-------------------- MODULE test203a ----------------\0a\0aCONSTANT A(_), b\0a\0ah == A(b) \0a\0a\0a=============================================================================']]]
      ['suite/test203a' 'test203a' %accept ~[['test203a' '-------------------- MODULE test203a ----------------\0a\0aCONSTANT A(_), b\0a\0ah == A(b) \0a\0a\0a=============================================================================']]]
      ['suite/test204' 'test204' %accept ~[['test204' '--------------- MODULE test204 -------------\0a\0a(***************************************************************************)\0a(* Test definability and use of all user-defined operators as prefix       *)\0a(* operators, as in +(a, b).  It does not work with binary minus.          *)\0a(***************************************************************************)\0a\0az - y == <<1, z, y>>\0a\\* ASSUME -(4, 6) = <<1, 4, 6>>\0az + y == <<2, z, y>>\0aASSUME +(4, 6) = <<2, 4, 6>>\0az * y == <<3, z, y>>\0aASSUME *(4, 6) = <<3, 4, 6>>\0az / y == <<4, z, y>>\0aASSUME /(4, 6) = <<4, 4, 6>>\0az ^ y == <<5, z, y>>\0aASSUME ^(4, 6) = <<5, 4, 6>>\0az < y == <<6, z, y>>\0aASSUME <(4, 6) = <<6, 4, 6>>\0az > y == <<7, z, y>>\0aASSUME >(4, 6) = <<7, 4, 6>>\0az .. y == <<8, z, y>>\0aASSUME ..(4, 6) = <<8, 4, 6>>\0az ... y == <<9, z, y>>\0aASSUME ...(4, 6) = <<9, 4, 6>>\0az | y == <<10, z, y>>\0aASSUME |(4, 6) = <<10, 4, 6>>\0az || y == <<11, z, y>>\0aASSUME ||(4, 6) = <<11, 4, 6>>\0az & y == <<12, z, y>>\0aASSUME &(4, 6) = <<12, 4, 6>>\0az && y == <<13, z, y>>\0aASSUME &&(4, 6) = <<13, 4, 6>>\0az $ y == <<14, z, y>>\0aASSUME $(4, 6) = <<14, 4, 6>>\0az $$ y == <<15, z, y>>\0aASSUME $$(4, 6) = <<15, 4, 6>>\0az ?? y == <<16, z, y>>\0aASSUME ??(4, 6) = <<16, 4, 6>>\0az %% y == <<17, z, y>>\0aASSUME %%(4, 6) = <<17, 4, 6>>\0az ## y == <<18, z, y>>\0aASSUME ##(4, 6) = <<18, 4, 6>>\0az ++ y == <<19, z, y>>\0aASSUME ++(4, 6) = <<19, 4, 6>>\0az -- y == <<20, z, y>>\0aASSUME --(4, 6) = <<20, 4, 6>>\0az ** y == <<21, z, y>>\0aASSUME **(4, 6) = <<21, 4, 6>>\0az // y == <<22, z, y>>\0aASSUME //(4, 6) = <<22, 4, 6>>\0az ^^ y == <<23, z, y>>\0aASSUME ^^(4, 6) = <<23, 4, 6>>\0az @@ y == <<23, z, y>> \0aASSUME @@(4, 6) = <<23, 4, 6>>\0az !! y == <<24, z, y>>\0aASSUME !!(4, 6) = <<24, 4, 6>>\0az |- y == <<25, z, y>>\0aASSUME |-(4, 6) = <<25, 4, 6>>\0az |= y == <<26, z, y>>\0aASSUME |=(4, 6) = <<26, 4, 6>>\0az -| y == <<27, z, y>>\0aASSUME -|(4, 6) = <<27, 4, 6>>\0az =| y == <<28, z, y>>\0aASSUME =|(4, 6) = <<28, 4, 6>>\0az <: y == <<29, z, y>>\0aASSUME <:(4, 6) = <<29, 4, 6>>\0az :> y == <<29, z, y>>\0aASSUME :>(4, 6) = <<29, 4, 6>>\0az := y == <<30, z, y>>\0aASSUME :=(4, 6) = <<30, 4, 6>>\0az ::= y == <<31, z, y>>\0aASSUME ::=(4, 6) = <<31, 4, 6>>\0az \\uplus y == <<32, z, y>>\0aASSUME \\uplus(4, 6) = <<32, 4, 6>>\0az \\sqcap y == <<33, z, y>>\0aASSUME \\sqcap(4, 6) = <<33, 4, 6>>\0az \\sqcup y == <<34, z, y>>\0aASSUME \\sqcup(4, 6) = <<34, 4, 6>>\0az \\div y == <<35, z, y>>\0aASSUME \\div(4, 6) = <<35, 4, 6>>\0az \\wr y == <<36, z, y>>\0aASSUME \\wr(4, 6) = <<36, 4, 6>>\0az \\star y == <<37, z, y>>\0aASSUME \\star(4, 6) = <<37, 4, 6>>\0az \\bigcirc y == <<38, z, y>>\0aASSUME \\bigcirc(4, 6) = <<38, 4, 6>>\0az \\bullet y == <<39, z, y>>\0aASSUME \\bullet(4, 6) = <<39, 4, 6>>\0az \\prec y == <<40, z, y>>\0aASSUME \\prec(4, 6) = <<40, 4, 6>>\0az \\succ y == <<41, z, y>>\0aASSUME \\succ(4, 6) = <<41, 4, 6>>\0az \\preceq y == <<42, z, y>>\0aASSUME \\preceq(4, 6) = <<42, 4, 6>>\0az \\succeq y == <<43, z, y>>\0aASSUME \\succeq(4, 6) = <<43, 4, 6>>\0az \\sim y == <<44, z, y>>\0aASSUME \\sim(4, 6) = <<44, 4, 6>>\0az \\simeq y == <<45, z, y>>\0aASSUME \\simeq(4, 6) = <<45, 4, 6>>\0az \\ll y == <<46, z, y>>\0aASSUME \\ll(4, 6) = <<46, 4, 6>>\0az \\gg y == <<47, z, y>>\0aASSUME \\gg(4, 6) = <<47, 4, 6>>\0az \\asymp y == <<48, z, y>>\0aASSUME \\asymp(4, 6) = <<48, 4, 6>>\0az \\subset y == <<49, z, y>>\0aASSUME \\subset(4, 6) = <<49, 4, 6>>\0az \\supset y == <<50, z, y>>\0aASSUME \\supset(4, 6) = <<50, 4, 6>>\0az \\supseteq y == <<51, z, y>>\0aASSUME \\supseteq(4, 6) = <<51, 4, 6>>\0az \\approx y == <<52, z, y>>\0aASSUME \\approx(4, 6) = <<52, 4, 6>>\0az \\cong y == <<53, z, y>>\0aASSUME \\cong(4, 6) = <<53, 4, 6>>\0az \\sqsubset y == <<54, z, y>>\0aASSUME \\sqsubset(4, 6) = <<54, 4, 6>>\0az \\sqsupset y == <<55, z, y>>\0aASSUME \\sqsupset(4, 6) = <<55, 4, 6>>\0az \\sqsubseteq y == <<56, z, y>>\0aASSUME \\sqsubseteq(4, 6) = <<56, 4, 6>>\0az \\sqsupseteq y == <<57, z, y>>\0aASSUME \\sqsupseteq(4, 6) = <<57, 4, 6>>\0az \\doteq y == <<58, z, y>>\0aASSUME \\doteq(4, 6) = <<58, 4, 6>>\0az \\propto y == <<59, z, y>>\0aASSUME \\propto(4, 6) = <<59, 4, 6>>\0a\0az ^+ == <<60, z>>\0aASSUME ^+(4) = <<60, 4>>\0az ^* == <<61, z>>\0aASSUME ^*(4) = <<61, 4>>\0az ^# == <<62, z>>\0aASSUME ^#(4) = <<62, 4>>\0a-. z == <<63, z>>\0aASSUME -.(4) = <<63, 4>>\0a\0az \\leq y == <<64, z, y>>\0aASSUME \\leq(4, 6) = <<64, 4, 6>>\0aASSUME <=(4, 6) = <<64, 4, 6>>\0aASSUME =<(4, 6) = <<64, 4, 6>>\0a\0az \\geq y == <<65, z, y>>\0aASSUME \\geq(4, 6) = <<65, 4, 6>>\0aASSUME >=(4, 6) = <<65, 4, 6>>\0a\0az \\oplus y == <<66, z, y>>\0aASSUME \\oplus(4, 6) = <<66, 4, 6>>\0aASSUME (+) (4, 6) = <<66, 4, 6>>\0a\0az \\ominus y == <<67, z, y>>\0aASSUME \\ominus(4, 6) = <<67, 4, 6>>\0aASSUME (-) (4, 6) = <<67, 4, 6>>\0a\0a\0az \\odot y == <<68, z, y>>\0aASSUME \\odot(4, 6) = <<68, 4, 6>>\0aASSUME (.) (4, 6) = <<68, 4, 6>>\0a\0az \\otimes y == <<69, z, y>>\0aASSUME \\otimes(4, 6) = <<69, 4, 6>>\0aASSUME (\\X) (4, 6) = <<69, 4, 6>>\0a\0az \\oslash y == <<70, z, y>>\0aASSUME \\oslash(4, 6) = <<70, 4, 6>>\0aASSUME (/) (4, 6) = <<70, 4, 6>>\0a\0az \\circ y == <<71, z, y>>\0aASSUME \\circ(4, 6) = <<71, 4, 6>>\0aASSUME \\o (4, 6) = <<71, 4, 6>>\0a\0aASSUME \\in(1, {1})\0a\0aASSUME \\cup({1}, {2}) = {1,2}\0a\0a=============================================================================\0a']]]
      ['suite/test206' 'test206' %accept ~[['test206' '------------------------------- MODULE test206 ------------------------------ \0a\\* Test of labels and their use in subexpression selectors.\0a\0aEXTENDS TLC, Integers\0a\0aCONSTANT C  \\* Test with C = 4\0a\0aOp(Arg(_), p) == \0a   \\A x \\in {1,2}, <<y, z>> \\in {<<3, 4>>} :\0a                      lab(x,y,z) ::  LET a ++ b ==  \0a                                          Arg(a) + b + x + 2*y + 3*z\0a                                     IN  (Arg(1) + Arg(p) + C + \0a                                            2*x  + 4*y + 6*z) =\0a                                         1 ++ ( label2 :: p ++ C)\0a\\*                                IN /\\label2::  PrintT("FOO")\0a\\*                                   /\\ PrintT(Arg(1))\0a\\*                                   /\\ PrintT("FOO2")\0a\\*                                   /\\ PrintT(<<p, Arg(p)>>)\0a\\*                                   /\\ PrintT("FOO3")\0a\\*                                   /\\ PrintT(<<p, C>>)\0a\\*                                   /\\ PrintT("FOO3a")\0a\\*                                   /\\ PrintT(1++2)\0a\\*                                   /\\ PrintT(p++C)\0a\\*                                   /\\ PrintT("FOO4")\0a\\*                                   /\\ PrintT(<<x, y, z>>)\0a\0aFoo(u) == 2*u \0a\0aASSUME Foo(5) = Foo(5)!:\0a\0aTHEOREM Thm == ASSUME FALSE\0a               PROVE  lab:: C > 0\0a\0aTHEOREM Thm2 == lab3 :: TRUE\0a\0a\0aASSUME Foo(25) = 50\0a\0aBar == Op(Foo, 9)!lab(1,2,3)\0a\0aASSUME Op(Foo, 9) \0a\0aASSUME Thm2!lab3\0a\0aASSUME Bar\0a\0aASSUME Op(Foo, 9)!lab(1,2,3)!label2 = Op(Foo, 9)!lab(1,2,3)!:!++(9, 4) \0a\0aOp3(A(_,_,_), a1, a2, a3) == A(a1, a2, a3)\0a\0aOp1(a) == \\A x \\in {} : lab(x) :: IF TRUE\0a                             THEN LET Op1a(c) == 4 * c + a*x\0a                                  IN  a + Op1a(x) \0a                             ELSE 1\0aSOp1(a) == a\0aOOp1(A(_), a) == A(a)\0aASSUME OOp1(SOp1, 2) = 2\0a\0aSOp1a(a) == {x \\in {1,2} : a = x}\0aOOp2(A(_,_), a, b) == A(a, b)\0aASSUME OOp2(SOp1a!@, 2, 2) = TRUE\0a\0aSOp1b(a) == {x + a : x \\in {1,2}}\0aASSUME OOp2(SOp1b!@, 2, 3) = 5\0a\0aSOp1c(a) == {(LET c == a * x IN x + a)  : x \\in {1,2}}\0aASSUME OOp2(SOp1c!@!c, 2, 3) = 2 * 3\0a\0aSOp1d(a) == {(LET c(y) == (a * x) + y IN x + a)  : x \\in {1,2}}\0aOOp3(A(_,_,_), a, b, c) == A(a, b, c)\0aASSUME OOp3(SOp1d!@!c, 2, 3, 4) = 2 * 3 + 4\0a\0aOOp4(A(_,_,_,_), a, b, c, d) == A(a, b, c, d)\0a\0a\0a\\* Foo1 == Op1(2)!(3)!2!1\0aASSUME Op1(2)!(3)!2!1 = 2 + 4*3 + 6\0aASSUME Op1(2)!(3)!2!Op1a(4) = 16 + 6\0aASSUME Op3(Op1!@!2!Op1a, 2, 3, 4) = 22\0a\0aCOp(q, p) == \0a   CHOOSE x : lab(x) ::  LET a ++ b ==  {a, b, q, p, x}\0a                         IN  <<q, 99 ++ p >>\0a\0a\0aASSUME COp(1, 2)!(3)!++(4, 5) = {2,1, 3, 4, 5}\0a\0aASSUME COp(1, 2)!(3) = <<1, {99, 1, 2, 3} >>\0aASSUME COp(1, 2)!(3)!1 = <<1, {99, 1, 2, 3} >>\0aASSUME COp(1, 2)!(3)!1!>> = {99, 1, 2, 3}\0a\0aOOp5(A(_, _, _, _, _), a1, a2, a3, a4, a5) == A(a1, a2, a3, a4, a5)\0a\0aASSUME OOp5(COp!@!++, 1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0aASSUME COp(1, 2)!lab(3)!:!++(4, 5) = {2,1, 3, 4, 5}\0a\0aInst == INSTANCE test206a WITH A5 <- COp!@!++\0aASSUME Inst!Foo(1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0aASSUME Inst!Bar(3)!>> = 3\0aASSUME Inst!Bar2(3)!>> = 3\0aASSUME Inst!Bar3!>> = 2\0aASSUME Inst!Bar4(1)!(2)!<< = 2\0aASSUME Inst!Bar4(1)!(2)!>> = 1\0aASSUME Inst!Bar4(1)!lab(2)!<< = 2\0aASSUME Inst!Bar4(1)!lab(2)!>> = 1\0aASSUME OOp2(Inst!Bar4!@!<<, 1, 2) = 2\0aASSUME OOp2(Inst!Bar4!@!>>, 1, 2) = 1\0aASSUME OOp2(Inst!Bar4!lab!<<, 1, 2) = 2\0aASSUME OOp2(Inst!Bar4!lab!>>, 1, 2) = 1\0aASSUME Inst!Bar5(1)!lab(2)!:!++(3, 4) = <<1, 3, 4, 2>>\0aASSUME Inst!Bar5(1)!(2)!++(3, 4) = <<1, 3, 4, 2>>\0aASSUME OOp4(Inst!Bar5!lab!:!++, 1, 2, 3, 4) = <<1, 3, 4, 2>>\0a\0aInst2(A5(_, _, _, _, _)) ==  INSTANCE test206a \0aASSUME Inst2(COp!@!++)!Foo(1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0a\0a\0aCOp2(q, p) == \0a   CHOOSE x : lab(x) ::  LET a ++ b ==  {lab(y):: y + a + b : y \\in {1}}\0a                         IN  <<q, 99 ++ p >>\0a\0aASSUME COp2(1,2)!lab(3)!:!++(9,10)!lab(11) = 30\0aASSUME COp2(1,2)!(3)!++(9,10)!lab(11) = 30\0aASSUME COp2(1,2)!lab(3)!:!++(9,10)!(11) = 30\0aOOp6(A(_, _, _, _, _, _), a1, a2, a3, a4, a5, a6) == A(a1, a2, a3, a4, a5, a6)\0aASSUME OOp6(COp2!lab!:!++!lab, 1, 2, 3, 9, 10, 11) = 30\0aASSUME OOp6(COp2!@!++!lab, 1, 2, 3, 9, 10, 11) = 30\0aASSUME OOp6(COp2!lab!:!++!@, 1, 2, 3, 9, 10, 11) = 30\0a\0a\\* Let\'s test all the different kinds of operators\0a\0aDef1 == {1, 2, 3, 4}\0aASSUME Def1!2 = 2\0a\0aDef2 == {x \\in {1, 2, 3} : x > 17}\0aASSUME Def2!1 = {1, 2, 3}\0aASSUME Def2!(14)!<< = 14\0a\0aDef3 == {<<x, y>> : x \\in {1}, y \\in {2}}\0aASSUME Def3!2!1 = 2\0aASSUME Def3!(1, 2)!<< = 1\0a\0aDef4 == SUBSET UNION {{1}, {2}}\0aASSUME Def4!<<!<<!2 = {2}\0a\0aDef5 == [i \\in 1..10 |-> i+1][3]\0aASSUME Def5!>> = 3\0aASSUME Def5!<<[4] = 5\0aASSUME Def5!<<!1!>> = 10\0a\0aDef6 == [[i \\in 1..10 |-> i+1] EXCEPT ![2] = 1, ![3] = 2]\0aASSUME Def6!1[3] = 4\0a\\* The following two subexpression expressions are now\0a\\* considered to be illegal because they could contain\0a\\* a "@".\0a\\* ASSUME Def6!2=1\0a\\* ASSUME Def6!3=2\0a\0aDef7 == 3.a\0aASSUME Def7!1 = 3\0aASSUME Def7!2 = "a"\0a\0aDef8 == [a |-> 1, b |-> 2]\0aASSUME Def8!2 = 2\0a\0aDef9 == [a : 1, b : 2]\0aASSUME Def9!2 = 2\0a\0aDef10 == <<1, 2, 3>>\0aASSUME Def10!2 = 2\0a\0aDef11 == {1} \\X {2} \\X {3}\0aASSUME Def11!3!1 = 3\0a\0aDef12 == IF 2=3 THEN 2 ELSE 3\0aASSUME /\\ Def12!1!<< = 2\0a       /\\ Def12!2 = 2\0a       /\\ Def12!3 = 3\0a\0aDef13 == \\A x : CASE x=1 -> 1\0a                  [] x=2 -> 2\0a                  [] OTHER -> 3\0aASSUME /\\ Def13!(42)!1!<<!<< = 42\0a       /\\ Def13!(42)!1!>> = 1\0a       /\\ Def13!(42)!2!>> = 2\0a       /\\ Def13!(42)!3!>> = 3\0a\0aDef14 == \\A x \\in {1} : x = 1\0aASSUME /\\ Def14!(2)!<< = 2\0a       /\\ Def14!1!1 = 1\0a\0aDef15 == \\A x \\in {1}, y \\in {2} : (x = 1) /\\ (y = 2)\0aASSUME /\\ Def15!(2,3)!<<!<< = 2\0a       /\\ Def15!(2,3)!>>!<< = 3\0a       /\\ Def15!2!<< = 2\0a\0aDef16 == \\E x \\in {1}, <<y, z>> \\in {<<2,3>>} : /\\ ((x = 1))\0a                                                /\\ y = 2 \0a                                                /\\ (z=3)\0aASSUME /\\ Def16!(2,3,4)!1!1 = 2\0a       /\\ Def16!(2,3,4)!2!1 = 3\0a       /\\ Def16!2!1!<< = 2\0a\0aDef17 == \\E x , y, z : /\\ ((x = 1))\0a                       /\\ y = 2 \0a                       /\\ (z=3)\0aASSUME /\\ Def17!(2,3,4)!1!1 = 2\0a       /\\ Def17!(2,3,4)!2!1 = 3\0a\0aDef18 == CHOOSE x : (x=1)\0aASSUME Def18!(2)!<< = 2\0a\0aDef19 == CHOOSE x \\in {42}: (x=1)\0aASSUME /\\ Def19!(2)!<< = 2\0a       /\\ Def19!1!1 = 42\0a\0aDef20 == [12]_(23)\0aASSUME /\\ Def20!1 = 12\0a       /\\ Def20!>> = 23\0a\0aDef21 == <<12>>_(23)\0aASSUME /\\ Def21!1 = 12\0a       /\\ Def21!>> = 23\0a\0aDef22 == WF_(12)(23)\0aASSUME /\\ Def22!1 = 12\0a       /\\ Def22!>> = 23\0a\0aDef23 == \\EE x , y, z : /\\ ((x = 1))\0a                        /\\ y = 2 \0a                        /\\ (z=3)\0aASSUME /\\ Def23!(2,3,4)!1!1 = 2\0a       /\\ Def23!(2,3,4)!2!1 = 3\0a\0a\0a=============================================================================\0a\0alast modified on Tue  9 March 2010 at 11:49:54 PST by lamport'] ['test206a' '----------------------------- MODULE test206a -----------------------------\0a\0aCONSTANT A5(_, _, _, _, _)\0a\0aFoo(a1, a2, a3, a4, a5) == A5(a1, a2, a3, a4, a5) \0aBar(a) == <<1, a>>\0aBar2(a) == <<1, lab::a>>\0aBar3 == <<1, 2>>\0aBar4(a) == {x \\in {1} : lab(x) :: <<x, a>>}\0aBar5(a) == {x \\in {1} : lab(x) :: LET b ++ c == <<a, b, c, x>>\0a                                  IN 42 }\0a=============================================================================']]]
      ['suite/test206a' 'test206a' %accept ~[['test206a' '----------------------------- MODULE test206a -----------------------------\0a\0aCONSTANT A5(_, _, _, _, _)\0a\0aFoo(a1, a2, a3, a4, a5) == A5(a1, a2, a3, a4, a5) \0aBar(a) == <<1, a>>\0aBar2(a) == <<1, lab::a>>\0aBar3 == <<1, 2>>\0aBar4(a) == {x \\in {1} : lab(x) :: <<x, a>>}\0aBar5(a) == {x \\in {1} : lab(x) :: LET b ++ c == <<a, b, c, x>>\0a                                  IN 42 }\0a=============================================================================']]]
      ['suite/test207' 'test207' %accept ~[['test207' '\\* SANY2 test.\0a\\* Test of scope of NEW declarations.  They should be restricted\0a\\* to the statement\'s proof, except for SUFFICES which should be \0a\\* visible to the rest of the current proof.\0a\0a-------------------- MODULE test207 ----------------\0aEXTENDS TLC\0aa + b == <<a, b>>\0aTHEOREM Thm == ASSUME NEW J PROVE lab :: TRUE\0a<1>1 ASSUME NEW I\0a     PROVE  Thm!lab\0a  <2>1 I = J\0a  <2>2 QED\0a<1> DEFINE I == 1\0a<1>2 ASSUME NEW K\0a     PROVE  TRUE\0a<1>3 SUFFICES ASSUME NEW K\0a              PROVE  TRUE\0a  <2>1. \\A K : TRUE\0a  <2>2. SUFFICES ASSUME NEW L\0a                 PROVE  TRUE\0a  <2>3. QED\0a<1>3a. DEFINE L == 0\0a<1>4.  K = 0      \\* 12 June 14 Changed from <*>4 which is now illegal.\0a  <2>1. DEFINE F == 7\0a  <2>4. TRUE   \\* 12 June 14 Changed from <*>4 which is now illegal.\0a  <2>2. QED\0a     BY <2>4\0a<1>4a. DEFINE F == 42\0a<1>5 QED\0a  BY <1>4\0aJ == 0\0aI == 0\0aF == 1\0a\0aASSUME PrintT("SANY2 Test")\0a\0a=============================\0a']]]
      ['suite/test21' 'test21' %accept ~[['test21' '--------------- MODULE test21 -------------\0a\0a(* Test of priming and variable confusion *)\0a\0aEXTENDS Naturals, Sequences, TLC\0a\0aBar(z)    == z\' = 2\0aFoo(y)    == y = 2\0aFooBar(y) == y = 1\0a\0aVARIABLE x, y\0a\0aLetTest == LET s == x=1\0a           IN  s\0a\0a\0aOp(a) ==  x+a\0a\0aInit == /\\ x = 1\0a        /\\ y = 3\0aNext == \0a\0a  \\/ /\\ x = 1\0a     /\\ x\'=x+1\0a     /\\ y\' = y\0a     /\\ IF Bar(x)\0a          THEN Print("Test 1 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 1 Failed")\0a\0a  \\/ /\\ x = 1\0a     /\\ x\'=x+1\0a     /\\ y\' = y\0a     /\\ IF Foo(x)\'\0a          THEN Print("Test 2 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 2 Failed")\0a\0a  \\/ /\\ x = 1\0a     /\\ x\'=x+1\0a     /\\ y\' = y\0a     /\\ IF FooBar(x)\0a          THEN Print("Test 3 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 3 Failed")\0a     /\\ IF LetTest\' THEN Assert(FALSE, "Test 4 Failed")\0a                    ELSE Print("Test 4 OK", TRUE)\0a     /\\ LET a == x\0a        IN  IF a\' = 2 THEN Print("Test 5 OK", TRUE)\0a                      ELSE Assert(FALSE, "Test 5 Failed")\0a\0a     /\\ IF FooBar(x)\' THEN Assert(FALSE, "Test 6 Failed")\0a                      ELSE Print("Test 6 OK", TRUE)\0a\0a     /\\ IF FooBar(x\') THEN Assert(FALSE, "Test 7 Failed")\0a                      ELSE Print("Test 7 OK", TRUE)\0a\0a  \\/ IF (x = 1)\0a       THEN /\\ x\'=x+1\0a            /\\ y\'=y\0a            /\\ Print("Test 8 OK", TRUE)\0a       ELSE /\\ x\'=x+1\0a            /\\ y\'=y\0a            /\\ Print("Test 12 OK", FALSE)  \0a\0a  \\/ /\\ x = 1\0a     /\\ x\'=x+1\0a     /\\ y\'=y\0a     /\\ IF Op(1)\' = 3\0a          THEN Print("Test 9 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 9 Failed")\0a     /\\ IF LET LetOp(a) ==  x+a\0a           IN  LetOp(1)\' = 3\0a          THEN Print("Test 10 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 10 Failed")\0a\0a     /\\ IF (LET LetOp(a) ==  x+a\0a            IN  LetOp(1) = 3     )\'\0a          THEN Print("Test 11 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 11 Failed")\0a\0a  \\/ UNCHANGED <<x,y>>\0a\0aInv == TRUE\0a\0a=========================================\0a']]]
      ['suite/test212' 'test212' %reject ~[['test212' '--------------------------- MODULE test212 --------------------------\0a\\* Test of Leibniz checking\0a\\*   Uses the fact that you can\'t substitute a non-Leibniz operator\0a\\*   for a constant operator.\0aVARIABLE x\0a\0aLeibniz(a2) == {a2 , x\'}\0aNonLeibniz2(a, b) == <<a, b\'>>\0aL ==  INSTANCE test212b WITH y <- x\0a\0aNonLeibniz(a1) == a1\'\0aLeibniz2(a, b) == <<a, b, x\'>>\0a\0aI(a) == INSTANCE test212b WITH y <- a\0aLL == INSTANCE test212b WITH y <- ENABLED (x\'=x)\0aNonL(a) ==INSTANCE test212b WITH y <- ENABLED a\0a\0a\\* Legal\0aL1 == INSTANCE test212a WITH Op <- Leibniz, Op2 <- Leibniz2\0aL2 == INSTANCE test212a WITH Op <- LAMBDA a : I(a)!Leibniz(1), \0a                             Op2 <- Leibniz2\0aL3 == INSTANCE test212a WITH Op <- Leibniz, Op2 <- I!Leibniz\0aL4 == INSTANCE test212a WITH Op <- Leibniz, Op2 <- LL!Leibniz2\0aL5 == INSTANCE test212a WITH Op <- LL!Leibniz, Op2 <- Leibniz2\0a\0a\\* Illegal\0aI1 == INSTANCE test212a WITH Op <- Leibniz, Op2 <- NonLeibniz2\0aI2 == INSTANCE test212a WITH Op <- NonLeibniz, Op2 <- Leibniz2\0aI3 == INSTANCE test212a WITH Op <- NonL!NoArg, Op2 <- Leibniz2\0aI4 == INSTANCE test212a WITH Op <- Leibniz, Op2 <- L!NonLeibniz2\0aI5 == INSTANCE test212a WITH Op <- Leibniz, Op2 <- NonL!Leibniz\0aI6 == INSTANCE test212a WITH Op <- Leibniz, Op2 <- I!NonLeibniz\0a=================================================================='] ['test212b' '-------------------------- MODULE test212b -------------------------\0aVARIABLE y\0aNoArg == y\'\0aLeibniz(a4) == <<a4, y>>\0aLeibniz2(a44, a45) == <<a44, a45, y>>\0aNonLeibniz(a5) == ENABLED a5\0aNonLeibniz2(a6, a7) == {a6\', a7}\0a\0a=============================================================================\0a'] ['test212a' '-------------------------- MODULE test212a -------------------------\0a\0aCONSTANT Op(_) , Op2(_,_) \0a\0a=============================================================================']]]
      ['suite/test212a' 'test212a' %accept ~[['test212a' '-------------------------- MODULE test212a -------------------------\0a\0aCONSTANT Op(_) , Op2(_,_) \0a\0a=============================================================================']]]
      ['suite/test212b' 'test212b' %accept ~[['test212b' '-------------------------- MODULE test212b -------------------------\0aVARIABLE y\0aNoArg == y\'\0aLeibniz(a4) == <<a4, y>>\0aLeibniz2(a44, a45) == <<a44, a45, y>>\0aNonLeibniz(a5) == ENABLED a5\0aNonLeibniz2(a6, a7) == {a6\', a7}\0a\0a=============================================================================\0a']]]
      ['suite/test213' 'test213' %reject ~[['test213' '------------------------------- MODULE test213 ------------------------------ \0a\\* Test that \0a\\* - A non-temporal theorem or proof step cannot have a\0a\\*   temporal formula in its proof.\0a\\* - A declared constant that appears in an ASSUME or an ASSUME/PROVE\0a\\*   cannot be instantiated with a temporal formula \0a\\*\0a\\* Parsing only; produces errors.\0a\0aVARIABLE x\0a\0aI1 == INSTANCE test213b WITH C <- x\', D <- x\' \0aI2 == INSTANCE test213b WITH C <- [](x=0), D <- TRUE \\* ERROR\0aI3 == INSTANCE test213b WITH C <- TRUE, D <- [](x=0) \\* ERROR\0a\0aTHEOREM [](x=0)\0a<1>1. CASE FALSE\0a  <2>1. [](x=0)\0a  <2>2. QED\0a    <3>1. [](x # 0)\0a      BY [](x # 0)\0a    <3>2. QED\0a<1>2. x=0        \\* ERROR\0a  <2>1. (x=0)   \0a  <2>2. QED\0a    <3>1. [](x=0)  \0a    <3>2. QED\0a<1>3. CASE TRUE\0a <2>1. CASE x=0  \\* ERROR\0a <2>1a. CASE FALSE\0a <2>2. HAVE x=0  \\* ERROR\0a <2>2a HAVE TRUE \0a <2>3. WITNESS 3 \\in x \\* ERROR\0a <2>4. WITNESS 2 \\in {}\0a <2>5. QED\0a<1>4. QED\0a  <2>1. [](x=0)\0a  <2>2. QED\0a \0a\0a\0aTHEOREM x=0  \\* ERROR\0a <1>1. x\'=0     \\* ERROR\0a   BY [](x=0)   \\* This BY causes an error, though it needn\'t \0a <1>2. [](x=0)  \\* this causes error in THEOREM\0a <1>3. QED\0a============================================================================='] ['test213b' '------------------------------ MODULE test213b ------------------------------ \0aCONSTANT C, D\0aASSUME C = {}\0a\0aTHEOREM ASSUME D\0a        PROVE  TRUE\0a=============================================================================\0a']]]
      ['suite/test213b' 'test213b' %accept ~[['test213b' '------------------------------ MODULE test213b ------------------------------ \0aCONSTANT C, D\0aASSUME C = {}\0a\0aTHEOREM ASSUME D\0a        PROVE  TRUE\0a=============================================================================\0a']]]
      ['suite/test214' 'test214' %reject ~[['test214' '------------------------------ MODULE test214 ------------------------------ \0a\\* Test that USE and HIDE cannot contain arbitrary expressions as \0a\\* facts.\0a\0aTHEOREM bar == <<1, 2>>\0a\0aUSE bar, bar!1 (*ERROR*)\0a         \0a\0aHIDE bar, TRUE (*ERROR*)\0a\0aTHEOREM xx == ASSUME TRUE PROVE FALSE \0a <1>2. USE TRUE (*ERROR*), bar , xx , xx!1 (*ERROR*)\0a <1>3. QED\0a\0a=============================================================================\0a']]]
      ['suite/test215' 'test215' %reject ~[['test215' '------------------------- MODULE test215 ------------------------- \0a\\* Test of constraints on levels of temporal operators that\0a\\* outlaw any form of raw TLA.\0a\0aVARIABLE x\0a\0aa == x ~> []x\0ab == x\' ~> []x    \\* ERROR\0ac == []x ~> x\'    \\* ERROR\0a\0ad == x -+-> []x\0ae == x\' -+-> []x  \\* ERROR\0af == []x -+-> x\'  \\* ERROR\0a\0ag == <><<x\'>>_x\0ah == <>(x\')       \\* ERROR\0a\0afoo == [][x\']_x\0a\0abar == [](x\')    \\* ERROR\0a\0am == \\A i \\in {}, j \\in x : []x\0an == \\A i \\in {}, j \\in x\' : []x   \\* ERROR\0a\0amm == \\E i \\in {}, j \\in x : []x\0ann == \\E i \\in {}, j \\in x\' : []x   \\* ERROR\0a\0am2 == \\A i \\in x\' : x\'\0a=======================================================================']]]
      ['suite/test216' 'test216' %accept ~[['test216' '---------------------------- MODULE test216 ------------------------\0aEXTENDS TLC, Naturals\0a\0aINSTANCE test216a WITH D <- 42\0aFoo == INSTANCE test216a WITH D <- 43\0aFooG == INSTANCE test216a WITH D <- 42\0aVARIABLE x\0aCONSTANT C\0a\0aTHEOREM Thm1 == x \\in 0..C\0a \0aTHEOREM Thm1Prime == x\' \\in 0..C\0a\0aTHEOREM Thm1a == 1+1=2\0aBar == x \\in 0..C\0aInit == Bar \\/ Thm1!: \\/ (Thm1 /\\ ENABLED Thm1Prime!:)\0aNext == x\'=(x+1)%C  /\\  Thm1!: \0a             /\\ Thm1Prime!: /\\ Thm1 /\\ Thm1Prime\0aSpec == /\\ Init \0a        /\\ [][Next]_x\0a        /\\ WF_x(Next)\0a\0a\0a\0a\0aInv == Thm1\0aInv2 == Thm1!<< \\in Thm1!>>\0a\0aTHEOREM Thm1b == Spec => /\\ []Inv \0a                         /\\  []<>(x=0)\0a\0aSpec1 == Thm1b!1\0a\\* need to build two tests, since there are two specs\0a\0aTHEOREM Thm1c == [][Next]_x\0aSpec2 == Init /\\ Thm1c \\* Doesn\'t work\0a\0aThm1d == []<>(x=0)\0aProp3 == Thm1d\0a\0aProp1 == Thm1b!2!1\0aProp2 == Thm1b!2!2\0a\0aASSUME Thm2\0aASSUME ~ Foo!Thm2\0aASSUME ~Foo!Thm3\0aASSUME ~Foo!I!Thm3\0aASSUME  FooG!Thm2\0aASSUME FooG!Thm3 \0aASSUME FooG!I!Thm3\0aASSUME Thm2!:\0aASSUME ~ Foo!Thm2!:\0aASSUME Thm2!1 = 42\0aASSUME Foo!Thm2!1 = 43\0a\0aTHEOREM Thm3!:\0aTHEOREM ~ Foo!Thm3!:\0aASSUME Foo!Thm3!2!2 = 42\0aASSUME Foo!I!Thm3!2!2 = 42\0aASSUME I!Thm3!2!2 = 42\0aASSUME Thm3!2!2 = 42\0a\0a\0aJ == INSTANCE test216c\0aProp4 == J!ThmC!1 /\\ J!ThmC!2 /\\ J!ThmC2!:\0a\0aThm1aDef == Thm1a\0a\0aINSTANCE test216c\0aThmC3Def == ThmC3\0aProp5 == ThmC!1 /\\ ThmC!2   /\\ ThmC3!: /\\ Thm1aDef /\\ ThmC3Def\0a====================================================================\0a'] ['test216c' '------------------ MODULE test216c ---------------------\0aEXTENDS Naturals\0aVARIABLE x\0a\0aInitC == x = 0\0aNextC == x\'=(x+1) %6\0a\0aSpecC == [][NextC]_x\0a\0aTHEOREM ThmC == SpecC => [](x \\in Nat)\0a\0aTHEOREM ThmC2 == [](x \\in Nat)\0a\0aTHEOREM ThmC3 == 1+1 = 2\0a======================================================'] ['test216a' '---------------------------- MODULE test216a ------------------------\0aEXTENDS Naturals\0aCONSTANT D\0a\0aASSUME Ass2 == D + 0 = 42 \0aTHEOREM Thm2 == D + 0 = 42\0aThm2Def == D + 0 = 42\0a\0aINSTANCE test216b WITH E <- D, y <- 0   \0a  \\* 12 June 2014: Changed from Test216b, which is now illegal\0aI == INSTANCE test216b WITH E <- D, y <- 0\0a  \\* 12 June 2014: Changed from Test216b, which is now illegal\0a\0a\0a====================================================================\0a'] ['test216b' '---------------------------- MODULE test216b ------------------------\0aCONSTANT E, y\0a\0aTHEOREM Thm3 == y \\in {y} /\\ E = 42\0a\0a\0a====================================================================\0a']]]
      ['suite/test216a' 'test216a' %accept ~[['test216a' '---------------------------- MODULE test216a ------------------------\0aEXTENDS Naturals\0aCONSTANT D\0a\0aASSUME Ass2 == D + 0 = 42 \0aTHEOREM Thm2 == D + 0 = 42\0aThm2Def == D + 0 = 42\0a\0aINSTANCE test216b WITH E <- D, y <- 0   \0a  \\* 12 June 2014: Changed from Test216b, which is now illegal\0aI == INSTANCE test216b WITH E <- D, y <- 0\0a  \\* 12 June 2014: Changed from Test216b, which is now illegal\0a\0a\0a====================================================================\0a'] ['test216b' '---------------------------- MODULE test216b ------------------------\0aCONSTANT E, y\0a\0aTHEOREM Thm3 == y \\in {y} /\\ E = 42\0a\0a\0a====================================================================\0a']]]
      ['suite/test216b' 'test216b' %accept ~[['test216b' '---------------------------- MODULE test216b ------------------------\0aCONSTANT E, y\0a\0aTHEOREM Thm3 == y \\in {y} /\\ E = 42\0a\0a\0a====================================================================\0a']]]
      ['suite/test216c' 'test216c' %accept ~[['test216c' '------------------ MODULE test216c ---------------------\0aEXTENDS Naturals\0aVARIABLE x\0a\0aInitC == x = 0\0aNextC == x\'=(x+1) %6\0a\0aSpecC == [][NextC]_x\0a\0aTHEOREM ThmC == SpecC => [](x \\in Nat)\0a\0aTHEOREM ThmC2 == [](x \\in Nat)\0a\0aTHEOREM ThmC3 == 1+1 = 2\0a======================================================']]]
      ['suite/test217' 'test217' %reject ~[['test217' 'Sany should produce two level errors when parsing this module.\0a\0a---- MODULE test217 ----\0a    \\* 12 June 2014: Changed module name from Test217, which is now illegal\0aEXTENDS test217a\0a    \\* 12 June 2014: Changed from Test217a, which is now illegal\0aVARIABLE x\0a\0aI(z) == INSTANCE test217a WITH y <- z\0a    \\* 12 June 2014: Changed from Test217a, which is now illegal\0a\0aFooBar == I(x\')!Foo\0aTHEOREM I({x\'})!Foo\0a==============================='] ['test217a' '---- MODULE test217a ----\0aVARIABLE y\0a\0aTHEOREM Foo == y\'=0\0a=========================']]]
      ['suite/test217a' 'test217a' %accept ~[['test217a' '---- MODULE test217a ----\0aVARIABLE y\0a\0aTHEOREM Foo == y\'=0\0a=========================']]]
  ==
::
++  test-sany-sub-4
  %+  expect-eq
    !>  ^-  (list @t)
    :~  'suite/test219a -> hoon=reject'  'suite/test30 -> hoon=reject'  'suite/test42 -> hoon=reject'  'suite/test43 -> hoon=reject'  'suite/test52 -> hoon=reject'
    ==
  !>
  %-  sub-batch-run
  ^-  (list [@t @t ?(%accept %reject) (list [@t @t])])
  :~
      ['suite/test219a' 'test219a' %accept ~[['test219a' '------------------------------- MODULE test219a ------------------------------ \0a\\* Test of labels and their use in subexpression selectors.\0a\0aEXTENDS TLC, Integers\0a\0aCONSTANT C\0a\\* C  == 4\0a\0aOp(Arg(_), p) == \0a   \\A x \\in {1,2}, <<y, z>> \\in {<<3, 4>>} :\0a                      lab(x,y,z) ::  LET a ++ b ==  \0a                                          Arg(a) + b + x + 2*y + 3*z\0a                                     IN  (Arg(1) + Arg(p) + C + \0a                                            2*x  + 4*y + 6*z) =\0a                                         1 ++ ( label2 :: p ++ C)\0a\\*                                IN /\\label2::  PrintT("FOO")\0a\\*                                   /\\ PrintT(Arg(1))\0a\\*                                   /\\ PrintT("FOO2")\0a\\*                                   /\\ PrintT(<<p, Arg(p)>>)\0a\\*                                   /\\ PrintT("FOO3")\0a\\*                                   /\\ PrintT(<<p, C>>)\0a\\*                                   /\\ PrintT("FOO3a")\0a\\*                                   /\\ PrintT(1++2)\0a\\*                                   /\\ PrintT(p++C)\0a\\*                                   /\\ PrintT("FOO4")\0a\\*                                   /\\ PrintT(<<x, y, z>>)\0a\0aFoo(u) == 2*u \0a\0a\\* ASSUME Foo(5) = Foo(5)!:\0a\0aTHEOREM Thm == ASSUME FALSE\0a               PROVE  lab:: C > 0\0a\0aTHEOREM Thm2 == lab3 :: TRUE\0a\0a\0a\\* ASSUME Foo(25) = 50\0a\0aBar == Op(Foo, 9)!lab(1,2,3)\0a\0a\\* ASSUME Op(Foo, 9) \0a\\* \0a\\* ASSUME Thm2!lab3\0a\\* \0a\\* ASSUME Bar\0a\\* \0a\\* ASSUME Op(Foo, 9)!lab(1,2,3)!label2 = Op(Foo, 9)!lab(1,2,3)!:!++(9, 4) \0a\0aOp3(A(_,_,_), a1, a2, a3) == A(a1, a2, a3)\0a\0aOp1(a) == \\A x \\in {} : lab(x) :: IF TRUE\0a                             THEN LET Op1a(c) == 4 * c + a*x\0a                                  IN  a + Op1a(x) \0a                             ELSE 1\0aSOp1(a) == a\0aOOp1(A(_), a) == A(a)\0a\\* ASSUME OOp1(SOp1, 2) = 2\0a\0aSOp1a(a) == {x \\in {1,2} : a = x}\0aOOp2(A(_,_), a, b) == A(a, b)\0a\\* ASSUME OOp2(SOp1a!@, 2, 2) = TRUE\0a\0aSOp1b(a) == {x + a : x \\in {1,2}}\0a\\* ASSUME OOp2(SOp1b!@, 2, 3) = 5\0a\0aSOp1c(a) == {(LET c == a * x IN x + a)  : x \\in {1,2}}\0a\\* ASSUME OOp2(SOp1c!@!c, 2, 3) = 2 * 3\0a\0aSOp1d(a) == {(LET c(y) == (a * x) + y IN x + a)  : x \\in {1,2}}\0aOOp3(A(_,_,_), a, b, c) == A(a, b, c)\0a\\* ASSUME OOp3(SOp1d!@!c, 2, 3, 4) = 2 * 3 + 4\0a\0aOOp4(A(_,_,_,_), a, b, c, d) == A(a, b, c, d)\0a\0a\0a\\* Foo1 == Op1(2)!(3)!2!1\0a\\* ASSUME Op1(2)!(3)!2!1 = 2 + 4*3 + 6\0a\\* ASSUME Op1(2)!(3)!2!Op1a(4) = 16 + 6\0a\\* ASSUME Op3(Op1!@!2!Op1a, 2, 3, 4) = 22\0a\0aCOp(q, p) == \0a   CHOOSE x : lab(x) ::  LET a ++ b ==  {a, b, q, p, x}\0a                         IN  <<q, 99 ++ p >>\0a\0a\0a\\* ASSUME COp(1, 2)!(3)!++(4, 5) = {2,1, 3, 4, 5}\0a\0a\\* ASSUME COp(1, 2)!(3) = <<1, {99, 1, 2, 3} >>\0a\\* ASSUME COp(1, 2)!(3)!1 = <<1, {99, 1, 2, 3} >>\0a\\* ASSUME COp(1, 2)!(3)!1!>> = {99, 1, 2, 3}\0a\0aOOp5(A(_, _, _, _, _), a1, a2, a3, a4, a5) == A(a1, a2, a3, a4, a5)\0a\0a\\* ASSUME OOp5(COp!@!++, 1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0a\\* ASSUME COp(1, 2)!lab(3)!:!++(4, 5) = {2,1, 3, 4, 5}\0a\0aInst == INSTANCE test206a WITH A5 <- COp!@!++\0a\\* ASSUME Inst!Foo(1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0a\\* ASSUME Inst!Bar(3)!>> = 3\0a\\* ASSUME Inst!Bar2(3)!>> = 3\0a\\* ASSUME Inst!Bar3!>> = 2\0a\\* ASSUME Inst!Bar4(1)!(2)!<< = 2\0a\\* ASSUME Inst!Bar4(1)!(2)!>> = 1\0a\\* ASSUME Inst!Bar4(1)!lab(2)!<< = 2\0a\\* ASSUME Inst!Bar4(1)!lab(2)!>> = 1\0a\\* ASSUME OOp2(Inst!Bar4!@!<<, 1, 2) = 2\0a\\* ASSUME OOp2(Inst!Bar4!@!>>, 1, 2) = 1\0a\\* ASSUME OOp2(Inst!Bar4!lab!<<, 1, 2) = 2\0a\\* ASSUME OOp2(Inst!Bar4!lab!>>, 1, 2) = 1\0a\\* ASSUME Inst!Bar5(1)!lab(2)!:!++(3, 4) = <<1, 3, 4, 2>>\0a\\* ASSUME Inst!Bar5(1)!(2)!++(3, 4) = <<1, 3, 4, 2>>\0a\\* ASSUME OOp4(Inst!Bar5!lab!:!++, 1, 2, 3, 4) = <<1, 3, 4, 2>>\0a\0aInst2(A5(_, _, _, _, _)) ==  INSTANCE test206a \0a\\* ASSUME Inst2(COp!@!++)!Foo(1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0a\0a\0aCOp2(q, p) == \0a   CHOOSE x : lab(x) ::  LET a ++ b ==  {lab(y):: y + a + b : y \\in {1}}\0a                         IN  <<q, 99 ++ p >>\0a\0a\\* ASSUME COp2(1,2)!lab(3)!:!++(9,10)!lab(11) = 30\0a\\* ASSUME COp2(1,2)!(3)!++(9,10)!lab(11) = 30\0a\\* ASSUME COp2(1,2)!lab(3)!:!++(9,10)!(11) = 30\0aOOp6(A(_, _, _, _, _, _), a1, a2, a3, a4, a5, a6) == A(a1, a2, a3, a4, a5, a6)\0a\\* ASSUME OOp6(COp2!lab!:!++!lab, 1, 2, 3, 9, 10, 11) = 30\0a\\* ASSUME OOp6(COp2!@!++!lab, 1, 2, 3, 9, 10, 11) = 30\0a\\* ASSUME OOp6(COp2!lab!:!++!@, 1, 2, 3, 9, 10, 11) = 30\0a\0a\\* Let\'s test all the different kinds of operators\0a\0aDef1 == {1, 2, 3, 4}\0a\\* ASSUME Def1!2 = 2\0a\0aDef2 == {x \\in {1, 2, 3} : x > 17}\0a\\* ASSUME Def2!1 = {1, 2, 3}\0a\\* ASSUME Def2!(14)!<< = 14\0a\0aDef3 == {<<x, y>> : x \\in {1}, y \\in {2}}\0a\\* ASSUME Def3!2!1 = 2\0a\\* ASSUME Def3!(1, 2)!<< = 1\0a\0aDef4 == SUBSET UNION {{1}, {2}}\0a\\* ASSUME Def4!<<!<<!2 = {2}\0a\0aDef5 == [i \\in 1..10 |-> i+1][3]\0a\\* ASSUME Def5!>> = 3\0a\\* ASSUME Def5!<<[4] = 5\0a\\* ASSUME Def5!<<!1!>> = 10\0a\0aDef6 == [[i \\in 1..10 |-> i+1] EXCEPT ![2] = 1, ![3] = 2]\0a\\* ASSUME Def6!1[3] = 4\0a\\* The following two subexpression expressions are now\0a\\* considered to be illegal because they could contain\0a\\* a "@".\0a\\* ASSUME Def6!2=1\0a\\* ASSUME Def6!3=2\0a\0aDef7 == 3.a\0a\\* ASSUME Def7!1 = 3\0a\\* ASSUME Def7!2 = "a"\0a\0aDef8 == [a |-> 1, b |-> 2]\0a\\* ASSUME Def8!2 = 2\0a\0aDef9 == [a : 1, b : 2]\0a\\* ASSUME Def9!2 = 2\0a\0aDef10 == <<1, 2, 3>>\0a\\* ASSUME Def10!2 = 2\0a\0aDef11 == {1} \\X {2} \\X {3}\0a\\* ASSUME Def11!3!1 = 3\0a\0aDef12 == IF 2=3 THEN 2 ELSE 3\0a\\* ASSUME /\\ Def12!1!<< = 2\0a\\*       /\\ Def12!2 = 2\0a\\*       /\\ Def12!3 = 3\0a\0aDef13 == \\A x : CASE x=1 -> 1\0a                  [] x=2 -> 2\0a                  [] OTHER -> 3\0a\\* ASSUME /\\ Def13!(42)!1!<<!<< = 42\0a\\*       /\\ Def13!(42)!1!>> = 1\0a\\*       /\\ Def13!(42)!2!>> = 2\0a\\*       /\\ Def13!(42)!3!>> = 3\0a\0aDef14 == \\A x \\in {1} : x = 1\0a\\* ASSUME /\\ Def14!(2)!<< = 2\0a\\*       /\\ Def14!1!1 = 1\0a\0aDef15 == \\A x \\in {1}, y \\in {2} : (x = 1) /\\ (y = 2)\0a\\* ASSUME /\\ Def15!(2,3)!<<!<< = 2\0a\\*       /\\ Def15!(2,3)!>>!<< = 3\0a\\*       /\\ Def15!2!<< = 2\0a\0aDef16 == \\E x \\in {1}, <<y, z>> \\in {<<2,3>>} : /\\ ((x = 1))\0a                                                /\\ y = 2 \0a                                                /\\ (z=3)\0a\\* ASSUME /\\ Def16!(2,3,4)!1!1 = 2\0a\\*       /\\ Def16!(2,3,4)!2!1 = 3\0a\\*       /\\ Def16!2!1!<< = 2\0a\0aDef17 == \\E x , y, z : /\\ ((x = 1))\0a                       /\\ y = 2 \0a                       /\\ (z=3)\0a\\* ASSUME /\\ Def17!(2,3,4)!1!1 = 2\0a\\*       /\\ Def17!(2,3,4)!2!1 = 3\0a\0aDef18 == CHOOSE x : (x=1)\0a\\* ASSUME Def18!(2)!<< = 2\0a\0aDef19 == CHOOSE x \\in {42}: (x=1)\0a\\* ASSUME /\\ Def19!(2)!<< = 2\0a\\*       /\\ Def19!1!1 = 42\0a\0aDef20 == [12]_(23)\0a\\* ASSUME /\\ Def20!1 = 12\0a\\*       /\\ Def20!>> = 23\0a\0aDef21 == <<12>>_(23)\0a\\* ASSUME /\\ Def21!1 = 12\0a\\*       /\\ Def21!>> = 23\0a\0aDef22 == WF_(12)(23)\0a\\* ASSUME /\\ Def22!1 = 12\0a\\*     /\\ Def22!>> = 23\0a\0aDef23 == \\EE x , y, z : /\\ ((x = 1))\0a                        /\\ y = 2 \0a                        /\\ (z=3)\0a\\* ASSUME /\\ Def23!(2,3,4)!1!1 = 2\0a\\*       /\\ Def23!(2,3,4)!2!1 = 3\0a\0a\0a=============================================================================\0a\0alast modified on Wed 31 October 2012 at 14:45:24 PST by lamport'] ['test206a' '----------------------------- MODULE test206a -----------------------------\0a\0aCONSTANT A5(_, _, _, _, _)\0a\0aFoo(a1, a2, a3, a4, a5) == A5(a1, a2, a3, a4, a5) \0aBar(a) == <<1, a>>\0aBar2(a) == <<1, lab::a>>\0aBar3 == <<1, 2>>\0aBar4(a) == {x \\in {1} : lab(x) :: <<x, a>>}\0aBar5(a) == {x \\in {1} : lab(x) :: LET b ++ c == <<a, b, c, x>>\0a                                  IN 42 }\0a=============================================================================']]]
      ['suite/test22' 'test22' %accept ~[['test22' '--------------- MODULE test22 -------------\0a\0a(* Test of fingerprinting. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x, y\0a\0aS == {1}\0aT == {2, 3, 4}\0a\0a\0a\0aInit ==  /\\ Print("Distinct States should equal Distinct Initial States", TRUE)\0a         /\\ x \\in [S -> [S -> SUBSET T]]\0a         /\\ y \\in [S -> [S -> SUBSET [a : {2}, b : {3, 4, 5}]]]\0a\0aInv == IF [S -> [S -> SUBSET [b : {4, 4, 3, 5, 4}, a : {2, 2}]]] # \0a               [S -> [S -> SUBSET [a : {2}, b : {3, 4, 5}]]]\0a          THEN Assert(FALSE, "Test 1 Failed")\0a          ELSE TRUE\0a\0aNext ==     \0a  \\/ UNCHANGED <<x, y>>\0a\0a  \\/ /\\ x\' \\in [S -> [S -> SUBSET {4, 4, 4, 3, 2, 2}]]\0a     /\\ UNCHANGED y\0a\0a  \\/ /\\ y\' \\in [S -> [S -> SUBSET [b : {4, 4, 3, 5, 4}, a : {2, 2}]]]\0a     /\\ UNCHANGED x\0a\0a  \\/ /\\ y\' = [y EXCEPT ![1][1] = {[b |-> 4, a |-> 2]}]\0a     /\\ UNCHANGED x\0a\0a  \\/ /\\ y\' = [y EXCEPT ![1][1] = {[b |-> 3, a |-> 2]}]\0a     /\\ UNCHANGED x\0a\0a  \\/ /\\ y\' = [y EXCEPT ![1][1] = {[b |-> 5, a |-> 2]}]\0a     /\\ UNCHANGED x\0a=========================================\0a']]]
      ['suite/test220' 'test220' %accept ~[['test220' '--------------- MODULE test220  -------------\0a\0a(* Testing deadlock and number of states found. *)\0a\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aASSUME TLCGet("config").deadlock = FALSE\0a\0aVARIABLE x, y, z\0a\0aInit == /\\ Print("This test should not deadlock when configured with CHECK_DEADLOCK=FALSE", TRUE)\0a        /\\ x = {}\0a        /\\ y = {}\0a        /\\ z = 1\0a\0aNext == /\\ x = {}\0a        /\\ x\' = {1}        \0a        /\\ y\' \\in SUBSET x\'\0a        /\\ z\' = z\0a        /\\ y\' = {}\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test23bis' 'test23bis' %reject ~[['test23bis' '--------------- MODULE test23 -------------\0a\0aEXTENDS Naturals, FiniteSets, Bags, TLC\0a\0aVARIABLES x\0a\0a(* S == {"a"} *)\0aS == {"a", "b", "c"} \0a\0aB1 == SetToBag(S)\0aB2 == BagCup(SetToBag(S), SetToBag({"a"}))\0aB3 == [i \\in S |-> 3]\0aB4 == BagUnion({B1, B2, B3})\0aB9 == BagCup(SetToBag(S), SetToBag({"a"}))\0a\0aF1(e) == CASE e = "a" -> "fa"\0a           [] e = "b" -> "fa"\0a           [] e = "c" -> "fc"\0a           [] e = "d" -> "fc"\0a\0aInit == /\\ Print("Computing Init", TRUE) \0a        /\\ x = 1\0a\0aNext == UNCHANGED x\0a\0aInv ==\0a  /\\ Print("Computing Inv", TRUE) \0a  /\\ Print(<<"B1", B1>>, TRUE)\0a  /\\ Print(SetToBag({"a"}), TRUE)\0a\0a  /\\ LET B7    == (DOMAIN B1) \\cup (DOMAIN SetToBag({"a"})) \0a         e1(e, BB) == (IF e \\in DOMAIN BB THEN BB[e] ELSE 0)\0a     IN /\\ IF B7 = {}\0a            THEN Assert(FALSE, "Failed Test 0a")\0a            ELSE Print("Test 0a OK", TRUE)\0a\0a        /\\ IF [e \\in B7 |-> 2]["a"] # 2\0a             THEN Assert(FALSE, "Failed Test 0b")\0a             ELSE Print("Test 0b OK", TRUE)\0a\0a        /\\ IF [e \\in B7 |-> e1(e, B1)]["a"] # 1\0a             THEN Assert(FALSE, "Failed Test 0c")\0a             ELSE Print("Test 0c OK", TRUE)\0a\0a        /\\ IF [e \\in B7 |-> e1(e, SetToBag({"a"}))]["a"] # 1\0a             THEN Assert(FALSE, "Failed Test 0d")\0a             ELSE Print("Test 0d OK", TRUE)\0a\0a        /\\ IF [e \\in B7 |-> e1(e, B1) + e1(e,SetToBag({"a"}))]["a"] # 2\0a             THEN Assert(FALSE, "Failed Test 0e")\0a             ELSE Print("Test 0e OK", TRUE)\0a\0a  /\\ IF B9["a"] # 2\0a       THEN Assert(FALSE, "Failed Test 1aa")\0a       ELSE Print("Test 1aa OK", TRUE)\0a  /\\ Print("Finished test 1aa", TRUE)\0a\0a  /\\ IF B2["a"] # 2\0a       THEN Assert(FALSE, "Failed Test 1a")\0a       ELSE Print("Test 1a OK", TRUE)\0a  /\\ Print("Finished test 1a", TRUE)\0a\0a  /\\ IF BagToSet(B9) # S\0a       THEN Assert(FALSE, "Failed Test 1b")\0a       ELSE Print("Test 1b OK", TRUE)\0a\0a  /\\ IF BagToSet(B2) # S\0a       THEN Assert(FALSE, "Failed Test 1c")\0a       ELSE Print("Test 1c OK", TRUE)\0a\0a  /\\ IF BagToSet(B1 -- SetToBag({"a"})) # {"c", "b"}\0a       THEN Assert(FALSE, "Failed Test 2")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF BagToSet(B3) # BagToSet(B1)\0a       THEN Assert(FALSE, "Failed Test 3")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF BagIn("a", B1 -- SetToBag({"a"}))\0a       THEN Assert(FALSE, "Failed Test 4")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF ~BagIn("a", B2)\0a       THEN Assert(FALSE, "Failed Test 5")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF EmptyBag # B1 -- B1\0a       THEN Assert(FALSE, "Failed Test 6")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF ~(B1 \\sqsubseteq B2)\0a       THEN Assert(FALSE, "Failed Test 7")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF ~(B2 \\sqsubseteq B3)\0a       THEN Assert(FALSE, "Failed Test 8")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF B2 \\sqsubseteq B1\0a       THEN Assert(FALSE, "Failed Test 9")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF BagCup(B1, SetToBag({"d"})) \\sqsubseteq B1\0a       THEN Assert(FALSE, "Failed Test 10")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF ~(B1 \\sqsubseteq (B1 ++ SetToBag({"d"})) )\0a       THEN Assert(FALSE, "Failed Test 11")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF BagToSet(B2 ++ SetToBag({"d"})) # S \\cup {"d"}\0a       THEN Assert(FALSE, "Failed Test 12")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF Cardinality(SubBag(B1)) # Cardinality(SUBSET S)\0a       THEN Assert(FALSE, "Failed Test 13")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0a  /\\ IF Cardinality(SubBag(B3)) # 64\0a       THEN Assert(FALSE, "Failed Test 14")\0a       ELSE Print("Test 14 OK", TRUE)\0a\0a  /\\ IF CopiesIn("fa", BagOfAll(F1, B1)) # 2\0a       THEN Assert(FALSE, "Failed Test 15")\0a       ELSE Print("Test 15 OK", TRUE)\0a\0a  /\\ IF CopiesIn("a", BagOfAll(F1, B1)) # 0\0a       THEN Assert(FALSE, "Failed Test 16")\0a       ELSE Print("Test 16 OK", TRUE)\0a\0a  /\\ IF CopiesIn("fa", BagOfAll(F1, B3)) # 6\0a       THEN Assert(FALSE, "Failed Test 17")\0a       ELSE Print("Test 17 OK", TRUE)\0a\0a  /\\ IF BagCardinality(B1) # 3\0a       THEN Assert(FALSE, "Failed Test 18")\0a       ELSE Print("Test 18 OK", TRUE)\0a\0a  /\\ IF BagCardinality(B3) # 9\0a       THEN Assert(FALSE, "Failed Test 19")\0a       ELSE Print("Test 19 OK", TRUE)\0a\0a==========================================================================\0a\0a\0a=============================================================================\0a']]]
      ['suite/test24' 'test24' %accept ~[['test24' '--------------- MODULE test24 -------------\0a\0a(* Test of UNCHANGED *)\0a\0aEXTENDS Naturals, TLC\0a\0aVARIABLES x, y\0a\0aInit == /\\ x = [i \\in 1..3 |-> i]\0a        /\\ y = 1\0aNext == \0a\0a  \\/ /\\ UNCHANGED <<x, y>>\0a     /\\ \\A i \\in 1..3 : (x[i])\' = x[i]\0a     /\\ Print("Test 1 OK", TRUE)\0a\0a  \\/ /\\ UNCHANGED <<x, y>>\0a     /\\ \\A i \\in 1..3 : UNCHANGED x[i]\0a     /\\ Print("Test 2 OK", TRUE)\0a\0a  \\/ /\\ UNCHANGED <<x, y>>\0a     /\\ \\A i \\in 1..3 : UNCHANGED [a |-> x[i], b |-> x[i]+1]\0a     /\\ Print("Test 3 OK", TRUE)\0a\0a  \\/ /\\ UNCHANGED <<x, y>>\0a     /\\ IF UNCHANGED \\E i \\in 1..3 : x[i]=3\0a          THEN Print("Test 4 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 4 Failed")\0a\0a  \\/ /\\ UNCHANGED <<x, y>>\0a     /\\ IF UNCHANGED \\A i \\in 1..3 : x[i]=3\0a          THEN Print("Test 5 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 5 Failed")\0a\0a  \\/ /\\ UNCHANGED <<x, y>>\0a     /\\ IF UNCHANGED CHOOSE i \\in DOMAIN x : x[i] = 2\0a          THEN Print("Test 6 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 6 Failed")\0a\0a  \\/ /\\ UNCHANGED <<x, y>>\0a     /\\ IF UNCHANGED {x[i] : i \\in 1..2}\0a          THEN Print("Test 7 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 7 Failed")\0a\0a  \\/ /\\ UNCHANGED <<x, y>>\0a     /\\ IF UNCHANGED {i \\in 3..5 : \\E j \\in 1..3 : x[j]=i}\0a          THEN Print("Test 8 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 8 Failed")\0a\0a  \\/ /\\ UNCHANGED <<x, y>>\0a     /\\ IF UNCHANGED DOMAIN x\0a          THEN Print("Test 9 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 9 Failed")\0a\0a  \\/ /\\ (y=1) /\\ (y\' = y+1)\0a     /\\ UNCHANGED <<x>>\0a     /\\ IF UNCHANGED {x}\0a          THEN Print("Test 10 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 10 Failed")\0a\0a  \\/ /\\ (y=1) /\\ (y\' = y+1)\0a     /\\ UNCHANGED <<x>>\0a     /\\ IF UNCHANGED {1, 2, y}\0a          THEN Print("Test 11 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 11 Failed")\0a\0aInv == TRUE\0a==========================================================================\0a\0a\0a=============================================================================\0a']]]
      ['suite/test25' 'test25' %accept ~[['test25' '---------------------- MODULE test25 ----------------------\0a\0a(* test of fingerprinting elements of [S -> [B -> C]]  *)\0a\0aEXTENDS Naturals, Sequences, TLC\0a\0aCONSTANT S, T, s1, t1, c\0a\0aVARIABLES x, y, z, w\0a\0aInit ==  /\\ Print("Should find only one state", TRUE)\0a         /\\ x = [i \\in 1..3 |-> [j \\in {4,5} |-> i+j]]\0a         /\\ y = [a |-> <<"b", "c">>, b |-> <<"c", "d", "e">>]\0a         /\\ z = [i \\in S |-> [j \\in {2,3} |-> j+1]]\0a         /\\ w = [i \\in S |-> [j \\in T |-> c]]\0a\0aInv == TRUE\0a\0aNext == \0a  \\/ UNCHANGED <<x, y, z, w>>\0a\0a  \\/ /\\ x\' = << [j \\in {4,5} |-> 1+j], [j \\in {4,5} |-> 2+j], [j \\in {4,5} |-> 3+j]>>\0a     /\\ y\' = [i \\in {"a", "b"} |->\0a               IF i = "a" THEN [j \\in {1,2} |-> IF j = 1 THEN "b" ELSE "c"]\0a                          ELSE [<<"x", "d", "e">> EXCEPT ![1]= "c"]]\0a     /\\ z\' = [[z EXCEPT ![s1] = [@ EXCEPT ![3] = 77]] EXCEPT ![s1][3] = 4]\0a     /\\ w\' = [[w EXCEPT ![s1][t1] = s1] EXCEPT ![s1][t1] = c]\0a      \0a\0a===========================================================\0a']]]
      ['suite/test26' 'test26' %accept ~[['test26' '--------------- MODULE test26 -------------\0a\0a(* Test of LET *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0a\0aInit ==  x = 0\0a\0aFcnSubst(f, e(_)) ==\0a  (* A recursive definition of [i \\in DOMAIN f |-> e(i)] *)\0a  LET Range == {f[i] : i \\in DOMAIN f}\0a      FSet == UNION { [U -> Range] : U \\in SUBSET DOMAIN f}\0a      FSub[g \\in FSet] == \0a        IF g = << >> \0a          THEN g\0a          ELSE LET el == CHOOSE el \\in DOMAIN g : TRUE\0a               IN  [ i \\in DOMAIN g |-> \0a                     IF i = el \0a                      THEN e(i)\0a                      ELSE FSub[[j \\in (DOMAIN g) \\ {el} |-> f[j]]][i]]\0a  IN FSub[f]\0a\0a\0aInv == \0a\0a  /\\ LET A == {}\0a         B == A\0a     IN  IF B = {}\0a           THEN Print("Test 1 OK", TRUE)\0a           ELSE Assert(FALSE, "Test 1 Failed")\0a\0a  /\\ LET A == {}\0a         B == A\0a         C[i \\in B] == 17\0a     IN  IF C = << >> \0a           THEN Print("Test 2 OK", TRUE)\0a           ELSE Assert(FALSE, "Test 2 Failed")\0a\0a  /\\ LET e(i) == i+1\0a     IN  IF FcnSubst(<<1,2,3>>, e) = <<2,3,4>>\0a           THEN Print("Test 3 OK", TRUE)\0a           ELSE Assert(FALSE, "Test 3 Failed")\0a           \0aNext ==  UNCHANGED x\0a=========================================\0a']]]
      ['suite/test27' 'test27' %accept ~[['test27' '--------------------------- MODULE test27 ----------------------------------\0a(***************************************************************************)\0a(* A fingerprint test that models LazyCache.                               *)\0a(***************************************************************************)\0a\0aEXTENDS Naturals, Sequences, FiniteSets, TLC\0a\0aCONSTANT Addr,         (* A set                         *)\0a         Data,         (* A set                         *)\0a         InitData,     (* A subset of Data              *)\0a         ND,           (* A model value                 *)\0a         N,            (* The number of processors      *)\0a         InLen, OutLen (* Maximum lengths of in and out *)\0a\0aVARIABLE mem, c, in, out\0a\0aProc == 1..N\0a\0a\0aExp(a, m) ==\0a  (*************************************************************************)\0a  (* Recursive definition of a^n.                                          *)\0a  (*************************************************************************)\0a  LET E[n \\in Nat] == IF n = 0 THEN 1 ELSE a * E[n-1]\0a  IN  E[m]\0a\0aCountSeq(S, len) ==\0a  (*************************************************************************)\0a  (* Number of elements in Seq(S) of length \\leq len.                      *)\0a  (*************************************************************************)\0a  LET CS[n \\in Nat] == \0a        (*******************************************************************)\0a        (* Recursive definition of CountSeq(S, n).  There are              *)\0a        (* (Cardinality(S))^n sequences of length n.                       *)\0a        (*******************************************************************)\0a         IF n = 0 THEN 1\0a                  ELSE Exp(Cardinality(S), n) + CS[n-1]       \0a  IN  CS[len]\0a\0a\0aOp  ==  (Data \\X Addr) \\cup {<<d, a, "*">> : d \\in Data, a \\in Addr}\0a                            (***********************************************)\0a                            (* Have to write Data \\X Addr \\X {"*"}         *)\0a                            (* in this way.                                *)\0a                            (***********************************************)\0a                            \0aRestrict(f) == \0a    { g \\in  [Addr -> Data \\cup  { ND  }] :\0a                   \\A  a \\in  Addr: g[a] \\in  { f[a] , ND  } } \0a\0aInit == /\\ Print(LET D == Cardinality(Data)\0a                     A == Cardinality(Addr)\0a                     P == Cardinality(Proc)\0a                 IN <<"Number of distinct states =", \0a                        Exp(D, A)                    (* No. of values of mem *)\0a                      * Exp(D+1, P * A)              (* No. of values of c   *)\0a                      * Exp(CountSeq(Op, InLen), P)  (* No. of values of in  *)\0a                      * Exp(CountSeq(Data \\X Addr, OutLen), P) (* No. of values of out *)\0a                    >>, TRUE)\0a        /\\ mem \\in  [Addr -> InitData] \0a        /\\ c \\in  [Proc -> Restrict(mem)] \0a        /\\ in  = [i \\in  Proc |-> <<>>]    \0a        /\\ out = [i \\in  Proc |-> <<>>]                  \0a\0aInv ==\0a  /\\ IF mem \\in [Addr -> Data] \0a       THEN TRUE\0a       ELSE /\\ Print("Conj 1 False", TRUE)\0a            /\\ FALSE\0a  /\\ IF c   \\in [Proc -> [Addr -> (Data \\cup {ND})] ] \0a       THEN TRUE\0a       ELSE /\\ Print("Conj 2 False", TRUE)\0a            /\\ FALSE\0a  /\\ IF in  \\in [Proc -> Seq(Op)]\0a       THEN TRUE\0a       ELSE /\\ Print("Conj 3 False", TRUE)\0a            /\\ FALSE\0a  /\\ IF \\A p \\in Proc: Len(in[p]) \\leq InLen\0a       THEN TRUE\0a       ELSE /\\ Print("Conj 4 False", TRUE)\0a            /\\ FALSE\0a  /\\ IF out \\in [Proc -> Seq(Data \\X Addr)] \0a       THEN TRUE\0a       ELSE /\\ Print("Conj 5 False", TRUE)\0a            /\\ FALSE\0a  /\\ IF \\A p \\in Proc: Len(out[p]) \\leq OutLen\0a       THEN TRUE\0a       ELSE /\\ Print("Conj 6 False", TRUE)\0a            /\\ FALSE\0a\0aNext ==\0a  \\/ UNCHANGED <<mem, c, in, out>>\0a\0a  \\/ /\\ \\E a \\in Addr, d \\in Data : mem\' = [mem EXCEPT ![a] = d]\0a     /\\ UNCHANGED <<c, in, out>>\0a\0a  \\/ \\E p \\in Proc : \0a\0a        \\/ /\\ \\E a \\in Addr,  d \\in Data \\cup {ND} :\0a                  c\' = [c EXCEPT ![p][a] = d]\0a           /\\ UNCHANGED <<mem,  in, out>>\0a\0a        \\/ /\\ Len(out[p]) < OutLen\0a           /\\ \\E o \\in Data \\X Addr : out\' = [out EXCEPT ![p] = @ \\o <<o>>]\0a           /\\ UNCHANGED <<mem, c, in>>\0a\0a        \\/ /\\ Len(in[p]) < InLen\0a           /\\ \\E o \\in Op : in\' = [in EXCEPT ![p] = @ \\o <<o>>]\0a           /\\ UNCHANGED <<mem, c, out>>\0a\0a        \\/ /\\ out[p] # << >> \0a           /\\ out\' = [out EXCEPT ![p] = Tail(@)]\0a           /\\ UNCHANGED <<mem, c, in>>\0a\0a        \\/ /\\ in[p] # << >> \0a           /\\ in\' = [in EXCEPT ![p] = Tail(@)]\0a           /\\ UNCHANGED <<mem, c, out>>\0a\0a\0a\0a=============================================================================\0a']]]
      ['suite/test28' 'test28' %accept ~[['test28' '--------------- MODULE test28  -------------\0a\\* Some random test\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0a\0aBdedSeq(S, n) == UNION {[1..i -> S] : i \\in 0..n}\0a\0aInit == /\\ x = 2\0a        /\\ x > 1 \0a        /\\ Print("Test 1 OK", TRUE)\0a        /\\ 1..x = {1,2}\0a        /\\ Print("Test 2 OK", TRUE)\0a        /\\ {i + 1 : i \\in {x}} = {3}\0a        /\\ Print("Test 3 OK", TRUE)\0a        /\\ {i \\in {x} : i = 2} = {2}\0a        /\\ Print("Test 4 OK", TRUE)\0a        /\\ \\E i \\in {x} : i = 2\0a        /\\ Print("Test 5 OK", TRUE)\0a        /\\ \\E i \\in 1..x : i < x\0a        /\\ Print("Test 6 OK", TRUE)\0a        /\\ IF BdedSeq({x}, 2) # {<<>>, <<2>>, <<2,2>>}\0a             THEN Print("Failed Test 7", TRUE)\0a             ELSE Print("Test 7 OK", TRUE)\0a\0aNext == UNCHANGED x\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test29' 'test29' %accept ~[['test29' '--------------- MODULE test29  -------------\0a\0a\\* Testing proper evaluation of primed variables in action\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0a\0a\0aInit == x = 2\0a\0aNext == /\\ x\' = 2\0a        /\\ x\' > 1 \0a        /\\ Print("Test 1 OK", TRUE)\0a        /\\ 1..x\' = {1,2}\0a        /\\ Print("Test 2 OK", TRUE)\0a        /\\ {i + 1 : i \\in {x\'}} = {3}\0a        /\\ Print("Test 3 OK", TRUE)\0a        /\\ {i \\in {x\'} : i = 2} = {2}\0a        /\\ Print("Test 4 OK", TRUE)\0a        /\\ \\E i \\in {x\'} : i = 2\0a        /\\ Print("Test 5 OK", TRUE)\0a        /\\ \\E i \\in 1..x\' : i < x\'\0a        /\\ Print("Test 6 OK", TRUE)\0a\0a\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test3' 'test3' %accept ~[['test3' '--------------- MODULE test3 -------------\0a\0a(* Test of function application. *)\0a\0aEXTENDS Naturals, TLC\0a\0aVARIABLE x\0aCONSTANT a, b, c\0a\0aType == x \\in {1}\0aInv  == \0a /\\ TRUE\0a\0a /\\ IF [i \\in {3, 2, 1} |-> i+1][3] # 4\0a      THEN Assert(FALSE, "Test 1")\0a      ELSE Print("Test 1", TRUE)\0a\0a /\\ IF <<a, b, c>>[2] # b\0a      THEN Assert(FALSE, "Test 2")\0a      ELSE Print("Test 2", TRUE)\0a\0a /\\ IF [a |-> 1, b |-> 42, c |-> 99]["b"] # 42\0a      THEN Assert(FALSE, "Test 3" )\0a      ELSE Print("Test 3" , TRUE) \0a\0a /\\ IF [i \\in Nat |-> i+1][3] # 4\0a      THEN Assert(FALSE, "Test 4" )\0a      ELSE Print("Test 4" , TRUE) \0a\0a /\\ IF [[i \\in Nat |-> i+1] EXCEPT ![42] = 3, ![42] = 5][42] # 5\0a      THEN Assert(FALSE, "Test 5" )\0a      ELSE Print("Test 5" , TRUE) \0a\0a /\\ IF [[i \\in Nat |-> i+1] EXCEPT ![42] = 3, ![42] = 5][79] # 80\0a      THEN Assert(FALSE, "Test 6" )\0a      ELSE Print("Test 6" , TRUE) \0a\0a /\\ IF [i \\in Nat |-> [j \\in Nat |-> 2*i + j]][5][3] # 13\0a      THEN Assert(FALSE, "Test 7" )\0a      ELSE Print("Test 7" , TRUE) \0a\0a /\\ IF [[i \\in Nat |-> [j \\in Nat |-> 2*i + j]] EXCEPT ![5] = 11][5] # 11\0a      THEN Assert(FALSE, "Test 8" )\0a      ELSE Print("Test 8" , TRUE) \0a /\\ IF [[i \\in Nat |-> [j \\in Nat |-> 2*i + j]] EXCEPT ![5][3] = @+1][5][3] # 14\0a      THEN Assert(FALSE, "Test 9" )\0a      ELSE Print("Test 9" , TRUE) \0a\0a /\\ IF [[i \\in Nat |-> [j \\in Nat |-> 2*i + j]] \0a            EXCEPT ![5][4] = @+2, ![5][3] = @+1][5][3] # 14\0a      THEN Assert(FALSE, "Test 10" )\0a      ELSE Print("Test 10" , TRUE) \0a\0a /\\ IF [[i \\in Nat |-> [j \\in Nat |-> 2*i + j]] \0a            EXCEPT ![5][3] = @+1, ![5][4] = @+2][5][3] # 14\0a      THEN Assert(FALSE, "Test 11" )\0a      ELSE Print("Test 11" , TRUE) \0a\0a /\\ IF [[i \\in Nat |-> [j \\in Nat |-> 2*i + j]] \0a        EXCEPT ![5][3] = @+1, ![5][3] = @+2][5][3] # 16\0a      THEN Assert(FALSE, "Test 12" )\0a      ELSE Print("Test 12" , TRUE) \0a\0a /\\ IF [i \\in Nat, j \\in STRING |-> <<i+1, j>>][22, "b"] # <<23, "b">>\0a      THEN Assert(FALSE, "Test 13" )\0a      ELSE Print("Test 13" , TRUE) \0a\0a /\\ IF [i \\in Nat, j \\in STRING |-> <<i+1, j>>][<<22, "b">>] # <<23, "b">>\0a      THEN Assert(FALSE, "Test 14" )\0a      ELSE Print("Test 14" , TRUE) \0a\0a /\\ IF [[i \\in Nat, j \\in STRING |-> <<i+1, j>>] \0a        EXCEPT ![22, "c"] = 15] [22, "b"] # <<23, "b">>\0a      THEN Assert(FALSE, "Test 15" )\0a      ELSE Print("Test 15" , TRUE) \0a\0a /\\ IF [[i \\in Nat, j \\in STRING |-> <<i+1, j>>] \0a          EXCEPT ![22, "c"] = 15] [22, "c"] # 15\0a      THEN Assert(FALSE, "Test 16" )\0a      ELSE Print("Test 16" , TRUE) \0a\0a /\\ IF [[i \\in Nat, j \\in STRING |-> <<i+1, j>>] \0a        EXCEPT ![22, "c"] = 15] [<<22, "c">>] # 15\0a      THEN Assert(FALSE, "Test 17" )\0a      ELSE Print("Test 17" , TRUE) \0a\0a /\\ IF [[i \\in Nat, j \\in STRING |-> <<i+1, j>>] \0a          EXCEPT ![22, "c"] = 15, ![22, "d"] = 33] [22, "c"] # 15\0a      THEN Assert(FALSE, "Test 18" )\0a      ELSE Print("Test 18" , TRUE) \0a\0a /\\ IF [[i \\in Nat, j \\in STRING |-> <<i+1, j>>] \0a          EXCEPT ![22, "d"] = 33, ![22, "c"] = 15] [22, "c"] # 15\0a      THEN Assert(FALSE, "Test 19" )\0a      ELSE Print("Test 19" , TRUE) \0a\0a /\\ IF [[i \\in Nat, j \\in STRING |-> <<i+1, j>>] \0a          EXCEPT ![22, "d"] = 33, ![22, "d"] = 15] [22, "d"] # 15\0a      THEN Assert(FALSE, "Test 20" )\0a      ELSE Print("Test 20" , TRUE) \0a\0a /\\ IF [[i \\in Nat, j \\in STRING |-> <<i+1, j>>] \0a        EXCEPT ![22, "d"] = @[1]] [22, "d"] # 23\0a      THEN Assert(FALSE, "Test 21" )\0a      ELSE Print("Test 21" , TRUE) \0a\0a\0a /\\ IF [[i \\in Nat, j \\in Nat |-> <<i+1, j>>] \0a         EXCEPT ![22, 3] = @[1]] [22, 3] # 23\0a      THEN Assert(FALSE, "Test 22" )\0a      ELSE Print("Test 22" , TRUE) \0a\0a /\\ Print("Tests completed", TRUE)\0a\0a\0a /\\ Print("Tests completed", TRUE)\0a\0aInit == x = 1\0a\0aNext == UNCHANGED x\0a=========================================\0a']]]
      ['suite/test30-true' 'test30-true' %reject ~[['test30-true' '--------------- MODULE test31  -------------\0a\0a(* Test replacement of and by infix operators and overridden operators. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0a\0aCONSTANT P(_,_), _++_ , Plus(_, _), PLen(_)\0a\0aPlusPlus(a, b) == <<a, b>>\0a\0aPRep(a, b) == {a, b}\0a\0aMCSeq(a) = {a}\0a\0aMCCat(a, b) == a + b\0a\0aInit == /\\ x = 1\0a        /\\ IF P(2, x+3) = {2, 4}\0a             THEN Print("Test 1 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 1 Failed")\0a        /\\ IF (2++(x+3)) = <<2, 4>>\0a             THEN Print("Test 2 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 2 Failed")\0a        /\\ IF PLen(<<1, 2, 3>>) = 3\0a             THEN Print("Test 3 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 3 Failed")\0a        /\\ IF Plus(2, x+3) = 6\0a             THEN Print("Test 4 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 4 Failed")\0a        /\\ IF Seq(22) = {22}\0a             THEN Print("Test 5 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 5 Failed")\0a        /\\ IF 1 \\o 2 = 3                          (* Huh???? *)\0a             THEN Print("Test 6 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 6 Failed")\0a        /\\ LET a \\prec b == a < b\0a           IN  IF 1 \\prec 2\0a                 THEN Print("Test 7 OK", TRUE)\0a                 ELSE Assert(FALSE, "Test 7 Failed")\0a\0aNext == UNCHANGED x\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test30' 'test30' %accept ~[['test30' '--------------- MODULE test30  -------------\0a\0a(* Test replacement of and by infix operators and overridden operators. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0a\0aCONSTANT P(_,_), _++_ , Plus(_, _), PLen(_)\0a\0aPlusPlus(a, b) == <<a, b>>\0a\0aPRep(a, b) == {a, b}\0a\0aMCSeq(a) == {a}\0a\0aMCCat(a, b) == a + b\0a\0aInit == /\\ x = 1\0a        /\\ IF P(2, x+3) = {2, 4}\0a             THEN Print("Test 1 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 1 Failed")\0a        /\\ IF (2++(x+3)) = <<2, 4>>\0a             THEN Print("Test 2 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 2 Failed")\0a        /\\ IF PLen(<<1, 2, 3>>) = 3\0a             THEN Print("Test 3 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 3 Failed")\0a        /\\ IF Plus(2, x+3) = 6\0a             THEN Print("Test 4 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 4 Failed")\0a        /\\ IF Seq(22) = {22}\0a             THEN Print("Test 5 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 5 Failed")\0a        /\\ IF 1 \\o 2 = 3                          (* Huh???? *)\0a             THEN Print("Test 6 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 6 Failed")\0a        /\\ LET a \\prec b == a < b\0a           IN  IF 1 \\prec 2\0a                 THEN Print("Test 7 OK", TRUE)\0a                 ELSE Assert(FALSE, "Test 7 Failed")\0a\0aNext == UNCHANGED x\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test31' 'test31' %accept ~[['test31' '--------------- MODULE test31  -------------\0a\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aVARIABLE x, y\0a\0aInit == /\\ Print("This test should generate 3 distinct state", TRUE)\0a        /\\ x = 1\0a        /\\ y = 1\0a\0aNext == \\/ /\\ Print("1", TRUE)\0a           /\\ x\' \\in {1, 2, 3}\0a           /\\ y\' = 1\0a           /\\ Print(<<"Generated state", x\', y\'>>, TRUE)\0a\0a        \\/ UNCHANGED <<x, y>>\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test32' 'test32' %accept ~[['test32' '--------------- MODULE test32  -------------\0a\0a(* Test of [A]_e and <<A>>_e *)\0a\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aVARIABLE x, y\0a\0aInit == /\\ x = 1\0a        /\\ y = 1\0a\0aAct1 == /\\ x\' = 1\0a        /\\ y\' = 1\0a\0aNext == \\/ /\\ UNCHANGED <<x, y>>\0a           /\\ IF [x # x]_<<x,y>>\0a                THEN Print("Test1 OK", TRUE)\0a                ELSE Assert(FALSE, "Test 1 Failed") \0a           /\\ IF <<Act1>>_<<x,y>>\0a                THEN Assert(FALSE, "Test 2 Failed")\0a                ELSE Print("Test2 OK", TRUE)\0a\0a        \\/ /\\ <<x\'= 1 /\\ y\'=1>>_y\0a           /\\ Assert(FALSE, "Test 3 Failed")\0a\0a        \\/ /\\ Print("Test 4 started -- should finish", TRUE)\0a           /\\ [FALSE]_<<x,y>>\0a           /\\ Print("Test 4 completed" , TRUE)\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test33' 'test33' %accept ~[['test33' '--------------- MODULE test33  -------------\0a\0a(* Test of large sets of functions *)\0a\0aEXTENDS TLC, Naturals\0a\0aVARIABLE x\0a\0aInit == /\\ Print(<<"Computing", 7^6, "States">>, TRUE)\0a        /\\ x \\in [1..6 -> 1..7]   \0a\0aNext == UNCHANGED x\0a\0aInv ==  TRUE\0a=========================================\0a\0aWorks for 7^6 = 117649 states on dix in     43.049u   3.729s  1:16.97 60.7%  \0a                                           (1529 states/sec)\0aWorks for 6^7 = 279936 states on dix in    113.333u  19.494s  3:37.24 61.1%\0a                                           (1289 states/sec)\0aworks for 7^7 = 823543 states on rowdy in  655.835u 158.050s 11:03.11 122.7%\0a                                           (1242 states/sec)\0aDoesn\'t work for 7^7 = 823543 states on dix\0a']]]
      ['suite/test34' 'test34' %accept ~[['test34' '--------------- MODULE test34  -------------\0a\0a(* Test Model Values *)\0a\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aCONSTANTS a, b, c\0a\0aVARIABLE x\0a\0aInit == x = 1\0a\0aNext == UNCHANGED x\0a\0aInv ==  /\\ IF a \\in STRING THEN Assert(FALSE, "Test 1 failed")\0a                           ELSE Print("Test 1 OK", TRUE)\0a        /\\ IF a = {1, 2}   THEN Assert(FALSE, "Test 2 failed")\0a                           ELSE Print("Test 2 OK", TRUE)\0a        /\\ IF a \\in {i \\in Nat : i > 7} \0a             THEN Assert(FALSE, "Test 3 failed")\0a             ELSE Print("Test 3 OK", TRUE)\0a        /\\ IF a \\in {b, c} THEN Assert(FALSE, "Test 4 failed")\0a                           ELSE Print("Test 4 OK", TRUE)\0a\0a=========================================\0a']]]
      ['suite/test35' 'test35' %accept ~[['test35' '------------------------------ MODULE test35 -----------------------------\0a(* Test of standard Sequences module.    *)\0a\0aEXTENDS Sequences, Integers, TLC\0a\0aVARIABLES x\0a\0aInit == x = 0\0a\0aNext == UNCHANGED x\0a\0aInv == \0a       /\\ IF  <<1, 2, 3>> \\in Seq(Nat)\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed")\0a\0a       /\\ IF  <<1, -2, 3>> \\notin Seq(Nat)\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed")        \0a\0a       /\\ IF <<1, 2, 3>> \\o <<4, 5>> = <<1, 2, 3, 4, 5>>\0a            THEN Print("Test 3 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")\0a\0a       /\\ IF << >> \\o << >> = << >>\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4 Failed")\0a\0a       /\\ IF << >> \\o <<1, 2 >> = <<1, 2 >>\0a            THEN Print("Test 5 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 5 Failed")\0a\0a       /\\ IF Len(<< >>) = 0\0a            THEN Print("Test 6 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 6 Failed")\0a\0a       /\\ IF Len(<<1, 2, 3>>) = 3\0a            THEN Print("Test 7 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 7 Failed")\0a\0a       /\\ IF Append(<<1, 2, 3>>, 4) = <<1, 2, 3, 4>>\0a            THEN Print("Test 8 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 8 Failed")\0a\0a       /\\ IF Append(<< >>, "a") = <<"a">>\0a            THEN Print("Test 9 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 9 Failed")\0a\0a       /\\ IF Head(<< 1 >>) = 1\0a            THEN Print("Test 10 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 10 Failed")\0a\0a       /\\ IF Head(<<1, 2, 3>>) = 1\0a            THEN Print("Test 11 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 11 Failed")\0a\0a       /\\ IF Tail(<<1>>) = << >>\0a            THEN Print("Test 12 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 12 Failed")\0a\0a       /\\ IF Tail (<<1, 2, 3>>) = <<2, 3>>\0a            THEN Print("Test 13 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 13 Failed")\0a\0a(*       /\\ IF SubSeq(<<1, 2, 3, 4, 5>>, 2, 4) = <<2, 3, 4>>\0a            THEN Print("Test 14 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 14 Failed")  \0a\0a       /\\ IF SubSeq(<<1, 2, 3, 4, 5>>, 1, 1) = <<1>>\0a            THEN Print("Test 15 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 15 Failed")   *)\0a\0a       /\\ IF SubSeq(<<1, 2, 3, 4, 5>>, 2, 1) = <<>>\0a            THEN Print("Test 16 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 16 Failed")\0a\0a(*       /\\ IF SubSeq(<<1, 2, 3, 4, 5>>, 5, 5) = <<5>>\0a            THEN Print("Test 17 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 17 Failed")   *)\0a\0a       /\\ IF LET T(a) == a \\in Nat\0a             IN  SelectSeq(<<-1, 2, -3, 4, -5, 6>>, T) = <<2, 4, 6>>\0a            THEN Print("Test 18 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 18 Failed")\0a\0a       /\\ IF LET T(a) == a \\in Nat\0a             IN  SelectSeq(<<0, -1, 2, -3, 4, -5>>, T) = <<0, 2, 4>>\0a            THEN Print("Test 19 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 19 Failed")\0a\0a       /\\ IF LET T(a) == a \\in Nat\0a             IN  SelectSeq(<<-1, -3, -5>>, T) = << >>\0a            THEN Print("Test 20 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 20 Failed")\0a\0a=============================================================================\0a']]]
      ['suite/test36' 'test36' %accept ~[['test36' '----------------------------- MODULE test36 --------------------------------\0a\0a(* Test of standard Bags module *)\0a\0aEXTENDS Naturals, TLC, Sequences, FiniteSets, Bags\0a\0aBag1 == SetToBag({"a", "b"})\0aBag2 == Bag1 (+) SetToBag({"a"})\0a\0aVARIABLES x\0aInit == x = 0\0aNext == x\'=x\0a\0aInv ==\0a       /\\ IF IsABag( Bag1 )\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed")\0a\0a       /\\ IF BagToSet(Bag2) = {"a", "b"}\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed")\0a\0a       /\\ IF BagIn("a", Bag2)\0a            THEN Print("Test 3 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")\0a\0a       /\\ IF ~BagIn("c", Bag2)\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4 Failed")\0a\0a       /\\ IF BagToSet(EmptyBag) = {}\0a            THEN Print("Test 5 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 5 Failed")\0a\0a       /\\ IF EmptyBag (+) Bag2 = Bag2\0a            THEN Print("Test 6 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 6 Failed")\0a\0a       /\\ IF Bag2 (-) SetToBag({"a"}) = Bag1\0a            THEN Print("Test 7 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 7 Failed")             \0a\0a       /\\ IF Bag1 (-) SetToBag({"a"}) = SetToBag({"b"})\0a            THEN Print("Test 8 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 8 Failed")            \0a\0a       /\\ IF BagUnion({Bag1, Bag2}) = Bag1 (+) Bag2\0a            THEN Print("Test 9 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 9 Failed")         \0a\0a       /\\ IF Bag1 \\sqsubseteq Bag2\0a            THEN Print("Test 10 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 10 Failed")   \0a\0a       /\\ Print("TLC Fails Tests 11 & 12 because SubBag not implemented", TRUE)\0a(*       /\\ IF Bag1 \\in SubBag(Bag2)\0a            THEN Print("Test 11 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 11 Failed")\0a\0a       /\\ IF Cardinality(SubBag(Bag2)) = 6\0a            THEN Print("Test 12 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 12 Failed")  *)\0a\0a       /\\ IF LET f(a) == <<"c", a>>\0a             IN  CopiesIn(<<"c", "a">>, BagOfAll(f, Bag2)) = 2\0a            THEN Print("Test 13 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 13 Failed")  \0a\0a       /\\ IF BagCardinality(Bag2) = 3\0a            THEN Print("Test 14 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 14 Failed")\0a\0a       /\\ IF CopiesIn("a", Bag2) = 2\0a            THEN Print("Test 15 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 15 Failed")\0a\0a       /\\ IF CopiesIn("c", Bag2) = 0\0a            THEN Print("Test 16 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 16 Failed")\0a\0a\0a\0a=============================================================================\0a\0a(* Last modified on Thu Aug 08 13:28:29 PT 2002 by lamport *)\0a\0a 6 Apr 99 : Modified version for standard module set\0a 7 Dec 98 : Corrected error found by Stephan Merz.\0a 6 Dec 98 : Modified comments based on suggestions by Lyle Ramshaw.\0a 5 Dec 98 : Initial version.']]]
      ['suite/test37' 'test37' %accept ~[['test37' '---------------------------- MODULE test37 -----------------------------\0a\0a(* Test of standard FiniteSets module *)\0a\0aEXTENDS FiniteSets, TLC\0a\0aVARIABLES x\0a\0aInit == x = 0\0aNext == x\'=x\0aInv  ==\0a       /\\ IF IsFiniteSet({"a", "b"})\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed")\0a\0a       /\\ IF IsFiniteSet({})\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed")\0a\0a       /\\ IF Cardinality({}) = 0\0a            THEN Print("Test 3 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")\0a\0a       /\\ IF Cardinality({"a", "b"}) = 2\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4 Failed")\0a\0a\0a=============================================================================\0a']]]
      ['suite/test38' 'test38' %accept ~[['test38' '---------------------------- MODULE test38 -----------------------------\0a\0a(* Test of EXTENDS *)\0a\0aEXTENDS test38a, TLC\0a\0aVARIABLES x\0a\\* CONSTANT c\0a\0aInit == MInit(x)\0aNext == x\'=c\0aInv  == IF (x=c) THEN Print("Test OK", TRUE)\0a                 ELSE Print("Test Failed", TRUE)\0a\0a\0a=============================================================================\0a'] ['test38a' '---------------------------- MODULE test38a -----------------------------\0a\0a(* Test of EXTENDS *)\0a\0a\\* VARIABLES x    multiple declarations no longer allowed.\0a CONSTANT c\0a\0aMInit(x) == x = c\0a\0a=============================================================================\0a']]]
      ['suite/test38a' 'test38a' %accept ~[['test38a' '---------------------------- MODULE test38a -----------------------------\0a\0a(* Test of EXTENDS *)\0a\0a\\* VARIABLES x    multiple declarations no longer allowed.\0a CONSTANT c\0a\0aMInit(x) == x = c\0a\0a=============================================================================\0a']]]
      ['suite/test39' 'test39' %accept ~[['test39' '--------------- MODULE test39 -------------\0a\0a(* Test priming and operator arguments *)\0a\0aEXTENDS TLC, Integers, Sequences, FiniteSets\0a\0aVARIABLE x, y\0a\0aInit == /\\ x = [i \\in {1,2} |-> i]\0a        /\\ y = 1\0a\0aAction1(c,d) == c\' = [c EXCEPT ![1] = d\']\0aAction2(c,d) == c\' = [c EXCEPT ![1] = d]\0a\0a\0aNext ==  \\/ /\\ y = 1\0a            /\\ y\' = 2\0a            /\\ Action1(x, y)\0a            /\\ IF x[1]\' = 2\0a                 THEN Print("Test1 OK", TRUE)\0a                 ELSE Assert(FALSE, "Test1 Failed") \0a\0a         \\/ /\\ y = 1\0a            /\\ y\' = 2\0a            /\\ Action2(x, y)\0a            /\\ IF x[1]\' = 1\0a                 THEN Print("Test2 OK", TRUE)\0a                 ELSE Assert(FALSE, "Test2 Failed")\0a\0a         \\/ UNCHANGED <<x, y>>\0a\0aInv ==  TRUE\0a         \0a\0aConstraint == TRUE\0a=========================================\0a']]]
      ['suite/test4' 'test4' %accept ~[['test4' '--------------- MODULE test4 -------------\0a\0a(* Test of fingerprinting of sets. *)\0a\0aEXTENDS Naturals, TLC, Sequences\0a\0aVARIABLE x, y, z, w\0a\0aType == \0a  /\\ x \\in {{1, 2, 3}}\0a  /\\ y \\in {{"a", "b", "c"}}\0a  /\\ z \\in {[a : {1, 2, 3}, b : {1, 2, 3}, c : {1, 2, 3}]}\0a  /\\ w \\in {[{1, 2, 3} -> {1, 2, 3}]}\0a\0a\0aInit == \0a  /\\ Print("Should find only one distinct state", TRUE)\0a  /\\ x = {1, 2, 3}\0a  /\\ y = {"a", "b", "c"}\0a  /\\ z = [a : {1, 2, 3}, b : {1, 2, 3}, c : {1, 2, 3}]\0a  /\\ w = [{1, 2, 3} -> {1, 2, 3}]\0a\0aInv  == \0a  /\\ TRUE\0a  /\\ x = {1, 2, 3}\0a  /\\ y = {"a", "b", "c"}\0a  /\\ z = [a : {1, 2, 3}, b : {1, 2, 3}, c : {1, 2, 3}]\0a  /\\ w = [{1, 2, 3} -> {1, 2, 3}]\0a\0a\0aNext ==\0a  \\/ /\\ x\' = {3, 3, 2, 1}\0a     /\\ UNCHANGED <<y, z, w>>\0a     /\\ Print("Test 1", TRUE)\0a\0a  \\/ /\\ x\' = 1..3\0a     /\\ UNCHANGED <<y, z, w>>\0a     /\\ Print("Test 2", TRUE)\0a\0a  \\/ /\\ x\' = {i \\in {5, 4, 3, 3, 2, 2, 1} : i \\leq 3}\0a     /\\ UNCHANGED <<y, z, w>>\0a     /\\ Print("Test 2", TRUE)\0a\0a  \\/ /\\ x\' = {i-3 : i \\in 4..6}\0a     /\\ UNCHANGED <<y, z, w>>\0a     /\\ Print("Test 2", TRUE)\0a\0a  \\/ /\\ x\' = {i-3 : i \\in {6, 6, 5, 4, 4, 5, 5}}\0a     /\\ UNCHANGED <<y, z, w>>\0a     /\\ Print("Test 2", TRUE)\0a\0a  \\/ /\\ x\' = { f[i] : i \\in 1..3, f \\in [{1,2,3} -> {1,2,3}] }\0a     /\\ UNCHANGED <<y, z, w>>\0a     /\\ Print("Test 3", TRUE)\0a\0a  \\/ /\\ y\' = DOMAIN [a |-> 1, b |-> 2, c |-> 3]\0a     /\\ UNCHANGED <<x, z, w>>\0a     /\\ Print("Test 4", TRUE)\0a  \\/ /\\ z\' = [{"a", "b", "c"} -> {1, 2, 3}]\0a     /\\ UNCHANGED <<y, x, w>>\0a     /\\ Print("Test 5", TRUE)\0a\0a  \\/ /\\ w\' = [{3,1, 2} -> {1, 3, 2}]\0a     /\\ UNCHANGED <<y, x, z>>\0a     /\\ Print("Test 6", TRUE)\0a\0a  \\/ /\\ w\' = [{3,1, 3, 3, 3, 2} -> {2, 2, 1, 3, 2}]\0a     /\\ UNCHANGED <<y, x, z>>\0a     /\\ Print("Test 6", TRUE)\0a\0a\0a============================================\0a']]]
      ['suite/test40' 'test40' %accept ~[['test40' '------------------------------ MODULE test40 -----------------------------\0a(* Test of standard Naturals module.    *)\0a\0aEXTENDS Naturals, TLC\0a\0aVARIABLES x\0a\0aInit == x = 0\0a\0aNext == UNCHANGED x\0a\0aInv == \0a       /\\ IF  2^10 + 2^10 = 2^11\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed")    \0a\0a       /\\ IF 0^20 = 0\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed")    \0a\0a       /\\ IF 2^21 - 2^20 = 2^20\0a            THEN Print("Test 2a OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2a Failed") \0a\0a       /\\ IF 2 - 3 \\notin Nat\0a            THEN Print("Test 3 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")\0a\0a       /\\ IF 123 * 345 = 42435\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4 Failed")\0a\0a       /\\ IF 123 < 124\0a            THEN Print("Test 5 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 5 Failed")\0a\0a       /\\ IF 12345 > 12344\0a            THEN Print("Test 6 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 6 Failed")\0a\0a       /\\ IF 123 \\leq 123\0a            THEN Print("Test 7 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 7 Failed")\0a\0a       /\\ IF 12345 \\geq 12345\0a            THEN Print("Test 8 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 8 Failed")\0a\0a       /\\ IF 123 \\leq 124\0a            THEN Print("Test 9 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 9 Failed")\0a\0a       /\\ IF 12344 \\geq 12333\0a            THEN Print("Test 10 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 10 Failed")\0a\0a       /\\ IF 145939 = 487 * (145939 \\div 487) + (145939 % 487) \0a            THEN Print("Test 11 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 11 Failed")  \0a\0a       /\\ IF 139982 \\div 1 = 139982 \0a            THEN Print("Test 12 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 12 Failed")\0a\0a       /\\ IF 123099 % 1 = 0\0a            THEN Print("Test 13 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 13 Failed")\0a\0a       /\\ IF 0 % 345 = 0\0a            THEN Print("Test 14 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 14 Failed")  \0a\0a       /\\ IF 24 % 9 = 6\0a            THEN Print("Test 15 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 15 Failed")   \0a\0a       /\\ IF 4566799 = 423 * (4566799 \\div 423) + (4566799 % 423)\0a            THEN Print("Test 16 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 16 Failed")    \0a\0a       /\\ IF 2222222 = 18 * (2222222 \\div 18) + (2222222 % 18)\0a            THEN Print("Test 17 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 17 Failed")   \0a\0a       /\\ IF 3 .. 2 = {}\0a            THEN Print("Test 18 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 18 Failed")\0a\0a       /\\ IF 2..4 = {2, 3, 4}\0a            THEN Print("Test 19 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 19 Failed")\0a\0a       /\\ IF (0-1) * (0-3) = 3\0a            THEN Print("Test 20 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 20 Failed")\0a\0a       /\\ IF (0-1) % 3 = 2\0a            THEN Print("Test 21 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 21 Failed")\0a\0a=============================================================================\0a']]]
      ['suite/test41' 'test41' %accept ~[['test41' '------------------------------ MODULE test41 -----------------------------\0a(* Test of standard Integers module.    *)\0a\0aEXTENDS Integers, TLC\0a\0aVARIABLES x\0a\0aInit == x = 0\0a\0aNext == UNCHANGED x\0a\0aInv == \0a       /\\ IF  2^10 + 2^10 = 2^11\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed")    \0a\0a       /\\ IF 0^20 = 0\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed")   \0a\0a       /\\ IF 2 - 3 \\in Int\0a            THEN Print("Test 3 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")\0a\0a       /\\ IF (-123) * (-345) = 42435\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4 Failed")\0a\0a       /\\ IF -123 > -124\0a            THEN Print("Test 5 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 5 Failed")\0a\0a       /\\ IF -12345 < -12344\0a            THEN Print("Test 6 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 6 Failed")\0a\0a       /\\ IF -123 \\leq -123\0a            THEN Print("Test 7 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 7 Failed")\0a\0a       /\\ IF -12345 \\geq -12345\0a            THEN Print("Test 8 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 8 Failed")\0a\0a       /\\ IF -123 \\geq -124\0a            THEN Print("Test 9 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 9 Failed")\0a\0a       /\\ IF -12344 \\leq 12333\0a            THEN Print("Test 10 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 10 Failed")\0a\0a       /\\ IF -145939 = 487 * ((-145939) \\div 487) + ((-145939) % 487) \0a            THEN Print("Test 11 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 11 Failed")    \0a\0a       /\\ IF -139982 \\div 1 = -139982 \0a            THEN Print("Test 12 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 12 Failed")\0a\0a       /\\ IF -123099 % 1 = 0\0a            THEN Print("Test 13 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 13 Failed")\0a\0a       /\\ IF (-1) % 345 = 344\0a            THEN Print("Test 14 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 14 Failed")  \0a\0a       /\\ IF (-24) % 9 = 3\0a            THEN Print("Test 15 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 15 Failed")   \0a\0a       /\\ IF -4566799 = 423 * ((-4566799) \\div 423) + ((-4566799) % 423)\0a            THEN Print("Test 16 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 16 Failed")    \0a\0a       /\\ IF -2222222 = 18 * ((-2222222) \\div 18) + (-2222222 % 18)\0a            THEN Print("Test 17 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 17 Failed")   \0a\0a       /\\ IF (-2) .. (-3) = {}\0a            THEN Print("Test 18 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 18 Failed")\0a\0a       /\\ IF (-4)..(-2) = {-2, -3, -4}\0a            THEN Print("Test 19 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 19 Failed")\0a\0a       /\\ IF 2*3+4 = 10\0a            THEN Print("Test 20 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 20 Failed")\0a\0a       /\\ IF 2^3*3 = 24\0a            THEN Print("Test 21 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 21 Failed")\0a\0a\0a       /\\ IF 4+2*3 = 10\0a            THEN Print("Test 22 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 22 Failed") \0a\0a\0a       /\\ IF 3*2^3 = 24\0a            THEN Print("Test 23 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 23 Failed")\0a\0a\0a       /\\ IF 1 + -2 = -1\0a            THEN Print("Test 24 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 24 Failed")\0a\0a\0a       /\\ IF 5 + 5 \\div 2 = 7\0a            THEN Print("Test 25 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 25 Failed")\0a\0a       /\\ IF  5 \\div 2 + 2 = 4\0a            THEN Print("Test 26 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 26 Failed") \0a\0a       /\\ IF 3 - 2 * 5 = -7\0a            THEN Print("Test 27 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 27 Failed")\0a\0a       /\\ IF 4 * 2 % 3 = 2\0a            THEN Print("Test 28 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 28 Failed")\0a\0a\0a=============================================================================\0a']]]
      ['suite/test42' 'test42' %accept ~[['test42' '--------------- MODULE test42 -------------\0a\0a(* Test of operator arguments  *)\0a\0aEXTENDS TLC, Integers, Sequences\0a\0aVARIABLE x\0a\0aa ++ b == a + b\0a\0aFoo(a, _--_) == a -- 0\0a\0a\0aInit == x = 1\0a\0a\0aNext ==  x\' = x\0a         \0aFooBar(a, Op(_,_)) == Op(a, 0)\0a\0aPlus(a, b) == a + b\0a\0aInv ==  /\\ IF FooBar(7, Plus) = 7\0a             THEN Print("Test 1 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 1 Failed")  \0a\0a        /\\ IF FooBar(7,+) = 7 \0a             THEN Print("Test 2 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 2 Failed")  \0a\0a        /\\ IF Foo(7, *) = 0 \0a             THEN Print("Test 3 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 3 Failed")  \0a\0a        /\\ IF Foo(7,+) = 7 \0a             THEN Print("Test 4 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 4 Failed")  \0a\0a        /\\ IF Foo(7,++) = 7 \0a             THEN Print("Test 5 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 5 Failed")  \0a\0aConstraint == TRUE\0a=========================================\0a']]]
      ['suite/test43' 'test43' %accept ~[['test43' '--------------- MODULE test43  -------------\0a\0a(* Test of TLC module *)\0a\0aEXTENDS TLC, Integers, Sequences\0a\0aVARIABLE x\0a\0aFApply(f, Op(_,_), Identity) ==\0a  LET fa[S \\in SUBSET DOMAIN f] ==\0a        IF S = { } THEN Identity\0a                   ELSE LET s == CHOOSE s \\in S : TRUE\0a                        IN  Op(f[s], fa[S \\ {s}])\0a                            \0a  IN  fa[DOMAIN f]\0a\0aBoundedSeq(S, n) == UNION {[1..i -> S] : i \\in 0..n}\0aPlus(a, b) == a + b\0a\0aTimes(a, b) == a * b\0a\0aInit == x = 1\0a\0aNext ==  x\' = x\0a\0aInv ==  \0a\0a        /\\ IF FApply([i \\in {"a", "b", "c"} |-> 3], Times, 1) = 27\0a             THEN Print("Test 1 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 1 Failed")\0a\0a        /\\ IF FApply(<<3, 4, 5, 6>> , Plus, 0) = 18\0a             THEN Print("Test 2 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 2 Failed")\0a        \0a        /\\ IF FApply(<<3>> , Plus, 0) = 3\0a             THEN Print("Test 3 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 3 Failed")\0a        \0a        /\\ IF FApply(<<>> , Plus, 7) = 7\0a             THEN Print("Test 4 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 4 Failed")  \0a\0a        /\\ IF <<1, 2>> \\in BoundedSeq(1..3, 3)\0a             THEN Print("Test 5 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 5 Failed")\0a\0a        /\\ IF <<1, 2, 3>> \\notin BoundedSeq(1..3, 2)\0a             THEN Print("Test 6 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 6 Failed")         \0a\0a        /\\ IF <<-1, 2>> \\notin BoundedSeq(1..4, 6)\0a             THEN Print("Test 7 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 7 Failed")\0a\0a        /\\ IF << >> \\in BoundedSeq({"a", "b"}, 2)\0a             THEN Print("Test 8 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 8 Failed")\0a\0a        /\\ IF \\A s \\in BoundedSeq({"a", "b", "c"}, 2) :\0a                Len(s) \\leq 2\0a             THEN Print("Test 9 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 10 Failed")\0a\0a        /\\ IF SortSeq(<<3, 2, 4, 2>>, \\leq) = <<2, 2, 3, 4>>\0a             THEN Print("Test 10 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 12 Failed")\0a\0a        /\\ IF SortSeq(<<3, 2, 4, 2>>, <) = <<2, 2, 3, 4>>\0a             THEN Print("Test 11 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 13 Failed")\0a\0a        /\\ IF SortSeq(<<>>, >) = <<>>\0a             THEN Print("Test 12 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 14 Failed")\0a\0a        /\\ IF SortSeq(<<1>>, >) = <<1>>\0a             THEN Print("Test 13 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 15 Failed")\0a\0a\0aConstraint == TRUE\0a=========================================\0a']]]
      ['suite/test45' 'test45' %accept ~[['test45' '------------------------------ MODULE test45 -----------------------------\0a(* Test of recursive function definitions. *)\0a\0aEXTENDS Naturals, TLC\0a\0aVARIABLES x\0a\0aInit == x = 2\0a\0aNext == UNCHANGED x\0a\0af[i \\in 0..5] == [j \\in 0..5 |-> \0a                    IF j = 0 \0a                      THEN [k \\in 0..i |-> \0a                              IF k = 0 THEN i\0a                                       ELSE f[i][1] + 1]\0a                      ELSE IF i = 0\0a                             THEN j\0a                             ELSE f[i-1][j] + 1 ]\0a\0ag[i \\in 0..5] == [j \\in 0..i |-> \0a                   IF j = 0 \0a                     THEN IF i = 0 THEN 0\0a                                   ELSE g[i-1][i-1]\0a                     ELSE g[i][j-1]+x]\0a\0a\0ah[i \\in 0..3, j \\in 0..3] == [k \\in 0..3 |->\0a                               IF k = 0\0a                                 THEN IF j = 0 \0a                                        THEN IF i = 0 THEN 0\0a                                                      ELSE h[i-1,j][k] + 1\0a                                        ELSE h[i,j-1][k]+1\0a                                 ELSE h[i,j][k-1] + 1]\0a\0a(* g[0][0] = 0  \0a   g[0][j] = j * x\0a   g[i][j] = j * x + g[i-1][i-1] \0a           = (j + i-1) * x + g[i-2][i-2]\0a           = (j + i + i-1) * x  + g[i-3][i-2] \0a           = ... *)\0a\0aInv == /\\ IF  f[4][3] = 7\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed")    \0a\0a       /\\ IF f[4][0][2] = 6\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed")    \0a\0a       /\\ IF DOMAIN g[3] = 0..3\0a            THEN Print("Test 3  OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")\0a\0a       /\\ IF DOMAIN f[5][0] = 0..5\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4 Failed")\0a\0a       /\\ IF g[0][0] = 0\0a            THEN Print("Test 5 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 5 Failed")\0a\0a       /\\ IF g[3][3] = 12\0a            THEN Print("Test 6 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 6 Failed")\0a\0a       /\\ IF g[3][1] = 8\0a            THEN Print("Test 7 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 7 Failed")\0a\0a       /\\ IF g[2][0] = 2\0a            THEN Print("Test 8 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 8 Failed")\0a\0a       /\\ IF DOMAIN h[1,2] = 0..3\0a            THEN Print("Test 9 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 9 Failed")\0a\0a       /\\ IF DOMAIN h = (0..3) \\X (0..3)\0a            THEN Print("Test 10 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 10 Failed")\0a\0a       /\\ IF h[2, 3] = [i \\in 0..3 |-> i+5]\0a            THEN Print("Test 11 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 11 Failed")\0a\0a       /\\ IF h[1, 2][3] = 6\0a            THEN Print("Test 12 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 12 Failed")\0a\0a\0a=============================================================================\0a']]]
      ['suite/test46' 'test46' %accept ~[['test46' '--------------------- MODULE test46 -----------------------\0a\0a(* This found a bug in Version 1.03 of 18 Oct 1999 *)\0a\0aEXTENDS Naturals, Sequences, FiniteSets, TLC\0aCONSTANT Reg, Adr, Val, Proc\0aVARIABLE reqQ, reqOrder\0a\0aRequest    == [adr : Adr, val : Val, op : {"Rd", "Wr"}]\0aFreeRegVal == [adr : Adr, val : Val, op : {"Free"}]\0a\0areqId == UNION { [proc : {p}, idx : DOMAIN reqQ[p]] : p \\in Proc }\0a\0aoi \\prec oj == <<oi, oj>> \\in reqOrder\0a\0aTypeInvariant == \0a  /\\ reqQ \\in [Proc -> Seq(Request \\cup [reg : Reg])]\0a  /\\ reqOrder \\in SUBSET (reqId \\X reqId)\0a\0aInit == /\\ reqQ = [p \\in Proc |-> << >>]\0a        /\\ reqOrder = {}\0a\0aGoodReqOrder ==\0a  /\\ \\A oi, oj, ok \\in reqId : (oi \\prec oj) /\\ (oj \\prec ok) => (oi \\prec ok)\0a  /\\ \\A oi \\in reqId : ~(oi \\prec oi)\0a  /\\ \\A oi, oj \\in reqId : \0a        (oi.proc = oj.proc) /\\ (oi.idx < oj.idx) => (oi \\prec oj)\0a\0a-----------------------------------------------------------------------------\0aUpdateReqOrder == \0a  /\\ reqOrder\' \\in SUBSET(reqId\' \\X reqId\')\0a  /\\ reqOrder \\subseteq reqOrder\'\0a  /\\ GoodReqOrder\'\0a\0aIssueRequest(proc, req, reg) ==\0a  (*************************************************************************)\0a  (* The action by which processor proc issues request req in register     *)\0a  (* reg.                                                                  *)\0a  (*************************************************************************)\0a  /\\ reqQ\' = [reqQ EXCEPT ![proc] = Append(@, [reg |-> reg])]\0a  /\\ UpdateReqOrder\0a\0a\0aNext == \\E proc \\in Proc, reg \\in Reg :\0a           \\E req \\in Request : IssueRequest(proc, req, reg)\0a\0a\0aConstraint == \\A p \\in Proc : Len(reqQ[p]) < 2\0a=============================================================================\0a']]]
      ['suite/test47' 'test47' %accept ~[['test47' '------- MODULE test47 -----\0a\0a\\* Checks EXTENDing of both Naturals and Integers\0a\0aEXTENDS test47a , Integers \0a\0aInit == x = -1\0a\0aNext == x\'= IF x = -3 THEN x ELSE x - 1\0a\0aInv == TRUE\0a==========================\0a'] ['test47a' '------------- MODULE test47a  --------------\0a\0aEXTENDS Naturals, TLC\0a\0a\0aVARIABLE x\0a=============================================\0a']]]
      ['suite/test47a' 'test47a' %accept ~[['test47a' '------------- MODULE test47a  --------------\0a\0aEXTENDS Naturals, TLC\0a\0a\0aVARIABLE x\0a=============================================\0a']]]
      ['suite/test48' 'test48' %accept ~[['test48' '--------------- MODULE test48 -------------\0a\0a(* test definability of all user-definable infix, prefix, and postfix  \0a   operators *)\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0a\0az - y == z\0az + y == z\0az * y == z\0az / y == z\0az ^ y == z\0az < y == z\0az > y == z\0az .. y == z\0az ... y == z\0az | y == z\0az || y == z\0az & y == z\0az && y == z\0az $ y == z\0az $$ y == z\0az ?? y == z\0az %% y == z\0az ## y == z\0az ++ y == z\0az -- y == z\0az ** y == z\0az // y == z\0az ^^ y == z\0a\\* z @@ y == z  \\* THIS IS DEFINED IN THE TLC MODULE\0az !! y == z\0az |- y == z\0az |= y == z\0az -| y == z\0az =| y == z\0az <: y == z  \0a\\* z :> y == z  \\* THIS IS DEFINED IN THE TLC MODULE\0az := y == z\0az ::= y == z\0az \\uplus y == z\0az \\sqcap y == z\0az \\sqcup y == z\0az \\div y == z\0az \\wr y == z\0az \\star y == z\0az \\bigcirc y == z\0az \\bullet y == z\0az \\prec y == z\0az \\succ y == z\0az \\preceq y == z\0az \\succeq y == z\0az \\sim y == z\0az \\simeq y == z\0az \\ll y == z\0az \\gg y == z\0az \\asymp y == z\0az \\subset y == z\0az \\supset y == z\0az \\supseteq y == z\0az \\approx y == z  \0az \\cong y == z\0az \\sqsubset y == z\0az \\sqsupset y == z\0az \\sqsubseteq y == z\0az \\sqsupseteq y == z\0az \\doteq y == z\0az \\propto y == z\0a\0az ^+ == z\0az ^* == z\0az ^# == z\0a-. z == z\0a\0a\0aInit == \0a /\\ x = 0\0a\0aNext ==\0a/\\ x = 0\0a/\\ \0a   \\/ x\' = x - 1   \0a   \\/ x\' = x + 1\0a   \\/ x\' = x * 1\0a   \\/ x\' = x / 1\0a   \\/ x\' = x ^ 1\0a   \\/ x\' = (x < 1)  \0a   \\/ x\' = (x > 1)  \0a   \\/ x\' = x .. 1\0a   \\/ x\' = x ... 1\0a   \\/ x\' = x | 1\0a   \\/ x\' = x || 1\0a   \\/ x\' = x & 1\0a   \\/ x\' = x && 1\0a   \\/ x\' = x $ 1\0a   \\/ x\' = x $$ 1\0a   \\/ x\' = x ?? 1\0a   \\/ x\' = x %% 1\0a   \\/ x\' = x ## 1\0a   \\/ x\' = x ++ 1\0a   \\/ x\' = x -- 1\0a   \\/ x\' = x ** 1\0a   \\/ x\' = x // 1\0a   \\/ x\' = x ^^ 1\0a   \\/ x\' = x !! 1\0a   \\/ x\' = (x |- 1)\0a   \\/ x\' = (x |= 1)\0a   \\/ x\' = (x -| 1)\0a   \\/ x\' = (x =| 1)\0a   \\/ x\' = (x <: 1)\0a   \\/ x\' = (x := 1)\0a   \\/ x\' = (x ::= 1)\0a   \\/ x\' = (x \\uplus 1)\0a   \\/ x\' = (x \\sqcap 1)\0a   \\/ x\' = (x \\sqcup 1)\0a   \\/ x\' = x \\div 1\0a   \\/ x\' = x \\wr 1\0a   \\/ x\' = x \\star 1\0a   \\/ x\' = x \\bigcirc 1\0a   \\/ x\' = x \\bullet 1\0a   \\/ x\' = (x \\prec 1 )\0a   \\/ x\' = (x \\succ 1)\0a   \\/ x\' = (x \\preceq 1)\0a   \\/ x\' = (x \\succeq 1)\0a   \\/ x\' = (x \\sim 1)\0a   \\/ x\' = (x \\simeq 1)\0a   \\/ x\' = (x \\ll 1)\0a   \\/ x\' = (x \\gg 1)\0a   \\/ x\' = (x \\asymp 1)\0a   \\/ x\' = (x \\subset 1)\0a   \\/ x\' = (x \\supset 1)\0a   \\/ x\' = (x \\supseteq 1)\0a   \\/ x\' = (x \\approx 1)\0a   \\/ x\' = (x \\cong 1)\0a   \\/ x\' = (x \\sqsubset 1)\0a   \\/ x\' = (x \\sqsupset 1)\0a   \\/ x\' = (x \\sqsubseteq 1)\0a   \\/ x\' = (x \\sqsupseteq 1)\0a   \\/ x\' = (x \\doteq 1)\0a   \\/ x\' = (x \\propto 1)\0a   \\/ x\' = x ^+ \0a   \\/ x\' = x ^* \0a   \\/ x\' = x ^# \0a   \\/ x\' = -x  \0a=============================================================================\0a']]]
      ['suite/test49' 'test49' %accept ~[['test49' '--------------- MODULE test49 -------------\0a\0a(* test definability of operators with aliases *)\0a\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0au (+) v == u\0au (-) v == u\0au (.) v == u\0au (/) v == u\0au (\\X) v == u \0au \\o v == u\0au % v == u\0au \\leq  v == u\0au \\geq v == u\0a\0a\0aInit == \0a /\\ x = 0\0a\0aNext ==\0a   /\\ x = 0\0a   /\\ \0a      \\/ x\' = x (+) 1    \0a      \\/ x\' = x (-) 1    \0a      \\/ x\' = x (.) 1    \0a      \\/ x\' = x (/) 1    \0a      \\/ x\' = x (\\X) 1   \0a      \\/ x\' = x \\o 1 \0a      \\/ x\' = x % 1 \0a      \\/ x\' = (x \\leq  1) \0a      \\/ x\' = (x \\geq 1 ) \0a=======================================\0a']]]
      ['suite/test49a' 'test49a' %accept ~[['test49a' '--------------- MODULE test49a -------------\0a\0a(* test definability of operators with aliases *)\0a\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0au (+) v == u\0au (-) v == u\0au (.) v == u\0au (/) v == u\0au (\\X) v == u \\* parser can\'t cope with this\0au \\o v == u\0au % v == u\0au \\leq  v == u\0au \\geq v == u\0a\0a\0aInit == \0a /\\ x = 0\0a /\\ Print("******************************************************", TRUE)\0a /\\ Print("Several tests have been commented out because of bugs.", TRUE)\0a /\\ Print("******************************************************", TRUE)\0a\0aNext ==\0a   /\\ x = 0\0a   /\\ \0a      \\/ x\' = x (+) 1    \\* caused TLC bug\0a      \\/ x\' = x (-) 1    \\* caused TLC bug\0a      \\/ x\' = x (.) 1    \\* caused TLC bug\0a      \\/ x\' = x (/) 1    \\* caused TLC bug\0a      \\/ x\' = x (\\X) 1   \\* parser can\'t cope with this.\0a      \\/ x\' = x \\o 1 \0a      \\/ x\' = x % 1 \0a      \\/ x\' = (x \\leq  1) \0a      \\/ x\' = (x \\geq 1 ) \0a=======================================\0a']]]
      ['suite/test49b' 'test49b' %reject ~[['test49b' '--------------- MODULE test49b -------------\0a\0a(* test definability of operators with aliases *)\0a\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0au \\oplus v == u\0au \\ominus v == u\0au \\odot v == u\0au \\oslash v == u\0au \\otimes v == u \0au \\circ v == u\0au \\mod v == u\0au =<  v == u\0au >= v == u\0a\0a\0aInit == \0a /\\ x = 0\0a /\\ Print("******************************************************", TRUE)\0a /\\ Print("Several tests have been commented out because of bugs.", TRUE)\0a /\\ Print("******************************************************", TRUE)\0a\0aNext ==\0a   /\\ x = 0\0a   /\\ \0a      \\/ x\' = x \\oplus 1  \0a      \\/ x\' = x \\ominus 1  \0a      \\/ x\' = x \\odot 1  \0a      \\/ x\' = x \\oslash 1  \0a      \\/ x\' = x \\otimes 1 \0a\\*      \\/ x\' = x \\circ 1 \0a\\*      \\/ x\' = x \\mod 1   \\* causes TLC bug\0a\\*      \\/ x\' = (x =<  1)  \\* causes TLC bug \0a\\*      \\/ x\' = (x >= 1 )  \\* causes TLC bug \0a=======================================\0a']]]
      ['suite/test49c' 'test49c' %reject ~[['test49c' '--------------- MODULE test49c -------------\0a\0a(* test definability of operators with aliases *)\0a\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0au \\oplus v == u\0au \\ominus v == u\0au \\odot v == u\0au \\oslash v == u\0au \\otimes v == u \0au \\o v == u\0au \\mod v == u\0au =<  v == u\0au >= v == u\0a\0a\0aInit == \0a /\\ x = 0\0a /\\ Print("*************************************************************", TRUE)\0a /\\ Print("Almost all the tests have been commented out because of bugs.", TRUE)\0a /\\ Print("*************************************************************", TRUE)\0a\0aNext ==\0a   /\\ x = 0\0a   /\\ \0a\\*      \\/ x\' = x (+) 1     \\* causes TLC bug\0a\\*      \\/ x\' = x (-) 1     \\* causes TLC bug\0a\\*      \\/ x\' = x (.) 1     \\* causes TLC bug\0a\\*      \\/ x\' = x (/) 1     \\* causes TLC bug\0a\\*      \\/ x\' = x (\\X) 1  \\* parser can\'t handle this\0a\\*      \\/ x\' = x \\circ 1   \\* causes TLC bug\0a      \\/ x\' = x % 1   \0a\\*      \\/ x\' = (x =<  1)  \\* TLC bug : sets x\' to TRUE\0a\\*      \\/ x\' = (x >= 1 )    \\* TLC bug : sets x\' to FALSE\0a=======================================\0a']]]
      ['suite/test5' 'test5' %accept ~[['test5' '--------------- MODULE test5 -------------\0a\0a(* test of Cartesian Product. *)\0a\0aEXTENDS Integers, TLC\0a\0aVARIABLE x\0aType == x \\in {1}\0aInit == x = 1\0aNext == UNCHANGED x\0a\0aInv  == \0a  /\\ IF {1, 2} \\X {"a", "b"} # {<<1, "a">>, <<2, "a">>, <<2, "b">>, <<1, "b">>}\0a      THEN Assert(FALSE, "Test 1 failed")\0a      ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF [p \\in Nat \\X Int |-> p[1] - 2*p[2]][2, -3] # 8\0a      THEN Assert(FALSE, "Test 2 failed")\0a      ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF [p \\in Int \\X Int |-> p[1] - 2*p[2]][2, -3] # 8\0a      THEN Assert(FALSE, "Test 3 failed")\0a      ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF <<1, 3>> \\notin Nat \\X Nat\0a      THEN Assert(FALSE, "Test 4 failed")\0a      ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF <<1, 3>> \\notin (Int \\X Int)\0a      THEN Assert(FALSE, "Test 5 failed")\0a      ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF [1..2 -> {1, 2, 3}] \\cap ({1} \\X {2}) # {<<1,2>>}\0a      THEN Assert(FALSE, "Test 6 failed")\0a      ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF {<<1, 4>>, <<2,3>>} \\notin SUBSET ({1,2} \\X {3,4})\0a      THEN Assert(FALSE, "Test 7 failed")\0a      ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF <<1,3>> \\notin {1,2,3} \\X {2,3,4}\0a      THEN Assert(FALSE, "Test 8 failed")\0a      ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF {1, 2} \\X {"a", "b"} \\X {"c"} # \0a           {<<1, "a", "c">>, <<2, "a", "c">>, <<2, "b", "c">>, <<1, "b", "c">>}\0a      THEN Assert(FALSE, "Test 9 failed")\0a      ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF [p \\in Nat \\X Int \\X Nat |-> p[1] - 2*p[2] + p[3]][2, -3, 4] # 12\0a      THEN Assert(FALSE, "Test 10 failed")\0a      ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF [p \\in Int \\X Int \\X Int |-> p[1] - 2*p[2] - p[3]][2, -3, -4] # 12\0a      THEN Assert(FALSE, "Test 11 failed")\0a      ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF <<1, 2, 3, 4>> \\notin Nat \\X Nat \\X Nat \\X Nat\0a      THEN Assert(FALSE, "Test 12 failed")\0a      ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF <<1, 2, 3, 4>> \\notin (Int \\X Int \\X Int \\X Int)\0a      THEN Assert(FALSE, "Test 13 failed")\0a      ELSE Print("Test 13 OK", TRUE)\0a\0a  /\\ IF [1..2 -> {1, 2, 3}] \\cap ({1} \\X {2}) # {<<1,2>>}\0a      THEN Assert(FALSE, "Test 14 failed")\0a      ELSE Print("Test 14 OK", TRUE)\0a\0a  /\\ IF {<<1, 4, 2>>, <<2,3,3>>} \\notin SUBSET ({1,2} \\X {3,4} \\X {2, 3})\0a      THEN Assert(FALSE, "Test 15 failed")\0a      ELSE Print("Test 15 OK", TRUE)\0a\0a  /\\ IF <<1,3, 5>> \\notin {1,2,3} \\X {2,3,4} \\X {5,6}\0a      THEN Assert(FALSE, "Test 16 failed")\0a      ELSE Print("Test 16 OK", TRUE)\0a  /\\ \\* Test 17 added 4 June 2014\0a     IF \\/ {} \\X {1,2} # {2,3,4} \\X {}\0a        \\/ {1, 2} \\X {} \\X {3,4} # {2} \\X {4,4} \\X {}\0a        \\/ {1} \\X {2} \\X {} # {} \\X {3,3}\0a      THEN Assert(FALSE, "Test 17 failed")\0a      ELSE Print("Test 17 OK", TRUE)\0a  /\\ \\* Test 18 added 12 Jun 2014\0a     IF \\/ [a: {12}, b : {}] # [c: {22}, d: {xyz \\in {1,2,3} : xyz < 0}]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: 2..1]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: {1,2,3} \\cap 4..6]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: {} \\cup {xz \\in {1,2,3} : xz < 0}]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: {2,3,4} \\X {}]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: [a: {}, b : {1}]]\0a        \\/ [a: {12}, b : {}] = [c: {22}, d: SUBSET {}]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: UNION {}]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: {2,3,4} \\ 1..5]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: [{1,2,3} -> {}]]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: {}]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: {xyz+1 : xyz \\in 2..1}]\0a      THEN Assert(FALSE, "Test 18 failed")\0a      ELSE Print("Test 18 OK", TRUE)\0a  /\\ \\* Test 19 added 12 Jun 2014\0a     IF \\/ {1} \\X {2} \\X {} # {22} \\X  {xyz \\in {1,2,3} : xyz < 0}\0a        \\/ {1} \\X {2} \\X {} # {22} \\X  (2..1)\0a        \\/ {1} \\X {2} \\X {} # {22} \\X  ({1,2,3} \\cap (4..6))\0a        \\/ {1} \\X {2} \\X {} # {22} \\X ({} \\cup {xz \\in {1,2,3} : xz < 0})\0a        \\/ {1} \\X {2} \\X {} # {22} \\X ({2,3,4} \\X {})\0a        \\/ {1} \\X {2} \\X {} # {22} \\X ([a: {}, b : {1}])\0a        \\/ {1} \\X {2} \\X {} = {22} \\X (SUBSET {})\0a        \\/ {1} \\X {2} \\X {} # {22} \\X (UNION {})\0a        \\/ {1} \\X {2} \\X {} # {22} \\X ({2,3,4} \\ (1..5))\0a        \\/ {1} \\X {2} \\X {} # {22} \\X ([{1,2,3} -> {}])\0a        \\/ {1} \\X {2} \\X {} # {22} \\X ({})\0a        \\/ {1} \\X {2} \\X {} # {22} \\X ({xyz+1 : xyz \\in 2..1})\0a      THEN Assert(FALSE, "Test 19 failed")\0a      ELSE Print("Test 19 OK", TRUE)\0a=========================================\0a']]]
      ['suite/test50' 'test50' %accept ~[['test50' '--------------- MODULE test50 -------------\0a\0a(* test usability of the following aliases with the standard modules:\0a   <=  and >=  of Naturals\0a   \\circ of Sequences\0a   (+) and (-) of Bags \0a\0a*)\0a\0a\0aEXTENDS Naturals, Sequences, Bags, TLC\0a\0aBag1 == SetToBag({"a", "b"})\0aBag2 == Bag1 \\oplus  SetToBag({"a"}) \\* causes TLC bug\0aBag3 == Bag2 \\ominus Bag1\0aBag2a == Bag1 (+) SetToBag({"a"})\0aBag3a == Bag2 (-) Bag1\0a\0a\0aVARIABLES x\0aInit == x = 0\0aNext == x\'=x\0a\0aInv == \0a       /\\ IF Bag2 = Bag2a\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed") \0a\0a       /\\ IF Bag3 = Bag3a\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed") \0a\0a       /\\ IF <<"a">> \\o <<"b">> = <<"a">> \\circ <<"b">>\0a            THEN Print("Test 3 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")  \0a    \0a       /\\ IF 1 \\leq 2\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4  Failed") \0a\0a       /\\ IF 1 <= 2\0a            THEN Print("Test 5 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 5  Failed") \0a    \0a       /\\ IF 2 \\geq 1 \0a            THEN Print("Test 6 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 6  Failed") \0a\0a       /\\ IF 2 >= 1 \0a            THEN Print("Test 7 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 7  Failed") \0a\0a=======================================\0a']]]
      ['suite/test51a' 'test51a' %accept ~[['test51a' '------------------- MODULE test51a -------------------------\0a\0a\\* Test definability of some aliases\0a\0aa =< b == {a, b}\0aa >=b == {a, b}\0aa \\circ b == {a, b}\0aa \\oplus b == {a, b}\0aa \\ominus b == {a, b}\0aa \\otimes b == {a, b}\0aa \\oslash b == {a, b}\0aa \\odot b == {a, b}\0a=============================================================================\0a']]]
      ['suite/test51b' 'test51b' %accept ~[['test51b' '---------------- MODULE test51b -----------------\0aa <= b == {a, b}\0a\0a==================================================================\0a']]]
      ['suite/test52' 'test52' %accept ~[['test52' '----------------------   MODULE test52 -----------------------\0a\0a\\* Test of prefix and postfix operators as arguments\0a\0aEXTENDS TLC\0a\0aVARIABLES x, y\0a\0aBoxTest(-._) == -(x=0)\0aFoo1 == BoxTest([])\0aFoo2 == BoxTest(<>)\0a\0a-. a == {{"a"}, {"b"}} \\ a\0aa ^+  == {{"a"}, {"b"}} \\ a\0aa ^*  == {{"a"}, {"b"}} \\ a\0aa ^#  == {{"a"}, {"b"}} \\ a\0a\0aSetOpTest(Foo(_)) == Foo({{"b"}, {"c"}})\0aDomainTest(Foo(_)) == Foo([i\\in {"a", "b"} |-> i])\0a\0aASSUME\0a  /\\ Print("Test1 Begun", TRUE)\0a  /\\ SetOpTest(-.) =  - {{"b"}, {"c"}}\0a  /\\ SetOpTest(^+) =   {{"b"}, {"c"}} ^+\0a  /\\ SetOpTest(^*) =   {{"b"}, {"c"}} ^*\0a  /\\ SetOpTest(^#) =   {{"b"}, {"c"}} ^#\0a  /\\ SetOpTest(SUBSET) = SUBSET {{"b"}, {"c"}}\0a  /\\ SetOpTest(UNION) = UNION {{"b"}, {"c"}}\0a  /\\ DomainTest(DOMAIN) = DOMAIN [i\\in {"a", "b"} |-> i]\0a  /\\ Print("Test1 Finished", TRUE)\0a\0a\0aInit == /\\ x = {"a"}\0a        /\\ y = {"a"}\0aNext == /\\ x\'= x \\cup {"a"}\0a        /\\ y\'= y \\cup {"b"}\0aSpec == Init /\\ [][Next]_<<x, y>>\0a\0aEnabledTest(Foo(_)) == Foo(x\'=x)\0aUnchangedTest(Foo(_)) == Foo(x)\0aPrimeTest(Foo(_)) == Foo(x) = x\0a\0aInvariant ==\0a /\\ EnabledTest(ENABLED)\0a\0aImpliedAction ==\0a /\\ UnchangedTest(UNCHANGED)\0a /\\ PrimeTest(\')\0a\0aProperty == [][ImpliedAction]_<<x, y>>\0a\0a==================================================================\0a\\* Prefix Operators\0a~\0aENABLED\0aUNCHANGED\0a[]\0a<>\0aSUBSET\0aUNION\0aDOMAIN\0a-\0a\0a\\* Postfix Operators\0a\\* Predefined\0a\'\0a\0a\\* Undefined\0a^+\0a^*\0a^#\0a']]]
      ['suite/test53' 'test53' %accept ~[['test53' '--------------- MODULE test53 -------------\0a\0a(* test definability of operators with aliases *)\0a\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0au \\oplus v == u\0au \\ominus v == u\0au \\odot v == u\0au \\oslash v == u\0au \\otimes v == u \0au \\circ v == u\0au % v == u\0au =<  v == u\0au >= v == u\0a\0a\0aInit == \0a /\\ x = 0\0a\0aNext ==\0a   /\\ x = 0\0a   /\\ \0a      \\/ x\' = x \\oplus 1  \0a      \\/ x\' = x \\ominus 1  \0a      \\/ x\' = x \\odot 1  \0a      \\/ x\' = x \\oslash 1  \0a      \\/ x\' = x \\otimes 1 \0a      \\/ x\' = x \\circ 1 \0a      \\/ x\' = x % 1   \\* causes TLC bug\0a      \\/ x\' = (x =<  1)  \\* causes TLC bug \0a      \\/ x\' = (x >= 1 )  \\* causes TLC bug \0a=======================================\0a']]]
      ['suite/test54' 'test54' %accept ~[['test54' '--------------- MODULE test54 -------------\0a\0a(* test definability of operators with aliases *)\0a\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0au \\oplus v == u\0au \\ominus v == u\0au \\odot v == u\0au \\oslash v == u\0au \\otimes v == u \0au \\o v == u\0au % v == u\0au =<  v == u\0au >= v == u\0a\0a\0aInit == \0a /\\ x = 0\0a\0aNext ==\0a   /\\ x = 0\0a   /\\ \0a      \\/ x\' = x (+) 1     \\* causes TLC bug\0a      \\/ x\' = x (-) 1     \\* causes TLC bug\0a      \\/ x\' = x (.) 1     \\* causes TLC bug\0a      \\/ x\' = x (/) 1     \\* causes TLC bug\0a      \\/ x\' = x (\\X) 1  \\* parser can\'t handle this\0a      \\/ x\' = x \\circ 1   \\* causes TLC bug\0a      \\/ x\' = x % 1   \0a      \\/ x\' = (x =<  1)  \\* TLC bug : sets x\' to TRUE\0a      \\/ x\' = (x >= 1 )    \\* TLC bug : sets x\' to FALSE\0a=======================================\0a']]]
      ['suite/test55a' 'test55a' %accept ~[['test55a' '------------------------------- MODULE test55a ------------------------------\0aEXTENDS Naturals\0aVARIABLES x, y\0a\0aF == ENABLED (x\'=0 /\\ y\'=1)\0aG == ENABLED ((x # y) /\\ (x\'=0) /\\ (y\'=1))\0a\0aInit == (x = 0) /\\ (y = 0)\0aNext == /\\ x\' = 1 - x\0a        /\\ y\' = y\0a\0aSafeSpec == Init /\\ [][Next]_<<x,y>>\0aLiveSpec == SafeSpec /\\ WF_<<x,y>>(Next)\0a=============================================================================\0a']]]
      ['suite/test58' 'test58' %accept ~[['test58' '------------------- MODULE test58 --------------------\0a\\* Test of binary, octal, and hexadecimal numbers\0a\0aEXTENDS Naturals\0a\0aASSUME\0a  /\\ 63 = \\b111111\0a  /\\ 63 = \\o77\0a  /\\ 63 = \\h3F\0a  /\\ 63 = \\B111111\0a  /\\ 63 = \\O77\0a  /\\ 63 = \\H3f\0a  /\\ 63 = \\H3F\0a  /\\ 63 = \\h3f\0a\0a=======================================================\0a']]]
      ['suite/test6' 'test6' %accept ~[['test6' '--------------- MODULE test6 -------------\0a\0a(* test of Propositional Logic. *)\0a\0aEXTENDS Integers, TLC\0a\0aVARIABLE x, y, z, w\0aType == /\\ x \\in BOOLEAN\0a        /\\ y \\in BOOLEAN\0a        /\\ z \\in BOOLEAN\0a        /\\ w = 0\0aInit == /\\ x = TRUE\0a        /\\ y = TRUE\0a        /\\ z = FALSE\0a        /\\ w = 0\0aNext ==  /\\ \\/ (w = 1) /\\ Assert(FALSE, "This is a bug")\0a            \\/ (w=0)\0a         /\\ (w=0) \\* \\/ Assert(FALSE, "This is a bug, too")\0a                  \\* Commented out because I now don\'t think it\'s a bug.\0a         /\\ UNCHANGED <<w, x, y, z>>\0a\0aInv  ==  \0a\0a  /\\ IF ~(x /\\ y /\\ ~z)\0a      THEN Assert(FALSE, "Test 1 failed")\0a      ELSE Print("Test 1 OK", TRUE)\0a \0a  /\\ IF ~(~z /\\ y)\0a      THEN Assert(FALSE, "Test 2 failed")\0a      ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF ~(x \\/ ~y \\/ z)\0a      THEN Assert(FALSE, "Test 3 failed")\0a      ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF ~(z \\/ ~y \\/ x)\0a      THEN Assert(FALSE, "Test 4 failed")\0a      ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF ~(x /\\ y)\0a      THEN Assert(FALSE, "Test 5 failed")\0a      ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF (x /\\ z)\0a      THEN Assert(FALSE, "Test 6 failed")\0a      ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF (z /\\ x)\0a      THEN Assert(FALSE, "Test 7 failed")\0a      ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF (z /\\ ~x)\0a      THEN Assert(FALSE, "Test 8 failed")\0a      ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF (z /\\ (x=1))\0a      THEN Assert(FALSE, "Test 9 failed")\0a      ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF ~(x \\/ (z=1))\0a      THEN Assert(FALSE, "Test 10 failed")\0a      ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF ~(x => y)\0a      THEN Assert(FALSE, "Test 11 failed")\0a      ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF ~(~x => y)\0a      THEN Assert(FALSE, "Test 12 failed")\0a      ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF ~(~x => z)\0a      THEN Assert(FALSE, "Test 13 failed")\0a      ELSE Print("Test 13 OK", TRUE)\0a\0a  /\\ IF (x => z)\0a      THEN Assert(FALSE, "Test 14 failed")\0a      ELSE Print("Test 14 OK", TRUE)\0a\0a  /\\ IF ~x\0a      THEN Assert(FALSE, "Test 15 failed")\0a      ELSE Print("Test 15 OK", TRUE)\0a\0a  /\\ IF ~~z\0a      THEN Assert(FALSE, "Test 16 failed")\0a      ELSE Print("Test 16 OK", TRUE)\0a\0a  /\\ IF ~(x <=> y)\0a      THEN Assert(FALSE, "Test 17 failed")\0a      ELSE Print("Test 17 OK", TRUE)\0a\0a  /\\ IF ~(~x <=> z)\0a      THEN Assert(FALSE, "Test 18 failed")\0a      ELSE Print("Test 18 OK", TRUE)\0a\0a  /\\ IF (x <=> z)\0a      THEN Assert(FALSE, "Test 19 failed")\0a      ELSE Print("Test 19 OK", TRUE)\0a\0a  /\\ IF (z <=> x)\0a      THEN Assert(FALSE, "Test 20 failed")\0a      ELSE Print("Test 20 OK", TRUE)\0a\0a  /\\ IF ~(x \\equiv y)\0a      THEN Assert(FALSE, "Test 21 failed")\0a      ELSE Print("Test 21 OK", TRUE)\0a\0a  /\\ IF ~(~x \\equiv z)\0a      THEN Assert(FALSE, "Test 22 failed")\0a      ELSE Print("Test 22 OK", TRUE)\0a\0a  /\\ IF (x \\equiv z)\0a      THEN Assert(FALSE, "Test 23 failed")\0a      ELSE Print("Test 23 OK", TRUE)\0a\0a  /\\ IF (z \\equiv x)\0a      THEN Assert(FALSE, "Test 24 failed")\0a      ELSE Print("Test 24 OK", TRUE)\0a\0a  /\\ IF TRUE \\notin BOOLEAN\0a      THEN Assert(FALSE, "Test 25 failed")\0a      ELSE Print("Test 25 OK", TRUE)\0a\0a  /\\ IF FALSE \\notin BOOLEAN\0a      THEN Assert(FALSE, "Test 26 failed")\0a      ELSE Print("Test 26 OK", TRUE)\0a\0a  /\\ IF {TRUE, FALSE} # BOOLEAN\0a      THEN Assert(FALSE, "Test 27 failed")\0a      ELSE Print("Test 27 OK", TRUE)\0a\0a=========================================\0a']]]
      ['suite/test60' 'test60' %accept ~[['test60' '-------------------- MODULE test60 --------------------\0a(***************************************************************************)\0a(* Test of handling strings as sequences.                                  *)\0a(***************************************************************************)\0a\0aEXTENDS Sequences, TLC\0a\0aASSUME "abc" \\o "def" = "abcdef"\0aASSUME Len("abcdef") = 6\0aASSUME "a\\\\b\\"c\\nd" = "a\\\\b\\"" \\o "c\\nd" \0aASSUME Len("a\\\\b\\"c\\nd") = 7\0a\0a========================================\0a\0a']]]
      ['suite/test61' 'test61' %accept ~[['test61' '-------------------- MODULE test61 --------------------\0a(***************************************************************************)\0a(* Test of parametrized INSTANCE                                            *)\0a(***************************************************************************)\0a\\* Because of bug, it Handles JSpec but not ISpec\0a\0aEXTENDS Naturals\0a\0aVARIABLE y\0a\0aIM(x) == INSTANCE test61a\0a\0aISpec == IM(y)!Spec\0a\0aInvariant == y \\in 0..4\0a\0aJM == INSTANCE test61a WITH x <- y\0aJSpec == JM!Spec\0a\0a========================================\0a\0a'] ['test61a' '-------------------- MODULE test61a --------------------\0a(***************************************************************************)\0a(* Test of parametrized INSTANCE                                            *)\0a(***************************************************************************)\0a\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aSpec == (x = 0) /\\ [][x\'=(x+1)%5]_x\0a========================================\0a']]]
      ['suite/test61a' 'test61a' %accept ~[['test61a' '-------------------- MODULE test61a --------------------\0a(***************************************************************************)\0a(* Test of parametrized INSTANCE                                            *)\0a(***************************************************************************)\0a\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aSpec == (x = 0) /\\ [][x\'=(x+1)%5]_x\0a========================================\0a']]]
      ['suite/test62' 'test62' %accept ~[['test62' '----------------------- MODULE test62 --------------------------\0aEXTENDS TLC\0aASSUME Print("Should print this", TRUE)\0aASSUME PrintT("And this")\0a=================================================================\0a']]]
      ['suite/test63' 'test63' %accept ~[['test63' '\\* Test of use of [A]_v within the next-state relation, checking\0a\\* bug fix of 11 Mar 2009\0a------------------------- MODULE test63 --------------------------\0aEXTENDS Naturals, test63a\0aVARIABLE now \0aCONSTANT Rho, MaxReal, SecondsPerHour\0a-----------------------------------------------------------------------------\0a\0aReal == 0 .. MaxReal\0a\0aASSUME (Rho \\in Real) /\\  (Rho > 0) \0a\0a   VARIABLE t  \0a   TNext == t\' = IF HCnxt THEN 0 ELSE t+(now\'-now) \0a   IsTimer == (t = 0)  /\\  [][TNext]_<<t,hr,now>>\0a   MaxTime == [](t \\leq  SecondsPerHour + Rho)  \0a   MinTime == [][HCnxt => t \\geq SecondsPerHour - Rho]_hr\0a   HCTime == IsTimer /\\ MaxTime /\\ MinTime \0a\0a\0aNowNext == /\\ now\' \\in {r \\in Real : r > now} \0a           /\\ UNCHANGED hr  \0a\0aBigNext == /\\ [NowNext]_now\0a           /\\ [HCnxt]_hr\0a           /\\ TNext\0a           /\\ HCnxt => t \\geq SecondsPerHour - Rho\0a           /\\ t\' \\leq  SecondsPerHour + Rho\0a\0aBigNextX == \0a           /\\ NowNext \\/ now\'=now\0a           /\\ HCnxt \\/ hr\'=hr\0a           /\\ TNext\0a           /\\ HCnxt => t \\geq SecondsPerHour - Rho\0a           /\\ t\' \\leq  SecondsPerHour + Rho\0a\0aBigInit == /\\ HCini\0a           /\\ t = 0\0a           /\\ now \\in Real \0a\0aFairness == \\A r \\in Real : WF_now(NowNext /\\ (now\'>r))\0a\0aNonZeno == \\A r \\in Real : <>(now \\geq r)\0a\0a\\* ImpliedTemporal == \\A h \\in 1..12 : []<>(hr = h)\0a\0aSpec == BigInit /\\ [][BigNext]_<<hr, now, t>>\\*  /\\ Fairness\0a\0aTypeOK == /\\ now \\in Nat\0a          /\\ hr \\in 1..12\0a\0aI == INSTANCE test63a\0a\0aProperty == I!HC\0a\0aRT == /\\ now \\in Real \0a      /\\ [][NowNext]_now\0a      /\\ \\A r \\in Real : WF_now(NowNext /\\ (now\'>r))\0a\0aErrorTemporal == []((now # 4) => <>[](now # 4))\0a=============================================================================\0a '] ['test63a' '---------------------- MODULE test63a ----------------------\0aEXTENDS Naturals\0aVARIABLE hr\0aHCini  ==  hr \\in (1 .. 12)\0aHCnxt  ==  hr\' = IF hr # 12 THEN hr + 1 ELSE 1\0aHC  ==  HCini /\\ [][HCnxt]_hr\0a--------------------------------------------------------------\0aTHEOREM  HC => []HCini\0a==============================================================\0a']]]
      ['suite/test63a' 'test63a' %accept ~[['test63a' '---------------------- MODULE test63a ----------------------\0aEXTENDS Naturals\0aVARIABLE hr\0aHCini  ==  hr \\in (1 .. 12)\0aHCnxt  ==  hr\' = IF hr # 12 THEN hr + 1 ELSE 1\0aHC  ==  HCini /\\ [][HCnxt]_hr\0a--------------------------------------------------------------\0aTHEOREM  HC => []HCini\0a==============================================================\0a']]]
      ['suite/test64' 'test64' %accept ~[['test64' '-------------------------------- MODULE test64 --------------------------------\0aVARIABLE y   \0a \0aI == INSTANCE test64a WITH x <- y  \0a  \\* Changed from Test64a on 12 June 2014 because that\'s now illegal\0a\0aSpec == I!Spec\0a=======================================================================\0a'] ['test64a' '----------------------- MODULE test64a -----------------------\0aVARIABLE x\0a\0aASet == {r \\in  [{0} -> {0}]  : x}\0a\0aSpec == x = TRUE /\\ [][x\' = (ASet = {})]_x\0a=============================================================\0a ']]]
      ['suite/test64a' 'test64a' %accept ~[['test64a' '----------------------- MODULE test64a -----------------------\0aVARIABLE x\0a\0aASet == {r \\in  [{0} -> {0}]  : x}\0a\0aSpec == x = TRUE /\\ [][x\' = (ASet = {})]_x\0a=============================================================\0a ']]]
  ==
::
++  test-sany-sub-5
  %+  expect-eq
    !>  ^-  (list @t)
    :~  'suite/test7 -> hoon=reject'  'suite/test9 -> hoon=reject'  'suite/test999 -> hoon=reject'
    ==
  !>
  %-  sub-batch-run
  ^-  (list [@t @t ?(%accept %reject) (list [@t @t])])
  :~
      ['suite/test65' 'test65' %accept ~[['test65' '-------------------------------- MODULE test65 --------------------------------\0aEXTENDS test65a\0a \0aI == INSTANCE test65a WITH c <- 42\0aJ == INSTANCE test65a WITH c <- 44\0aASSUME /\\ <<I!foo, J!foo>>  = <<42, 44>>\0a       /\\ foo = c\0a=======================================================================\0a'] ['test65a' '----------------------- MODULE test65a -----------------------\0aCONSTANT c\0a\0abar == c\0afoo == bar\0a=============================================================\0a ']]]
      ['suite/test65a' 'test65a' %accept ~[['test65a' '----------------------- MODULE test65a -----------------------\0aCONSTANT c\0a\0abar == c\0afoo == bar\0a=============================================================\0a ']]]
      ['suite/test7' 'test7' %accept ~[['test7' '--------------- MODULE test7 -------------\0a\0a(* test of Predicate Logic and CHOOSE *)\0a\0aEXTENDS Integers, TLC\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0aInv  ==  \0a\0a  /\\ IF ~ \\E i \\in {1,2,3} : i=2\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF ~ \\exists i \\in {1,2,3} : i=2\0a       THEN Assert(FALSE, "Test 1a Failed")\0a       ELSE Print("Test 1a OK", TRUE)\0a\0a  /\\ IF \\A i \\in {3,3,3,3,2,1} : i=3\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF \\forall i \\in {3,3,3,3,2,1} : i=3\0a       THEN Assert(FALSE, "Test 2a Failed")\0a       ELSE Print("Test 2a OK", TRUE)\0a\0a  /\\ IF \\E i \\in {1,2,3} : FALSE\0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF ~\\A i \\in {1,2,3} : TRUE\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF \\E i \\in {} : TRUE\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF \\exists i \\in {} : TRUE\0a       THEN Assert(FALSE, "Test 5a Failed")\0a       ELSE Print("Test 5a OK", TRUE)\0a\0a  /\\ IF ~\\A i \\in {} : FALSE\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF ~\\forall i \\in {} : FALSE\0a       THEN Assert(FALSE, "Test 6a Failed")\0a       ELSE Print("Test 6a OK", TRUE)\0a\0a  /\\ IF ~\\E <<i, j>> \\in {1,2} \\X {3,4}, \0a             k, l \\in {4, 5}, m \\in {6,7} : i + j + k + l + m = 23\0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF ~\\A <<i, j>> \\in {1,2} \\X {3,4}, \0a        k, l \\in {4, 5}, m \\in {6,7} : i + j + k + l + m > 17\0a       THEN Assert(FALSE, "Test 8 Failed")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF (CHOOSE i \\in {1,2,3} : i > 2) # 3\0a       THEN Assert(FALSE, "Test 9 Failed")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF (CHOOSE i \\in {1,2,3, 4} : i > 2) \\leq 2\0a       THEN Assert(FALSE, "Test 10 Failed")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF <<1, 3>> # CHOOSE <<i, j>> \\in {1,2} \\X {3,4} : (i < 2) /\\ (j = i+2)\0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF ~(\\A i \\in {1,2}, <<j, k>> \\in {3,4} \\X {5, 6}, m, n \\in {7,8} :\0a            i+j+k+m+n \\geq 23)\0a       THEN Assert(FALSE, "Test 12 Failed")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF \\E i \\in {1,2}, <<j, k>> \\in {3,4} \\X {5, 6}, m, n \\in {7,8} :\0a            i+j+k+m+n < 23\0a       THEN Assert(FALSE, "Test 13 Failed")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0a\0a  /\\ IF \\A i \\in CHOOSE j \\in {{Nat}, {Int}} : \\E k \\in j : -1 \\in k :\0a           -4 \\in i\0a       THEN Print("Test 14 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 14 Failed")\0a=========================================\0a\0aThe following test is not expected to work because\0aTLC does not preserve the semantics of CHOOSE\0a\0a  /\\ IF (CHOOSE i \\in {1,2,3, 4} : i > 2) \0a           # (CHOOSE i \\in {4, 1, 3 , 2} : i > 2) \0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a']]]
      ['suite/test8' 'test8' %accept ~[['test8' '--------------- MODULE test8 -------------\0a\0a(* Test of set operators \\cup, \\cap, \\subseteq, \\ *)\0a\0aEXTENDS Integers, TLC, Sequences\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0aInv  ==  \0a\0a  /\\ IF {1, 2, 3} \\cup {3, 4, 5} # 1..5\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF {1, 2, 3} \\cap {3, 4, 5} # {3}\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF -5 \\notin Int \\cup Nat \0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF -5 \\notin Nat \\cup Int\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF {1, 2, 3, 4} \\cap {i \\in Int : i > 2} # {3, 4}\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF {1, 2, 3} \\cap {} # {}\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF {} \\cap {1, 2, 3} # {}\0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF {1, 2, 3, 4} \\ {i \\in Int : i > 2} # {2, 1}\0a       THEN Assert(FALSE, "Test 8 Failed")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF {1, 2, 3} \\ {} # {3,1,2}\0a       THEN Assert(FALSE, "Test 9 Failed")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF {} \\ {1, 2, 3} # {}\0a       THEN Assert(FALSE, "Test 10 Failed")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF -5 \\in {-5} \\ Int\0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF <<1, 2>> \\in Seq({1,2,3}) \\ Seq({1,2})\0a       THEN Assert(FALSE, "Test 12 Failed")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF <<1, 2>> \\notin Seq({1,2,3}) \0a       THEN Assert(FALSE, "Test 12a Failed")\0a       ELSE Print("Test 12a OK", TRUE)\0a\0a  /\\ IF <<1, 2>> \\notin Seq({1,2,3}) \\cap  Seq({0,1,2})\0a       THEN Assert(FALSE, "Test 13 Failed")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0a  /\\ IF <<1, 2>> \\notin Seq({0,1}) \\cup  Seq({1,2,3}) \0a       THEN Assert(FALSE, "Test 14 Failed")\0a       ELSE Print("Test 14 OK", TRUE)\0a\0a  /\\ IF <<1, 2>> \\in [1..2 ->{1,2,3}] \\ [1..2 ->{1,2}]\0a       THEN Assert(FALSE, "Test 16 Failed")\0a       ELSE Print("Test 16 OK", TRUE)\0a\0a  /\\ IF <<1, 2>> \\notin [1..2 ->{1,2,3}] \0a       THEN Assert(FALSE, "Test 17 Failed")\0a       ELSE Print("Test 17 OK", TRUE)\0a\0a  /\\ IF <<1, 2>> \\notin [1..2 ->{1,2,3}] \\cap  [1..2 ->{0,1,2}]\0a       THEN Assert(FALSE, "Test 18 Failed")\0a       ELSE Print("Test 18 OK", TRUE)\0a\0a  /\\ IF <<1, 2>> \\notin [1..2 ->{0,1}] \\cup [1..2 ->{1,2,3}] \0a       THEN Assert(FALSE, "Test 19 Failed")\0a       ELSE Print("Test 19 OK", TRUE)\0a\0a  /\\ IF ~({1,2,3} \\subseteq Int)\0a       THEN Assert(FALSE, "Test 20 Failed")\0a       ELSE Print("Test 20 OK", TRUE)\0a\0a  /\\ IF {1,2,3} \\subseteq {i \\in Int : i < 3}\0a       THEN Assert(FALSE, "Test 21 Failed")\0a       ELSE Print("Test 21 OK", TRUE)\0a\0a  /\\ IF <<1,2>> \\in ({1,2} \\X Nat) \\cup {<<3,4>>, <<5,6>>}\0a       THEN Print("Test 22 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 22 Failed")\0a\0a=========================================\0a']]]
      ['suite/test9' 'test9' %accept ~[['test9' '--------------- MODULE test9 -------------\0a\0a(* Test of set constructors {x \\in S : P(x)} and {e(x) : x \\in S} *)\0a\0aEXTENDS Integers, TLC, FiniteSets\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0aInv  ==  \0a\0a  /\\ IF {i \\in {1,3,3,3,4} : i > 1} # {4,3}\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF {<<i, j>> \\in {1,2} \\X {2,3} : j > i} # {<<1,2>>, <<1,3>>, <<2,3>>}\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF 2 \\notin {i \\in Int : i > 1}\0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF <<3,4>> \\notin {<<i,j>> \\in Int \\X Int : j > i}\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF {i+j+k+l+m  : i, j \\in {1, 2, 3}, \0a                      <<k, l>> \\in {4,5} \\X {6,7}, m \\in {8}} # 20..26\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF 24 \\notin {i+j+k+l+m  : i, j \\in {1, 2, 3}, \0a                                <<k, l>> \\in {4,5} \\X {6,7}, m \\in {8}} \0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF {i+j : i \\in {1,2,3}, j \\in {}} # {}\0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF {i \\in {} : i > 2} # {}\0a       THEN Assert(FALSE, "Test 8 Failed")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF {<<i, j>>  \\in {1,3} \\X {} : i > 2} # {}\0a       THEN Assert(FALSE, "Test 9 Failed")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF <<1,2>> \\notin {f \\in UNION {[S -> {1,2,3}] : \0a                          S \\in SUBSET {1,2,3}} : f[2] = 2}\0a       THEN Assert(FALSE, "Test 10 Failed")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF Cardinality({f \\in [{1,2,3} -> {1,2,3}] : f[2] > 1}) # 18\0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF Cardinality([{1,2,3} -> {1,2,3,4}]) # 64\0a       THEN Assert(FALSE, "Test 12 Failed")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF Cardinality([ {5, 5, 5, 3, 5, 2} -> {1, 3, 3, 3} ]) # 8\0a       THEN Assert(FALSE, "Test 13 Failed")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0a  /\\ IF [ {5, 5, 5, 3, 5, 2} -> {1, 3, 3, 3} ] # [{2,3,5} -> {1,3}]\0a       THEN Assert(FALSE, "Test 14 Failed")\0a       ELSE Print("Test 14 OK", TRUE)\0a\0a=========================================\0a']]]
      ['suite/test99' 'test99' %accept ~[['test99' '------------------------------ MODULE test99 -----------------------------\0a(* Test of standard Naturals module.    *)\0a\0aEXTENDS Integers, TLC\0a\0aVARIABLES x\0a\0aInit == x = 0\0a\0aNext == UNCHANGED x\0a\0aInv == \0a(*       /\\ IF  2^10 + 2^10 = 2^11\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed")    \0a\0a       /\\ IF 0^20 = 0\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed")    *)    \0a\0a       /\\ IF 2 - 3 \\notin Nat\0a            THEN Print("Test 3 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")\0a\0a       /\\ IF 123 * 345 = 42435\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4 Failed")\0a\0a       /\\ IF 123 < 124\0a            THEN Print("Test 5 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 5 Failed")\0a\0a       /\\ IF 12345 > 12344\0a            THEN Print("Test 6 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 6 Failed")\0a\0a       /\\ IF 123 \\leq 123\0a            THEN Print("Test 7 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 7 Failed")\0a\0a       /\\ IF 12345 \\geq 12345\0a            THEN Print("Test 8 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 8 Failed")\0a\0a       /\\ IF 123 \\leq 124\0a            THEN Print("Test 9 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 9 Failed")\0a\0a       /\\ IF 12344 \\geq 12333\0a            THEN Print("Test 10 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 10 Failed")\0a\0a       /\\ IF 145939 = 487 * (145939 \\div 487) + (145939 % 487) \0a            THEN Print("Test 11 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 11 Failed")  \0a\0a       /\\ IF 139982 \\div 1 = 139982 \0a            THEN Print("Test 12 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 12 Failed")\0a\0a       /\\ IF 123099 % 1 = 0\0a            THEN Print("Test 13 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 13 Failed")\0a\0a       /\\ IF 0 % 345 = 0\0a            THEN Print("Test 14 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 14 Failed")  \0a\0a       /\\ IF 24 % 9 = 6\0a            THEN Print("Test 15 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 15 Failed")   \0a\0a       /\\ IF 4566799 = 423 * (4566799 \\div 423) + (4566799 % 423)\0a            THEN Print("Test 16 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 16 Failed")    \0a\0a       /\\ IF 2222222 = 18 * (2222222 \\div 18) + (2222222 % 18)\0a            THEN Print("Test 17 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 17 Failed")   \0a\0a       /\\ IF 3 .. 2 = {}\0a            THEN Print("Test 18 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 18 Failed")\0a\0a       /\\ IF 2..4 = {2, 3, 4}\0a            THEN Print("Test 19 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 19 Failed")\0a\0a=============================================================================\0a']]]
      ['suite/test999' 'test999' %accept ~[['test999' '--------------- MODULE test999  -------------\0a\0a(* Test replacement of and by infix operators and overridden operators. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0a\0aCONSTANT P(_,_), _++_ , Plus(_, _), PLen(_)\0a\0aPlusPlus(a, b) == <<a, b>>\0a\0aPRep(a, b) == {a, b}\0a\0aMCSeq(a) == {a}\0a\0aMCCat(a, b) == a + b\0a\0aInit == /\\ x = 1\0a        /\\ IF P(2, x+3) = {2, 4}\0a             THEN Print("Test 1 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 1 Failed")\0a        /\\ IF (2++(x+3)) = <<2, 4>>\0a             THEN Print("Test 2 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 2 Failed")\0a        /\\ IF PLen(<<1, 2, 3>>) = 3\0a             THEN Print("Test 3 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 3 Failed")\0a        /\\ IF Plus(2, x+3) = 6\0a             THEN Print("Test 4 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 4 Failed")\0a        /\\ IF Seq(22) = {22}\0a             THEN Print("Test 5 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 5 Failed")\0a        /\\ IF 1 \\o 2 = 3                          (* Huh???? *)\0a             THEN Print("Test 6 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 6 Failed")\0a        /\\ LET a \\prec b == a < b\0a           IN  IF 1 \\prec 2\0a                 THEN Print("Test 7 OK", TRUE)\0a                 ELSE Assert(FALSE, "Test 7 Failed")\0a\0aNext == UNCHANGED x\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/testa' 'testa' %reject ~[['testa' '------- MODULE testa -----\0a\0aEXTENDS test, Integers\0a\0a==========================\0a'] ['test' '------------- MODULE Foo  --------------\0aEXTENDS Naturals\0a\0aFoo == \\A x \\in {1} : lab(x) :: x = 1\0a\0aBar == Foo!lab(1)\0a\0aASSUME Bar\0a=============================================\0a']]]
      ['suite/testfoo' 'testfoo' %reject ~[['testfoo' '------------- MODULE test  --------------\0aEXTENDS Naturals\0a\0aVARIABLES x\0a\0aInit == x \\in SUBSET (1..32)\0a        \0aNext == x\' = 1\0a=============================================\0a']]]
      ['suite/testt37' 'testt37' %reject ~[['testt37' '---------------------------- MODULE test37 -----------------------------\0aEXTENDS FiniteSets, TLC\0a\0aVARIABLES x\0a\0aInit == x = 0\0aNext == x\'=x\0aInv  ==\0a       /\\ IF IsFiniteSet({"a", "b"})\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed")\0a\0a       /\\ IF IsFiniteSet({})\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed")\0a\0a       /\\ IF Cardinality({}) = 0\0a            THEN Print("Test 3 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")\0a\0a       /\\ IF Cardinality({"a", "b"}) = 2\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4 Failed")\0a\0a\0a=============================================================================\0a']]]
      ['symmetry/April20a' 'April20a' %accept ~[['April20a' '----------------------------- MODULE April20a -----------------------------\0aEXTENDS Integers\0a\0aCONSTANT S\0a\0aVARIABLE x, y\0avars == <<x, y>>\0a\0aInit == (x = 0) /\\ (y=0)\0a\0aNext == \\/ /\\ y=0\0a           /\\ y\'=1\0a           /\\ x\' \\in S\0a        \\/ /\\ y=1\0a           /\\ y\'=2\0a           /\\ x\' \\in S \\ {x} \0a        \\/ /\\ y = 2\0a           /\\ y\'=0\0a           /\\ x\' = 0\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aLive == ~ \\A i \\in S : \\E j \\in S \\ {i} : []<><<x\'=i /\\ x=j>>_x\0a=============================================================================\0a']]]
