      ['coverage/A' 'A' %accept ~[['A' '---------------------------- MODULE A ----------------------------\0aEXTENDS Naturals, FiniteSets\0aVARIABLE x\0a\0aOp1(S) == \\A e \\in SUBSET S : Cardinality(e) >= 0\0a\0aInit == /\\ x = 0\0a        /\\ Op1(1..17)\0a\0a\\* Max(s)\0aOp2(n) == CHOOSE i \\in 1..n : \\A j \\in ((1..n) \\ {i}) : i > j\0a\0aA(n) == x\' = Op2(n)\0a\0aB(n) == x\' = Op2(n)\0a\0aNext == A(10) \\/ B(3)\0a=============================================================================\0a']]]
      ['coverage/B' 'B' %accept ~[['B' '---------------------------- MODULE B ----------------------------\0aVARIABLE x\0a\0aInit == x = FALSE\0a\0aSwitch(var) == ~var\0a\0aA == x\' = Switch(x)\0a\0aB == x\' = Switch(x)\0a\0aNext == A \\/ B\0a=============================================================================\0a']]]
      ['coverage/C' 'C' %accept ~[['C' '---------------------------- MODULE C ----------------------------\0aEXTENDS Naturals, FiniteSets\0aVARIABLES x,y\0a\0ac == x\0ad == y\0a\0avars == <<x,y>>\0a\0aa == x\'\0a\0aOp(S) == \\A e \\in SUBSET S : Cardinality(e) >= 0\0a\0aInit == /\\ x \\in 1..3\0a        /\\ y = 0\0a\0aA == /\\ c \\in Nat\0a     /\\ y \\in Nat\0a     /\\ a = x + 1\0a     /\\ UNCHANGED y\0a\0aB == /\\ x \\in Nat\0a     /\\ Op(1..5)\0a     /\\ UNCHANGED <<x,d>>\0a\0aC == /\\ x = 42\0a     /\\ c\' = TRUE\0a     /\\ y\' = FALSE\0a\0aD == x\' \\in 0..x /\\ UNCHANGED y\0a\0aU1 == x < 0 /\\ UNCHANGED vars\0a\0aU2 == x < 0 /\\ UNCHANGED <<x,y>>\0a\0aU3 == x < 0 /\\ UNCHANGED x /\\ UNCHANGED y\0a\0aNext == A \\/ B \\/ C \\/ D \\/ U1 \\/ U2 \\/ U3\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aConstraint == x < 20\0a\0a(* Coverage/Cost statistics for Invariants too. *)\0a\0aexpensive(N) == \\A e \\in SUBSET (1..N) : \\A f \\in e : f \\in 1..N \0a\0aInv == /\\ x \\in Nat\0a       /\\ y \\in Nat\0a       /\\ expensive(8)\0a       /\\ LET frob == TRUE  \0a          IN /\\ frob = TRUE\0a             /\\ \\A i \\in 1..5: i \\in Nat \0a             /\\ 42 \\in Nat\0a\0aInv2 == /\\ x \\in Nat\0a        /\\ y \\in Nat\0a        /\\ expensive(9)\0a        /\\ LET frob == TRUE\0a           IN /\\ frob = TRUE\0a             /\\ \\A i \\in 1..5: i \\in Nat \0a              /\\ 42 \\in Nat\0a=============================================================================\0a']]]
      ['coverage/CoverageStatistics' 'CoverageStatistics' %accept ~[['CoverageStatistics' '---------------------------- MODULE CoverageStatistics ----------------------------\0aEXTENDS Naturals, FiniteSets\0aVARIABLES x,y\0a\0ac == x\0ad == y\0a\0avars == <<x,y>>\0a\0aa == x\'\0a\0aInit == /\\ x \\in 1..3\0a        /\\ y = 0\0a\0aA == /\\ c \\in Nat\0a     /\\ y \\in Nat\0a     /\\ a = x + 1\0a     /\\ UNCHANGED d \\* 18 should be covered (6 should be omitted)\0a\0aB == /\\ x \\in Nat\0a     /\\ UNCHANGED <<x,d>> \\* 21 and 6 should be covered (6 should actually be omitted)\0a\0aB2 == /\\ x \\in Nat\0a     /\\ UNCHANGED vars \\* 21 and 6 should be covered (6 should actually be omitted)\0a     \0aC == /\\ x = 42\0a     /\\ c\' = TRUE\0a     /\\ y\' = FALSE\0a\0aU1 == x < 0 /\\ UNCHANGED vars \\* vars should be reported as uncovered instead of x and y on line 8\0a\0aU2 == x < 0 /\\ UNCHANGED <<x,y>> \\* col 28 & 30 \0a\0aU3 == x < 0 /\\ UNCHANGED x /\\ UNCHANGED y \\* col 26 & 41\0a\0aU4 == x < 0 /\\ UNCHANGED x /\\ UNCHANGED d (* d itself instead of y is marked uncovered *)\0a\0aUC1 == x \\in Nat /\\ UNCHANGED <<x,y>>\0a\0aUC2 == x \\in Nat /\\ UNCHANGED x /\\ UNCHANGED y\0a\0aUC3 == x \\in Nat /\\ UNCHANGED vars \\* Do not mark vars on line 8 as covered\0a\0aNext == A \\/ B \\/ C \\/ U1 \\/ U2 \\/ U3 \\/ U4 \\/ UC1 \\/ UC2 \\/ UC3\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aConstraint == x < 20\0a\0a=============================================================================\0a']]]
      ['coverage/D' 'D' %accept ~[['D' '---------------------------- MODULE D ----------------------------\0aEXTENDS Naturals\0aVARIABLE x\0a\0aInit == x = 0\0a\0a(* No endless recursion in Coverage/Cost with RECURSIVE. *)\0aRECURSIVE fact(_)\0afact(n) == IF n = 1 THEN 1 ELSE n * fact(n - 1)\0a\0aA == x\' = fact(3)\0a\0aB == x\' = fact(9)\0a\0aNext == A \\/ B\0a\0aSpec == Init /\\ [][Next]_<<x>>\0a=============================================================================\0a']]]
      ['coverage/E' 'E' %accept ~[['E' '---------------------------- MODULE E ----------------------------\0aCONSTANT Op(_)\0a\0aVARIABLE x\0a\0aId(n) == SUBSET {1,2,3}\0a\0aForty2(n) == Id(n)\0a\0aInit == x = 0\0a\0aNext == x\' \\in Op(x)\0a=============================================================================\0a']]]
      ['coverage/F' 'F' %accept ~[['F' '---------------------------- MODULE F ----------------------------\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aOp(S, P(_), Q(_, _)) == { s \\in S : P(s) /\\ Q(s, TRUE) }\0a\0aInit == x \\in Op({1,2,3,4,5}, LAMBDA s: s > 1, LAMBDA odd, b: odd % 2 # 0 /\\ b) \0a\0aNext == UNCHANGED x\0a=============================================================================\0a']]]
      ['coverage/G' 'G' %accept ~[['G' '---------------------------- MODULE G ----------------------------\0aVARIABLES u1\0a\0avars == << u1 >>\0a\0aInit == /\\ u1 = TRUE\0a\0aNext == /\\ UNCHANGED vars\0a        /\\ UNCHANGED <<u1>>\0a        /\\ UNCHANGED u1\0a\0aProp == ENABLED Next\0a=============================================================================\0a']]]
      ['coverage/Github649' 'Github649' %accept ~[['Github649' '---- MODULE Github649 ----\0aEXTENDS Naturals\0a\0aVARIABLE clock\0a\0aRECURSIVE Check(_,_)\0aCheck(c,n) == IF n = 0 THEN c \\in BOOLEAN ELSE Check(c, n - 1)\0a\0aTypeOK == Check(clock,1)\0a\0aRECURSIVE Flip(_,_,_)\0aFlip(v, b, n) == IF n = 0 THEN v = ~b ELSE Flip(v, b, n - 1)\0a\0aInit == Flip(clock, FALSE, 1)  \\* The expression Flip(..) does *not* appear in the coverage result. Some of its parameters are covered (invoked),\0a                               \\* but the Flip(..) itself gets skipped over by TLC.  It correctly does not get marked as uncovered.\0aNext == clock\' = ~clock\0a\0aConstraint ==\0a    Flip(clock, ~clock, 2)\0a====']]]
      ['coverage/H' 'H' %accept ~[['H' '------------------------------ MODULE H ------------------------------\0aEXTENDS Naturals\0aVARIABLES x\0a\0aMyNat == 0..30\0a\0aTypeOK == x \\in MyNat\0a\0aInit == x = 0\0a\0aA == x\' = 23\0a\0aBandC == \\/ /\\ x \\in MyNat\0a            /\\ x\' \\in 23..25\0a         \\/ /\\ x < 25\0a            /\\ x\' = 26\0a\0aDandE == (x = 23 /\\ x\' = 42) \\/ (x = 123 /\\ x\' = 4711)\0a\0aNext == A \\/ BandC \\/ DandE\0a\0aInv == /\\ TypeOK\0a       /\\ x = 0\0a\0aSpec == Inv /\\ [][Next]_x\0a\0a============\0a']]]
      ['coverage/I' 'I' %accept ~[['I' '------------------------------ MODULE I ------------------------------\0aEXTENDS Naturals\0aVARIABLES x\0a\0aF[ i \\in {1,2,3,4,5} ] == \0a   IF i = 1 THEN 1 ELSE F[i-1] + 1 \\* Recursive Function Definition\0a\0aN[n \\in {1,2,3}] == \0a    /\\ UNCHANGED <<x>>\0a\0aSpec == x \\in {1,2,3,4,5} /\\ [][\\E i \\in {1,2,3} : N[i] ]_x\0a\0aInv == \\E i \\in DOMAIN F: F[i] = x\0a\0a============\0a']]]
      ['coverage/J' 'J' %accept ~[['J' '------------------------------ MODULE J ------------------------------\0a\0aVARIABLES x, y\0a\0aInit == /\\ x \\in {1,2,3,4,5}\0a        /\\ y = [i \\in {1,2,3,4,5} |-> 0]\0a\0aFoo(rcds) ==\0a CASE x = 1 -> [ rcds EXCEPT ![x] = 42 ]\0a   [] OTHER -> rcds\0a\0aNext == /\\ y\' = Foo(y)\0a        /\\ UNCHANGED x \0a\0aSpec == Init /\\ [][Next]_<<x,y>>\0a============\0a']]]
      ['coverage/K' 'K' %accept ~[['K' '------------------------------ MODULE K ------------------------------\0a\0aEXTENDS Naturals\0a\0aFoo(Op(_), S) == \\A s \\in S: Op(s)\0a\0aBar(S) == Foo(LAMBDA e: e \\in Nat, S)\0a\0aVARIABLE x\0a\0aSpec == x = Bar({1,2,3}) /\\ [][UNCHANGED x]_x \0a============\0a']]]
      ['coverage/L' 'L' %accept ~[['L' '------------------------------ MODULE L ------------------------------\0aEXTENDS Naturals\0a\0aVARIABLE v\0a\0aChooseOne(S, P(_)) == CHOOSE x \\in S : P(x) /\\ \\A y \\in S : P(y)\0a\0aSpec == v = ChooseOne({1}, LAMBDA x : TRUE) /\\ [][UNCHANGED v]_v\0a\0a============\0a']]]
      ['coverage/M' 'M' %accept ~[['M' '------------------------------ MODULE M ------------------------------\0aEXTENDS Naturals, FiniteSets\0a\0aVARIABLES active, color, tpos, tcolor\0avars == <<active, color, tpos, tcolor>>\0a\0aNodes == 0 .. 2\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]    \\* status of nodes (active or passive)\0a  /\\ color \\in [Nodes -> Color]       \\* color of nodes\0a  /\\ tpos \\in Nodes                   \\* token position\0a  /\\ tcolor \\in Color                 \\* token color\0a\0aInit ==\0a  /\\ active \\in [{23,42,56} -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor = "black"\0a\0aNext ==\0a  /\\ active\' \\in [{23,42,56} -> BOOLEAN]\0a  /\\ color\' \\in [Nodes -> Color]\0a  /\\ tpos\' \\in Nodes\0a  /\\ tcolor\' = "black"\0a  \0aSpec ==\0a  Init /\\ [][Next]_vars\0a\0a============\0a']]]
      ['debug/Debug02' 'Debug02' %accept ~[['Debug02' '\0a  I didn\'t want to update the line numbers in the JUnit test.\0a\0a------------------------------- MODULE Debug02 -------------------------------\0aVARIABLE x\0aInit == x = TRUE\0aNext == x\' =~x\0aSpec == Init /\\ [][Next]_x\0aCONSTANT C\0aval == 42\0a==================================================================================\0a------------------------------- CONFIG Debug02 -------------------------------\0aSPECIFICATION Spec\0aCONSTANT C <- val\0a==================================================================================\0a']]]
      ['debug/Debug03' 'Debug03' %accept ~[['Debug03' '------------------------------- MODULE Debug03 -------------------------------\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aInit ==\0a    x \\in 0..1\0a\0aNext == \0a    /\\ x < 10\0a    /\\ x\' \\in 1..9\0a\0aSpec == \0a    Init /\\ [][Next]_x\0a\0a==================================================================================\0a------------------------------- CONFIG Debug03 -------------------------------\0aSPECIFICATION Spec\0a==================================================================================\0a']]]
      ['debug/Debug05' 'Debug05' %accept ~[['Debug05' '--------------------------------- MODULE Debug05 ---------------------------------\0aEXTENDS Naturals\0aVARIABLE b, i\0aInit == b = FALSE /\\ i = 1\0aNext == b\' \\in BOOLEAN /\\ i\' = i + 1\0aSpec == Init /\\ [][Next]_<<b, i>>\0a==================================================================================\0a--------------------------------- CONFIG Debug05 ---------------------------------\0aSPECIFICATION Spec\0a==================================================================================\0a']]]
      ['debug/ExpressionBreakpointTest' 'ExpressionBreakpointTest' %accept ~[['ExpressionBreakpointTest' '---- MODULE ExpressionBreakpointTest ----\0aEXTENDS Naturals\0aVARIABLE i\0aCONSTANT j\0aASSUME j \\in Nat\0aop(k) ==\0a  \\A l \\in 0 .. (j - k) :\0a    i \\in Nat\0aInv == op(5)\0aInit == i = 0\0aNext == IF i < j THEN i\' = i + 1 ELSE UNCHANGED i\0a====\0a---- CONFIG ExpressionBreakpointTest ----\0aCONSTANT j = 10\0aINVARIANTS Inv\0aINIT Init\0aNEXT Next\0a====\0a\0a']]]
      ['examples/SpecifyingSystems/CachingMemory/MemoryInterface' 'MemoryInterface' %accept ~[['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a']]]
      ['examples/SpecifyingSystems/Liveness/HourClock' 'HourClock' %accept ~[['HourClock' '---------------------- MODULE HourClock ----------------------\0aEXTENDS Naturals\0aVARIABLE hr\0aHCini  ==  hr \\in (1 .. 12)\0aHCnxt  ==  hr\' = IF hr # 12 THEN hr + 1 ELSE 1\0aHC  ==  HCini /\\ [][HCnxt]_hr\0a--------------------------------------------------------------\0aTHEOREM  HC => []HCini\0a==============================================================\0a']]]
      ['examples/SpecifyingSystems/Liveness/MemoryInterface' 'MemoryInterface' %accept ~[['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a']]]
      ['examples/SpecifyingSystems/TLC/ABCorrectness' 'ABCorrectness' %accept ~[['ABCorrectness' '------------------- MODULE ABCorrectness --------------------\0aEXTENDS Naturals\0aCONSTANTS Data\0aVARIABLES sBit, sAck, rBit, sent, rcvd  \0a-------------------------------------------------------------\0aABCInit == /\\ sBit \\in {0, 1}\0a           /\\ sAck = sBit\0a           /\\ rBit = sBit\0a           /\\ sent \\in Data\0a           /\\ rcvd \\in Data\0a\0aCSndNewValue(d) == /\\ sAck = sBit\0a                   /\\ sent\' = d\0a                   /\\ sBit\' = 1 - sBit\0a                   /\\ UNCHANGED <<sAck, rBit, rcvd>>\0a\0aCRcvMsg == /\\ rBit # sBit \0a           /\\ rBit\' = sBit\0a           /\\ rcvd\' = sent\0a           /\\ UNCHANGED <<sBit, sAck, sent>>\0a\0aCRcvAck == /\\ rBit # sAck\0a           /\\ sAck\' = rBit\0a           /\\ UNCHANGED <<sBit, rBit, sent, rcvd>>\0a\0aABCNext == \\/  \\E d \\in Data : CSndNewValue(d) \0a           \\/  CRcvMsg \\/ CRcvAck \0a-------------------------------------------------------------\0acvars == <<sBit, sAck, rBit, sent, rcvd>>\0a\0aTypeInv == /\\ sBit \\in {0, 1}\0a           /\\ sAck \\in {0, 1}\0a           /\\ rBit \\in {0, 1}\0a           /\\ sent \\in Data\0a           /\\ rcvd \\in Data\0a\0aABCFairness == WF_cvars(CRcvMsg) /\\ WF_cvars(CRcvAck)   \0a\0aABCSpec == ABCInit /\\ [][ABCNext]_cvars /\\ ABCFairness\0a\0aInfOftenOutOfSync == []<>(sBit # sAck)\0a==============================================================\0a']]]
      ['gh1134/Base' 'Base' %accept ~[['Base' '------------------------------- MODULE Base -------------------------------\0a\0aEXTENDS FiniteSets, Integers, TLC\0a\0aCONSTANT UserIDs\0aVARIABLE State\0a\0aStateMachine == INSTANCE UserStateMachine\0a\0a============================================================================='] ['UserStateMachine' '------------------------------- MODULE UserStateMachine -------------------------------\0a\0aEXTENDS Sequences\0a\0aVARIABLE State\0a\0aInit(userIDs) ==\0a    State = [u \\in userIDs |-> "INIT"]\0a    \0aNext(user) ==\0a    State\' = [State EXCEPT ![user] = "DONE"]\0a\0a=============================================================================\0a\0aBefore param refinement:\0a[State line 5, col 10 to line 5, col 14 of module UserStateMachine->(2 :> "INIT"), \0a    userIDs line 7, col 6 to line 7, col 12 of module UserStateMachine-><LAZY line 13, col 27 to line 13, col 33 of module SingleUser>, \0a        State line 6, col 10 to line 6, col 14 of module Base->(2 :> "INIT"), \0a            UserIDs line 5, col 10 to line 5, col 16 of module Base-><LAZY line 6, col 28 to line 6, col 30 of module MultiUser>]\0a\0aWith param refinement:\0a[State line 5, col 10 to line 5, col 14 of module UserStateMachine->(2 :> "INIT"), \0a    State line 6, col 10 to line 6, col 14 of module Base->(2 :> "INIT"), \0a        UserIDs line 5, col 10 to line 5, col 16 of module Base-><LAZY line 6, col 28 to line 6, col 30 of module MultiUser>, \0a            userIDs line 7, col 6 to line 7, col 12 of module UserStateMachine-><LAZY line 13, col 27 to line 13, col 33 of module SingleUser>]\0a\0a']]]
      ['gh1134/UserStateMachine' 'UserStateMachine' %accept ~[['UserStateMachine' '------------------------------- MODULE UserStateMachine -------------------------------\0a\0aEXTENDS Sequences\0a\0aVARIABLE State\0a\0aInit(userIDs) ==\0a    State = [u \\in userIDs |-> "INIT"]\0a    \0aNext(user) ==\0a    State\' = [State EXCEPT ![user] = "DONE"]\0a\0a=============================================================================\0a\0aBefore param refinement:\0a[State line 5, col 10 to line 5, col 14 of module UserStateMachine->(2 :> "INIT"), \0a    userIDs line 7, col 6 to line 7, col 12 of module UserStateMachine-><LAZY line 13, col 27 to line 13, col 33 of module SingleUser>, \0a        State line 6, col 10 to line 6, col 14 of module Base->(2 :> "INIT"), \0a            UserIDs line 5, col 10 to line 5, col 16 of module Base-><LAZY line 6, col 28 to line 6, col 30 of module MultiUser>]\0a\0aWith param refinement:\0a[State line 5, col 10 to line 5, col 14 of module UserStateMachine->(2 :> "INIT"), \0a    State line 6, col 10 to line 6, col 14 of module Base->(2 :> "INIT"), \0a        UserIDs line 5, col 10 to line 5, col 16 of module Base-><LAZY line 6, col 28 to line 6, col 30 of module MultiUser>, \0a            userIDs line 7, col 6 to line 7, col 12 of module UserStateMachine-><LAZY line 13, col 27 to line 13, col 33 of module SingleUser>]\0a\0a']]]
      ['pcal/CEither1' 'CEither1' %accept ~[['CEither1' '------------------------------- MODULE CEither1 ----------------------------- \0aEXTENDS Naturals, Sequences, TLC\0a\0a(* --algorithm Either {\0a      variables x = 0 ; y = 0 ;\0a        {   a: either {x := 1 ; b: x := x + 1;} ;\0a                   or { y := 1 ; c: y := y + 1;} ; \0a\\*               end either ;\0a            d: assert x+y = 2 ;\0a        } }\0a     \0a*)\0a\0a\\* BEGIN TRANSLATION (chksum(pcal) = "f7b78f6e" /\\ chksum(tla) = "7186648")\0aVARIABLES pc, x, y\0a\0avars == << pc, x, y >>\0a\0aInit == (* Global variables *)\0a        /\\ x = 0\0a        /\\ y = 0\0a        /\\ pc = "a"\0a\0aa == /\\ pc = "a"\0a     /\\ \\/ /\\ x\' = 1\0a           /\\ pc\' = "b"\0a           /\\ y\' = y\0a        \\/ /\\ y\' = 1\0a           /\\ pc\' = "c"\0a           /\\ x\' = x\0a\0ab == /\\ pc = "b"\0a     /\\ x\' = x + 1\0a     /\\ pc\' = "d"\0a     /\\ y\' = y\0a\0ac == /\\ pc = "c"\0a     /\\ y\' = y + 1\0a     /\\ pc\' = "d"\0a     /\\ x\' = x\0a\0ad == /\\ pc = "d"\0a     /\\ Assert(x+y = 2, "Failure of assertion at line 9, column 16.")\0a     /\\ pc\' = "Done"\0a     /\\ UNCHANGED << x, y >>\0a\0a(* Allow infinite stuttering to prevent deadlock on termination. *)\0aTerminating == pc = "Done" /\\ UNCHANGED vars\0a\0aNext == a \\/ b \\/ c \\/ d\0a           \\/ Terminating\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ WF_vars(Next)\0a\0aTermination == <>(pc = "Done")\0a\0a\\* END TRANSLATION\0a\0a=============================================================================\0a']]]
  ==
::
++  test-sany-sub-2
  %+  expect-eq
    !>  ^-  (list @t)
    :~  'suite/etest15 -> hoon=reject'  'suite/etest16 -> hoon=accept'  'suite/test16 -> hoon=reject'  'suite/test201 -> hoon=reject'  'suite/test203 -> hoon=reject'  'suite/test214 -> hoon=accept'  'suite/test30 -> hoon=reject'
    ==
  !>
  %-  sub-batch-run
  ^-  (list [@t @t ?(%accept %reject) (list [@t @t])])
  :~
      ['pcal/Github136' 'Github136' %accept ~[['Github136' '------------------------------ MODULE Github136 -----------------------------\0a\\* Regression test for https://github.com/tlaplus/tlaplus/issues/136\0a\\* The PlusCal translator used to choke on a top-level comma inside an\0a\\* INSTANCE ... WITH clause appearing within a `define\' block.\0a\0aEXTENDS Naturals\0a\0a(*--algorithm Github136\0avariables x = 0;\0adefine\0a    Inner == INSTANCE Github136Inner WITH Foo1 <- 3, Foo2 <- 4\0aend define;\0abegin\0a    Step: x := Inner!Sum;\0aend algorithm; *)\0a\\* BEGIN TRANSLATION (chksum(pcal) = "a38a0cc5" /\\ chksum(tla) = "81c563ad")\0aVARIABLES pc, x\0a\0a(* define statement *)\0aInner == INSTANCE Github136Inner WITH Foo1 <- 3, Foo2 <- 4\0a\0a\0avars == << pc, x >>\0a\0aInit == (* Global variables *)\0a        /\\ x = 0\0a        /\\ pc = "Step"\0a\0aStep == /\\ pc = "Step"\0a        /\\ x\' = Inner!Sum\0a        /\\ pc\' = "Done"\0a\0a(* Allow infinite stuttering to prevent deadlock on termination. *)\0aTerminating == pc = "Done" /\\ UNCHANGED vars\0a\0aNext == Step\0a           \\/ Terminating\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aTermination == <>(pc = "Done")\0a\0a\\* END TRANSLATION \0a\0aXCorrect == x \\in {0, 7}\0a=============================================================================\0a'] ['Github136Inner' '------------------------------ MODULE Github136Inner ------------------------------\0aEXTENDS Naturals\0a\0aCONSTANTS Foo1, Foo2\0a\0aSum == Foo1 + Foo2\0a=============================================================================\0a']]]
      ['pcal/Github136Inner' 'Github136Inner' %accept ~[['Github136Inner' '------------------------------ MODULE Github136Inner ------------------------------\0aEXTENDS Naturals\0a\0aCONSTANTS Foo1, Foo2\0a\0aSum == Foo1 + Foo2\0a=============================================================================\0a']]]
      ['sany/RecursiveDefDeclMismatch' 'RecursiveDefDeclMismatch' %reject ~[['RecursiveDefDeclMismatch' '------------------------- MODULE RecursiveDefDeclMismatch -------------------\0a\0aRECURSIVE CountDown(_,_)\0aCountDown(n) == IF n = 0 THEN TRUE ELSE CountDown(n - 1)\0a\0a=============================================================================\0a']]]
      ['simulation/BenchmarkSpec/BenchmarkSpec' 'BenchmarkSpec' %accept ~[['BenchmarkSpec' '------------------------------ MODULE BenchmarkSpec ------------------------------\0aEXTENDS Integers, Sequences\0a\0a\\*\0a\\* This spec produces a state space with a simple tree-like structure. The maximum depth and branching\0a\\* factor of the state space tree can be controlled by setting the constant values of the spec. The goal\0a\\* is to give a spec whose state space structure is easily understandable and controllable, for the sake\0a\\* of running performance and/or correctness tests of TLC.\0a\\*\0a\0aVARIABLE hist\0a\0aInit == hist = <<>>\0a\0aCONSTANTS Depth, BranchingFactor\0a    \0aNext ==\0a    \\E e \\in 1..BranchingFactor :\0a    hist\' = Append(hist, e)    \0a\0aSpec == Init /\\ [][Next]_<<hist>>\0a\0aConstraint == Len(hist) < Depth\0a\0a\\* An arbitrary state of max length. It\'s just a sequence filled with all 1\'s.\0aInv == hist # [i \\in 1..Depth |-> 1]\0a\0a=============================================================================']]]
      ['suite/etest1' 'etest1' %reject ~[['etest1' '--------------- MODULE etest1 -------------\0a\0a(* Test that TLC complains if an operator is called with too many arguments. *)\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == \0a  /\\ Print("Should complain that operator Foo is called with too many arguments", TRUE)\0a  /\\ x = TRUE\0a\0aNext == UNCHANGED x\0a\0a\0aFoo(a) == a \0a\0aInv ==  Foo(x, x)\0a\0a=========================================\0a']]]
      ['suite/etest10' 'etest10' %accept ~[['etest10' '--------------- MODULE etest10  -------------\0a\0a\\* Test that TLC doesn\'t accept x \\in Int if x not a number\0a\0aEXTENDS TLC, Integers\0a\0aVARIABLE x\0a\0aInit == /\\ x = "a"\0a        /\\ Print("Should report error here", TRUE)\0a        /\\ Print(x \\in Int, TRUE)\0a\0aNext == /\\ x\'=x\0a        /\\ Print("Test failed--error not reported", TRUE)\0a=========================================\0a']]]
      ['suite/etest11' 'etest11' %accept ~[['etest11' '--------------- MODULE etest11  -------------\0a\0a\\* Test that TLC doesn\'t accept x \\in STRING if x not a string\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0aInit == /\\ x = 1\0a        /\\ Print("Should report error here", TRUE)\0a        /\\ Print(x \\in STRING, TRUE)\0a\0aNext == /\\ x\'=x\0a        /\\ Print("Test failed--error not reported", TRUE)\0a=========================================\0a']]]
      ['suite/etest12' 'etest12' %accept ~[['etest12' '-------------------------- MODULE etest12 --------------------------------\0aEXTENDS Naturals, TLC, FiniteSets\0a\\* Test of error reporting when computing Cardinality of a huge set.\0a\0aASSUME\0a     IF Cardinality ([0..2 -> 1..2000]) = Cardinality ([2..4 -> 1..2000]) \0a       THEN Print("Test 22 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 22 Failed")\0a==========================================================================']]]
      ['suite/etest13' 'etest13' %accept ~[['etest13' '-------------------------- MODULE etest13 --------------------------------\0aEXTENDS Naturals, TLC, FiniteSets\0a\\* Test of error reporting when computing Cardinality of a huge set.\0a\0aASSUME\0a     IF Cardinality ([0..2 -> 1..2000]) = Cardinality ([2..4 -> 1..2000]) \0a       THEN Print("Test 22 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 22 Failed")\0a==========================================================================']]]
      ['suite/etest14' 'etest14' %accept ~[['etest14' '----------------------  MODULE etest14 -----------------------------\0a\0a\\* Test of CHOOSEing element of empty set.\0aASSUME\0a  /\\ (CHOOSE y \\in {} : TRUE) = (CHOOSE y \\in {} : TRUE)\0a=====================================================================\0a']]]
      ['suite/etest15' 'etest15' %accept ~[['etest15' '----------------------  MODULE etest15 -----------------------------\0a\\* Test that TLC distinguishes <<x>> from x in function expressions.\0a\0aEXTENDS Naturals\0a\0aS == {<<y>> : y \\in {1, 2, 3, 4}}\0a\0aASSUME  [<<y>> \\in S |-> y+1][2] = [<<y>> \\in S |-> y+1][2] \0a  \0a=====================================================================\0a']]]
      ['suite/etest16' 'etest16' %reject ~[['etest16' '--------------- MODULE etest16 -----------\0a\0a\\* Test of detecting duplicate record elements\0a\0aFoo == [a |-> 1, b |-> 2, a |-> 1]\0a\0aBar == [a : {1}, b : {2}, a : {1}]\0a=============================================================================\0a\0a\0a\0a']]]
      ['suite/etest2' 'etest2' %reject ~[['etest2' '--------------- MODULE etest2 -------------\0a\0a(* Test that TLC complains if a operator is called with too few arguments. *)\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == \0a  /\\ Print("Should complain that operator Foo is called with too few arguments", TRUE)\0a  /\\ x = TRUE\0a\0aNext == UNCHANGED x\0a\0a\0aFoo(a, b) == a /\\ b\0a\0aInv ==  Foo(x)\0a\0a=========================================\0a']]]
      ['suite/etest3' 'etest3' %accept ~[['etest3' '--------------- MODULE etest3  -------------\0a\0a(* Testing deadlock and number of states found. *)\0a\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aVARIABLE x, y, z\0a\0aInit == /\\ Print("This test should deadlock after finding two states", TRUE)\0a        /\\ x = {}\0a        /\\ y = {}\0a        /\\ z = 1\0a\0aNext == /\\ x = {}\0a        /\\ x\' = {1}        \0a        /\\ y\' \\in SUBSET x\'\0a        /\\ z\' = z\0a        /\\ y\' = {}\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/etest4' 'etest4' %accept ~[['etest4' '--------------- MODULE etest4  -------------\0a\0a(* Evaluates m[v] for model-value m. *)\0a\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aVARIABLE x\0aCONSTANT A\0a\0a\0a\0aReq == [  mask |-> A  ]\0aInit == /\\ x = 1\0a        /\\ Print("Should report error for applying model value to arg", TRUE)\0a        /\\ Req.mask[1] = 1\0a        /\\ Print("Should never get this far", TRUE)\0a\0aNext == UNCHANGED x\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/etest5' 'etest5' %reject ~[['etest5' '--------------- MODULE etest5  -------------\0a\0a(* M!Ident for nonexistent module M. *)\0a\0aEXTENDS TLC, Naturals\0a\0aVARIABLE x\0a\0aInit == /\\ x = 1\0a        /\\ Print("Should report error for nonexistent module M", TRUE)\0a\0aNext == /\\ UNCHANGED x\0a        /\\ IF M!Init THEN TRUE\0a                     ELSE TRUE\0a        /\\ Print("Should not get this far", TRUE)\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/etest6' 'etest6' %accept ~[['etest6' '--------------- MODULE etest6 -------------\0a\0a(* Defining x\' in terms of x\' *)\0a\0aEXTENDS TLC, Integers, Sequences, FiniteSets\0a\0aVARIABLE x\0a\0aInit == /\\ Print("Should complain about undefined value of x.", TRUE)\0a        /\\ x = [i \\in {1,2} |-> i]\0a\0a\0aAction(c) == c\' = [c EXCEPT ![1] = (c[2])\']\0a\0aNext ==  \\/ /\\ x[1] = 1\0a            /\\ Action(x)\0a            /\\ Print("Should not get this far", TRUE)\0a\0a         \\/ UNCHANGED x\0a\0aInv ==  TRUE\0a         \0a\0aConstraint == TRUE\0a=========================================\0a']]]
      ['suite/etest7' 'etest7' %accept ~[['etest7' '--------------- MODULE etest7  -------------\0a\0a(* Test replacement of constant with nonconstant operator. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aCONSTANT C\0a\0aVARIABLE x\0a\0aFoo == x\0a\0aNext == x\' = C\0a\0aInit == /\\ Print("TLC should complain about replacing the constant C", TRUE)\0a        /\\ Print("by the nonconstant Foo", TRUE)\0a        /\\ x = 2\0a\0aInv ==  x = 2\0a\0a=========================================\0a']]]
      ['suite/etest8' 'etest8' %accept ~[['etest8' '--------------- MODULE etest8  -------------\0a\0a(* Test that simulation mode doesn\'t check for deadlock. *)\0a\0aEXTENDS TLC\0a\0a\0aVARIABLE x\0a\0aInit == /\\ x \\in {"a", "b"}\0a        /\\ Print("This spec can deadlock, but shouldn\'t.", TRUE)\0a\0aNext == \\/ /\\ x = "b"\0a           /\\ x\' = "c"\0a        \\/ /\\ x = "c"\0a           /\\ x\' = "d"\0a        \\/ /\\ x = "d"\0a           /\\ x\' = "d"\0a           /\\ Assert(FALSE, "Test successfully completed.")\0a\0a=========================================\0a']]]
      ['suite/etest9' 'etest9' %accept ~[['etest9' '--------------- MODULE etest9  -------------\0a\0a\\* Test that TLC doesn\'t accept x \\in Nat if x not a number\0a\0aEXTENDS TLC, Naturals\0a\0aVARIABLE x\0a\0aInit == /\\ x = "a"\0a        /\\ Print("Should report error here", TRUE)\0a        /\\ Print(x \\in Nat, TRUE)\0a\0aNext == /\\ x\'=x\0a        /\\ Print("Test failed--error not reported", TRUE)\0a=========================================\0a']]]
      ['suite/test' 'test' %reject ~[['test' '------------- MODULE Foo  --------------\0aEXTENDS Naturals\0a\0aFoo == \\A x \\in {1} : lab(x) :: x = 1\0a\0aBar == Foo!lab(1)\0a\0aASSUME Bar\0a=============================================\0a']]]
      ['suite/test16' 'test16' %accept ~[['test16' '--------------- MODULE test16 -------------\0a(* Test of handling of one-tuples *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0aS == {<<y>> : y \\in {1, 2, 3, 4}}\0a\0aInv ==  \0a\0a  /\\ IF <<1>> \\notin S\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF ~(\\E <<y>> \\in S : y = 2) \0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF ~(\\E y \\in S : y[1] = 2) \0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF {<<y>> \\in S : y > 3} # {<<4>>}\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF <<1>> \\o <<2>> # <<1, 2>>\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF [<<y>> \\in S |-> y+1][<<2>>] # 3\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a\0a=========================================\0a']]]
      ['suite/test19' 'test19' %accept ~[['test19' '--------------- MODULE test19 -------------\0a\0a(* Test of large initial state space *)\0a\0aEXTENDS Naturals, Sequences\0a\0aVARIABLE x, y, z \0aInit == /\\ x \\in 1..100\0a        /\\ y \\in 1..200\0a        /\\ z \\in 1..20\0a\0aNext == UNCHANGED <<x, y, z>>\0a\0aInv == TRUE\0a=========================================\0a']]]
      ['suite/test201' 'test201' %accept ~[['test201' '-------------------- MODULE test201 ----------------\0a\\* Test of lambda expressions\0a\0aEXTENDS Naturals, TLC\0aOp(A(_)) == A(4)\0a\0abar == Op(LAMBDA x : x^2)\0a\0aASSUME /\\ Op(LAMBDA x : {x,2} ) = {4,2}\0a       /\\ PrintT("Test1 OK")\0a\0aASSUME /\\ bar = 16 \0a       /\\ PrintT("Test2 OK")\0a\0afoo == INSTANCE test201a WITH A <- LAMBDA y : y^3, b <- 4\0a\0aASSUME /\\ foo!def = 64\0a       /\\ PrintT("Test201 OK")\0a=================================================\0a\0a'] ['test201a' '-------------------- MODULE test201a ----------------\0a\0aCONSTANT A(_), b\0a\0adef == A(b)\0a\0a=============================================================================']]]
      ['suite/test201a' 'test201a' %accept ~[['test201a' '-------------------- MODULE test201a ----------------\0a\0aCONSTANT A(_), b\0a\0adef == A(b)\0a\0a=============================================================================']]]
      ['suite/test202' 'test202' %accept ~[['test202' '-------------------- MODULE test202 ----------------\0a\\* Test of recursion\0a\0aEXTENDS Naturals, TLC\0a\0aRECURSIVE g(_)\0af(a) == IF a = 0 THEN 1 ELSE a * g(a-1)\0ag(a) == f(a) \0a\0a\0aASSUME /\\ f(0) = 1\0a       /\\ f(4) = 24\0a       /\\ \\A i \\in 1..5 : f(i) = i * f(i-1)\0a       /\\ PrintT("Test 1 OK")\0a\0aASSUME /\\ g(0) = 1\0a       /\\ g(4) = 24\0a       /\\ \\A i \\in 1..5 : g(i) = i * g(i-1)\0a       /\\ PrintT("Test 2 OK")\0a\0aRECURSIVE fact\0afact1[n \\in Nat] == fact[n]\0afact[n \\in Nat] == IF n = 0 THEN 1 ELSE n * fact1[n-1]\0a\0aASSUME /\\ fact1[3] = 6\0a       /\\ fact[4] = 24\0a       /\\ \\A i \\in 0..5 : fact[i] = g(i)     \0a       /\\ PrintT("Test 3 OK")\0a\0a\0a=================================================\0a\0a']]]
      ['suite/test203' 'test203' %accept ~[['test203' '-------------------- MODULE test203 ----------------\0a\\* Test of recursion\0a\0aEXTENDS Naturals, TLC\0a\0aRECURSIVE g(_)\0a\0afoo(n) == INSTANCE test203a WITH A <- g, b <- n\0a\0ag(n) == IF n = 0 THEN 1 ELSE n * foo(n-1)!h\0a\0aASSUME /\\ g(0) = 1\0a       /\\ g(4) = 24\0a       /\\ \\A i \\in 1..5 : g(i) = i * g(i-1)\0a       /\\ PrintT("Test1 OK")\0a=================================================\0a\0a'] ['test203a' '-------------------- MODULE test203a ----------------\0a\0aCONSTANT A(_), b\0a\0ah == A(b) \0a\0a\0a=============================================================================']]]
      ['suite/test203a' 'test203a' %accept ~[['test203a' '-------------------- MODULE test203a ----------------\0a\0aCONSTANT A(_), b\0a\0ah == A(b) \0a\0a\0a=============================================================================']]]
      ['suite/test206a' 'test206a' %accept ~[['test206a' '----------------------------- MODULE test206a -----------------------------\0a\0aCONSTANT A5(_, _, _, _, _)\0a\0aFoo(a1, a2, a3, a4, a5) == A5(a1, a2, a3, a4, a5) \0aBar(a) == <<1, a>>\0aBar2(a) == <<1, lab::a>>\0aBar3 == <<1, 2>>\0aBar4(a) == {x \\in {1} : lab(x) :: <<x, a>>}\0aBar5(a) == {x \\in {1} : lab(x) :: LET b ++ c == <<a, b, c, x>>\0a                                  IN 42 }\0a=============================================================================']]]
      ['suite/test207' 'test207' %accept ~[['test207' '\\* SANY2 test.\0a\\* Test of scope of NEW declarations.  They should be restricted\0a\\* to the statement\'s proof, except for SUFFICES which should be \0a\\* visible to the rest of the current proof.\0a\0a-------------------- MODULE test207 ----------------\0aEXTENDS TLC\0aa + b == <<a, b>>\0aTHEOREM Thm == ASSUME NEW J PROVE lab :: TRUE\0a<1>1 ASSUME NEW I\0a     PROVE  Thm!lab\0a  <2>1 I = J\0a  <2>2 QED\0a<1> DEFINE I == 1\0a<1>2 ASSUME NEW K\0a     PROVE  TRUE\0a<1>3 SUFFICES ASSUME NEW K\0a              PROVE  TRUE\0a  <2>1. \\A K : TRUE\0a  <2>2. SUFFICES ASSUME NEW L\0a                 PROVE  TRUE\0a  <2>3. QED\0a<1>3a. DEFINE L == 0\0a<1>4.  K = 0      \\* 12 June 14 Changed from <*>4 which is now illegal.\0a  <2>1. DEFINE F == 7\0a  <2>4. TRUE   \\* 12 June 14 Changed from <*>4 which is now illegal.\0a  <2>2. QED\0a     BY <2>4\0a<1>4a. DEFINE F == 42\0a<1>5 QED\0a  BY <1>4\0aJ == 0\0aI == 0\0aF == 1\0a\0aASSUME PrintT("SANY2 Test")\0a\0a=============================\0a']]]
      ['suite/test212a' 'test212a' %accept ~[['test212a' '-------------------------- MODULE test212a -------------------------\0a\0aCONSTANT Op(_) , Op2(_,_) \0a\0a=============================================================================']]]
      ['suite/test212b' 'test212b' %accept ~[['test212b' '-------------------------- MODULE test212b -------------------------\0aVARIABLE y\0aNoArg == y\'\0aLeibniz(a4) == <<a4, y>>\0aLeibniz2(a44, a45) == <<a44, a45, y>>\0aNonLeibniz(a5) == ENABLED a5\0aNonLeibniz2(a6, a7) == {a6\', a7}\0a\0a=============================================================================\0a']]]
      ['suite/test213' 'test213' %reject ~[['test213' '------------------------------- MODULE test213 ------------------------------ \0a\\* Test that \0a\\* - A non-temporal theorem or proof step cannot have a\0a\\*   temporal formula in its proof.\0a\\* - A declared constant that appears in an ASSUME or an ASSUME/PROVE\0a\\*   cannot be instantiated with a temporal formula \0a\\*\0a\\* Parsing only; produces errors.\0a\0aVARIABLE x\0a\0aI1 == INSTANCE test213b WITH C <- x\', D <- x\' \0aI2 == INSTANCE test213b WITH C <- [](x=0), D <- TRUE \\* ERROR\0aI3 == INSTANCE test213b WITH C <- TRUE, D <- [](x=0) \\* ERROR\0a\0aTHEOREM [](x=0)\0a<1>1. CASE FALSE\0a  <2>1. [](x=0)\0a  <2>2. QED\0a    <3>1. [](x # 0)\0a      BY [](x # 0)\0a    <3>2. QED\0a<1>2. x=0        \\* ERROR\0a  <2>1. (x=0)   \0a  <2>2. QED\0a    <3>1. [](x=0)  \0a    <3>2. QED\0a<1>3. CASE TRUE\0a <2>1. CASE x=0  \\* ERROR\0a <2>1a. CASE FALSE\0a <2>2. HAVE x=0  \\* ERROR\0a <2>2a HAVE TRUE \0a <2>3. WITNESS 3 \\in x \\* ERROR\0a <2>4. WITNESS 2 \\in {}\0a <2>5. QED\0a<1>4. QED\0a  <2>1. [](x=0)\0a  <2>2. QED\0a \0a\0a\0aTHEOREM x=0  \\* ERROR\0a <1>1. x\'=0     \\* ERROR\0a   BY [](x=0)   \\* This BY causes an error, though it needn\'t \0a <1>2. [](x=0)  \\* this causes error in THEOREM\0a <1>3. QED\0a============================================================================='] ['test213b' '------------------------------ MODULE test213b ------------------------------ \0aCONSTANT C, D\0aASSUME C = {}\0a\0aTHEOREM ASSUME D\0a        PROVE  TRUE\0a=============================================================================\0a']]]
      ['suite/test213b' 'test213b' %accept ~[['test213b' '------------------------------ MODULE test213b ------------------------------ \0aCONSTANT C, D\0aASSUME C = {}\0a\0aTHEOREM ASSUME D\0a        PROVE  TRUE\0a=============================================================================\0a']]]
      ['suite/test214' 'test214' %reject ~[['test214' '------------------------------ MODULE test214 ------------------------------ \0a\\* Test that USE and HIDE cannot contain arbitrary expressions as \0a\\* facts.\0a\0aTHEOREM bar == <<1, 2>>\0a\0aUSE bar, bar!1 (*ERROR*)\0a         \0a\0aHIDE bar, TRUE (*ERROR*)\0a\0aTHEOREM xx == ASSUME TRUE PROVE FALSE \0a <1>2. USE TRUE (*ERROR*), bar , xx , xx!1 (*ERROR*)\0a <1>3. QED\0a\0a=============================================================================\0a']]]
      ['suite/test215' 'test215' %reject ~[['test215' '------------------------- MODULE test215 ------------------------- \0a\\* Test of constraints on levels of temporal operators that\0a\\* outlaw any form of raw TLA.\0a\0aVARIABLE x\0a\0aa == x ~> []x\0ab == x\' ~> []x    \\* ERROR\0ac == []x ~> x\'    \\* ERROR\0a\0ad == x -+-> []x\0ae == x\' -+-> []x  \\* ERROR\0af == []x -+-> x\'  \\* ERROR\0a\0ag == <><<x\'>>_x\0ah == <>(x\')       \\* ERROR\0a\0afoo == [][x\']_x\0a\0abar == [](x\')    \\* ERROR\0a\0am == \\A i \\in {}, j \\in x : []x\0an == \\A i \\in {}, j \\in x\' : []x   \\* ERROR\0a\0amm == \\E i \\in {}, j \\in x : []x\0ann == \\E i \\in {}, j \\in x\' : []x   \\* ERROR\0a\0am2 == \\A i \\in x\' : x\'\0a=======================================================================']]]
      ['suite/test216a' 'test216a' %accept ~[['test216a' '---------------------------- MODULE test216a ------------------------\0aEXTENDS Naturals\0aCONSTANT D\0a\0aASSUME Ass2 == D + 0 = 42 \0aTHEOREM Thm2 == D + 0 = 42\0aThm2Def == D + 0 = 42\0a\0aINSTANCE test216b WITH E <- D, y <- 0   \0a  \\* 12 June 2014: Changed from Test216b, which is now illegal\0aI == INSTANCE test216b WITH E <- D, y <- 0\0a  \\* 12 June 2014: Changed from Test216b, which is now illegal\0a\0a\0a====================================================================\0a'] ['test216b' '---------------------------- MODULE test216b ------------------------\0aCONSTANT E, y\0a\0aTHEOREM Thm3 == y \\in {y} /\\ E = 42\0a\0a\0a====================================================================\0a']]]
      ['suite/test216b' 'test216b' %accept ~[['test216b' '---------------------------- MODULE test216b ------------------------\0aCONSTANT E, y\0a\0aTHEOREM Thm3 == y \\in {y} /\\ E = 42\0a\0a\0a====================================================================\0a']]]
      ['suite/test216c' 'test216c' %accept ~[['test216c' '------------------ MODULE test216c ---------------------\0aEXTENDS Naturals\0aVARIABLE x\0a\0aInitC == x = 0\0aNextC == x\'=(x+1) %6\0a\0aSpecC == [][NextC]_x\0a\0aTHEOREM ThmC == SpecC => [](x \\in Nat)\0a\0aTHEOREM ThmC2 == [](x \\in Nat)\0a\0aTHEOREM ThmC3 == 1+1 = 2\0a======================================================']]]
      ['suite/test217' 'test217' %reject ~[['test217' 'Sany should produce two level errors when parsing this module.\0a\0a---- MODULE test217 ----\0a    \\* 12 June 2014: Changed module name from Test217, which is now illegal\0aEXTENDS test217a\0a    \\* 12 June 2014: Changed from Test217a, which is now illegal\0aVARIABLE x\0a\0aI(z) == INSTANCE test217a WITH y <- z\0a    \\* 12 June 2014: Changed from Test217a, which is now illegal\0a\0aFooBar == I(x\')!Foo\0aTHEOREM I({x\'})!Foo\0a==============================='] ['test217a' '---- MODULE test217a ----\0aVARIABLE y\0a\0aTHEOREM Foo == y\'=0\0a=========================']]]
      ['suite/test217a' 'test217a' %accept ~[['test217a' '---- MODULE test217a ----\0aVARIABLE y\0a\0aTHEOREM Foo == y\'=0\0a=========================']]]
      ['suite/test22' 'test22' %accept ~[['test22' '--------------- MODULE test22 -------------\0a\0a(* Test of fingerprinting. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x, y\0a\0aS == {1}\0aT == {2, 3, 4}\0a\0a\0a\0aInit ==  /\\ Print("Distinct States should equal Distinct Initial States", TRUE)\0a         /\\ x \\in [S -> [S -> SUBSET T]]\0a         /\\ y \\in [S -> [S -> SUBSET [a : {2}, b : {3, 4, 5}]]]\0a\0aInv == IF [S -> [S -> SUBSET [b : {4, 4, 3, 5, 4}, a : {2, 2}]]] # \0a               [S -> [S -> SUBSET [a : {2}, b : {3, 4, 5}]]]\0a          THEN Assert(FALSE, "Test 1 Failed")\0a          ELSE TRUE\0a\0aNext ==     \0a  \\/ UNCHANGED <<x, y>>\0a\0a  \\/ /\\ x\' \\in [S -> [S -> SUBSET {4, 4, 4, 3, 2, 2}]]\0a     /\\ UNCHANGED y\0a\0a  \\/ /\\ y\' \\in [S -> [S -> SUBSET [b : {4, 4, 3, 5, 4}, a : {2, 2}]]]\0a     /\\ UNCHANGED x\0a\0a  \\/ /\\ y\' = [y EXCEPT ![1][1] = {[b |-> 4, a |-> 2]}]\0a     /\\ UNCHANGED x\0a\0a  \\/ /\\ y\' = [y EXCEPT ![1][1] = {[b |-> 3, a |-> 2]}]\0a     /\\ UNCHANGED x\0a\0a  \\/ /\\ y\' = [y EXCEPT ![1][1] = {[b |-> 5, a |-> 2]}]\0a     /\\ UNCHANGED x\0a=========================================\0a']]]
      ['suite/test220' 'test220' %accept ~[['test220' '--------------- MODULE test220  -------------\0a\0a(* Testing deadlock and number of states found. *)\0a\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aASSUME TLCGet("config").deadlock = FALSE\0a\0aVARIABLE x, y, z\0a\0aInit == /\\ Print("This test should not deadlock when configured with CHECK_DEADLOCK=FALSE", TRUE)\0a        /\\ x = {}\0a        /\\ y = {}\0a        /\\ z = 1\0a\0aNext == /\\ x = {}\0a        /\\ x\' = {1}        \0a        /\\ y\' \\in SUBSET x\'\0a        /\\ z\' = z\0a        /\\ y\' = {}\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test25' 'test25' %accept ~[['test25' '---------------------- MODULE test25 ----------------------\0a\0a(* test of fingerprinting elements of [S -> [B -> C]]  *)\0a\0aEXTENDS Naturals, Sequences, TLC\0a\0aCONSTANT S, T, s1, t1, c\0a\0aVARIABLES x, y, z, w\0a\0aInit ==  /\\ Print("Should find only one state", TRUE)\0a         /\\ x = [i \\in 1..3 |-> [j \\in {4,5} |-> i+j]]\0a         /\\ y = [a |-> <<"b", "c">>, b |-> <<"c", "d", "e">>]\0a         /\\ z = [i \\in S |-> [j \\in {2,3} |-> j+1]]\0a         /\\ w = [i \\in S |-> [j \\in T |-> c]]\0a\0aInv == TRUE\0a\0aNext == \0a  \\/ UNCHANGED <<x, y, z, w>>\0a\0a  \\/ /\\ x\' = << [j \\in {4,5} |-> 1+j], [j \\in {4,5} |-> 2+j], [j \\in {4,5} |-> 3+j]>>\0a     /\\ y\' = [i \\in {"a", "b"} |->\0a               IF i = "a" THEN [j \\in {1,2} |-> IF j = 1 THEN "b" ELSE "c"]\0a                          ELSE [<<"x", "d", "e">> EXCEPT ![1]= "c"]]\0a     /\\ z\' = [[z EXCEPT ![s1] = [@ EXCEPT ![3] = 77]] EXCEPT ![s1][3] = 4]\0a     /\\ w\' = [[w EXCEPT ![s1][t1] = s1] EXCEPT ![s1][t1] = c]\0a      \0a\0a===========================================================\0a']]]
      ['suite/test26' 'test26' %accept ~[['test26' '--------------- MODULE test26 -------------\0a\0a(* Test of LET *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0a\0aInit ==  x = 0\0a\0aFcnSubst(f, e(_)) ==\0a  (* A recursive definition of [i \\in DOMAIN f |-> e(i)] *)\0a  LET Range == {f[i] : i \\in DOMAIN f}\0a      FSet == UNION { [U -> Range] : U \\in SUBSET DOMAIN f}\0a      FSub[g \\in FSet] == \0a        IF g = << >> \0a          THEN g\0a          ELSE LET el == CHOOSE el \\in DOMAIN g : TRUE\0a               IN  [ i \\in DOMAIN g |-> \0a                     IF i = el \0a                      THEN e(i)\0a                      ELSE FSub[[j \\in (DOMAIN g) \\ {el} |-> f[j]]][i]]\0a  IN FSub[f]\0a\0a\0aInv == \0a\0a  /\\ LET A == {}\0a         B == A\0a     IN  IF B = {}\0a           THEN Print("Test 1 OK", TRUE)\0a           ELSE Assert(FALSE, "Test 1 Failed")\0a\0a  /\\ LET A == {}\0a         B == A\0a         C[i \\in B] == 17\0a     IN  IF C = << >> \0a           THEN Print("Test 2 OK", TRUE)\0a           ELSE Assert(FALSE, "Test 2 Failed")\0a\0a  /\\ LET e(i) == i+1\0a     IN  IF FcnSubst(<<1,2,3>>, e) = <<2,3,4>>\0a           THEN Print("Test 3 OK", TRUE)\0a           ELSE Assert(FALSE, "Test 3 Failed")\0a           \0aNext ==  UNCHANGED x\0a=========================================\0a']]]
      ['suite/test28' 'test28' %accept ~[['test28' '--------------- MODULE test28  -------------\0a\\* Some random test\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0a\0aBdedSeq(S, n) == UNION {[1..i -> S] : i \\in 0..n}\0a\0aInit == /\\ x = 2\0a        /\\ x > 1 \0a        /\\ Print("Test 1 OK", TRUE)\0a        /\\ 1..x = {1,2}\0a        /\\ Print("Test 2 OK", TRUE)\0a        /\\ {i + 1 : i \\in {x}} = {3}\0a        /\\ Print("Test 3 OK", TRUE)\0a        /\\ {i \\in {x} : i = 2} = {2}\0a        /\\ Print("Test 4 OK", TRUE)\0a        /\\ \\E i \\in {x} : i = 2\0a        /\\ Print("Test 5 OK", TRUE)\0a        /\\ \\E i \\in 1..x : i < x\0a        /\\ Print("Test 6 OK", TRUE)\0a        /\\ IF BdedSeq({x}, 2) # {<<>>, <<2>>, <<2,2>>}\0a             THEN Print("Failed Test 7", TRUE)\0a             ELSE Print("Test 7 OK", TRUE)\0a\0aNext == UNCHANGED x\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test29' 'test29' %accept ~[['test29' '--------------- MODULE test29  -------------\0a\0a\\* Testing proper evaluation of primed variables in action\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0a\0a\0aInit == x = 2\0a\0aNext == /\\ x\' = 2\0a        /\\ x\' > 1 \0a        /\\ Print("Test 1 OK", TRUE)\0a        /\\ 1..x\' = {1,2}\0a        /\\ Print("Test 2 OK", TRUE)\0a        /\\ {i + 1 : i \\in {x\'}} = {3}\0a        /\\ Print("Test 3 OK", TRUE)\0a        /\\ {i \\in {x\'} : i = 2} = {2}\0a        /\\ Print("Test 4 OK", TRUE)\0a        /\\ \\E i \\in {x\'} : i = 2\0a        /\\ Print("Test 5 OK", TRUE)\0a        /\\ \\E i \\in 1..x\' : i < x\'\0a        /\\ Print("Test 6 OK", TRUE)\0a\0a\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test30-true' 'test30-true' %reject ~[['test30-true' '--------------- MODULE test31  -------------\0a\0a(* Test replacement of and by infix operators and overridden operators. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0a\0aCONSTANT P(_,_), _++_ , Plus(_, _), PLen(_)\0a\0aPlusPlus(a, b) == <<a, b>>\0a\0aPRep(a, b) == {a, b}\0a\0aMCSeq(a) = {a}\0a\0aMCCat(a, b) == a + b\0a\0aInit == /\\ x = 1\0a        /\\ IF P(2, x+3) = {2, 4}\0a             THEN Print("Test 1 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 1 Failed")\0a        /\\ IF (2++(x+3)) = <<2, 4>>\0a             THEN Print("Test 2 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 2 Failed")\0a        /\\ IF PLen(<<1, 2, 3>>) = 3\0a             THEN Print("Test 3 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 3 Failed")\0a        /\\ IF Plus(2, x+3) = 6\0a             THEN Print("Test 4 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 4 Failed")\0a        /\\ IF Seq(22) = {22}\0a             THEN Print("Test 5 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 5 Failed")\0a        /\\ IF 1 \\o 2 = 3                          (* Huh???? *)\0a             THEN Print("Test 6 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 6 Failed")\0a        /\\ LET a \\prec b == a < b\0a           IN  IF 1 \\prec 2\0a                 THEN Print("Test 7 OK", TRUE)\0a                 ELSE Assert(FALSE, "Test 7 Failed")\0a\0aNext == UNCHANGED x\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test30' 'test30' %accept ~[['test30' '--------------- MODULE test30  -------------\0a\0a(* Test replacement of and by infix operators and overridden operators. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0a\0aCONSTANT P(_,_), _++_ , Plus(_, _), PLen(_)\0a\0aPlusPlus(a, b) == <<a, b>>\0a\0aPRep(a, b) == {a, b}\0a\0aMCSeq(a) == {a}\0a\0aMCCat(a, b) == a + b\0a\0aInit == /\\ x = 1\0a        /\\ IF P(2, x+3) = {2, 4}\0a             THEN Print("Test 1 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 1 Failed")\0a        /\\ IF (2++(x+3)) = <<2, 4>>\0a             THEN Print("Test 2 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 2 Failed")\0a        /\\ IF PLen(<<1, 2, 3>>) = 3\0a             THEN Print("Test 3 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 3 Failed")\0a        /\\ IF Plus(2, x+3) = 6\0a             THEN Print("Test 4 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 4 Failed")\0a        /\\ IF Seq(22) = {22}\0a             THEN Print("Test 5 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 5 Failed")\0a        /\\ IF 1 \\o 2 = 3                          (* Huh???? *)\0a             THEN Print("Test 6 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 6 Failed")\0a        /\\ LET a \\prec b == a < b\0a           IN  IF 1 \\prec 2\0a                 THEN Print("Test 7 OK", TRUE)\0a                 ELSE Assert(FALSE, "Test 7 Failed")\0a\0aNext == UNCHANGED x\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test31' 'test31' %accept ~[['test31' '--------------- MODULE test31  -------------\0a\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aVARIABLE x, y\0a\0aInit == /\\ Print("This test should generate 3 distinct state", TRUE)\0a        /\\ x = 1\0a        /\\ y = 1\0a\0aNext == \\/ /\\ Print("1", TRUE)\0a           /\\ x\' \\in {1, 2, 3}\0a           /\\ y\' = 1\0a           /\\ Print(<<"Generated state", x\', y\'>>, TRUE)\0a\0a        \\/ UNCHANGED <<x, y>>\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test32' 'test32' %accept ~[['test32' '--------------- MODULE test32  -------------\0a\0a(* Test of [A]_e and <<A>>_e *)\0a\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aVARIABLE x, y\0a\0aInit == /\\ x = 1\0a        /\\ y = 1\0a\0aAct1 == /\\ x\' = 1\0a        /\\ y\' = 1\0a\0aNext == \\/ /\\ UNCHANGED <<x, y>>\0a           /\\ IF [x # x]_<<x,y>>\0a                THEN Print("Test1 OK", TRUE)\0a                ELSE Assert(FALSE, "Test 1 Failed") \0a           /\\ IF <<Act1>>_<<x,y>>\0a                THEN Assert(FALSE, "Test 2 Failed")\0a                ELSE Print("Test2 OK", TRUE)\0a\0a        \\/ /\\ <<x\'= 1 /\\ y\'=1>>_y\0a           /\\ Assert(FALSE, "Test 3 Failed")\0a\0a        \\/ /\\ Print("Test 4 started -- should finish", TRUE)\0a           /\\ [FALSE]_<<x,y>>\0a           /\\ Print("Test 4 completed" , TRUE)\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test33' 'test33' %accept ~[['test33' '--------------- MODULE test33  -------------\0a\0a(* Test of large sets of functions *)\0a\0aEXTENDS TLC, Naturals\0a\0aVARIABLE x\0a\0aInit == /\\ Print(<<"Computing", 7^6, "States">>, TRUE)\0a        /\\ x \\in [1..6 -> 1..7]   \0a\0aNext == UNCHANGED x\0a\0aInv ==  TRUE\0a=========================================\0a\0aWorks for 7^6 = 117649 states on dix in     43.049u   3.729s  1:16.97 60.7%  \0a                                           (1529 states/sec)\0aWorks for 6^7 = 279936 states on dix in    113.333u  19.494s  3:37.24 61.1%\0a                                           (1289 states/sec)\0aworks for 7^7 = 823543 states on rowdy in  655.835u 158.050s 11:03.11 122.7%\0a                                           (1242 states/sec)\0aDoesn\'t work for 7^7 = 823543 states on dix\0a']]]
      ['suite/test34' 'test34' %accept ~[['test34' '--------------- MODULE test34  -------------\0a\0a(* Test Model Values *)\0a\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aCONSTANTS a, b, c\0a\0aVARIABLE x\0a\0aInit == x = 1\0a\0aNext == UNCHANGED x\0a\0aInv ==  /\\ IF a \\in STRING THEN Assert(FALSE, "Test 1 failed")\0a                           ELSE Print("Test 1 OK", TRUE)\0a        /\\ IF a = {1, 2}   THEN Assert(FALSE, "Test 2 failed")\0a                           ELSE Print("Test 2 OK", TRUE)\0a        /\\ IF a \\in {i \\in Nat : i > 7} \0a             THEN Assert(FALSE, "Test 3 failed")\0a             ELSE Print("Test 3 OK", TRUE)\0a        /\\ IF a \\in {b, c} THEN Assert(FALSE, "Test 4 failed")\0a                           ELSE Print("Test 4 OK", TRUE)\0a\0a=========================================\0a']]]
      ['suite/test37' 'test37' %accept ~[['test37' '---------------------------- MODULE test37 -----------------------------\0a\0a(* Test of standard FiniteSets module *)\0a\0aEXTENDS FiniteSets, TLC\0a\0aVARIABLES x\0a\0aInit == x = 0\0aNext == x\'=x\0aInv  ==\0a       /\\ IF IsFiniteSet({"a", "b"})\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed")\0a\0a       /\\ IF IsFiniteSet({})\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed")\0a\0a       /\\ IF Cardinality({}) = 0\0a            THEN Print("Test 3 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")\0a\0a       /\\ IF Cardinality({"a", "b"}) = 2\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4 Failed")\0a\0a\0a=============================================================================\0a']]]
      ['suite/test38' 'test38' %accept ~[['test38' '---------------------------- MODULE test38 -----------------------------\0a\0a(* Test of EXTENDS *)\0a\0aEXTENDS test38a, TLC\0a\0aVARIABLES x\0a\\* CONSTANT c\0a\0aInit == MInit(x)\0aNext == x\'=c\0aInv  == IF (x=c) THEN Print("Test OK", TRUE)\0a                 ELSE Print("Test Failed", TRUE)\0a\0a\0a=============================================================================\0a'] ['test38a' '---------------------------- MODULE test38a -----------------------------\0a\0a(* Test of EXTENDS *)\0a\0a\\* VARIABLES x    multiple declarations no longer allowed.\0a CONSTANT c\0a\0aMInit(x) == x = c\0a\0a=============================================================================\0a']]]
  ==
::
++  test-sany-sub-3
  %+  expect-eq
    !>  ^-  (list @t)
    :~  'suite/test42 -> hoon=reject'  'suite/test52 -> hoon=reject'  'suite/test999 -> hoon=reject'
    ==
  !>
  %-  sub-batch-run
  ^-  (list [@t @t ?(%accept %reject) (list [@t @t])])
  :~
      ['suite/test38a' 'test38a' %accept ~[['test38a' '---------------------------- MODULE test38a -----------------------------\0a\0a(* Test of EXTENDS *)\0a\0a\\* VARIABLES x    multiple declarations no longer allowed.\0a CONSTANT c\0a\0aMInit(x) == x = c\0a\0a=============================================================================\0a']]]
      ['suite/test39' 'test39' %accept ~[['test39' '--------------- MODULE test39 -------------\0a\0a(* Test priming and operator arguments *)\0a\0aEXTENDS TLC, Integers, Sequences, FiniteSets\0a\0aVARIABLE x, y\0a\0aInit == /\\ x = [i \\in {1,2} |-> i]\0a        /\\ y = 1\0a\0aAction1(c,d) == c\' = [c EXCEPT ![1] = d\']\0aAction2(c,d) == c\' = [c EXCEPT ![1] = d]\0a\0a\0aNext ==  \\/ /\\ y = 1\0a            /\\ y\' = 2\0a            /\\ Action1(x, y)\0a            /\\ IF x[1]\' = 2\0a                 THEN Print("Test1 OK", TRUE)\0a                 ELSE Assert(FALSE, "Test1 Failed") \0a\0a         \\/ /\\ y = 1\0a            /\\ y\' = 2\0a            /\\ Action2(x, y)\0a            /\\ IF x[1]\' = 1\0a                 THEN Print("Test2 OK", TRUE)\0a                 ELSE Assert(FALSE, "Test2 Failed")\0a\0a         \\/ UNCHANGED <<x, y>>\0a\0aInv ==  TRUE\0a         \0a\0aConstraint == TRUE\0a=========================================\0a']]]
      ['suite/test42' 'test42' %accept ~[['test42' '--------------- MODULE test42 -------------\0a\0a(* Test of operator arguments  *)\0a\0aEXTENDS TLC, Integers, Sequences\0a\0aVARIABLE x\0a\0aa ++ b == a + b\0a\0aFoo(a, _--_) == a -- 0\0a\0a\0aInit == x = 1\0a\0a\0aNext ==  x\' = x\0a         \0aFooBar(a, Op(_,_)) == Op(a, 0)\0a\0aPlus(a, b) == a + b\0a\0aInv ==  /\\ IF FooBar(7, Plus) = 7\0a             THEN Print("Test 1 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 1 Failed")  \0a\0a        /\\ IF FooBar(7,+) = 7 \0a             THEN Print("Test 2 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 2 Failed")  \0a\0a        /\\ IF Foo(7, *) = 0 \0a             THEN Print("Test 3 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 3 Failed")  \0a\0a        /\\ IF Foo(7,+) = 7 \0a             THEN Print("Test 4 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 4 Failed")  \0a\0a        /\\ IF Foo(7,++) = 7 \0a             THEN Print("Test 5 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 5 Failed")  \0a\0aConstraint == TRUE\0a=========================================\0a']]]
      ['suite/test47' 'test47' %accept ~[['test47' '------- MODULE test47 -----\0a\0a\\* Checks EXTENDing of both Naturals and Integers\0a\0aEXTENDS test47a , Integers \0a\0aInit == x = -1\0a\0aNext == x\'= IF x = -3 THEN x ELSE x - 1\0a\0aInv == TRUE\0a==========================\0a'] ['test47a' '------------- MODULE test47a  --------------\0a\0aEXTENDS Naturals, TLC\0a\0a\0aVARIABLE x\0a=============================================\0a']]]
      ['suite/test47a' 'test47a' %accept ~[['test47a' '------------- MODULE test47a  --------------\0a\0aEXTENDS Naturals, TLC\0a\0a\0aVARIABLE x\0a=============================================\0a']]]
      ['suite/test49' 'test49' %accept ~[['test49' '--------------- MODULE test49 -------------\0a\0a(* test definability of operators with aliases *)\0a\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0au (+) v == u\0au (-) v == u\0au (.) v == u\0au (/) v == u\0au (\\X) v == u \0au \\o v == u\0au % v == u\0au \\leq  v == u\0au \\geq v == u\0a\0a\0aInit == \0a /\\ x = 0\0a\0aNext ==\0a   /\\ x = 0\0a   /\\ \0a      \\/ x\' = x (+) 1    \0a      \\/ x\' = x (-) 1    \0a      \\/ x\' = x (.) 1    \0a      \\/ x\' = x (/) 1    \0a      \\/ x\' = x (\\X) 1   \0a      \\/ x\' = x \\o 1 \0a      \\/ x\' = x % 1 \0a      \\/ x\' = (x \\leq  1) \0a      \\/ x\' = (x \\geq 1 ) \0a=======================================\0a']]]
      ['suite/test49a' 'test49a' %accept ~[['test49a' '--------------- MODULE test49a -------------\0a\0a(* test definability of operators with aliases *)\0a\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0au (+) v == u\0au (-) v == u\0au (.) v == u\0au (/) v == u\0au (\\X) v == u \\* parser can\'t cope with this\0au \\o v == u\0au % v == u\0au \\leq  v == u\0au \\geq v == u\0a\0a\0aInit == \0a /\\ x = 0\0a /\\ Print("******************************************************", TRUE)\0a /\\ Print("Several tests have been commented out because of bugs.", TRUE)\0a /\\ Print("******************************************************", TRUE)\0a\0aNext ==\0a   /\\ x = 0\0a   /\\ \0a      \\/ x\' = x (+) 1    \\* caused TLC bug\0a      \\/ x\' = x (-) 1    \\* caused TLC bug\0a      \\/ x\' = x (.) 1    \\* caused TLC bug\0a      \\/ x\' = x (/) 1    \\* caused TLC bug\0a      \\/ x\' = x (\\X) 1   \\* parser can\'t cope with this.\0a      \\/ x\' = x \\o 1 \0a      \\/ x\' = x % 1 \0a      \\/ x\' = (x \\leq  1) \0a      \\/ x\' = (x \\geq 1 ) \0a=======================================\0a']]]
      ['suite/test49b' 'test49b' %reject ~[['test49b' '--------------- MODULE test49b -------------\0a\0a(* test definability of operators with aliases *)\0a\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0au \\oplus v == u\0au \\ominus v == u\0au \\odot v == u\0au \\oslash v == u\0au \\otimes v == u \0au \\circ v == u\0au \\mod v == u\0au =<  v == u\0au >= v == u\0a\0a\0aInit == \0a /\\ x = 0\0a /\\ Print("******************************************************", TRUE)\0a /\\ Print("Several tests have been commented out because of bugs.", TRUE)\0a /\\ Print("******************************************************", TRUE)\0a\0aNext ==\0a   /\\ x = 0\0a   /\\ \0a      \\/ x\' = x \\oplus 1  \0a      \\/ x\' = x \\ominus 1  \0a      \\/ x\' = x \\odot 1  \0a      \\/ x\' = x \\oslash 1  \0a      \\/ x\' = x \\otimes 1 \0a\\*      \\/ x\' = x \\circ 1 \0a\\*      \\/ x\' = x \\mod 1   \\* causes TLC bug\0a\\*      \\/ x\' = (x =<  1)  \\* causes TLC bug \0a\\*      \\/ x\' = (x >= 1 )  \\* causes TLC bug \0a=======================================\0a']]]
      ['suite/test49c' 'test49c' %reject ~[['test49c' '--------------- MODULE test49c -------------\0a\0a(* test definability of operators with aliases *)\0a\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0au \\oplus v == u\0au \\ominus v == u\0au \\odot v == u\0au \\oslash v == u\0au \\otimes v == u \0au \\o v == u\0au \\mod v == u\0au =<  v == u\0au >= v == u\0a\0a\0aInit == \0a /\\ x = 0\0a /\\ Print("*************************************************************", TRUE)\0a /\\ Print("Almost all the tests have been commented out because of bugs.", TRUE)\0a /\\ Print("*************************************************************", TRUE)\0a\0aNext ==\0a   /\\ x = 0\0a   /\\ \0a\\*      \\/ x\' = x (+) 1     \\* causes TLC bug\0a\\*      \\/ x\' = x (-) 1     \\* causes TLC bug\0a\\*      \\/ x\' = x (.) 1     \\* causes TLC bug\0a\\*      \\/ x\' = x (/) 1     \\* causes TLC bug\0a\\*      \\/ x\' = x (\\X) 1  \\* parser can\'t handle this\0a\\*      \\/ x\' = x \\circ 1   \\* causes TLC bug\0a      \\/ x\' = x % 1   \0a\\*      \\/ x\' = (x =<  1)  \\* TLC bug : sets x\' to TRUE\0a\\*      \\/ x\' = (x >= 1 )    \\* TLC bug : sets x\' to FALSE\0a=======================================\0a']]]
      ['suite/test50' 'test50' %accept ~[['test50' '--------------- MODULE test50 -------------\0a\0a(* test usability of the following aliases with the standard modules:\0a   <=  and >=  of Naturals\0a   \\circ of Sequences\0a   (+) and (-) of Bags \0a\0a*)\0a\0a\0aEXTENDS Naturals, Sequences, Bags, TLC\0a\0aBag1 == SetToBag({"a", "b"})\0aBag2 == Bag1 \\oplus  SetToBag({"a"}) \\* causes TLC bug\0aBag3 == Bag2 \\ominus Bag1\0aBag2a == Bag1 (+) SetToBag({"a"})\0aBag3a == Bag2 (-) Bag1\0a\0a\0aVARIABLES x\0aInit == x = 0\0aNext == x\'=x\0a\0aInv == \0a       /\\ IF Bag2 = Bag2a\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed") \0a\0a       /\\ IF Bag3 = Bag3a\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed") \0a\0a       /\\ IF <<"a">> \\o <<"b">> = <<"a">> \\circ <<"b">>\0a            THEN Print("Test 3 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")  \0a    \0a       /\\ IF 1 \\leq 2\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4  Failed") \0a\0a       /\\ IF 1 <= 2\0a            THEN Print("Test 5 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 5  Failed") \0a    \0a       /\\ IF 2 \\geq 1 \0a            THEN Print("Test 6 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 6  Failed") \0a\0a       /\\ IF 2 >= 1 \0a            THEN Print("Test 7 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 7  Failed") \0a\0a=======================================\0a']]]
      ['suite/test51a' 'test51a' %accept ~[['test51a' '------------------- MODULE test51a -------------------------\0a\0a\\* Test definability of some aliases\0a\0aa =< b == {a, b}\0aa >=b == {a, b}\0aa \\circ b == {a, b}\0aa \\oplus b == {a, b}\0aa \\ominus b == {a, b}\0aa \\otimes b == {a, b}\0aa \\oslash b == {a, b}\0aa \\odot b == {a, b}\0a=============================================================================\0a']]]
