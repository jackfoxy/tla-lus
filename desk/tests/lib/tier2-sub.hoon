      ['symmetry/April20bMC' 'April20bMC' %accept ~[['April20bMC' '---- MODULE April20bMC ----\0aEXTENDS April20b, TLC\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0am1, m2\0a----\0a\0a\\* MV CONSTANT definitions S\0aconst_146115906599338000 == \0a{m1, m2}\0a----\0a\0a\\* SYMMETRY definition\0asymm_146115906600339000 == \0aPermutations(const_146115906599338000)\0a----\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_146115906601340000 ==\0aSpec\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_146115906602341000 ==\0aLive\0a----\0a\\* NEGATED PROPERTY definition\0aneg_prop_146115906602341000 ==\0a~(Live)\0a----\0a\0aYReturnsToZero == <>(y = 0)\0a\0aTautology == (vars = vars) ~> (vars = vars)\0a=============================================================================\0a'] ['April20b' '----------------------------- MODULE April20b -----------------------------\0aEXTENDS Integers, Sequences\0a\0aCONSTANT S\0a\0aVARIABLE x, y\0avars == <<x, y>>\0a\0aInit == (x = << >>) /\\ (y=0)\0a\0aNext == \\/ /\\ y=0\0a           /\\ y\'=1\0a           /\\ \\E s \\in S : x\' = <<s>>\0a        \\/ /\\ y=1\0a           /\\ y\'=2\0a           /\\ \\E s \\in S \\ {x[1]} : x\' = Append(x, s) \0a        \\/ /\\ y = 2\0a           /\\ y\'=0\0a           /\\ x\' = << >>\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aLive == ~ \\A i \\in S : \\E j \\in S \\ {i} : []<>(x = <<i, j>>)\0a=============================================================================\0a']]]
