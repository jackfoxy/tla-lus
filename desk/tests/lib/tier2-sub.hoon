      ['suite/test52' 'test52' %accept ~[['test52' '----------------------   MODULE test52 -----------------------\0a\0a\\* Test of prefix and postfix operators as arguments\0a\0aEXTENDS TLC\0a\0aVARIABLES x, y\0a\0aBoxTest(-._) == -(x=0)\0aFoo1 == BoxTest([])\0aFoo2 == BoxTest(<>)\0a\0a-. a == {{"a"}, {"b"}} \\ a\0aa ^+  == {{"a"}, {"b"}} \\ a\0aa ^*  == {{"a"}, {"b"}} \\ a\0aa ^#  == {{"a"}, {"b"}} \\ a\0a\0aSetOpTest(Foo(_)) == Foo({{"b"}, {"c"}})\0aDomainTest(Foo(_)) == Foo([i\\in {"a", "b"} |-> i])\0a\0aASSUME\0a  /\\ Print("Test1 Begun", TRUE)\0a  /\\ SetOpTest(-.) =  - {{"b"}, {"c"}}\0a  /\\ SetOpTest(^+) =   {{"b"}, {"c"}} ^+\0a  /\\ SetOpTest(^*) =   {{"b"}, {"c"}} ^*\0a  /\\ SetOpTest(^#) =   {{"b"}, {"c"}} ^#\0a  /\\ SetOpTest(SUBSET) = SUBSET {{"b"}, {"c"}}\0a  /\\ SetOpTest(UNION) = UNION {{"b"}, {"c"}}\0a  /\\ DomainTest(DOMAIN) = DOMAIN [i\\in {"a", "b"} |-> i]\0a  /\\ Print("Test1 Finished", TRUE)\0a\0a\0aInit == /\\ x = {"a"}\0a        /\\ y = {"a"}\0aNext == /\\ x\'= x \\cup {"a"}\0a        /\\ y\'= y \\cup {"b"}\0aSpec == Init /\\ [][Next]_<<x, y>>\0a\0aEnabledTest(Foo(_)) == Foo(x\'=x)\0aUnchangedTest(Foo(_)) == Foo(x)\0aPrimeTest(Foo(_)) == Foo(x) = x\0a\0aInvariant ==\0a /\\ EnabledTest(ENABLED)\0a\0aImpliedAction ==\0a /\\ UnchangedTest(UNCHANGED)\0a /\\ PrimeTest(\')\0a\0aProperty == [][ImpliedAction]_<<x, y>>\0a\0a==================================================================\0a\\* Prefix Operators\0a~\0aENABLED\0aUNCHANGED\0a[]\0a<>\0aSUBSET\0aUNION\0aDOMAIN\0a-\0a\0a\\* Postfix Operators\0a\\* Predefined\0a\'\0a\0a\\* Undefined\0a^+\0a^*\0a^#\0a']]]
      ['suite/test53' 'test53' %accept ~[['test53' '--------------- MODULE test53 -------------\0a\0a(* test definability of operators with aliases *)\0a\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0au \\oplus v == u\0au \\ominus v == u\0au \\odot v == u\0au \\oslash v == u\0au \\otimes v == u \0au \\circ v == u\0au % v == u\0au =<  v == u\0au >= v == u\0a\0a\0aInit == \0a /\\ x = 0\0a\0aNext ==\0a   /\\ x = 0\0a   /\\ \0a      \\/ x\' = x \\oplus 1  \0a      \\/ x\' = x \\ominus 1  \0a      \\/ x\' = x \\odot 1  \0a      \\/ x\' = x \\oslash 1  \0a      \\/ x\' = x \\otimes 1 \0a      \\/ x\' = x \\circ 1 \0a      \\/ x\' = x % 1   \\* causes TLC bug\0a      \\/ x\' = (x =<  1)  \\* causes TLC bug \0a      \\/ x\' = (x >= 1 )  \\* causes TLC bug \0a=======================================\0a']]]
