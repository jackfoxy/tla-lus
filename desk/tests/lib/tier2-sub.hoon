d")\0a  /\\ IF TestTLCOps(:>, @@) =  1 :> "ab" @@ 2 :> "cd"\0a       THEN Print("Test 78 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 78 Failed")\0a  /\\ IF TestDefinedBooleanOp(=>) = (TRUE => FALSE)\0a       THEN Print("Test 79 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 79 Failed")\0a  /\\ IF TestDefinedBooleanOp(\\equiv) = (TRUE \\equiv FALSE)\0a       THEN Print("Test 80 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 80 Failed")\0a  /\\ IF TestDefinedBooleanOp(<=>) = (TRUE <=> FALSE)\0a       THEN Print("Test 81 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 81 Failed")\0a\\*  /\\ Print("Test 82 fails because of parser bug", TRUE)\0a  /\\ IF TestDefinedBooleanOp(/\\) = (TRUE /\\ FALSE)\0a       THEN Print("Test 82 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 82 Failed")\0a  /\\ IF TestDefinedBooleanOp(\\land) = (TRUE \\land FALSE)\0a       THEN Print("Test 83 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 83 Failed")\0a\\*  /\\ Print("Test 84 fails because of parser bug", TRUE)\0a  /\\ IF TestDefinedBooleanOp(\\/) = (TRUE \\/ FALSE)\0a       THEN Print("Test 84 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 84 Failed")\0a  /\\ IF TestDefinedBooleanOp(\\lor) = (TRUE \\lor FALSE)\0a       THEN Print("Test 85 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 85 Failed")\0a  /\\ IF TestDefinedSetOp(#) = ({"a", "b"} # {"b", "c"})\0a       THEN Print("Test 86 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 86 Failed")\0a  /\\ IF TestDefinedSetOp(/=) = ({"a", "b"} /= {"b", "c"})\0a       THEN Print("Test 87 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 87 Failed")\0a  /\\ IF TestIn(\\in) = ("a"\\in {"b", "c"})\0a       THEN Print("Test 88 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 88 Failed")\0a  /\\ IF TestIn(\\notin) = ("a" \\notin {"b", "c"})\0a       THEN Print("Test 89 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 89 Failed")\0a  /\\ IF TestDefinedSetOp(\\subseteq) = ({"a", "b"} \\subseteq {"b", "c"})\0a       THEN Print("Test 90 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 90 Failed")\0a  /\\ IF TestDefinedSetOp(\\) = ({"a", "b"} \\ {"b", "c"})\0a       THEN Print("Test 91 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 91 Failed")\0a  /\\ IF TestDefinedSetOp(\\cap) = ({"a", "b"} \\cap {"b", "c"})\0a       THEN Print("Test 92 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 92 Failed")\0a  /\\ IF TestDefinedSetOp(\\intersect) = ({"a", "b"} \\intersect {"b", "c"})\0a       THEN Print("Test 93 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 93 Failed")\0a  /\\ IF TestDefinedSetOp(\\cup) = ({"a", "b"} \\cup {"b", "c"})\0a       THEN Print("Test 94 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 94 Failed")\0a  /\\ IF TestDefinedSetOp(\\union) = ({"a", "b"} \\union {"b", "c"})\0a       THEN Print("Test 95 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 95 Failed")\0a\0a\0a==============================================================\0a78\0aALL UNDEFINED INFIX OPERATORS\0a\0a+ \0a- \0a* \0a/ \0a..\0a< \0a> \0a\\leq \0a=<\0a<=\0a\\geq \0a>=\0a% \0a^\0a\\circ \0a\\o\0a++ \0a\\div \0a...\0a-- \0a\\oplus \0a(+)\0a\\ominus \0a(-)\0a\\otimes \0a(\\X)\0a\\oslash \0a(/)\0a\\odot \0a(.)\0a** \0a\\sqcap \0a// \0a\\prec \0a\\succ \0a\\preceq \0a\\succeq \0a\\sqcup \0a^^\0a\\ll \0a\\gg \0a<: \0a& \0a&& \0a\\sqsubset \0a\\sqsupset \0a\\sqsubseteq \0a\\sqsupseteq \0a| \0a|| \0a\\subset \0a\\supset \0a\\supseteq \0a\\star \0a%% \0a|- \0a-|\0a|= \0a=|\0a\\bullet \0a##\0a\\sim \0a\\simeq \0a\\approx \0a\\cong \0a$\0a$$\0a:= \0a::= \0a\\asymp \0a\\doteq \0a?? \0a!! \0a\\propto \0a\\wr \0a\\uplus \0a\\bigcirc \0a\0a\0aBUILT-IN BOOLEANS\0a=>\0a\\equiv\0a<=>\0a/\\\0a\\land\0a\\/\0a\\lor\0a\0aBUILT-IN SET OPERATORS\0a#\0a/=\0a\\in\0a\\notin\0a\\subseteq\0a\\\0a\\cap\0a\\intersect\0a\\cup\0a\\union\0a\0aOTHER\0a\0a-+->\0a~>\0a\\cdot\0a'] ['test51b' '---------------- MODULE test51b -----------------\0aa <= b == {a, b}\0a\0a==================================================================\0a'] ['test51a' '------------------- MODULE test51a -------------------------\0a\0a\\* Test definability of some aliases\0a\0aa =< b == {a, b}\0aa >=b == {a, b}\0aa \\circ b == {a, b}\0aa \\oplus b == {a, b}\0aa \\ominus b == {a, b}\0aa \\otimes b == {a, b}\0aa \\oslash b == {a, b}\0aa \\odot b == {a, b}\0a=============================================================================\0a']]]
