      ['EWD840/EWD840' 'EWD840' %accept ~[['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor \\in Color\0a\0a(* Initially the token is at node 0, and it is black. There\0a   are no constraints on the status and color of the nodes. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos = 0\0a  /\\ tcolor = "black"\0a\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i]\0a        \\/ color[i] = "black"\0a        \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0aNext ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a  \\/ \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0aSystem ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aFairness == WF_vars(System)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aLInv == [][Next]_vars => WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0aNeverBlack == \\A i \\in Nodes : color[i] # "black"\0a\0aNeverChangeColor == [][ \\A i \\in Nodes : UNCHANGED color[i] ]_vars\0a\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a  /\\ color[1] = "white"\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0aLiveness ==\0a  /\\ (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0aAllNodesTerminateIfNoMessages ==\0a  <>[][~ \\E i \\in Nodes : SendMsg(i)]_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a=============================================================================\0a']]]
      ['EWD840/Error02' 'Error02' %accept ~[['Error02' '---- CONFIG Error02 ----\0aCONSTANT\0aN = 2\0aSPECIFICATION SillySpec\0aCONSTRAINT StateConstraint\0aACTION_CONSTRAINT ActionConstraint\0aPROPERTIES Liveness\0aINVARIANT Inv\0a========================\0a---- MODULE Error02 ----\0aEXTENDS EWD840, TLC, Sequences\0a\0aSillySpec ==\0a    Spec /\\ 42 = "abc" \\* Silly expression as the level of the behavior spec.\0a\0aStateConstraint ==\0a    \\* For the tests to be interesting, this triggers the evaluation \0a    \\* of a Java module override in one of TLC\'s standard modules that\0a    \\* accesses a variable (the state) and involves EvalControl.\0a    \\* Since we don\'t care about constraining the state space, this is\0a    \\* a tautology.\0a    SelectSeq([i \\in 1..N+1 |-> i - 1], LAMBDA node: node = "abc" ) = <<tpos>>\0a\0aActionConstraint ==\0a    LET foo(vv) == SelectSeq([i \\in 1..N+1 |-> i - 1], LAMBDA node: node = vv )\0a    IN \\/ foo("abc") = <<tpos>>\'\0a       \\/ foo("abc") # <<tpos\'>>\0a    \0a=============================================================================\0a'] ['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor \\in Color\0a\0a(* Initially the token is at node 0, and it is black. There\0a   are no constraints on the status and color of the nodes. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos = 0\0a  /\\ tcolor = "black"\0a\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i]\0a        \\/ color[i] = "black"\0a        \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0aNext ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a  \\/ \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0aSystem ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aFairness == WF_vars(System)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aLInv == [][Next]_vars => WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0aNeverBlack == \\A i \\in Nodes : color[i] # "black"\0a\0aNeverChangeColor == [][ \\A i \\in Nodes : UNCHANGED color[i] ]_vars\0a\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a  /\\ color[1] = "white"\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0aLiveness ==\0a  /\\ (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0aAllNodesTerminateIfNoMessages ==\0a  <>[][~ \\E i \\in Nodes : SendMsg(i)]_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a=============================================================================\0a']]]
      ['EWD840/Error03' 'Error03' %accept ~[['Error03' '---- CONFIG Error03 ----\0aCONSTANT\0aN = 2\0aSPECIFICATION Spec\0aACTION_CONSTRAINT ActionConstraint\0aPROPERTIES Liveness\0aINVARIANT Inv\0a========================\0a---- MODULE Error03 ----\0aEXTENDS EWD840, TLC, Sequences\0a\0aActionConstraint ==\0a    LET foo(vv) == SelectSeq([i \\in 1..N+1 |-> i - 1], LAMBDA node: node = vv )\0a    IN \\/ foo("abc") = <<tpos>>\'\0a       \\/ foo("abc") # <<tpos\'>>\0a    \0a=============================================================================\0a'] ['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor \\in Color\0a\0a(* Initially the token is at node 0, and it is black. There\0a   are no constraints on the status and color of the nodes. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos = 0\0a  /\\ tcolor = "black"\0a\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i]\0a        \\/ color[i] = "black"\0a        \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0aNext ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a  \\/ \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0aSystem ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aFairness == WF_vars(System)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aLInv == [][Next]_vars => WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0aNeverBlack == \\A i \\in Nodes : color[i] # "black"\0a\0aNeverChangeColor == [][ \\A i \\in Nodes : UNCHANGED color[i] ]_vars\0a\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a  /\\ color[1] = "white"\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0aLiveness ==\0a  /\\ (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0aAllNodesTerminateIfNoMessages ==\0a  <>[][~ \\E i \\in Nodes : SendMsg(i)]_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a=============================================================================\0a']]]
      ['EWD840/MC' 'MC' %accept ~[['MC' '---- MODULE MC ----\0aEXTENDS EWD840, TLC\0a\0a\\* CONSTANT definitions @modelParameterConstants:0N\0aconst_143073460396411000 == \0a10\0a----\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_143073460397412000 ==\0aSpec\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_143073460398413000 ==\0aLiveness\0a----\0a=============================================================================\0a\\* Modification History\0a\\* Created Mon May 04 12:16:43 CEST 2015 by markus\0a'] ['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor \\in Color\0a\0a(* Initially the token is at node 0, and it is black. There\0a   are no constraints on the status and color of the nodes. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos = 0\0a  /\\ tcolor = "black"\0a\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i]\0a        \\/ color[i] = "black"\0a        \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0aNext ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a  \\/ \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0aSystem ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aFairness == WF_vars(System)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aLInv == [][Next]_vars => WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0aNeverBlack == \\A i \\in Nodes : color[i] # "black"\0a\0aNeverChangeColor == [][ \\A i \\in Nodes : UNCHANGED color[i] ]_vars\0a\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a  /\\ color[1] = "white"\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0aLiveness ==\0a  /\\ (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0aAllNodesTerminateIfNoMessages ==\0a  <>[][~ \\E i \\in Nodes : SendMsg(i)]_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a=============================================================================\0a']]]
      ['EWD840/MC02' 'MC02' %accept ~[['MC02' '---- MODULE MC02 ----\0aEXTENDS EWD840, TLC, Sequences\0a\0aconst_143073460396411000 == \0a    2\0a\0aspec_143073460397412000 ==\0a    Spec /\\ ENABLED Next /\\ ENABLED (SelectSeq([i \\in 1..N+1 |-> i - 1], LAMBDA node: node = tpos ) = <<tpos>>)\0a\0aStateConstraint ==\0a    \\* For the tests to be interesting, this triggers the evaluation \0a    \\* of a Java module override in one of TLC\'s standard modules that\0a    \\* accesses a variable (the state) and involves EvalControl.\0a    \\* Since we don\'t care about constraining the state space, this is\0a    \\* a tautology.\0a    SelectSeq([i \\in 1..N+1 |-> i - 1], LAMBDA node: node = tpos ) = <<tpos>>\0a\0aActionConstraint ==\0a    LET foo == SelectSeq([i \\in 1..N+1 |-> i - 1], LAMBDA node: node = tpos )\0a    IN \\/ foo = <<tpos>>\'\0a       \\/ foo # <<tpos\'>>\0a\0a-----------------------------------------------------------------------------\0a\0aStop == TLCGet("distinct") < 38\0a\0aAlias ==\0a    [\0a         active |-> active,\0a         color |-> color,\0a         tpos |-> tpos,\0a         tcolor |-> tpos,\0a         enbld |-> ENABLED <<InitiateProbe>>_vars\0a    ]\0a    \0a=============================================================================\0a'] ['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor \\in Color\0a\0a(* Initially the token is at node 0, and it is black. There\0a   are no constraints on the status and color of the nodes. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos = 0\0a  /\\ tcolor = "black"\0a\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i]\0a        \\/ color[i] = "black"\0a        \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0aNext ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a  \\/ \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0aSystem ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aFairness == WF_vars(System)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aLInv == [][Next]_vars => WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0aNeverBlack == \\A i \\in Nodes : color[i] # "black"\0a\0aNeverChangeColor == [][ \\A i \\in Nodes : UNCHANGED color[i] ]_vars\0a\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a  /\\ color[1] = "white"\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0aLiveness ==\0a  /\\ (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0aAllNodesTerminateIfNoMessages ==\0a  <>[][~ \\E i \\in Nodes : SendMsg(i)]_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a=============================================================================\0a']]]
      ['EWD840/MC02Sim' 'MC02Sim' %accept ~[['MC02Sim' '---- MODULE MC02Sim ----\0aEXTENDS EWD840, TLC, Sequences\0a\0aconst_143073460396411000 == \0a    2\0a\0aspec_143073460397412000 ==\0a    Spec /\\ ENABLED Next /\\ ENABLED (SelectSeq([i \\in 1..N+1 |-> i - 1], LAMBDA node: node = tpos ) = <<tpos>>)\0a\0aStateConstraint ==\0a    \\* For the tests to be interesting, this triggers the evaluation \0a    \\* of a Java module override in one of TLC\'s standard modules that\0a    \\* accesses a variable (the state) and involves EvalControl.\0a    \\* Since we don\'t care about constraining the state space, this is\0a    \\* a tautology.\0a    SelectSeq([i \\in 1..N+1 |-> i - 1], LAMBDA node: node = tpos ) = <<tpos>>\0a\0aActionConstraint ==\0a    LET foo == SelectSeq([i \\in 1..N+1 |-> i - 1], LAMBDA node: node = tpos )\0a    IN \\/ foo = <<tpos>>\'\0a       \\/ foo # <<tpos\'>>\0a\0a-----------------------------------------------------------------------------\0a\0aStop == TLCGet("level") < 6\0a\0aAlias ==\0a    [\0a         active |-> active,\0a         color |-> color,\0a         tpos |-> tpos,\0a         tcolor |-> tpos,\0a         enbld |-> ENABLED <<InitiateProbe>>_vars\0a    ]\0a    \0a=============================================================================\0a'] ['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor \\in Color\0a\0a(* Initially the token is at node 0, and it is black. There\0a   are no constraints on the status and color of the nodes. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos = 0\0a  /\\ tcolor = "black"\0a\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i]\0a        \\/ color[i] = "black"\0a        \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0aNext ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a  \\/ \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0aSystem ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aFairness == WF_vars(System)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aLInv == [][Next]_vars => WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0aNeverBlack == \\A i \\in Nodes : color[i] # "black"\0a\0aNeverChangeColor == [][ \\A i \\in Nodes : UNCHANGED color[i] ]_vars\0a\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a  /\\ color[1] = "white"\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0aLiveness ==\0a  /\\ (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0aAllNodesTerminateIfNoMessages ==\0a  <>[][~ \\E i \\in Nodes : SendMsg(i)]_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a=============================================================================\0a']]]
      ['EWD840/MC03Sim' 'MC03Sim' %accept ~[['MC03Sim' '---- MODULE MC03Sim ----\0aEXTENDS EWD840, TLC, Sequences\0a\0aLevel ==\0a    TLCGet("level") < 15\0a\0aActionConstraint ==\0a    vars\' # vars\0a=============================================================================\0a'] ['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor \\in Color\0a\0a(* Initially the token is at node 0, and it is black. There\0a   are no constraints on the status and color of the nodes. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos = 0\0a  /\\ tcolor = "black"\0a\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i]\0a        \\/ color[i] = "black"\0a        \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0aNext ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a  \\/ \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0aSystem ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aFairness == WF_vars(System)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aLInv == [][Next]_vars => WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0aNeverBlack == \\A i \\in Nodes : color[i] # "black"\0a\0aNeverChangeColor == [][ \\A i \\in Nodes : UNCHANGED color[i] ]_vars\0a\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a  /\\ color[1] = "white"\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0aLiveness ==\0a  /\\ (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0aAllNodesTerminateIfNoMessages ==\0a  <>[][~ \\E i \\in Nodes : SendMsg(i)]_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a=============================================================================\0a']]]
      ['EWD840/MC06' 'MC06' %accept ~[['MC06' '---- MODULE MC06 ----\0aEXTENDS EWD840, TLC\0a\0a\\* CONSTANT definitions @modelParameterConstants:0N\0aconst_143073460396411000 == \0a7\0a----\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_143073460397412000 ==\0aSpec\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_143073460398413000 ==\0aLiveness\0a----\0a=============================================================================\0a'] ['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor \\in Color\0a\0a(* Initially the token is at node 0, and it is black. There\0a   are no constraints on the status and color of the nodes. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos = 0\0a  /\\ tcolor = "black"\0a\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i]\0a        \\/ color[i] = "black"\0a        \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0aNext ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a  \\/ \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0aSystem ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aFairness == WF_vars(System)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aLInv == [][Next]_vars => WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0aNeverBlack == \\A i \\in Nodes : color[i] # "black"\0a\0aNeverChangeColor == [][ \\A i \\in Nodes : UNCHANGED color[i] ]_vars\0a\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a  /\\ color[1] = "white"\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0aLiveness ==\0a  /\\ (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0aAllNodesTerminateIfNoMessages ==\0a  <>[][~ \\E i \\in Nodes : SendMsg(i)]_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a=============================================================================\0a']]]
      ['EWD998/Utils' 'Utils' %accept ~[['Utils' '------------------------------- MODULE Utils -------------------------------\0aEXTENDS Integers, Sequences, FiniteSets\0a\0a\\* This are mostly copy&pasted from various TLA+ community modules at:\0a\\* https://github.com/tlaplus/CommunityModules/modules\0a\0aReduce(op(_,_), fun, from, to, base) == \0a  (**************************************************************************)\0a  (* Reduce the elements in the range from..to of the function\'s co-domain. *)\0a  (**************************************************************************)\0a  LET reduced[i \\in from..to] ==\0a          IF i = from THEN op(base, fun[i])\0a          ELSE op(reduced[i - 1], fun[i])\0a  IN reduced[to]\0a\0asum(a, b) ==\0a  a + b\0a\0aContains(s, e) ==\0a  (**************************************************************************)\0a  (* TRUE iff the element e \\in ToSet(s).                                   *)\0a  (**************************************************************************)\0a  \\E i \\in 1..Len(s) : s[i] = e\0a  \0aRemoveAt(s, i) == \0a  (**************************************************************************)\0a  (* Replaces the element at position i shortening the length of s by one.  *)\0a  (**************************************************************************)\0a  SubSeq(s, 1, i-1) \\o SubSeq(s, i+1, Len(s))\0a\0aRange(f) ==\0a  { f[x] : x \\in DOMAIN f }\0a\0a\\* No support for RECURSIVE in PlusPy.\0aIsSimpleCycle(S, r) ==\0a  (* View r as a graph s.t. S is the graph\'s set of vertices and there \0a     exists an edge from s to t iff f[s] = t. IsFiniteSet(DOMAIN r). *)\0a  LET \0a   F[ i \\in 1..Cardinality(S) ] == \0a         IF i = 1 THEN << CHOOSE s \\in S : TRUE >>\0a         ELSE LET seq == F[i-1]\0a                  head == Head(seq)\0a              IN << r[head] >> \\o F[i-1]\0a  IN Range(F[Cardinality(S)]) = S\0a\0a=============================================================================\0a']]]
      ['Echo/Relation' 'Relation' %accept ~[['Relation' '----------------------------- MODULE Relation ------------------------------\0aEXTENDS Naturals, FiniteSets\0a\0a(***************************************************************************)\0a(* This module provides some basic operations on relations, represented    *)\0a(* as binary Boolean functions over some set S.                            *)\0a(***************************************************************************)\0a\0a(***************************************************************************)\0a(* Is the relation R reflexive over S?                                     *)\0a(***************************************************************************)\0aIsReflexive(R, S) == \\A x \\in S : R[x,x]\0a\0a(***************************************************************************)\0a(* Is the relation R irreflexive over set S?                               *)\0a(***************************************************************************)\0aIsIrreflexive(R, S) == \\A x \\in S : ~ R[x,x]\0a\0a(***************************************************************************)\0a(* Is the relation R symmetric over set S?                                 *)\0a(***************************************************************************)\0aIsSymmetric(R, S) == \\A x,y \\in S : R[x,y] <=> R[y,x]\0a\0a(***************************************************************************)\0a(* Is the relation R asymmetric over set S?                                *)\0a(***************************************************************************)\0aIsAsymmetric(R, S) == \\A x,y \\in S : ~(R[x,y] /\\ R[y,x])\0a\0a(***************************************************************************)\0a(* Is the relation R transitive over set S?                                *)\0a(***************************************************************************)\0aIsTransitive(R, S) == \\A x,y,z \\in S : R[x,y] /\\ R[y,z] => R[x,z]\0a\0a(***************************************************************************)\0a(* Compute the transitive closure of relation R over set S.                *)\0a(***************************************************************************)\0aTransitiveClosure(R, S) ==\0a  LET N == Cardinality(S)\0a      trcl[n \\in Nat] == \0a          [x,y \\in S |-> IF n=0 THEN R[x,y]\0a                         ELSE \\/ trcl[n-1][x,y]\0a                              \\/ \\E z \\in S : trcl[n-1][x,z] /\\ trcl[n-1][z,y]]\0a  IN  trcl[N]\0a\0a(***************************************************************************)\0a(* Compute the reflexive transitive closure of relation R over set S.      *)\0a(***************************************************************************)\0aReflexiveTransitiveClosure(R, S) ==\0a  LET trcl == TransitiveClosure(R,S)\0a  IN  [x,y \\in S |-> x=y \\/ trcl[x,y]]\0a\0a(***************************************************************************)\0a(* Is the relation R connected over set S, i.e. does there exist a path    *)\0a(* between two arbitrary elements of S?                                    *)\0a(***************************************************************************)\0aIsConnected(R, S) ==\0a  LET rtrcl == ReflexiveTransitiveClosure(R,S)\0a  IN  \\A x,y \\in S : rtrcl[x,y]\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Sun Jun 14 15:32:47 CEST 2020 by merz\0a\\* Created Tue Apr 26 10:24:07 CEST 2016 by merz\0a']]]
      ['EvalOrder/Base' 'Base' %accept ~[['Base' '-------------------------------- MODULE Base --------------------------------\0aVARIABLES clk\0avars == <<clk>>\0a\0aInit == clk = 0\0a        \0aSpec == Init /\\ [][UNCHANGED vars]_vars\0a\0a=============================================================================\0a']]]
      ['EvalOrder/InitEvalOrder' 'InitEvalOrder' %accept ~[['InitEvalOrder' '--------------------------- MODULE InitEvalOrder ---------------------------\0aVARIABLE Clk1\0aS1 == INSTANCE Base  WITH  clk <- Clk1\0a\0aVARIABLE Clk2\0aS2 == INSTANCE Base  WITH  clk <- Clk2\0a\0aSpec1 == \0a       /\\ S1!Init /\\ S2!Init /\\ (Clk2 = Clk1)\0a       /\\ [][UNCHANGED <<Clk1, Clk2>>]_<<S1!vars, S2!vars>>\0a\0aSpec2 == \0a       /\\ S2!Init /\\ S1!Init /\\ (Clk1 = Clk2)\0a       /\\ [][UNCHANGED <<Clk1, Clk2>>]_<<S1!vars, S2!vars>>\0a\0aSpec3 == \0a       /\\ S1!Init /\\ S2!Init /\\ (Clk1 = Clk2)\0a       /\\ [][UNCHANGED <<Clk1, Clk2>>]_<<S1!vars, S2!vars>>\0a\0aSpec4 == \0a       /\\ S2!Init /\\ S1!Init /\\ (Clk2 = Clk1)\0a       /\\ [][UNCHANGED <<Clk1, Clk2>>]_<<S1!vars, S2!vars>>\0a=============================================================================\0a'] ['Base' '-------------------------------- MODULE Base --------------------------------\0aVARIABLES clk\0avars == <<clk>>\0a\0aInit == clk = 0\0a        \0aSpec == Init /\\ [][UNCHANGED vars]_vars\0a\0a=============================================================================\0a']]]
      ['EvalOrder/InitEvalOrderBasic' 'InitEvalOrderBasic' %accept ~[['InitEvalOrderBasic' '--------------------------- MODULE InitEvalOrderBasic ---------------------------\0aVARIABLES x, y\0a\0aSpec == /\\ (y=0) /\\ (x=0) /\\ (y = x)\0a        /\\ [][UNCHANGED <<x,y>>]_<<x,y>>\0a=============================================================================\0a']]]
      ['Loop/SystemLoop' 'SystemLoop' %accept ~[['SystemLoop' '----------------------------- MODULE SystemLoop -----------------------------\0a\0a(* System LOOP as described by Manna & Pneuli on page 423ff *)\0a\0aVARIABLES x\0avars == <<x>>\0a\0aInit == x = 0\0a\0aOne == x = 0 /\\ x\' = 1\0aTwo == x = 1 /\\ x\' = 2\0aThree == x = 2 /\\ x\' = 3\0aBack == x = 3 /\\ x\' = 0\0a\0aNext == One \\/ Two \\/ Three \\/ Back\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aSpecWeakFair == Spec /\\ WF_vars(Next)\0a\0aLiveness == []<>(x=3)\0a\0aneg_Liveness == ~(Liveness)\0a\0aXInitZero == <>(x = 0)\0a\0aTautology == (vars = vars) ~> (vars = vars)\0a=============================================================================\0a']]]
      ['ModuleOverwrites/ModuleOverwrites' 'ModuleOverwrites' %accept ~[['ModuleOverwrites' '-------------------------- MODULE ModuleOverwrites --------------------------\0aEXTENDS Integers, Sequences\0a\0aVARIABLES t\0a\0aInit == t = [ i \\in 1..10 |-> i ]\0a\0aNext == t\' = t\0a\0a-----------------------------------------------------------------------------\0a\0anoDupesOverwrite(arr, emp) == FALSE\0a\0aInvAsModuleOverwrite == noDupesOverwrite(t, -1)\0a\0a-----------------------------------------------------------------------------\0a\0anoDupesOverwriteLinear(arr, emp) == FALSE\0a\0aInvAsModuleOverwriteLinear == noDupesOverwriteLinear(t, -1)\0a\0a-----------------------------------------------------------------------------\0a\0anoDupes(arr, emp) == LET sub == SelectSeq(t, LAMBDA e: e # -1)\0a                         abs(number) == IF number < 0 THEN -1 * number ELSE number\0a                     IN IF Len(sub) < 2 THEN TRUE\0a                        ELSE \\A i \\in 1..(Len(sub) - 1):\0a                                \\A j \\in (i+1)..Len(sub):\0a                                   abs(sub[i]) # abs(sub[j]) \0a\0aInvNoModuleOverwrite == noDupes(t, -1)\0a=============================================================================\0a']]]
      ['PrintTraceRace/MC' 'MC' %accept ~[['MC' '---- MODULE MC ----\0aEXTENDS PrintTraceRace, TLC\0a\0a\\* INIT definition @modelBehaviorInit:0\0ainit_143958263805435000 ==\0aTestInit\0a----\0a\\* NEXT definition @modelBehaviorNext:0\0anext_143958263806436000 ==\0aTestNext\0a----\0a\\* INVARIANT definition @modelCorrectnessInvariants:0\0ainv_143958263807437000 ==\0aTestTypeInv\0a----\0a=============================================================================\0a'] ['PrintTraceRace' '---------------------- MODULE PrintTraceRace -------------------------\0aEXTENDS Naturals, Sequences\0aVARIABLES S\0a\0aTestTypeInv == S \\in [ q: Seq({1..2}),\0a                       i: 0..3]\0a\0aTestInit == S = [q |->  << >>,\0a                 i |-> 1]\0a\0aSend == /\\ (S.i \\leq 2)\0a        /\\ (S\' = [S EXCEPT !.i = (S.i + 1),!.q = Append(S.q,S.i)])\0a\0aDone == /\\ S.i > 2\0a        /\\ UNCHANGED << S >>\0a\0aTestNext == \\/ Send\0a            \\/ Done\0a============================================================']]]
      ['PrintTraceRace/PrintTraceRace' 'PrintTraceRace' %accept ~[['PrintTraceRace' '---------------------- MODULE PrintTraceRace -------------------------\0aEXTENDS Naturals, Sequences\0aVARIABLES S\0a\0aTestTypeInv == S \\in [ q: Seq({1..2}),\0a                       i: 0..3]\0a\0aTestInit == S = [q |->  << >>,\0a                 i |-> 1]\0a\0aSend == /\\ (S.i \\leq 2)\0a        /\\ (S\' = [S EXCEPT !.i = (S.i + 1),!.q = Append(S.q,S.i)])\0a\0aDone == /\\ S.i > 2\0a        /\\ UNCHANGED << S >>\0a\0aTestNext == \\/ Send\0a            \\/ Done\0a============================================================']]]
      ['TESpecTest/TESpecDeadlockTest' 'TESpecDeadlockTest' %accept ~[['TESpecDeadlockTest' '---------- MODULE TESpecDeadlockTest -----------\0a\0aEXTENDS Naturals\0a\0aVARIABLES x, y\0a\0aInit ==\0a    /\\ x = 0\0a    /\\ y = FALSE\0a\0aNext ==\0a    /\\ x <= 3\0a    /\\ x\' = x + 1\0a    /\\ y\' = ~y\0a\0aSpec ==\0a    /\\ Init\0a    /\\ [][Next]_<<x, y>>\0a\0a==============================================\0a']]]
      ['TESpecTest/TESpecNoErrorTest' 'TESpecNoErrorTest' %accept ~[['TESpecNoErrorTest' '---------- MODULE TESpecNoErrorTest -----------\0a\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aInit == x = 0\0a\0aNext ==\0a    \\/  /\\ x < 3\0a        /\\ x\' = x + 1\0a    \\/  /\\ x >= 3\0a        /\\ UNCHANGED x\0a\0aSpec ==\0a    /\\ Init\0a    /\\ [][Next]_<<x>>\0a\0a==============================================\0a']]]
      ['TESpecTest/TESpecPlusCalTest' 'TESpecPlusCalTest' %accept ~[['TESpecPlusCalTest' '---------- MODULE TESpecPlusCalTest -----------\0a\0aEXTENDS Naturals, TLC\0a\0a(* --algorithm Steps\0avariables x = 1, y = FALSE;\0abegin\0a    while TRUE do\0a        x := x + 1;\0a        y := ~y;\0a        assert x < 5;\0a    end while;\0aend algorithm; *)\0a\\* BEGIN TRANSLATION (chksum(pcal) = "2f1a7a64" /\\ chksum(tla) = "93b619e3")\0aVARIABLES x, y\0a\0avars == << x, y >>\0a\0aInit == (* Global variables *)\0a        /\\ x = 1\0a        /\\ y = FALSE\0a\0aNext == /\\ x\' = x + 1\0a        /\\ y\' = ~y\0a        /\\ Assert(x\' < 5, "Failure of assertion at line 11, column 9.")\0a\0aSpec == Init /\\ [][Next]_vars\0a\0a\\* END TRANSLATION \0a\0a==============================================\0a']]]
      ['TESpecTest/TESpecRuntimeErrorTest' 'TESpecRuntimeErrorTest' %accept ~[['TESpecRuntimeErrorTest' '---------- MODULE TESpecRuntimeErrorTest -----------\0a\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aInit == x = [val |-> 0]\0a\0aNext ==\0a    \\/  /\\ x.val < 3\0a        /\\ x\' = [val |-> x.val + 1]\0a    \\/  /\\ x.val >= 3\0a        /\\ x\' = [val2 |-> x.val + 1]\0a\0aSpec ==\0a    /\\ Init\0a    /\\ [][Next]_<<x>>\0a\0a==============================================\0a']]]
      ['TESpecTest/TESpecTest' 'TESpecTest' %accept ~[['TESpecTest' '---------- MODULE TESpecTest -----------\0a\0aEXTENDS Naturals\0a\0aCONSTANT Limit\0a\0aASSUME Limit \\in Nat\0a\0aVARIABLES x, y\0a\0aSafety ==\0a    /\\ x /= Limit\0a\0aLiveness ==\0a    /\\ <>(x = Limit)\0a\0aInit ==\0a    /\\ x = 0\0a    /\\ y = FALSE\0a\0aIncrement ==\0a    /\\ x\' = x + 1\0a    /\\ y\' = ~y\0a\0aDecrement ==\0a    /\\ x > 0\0a    /\\ x\' = x - 1\0a    /\\ y\' = ~y\0a\0aNext ==\0a    \\/ Increment\0a    \\/ Decrement\0a\0aSpec ==\0a    /\\ Init\0a    /\\ [][Next]_<<x, y>>\0a\0aLiveSpec ==\0a    /\\ Init\0a    /\\ [][Next]_<<x, y>>\0a    /\\ WF_<<x, y>>(Increment)\0a\0aEqAlias ==\0a    [x |-> x,\0a    y |-> y]\0a\0aMapAlias ==\0a    [x |-> x + 1,\0a    y |-> ~y]\0a\0aSupersetAlias ==\0a    [x |-> x,\0a    y |-> y,\0a    z |-> ~y]\0a\0aSubsetAlias ==\0a    [x |-> x]\0a\0a==============================================\0a']]]
      ['VoteProof/FiniteSets' 'FiniteSets' %accept ~[['FiniteSets' '---------------------------- MODULE FiniteSets -----------------------------\0aLOCAL INSTANCE Naturals\0aLOCAL INSTANCE Sequences\0a  (*************************************************************************)\0a  (* Imports the definitions from Naturals and Sequences, but doesn\'t      *)\0a  (* export them.                                                          *)\0a  (*************************************************************************)\0a\0aIsFiniteSet(S) == \0a  (*************************************************************************)\0a  (* A set S is finite iff there is a finite sequence containing all its   *)\0a  (* elements.                                                             *)\0a  (*************************************************************************)\0a  \\E seq \\in Seq(S) : \\A s \\in S : \\E n \\in 1..Len(seq) : seq[n] = s\0a\0aCardinality(S) ==\0a  (*************************************************************************)\0a  (* Cardinality is defined only for finite sets.                          *)\0a  (*************************************************************************)\0a  LET CS[T \\in SUBSET S] == IF T = {} THEN 0\0a                                      ELSE 1 + CS[T \\ {CHOOSE x : x \\in T}]\0a  IN  CS[S]\0a=============================================================================\0a']]]
      ['cdot/ActionComposition' 'ActionComposition' %accept ~[['ActionComposition' '------ MODULE ActionComposition ------\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aInit ==\0a    x = 0\0a\0aA ==\0a    \\/ /\\ x  \\in {0}\0a       /\\ x\' \\in {1, 2, 3}\0a    \\/ /\\ x  \\in {4}\0a       /\\ x\' \\in {5}\0a\0aB ==\0a    \\/ /\\ x  \\in {1, 2}\0a       /\\ x\' \\in {2, 4}\0a    \\/ /\\ x  \\in {5}\0a       /\\ x\' \\in {6}\0a\0aNext ==\0a    A \\cdot B\0a\0aSpec ==\0a    Init /\\ [][Next]_x\0a\0aInv ==\0a    x \\in {0, 1, 2, 4, 6}\0a\0aInv2 ==\0a\09x < 3 \\/ ENABLED Next\0a\0aProp ==\0a\09[][~(B \\cdot A)]_x\0a\0aProp2 ==\0a\09[][Next]_x\0a\0aActionConstraint ==\0a    <<Next>>_x\0a======\0a']]]
      ['cdot/CdotWithContextA' 'CdotWithContextA' %accept ~[['CdotWithContextA' '-------- MODULE CdotWithContextA ---------\0aEXTENDS Naturals\0a\0aVARIABLE x, S\0a\0aInit ==\0a    x = 0 /\\ S = {1,2}\0a\0aA(n) ==\0a    /\\ x\' = n\0a    /\\ UNCHANGED S\0a    \0a\0aB(n) ==\0a    /\\ x\' = n + 1\0a\09/\\ UNCHANGED S\0a\0aNext ==\0a\09/\\ x = 0\0a    /\\ \\E n \\in S :\0a          /\\ n \\in S\0a          /\\ A(n) \\cdot B(n)\0a\0aSpec ==\0a    Init /\\ [][Next]_<<S, x>>\0a\0a=======']]]
      ['cdot/CdotWithContextB' 'CdotWithContextB' %accept ~[['CdotWithContextB' '-------- MODULE CdotWithContextB ---------\0aEXTENDS Naturals\0a\0aVARIABLE x, S\0a\0aInit ==\0a    x = 0 /\\ S = {1,2}\0a\0aA(n) ==\0a    x\' = n\0a\0aB(n) ==\0a    x\' = n + 1\0a\0aNext ==\0a\09/\\ x = 0\0a\09/\\ UNCHANGED S\0a    /\\ \\E n \\in S :\0a          /\\ n \\in S\0a          /\\ A(n) \\cdot B(n)\0a\0aSpec ==\0a    Init /\\ [][Next]_<<S,x>>\0a\0aProp ==\0a\09[][Next]_<<S,x>>\0a\0aProp2 ==\0a\09ENABLED Next\0a\0a=======']]]
      ['cdot/CdotWithContextC' 'CdotWithContextC' %accept ~[['CdotWithContextC' '-------- MODULE CdotWithContextC ---------\0aEXTENDS Naturals\0a\0aVARIABLE x, S\0a\0aInit ==\0a    x = 0 /\\ S = {1,2}\0a\0aA(n) ==\0a    x\' = n\0a\0aB(n) ==\0a    /\\ x\' = n + 1\0a\0aNext ==\0a\09/\\ x = 0\0a    /\\ \\E n \\in S :\0a          /\\ n \\in S\0a          /\\ A(n) \\cdot B(n)\0a          /\\ UNCHANGED S\0a\0aSpec ==\0a    Init /\\ [][Next]_<<S, x>>\0a\0a=======']]]
      ['cdot/CdotWithContextD' 'CdotWithContextD' %accept ~[['CdotWithContextD' '-------- MODULE CdotWithContextD ---------\0aEXTENDS Naturals\0a\0aVARIABLE x, S\0a\0aInit ==\0a    x = 0 /\\ S = {1,2}\0a\0aA(n) ==\0a    x\' = n\0a\0aB(n) ==\0a    x\' = n + 1\0a\0aNext ==\0a\09/\\ x = 0\0a\09/\\ UNCHANGED S\0a    /\\ \\E n \\in S :\0a          /\\ n \\in S\0a          /\\ ( A(n) /\\ S\' = {} ) \\cdot B(n) \\* Next false\0a\0aSpec ==\0a    Init /\\ [][Next]_<<S,x>>\0a\0aProp ==\0a\09[][Next]_<<S,x>>\0a\0aProp2 ==\0a\09~(ENABLED Next)\0a\0a=======']]]
      ['cdot/ChainedCdots' 'ChainedCdots' %accept ~[['ChainedCdots' '-------- MODULE ChainedCdots ---------\0aEXTENDS Naturals, TLC\0a\0aASSUME TLCSet(0, 0)\0a\0aVARIABLE x\0a\0aInit ==\0a    x = 0\0a\0aA(S) ==\0a\09\\E n \\in S:\0a\09\09/\\ x\' = x + n\0a\09\09/\\ TLCSet(0, TLCGet(0) + x\')\0a\0aNext ==\0a\09/\\ x = 0\0a    /\\ A({1,2}) \\cdot A({3,4}) \\cdot A({5})\0a\0aSpec ==\0a    Init /\\ [][Next]_x\0a\0aPostCondition ==\0a\09/\\ TLCSet(42, TLCGet("generated"))\0a\09/\\ TLCGet(0) = 63\0a\0a=======']]]
      ['checkpoint/InfiniteStateSpace' 'InfiniteStateSpace' %accept ~[['InfiniteStateSpace' '------------------------------ MODULE InfiniteStateSpace ------------------------------\0aEXTENDS Naturals\0a\0aVARIABLES x,y\0a\0aSpec == x = 0 /\\ y \\in 1..1000 /\\ [][x\'= x + 1 /\\ UNCHANGED y]_<<x,y>>\0a=============================================================================\0a']]]
      ['coverage/A' 'A' %accept ~[['A' '---------------------------- MODULE A ----------------------------\0aEXTENDS Naturals, FiniteSets\0aVARIABLE x\0a\0aOp1(S) == \\A e \\in SUBSET S : Cardinality(e) >= 0\0a\0aInit == /\\ x = 0\0a        /\\ Op1(1..17)\0a\0a\\* Max(s)\0aOp2(n) == CHOOSE i \\in 1..n : \\A j \\in ((1..n) \\ {i}) : i > j\0a\0aA(n) == x\' = Op2(n)\0a\0aB(n) == x\' = Op2(n)\0a\0aNext == A(10) \\/ B(3)\0a=============================================================================\0a']]]
      ['coverage/B' 'B' %accept ~[['B' '---------------------------- MODULE B ----------------------------\0aVARIABLE x\0a\0aInit == x = FALSE\0a\0aSwitch(var) == ~var\0a\0aA == x\' = Switch(x)\0a\0aB == x\' = Switch(x)\0a\0aNext == A \\/ B\0a=============================================================================\0a']]]
      ['coverage/C' 'C' %accept ~[['C' '---------------------------- MODULE C ----------------------------\0aEXTENDS Naturals, FiniteSets\0aVARIABLES x,y\0a\0ac == x\0ad == y\0a\0avars == <<x,y>>\0a\0aa == x\'\0a\0aOp(S) == \\A e \\in SUBSET S : Cardinality(e) >= 0\0a\0aInit == /\\ x \\in 1..3\0a        /\\ y = 0\0a\0aA == /\\ c \\in Nat\0a     /\\ y \\in Nat\0a     /\\ a = x + 1\0a     /\\ UNCHANGED y\0a\0aB == /\\ x \\in Nat\0a     /\\ Op(1..5)\0a     /\\ UNCHANGED <<x,d>>\0a\0aC == /\\ x = 42\0a     /\\ c\' = TRUE\0a     /\\ y\' = FALSE\0a\0aD == x\' \\in 0..x /\\ UNCHANGED y\0a\0aU1 == x < 0 /\\ UNCHANGED vars\0a\0aU2 == x < 0 /\\ UNCHANGED <<x,y>>\0a\0aU3 == x < 0 /\\ UNCHANGED x /\\ UNCHANGED y\0a\0aNext == A \\/ B \\/ C \\/ D \\/ U1 \\/ U2 \\/ U3\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aConstraint == x < 20\0a\0a(* Coverage/Cost statistics for Invariants too. *)\0a\0aexpensive(N) == \\A e \\in SUBSET (1..N) : \\A f \\in e : f \\in 1..N \0a\0aInv == /\\ x \\in Nat\0a       /\\ y \\in Nat\0a       /\\ expensive(8)\0a       /\\ LET frob == TRUE  \0a          IN /\\ frob = TRUE\0a             /\\ \\A i \\in 1..5: i \\in Nat \0a             /\\ 42 \\in Nat\0a\0aInv2 == /\\ x \\in Nat\0a        /\\ y \\in Nat\0a        /\\ expensive(9)\0a        /\\ LET frob == TRUE\0a           IN /\\ frob = TRUE\0a             /\\ \\A i \\in 1..5: i \\in Nat \0a              /\\ 42 \\in Nat\0a=============================================================================\0a']]]
      ['coverage/CoverageStatistics' 'CoverageStatistics' %accept ~[['CoverageStatistics' '---------------------------- MODULE CoverageStatistics ----------------------------\0aEXTENDS Naturals, FiniteSets\0aVARIABLES x,y\0a\0ac == x\0ad == y\0a\0avars == <<x,y>>\0a\0aa == x\'\0a\0aInit == /\\ x \\in 1..3\0a        /\\ y = 0\0a\0aA == /\\ c \\in Nat\0a     /\\ y \\in Nat\0a     /\\ a = x + 1\0a     /\\ UNCHANGED d \\* 18 should be covered (6 should be omitted)\0a\0aB == /\\ x \\in Nat\0a     /\\ UNCHANGED <<x,d>> \\* 21 and 6 should be covered (6 should actually be omitted)\0a\0aB2 == /\\ x \\in Nat\0a     /\\ UNCHANGED vars \\* 21 and 6 should be covered (6 should actually be omitted)\0a     \0aC == /\\ x = 42\0a     /\\ c\' = TRUE\0a     /\\ y\' = FALSE\0a\0aU1 == x < 0 /\\ UNCHANGED vars \\* vars should be reported as uncovered instead of x and y on line 8\0a\0aU2 == x < 0 /\\ UNCHANGED <<x,y>> \\* col 28 & 30 \0a\0aU3 == x < 0 /\\ UNCHANGED x /\\ UNCHANGED y \\* col 26 & 41\0a\0aU4 == x < 0 /\\ UNCHANGED x /\\ UNCHANGED d (* d itself instead of y is marked uncovered *)\0a\0aUC1 == x \\in Nat /\\ UNCHANGED <<x,y>>\0a\0aUC2 == x \\in Nat /\\ UNCHANGED x /\\ UNCHANGED y\0a\0aUC3 == x \\in Nat /\\ UNCHANGED vars \\* Do not mark vars on line 8 as covered\0a\0aNext == A \\/ B \\/ C \\/ U1 \\/ U2 \\/ U3 \\/ U4 \\/ UC1 \\/ UC2 \\/ UC3\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aConstraint == x < 20\0a\0a=============================================================================\0a']]]
      ['coverage/D' 'D' %accept ~[['D' '---------------------------- MODULE D ----------------------------\0aEXTENDS Naturals\0aVARIABLE x\0a\0aInit == x = 0\0a\0a(* No endless recursion in Coverage/Cost with RECURSIVE. *)\0aRECURSIVE fact(_)\0afact(n) == IF n = 1 THEN 1 ELSE n * fact(n - 1)\0a\0aA == x\' = fact(3)\0a\0aB == x\' = fact(9)\0a\0aNext == A \\/ B\0a\0aSpec == Init /\\ [][Next]_<<x>>\0a=============================================================================\0a']]]
      ['coverage/E' 'E' %accept ~[['E' '---------------------------- MODULE E ----------------------------\0aCONSTANT Op(_)\0a\0aVARIABLE x\0a\0aId(n) == SUBSET {1,2,3}\0a\0aForty2(n) == Id(n)\0a\0aInit == x = 0\0a\0aNext == x\' \\in Op(x)\0a=============================================================================\0a']]]
      ['coverage/F' 'F' %accept ~[['F' '---------------------------- MODULE F ----------------------------\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aOp(S, P(_), Q(_, _)) == { s \\in S : P(s) /\\ Q(s, TRUE) }\0a\0aInit == x \\in Op({1,2,3,4,5}, LAMBDA s: s > 1, LAMBDA odd, b: odd % 2 # 0 /\\ b) \0a\0aNext == UNCHANGED x\0a=============================================================================\0a']]]
      ['coverage/G' 'G' %accept ~[['G' '---------------------------- MODULE G ----------------------------\0aVARIABLES u1\0a\0avars == << u1 >>\0a\0aInit == /\\ u1 = TRUE\0a\0aNext == /\\ UNCHANGED vars\0a        /\\ UNCHANGED <<u1>>\0a        /\\ UNCHANGED u1\0a\0aProp == ENABLED Next\0a=============================================================================\0a']]]
      ['coverage/Github377' 'Github377' %accept ~[['Github377' '---- MODULE Github377 ----\0aEXTENDS Integers\0aVARIABLES x\0a\0aSpec == x = TRUE /\\ [][UNCHANGED x]_x\0a\0a--------------\0a\0a1Inv ==\0a LET recfcn[ i \\in {1,2,3} ] == IF i = 1 THEN x = TRUE ELSE recfcn[1]\0a IN recfcn[1]\0a\0a--------------\0a\0a1InvNonRec ==\0a LET recfcn[ i \\in {1,2,3} ] == x = TRUE\0a IN recfcn[1]\0a\0a--------------\0a\0a2Inv ==\0a  LET outer ==\0a      LET innerA[ i \\in {1} ] == IF i = 1 THEN x = TRUE ELSE innerA[i]\0a          innerB[ i \\in {1} ] == innerA[i] \0a      IN innerB[1] /\\ 42 = 31 + 11 /\\ innerA[1]\0a  IN  outer\0a\0a2aInv ==\0a  LET outer ==\0a      LET innerA[ i \\in {1} ] == IF i = 1 THEN x = TRUE ELSE innerA[i]\0a          innerB[ i \\in {1} ] == innerA[i]\0a      IN /\\ innerA[1]\0a         /\\ innerB[1] \0a  IN  outer\0a  \0a2bInv ==\0a  LET outer ==\0a      LET innerA[ i \\in {1} ] == IF i = 1 THEN x = TRUE ELSE innerA[i]\0a          innerB[ i \\in {1} ] == innerA[i]\0a      IN innerA[1] /\\ innerB[1]\0a  IN  outer\0a--------------\0a\0a3aInv ==\0a  LET outer ==\0a      LET innerA[ i \\in {1} ] == IF i = 1 THEN x = TRUE ELSE innerA[i]\0a          innerB[ i \\in {1} ] == innerA[1]\0a      IN /\\ LET foo(i) == innerA[i]\0a            IN foo(1)\0a         /\\ innerB[1] \0a  IN  outer\0a\0a--------------\0a\0a3bInv ==\0a  LET outer ==\0a      LET innerA[ i \\in {1} ] == IF i = 1 THEN x = TRUE ELSE innerA[i]\0a          innerB[ i \\in {1} ] == innerA[1]\0a      IN LET foo(i) == innerA[i]\0a         IN foo(1) /\\ innerB[1] \0a  IN  outer\0a  \0a\0a--------------\0a\0a4Inv ==\0a  LET outer ==\0a      LET inner[ i \\in {1} ] ==\0a          LET innerst[ j \\in {1} ] == x = TRUE\0a          IN  innerst[1]\0a      IN  inner[1]\0a  IN  outer\0a  \0a====\0a  ']]]
  ==
::
++  test-sany-sub-2
  %+  expect-eq
    !>  ^-  (list @t)
    :~  'coverage/K -> hoon=reject'  'coverage/L -> hoon=reject'  'examples/SingleLaneBridge/SingleLaneBridge -> hoon=reject'  'gh1134/MultiUser -> hoon=reject'  'gh1134/SingleUser -> hoon=reject'
    ==
  !>
  %-  sub-batch-run
  ^-  (list [@t @t ?(%accept %reject) (list [@t @t])])
  :~
      ['coverage/Github649' 'Github649' %accept ~[['Github649' '---- MODULE Github649 ----\0aEXTENDS Naturals\0a\0aVARIABLE clock\0a\0aRECURSIVE Check(_,_)\0aCheck(c,n) == IF n = 0 THEN c \\in BOOLEAN ELSE Check(c, n - 1)\0a\0aTypeOK == Check(clock,1)\0a\0aRECURSIVE Flip(_,_,_)\0aFlip(v, b, n) == IF n = 0 THEN v = ~b ELSE Flip(v, b, n - 1)\0a\0aInit == Flip(clock, FALSE, 1)  \\* The expression Flip(..) does *not* appear in the coverage result. Some of its parameters are covered (invoked),\0a                               \\* but the Flip(..) itself gets skipped over by TLC.  It correctly does not get marked as uncovered.\0aNext == clock\' = ~clock\0a\0aConstraint ==\0a    Flip(clock, ~clock, 2)\0a====']]]
      ['coverage/H' 'H' %accept ~[['H' '------------------------------ MODULE H ------------------------------\0aEXTENDS Naturals\0aVARIABLES x\0a\0aMyNat == 0..30\0a\0aTypeOK == x \\in MyNat\0a\0aInit == x = 0\0a\0aA == x\' = 23\0a\0aBandC == \\/ /\\ x \\in MyNat\0a            /\\ x\' \\in 23..25\0a         \\/ /\\ x < 25\0a            /\\ x\' = 26\0a\0aDandE == (x = 23 /\\ x\' = 42) \\/ (x = 123 /\\ x\' = 4711)\0a\0aNext == A \\/ BandC \\/ DandE\0a\0aInv == /\\ TypeOK\0a       /\\ x = 0\0a\0aSpec == Inv /\\ [][Next]_x\0a\0a============\0a']]]
      ['coverage/I' 'I' %accept ~[['I' '------------------------------ MODULE I ------------------------------\0aEXTENDS Naturals\0aVARIABLES x\0a\0aF[ i \\in {1,2,3,4,5} ] == \0a   IF i = 1 THEN 1 ELSE F[i-1] + 1 \\* Recursive Function Definition\0a\0aN[n \\in {1,2,3}] == \0a    /\\ UNCHANGED <<x>>\0a\0aSpec == x \\in {1,2,3,4,5} /\\ [][\\E i \\in {1,2,3} : N[i] ]_x\0a\0aInv == \\E i \\in DOMAIN F: F[i] = x\0a\0a============\0a']]]
      ['coverage/J' 'J' %accept ~[['J' '------------------------------ MODULE J ------------------------------\0a\0aVARIABLES x, y\0a\0aInit == /\\ x \\in {1,2,3,4,5}\0a        /\\ y = [i \\in {1,2,3,4,5} |-> 0]\0a\0aFoo(rcds) ==\0a CASE x = 1 -> [ rcds EXCEPT ![x] = 42 ]\0a   [] OTHER -> rcds\0a\0aNext == /\\ y\' = Foo(y)\0a        /\\ UNCHANGED x \0a\0aSpec == Init /\\ [][Next]_<<x,y>>\0a============\0a']]]
      ['coverage/K' 'K' %accept ~[['K' '------------------------------ MODULE K ------------------------------\0a\0aEXTENDS Naturals\0a\0aFoo(Op(_), S) == \\A s \\in S: Op(s)\0a\0aBar(S) == Foo(LAMBDA e: e \\in Nat, S)\0a\0aVARIABLE x\0a\0aSpec == x = Bar({1,2,3}) /\\ [][UNCHANGED x]_x \0a============\0a']]]
      ['coverage/L' 'L' %accept ~[['L' '------------------------------ MODULE L ------------------------------\0aEXTENDS Naturals\0a\0aVARIABLE v\0a\0aChooseOne(S, P(_)) == CHOOSE x \\in S : P(x) /\\ \\A y \\in S : P(y)\0a\0aSpec == v = ChooseOne({1}, LAMBDA x : TRUE) /\\ [][UNCHANGED v]_v\0a\0a============\0a']]]
      ['coverage/M' 'M' %accept ~[['M' '------------------------------ MODULE M ------------------------------\0aEXTENDS Naturals, FiniteSets\0a\0aVARIABLES active, color, tpos, tcolor\0avars == <<active, color, tpos, tcolor>>\0a\0aNodes == 0 .. 2\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]    \\* status of nodes (active or passive)\0a  /\\ color \\in [Nodes -> Color]       \\* color of nodes\0a  /\\ tpos \\in Nodes                   \\* token position\0a  /\\ tcolor \\in Color                 \\* token color\0a\0aInit ==\0a  /\\ active \\in [{23,42,56} -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor = "black"\0a\0aNext ==\0a  /\\ active\' \\in [{23,42,56} -> BOOLEAN]\0a  /\\ color\' \\in [Nodes -> Color]\0a  /\\ tpos\' \\in Nodes\0a  /\\ tcolor\' = "black"\0a  \0aSpec ==\0a  Init /\\ [][Next]_vars\0a\0a============\0a']]]
      ['debug/Debug02' 'Debug02' %accept ~[['Debug02' '\0a  I didn\'t want to update the line numbers in the JUnit test.\0a\0a------------------------------- MODULE Debug02 -------------------------------\0aVARIABLE x\0aInit == x = TRUE\0aNext == x\' =~x\0aSpec == Init /\\ [][Next]_x\0aCONSTANT C\0aval == 42\0a==================================================================================\0a------------------------------- CONFIG Debug02 -------------------------------\0aSPECIFICATION Spec\0aCONSTANT C <- val\0a==================================================================================\0a']]]
      ['debug/Debug03' 'Debug03' %accept ~[['Debug03' '------------------------------- MODULE Debug03 -------------------------------\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aInit ==\0a    x \\in 0..1\0a\0aNext == \0a    /\\ x < 10\0a    /\\ x\' \\in 1..9\0a\0aSpec == \0a    Init /\\ [][Next]_x\0a\0a==================================================================================\0a------------------------------- CONFIG Debug03 -------------------------------\0aSPECIFICATION Spec\0a==================================================================================\0a']]]
      ['debug/Debug05' 'Debug05' %accept ~[['Debug05' '--------------------------------- MODULE Debug05 ---------------------------------\0aEXTENDS Naturals\0aVARIABLE b, i\0aInit == b = FALSE /\\ i = 1\0aNext == b\' \\in BOOLEAN /\\ i\' = i + 1\0aSpec == Init /\\ [][Next]_<<b, i>>\0a==================================================================================\0a--------------------------------- CONFIG Debug05 ---------------------------------\0aSPECIFICATION Spec\0a==================================================================================\0a']]]
      ['debug/ExpressionBreakpointTest' 'ExpressionBreakpointTest' %accept ~[['ExpressionBreakpointTest' '---- MODULE ExpressionBreakpointTest ----\0aEXTENDS Naturals\0aVARIABLE i\0aCONSTANT j\0aASSUME j \\in Nat\0aop(k) ==\0a  \\A l \\in 0 .. (j - k) :\0a    i \\in Nat\0aInv == op(5)\0aInit == i = 0\0aNext == IF i < j THEN i\' = i + 1 ELSE UNCHANGED i\0a====\0a---- CONFIG ExpressionBreakpointTest ----\0aCONSTANT j = 10\0aINVARIANTS Inv\0aINIT Init\0aNEXT Next\0a====\0a\0a']]]
      ['examples/CoffeeCan/CoffeeCan100Beans' 'CoffeeCan100Beans' %accept ~[['CoffeeCan100Beans' '---------------------------- MODULE CoffeeCan100Beans -------------------------------\0a(***************************************************************************)\0a(* This is a spec for the Coffee Can problem, a math problem usually       *)\0a(* attributed to David Gries in his 1987 book The Science of Programming.  *)\0a(* However, on page 301 section 23.2 of the same book Gries attributes the *)\0a(* problem to a 1979 letter by Edsger W. Dijkstra, who himself credits the *)\0a(* problem to his colleague Carel S. Scholten.                             *)\0a(*                                                                         *)\0a(* The problem as presented on page 165 of The Science of Programming:     *)\0a(*                                                                         *)\0a(* A coffee can contains some black beans and white beans. The following   *)\0a(* process is to be repeated as long as possible:                          *)\0a(*                                                                         *)\0a(* Randomly select two beans from the can. If they are the same color,     *)\0a(* throw them out, but put another black bean in. (Enough extra black      *)\0a(* beans are available to do this.) If they are different colors, place    *)\0a(* the white one back into the can and throw the black one away.           *)\0a(*                                                                         *)\0a(* Execution of this process reduces the number of beans in the can by     *)\0a(* one. Repetition of this process must terminate with exactly one bean in *)\0a(* the can, for then two beans cannot be selected. The question is: what,  *)\0a(* if anything, can be said about the color of the final bean based on the *)\0a(* number of white beans and the number of black beans initially in the    *)\0a(* can?                                                                    *)\0a(*                                                                         *)\0a(* We model this problem in TLA⁺ with a focus on two things:               *)\0a(*  1. Validate a monotonic decrease in number of beans at each step       *)\0a(*  2. Identify a loop/inductive invariant                                 *)\0a(*  3. Form a hypothesis about the final bean and modelcheck it            *)\0a(*                                                                         *)\0a(* Finite modelchecking can only check our properties for a finite number  *)\0a(* of beans, while we want to show that it holds for all Natural numbers.  *)\0a(* TLA⁺\'s built-in proof language can be used for this purpose, although   *)\0a(* such a proof is not currently included in this spec.                    *)\0a(*                                                                         *)\0a(***************************************************************************)\0a\0aEXTENDS Naturals\0a\0aCONSTANT MaxBeanCount\0a\0aASSUME MaxBeanCount \\in Nat /\\ MaxBeanCount >= 1\0a\0aVARIABLES can\0a\0a\\* The set of all possible cans\0aCan == [black : 0..MaxBeanCount, white : 0..MaxBeanCount]\0a\0a\\* Possible values the can variable can take on\0aTypeInvariant == can \\in Can\0a\0a\\* Initialize can so it contains between 1 and MaxBeanCount beans\0aInit == can \\in {c \\in Can : c.black + c.white \\in 1..MaxBeanCount}\0a\0a\\* Number of beans currently in the can\0aBeanCount == can.black + can.white\0a\0a\\* Pick two black beans; throw both away, put one black bean in\0aPickSameColorBlack ==\0a    /\\ BeanCount > 1\0a    /\\ can.black >= 2\0a    /\\ can\' = [can EXCEPT !.black = @ - 1]\0a\0a\\* Pick two white beans; throw both away, put one black bean in\0aPickSameColorWhite ==\0a    /\\ BeanCount > 1\0a    /\\ can.white >= 2\0a    /\\ can\' = [can EXCEPT !.black = @ + 1, !.white = @ - 2]\0a\0a\\* Pick one bean of each color; put white back, throw away black\0aPickDifferentColor ==\0a    /\\ BeanCount > 1\0a    /\\ can.black >= 1\0a    /\\ can.white >= 1\0a    /\\ can\' = [can EXCEPT !.black = @ - 1]\0a\0a\\* Termination action to avoid triggering deadlock detection\0aTermination ==\0a    /\\ BeanCount = 1\0a    /\\ UNCHANGED can\0a\0a\\* Next-state relation: what actions can be taken?\0aNext ==\0a    \\/ PickSameColorWhite\0a    \\/ PickSameColorBlack\0a    \\/ PickDifferentColor\0a    \\/ Termination\0a\0a\\* Action formula: every step decreases the number of beans in the can\0aMonotonicDecrease == [][BeanCount\' < BeanCount]_can\0a\0a\\* Liveness property: we eventually end up with one bean left\0aEventuallyTerminates == <>(ENABLED Termination)\0a\0a\\* Loop invariant: every step preserves white bean count mod 2\0aLoopInvariant == [][can.white % 2 = 0 <=> can\'.white % 2 = 0]_can\0a\0a\\* Hypothesis: If we start out with an even number of white beans, we end up\0a\\* with a single black bean. Otherwise, we end up with a single white bean.\0aTerminationHypothesis ==\0a    IF can.white % 2 = 0\0a    THEN <>(can.black = 1 /\\ can.white = 0)\0a    ELSE <>(can.black = 0 /\\ can.white = 1)\0a\0a\\* Start out in a state defined by the Init operator and every step is one\0a\\* defined by the Next operator. Assume weak fairness so the system can\'t\0a\\* stutter indefinitely: we eventually take some beans out of the can.\0aSpec ==\0a    /\\ Init\0a    /\\ [][Next]_can\0a    /\\ WF_can(Next)\0a\0a\\* What we want to show: that if our system follows the rules set out by the\0a\\* Spec operator, then all our properties and assumptions will be satisfied.\0aTHEOREM Spec =>\0a    /\\ TypeInvariant\0a    /\\ MonotonicDecrease\0a    /\\ EventuallyTerminates\0a    /\\ LoopInvariant\0a    /\\ TerminationHypothesis\0a\0a=============================================================================\0a\0a\0a']]]
      ['examples/SingleLaneBridge/MC' 'MC' %accept ~[['MC' '---- MODULE MC ----\0aEXTENDS SingleLaneBridge, TLC\0a\0a\\* CONSTANT definitions @modelParameterConstants:0CarsRight\0aconst_1615720459299211000 == \0a{"r1","r2"}\0a----\0a\0a\\* CONSTANT definitions @modelParameterConstants:1CarsLeft\0aconst_1615720459299212000 == \0a{"l1","l2"}\0a----\0a\0a\\* CONSTANT definitions @modelParameterConstants:2Bridge\0aconst_1615720459299213000 == \0a{4,5}\0a----\0a\0a\\* CONSTANT definitions @modelParameterConstants:3Positions\0aconst_1615720459299214000 == \0a{1,2,3,4,5,6,7,8}\0a----\0a\0aCarsInfOftenOnBridge == \\A car \\in CarsRight : []<>(Location[car] \\in Bridge)\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Sun Oct 10 22:023:42 CEST 2021 by youne\0a'] ['SingleLaneBridge' '-------------------------- MODULE SingleLaneBridge --------------------------\0a\0a\\* A bridge over a river is only wide enough to permit a single lane of traffic.\0a\\* Consequently, cars can only move concurrently if they are moving in the same \0a\\* direction. A safety violation occurs if two cars moving in different directions\0a\\* enter the bridge at the same time.\0a\\* To visualize the problem, refer to https://flylib.com/books/en/2.752.1.48/1/\0a   \0aEXTENDS Naturals, FiniteSets, Sequences\0a\0aCONSTANTS CarsRight, CarsLeft, Bridge, Positions\0a\0aVARIABLES Location, WaitingBeforeBridge\0avars == <<Location, WaitingBeforeBridge>>\0a\0aStartPos == CHOOSE min \\in Positions : \\A p \\in Positions : min <= p\0aEndPos   == CHOOSE max \\in Positions : \\A p \\in Positions : max >= p\0a\0aStartBridge == CHOOSE min \\in Bridge : \\A e \\in Bridge : min <= e\0aEndBridge   == CHOOSE max \\in Bridge : \\A e \\in Bridge : max >= e\0a\0aASSUME CarsRight \\cap CarsLeft = {}\0aASSUME Cardinality(CarsRight \\union CarsLeft ) # 0\0aASSUME StartPos < StartBridge /\\ EndPos > EndBridge /\\ Cardinality(Bridge) < Cardinality(Positions)\0a\0a\0aRECURSIVE SeqFromSet(_)\0aSeqFromSet(S) == \0a  IF S = {} THEN << >> \0a  ELSE LET x == CHOOSE x \\in S : TRUE\0a       IN  << x >> \\o SeqFromSet(S \\ {x})\0a\0aCars == CarsRight \\union CarsLeft\0aCarsInBridge == { c \\in Cars : Location[c] \\in Bridge }\0aCarsBeforeBridge == { car \\in CarsRight : EndPos - EndBridge = 1 } \\cup { car \\in CarsLeft : StartBridge - StartPos = 1 }\0a\0aRMove(pos) == IF pos > StartPos THEN pos - 1 ELSE EndPos\0aLMove(pos) == IF pos < EndPos THEN pos + 1 ELSE StartPos\0a\0aNextLocation(car) == IF car \\in CarsRight THEN RMove(Location[car]) ELSE LMove(Location[car])\0a\0aChangeLocation(car) ==\0a    /\\ IF \\/ car \\in CarsRight /\\ NextLocation(car) = EndBridge + 1\0a          \\/ car \\in CarsLeft /\\ NextLocation(car) = StartBridge - 1\0a        THEN WaitingBeforeBridge\' = Append(WaitingBeforeBridge, car)\0a        ELSE UNCHANGED WaitingBeforeBridge\0a    /\\ Location\' = [ Location EXCEPT ![car] = NextLocation(car) ]\0a\0aHaveSameDirection(car) ==\0a    \\/ car \\in CarsRight /\\ \\A c \\in CarsInBridge : c \\in CarsRight\0a    \\/ car \\in CarsLeft /\\ \\A c \\in CarsInBridge : c \\in CarsLeft\0a\0a\\* Actions\0aMoveOutsideBridge(car) ==\0a    /\\ NextLocation(car) \\notin Bridge\0a    /\\ ChangeLocation(car)\0a\0aMoveInsideBridge(car) ==\0a    /\\ car \\in CarsInBridge\0a    /\\ \\A c \\in Cars : Location[c] # NextLocation(car)\0a    /\\ ChangeLocation(car)\0a\0aEnterBridge ==\0a    \\/  /\\ CarsInBridge = {}\0a        /\\ Len(WaitingBeforeBridge) # 0\0a        /\\ Location\' = [ Location EXCEPT ![Head(WaitingBeforeBridge)] = NextLocation(Head(WaitingBeforeBridge)) ]\0a        /\\ WaitingBeforeBridge\' = Tail(WaitingBeforeBridge)\0a    \\/  /\\ Len(WaitingBeforeBridge) # 0\0a        /\\ Head(WaitingBeforeBridge) \\notin CarsInBridge\0a        /\\ HaveSameDirection(Head(WaitingBeforeBridge))\0a        /\\ \\A c \\in Cars : Location[c] # NextLocation(Head(WaitingBeforeBridge))\0a        /\\ Location\' = [ Location EXCEPT ![Head(WaitingBeforeBridge)] = NextLocation(Head(WaitingBeforeBridge)) ]\0a        /\\ WaitingBeforeBridge\' = Tail(WaitingBeforeBridge)\0a\0aInit == \0a    /\\ Location = [ c \\in Cars |-> IF c \\in CarsRight THEN EndPos ELSE StartPos  ]\0a    /\\ WaitingBeforeBridge = SeqFromSet(CarsBeforeBridge)\0a\0aNext == \\E car \\in Cars : EnterBridge \\/ MoveOutsideBridge(car) \\/ MoveInsideBridge(car)\0a\0aFairness ==\0a    /\\ \\A car \\in Cars : WF_vars(MoveOutsideBridge(car))\0a    /\\ \\A car \\in Cars : WF_vars(MoveInsideBridge(car))\0a    /\\ \\A car \\in Cars : WF_vars(EnterBridge)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aInvariants ==\0a    \\* Two cars or more cannot be in the same location in the Bridge at the same time\0a    /\\ \\A a,b \\in Cars :\0a        /\\ Location[a] \\in Bridge\0a        /\\ Location[a] = Location[b]\0a        => a = b\0a    \\* The bridge capacity should be respected\0a    /\\ Cardinality(CarsInBridge) < Cardinality(Bridge) + 1\0a    \\* Two cars of different directions can never be in the bridge\0a    /\\ \\A <<r,l>> \\in CarsRight \\X CarsLeft :\0a        ~ (Location[r] \\in Bridge /\\ Location[l] \\in Bridge) \0a\0aTypeOK ==\0a    /\\ Location \\in [ Cars -> Positions ]\0a    /\\ Len(WaitingBeforeBridge) <= Cardinality(Cars)\0a\0aCarsInBridgeExitBridge ==\0a    \\* All cars eventually exit the Bridge \0a    \\A car \\in Cars : Location[car] \\in Bridge ~> Location[car] \\notin Bridge\0a\0aCarsEnterBridge ==\0a    \\* All cars eventually enter the bridge\0a    \\A car \\in Cars : Location[car] \\notin Bridge ~> Location[car] \\in Bridge\0a\0aTHEOREM Spec => [] Invariants\0a\0aTHEOREM Spec => [] TypeOK\0a\0aTHEOREM Spec => CarsInBridgeExitBridge\0aTHEOREM Spec => CarsEnterBridge\0a\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Tue Oct 12 00:20:28 CEST 2021 by youne\0a']]]
      ['examples/SingleLaneBridge/SingleLaneBridge' 'SingleLaneBridge' %accept ~[['SingleLaneBridge' '-------------------------- MODULE SingleLaneBridge --------------------------\0a\0a\\* A bridge over a river is only wide enough to permit a single lane of traffic.\0a\\* Consequently, cars can only move concurrently if they are moving in the same \0a\\* direction. A safety violation occurs if two cars moving in different directions\0a\\* enter the bridge at the same time.\0a\\* To visualize the problem, refer to https://flylib.com/books/en/2.752.1.48/1/\0a   \0aEXTENDS Naturals, FiniteSets, Sequences\0a\0aCONSTANTS CarsRight, CarsLeft, Bridge, Positions\0a\0aVARIABLES Location, WaitingBeforeBridge\0avars == <<Location, WaitingBeforeBridge>>\0a\0aStartPos == CHOOSE min \\in Positions : \\A p \\in Positions : min <= p\0aEndPos   == CHOOSE max \\in Positions : \\A p \\in Positions : max >= p\0a\0aStartBridge == CHOOSE min \\in Bridge : \\A e \\in Bridge : min <= e\0aEndBridge   == CHOOSE max \\in Bridge : \\A e \\in Bridge : max >= e\0a\0aASSUME CarsRight \\cap CarsLeft = {}\0aASSUME Cardinality(CarsRight \\union CarsLeft ) # 0\0aASSUME StartPos < StartBridge /\\ EndPos > EndBridge /\\ Cardinality(Bridge) < Cardinality(Positions)\0a\0a\0aRECURSIVE SeqFromSet(_)\0aSeqFromSet(S) == \0a  IF S = {} THEN << >> \0a  ELSE LET x == CHOOSE x \\in S : TRUE\0a       IN  << x >> \\o SeqFromSet(S \\ {x})\0a\0aCars == CarsRight \\union CarsLeft\0aCarsInBridge == { c \\in Cars : Location[c] \\in Bridge }\0aCarsBeforeBridge == { car \\in CarsRight : EndPos - EndBridge = 1 } \\cup { car \\in CarsLeft : StartBridge - StartPos = 1 }\0a\0aRMove(pos) == IF pos > StartPos THEN pos - 1 ELSE EndPos\0aLMove(pos) == IF pos < EndPos THEN pos + 1 ELSE StartPos\0a\0aNextLocation(car) == IF car \\in CarsRight THEN RMove(Location[car]) ELSE LMove(Location[car])\0a\0aChangeLocation(car) ==\0a    /\\ IF \\/ car \\in CarsRight /\\ NextLocation(car) = EndBridge + 1\0a          \\/ car \\in CarsLeft /\\ NextLocation(car) = StartBridge - 1\0a        THEN WaitingBeforeBridge\' = Append(WaitingBeforeBridge, car)\0a        ELSE UNCHANGED WaitingBeforeBridge\0a    /\\ Location\' = [ Location EXCEPT ![car] = NextLocation(car) ]\0a\0aHaveSameDirection(car) ==\0a    \\/ car \\in CarsRight /\\ \\A c \\in CarsInBridge : c \\in CarsRight\0a    \\/ car \\in CarsLeft /\\ \\A c \\in CarsInBridge : c \\in CarsLeft\0a\0a\\* Actions\0aMoveOutsideBridge(car) ==\0a    /\\ NextLocation(car) \\notin Bridge\0a    /\\ ChangeLocation(car)\0a\0aMoveInsideBridge(car) ==\0a    /\\ car \\in CarsInBridge\0a    /\\ \\A c \\in Cars : Location[c] # NextLocation(car)\0a    /\\ ChangeLocation(car)\0a\0aEnterBridge ==\0a    \\/  /\\ CarsInBridge = {}\0a        /\\ Len(WaitingBeforeBridge) # 0\0a        /\\ Location\' = [ Location EXCEPT ![Head(WaitingBeforeBridge)] = NextLocation(Head(WaitingBeforeBridge)) ]\0a        /\\ WaitingBeforeBridge\' = Tail(WaitingBeforeBridge)\0a    \\/  /\\ Len(WaitingBeforeBridge) # 0\0a        /\\ Head(WaitingBeforeBridge) \\notin CarsInBridge\0a        /\\ HaveSameDirection(Head(WaitingBeforeBridge))\0a        /\\ \\A c \\in Cars : Location[c] # NextLocation(Head(WaitingBeforeBridge))\0a        /\\ Location\' = [ Location EXCEPT ![Head(WaitingBeforeBridge)] = NextLocation(Head(WaitingBeforeBridge)) ]\0a        /\\ WaitingBeforeBridge\' = Tail(WaitingBeforeBridge)\0a\0aInit == \0a    /\\ Location = [ c \\in Cars |-> IF c \\in CarsRight THEN EndPos ELSE StartPos  ]\0a    /\\ WaitingBeforeBridge = SeqFromSet(CarsBeforeBridge)\0a\0aNext == \\E car \\in Cars : EnterBridge \\/ MoveOutsideBridge(car) \\/ MoveInsideBridge(car)\0a\0aFairness ==\0a    /\\ \\A car \\in Cars : WF_vars(MoveOutsideBridge(car))\0a    /\\ \\A car \\in Cars : WF_vars(MoveInsideBridge(car))\0a    /\\ \\A car \\in Cars : WF_vars(EnterBridge)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aInvariants ==\0a    \\* Two cars or more cannot be in the same location in the Bridge at the same time\0a    /\\ \\A a,b \\in Cars :\0a        /\\ Location[a] \\in Bridge\0a        /\\ Location[a] = Location[b]\0a        => a = b\0a    \\* The bridge capacity should be respected\0a    /\\ Cardinality(CarsInBridge) < Cardinality(Bridge) + 1\0a    \\* Two cars of different directions can never be in the bridge\0a    /\\ \\A <<r,l>> \\in CarsRight \\X CarsLeft :\0a        ~ (Location[r] \\in Bridge /\\ Location[l] \\in Bridge) \0a\0aTypeOK ==\0a    /\\ Location \\in [ Cars -> Positions ]\0a    /\\ Len(WaitingBeforeBridge) <= Cardinality(Cars)\0a\0aCarsInBridgeExitBridge ==\0a    \\* All cars eventually exit the Bridge \0a    \\A car \\in Cars : Location[car] \\in Bridge ~> Location[car] \\notin Bridge\0a\0aCarsEnterBridge ==\0a    \\* All cars eventually enter the bridge\0a    \\A car \\in Cars : Location[car] \\notin Bridge ~> Location[car] \\in Bridge\0a\0aTHEOREM Spec => [] Invariants\0a\0aTHEOREM Spec => [] TypeOK\0a\0aTHEOREM Spec => CarsInBridgeExitBridge\0aTHEOREM Spec => CarsEnterBridge\0a\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Tue Oct 12 00:20:28 CEST 2021 by youne\0a']]]
      ['examples/SpanningTree/SpanTreeRandom' 'SpanTreeRandom' %accept ~[['SpanTreeRandom' '------------------------------ MODULE SpanTreeRandom ------------------------------\0a(***************************************************************************)\0a(* The specification in this module is a modified version of the one in    *)\0a(* module SpanTree obtained by replacing the declared constant Edges with  *)\0a(* a defined constant that equals a randomly chosen set of edges joining   *)\0a(* the nodes in Nodes.  Thus it can be used to test the algorithm of       *)\0a(* SpanTree on a randomly chosen node, making it easy to check the         *)\0a(* algorithm on a sequence of different graphs.                            *)\0a(***************************************************************************)\0aEXTENDS Integers, FiniteSets, TLC\0a\0aCONSTANTS Nodes, Root, MaxCardinality\0a\0aEdges == \0a  UNION { {{n, m} : m \\in RandomElement(SUBSET (Nodes\\{n}))} : n \\in Nodes }\0a  (*************************************************************************)\0a  (* To understand this definition let\'s look at its subformulas, from the *)\0a  (* inside out.                                                           *)\0a  (*                                                                       *)\0a  (*  - SUBSET (Nodes \\ {n})  is the set of all subsets of the set         *)\0a  (*    Nodes \\ {n} , which is the set of all nodes other than n.          *)\0a  (*                                                                       *)\0a  (*  - RandomElement(...)  is a hack introduced in the TLC module.  TLC   *)\0a  (*    computes its value to be a randomly chosen element in the set      *)\0a  (*    ... . This is hack because, in math, an expression has the same    *)\0a  (*    value whenever it\'s computed.  The value of 2^{1/2} is the same    *)\0a  (*    next Thursday as it is today.  Every mathematical expression exp   *)\0a  (*    satisfies exp = exp.  However, TLC may evaluate                    *)\0a  (*                                                                       *)\0a  (*       RandomElement(S) = RandomElement(S)                             *)\0a  (*                                                                       *)\0a  (*    to equal FALSE if S is a set with more than 1 element, This is     *)\0a  (*    one of the few cases in which TLC does not obey the rules of math. *)\0a  (*                                                                       *)\0a  (*  - {{n, m} : m \\in RandomElement(...)}  is the set of  elements that  *)\0a  (*    equal the set {n, m} for m some element of RandomElement(...) .    *)\0a  (*                                                                       *)\0a  (*  - UNION { ... : n \\in Nodes }  is the union of all sets ...  for n   *)\0a  (*    an element of Nodes.  This expression makes sense if the           *)\0a  (*    expression equals a set that depends on the value of n.            *)\0a  (*************************************************************************)\0a\0aASSUME /\\ Root \\in Nodes\0a       /\\ MaxCardinality \\in Nat\0a       /\\ MaxCardinality >= Cardinality(Nodes)\0a       \0aVARIABLES mom, dist\0avars == <<mom, dist>>\0a\0aNbrs(n) == {m \\in Nodes : {m, n} \\in Edges}\0a\0aTypeOK == /\\ mom \\in [Nodes -> Nodes]\0a          /\\ dist \\in [Nodes -> Nat]\0a          /\\ \\A e \\in Edges : (e \\subseteq Nodes) /\\ (Cardinality(e) = 2)\0a\0aInit == /\\ mom = [n \\in Nodes |-> n]\0a        /\\ dist = [n \\in Nodes |-> IF n = Root THEN 0 ELSE MaxCardinality]\0a        \0aNext == \\E n \\in Nodes :\0a          \\E m \\in Nbrs(n) : \0a             /\\ dist[m] < 1 + dist[n]\0a             /\\ \\E d \\in (dist[m]+1) .. (dist[n] - 1) :\0a                    /\\ dist\' = [dist EXCEPT ![n] = d]\0a                    /\\ mom\'  = [mom  EXCEPT ![n] = m]\0a\0aSpec == Init /\\ [][Next]_vars /\\ WF_vars(Next)\0a-----------------------------------------------------------------------------\0aPostCondition == \0a  \\A n \\in Nodes :\0a    \\/ /\\ n = Root \0a       /\\ dist[n] = 0\0a       /\\ mom[n] = n\0a    \\/ /\\ dist[n] = MaxCardinality \0a       /\\ mom[n] = n\0a       /\\ \\A m \\in Nbrs(n) : dist[m] = MaxCardinality\0a    \\/ /\\ dist[n] \\in 1..(MaxCardinality-1)\0a       /\\ mom[n] \\in Nbrs(n)\0a       /\\ dist[n] = dist[mom[n]] + 1\0a\0aSafety == []((~ ENABLED Next) => PostCondition)\0a\0aLiveness == <>PostCondition\0a(***************************************************************************)\0a(* Model Model_1 has TLC check these correctness condition for a (randomly *)\0a(* chosen) graph with six nodes.  On a few tries, it took TLC an average   *)\0a(* of a little more than 30 seconds to do it.                              *)\0a(***************************************************************************)\0aNextAlwaysEnabled == []<>(ENABLED Next)\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Mon Jun 17 05:39:15 PDT 2019 by lamport\0a\\* Created Fri Jun 14 03:07:58 PDT 2019 by lamport\0a']]]
      ['examples/SpanningTree/SpanTreeTest' 'SpanTreeTest' %accept ~[['SpanTreeTest' '------------------------------ MODULE SpanTreeTest ------------------------------\0a(***************************************************************************)\0a(* The specification in this module is a modified version of the one in    *)\0a(* module SpanTree obtained by replacing the declared constant Edges with  *)\0a(* a variable of the same name that is set initially to any possible set   *)\0a(* of edges with nodes in Nodes.  Thus, it can be used to test the         *)\0a(* algorithm of SpanTree on all possible graphs having a particular number *)\0a(* of nodes.                                                               *)\0a(***************************************************************************)\0aEXTENDS Integers, FiniteSets, Randomization\0a\0aCONSTANTS Nodes, Root, MaxCardinality\0a\0aASSUME /\\ Root \\in Nodes\0a       /\\ MaxCardinality \\in Nat\0a       /\\ MaxCardinality >= Cardinality(Nodes)\0a       \0aVARIABLES mom, dist, Edges\0avars == <<mom, dist, Edges>>\0a\0aNbrs(n) == {m \\in Nodes : {m, n} \\in Edges}\0a\0aTypeOK == /\\ mom \\in [Nodes -> Nodes]\0a          /\\ dist \\in [Nodes -> Nat]\0a          /\\ \\A e \\in Edges : (e \\subseteq Nodes) /\\ (Cardinality(e) = 2)\0a\0aInit == /\\ mom = [n \\in Nodes |-> n]\0a        /\\ dist = [n \\in Nodes |-> IF n = Root THEN 0 ELSE MaxCardinality]\0a        /\\ Edges \\in {E \\in SUBSET (SUBSET Nodes) : \\A e \\in E : Cardinality(e) = 2}\0a           (****************************************************************)\0a           (* SUBSET S is the set of all subsets of a set S.  Thus, this   *)\0a           (* allows Edges to have as its initial value any set of sets of *)\0a           (* nodes containing exactly two nodes.                          *)\0a           (****************************************************************)\0a        \0aNext == \\E n \\in Nodes :\0a          \\E m \\in Nbrs(n) : \0a             /\\ dist[m] < 1 + dist[n]\0a             /\\ \\E d \\in (dist[m]+1) .. (dist[n] - 1) :\0a                    /\\ dist\' = [dist EXCEPT ![n] = d]\0a                    /\\ mom\'  = [mom  EXCEPT ![n] = m]\0a                    /\\ Edges\' = Edges\0a\0aSpec == Init /\\ [][Next]_vars /\\ WF_vars(Next)\0a-----------------------------------------------------------------------------\0aPostCondition == \0a  \\A n \\in Nodes :\0a    \\/ /\\ n = Root \0a       /\\ dist[n] = 0\0a       /\\ mom[n] = n\0a    \\/ /\\ dist[n] = MaxCardinality \0a       /\\ mom[n] = n\0a       /\\ \\A m \\in Nbrs(n) : dist[m] = MaxCardinality\0a    \\/ /\\ dist[n] \\in 1..(MaxCardinality-1)\0a       /\\ mom[n] \\in Nbrs(n)\0a       /\\ dist[n] = dist[mom[n]] + 1\0a\0aSafety == []((~ ENABLED Next) => PostCondition)\0a\0aLiveness == <>PostCondition\0a(***************************************************************************)\0a(* This took a few seconds to check for 4 nodes, and about 25 minutes for  *)\0a(* 5 nodes on my laptop.  To compute the initial value of Edges, TLC has   *)\0a(* to compute all the elements of SUBSET (SUBSET Nodes) (the set of all    *)\0a(* subsets of the set of all sets of nodes) and then throw away all the    *)\0a(* elements of that set that don\'t consist entirely of sets having         *)\0a(* cardinality 2.  For N nodes, SUBSET(SUBSET Nodes) contains 2^(2^N)      *)\0a(* elements.                                                               *)\0a(***************************************************************************)\0aAllDistancesOne == <>[](\\A n \\in Nodes : dist[n] = 1)\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Mon Jun 17 05:43:38 PDT 2019 by lamport\0a\\* Created Fri Jun 14 03:07:58 PDT 2019 by lamport\0a']]]
      ['examples/SpecifyingSystems/CachingMemory/InternalMemory' 'InternalMemory' %accept ~[['InternalMemory' '------------------ MODULE InternalMemory ---------------------\0aEXTENDS MemoryInterface\0aVARIABLES mem, ctl, buf\0a--------------------------------------------------------------\0aIInit == /\\ mem \\in [Adr->Val]\0a         /\\ ctl = [p \\in Proc |-> "rdy"] \0a         /\\ buf = [p \\in Proc |-> NoVal] \0a         /\\ memInt \\in InitMemInt\0a\0aTypeInvariant == \0a  /\\ mem \\in [Adr->Val]\0a  /\\ ctl \\in [Proc -> {"rdy", "busy","done"}] \0a  /\\ buf \\in [Proc -> MReq \\cup Val \\cup {NoVal}]\0a\0aReq(p) == /\\ ctl[p] = "rdy" \0a          /\\ \\E req \\in  MReq :\0a                /\\ Send(p, req, memInt, memInt\') \0a                /\\ buf\' = [buf EXCEPT ![p] = req]\0a                /\\ ctl\' = [ctl EXCEPT ![p] = "busy"]\0a          /\\ UNCHANGED mem \0a\0aDo(p) == \0a  /\\ ctl[p] = "busy" \0a  /\\ mem\' = IF buf[p].op = "Wr"\0a              THEN [mem EXCEPT ![buf[p].adr] = buf[p].val] \0a              ELSE mem \0a  /\\ buf\' = [buf EXCEPT ![p] = IF buf[p].op = "Wr"\0a                                  THEN NoVal\0a                                  ELSE mem[buf[p].adr]]\0a  /\\ ctl\' = [ctl EXCEPT ![p] = "done"] \0a  /\\ UNCHANGED memInt \0a\0aRsp(p) == /\\ ctl[p] = "done"\0a          /\\ Reply(p, buf[p], memInt, memInt\')\0a          /\\ ctl\' = [ctl EXCEPT ![p]= "rdy"]\0a          /\\ UNCHANGED <<mem, buf>> \0a\0aINext == \\E p \\in Proc: Req(p) \\/ Do(p) \\/ Rsp(p) \0a\0aISpec == IInit  /\\  [][INext]_<<memInt, mem, ctl, buf>>\0a--------------------------------------------------------------\0aTHEOREM ISpec => []TypeInvariant\0a==============================================================\0a'] ['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a']]]
      ['examples/SpecifyingSystems/CachingMemory/Memory' 'Memory' %accept ~[['Memory' '----------------------- MODULE Memory ------------------------\0aEXTENDS MemoryInterface\0aInner(mem, ctl, buf) == INSTANCE InternalMemory \0aSpec == \\EE mem, ctl, buf : Inner(mem, ctl, buf)!ISpec \0a==============================================================\0a\0a'] ['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a'] ['InternalMemory' '------------------ MODULE InternalMemory ---------------------\0aEXTENDS MemoryInterface\0aVARIABLES mem, ctl, buf\0a--------------------------------------------------------------\0aIInit == /\\ mem \\in [Adr->Val]\0a         /\\ ctl = [p \\in Proc |-> "rdy"] \0a         /\\ buf = [p \\in Proc |-> NoVal] \0a         /\\ memInt \\in InitMemInt\0a\0aTypeInvariant == \0a  /\\ mem \\in [Adr->Val]\0a  /\\ ctl \\in [Proc -> {"rdy", "busy","done"}] \0a  /\\ buf \\in [Proc -> MReq \\cup Val \\cup {NoVal}]\0a\0aReq(p) == /\\ ctl[p] = "rdy" \0a          /\\ \\E req \\in  MReq :\0a                /\\ Send(p, req, memInt, memInt\') \0a                /\\ buf\' = [buf EXCEPT ![p] = req]\0a                /\\ ctl\' = [ctl EXCEPT ![p] = "busy"]\0a          /\\ UNCHANGED mem \0a\0aDo(p) == \0a  /\\ ctl[p] = "busy" \0a  /\\ mem\' = IF buf[p].op = "Wr"\0a              THEN [mem EXCEPT ![buf[p].adr] = buf[p].val] \0a              ELSE mem \0a  /\\ buf\' = [buf EXCEPT ![p] = IF buf[p].op = "Wr"\0a                                  THEN NoVal\0a                                  ELSE mem[buf[p].adr]]\0a  /\\ ctl\' = [ctl EXCEPT ![p] = "done"] \0a  /\\ UNCHANGED memInt \0a\0aRsp(p) == /\\ ctl[p] = "done"\0a          /\\ Reply(p, buf[p], memInt, memInt\')\0a          /\\ ctl\' = [ctl EXCEPT ![p]= "rdy"]\0a          /\\ UNCHANGED <<mem, buf>> \0a\0aINext == \\E p \\in Proc: Req(p) \\/ Do(p) \\/ Rsp(p) \0a\0aISpec == IInit  /\\  [][INext]_<<memInt, mem, ctl, buf>>\0a--------------------------------------------------------------\0aTHEOREM ISpec => []TypeInvariant\0a==============================================================\0a']]]
      ['examples/SpecifyingSystems/CachingMemory/MemoryInterface' 'MemoryInterface' %accept ~[['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a']]]
      ['examples/SpecifyingSystems/CachingMemory/WriteThroughCache' 'WriteThroughCache' %accept ~[['WriteThroughCache' '------------------ MODULE WriteThroughCache ------------------\0aEXTENDS Naturals, Sequences, MemoryInterface \0aVARIABLES wmem, ctl, buf, cache, memQ \0aCONSTANT QLen\0aASSUME (QLen \\in Nat) /\\ (QLen > 0) \0aM == INSTANCE InternalMemory WITH mem <- wmem\0a--------------------------------------------------------------\0aInit == /\\ M!IInit \0a        /\\ cache = [p \\in Proc |-> [a \\in Adr |-> NoVal] ]\0a        /\\ memQ = << >>  \0a \0aTypeInvariant == \0a  /\\ wmem  \\in [Adr -> Val]\0a  /\\ ctl   \\in [Proc -> {"rdy", "busy", "waiting", "done"}] \0a  /\\ buf   \\in [Proc -> MReq \\cup Val \\cup {NoVal}]\0a  /\\ cache \\in [Proc -> [Adr -> Val \\cup {NoVal}]] \0a  /\\ memQ  \\in Seq(Proc \\X MReq) \0a\0aCoherence == \\A p, q \\in Proc, a \\in Adr : \0a                (NoVal \\notin {cache[p][a], cache[q][a]})\0a                      => (cache[p][a]=cache[q][a]) \0a--------------------------------------------------------------\0aReq(p) == M!Req(p) /\\ UNCHANGED <<cache, memQ>> \0aRsp(p) == M!Rsp(p) /\\ UNCHANGED <<cache, memQ>> \0a\0aRdMiss(p) ==  /\\ (ctl[p] = "busy") /\\ (buf[p].op = "Rd") \0a              /\\ cache[p][buf[p].adr] = NoVal \0a              /\\ Len(memQ) < QLen\0a              /\\ memQ\' = Append(memQ, <<p, buf[p]>>)\0a              /\\ ctl\' = [ctl EXCEPT ![p] = "waiting"]\0a              /\\ UNCHANGED <<memInt, wmem, buf, cache>>\0a\0aDoRd(p) == \0a  /\\ ctl[p] \\in {"busy","waiting"} \0a  /\\ buf[p].op = "Rd" \0a  /\\ cache[p][buf[p].adr] # NoVal\0a  /\\ buf\' = [buf EXCEPT ![p] = cache[p][buf[p].adr]]\0a  /\\ ctl\' = [ctl EXCEPT ![p] = "done"]\0a  /\\ UNCHANGED <<memInt, wmem, cache, memQ>> \0a\0aDoWr(p) == \0a  LET r == buf[p]\0a  IN  /\\ (ctl[p] = "busy") /\\ (r.op = "Wr") \0a      /\\ Len(memQ) < QLen\0a      /\\ cache\' = [q \\in Proc |-> \0a                    IF (p=q)  \\/  (cache[q][r.adr]#NoVal)\0a                      THEN [cache[q] EXCEPT ![r.adr] = r.val]\0a                      ELSE cache[q] ]\0a      /\\ memQ\' = Append(memQ, <<p, r>>)\0a      /\\ buf\' = [buf EXCEPT ![p] = NoVal]\0a      /\\ ctl\' = [ctl EXCEPT ![p] = "done"]\0a      /\\ UNCHANGED <<memInt, wmem>> \0a\0avmem  ==  \0a  LET f[i \\in 0 .. Len(memQ)] == \0a        IF i=0 THEN wmem\0a               ELSE IF memQ[i][2].op = "Rd"\0a                      THEN f[i-1]\0a                      ELSE [f[i-1] EXCEPT ![memQ[i][2].adr] =\0a                                              memQ[i][2].val]\0a  IN f[Len(memQ)] \0a\0aMemQWr == LET r == Head(memQ)[2] \0a          IN  /\\ (memQ # << >>)  /\\   (r.op = "Wr") \0a              /\\ wmem\' = [wmem EXCEPT ![r.adr] = r.val] \0a              /\\ memQ\' = Tail(memQ) \0a              /\\ UNCHANGED <<memInt, buf, ctl, cache>> \0a\0aMemQRd == \0a  LET p == Head(memQ)[1] \0a      r == Head(memQ)[2] \0a  IN  /\\ (memQ # << >> ) /\\ (r.op = "Rd")\0a      /\\ memQ\' = Tail(memQ)\0a      /\\ cache\' = [cache EXCEPT ![p][r.adr] = vmem[r.adr]]\0a      /\\ UNCHANGED <<memInt, wmem, buf, ctl>>  \0a\0aEvict(p,a) == /\\ (ctl[p] = "waiting") => (buf[p].adr # a) \0a              /\\ cache\' = [cache EXCEPT ![p][a] = NoVal]\0a              /\\ UNCHANGED <<memInt, wmem, buf, ctl, memQ>> \0a\0aNext == \\/ \\E p\\in Proc : \\/ Req(p) \\/ Rsp(p) \0a                          \\/ RdMiss(p) \\/ DoRd(p) \\/ DoWr(p) \0a                          \\/ \\E a \\in Adr : Evict(p, a)\0a        \\/ MemQWr \\/ MemQRd    \0a\0aSpec == \0a  Init /\\ [][Next]_<<memInt, wmem, buf, ctl, cache, memQ>>\0a--------------------------------------------------------------\0aTHEOREM Spec => [](TypeInvariant /\\ Coherence)\0a--------------------------------------------------------------\0aLM == INSTANCE Memory \0aTHEOREM Spec => LM!Spec \0a==============================================================\0a'] ['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a'] ['Memory' '----------------------- MODULE Memory ------------------------\0aEXTENDS MemoryInterface\0aInner(mem, ctl, buf) == INSTANCE InternalMemory \0aSpec == \\EE mem, ctl, buf : Inner(mem, ctl, buf)!ISpec \0a==============================================================\0a\0a'] ['InternalMemory' '------------------ MODULE InternalMemory ---------------------\0aEXTENDS MemoryInterface\0aVARIABLES mem, ctl, buf\0a--------------------------------------------------------------\0aIInit == /\\ mem \\in [Adr->Val]\0a         /\\ ctl = [p \\in Proc |-> "rdy"] \0a         /\\ buf = [p \\in Proc |-> NoVal] \0a         /\\ memInt \\in InitMemInt\0a\0aTypeInvariant == \0a  /\\ mem \\in [Adr->Val]\0a  /\\ ctl \\in [Proc -> {"rdy", "busy","done"}] \0a  /\\ buf \\in [Proc -> MReq \\cup Val \\cup {NoVal}]\0a\0aReq(p) == /\\ ctl[p] = "rdy" \0a          /\\ \\E req \\in  MReq :\0a                /\\ Send(p, req, memInt, memInt\') \0a                /\\ buf\' = [buf EXCEPT ![p] = req]\0a                /\\ ctl\' = [ctl EXCEPT ![p] = "busy"]\0a          /\\ UNCHANGED mem \0a\0aDo(p) == \0a  /\\ ctl[p] = "busy" \0a  /\\ mem\' = IF buf[p].op = "Wr"\0a              THEN [mem EXCEPT ![buf[p].adr] = buf[p].val] \0a              ELSE mem \0a  /\\ buf\' = [buf EXCEPT ![p] = IF buf[p].op = "Wr"\0a                                  THEN NoVal\0a                                  ELSE mem[buf[p].adr]]\0a  /\\ ctl\' = [ctl EXCEPT ![p] = "done"] \0a  /\\ UNCHANGED memInt \0a\0aRsp(p) == /\\ ctl[p] = "done"\0a          /\\ Reply(p, buf[p], memInt, memInt\')\0a          /\\ ctl\' = [ctl EXCEPT ![p]= "rdy"]\0a          /\\ UNCHANGED <<mem, buf>> \0a\0aINext == \\E p \\in Proc: Req(p) \\/ Do(p) \\/ Rsp(p) \0a\0aISpec == IInit  /\\  [][INext]_<<memInt, mem, ctl, buf>>\0a--------------------------------------------------------------\0aTHEOREM ISpec => []TypeInvariant\0a==============================================================\0a']]]
      ['examples/SpecifyingSystems/Liveness/HourClock' 'HourClock' %accept ~[['HourClock' '---------------------- MODULE HourClock ----------------------\0aEXTENDS Naturals\0aVARIABLE hr\0aHCini  ==  hr \\in (1 .. 12)\0aHCnxt  ==  hr\' = IF hr # 12 THEN hr + 1 ELSE 1\0aHC  ==  HCini /\\ [][HCnxt]_hr\0a--------------------------------------------------------------\0aTHEOREM  HC => []HCini\0a==============================================================\0a']]]
      ['examples/SpecifyingSystems/Liveness/InternalMemory' 'InternalMemory' %accept ~[['InternalMemory' '------------------ MODULE InternalMemory ---------------------\0aEXTENDS MemoryInterface\0aVARIABLES mem, ctl, buf\0a--------------------------------------------------------------\0aIInit == /\\ mem \\in [Adr->Val]\0a         /\\ ctl = [p \\in Proc |-> "rdy"] \0a         /\\ buf = [p \\in Proc |-> NoVal] \0a         /\\ memInt \\in InitMemInt\0a\0aTypeInvariant == \0a  /\\ mem \\in [Adr->Val]\0a  /\\ ctl \\in [Proc -> {"rdy", "busy","done"}] \0a  /\\ buf \\in [Proc -> MReq \\cup Val \\cup {NoVal}]\0a\0aReq(p) == /\\ ctl[p] = "rdy" \0a          /\\ \\E req \\in  MReq : \0a                /\\ Send(p, req, memInt, memInt\') \0a                /\\ buf\' = [buf EXCEPT ![p] = req]\0a                /\\ ctl\' = [ctl EXCEPT ![p] = "busy"]\0a          /\\ UNCHANGED mem \0a\0aDo(p) == \0a  /\\ ctl[p] = "busy" \0a  /\\ mem\' = IF buf[p].op = "Wr"\0a              THEN [mem EXCEPT ![buf[p].adr] = buf[p].val] \0a              ELSE mem \0a  /\\ buf\' = [buf EXCEPT ![p] = IF buf[p].op = "Wr"\0a                                  THEN NoVal\0a                                  ELSE mem[buf[p].adr]]\0a  /\\ ctl\' = [ctl EXCEPT ![p] = "done"] \0a  /\\ UNCHANGED memInt \0a\0aRsp(p) == /\\ ctl[p] = "done"\0a          /\\ Reply(p, buf[p], memInt, memInt\')\0a          /\\ ctl\' = [ctl EXCEPT ![p]= "rdy"]\0a          /\\ UNCHANGED <<mem, buf>> \0a\0aINext == \\E p \\in Proc: Req(p) \\/ Do(p) \\/ Rsp(p) \0a\0aISpec == IInit  /\\  [][INext]_<<memInt, mem, ctl, buf>>\0a--------------------------------------------------------------\0aTHEOREM ISpec => []TypeInvariant\0a==============================================================\0a'] ['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a']]]
      ['examples/SpecifyingSystems/Liveness/LiveHourClock' 'LiveHourClock' %accept ~[['LiveHourClock' '--------------------------- MODULE LiveHourClock ----------------------------\0a(***************************************************************************)\0a(* This module adds the liveness condition to the hour clock specification *)\0a(* of module HourClock.                                                    *)\0a(***************************************************************************)\0a\0aEXTENDS HourClock, TLC, TLCExt\0a\0aLSpec == HC /\\ WF_hr(HCnxt)\0a  (*************************************************************************)\0a  (* The specification with the liveness condition conjoined.              *)\0a  (*************************************************************************)\0a\0a(***************************************************************************)\0a(* We now define some properties that LSpec satisfies.                     *)\0a(***************************************************************************)\0aAlwaysTick == []<><<HCnxt>>_hr\0a  (*************************************************************************)\0a  (* Asserts that infinitely many <<HCnxt>>_hr steps occur.                *)\0a  (*************************************************************************)\0a\0aAllTimes == \\A n \\in 1..12 : []<>(hr = n)\0a  (*************************************************************************)\0a  (* Asserts that, for each time n in 1..12, hr infinitely often equals n. *)\0a  (*************************************************************************)\0a\0aTypeInvariance == []HCini\0a  (*************************************************************************)\0a  (* The temporal formula asserting that HCini is always true.  It is      *)\0a  (* stated in this way to show you another way of telling TLC to check an *)\0a  (* invariant.                                                            *)\0a  (*************************************************************************)\0a  \0a-----------------------------------------------------------------------------\0aTHEOREM  LSpec => AlwaysTick /\\ AllTimes /\\ TypeInvariance\0a\0aClockSettles == \\E n \\in 1..12 : <>[](hr = n)\0a\0aPostCondition ==\0a   CounterExample =\0a    [ action |->\0a      { << <<1, [hr |-> 1]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<2, [hr |-> 2]>> >>,\0a        << <<2, [hr |-> 2]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<3, [hr |-> 3]>> >>,\0a        << <<3, [hr |-> 3]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<4, [hr |-> 4]>> >>,\0a        << <<4, [hr |-> 4]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<5, [hr |-> 5]>> >>,\0a        << <<5, [hr |-> 5]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<6, [hr |-> 6]>> >>,\0a        << <<6, [hr |-> 6]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<7, [hr |-> 7]>> >>,\0a        << <<7, [hr |-> 7]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<8, [hr |-> 8]>> >>,\0a        << <<8, [hr |-> 8]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<9, [hr |-> 9]>> >>,\0a        << <<9, [hr |-> 9]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<10, [hr |-> 10]>> >>,\0a        << <<10, [hr |-> 10]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<11, [hr |-> 11]>> >>,\0a        << <<11, [hr |-> 11]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<12, [hr |-> 12]>> >>,\0a        << <<12, [hr |-> 12]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<1, [hr |-> 1]>> >> },\0a  state |->\0a      { <<1, [hr |-> 1]>>,\0a        <<2, [hr |-> 2]>>,\0a        <<3, [hr |-> 3]>>,\0a        <<4, [hr |-> 4]>>,\0a        <<5, [hr |-> 5]>>,\0a        <<6, [hr |-> 6]>>,\0a        <<7, [hr |-> 7]>>,\0a        <<8, [hr |-> 8]>>,\0a        <<9, [hr |-> 9]>>,\0a        <<10, [hr |-> 10]>>,\0a        <<11, [hr |-> 11]>>,\0a        <<12, [hr |-> 12]>> } ]\0a=============================================================================\0a\0a'] ['HourClock' '---------------------- MODULE HourClock ----------------------\0aEXTENDS Naturals\0aVARIABLE hr\0aHCini  ==  hr \\in (1 .. 12)\0aHCnxt  ==  hr\' = IF hr # 12 THEN hr + 1 ELSE 1\0aHC  ==  HCini /\\ [][HCnxt]_hr\0a--------------------------------------------------------------\0aTHEOREM  HC => []HCini\0a==============================================================\0a']]]
      ['examples/SpecifyingSystems/Liveness/LiveInternalMemory' 'LiveInternalMemory' %accept ~[['LiveInternalMemory' '------------------------ MODULE LiveInternalMemory --------------------------\0a\0a(***************************************************************************)\0a(* This module defines LISpec to be specification ISpec of module          *)\0a(* InternalMemory enhanced with the liveness condition described in the    *)\0a(* subsection "The Liveness Requirement" of the section "The Memory        *)\0a(* Specification".                                                         *)\0a(***************************************************************************)\0a\0aEXTENDS InternalMemory\0a\0avars == <<memInt, mem, ctl, buf>>\0a  (*************************************************************************)\0a  (* The tuple of all variables.                                           *)\0a  (*************************************************************************)\0a  \0aLiveness == \\A p \\in Proc : WF_vars(Do(p)) /\\ WF_vars(Rsp(p))\0aLiveness2 == \\A p \\in Proc : WF_vars(Do(p) \\/ Rsp(p))\0a  (*************************************************************************)\0a  (* The two versions of the liveness condition defined in the book.       *)\0a  (*************************************************************************)\0a  \0aLISpec == ISpec /\\ Liveness2\0a  (*************************************************************************)\0a  (* The spec with liveness.                                               *)\0a  (*************************************************************************)\0a\0a(***************************************************************************)\0a(* The following property asserts that, whenever any processor p has       *)\0a(* issued a request, so ctl[p] = "busy", then a response eventually occurs,*)\0a(* setting ctl[p] to "rdy".                                                *)\0a(***************************************************************************)\0a\0aLivenessProperty == \0a   \\A p \\in Proc : (ctl[p] = "busy") ~> (ctl[p] = "rdy")\0a\0a-----------------------------------------------------------------------------\0a(***************************************************************************)\0a(* The following theorem asserts that specification LISpec satisfies       *)\0a(* property LivenessProperty.  The accompanying configuration file has TLC *)\0a(* check this theorem.                                                     *)\0a(***************************************************************************)\0a\0aTHEOREM LISpec => LivenessProperty\0a=============================================================================\0a'] ['InternalMemory' '------------------ MODULE InternalMemory ---------------------\0aEXTENDS MemoryInterface\0aVARIABLES mem, ctl, buf\0a--------------------------------------------------------------\0aIInit == /\\ mem \\in [Adr->Val]\0a         /\\ ctl = [p \\in Proc |-> "rdy"] \0a         /\\ buf = [p \\in Proc |-> NoVal] \0a         /\\ memInt \\in InitMemInt\0a\0aTypeInvariant == \0a  /\\ mem \\in [Adr->Val]\0a  /\\ ctl \\in [Proc -> {"rdy", "busy","done"}] \0a  /\\ buf \\in [Proc -> MReq \\cup Val \\cup {NoVal}]\0a\0aReq(p) == /\\ ctl[p] = "rdy" \0a          /\\ \\E req \\in  MReq : \0a                /\\ Send(p, req, memInt, memInt\') \0a                /\\ buf\' = [buf EXCEPT ![p] = req]\0a                /\\ ctl\' = [ctl EXCEPT ![p] = "busy"]\0a          /\\ UNCHANGED mem \0a\0aDo(p) == \0a  /\\ ctl[p] = "busy" \0a  /\\ mem\' = IF buf[p].op = "Wr"\0a              THEN [mem EXCEPT ![buf[p].adr] = buf[p].val] \0a              ELSE mem \0a  /\\ buf\' = [buf EXCEPT ![p] = IF buf[p].op = "Wr"\0a                                  THEN NoVal\0a                                  ELSE mem[buf[p].adr]]\0a  /\\ ctl\' = [ctl EXCEPT ![p] = "done"] \0a  /\\ UNCHANGED memInt \0a\0aRsp(p) == /\\ ctl[p] = "done"\0a          /\\ Reply(p, buf[p], memInt, memInt\')\0a          /\\ ctl\' = [ctl EXCEPT ![p]= "rdy"]\0a          /\\ UNCHANGED <<mem, buf>> \0a\0aINext == \\E p \\in Proc: Req(p) \\/ Do(p) \\/ Rsp(p) \0a\0aISpec == IInit  /\\  [][INext]_<<memInt, mem, ctl, buf>>\0a--------------------------------------------------------------\0aTHEOREM ISpec => []TypeInvariant\0a==============================================================\0a'] ['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a']]]
      ['examples/SpecifyingSystems/Liveness/Memory' 'Memory' %accept ~[['Memory' '----------------------- MODULE Memory ------------------------\0aEXTENDS MemoryInterface\0aInner(mem, ctl, buf) == INSTANCE InternalMemory \0aSpec == \\EE mem, ctl, buf : Inner(mem, ctl, buf)!ISpec \0a==============================================================\0a\0a'] ['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a'] ['InternalMemory' '------------------ MODULE InternalMemory ---------------------\0aEXTENDS MemoryInterface\0aVARIABLES mem, ctl, buf\0a--------------------------------------------------------------\0aIInit == /\\ mem \\in [Adr->Val]\0a         /\\ ctl = [p \\in Proc |-> "rdy"] \0a         /\\ buf = [p \\in Proc |-> NoVal] \0a         /\\ memInt \\in InitMemInt\0a\0aTypeInvariant == \0a  /\\ mem \\in [Adr->Val]\0a  /\\ ctl \\in [Proc -> {"rdy", "busy","done"}] \0a  /\\ buf \\in [Proc -> MReq \\cup Val \\cup {NoVal}]\0a\0aReq(p) == /\\ ctl[p] = "rdy" \0a          /\\ \\E req \\in  MReq : \0a                /\\ Send(p, req, memInt, memInt\') \0a                /\\ buf\' = [buf EXCEPT ![p] = req]\0a                /\\ ctl\' = [ctl EXCEPT ![p] = "busy"]\0a          /\\ UNCHANGED mem \0a\0aDo(p) == \0a  /\\ ctl[p] = "busy" \0a  /\\ mem\' = IF buf[p].op = "Wr"\0a              THEN [mem EXCEPT ![buf[p].adr] = buf[p].val] \0a              ELSE mem \0a  /\\ buf\' = [buf EXCEPT ![p] = IF buf[p].op = "Wr"\0a                                  THEN NoVal\0a                                  ELSE mem[buf[p].adr]]\0a  /\\ ctl\' = [ctl EXCEPT ![p] = "done"] \0a  /\\ UNCHANGED memInt \0a\0aRsp(p) == /\\ ctl[p] = "done"\0a          /\\ Reply(p, buf[p], memInt, memInt\')\0a          /\\ ctl\' = [ctl EXCEPT ![p]= "rdy"]\0a          /\\ UNCHANGED <<mem, buf>> \0a\0aINext == \\E p \\in Proc: Req(p) \\/ Do(p) \\/ Rsp(p) \0a\0aISpec == IInit  /\\  [][INext]_<<memInt, mem, ctl, buf>>\0a--------------------------------------------------------------\0aTHEOREM ISpec => []TypeInvariant\0a==============================================================\0a']]]
      ['examples/SpecifyingSystems/Liveness/MemoryInterface' 'MemoryInterface' %accept ~[['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a']]]
      ['examples/SpecifyingSystems/TLC/ABCorrectness' 'ABCorrectness' %accept ~[['ABCorrectness' '------------------- MODULE ABCorrectness --------------------\0aEXTENDS Naturals\0aCONSTANTS Data\0aVARIABLES sBit, sAck, rBit, sent, rcvd  \0a-------------------------------------------------------------\0aABCInit == /\\ sBit \\in {0, 1}\0a           /\\ sAck = sBit\0a           /\\ rBit = sBit\0a           /\\ sent \\in Data\0a           /\\ rcvd \\in Data\0a\0aCSndNewValue(d) == /\\ sAck = sBit\0a                   /\\ sent\' = d\0a                   /\\ sBit\' = 1 - sBit\0a                   /\\ UNCHANGED <<sAck, rBit, rcvd>>\0a\0aCRcvMsg == /\\ rBit # sBit \0a           /\\ rBit\' = sBit\0a           /\\ rcvd\' = sent\0a           /\\ UNCHANGED <<sBit, sAck, sent>>\0a\0aCRcvAck == /\\ rBit # sAck\0a           /\\ sAck\' = rBit\0a           /\\ UNCHANGED <<sBit, rBit, sent, rcvd>>\0a\0aABCNext == \\/  \\E d \\in Data : CSndNewValue(d) \0a           \\/  CRcvMsg \\/ CRcvAck \0a-------------------------------------------------------------\0acvars == <<sBit, sAck, rBit, sent, rcvd>>\0a\0aTypeInv == /\\ sBit \\in {0, 1}\0a           /\\ sAck \\in {0, 1}\0a           /\\ rBit \\in {0, 1}\0a           /\\ sent \\in Data\0a           /\\ rcvd \\in Data\0a\0aABCFairness == WF_cvars(CRcvMsg) /\\ WF_cvars(CRcvAck)   \0a\0aABCSpec == ABCInit /\\ [][ABCNext]_cvars /\\ ABCFairness\0a\0aInfOftenOutOfSync == []<>(sBit # sAck)\0a==============================================================\0a']]]
      ['examples/SpecifyingSystems/TLC/AlternatingBit' 'AlternatingBit' %accept ~[['AlternatingBit' '--------------------------- MODULE AlternatingBit ---------------------------\0aEXTENDS Naturals, Sequences\0aCONSTANTS Data\0aVARIABLES msgQ, \0a          ackQ, \0a          sBit, \0a          sAck, \0a          rBit, \0a          sent, \0a          rcvd  \0a-----------------------------------------------------------------------------\0aABInit == /\\ msgQ = << >>\0a          /\\ ackQ = << >>\0a          /\\ sBit \\in {0, 1}\0a          /\\ sAck = sBit\0a          /\\ rBit = sBit\0a          /\\ sent \\in Data\0a          /\\ rcvd \\in Data\0a\0aABTypeInv == /\\ msgQ \\in Seq({0,1} \\X Data)\0a             /\\ ackQ \\in Seq({0,1})\0a             /\\ sBit \\in {0, 1}\0a             /\\ sAck \\in {0, 1}\0a             /\\ rBit \\in {0, 1}\0a             /\\ sent \\in Data\0a             /\\ rcvd \\in Data\0a-----------------------------------------------------------------------------\0aSndNewValue(d) == \0a  /\\ sAck = sBit\0a  /\\ sent\' = d\0a  /\\ sBit\' = 1 - sBit\0a  /\\ msgQ\' = Append(msgQ, <<sBit\', d>>) \0a  /\\ UNCHANGED <<ackQ, sAck, rBit, rcvd>>\0a\0aReSndMsg == \0a  /\\ sAck # sBit\0a  /\\ msgQ\' = Append(msgQ, <<sBit, sent>>)\0a  /\\ UNCHANGED <<ackQ, sBit, sAck, rBit, sent, rcvd>>\0a\0aRcvMsg == \0a  /\\ msgQ # <<>>\0a  /\\ msgQ\' = Tail(msgQ)\0a  /\\ rBit\' = Head(msgQ)[1] \0a  /\\ rcvd\' = Head(msgQ)[2] \0a  /\\ UNCHANGED <<ackQ, sBit, sAck, sent>>\0a\0aSndAck == /\\ ackQ\' = Append(ackQ, rBit)\0a          /\\ UNCHANGED <<msgQ, sBit, sAck, rBit, sent, rcvd>>\0a\0aRcvAck == /\\ ackQ # << >>\0a          /\\ ackQ\' = Tail(ackQ)\0a          /\\ sAck\' = Head(ackQ)\0a          /\\ UNCHANGED <<msgQ, sBit, rBit, sent, rcvd>>\0a\0aLose(q) == \0a   /\\ q # << >>\0a   /\\ \\E i \\in 1..Len(q) : \0a          q\' = [j \\in 1..(Len(q)-1) |-> IF j < i THEN q[j] \0a                                                 ELSE q[j+1] ]\0a   /\\ UNCHANGED <<sBit, sAck, rBit, sent, rcvd>>\0a\0aLoseMsg == Lose(msgQ) /\\ UNCHANGED ackQ\0a\0aLoseAck == Lose(ackQ) /\\ UNCHANGED msgQ\0a\0aABNext == \\/  \\E d \\in Data : SndNewValue(d) \0a          \\/  ReSndMsg \\/ RcvMsg \\/ SndAck \\/ RcvAck \0a          \\/  LoseMsg \\/ LoseAck \0a-----------------------------------------------------------------------------\0aabvars == << msgQ, ackQ, sBit, sAck, rBit, sent, rcvd>>\0a\0aABFairness == /\\ WF_abvars(ReSndMsg) /\\ WF_abvars(SndAck)   \0a              /\\ SF_abvars(RcvMsg) /\\ SF_abvars(RcvAck) \0a-----------------------------------------------------------------------------\0aABSpec == ABInit /\\ [][ABNext]_abvars /\\ ABFairness\0a-----------------------------------------------------------------------------\0aTHEOREM ABSpec => []ABTypeInv\0a=============================================================================\0a']]]
      ['examples/SpecifyingSystems/TLC/MCAlternatingBit' 'MCAlternatingBit' %accept ~[['MCAlternatingBit' '--------------------------- MODULE MCAlternatingBit -------------------------\0aEXTENDS AlternatingBit, TLC, TLCExt\0a\0aINSTANCE ABCorrectness \0a\0aCONSTANTS msgQLen, ackQLen\0a\0aSeqConstraint == /\\ Len(msgQ) \\leq msgQLen\0a                 /\\ Len(ackQ) \\leq ackQLen\0a\0aSentLeadsToRcvd == \\A d \\in Data : (sent = d) /\\ (sBit # sAck) ~> (rcvd = d)\0a\0aPermanentBitDisagreement == <>[](sBit # rBit)\0a\0aCONSTANT d1, d2\0a\0aPostCondition ==\0a   CounterExample = \0a   [ action |->\0a      { << << 1,\0a              [ msgQ |-> <<>>,\0a                ackQ |-> <<>>,\0a                sent |-> d1,\0a                sBit |-> 0,\0a                sAck |-> 0,\0a                rcvd |-> d1,\0a                rBit |-> 0 ] >>,\0a           [ name |-> "SndAck",\0a             location |->\0a                 [ beginLine |-> 47,\0a                   beginColumn |-> 11,\0a                   endLine |-> 48,\0a                   endColumn |-> 61,\0a                   module |-> "AlternatingBit" ] ],\0a           << 2,\0a              [ msgQ |-> <<>>,\0a                ackQ |-> <<0>>,\0a                sent |-> d1,\0a                sBit |-> 0,\0a                sAck |-> 0,\0a                rcvd |-> d1,\0a                rBit |-> 0 ] >> >>,\0a        << << 2,\0a              [ msgQ |-> <<>>,\0a                ackQ |-> <<0>>,\0a                sent |-> d1,\0a                sBit |-> 0,\0a                sAck |-> 0,\0a                rcvd |-> d1,\0a                rBit |-> 0 ] >>,\0a           [ name |-> "RcvAck",\0a             location |->\0a                 [ beginLine |-> 50,\0a                   beginColumn |-> 11,\0a                   endLine |-> 53,\0a                   endColumn |-> 55,\0a                   module |-> "AlternatingBit" ] ],\0a           << 1,\0a              [ msgQ |-> <<>>,\0a                ackQ |-> <<>>,\0a                sent |-> d1,\0a                sBit |-> 0,\0a                sAck |-> 0,\0a                rcvd |-> d1,\0a                rBit |-> 0 ] >> >> },\0a  state |->\0a      { << 1,\0a           [ msgQ |-> <<>>,\0a             ackQ |-> <<>>,\0a             sent |-> d1,\0a             sBit |-> 0,\0a             sAck |-> 0,\0a             rcvd |-> d1,\0a             rBit |-> 0 ] >>,\0a        << 2,\0a           [ msgQ |-> <<>>,\0a             ackQ |-> <<0>>,\0a             sent |-> d1,\0a             sBit |-> 0,\0a             sAck |-> 0,\0a             rcvd |-> d1,\0a             rBit |-> 0 ] >> } ]\0a=============================================================================\0a\0aImpliedAction == [ABCNext]_cvars\0a\0aTNext == WF_msgQ(~ABTypeInv\')\0aTProp == \\A d \\in Data : (sent = d) => [](sent = d)\0a\0aCSpec == ABSpec /\\ TNext\0a\0a\\* DataPerm == Permutations(Data)\0a==============================================================\0a'] ['AlternatingBit' '--------------------------- MODULE AlternatingBit ---------------------------\0aEXTENDS Naturals, Sequences\0aCONSTANTS Data\0aVARIABLES msgQ, \0a          ackQ, \0a          sBit, \0a          sAck, \0a          rBit, \0a          sent, \0a          rcvd  \0a-----------------------------------------------------------------------------\0aABInit == /\\ msgQ = << >>\0a          /\\ ackQ = << >>\0a          /\\ sBit \\in {0, 1}\0a          /\\ sAck = sBit\0a          /\\ rBit = sBit\0a          /\\ sent \\in Data\0a          /\\ rcvd \\in Data\0a\0aABTypeInv == /\\ msgQ \\in Seq({0,1} \\X Data)\0a             /\\ ackQ \\in Seq({0,1})\0a             /\\ sBit \\in {0, 1}\0a             /\\ sAck \\in {0, 1}\0a             /\\ rBit \\in {0, 1}\0a             /\\ sent \\in Data\0a             /\\ rcvd \\in Data\0a-----------------------------------------------------------------------------\0aSndNewValue(d) == \0a  /\\ sAck = sBit\0a  /\\ sent\' = d\0a  /\\ sBit\' = 1 - sBit\0a  /\\ msgQ\' = Append(msgQ, <<sBit\', d>>) \0a  /\\ UNCHANGED <<ackQ, sAck, rBit, rcvd>>\0a\0aReSndMsg == \0a  /\\ sAck # sBit\0a  /\\ msgQ\' = Append(msgQ, <<sBit, sent>>)\0a  /\\ UNCHANGED <<ackQ, sBit, sAck, rBit, sent, rcvd>>\0a\0aRcvMsg == \0a  /\\ msgQ # <<>>\0a  /\\ msgQ\' = Tail(msgQ)\0a  /\\ rBit\' = Head(msgQ)[1] \0a  /\\ rcvd\' = Head(msgQ)[2] \0a  /\\ UNCHANGED <<ackQ, sBit, sAck, sent>>\0a\0aSndAck == /\\ ackQ\' = Append(ackQ, rBit)\0a          /\\ UNCHANGED <<msgQ, sBit, sAck, rBit, sent, rcvd>>\0a\0aRcvAck == /\\ ackQ # << >>\0a          /\\ ackQ\' = Tail(ackQ)\0a          /\\ sAck\' = Head(ackQ)\0a          /\\ UNCHANGED <<msgQ, sBit, rBit, sent, rcvd>>\0a\0aLose(q) == \0a   /\\ q # << >>\0a   /\\ \\E i \\in 1..Len(q) : \0a          q\' = [j \\in 1..(Len(q)-1) |-> IF j < i THEN q[j] \0a                                                 ELSE q[j+1] ]\0a   /\\ UNCHANGED <<sBit, sAck, rBit, sent, rcvd>>\0a\0aLoseMsg == Lose(msgQ) /\\ UNCHANGED ackQ\0a\0aLoseAck == Lose(ackQ) /\\ UNCHANGED msgQ\0a\0aABNext == \\/  \\E d \\in Data : SndNewValue(d) \0a          \\/  ReSndMsg \\/ RcvMsg \\/ SndAck \\/ RcvAck \0a          \\/  LoseMsg \\/ LoseAck \0a-----------------------------------------------------------------------------\0aabvars == << msgQ, ackQ, sBit, sAck, rBit, sent, rcvd>>\0a\0aABFairness == /\\ WF_abvars(ReSndMsg) /\\ WF_abvars(SndAck)   \0a              /\\ SF_abvars(RcvMsg) /\\ SF_abvars(RcvAck) \0a-----------------------------------------------------------------------------\0aABSpec == ABInit /\\ [][ABNext]_abvars /\\ ABFairness\0a-----------------------------------------------------------------------------\0aTHEOREM ABSpec => []ABTypeInv\0a=============================================================================\0a'] ['ABCorrectness' '------------------- MODULE ABCorrectness --------------------\0aEXTENDS Naturals\0aCONSTANTS Data\0aVARIABLES sBit, sAck, rBit, sent, rcvd  \0a-------------------------------------------------------------\0aABCInit == /\\ sBit \\in {0, 1}\0a           /\\ sAck = sBit\0a           /\\ rBit = sBit\0a           /\\ sent \\in Data\0a           /\\ rcvd \\in Data\0a\0aCSndNewValue(d) == /\\ sAck = sBit\0a                   /\\ sent\' = d\0a                   /\\ sBit\' = 1 - sBit\0a                   /\\ UNCHANGED <<sAck, rBit, rcvd>>\0a\0aCRcvMsg == /\\ rBit # sBit \0a           /\\ rBit\' = sBit\0a           /\\ rcvd\' = sent\0a           /\\ UNCHANGED <<sBit, sAck, sent>>\0a\0aCRcvAck == /\\ rBit # sAck\0a           /\\ sAck\' = rBit\0a           /\\ UNCHANGED <<sBit, rBit, sent, rcvd>>\0a\0aABCNext == \\/  \\E d \\in Data : CSndNewValue(d) \0a           \\/  CRcvMsg \\/ CRcvAck \0a-------------------------------------------------------------\0acvars == <<sBit, sAck, rBit, sent, rcvd>>\0a\0aTypeInv == /\\ sBit \\in {0, 1}\0a           /\\ sAck \\in {0, 1}\0a           /\\ rBit \\in {0, 1}\0a           /\\ sent \\in Data\0a           /\\ rcvd \\in Data\0a\0aABCFairness == WF_cvars(CRcvMsg) /\\ WF_cvars(CRcvAck)   \0a\0aABCSpec == ABCInit /\\ [][ABCNext]_cvars /\\ ABCFairness\0a\0aInfOftenOutOfSync == []<>(sBit # sAck)\0a==============================================================\0a']]]
      ['examples/cf1s-folklore/cf1s_folklore' 'cf1s_folklore' %accept ~[['cf1s_folklore' '------------------------------ MODULE cf1s_folklore ------------------------------\0a\0a(* An encoding of the consensus algorithm with Byzantine faults in one communication step [1]. Here \0a   we consider only the algorithm itself (Algorithm 2, lines 1--4), without looking at the underlying \0a   consensus algorithm. \0a   \0a   [1] Dobre, Dan, and Neeraj Suri. "One-step consensus with zero-degradation." Dependable Systems and \0a   Networks, 2006. DSN 2006. International Conference on. IEEE, 2006.\0a                                                               \0a   Igor Konnov, Thanh Hai Tran, Josef Widder, 2016\0a  \0a   This file is a subject to the license that is bundled together with this package and can be found \0a   in the file LICENSE.\0a *)\0a\0a\0aEXTENDS Naturals, FiniteSets, TLC\0a\0aCONSTANTS N, T, F\0a\0aVARIABLES nSnt0,    (* nSnt0, nSnt1 - the messages sent by correct processes *)\0a          nSnt1,\0a          nSnt0F,   (* nsnt0F, nsnt1F - the messages sent by faulty processes *)\0a          nSnt1F,  \0a          nFaulty,  (* the number of faulty processes *)\0a          pc,       (* process locations *)\0a          nRcvd0,   (* the number of received messages *)\0a          nRcvd1\0a          (* nStep - only for checking IndInv0 with TLC *)                \0a\0aASSUME NTF == N \\in Nat /\\ T \\in Nat /\\ F \\in Nat /\\ (N > 3 * T) /\\ (T >= F) /\\ (F >= 0)\0a\0aProc == 1 .. N\0aStatus == { "V0", "V1", "S0", "S1", "D0", "D1", "U0", "U1", "BYZ" }\0avars == << nSnt0, nSnt1, nSnt0F, nSnt1F, nFaulty, pc, nRcvd0, nRcvd1 >>\0a\0a\0aInit ==\0a  /\\ pc \\in [ Proc -> { "V0", "V1" } ]\0a  /\\ nSnt0 = 0\0a  /\\ nSnt1 = 0\0a  /\\ nSnt0F = 0\0a  /\\ nSnt1F = 0\0a  /\\ nFaulty = 0\0a  /\\ nRcvd0 = [ i \\in Proc |-> 0 ]\0a  /\\ nRcvd1 = [ i \\in Proc |-> 0 ]\0a  \0aFaulty(i) ==\0a  /\\ nFaulty < F\0a  /\\ pc[i] # "BYZ"\0a  /\\ pc\' = [ pc EXCEPT ![i] = "BYZ" ] \0a  /\\ nFaulty\' = nFaulty + 1  \0a  /\\ IF pc[i] = "V0" THEN nSnt0F\' = nSnt0F + 1 ELSE nSnt0F\' = nSnt0F\0a  /\\ IF pc[i] = "V1" THEN nSnt0F\' = nSnt1F + 1 ELSE nSnt1F\' = nSnt1F\0a  /\\ UNCHANGED << nSnt0, nSnt1, nRcvd0, nRcvd1 >>\0a  \0aPropose(i) ==\0a  \\/ /\\ pc[i] = "V0"\0a     /\\ pc\' = [ pc EXCEPT ![i] = "S0" ]\0a     /\\ nSnt0\' = nSnt0 + 1\0a     /\\ UNCHANGED << nSnt1, nSnt0F, nSnt1F, nFaulty, nRcvd0, nRcvd1 >>\0a  \\/ /\\ pc[i] = "V1"\0a     /\\ pc\' = [ pc EXCEPT ![i] = "S1" ]\0a     /\\ nSnt1\' = nSnt1 + 1\0a     /\\ UNCHANGED << nSnt0, nSnt0F, nSnt1F, nFaulty, nRcvd0, nRcvd1 >>\0a     \0aReceive(i) ==\0a  \\/ /\\ nRcvd0[i] < nSnt0 + nSnt0F\0a     /\\ nRcvd0\' = [ nRcvd0 EXCEPT ![i] = nRcvd0[i] + 1 ]\0a     /\\ UNCHANGED << nSnt0, nSnt1, nSnt0F, nFaulty, pc, nSnt1F, nRcvd1 >>     \0a  \\/ /\\ nRcvd1[i] < nSnt1 + nSnt1F\0a     /\\ nRcvd1\' = [ nRcvd1 EXCEPT ![i] = nRcvd1[i] + 1 ]\0a     /\\ UNCHANGED << nSnt0, nSnt1, nSnt0F, nFaulty, pc, nSnt1F, nRcvd0 >>    \0a  \\/ /\\ nRcvd0[i] = nSnt0\0a     /\\ nRcvd1[i] = nSnt1\0a     /\\ UNCHANGED vars \0a     \0aDecide(i) ==\0a  /\\ \\/ pc[i] = "S0"\0a     \\/ pc[i] = "S1"\0a  /\\ nRcvd0[i] + nRcvd1[i] >= N - T\0a  /\\ \\/ /\\ nRcvd0[i] >= N - T\0a        /\\ pc\' = [ pc EXCEPT ![i] = "D0" ]      \0a     \\/ /\\ nRcvd1[i] >= N - T\0a        /\\ pc\' = [ pc EXCEPT ![i] = "D1" ]\0a     \\/ /\\ nRcvd0[i] < N - T\0a        /\\ nRcvd1[i] < N - T\0a        /\\ pc[i] = "S0"\0a        /\\ pc\' = [ pc EXCEPT ![i] = "U0" ]\0a     \\/ /\\ nRcvd0[i] < N - T\0a        /\\ nRcvd1[i] < N - T\0a        /\\ pc[i] = "S1"\0a        /\\ pc\' = [ pc EXCEPT ![i] = "U1" ]\0a  /\\ UNCHANGED << nSnt0, nSnt1, nSnt0F, nSnt1F, nFaulty, nRcvd0, nRcvd1 >>\0a\0aNext ==\0a  /\\ \\E self \\in Proc : \0a        \\/ Receive(self) \0a        \\/ Propose(self) \0a        \\/ Decide(self) \0a        \\/ Faulty(self)\0a        \\/ UNCHANGED vars                  \0a\0a(* Add weak fairness condition since we want to check liveness properties.  *)\0a(* We require that if UponV1 (UponNonFaulty, UponAcceptNotSent, UponAccept) *)\0a(* ever becomes forever enabled, then this step must eventually occur.      *)\0aSpec == Init /\\ [][Next]_vars \0a             /\\ WF_vars(\\E self \\in Proc : \\/ Receive(self)\0a                                           \\/ Propose(self)\0a                                           \\/ Decide(self))\0a\0a(* All processes propose 0. *)\0aInit0 ==\0a  /\\ pc = [ i \\in Proc |-> "V0" ]\0a  /\\ nSnt0 = 0\0a  /\\ nSnt1 = 0\0a  /\\ nSnt0F = 0\0a  /\\ nSnt1F = 0\0a  /\\ nFaulty = 0\0a  /\\ nRcvd0 = [ i \\in Proc |-> 0 ]\0a  /\\ nRcvd1 = [ i \\in Proc |-> 0 ]\0a  (* /\\ nStep = 0 *)\0a  \0a(* All processes propose 1. *)  \0aInit1 ==\0a  /\\ pc = [ i \\in Proc |-> "V1" ]\0a  /\\ nSnt0 = 0\0a  /\\ nSnt1 = 0\0a  /\\ nSnt0F = 0\0a  /\\ nSnt1F = 0\0a  /\\ nFaulty = 0\0a  /\\ nRcvd0 = [ i \\in Proc |-> 0 ]\0a  /\\ nRcvd1 = [ i \\in Proc |-> 0 ]  \0a\0a\0aTypeOK == \0a  /\\ pc \\in [ Proc -> Status ]          \0a  /\\ nSnt0 \\in 0..N\0a  /\\ nSnt1 \\in 0..N\0a  /\\ nSnt0F \\in 0..N\0a  /\\ nSnt1F \\in 0..N\0a  /\\ nFaulty \\in 0..F\0a  /\\ nRcvd0 \\in [ Proc -> 0..N ]\0a  /\\ nRcvd1 \\in [ Proc -> 0..N ]\0a  \0a (* If all processes propose 0, then every process crashes or decides 0. *) \0aOneStep0_Ltl ==\0a  (\\A i \\in Proc : pc[i] = "V0") => [](\\A i \\in Proc : pc[i] # "U0" /\\ pc[i] # "U1" /\\ pc[i] # "D1")\0a\0a(* If all processes propose 1, then every process crashes or decides 1. *)\0aOneStep1_Ltl ==  \0a  (\\A i \\in Proc : pc[i] = "V1") => <>(\\A i \\in Proc : pc[i] # "U0" /\\ pc[i] # "U1" /\\ pc[i] # "D0")\0a \0aStateConstraint ==\0a    TLCGet("level") < 6\0a\0aAllDecideOne == \\A self \\in Proc : <>(pc[self] = "D1")\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Mon Jul 09 13:26:59 CEST 2018 by tthai\0a\\* Created Mon Jun 04 13:20:35 CEST 2018 by tthai\0a']]]
      ['examples/detector_chan96/Age_Channel' 'Age_Channel' %accept ~[['Age_Channel' '---------------------------- MODULE Age_Channel ----------------------------\0a\0aEXTENDS Integers, TLC\0a\0a\0aCONSTANT Messages,    (* All messages sent by correct processes. *)\0a         Boxes        (* Every message is put into a box which has information\0a                          about how long this message have been in transit. *) \0a       \0a\0aVARIABLES inTransit,  (* All messages are in transit. *)\0a          inDelivery  (* inDelivery contains messages which are delivered\0a                          to a process p_i in this transition. *)\0a\0a\0a(* Pack a message into a box with its age which shows how long a message\0a    have been in transit. *)\0aPack_WaitingTime(msgs) == { [ content |-> m, age |-> 0 ] : m \\in msgs }\0a\0a(*  - Unpack boxes to get messages. Ages is not delivered. \0a    - Those messages are delivered to a process in this transition. *)\0aUnpack(boxes) == { m.content : m \\in boxes } \0a\0a(* Initialization *)\0aInit ==  \0a  /\\ inTransit = {}   (* No boxes are in transit. *)\0a  /\\ inDelivery = {}  (* No messages are delivered. *)\0a\0a\0a(* Pack a set msgs of messages with ages and put them in transit *)\0aPickup(msgs) == \0a  /\\ inTransit\' = inTransit \\cup Pack_WaitingTime(msgs)\0a  /\\ inDelivery\' = {}  \0a\0a\0a(*  - Non-deterministically choose some boxes and deliver associated messages to rcver. \0a    - Messages which are delivered are removed from inTransit. *)\0aDeliver(rcver) ==\0a  \\E boxes \\in SUBSET inTransit :\0a      /\\ \\A box \\in boxes : box.content.to = rcver\0a      /\\ inDelivery\' = Unpack(boxes)\0a      /\\ inTransit\' = inTransit \\ boxes\0a\0a               \0a(*  - Every message in transit attains a new age at every tick of the environmental clock. \0a    - Recall that we don\'t directly specify the environmental clock  in this encoding way.\0a      At every tick of the global clock, we only increase ages of boxes in transit.  \0a    - We can keep inDelivery unchanged. However, I set inDelivery\' an empty set because it \0a      makes an execution path more (human) readable, at least for me.  *)               \0aAttainAge ==\0a  /\\ inTransit\' = { [ content |-> package.content, age |-> package.age + 1 ]  : \0a                        package \\in inTransit }\0a  /\\ inDelivery\' = {}  \0a  \0a(* Type invariant for inTransit and inDelivery. *)\0aTypeOK ==\0a  /\\ inTransit \\subseteq Boxes\0a  /\\ inDelivery \\subseteq Messages \0a\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Mon Jun 11 13:30:42 CEST 2018 by tthai\0a\\* Created Thu Jun 07 09:30:18 CEST 2018 by tthai\0a']]]
      ['examples/ewd840/SyncTerminationDetection' 'SyncTerminationDetection' %accept ~[['SyncTerminationDetection' '---------------------- MODULE SyncTerminationDetection ----------------------\0a(***************************************************************************)\0a(* This module contains an abstract specification of the termination       *)\0a(* detection problem in a ring with synchronous communication. We will     *)\0a(* prove that the EWD840 algorithm refines this specification.             *)\0a(***************************************************************************)\0aEXTENDS Naturals\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aNode == 0 .. N-1\0a\0aVARIABLES \0a  active,               \\* activation status of nodes\0a  terminationDetected   \\* has termination been detected?\0a\0aTypeOK ==\0a  /\\ active \\in [Node -> BOOLEAN]\0a  /\\ terminationDetected \\in BOOLEAN\0a\0aterminated == \\A n \\in Node : ~ active[n]\0a\0a(***************************************************************************)\0a(* Initial condition: the nodes can be active or inactive, termination     *)\0a(* may (but need not) be detected immediately if all nodes are inactive.   *)\0a(***************************************************************************)\0aInit ==\0a  /\\ active \\in [Node -> BOOLEAN]\0a  /\\ terminationDetected \\in {FALSE, terminated}\0a\0aTerminate(i) ==  \\* node i terminates\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a     (* possibly (but not necessarily) detect termination if all nodes are inactive *)\0a  /\\ terminationDetected\' \\in {terminationDetected, terminated\'}\0a\0aWakeup(i,j) ==  \\* node i activates node j\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![j] = TRUE]\0a  /\\ UNCHANGED terminationDetected\0a\0aDetectTermination ==\0a  /\\ terminated\0a  /\\ terminationDetected\' = TRUE\0a  /\\ UNCHANGED active\0a\0aNext ==\0a  \\/ \\E i \\in Node : Terminate(i)\0a  \\/ \\E i,j \\in Node : Wakeup(i,j)\0a  \\/ DetectTermination\0a\0avars == <<active, terminationDetected>>\0aSpec == Init /\\ [][Next]_vars /\\ WF_vars(DetectTermination)\0a\0a------------------------------------------------------------------------------\0a(* Correctness properties *)\0a\0aTDCorrect == terminationDetected => terminated\0a\0aQuiescence == [](terminated => []terminated)\0a\0aLiveness == terminated ~> terminationDetected\0a\0aDetectionLeadsToReactivation == terminationDetected ~> (\\E n \\in Node : active[n])\0a\0a=============================================================================\0a\\* Modification History\0a\\* Created Sun Jan 10 15:19:20 CET 2021 by merz\0a']]]
      ['examples/ewd998/AsyncTerminationDetection' 'AsyncTerminationDetection' %accept ~[['AsyncTerminationDetection' '---------------------- MODULE AsyncTerminationDetection ---------------------\0a(***************************************************************************)\0a(* An abstract specification of the termination detection problem in a     *)\0a(* ring with asynchronous communication.                                   *)\0a(***************************************************************************)\0aEXTENDS Naturals, TLC, TLCExt\0aCONSTANT\0a  \\* @type: Int; \0a  N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aNode == 0 .. N-1\0a\0aVARIABLES \0a  \\* @type: Int -> Bool;\0a  active,               \\* activation status of nodes\0a  \\* @type: Int -> Int;\0a  pending,              \\* number of messages pending at a node\0a  \\* @type: Bool;\0a  terminationDetected   \\* has termination been detected?\0a\0aTypeOK ==\0a  /\\ active \\in [Node -> BOOLEAN]\0a  /\\ pending \\in [Node -> Nat]\0a  /\\ terminationDetected \\in BOOLEAN\0a\0aterminated == \\A n \\in Node : ~ active[n] /\\ pending[n] = 0\0a\0a(***************************************************************************)\0a(* Initial condition: the nodes can be active or inactive, no pending      *)\0a(* messages. Termination may (but need not) be detected immediately if all *)\0a(* nodes are inactive.                                                     *)\0a(***************************************************************************)\0aInit ==\0a  /\\ active \\in [Node -> BOOLEAN]\0a  /\\ pending = [n \\in Node |-> 0]\0a  /\\ terminationDetected \\in {FALSE, terminated}\0a\0aTerminate(i) ==  \\* node i terminates\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ pending\' = pending\0a     (* possibly (but not necessarily) detect termination if all nodes are inactive *)\0a  /\\ terminationDetected\' \\in {terminationDetected, terminated\'}\0a\0aSendMsg(i,j) ==  \\* node i sends a message to node j\0a  /\\ active[i]\0a  /\\ pending\' = [pending EXCEPT ![j] = @ + 1]\0a  /\\ UNCHANGED <<active, terminationDetected>>\0a\0aRcvMsg(i) == \\* node i receives a pending message\0a  /\\ pending[i] > 0\0a  /\\ active\' = [active EXCEPT ![i] = TRUE]\0a  /\\ pending\' = [pending EXCEPT ![i] = @ - 1]\0a  /\\ UNCHANGED terminationDetected\0a\0aDetectTermination ==\0a  /\\ terminated\0a  /\\ terminationDetected\' = TRUE\0a  /\\ UNCHANGED <<active, pending>>\0a\0aNext ==\0a  \\/ \\E i \\in Node : RcvMsg(i) \\/ Terminate(i)\0a  \\/ \\E i,j \\in Node : SendMsg(i,j)\0a  \\/ DetectTermination\0a\0avars == <<active, pending, terminationDetected>>\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ WF_vars(DetectTermination)\0a           \\* reasonable but not necessary for detecting termination\0a           \\* /\\ \\A i \\in Node : WF_vars(Wakeup(i))\0a\0a\\* a temporary solution for Apalache, until it translates [][Next]_vars\0aNextOrUnchanged ==\0a    Next \\/ UNCHANGED vars\0a\0a(***************************************************************************)\0a(* Restrict TLC model checking to a finite fragment of the state space.    *)\0a(***************************************************************************)\0aStateConstraint == \\A n \\in Node : pending[n] <= 3\0a\0a(***************************************************************************)\0a(* Correctness properties.                                                 *)\0a(***************************************************************************)\0aSafe == terminationDetected => terminated\0a\0aQuiescence == [](terminated => []terminated)\0a\0aLive == terminated ~> terminationDetected\0a\0a(***************************************************************************)\0a(* An inductive invariant to be checked with Apalache.                     *)\0a(***************************************************************************)\0aIndInv ==\0a    /\\ TypeOK\0a    /\\ Safe\0a\0a\\* By proving QuiescenceAsActionInv, we show that Quiescence holds true\0aQuiescenceAsActionInv ==\0a    terminated => terminated\'\0a\0a\\* @typeAlias: STATE =\0a\\*   [ active: Int -> Bool, pending: Int -> Int, terminationDetected: Bool ];\0a\\* @type: Seq(STATE) => Bool;\0aQuiescenceAsTraceInv(hist) ==\0a    LET terminatedAt(i) ==\0a        \\A n \\in Node: ~hist[i].active[n] /\\ hist[i].pending[n] = 0\0a    IN\0a    \\A i \\in DOMAIN hist:\0a        terminatedAt(i) =>\0a            \\A j \\in DOMAIN hist: j >= i => terminatedAt(j)\0a\0a(***************************************************************************)\0a(* Use Apalache to verify Quiescence by checking the action formula        *)\0a(* StableActionInvariant for a model with initial-state predicate TypeOK   *)\0a(* and next-state relation Next.                                           *)\0a(***************************************************************************)\0aStableActionInvariant == terminated => terminated\'\0a\0aPendingInfOften == <>[][DetectTermination]_vars\0a\0aPostCondition ==\0a  CounterExample =\0a   [ action |->\0a      { << << 1,\0a              [ active |->\0a                    (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE @@ 3 :> TRUE),\0a                pending |-> (0 :> 0 @@ 1 :> 0 @@ 2 :> 0 @@ 3 :> 0),\0a                terminationDetected |-> FALSE ] >>,\0a           [ name |-> "SendMsg",\0a             location |->\0a                 [ beginLine |-> 47,\0a                   beginColumn |-> 3,\0a                   endLine |-> 49,\0a                   endColumn |-> 46,\0a                   module |-> "AsyncTerminationDetection" ],\0a             context |-> [i |-> 3, j |-> 3],\0a             parameters |-> <<"i", "j">> ],\0a           << 2,\0a              [ active |->\0a                    (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE @@ 3 :> TRUE),\0a                pending |-> (0 :> 0 @@ 1 :> 0 @@ 2 :> 0 @@ 3 :> 1),\0a                terminationDetected |-> FALSE ] >> >>,\0a        << << 2,\0a              [ active |->\0a                    (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE @@ 3 :> TRUE),\0a                pending |-> (0 :> 0 @@ 1 :> 0 @@ 2 :> 0 @@ 3 :> 1),\0a                terminationDetected |-> FALSE ] >>,\0a           [ name |-> "RcvMsg",\0a             location |->\0a                 [ beginLine |-> 52,\0a                   beginColumn |-> 3,\0a                   endLine |-> 55,\0a                   endColumn |-> 34,\0a                   module |-> "AsyncTerminationDetection" ],\0a             context |-> [i |-> 3],\0a             parameters |-> <<"i">> ],\0a           << 1,\0a              [ active |->\0a                    (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE @@ 3 :> TRUE),\0a                pending |-> (0 :> 0 @@ 1 :> 0 @@ 2 :> 0 @@ 3 :> 0),\0a                terminationDetected |-> FALSE ] >> >> },\0a  state |->\0a      { << 1,\0a           [ active |-> (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE @@ 3 :> TRUE),\0a             pending |-> (0 :> 0 @@ 1 :> 0 @@ 2 :> 0 @@ 3 :> 0),\0a             terminationDetected |-> FALSE ] >>,\0a        << 2,\0a           [ active |-> (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE @@ 3 :> TRUE),\0a             pending |-> (0 :> 0 @@ 1 :> 0 @@ 2 :> 0 @@ 3 :> 1),\0a             terminationDetected |-> FALSE ] >> } ]\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Tue Apr 12 15:04:08 CEST 2022 by merz\0a\\* Last modified Wed Jun 02 14:21:31 PDT 2021 by markus\0a\\* Created Sun Jan 10 15:19:20 CET 2021 by merz\0a']]]
      ['gh1134/Base' 'Base' %accept ~[['Base' '------------------------------- MODULE Base -------------------------------\0a\0aEXTENDS FiniteSets, Integers, TLC\0a\0aCONSTANT UserIDs\0aVARIABLE State\0a\0aStateMachine == INSTANCE UserStateMachine\0a\0a============================================================================='] ['UserStateMachine' '------------------------------- MODULE UserStateMachine -------------------------------\0a\0aEXTENDS Sequences\0a\0aVARIABLE State\0a\0aInit(userIDs) ==\0a    State = [u \\in userIDs |-> "INIT"]\0a    \0aNext(user) ==\0a    State\' = [State EXCEPT ![user] = "DONE"]\0a\0a=============================================================================\0a\0aBefore param refinement:\0a[State line 5, col 10 to line 5, col 14 of module UserStateMachine->(2 :> "INIT"), \0a    userIDs line 7, col 6 to line 7, col 12 of module UserStateMachine-><LAZY line 13, col 27 to line 13, col 33 of module SingleUser>, \0a        State line 6, col 10 to line 6, col 14 of module Base->(2 :> "INIT"), \0a            UserIDs line 5, col 10 to line 5, col 16 of module Base-><LAZY line 6, col 28 to line 6, col 30 of module MultiUser>]\0a\0aWith param refinement:\0a[State line 5, col 10 to line 5, col 14 of module UserStateMachine->(2 :> "INIT"), \0a    State line 6, col 10 to line 6, col 14 of module Base->(2 :> "INIT"), \0a        UserIDs line 5, col 10 to line 5, col 16 of module Base-><LAZY line 6, col 28 to line 6, col 30 of module MultiUser>, \0a            userIDs line 7, col 6 to line 7, col 12 of module UserStateMachine-><LAZY line 13, col 27 to line 13, col 33 of module SingleUser>]\0a\0a']]]
      ['gh1134/MC' 'MC' %accept ~[['MC' '---- MODULE MC ----\0aEXTENDS MultiUser\0a\0a\\* CONSTANT definitions @modelParameterConstants:0UserIDs\0aconst_17385913267612000 == \0a1..2\0a----\0a\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_SingleUser2 ==\0a    SingleUser2!Spec\0a\0aprop_SingleUser3 ==\0a    SingleUser3!Spec\0a\0aprop_SingleUserP2 ==\0a    SingleUserP(2)!Spec\0a\0aprop_SingleUserP3 ==\0a    SingleUserP(3)!Spec\0a\0aprop_SingleUserAll2 ==\0a    \\A n \\in {2} : SingleUserP(n)!Spec\0a\0aprop_SingleUserAll3 ==\0a    \\A n \\in {3} : SingleUserP(n)!Spec\0a============================================================================='] ['MultiUser' '------------------------------- MODULE MultiUser -------------------------------\0a\0aEXTENDS Base\0a\0aSingleUser2 == INSTANCE SingleUser WITH\0a                UserIDs <- {2},\0a                State <- 2 :> State[2] \0a\0aSingleUser3 == INSTANCE SingleUser WITH\0a                UserIDs <- {3},\0a                State <- 2 :> State[2] \0a\0aSingleUserP(n) == INSTANCE SingleUser WITH\0a                UserIDs <- {n},\0a                State <- n :> State[n] \0a\0aInit ==\0a    StateMachine!Init(UserIDs)\0a    \0aNext ==\0a    \\E user \\in UserIDs : StateMachine!Next(user)\0a\0aSpec ==\0a    /\\ Init\0a    /\\ [][Next]_State\0a\0a============================================================================='] ['SingleUser' '------------------------------- MODULE SingleUser -------------------------------\0a\0aEXTENDS Base\0a\0a\\* This assume is not evaluated!!!\0aASSUME Cardinality(UserIDs) = 1\0a\0aInit ==\0a\\*  Verification succeeds with the following LET ... IN\0a\\*  Verification fails without the following LET ... IN\0a\\*    /\\ LET a == 1\0a\\*       IN\0a        StateMachine!Init(UserIDs)\0a    \0aNext ==\0a    \\E user \\in UserIDs : StateMachine!Next(user)\0a\0aSpec ==\0a    /\\ Init\0a    /\\ [][Next]_State\0a\0a============================================================================='] ['Base' '------------------------------- MODULE Base -------------------------------\0a\0aEXTENDS FiniteSets, Integers, TLC\0a\0aCONSTANT UserIDs\0aVARIABLE State\0a\0aStateMachine == INSTANCE UserStateMachine\0a\0a============================================================================='] ['UserStateMachine' '------------------------------- MODULE UserStateMachine -------------------------------\0a\0aEXTENDS Sequences\0a\0aVARIABLE State\0a\0aInit(userIDs) ==\0a    State = [u \\in userIDs |-> "INIT"]\0a    \0aNext(user) ==\0a    State\' = [State EXCEPT ![user] = "DONE"]\0a\0a=============================================================================\0a\0aBefore param refinement:\0a[State line 5, col 10 to line 5, col 14 of module UserStateMachine->(2 :> "INIT"), \0a    userIDs line 7, col 6 to line 7, col 12 of module UserStateMachine-><LAZY line 13, col 27 to line 13, col 33 of module SingleUser>, \0a        State line 6, col 10 to line 6, col 14 of module Base->(2 :> "INIT"), \0a            UserIDs line 5, col 10 to line 5, col 16 of module Base-><LAZY line 6, col 28 to line 6, col 30 of module MultiUser>]\0a\0aWith param refinement:\0a[State line 5, col 10 to line 5, col 14 of module UserStateMachine->(2 :> "INIT"), \0a    State line 6, col 10 to line 6, col 14 of module Base->(2 :> "INIT"), \0a        UserIDs line 5, col 10 to line 5, col 16 of module Base-><LAZY line 6, col 28 to line 6, col 30 of module MultiUser>, \0a            userIDs line 7, col 6 to line 7, col 12 of module UserStateMachine-><LAZY line 13, col 27 to line 13, col 33 of module SingleUser>]\0a\0a']]]
      ['gh1134/MultiUser' 'MultiUser' %accept ~[['MultiUser' '------------------------------- MODULE MultiUser -------------------------------\0a\0aEXTENDS Base\0a\0aSingleUser2 == INSTANCE SingleUser WITH\0a                UserIDs <- {2},\0a                State <- 2 :> State[2] \0a\0aSingleUser3 == INSTANCE SingleUser WITH\0a                UserIDs <- {3},\0a                State <- 2 :> State[2] \0a\0aSingleUserP(n) == INSTANCE SingleUser WITH\0a                UserIDs <- {n},\0a                State <- n :> State[n] \0a\0aInit ==\0a    StateMachine!Init(UserIDs)\0a    \0aNext ==\0a    \\E user \\in UserIDs : StateMachine!Next(user)\0a\0aSpec ==\0a    /\\ Init\0a    /\\ [][Next]_State\0a\0a============================================================================='] ['SingleUser' '------------------------------- MODULE SingleUser -------------------------------\0a\0aEXTENDS Base\0a\0a\\* This assume is not evaluated!!!\0aASSUME Cardinality(UserIDs) = 1\0a\0aInit ==\0a\\*  Verification succeeds with the following LET ... IN\0a\\*  Verification fails without the following LET ... IN\0a\\*    /\\ LET a == 1\0a\\*       IN\0a        StateMachine!Init(UserIDs)\0a    \0aNext ==\0a    \\E user \\in UserIDs : StateMachine!Next(user)\0a\0aSpec ==\0a    /\\ Init\0a    /\\ [][Next]_State\0a\0a============================================================================='] ['Base' '------------------------------- MODULE Base -------------------------------\0a\0aEXTENDS FiniteSets, Integers, TLC\0a\0aCONSTANT UserIDs\0aVARIABLE State\0a\0aStateMachine == INSTANCE UserStateMachine\0a\0a============================================================================='] ['UserStateMachine' '------------------------------- MODULE UserStateMachine -------------------------------\0a\0aEXTENDS Sequences\0a\0aVARIABLE State\0a\0aInit(userIDs) ==\0a    State = [u \\in userIDs |-> "INIT"]\0a    \0aNext(user) ==\0a    State\' = [State EXCEPT ![user] = "DONE"]\0a\0a=============================================================================\0a\0aBefore param refinement:\0a[State line 5, col 10 to line 5, col 14 of module UserStateMachine->(2 :> "INIT"), \0a    userIDs line 7, col 6 to line 7, col 12 of module UserStateMachine-><LAZY line 13, col 27 to line 13, col 33 of module SingleUser>, \0a        State line 6, col 10 to line 6, col 14 of module Base->(2 :> "INIT"), \0a            UserIDs line 5, col 10 to line 5, col 16 of module Base-><LAZY line 6, col 28 to line 6, col 30 of module MultiUser>]\0a\0aWith param refinement:\0a[State line 5, col 10 to line 5, col 14 of module UserStateMachine->(2 :> "INIT"), \0a    State line 6, col 10 to line 6, col 14 of module Base->(2 :> "INIT"), \0a        UserIDs line 5, col 10 to line 5, col 16 of module Base-><LAZY line 6, col 28 to line 6, col 30 of module MultiUser>, \0a            userIDs line 7, col 6 to line 7, col 12 of module UserStateMachine-><LAZY line 13, col 27 to line 13, col 33 of module SingleUser>]\0a\0a']]]
      ['gh1134/SingleUser' 'SingleUser' %accept ~[['SingleUser' '------------------------------- MODULE SingleUser -------------------------------\0a\0aEXTENDS Base\0a\0a\\* This assume is not evaluated!!!\0aASSUME Cardinality(UserIDs) = 1\0a\0aInit ==\0a\\*  Verification succeeds with the following LET ... IN\0a\\*  Verification fails without the following LET ... IN\0a\\*    /\\ LET a == 1\0a\\*       IN\0a        StateMachine!Init(UserIDs)\0a    \0aNext ==\0a    \\E user \\in UserIDs : StateMachine!Next(user)\0a\0aSpec ==\0a    /\\ Init\0a    /\\ [][Next]_State\0a\0a============================================================================='] ['Base' '------------------------------- MODULE Base -------------------------------\0a\0aEXTENDS FiniteSets, Integers, TLC\0a\0aCONSTANT UserIDs\0aVARIABLE State\0a\0aStateMachine == INSTANCE UserStateMachine\0a\0a============================================================================='] ['UserStateMachine' '------------------------------- MODULE UserStateMachine -------------------------------\0a\0aEXTENDS Sequences\0a\0aVARIABLE State\0a\0aInit(userIDs) ==\0a    State = [u \\in userIDs |-> "INIT"]\0a    \0aNext(user) ==\0a    State\' = [State EXCEPT ![user] = "DONE"]\0a\0a=============================================================================\0a\0aBefore param refinement:\0a[State line 5, col 10 to line 5, col 14 of module UserStateMachine->(2 :> "INIT"), \0a    userIDs line 7, col 6 to line 7, col 12 of module UserStateMachine-><LAZY line 13, col 27 to line 13, col 33 of module SingleUser>, \0a        State line 6, col 10 to line 6, col 14 of module Base->(2 :> "INIT"), \0a            UserIDs line 5, col 10 to line 5, col 16 of module Base-><LAZY line 6, col 28 to line 6, col 30 of module MultiUser>]\0a\0aWith param refinement:\0a[State line 5, col 10 to line 5, col 14 of module UserStateMachine->(2 :> "INIT"), \0a    State line 6, col 10 to line 6, col 14 of module Base->(2 :> "INIT"), \0a        UserIDs line 5, col 10 to line 5, col 16 of module Base-><LAZY line 6, col 28 to line 6, col 30 of module MultiUser>, \0a            userIDs line 7, col 6 to line 7, col 12 of module UserStateMachine-><LAZY line 13, col 27 to line 13, col 33 of module SingleUser>]\0a\0a']]]
      ['gh1134/UserStateMachine' 'UserStateMachine' %accept ~[['UserStateMachine' '------------------------------- MODULE UserStateMachine -------------------------------\0a\0aEXTENDS Sequences\0a\0aVARIABLE State\0a\0aInit(userIDs) ==\0a    State = [u \\in userIDs |-> "INIT"]\0a    \0aNext(user) ==\0a    State\' = [State EXCEPT ![user] = "DONE"]\0a\0a=============================================================================\0a\0aBefore param refinement:\0a[State line 5, col 10 to line 5, col 14 of module UserStateMachine->(2 :> "INIT"), \0a    userIDs line 7, col 6 to line 7, col 12 of module UserStateMachine-><LAZY line 13, col 27 to line 13, col 33 of module SingleUser>, \0a        State line 6, col 10 to line 6, col 14 of module Base->(2 :> "INIT"), \0a            UserIDs line 5, col 10 to line 5, col 16 of module Base-><LAZY line 6, col 28 to line 6, col 30 of module MultiUser>]\0a\0aWith param refinement:\0a[State line 5, col 10 to line 5, col 14 of module UserStateMachine->(2 :> "INIT"), \0a    State line 6, col 10 to line 6, col 14 of module Base->(2 :> "INIT"), \0a        UserIDs line 5, col 10 to line 5, col 16 of module Base-><LAZY line 6, col 28 to line 6, col 30 of module MultiUser>, \0a            userIDs line 7, col 6 to line 7, col 12 of module UserStateMachine-><LAZY line 13, col 27 to line 13, col 33 of module SingleUser>]\0a\0a']]]
      ['pcal/CEither1' 'CEither1' %accept ~[['CEither1' '------------------------------- MODULE CEither1 ----------------------------- \0aEXTENDS Naturals, Sequences, TLC\0a\0a(* --algorithm Either {\0a      variables x = 0 ; y = 0 ;\0a        {   a: either {x := 1 ; b: x := x + 1;} ;\0a                   or { y := 1 ; c: y := y + 1;} ; \0a\\*               end either ;\0a            d: assert x+y = 2 ;\0a        } }\0a     \0a*)\0a\0a\\* BEGIN TRANSLATION (chksum(pcal) = "f7b78f6e" /\\ chksum(tla) = "7186648")\0aVARIABLES pc, x, y\0a\0avars == << pc, x, y >>\0a\0aInit == (* Global variables *)\0a        /\\ x = 0\0a        /\\ y = 0\0a        /\\ pc = "a"\0a\0aa == /\\ pc = "a"\0a     /\\ \\/ /\\ x\' = 1\0a           /\\ pc\' = "b"\0a           /\\ y\' = y\0a        \\/ /\\ y\' = 1\0a           /\\ pc\' = "c"\0a           /\\ x\' = x\0a\0ab == /\\ pc = "b"\0a     /\\ x\' = x + 1\0a     /\\ pc\' = "d"\0a     /\\ y\' = y\0a\0ac == /\\ pc = "c"\0a     /\\ y\' = y + 1\0a     /\\ pc\' = "d"\0a     /\\ x\' = x\0a\0ad == /\\ pc = "d"\0a     /\\ Assert(x+y = 2, "Failure of assertion at line 9, column 16.")\0a     /\\ pc\' = "Done"\0a     /\\ UNCHANGED << x, y >>\0a\0a(* Allow infinite stuttering to prevent deadlock on termination. *)\0aTerminating == pc = "Done" /\\ UNCHANGED vars\0a\0aNext == a \\/ b \\/ c \\/ d\0a           \\/ Terminating\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ WF_vars(Next)\0a\0aTermination == <>(pc = "Done")\0a\0a\\* END TRANSLATION\0a\0a=============================================================================\0a']]]
      ['pcal/DetlefSpec' 'DetlefSpec' %accept ~[['DetlefSpec' '----------------------------- MODULE DetlefSpec ----------------------------- \0aEXTENDS Sequences, Naturals\0a\0aCONSTANTS Val, Procs, null\0a\0a\0a(* --algorithm Spec {\0a      variable queue = << >> ;\0a      process (P \\in Procs) \0a      variable rV = null ; {\0aL1: while (TRUE) {\0a      either \0a        with (v \\in Val) {\0a           either { queue := queue \\o <<v>> ;\0a                    rV := "okay" }\0a               or { queue := <<v>> \\o  queue ;\0a                    rV := "okay"} \0a               or rV := "full" ;\0a          }\0a      or { if (queue # << >>)\0a             { either { rV := Head(queue) ;\0a                        queue := Tail(queue) }\0a                   or { rV := queue[Len(queue)] ;\0a                        queue := [ i \\in 1 .. (Len(queue) - 1) |-> queue[i]]}\0a             }\0a           else { rV := "empty" } \0a         } ;\0aL2:   rV := null \0a    } } }\0a*)\0a\0a\\* BEGIN TRANSLATION (chksum(pcal) = "ef5d02d1" /\\ chksum(tla) = "8f1961dc")\0aVARIABLES pc, queue, rV\0a\0avars == << pc, queue, rV >>\0a\0aProcSet == (Procs)\0a\0aInit == (* Global variables *)\0a        /\\ queue = << >>\0a        (* Process P *)\0a        /\\ rV = [self \\in Procs |-> null]\0a        /\\ pc = [self \\in ProcSet |-> "L1"]\0a\0aL1(self) == /\\ pc[self] = "L1"\0a            /\\ \\/ /\\ \\E v \\in Val:\0a                       \\/ /\\ queue\' = queue \\o <<v>>\0a                          /\\ rV\' = [rV EXCEPT ![self] = "okay"]\0a                       \\/ /\\ queue\' = <<v>> \\o  queue\0a                          /\\ rV\' = [rV EXCEPT ![self] = "okay"]\0a                       \\/ /\\ rV\' = [rV EXCEPT ![self] = "full"]\0a                          /\\ queue\' = queue\0a               \\/ /\\ IF queue # << >>\0a                        THEN /\\ \\/ /\\ rV\' = [rV EXCEPT ![self] = Head(queue)]\0a                                   /\\ queue\' = Tail(queue)\0a                                \\/ /\\ rV\' = [rV EXCEPT ![self] = queue[Len(queue)]]\0a                                   /\\ queue\' = [ i \\in 1 .. (Len(queue) - 1) |-> queue[i]]\0a                        ELSE /\\ rV\' = [rV EXCEPT ![self] = "empty"]\0a                             /\\ queue\' = queue\0a            /\\ pc\' = [pc EXCEPT ![self] = "L2"]\0a\0aL2(self) == /\\ pc[self] = "L2"\0a            /\\ rV\' = [rV EXCEPT ![self] = null]\0a            /\\ pc\' = [pc EXCEPT ![self] = "L1"]\0a            /\\ queue\' = queue\0a\0aP(self) == L1(self) \\/ L2(self)\0a\0aNext == (\\E self \\in Procs: P(self))\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ \\A self \\in Procs : WF_vars(P(self))\0a\0a\\* END TRANSLATION\0a\0aCONSTANT N\0a\0aConstraint == Len(queue) \\leq N\0a=============================================================================\0a']]]
      ['pcal/Either1' 'Either1' %accept ~[['Either1' '------------------------------- MODULE Either1 ------------------------------ \0aEXTENDS Naturals, Sequences, TLC\0a\0a(* --algorithm Either\0a      variables x = 0 ; y = 0 ;\0a      begin a: either x := 1 ; b: x := x + 1;\0a                   or y := 1 ; c: y := y + 1;\0a               end either ;\0a            d: assert x+y = 2 ;\0a     end algorithm\0a*)\0a\0a\\* BEGIN TRANSLATION (chksum(pcal) = "f7b78f6e" /\\ chksum(tla) = "7186648")\0aVARIABLES pc, x, y\0a\0avars == << pc, x, y >>\0a\0aInit == (* Global variables *)\0a        /\\ x = 0\0a        /\\ y = 0\0a        /\\ pc = "a"\0a\0aa == /\\ pc = "a"\0a     /\\ \\/ /\\ x\' = 1\0a           /\\ pc\' = "b"\0a           /\\ y\' = y\0a        \\/ /\\ y\' = 1\0a           /\\ pc\' = "c"\0a           /\\ x\' = x\0a\0ab == /\\ pc = "b"\0a     /\\ x\' = x + 1\0a     /\\ pc\' = "d"\0a     /\\ y\' = y\0a\0ac == /\\ pc = "c"\0a     /\\ y\' = y + 1\0a     /\\ pc\' = "d"\0a     /\\ x\' = x\0a\0ad == /\\ pc = "d"\0a     /\\ Assert(x+y = 2, "Failure of assertion at line 9, column 16.")\0a     /\\ pc\' = "Done"\0a     /\\ UNCHANGED << x, y >>\0a\0a(* Allow infinite stuttering to prevent deadlock on termination. *)\0aTerminating == pc = "Done" /\\ UNCHANGED vars\0a\0aNext == a \\/ b \\/ c \\/ d\0a           \\/ Terminating\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ WF_vars(Next)\0a\0aTermination == <>(pc = "Done")\0a\0a\\* END TRANSLATION\0a\0aXBranch == pc = "b"\0a\0aChooseX == pc = "a" /\\ pc\' = "b"\0a\0aPossibleCounts ==\0a    LET p == TLCGet("all:named")["s:_possible"][1]\0a    IN /\\ p["XBranch"] = 1\0a       /\\ p["ChooseX"] = 1\0a\0a=============================================================================\0a']]]
