++  test-sany-sub-3
  %+  expect-eq
    !>  ^-  (list @t)
    :~  'suite/etest15 -> hoon=reject'  'suite/etest16 -> hoon=accept'  'suite/test10 -> hoon=reject'  'suite/test16 -> hoon=reject'  'suite/test203 -> hoon=reject'
    ==
  !>
  %-  sub-batch-run
  ^-  (list [@t @t ?(%accept %reject) (list [@t @t])])
  :~
      ['pcal/DetlefSpec' 'DetlefSpec' %accept ~[['DetlefSpec' '----------------------------- MODULE DetlefSpec ----------------------------- \0aEXTENDS Sequences, Naturals\0a\0aCONSTANTS Val, Procs, null\0a\0a\0a(* --algorithm Spec {\0a      variable queue = << >> ;\0a      process (P \\in Procs) \0a      variable rV = null ; {\0aL1: while (TRUE) {\0a      either \0a        with (v \\in Val) {\0a           either { queue := queue \\o <<v>> ;\0a                    rV := "okay" }\0a               or { queue := <<v>> \\o  queue ;\0a                    rV := "okay"} \0a               or rV := "full" ;\0a          }\0a      or { if (queue # << >>)\0a             { either { rV := Head(queue) ;\0a                        queue := Tail(queue) }\0a                   or { rV := queue[Len(queue)] ;\0a                        queue := [ i \\in 1 .. (Len(queue) - 1) |-> queue[i]]}\0a             }\0a           else { rV := "empty" } \0a         } ;\0aL2:   rV := null \0a    } } }\0a*)\0a\0a\\* BEGIN TRANSLATION (chksum(pcal) = "ef5d02d1" /\\ chksum(tla) = "8f1961dc")\0aVARIABLES pc, queue, rV\0a\0avars == << pc, queue, rV >>\0a\0aProcSet == (Procs)\0a\0aInit == (* Global variables *)\0a        /\\ queue = << >>\0a        (* Process P *)\0a        /\\ rV = [self \\in Procs |-> null]\0a        /\\ pc = [self \\in ProcSet |-> "L1"]\0a\0aL1(self) == /\\ pc[self] = "L1"\0a            /\\ \\/ /\\ \\E v \\in Val:\0a                       \\/ /\\ queue\' = queue \\o <<v>>\0a                          /\\ rV\' = [rV EXCEPT ![self] = "okay"]\0a                       \\/ /\\ queue\' = <<v>> \\o  queue\0a                          /\\ rV\' = [rV EXCEPT ![self] = "okay"]\0a                       \\/ /\\ rV\' = [rV EXCEPT ![self] = "full"]\0a                          /\\ queue\' = queue\0a               \\/ /\\ IF queue # << >>\0a                        THEN /\\ \\/ /\\ rV\' = [rV EXCEPT ![self] = Head(queue)]\0a                                   /\\ queue\' = Tail(queue)\0a                                \\/ /\\ rV\' = [rV EXCEPT ![self] = queue[Len(queue)]]\0a                                   /\\ queue\' = [ i \\in 1 .. (Len(queue) - 1) |-> queue[i]]\0a                        ELSE /\\ rV\' = [rV EXCEPT ![self] = "empty"]\0a                             /\\ queue\' = queue\0a            /\\ pc\' = [pc EXCEPT ![self] = "L2"]\0a\0aL2(self) == /\\ pc[self] = "L2"\0a            /\\ rV\' = [rV EXCEPT ![self] = null]\0a            /\\ pc\' = [pc EXCEPT ![self] = "L1"]\0a            /\\ queue\' = queue\0a\0aP(self) == L1(self) \\/ L2(self)\0a\0aNext == (\\E self \\in Procs: P(self))\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ \\A self \\in Procs : WF_vars(P(self))\0a\0a\\* END TRANSLATION\0a\0aCONSTANT N\0a\0aConstraint == Len(queue) \\leq N\0a=============================================================================\0a']]]
      ['pcal/Either1' 'Either1' %accept ~[['Either1' '------------------------------- MODULE Either1 ------------------------------ \0aEXTENDS Naturals, Sequences, TLC\0a\0a(* --algorithm Either\0a      variables x = 0 ; y = 0 ;\0a      begin a: either x := 1 ; b: x := x + 1;\0a                   or y := 1 ; c: y := y + 1;\0a               end either ;\0a            d: assert x+y = 2 ;\0a     end algorithm\0a*)\0a\0a\\* BEGIN TRANSLATION (chksum(pcal) = "f7b78f6e" /\\ chksum(tla) = "7186648")\0aVARIABLES pc, x, y\0a\0avars == << pc, x, y >>\0a\0aInit == (* Global variables *)\0a        /\\ x = 0\0a        /\\ y = 0\0a        /\\ pc = "a"\0a\0aa == /\\ pc = "a"\0a     /\\ \\/ /\\ x\' = 1\0a           /\\ pc\' = "b"\0a           /\\ y\' = y\0a        \\/ /\\ y\' = 1\0a           /\\ pc\' = "c"\0a           /\\ x\' = x\0a\0ab == /\\ pc = "b"\0a     /\\ x\' = x + 1\0a     /\\ pc\' = "d"\0a     /\\ y\' = y\0a\0ac == /\\ pc = "c"\0a     /\\ y\' = y + 1\0a     /\\ pc\' = "d"\0a     /\\ x\' = x\0a\0ad == /\\ pc = "d"\0a     /\\ Assert(x+y = 2, "Failure of assertion at line 9, column 16.")\0a     /\\ pc\' = "Done"\0a     /\\ UNCHANGED << x, y >>\0a\0a(* Allow infinite stuttering to prevent deadlock on termination. *)\0aTerminating == pc = "Done" /\\ UNCHANGED vars\0a\0aNext == a \\/ b \\/ c \\/ d\0a           \\/ Terminating\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ WF_vars(Next)\0a\0aTermination == <>(pc = "Done")\0a\0a\\* END TRANSLATION\0a\0aXBranch == pc = "b"\0a\0aChooseX == pc = "a" /\\ pc\' = "b"\0a\0aPossibleCounts ==\0a    LET p == TLCGet("all:named")["s:_possible"][1]\0a    IN /\\ p["XBranch"] = 1\0a       /\\ p["ChooseX"] = 1\0a\0a=============================================================================\0a']]]
      ['pcal/Either2' 'Either2' %accept ~[['Either2' '------------------------------- MODULE Either2 ------------------------------ \0aEXTENDS Naturals, Sequences, TLC\0a\0a(* --algorithm Either\0a      variables x = 0 ; y = 0 ; z = 0 ;\0a      begin a: either    x := 1 ; \0a                      b: x := x + 1; \0a                   or y := 1 ; c: y := y + 1;\0a               end either ;\0a            d: either when x = 0 ; z := z + 1 ;\0a                   or when x = 2 ; z := z + 3 ;\0a               end either ;     \0a               assert x+y = 2 ;\0a               assert z = x + 1 ;\0a     end algorithm\0a*)\0a\0a\\* BEGIN TRANSLATION (chksum(pcal) = "d9025312" /\\ chksum(tla) = "1742027")\0aVARIABLES pc, x, y, z\0a\0avars == << pc, x, y, z >>\0a\0aInit == (* Global variables *)\0a        /\\ x = 0\0a        /\\ y = 0\0a        /\\ z = 0\0a        /\\ pc = "a"\0a\0aa == /\\ pc = "a"\0a     /\\ \\/ /\\ x\' = 1\0a           /\\ pc\' = "b"\0a           /\\ y\' = y\0a        \\/ /\\ y\' = 1\0a           /\\ pc\' = "c"\0a           /\\ x\' = x\0a     /\\ z\' = z\0a\0ab == /\\ pc = "b"\0a     /\\ x\' = x + 1\0a     /\\ pc\' = "d"\0a     /\\ UNCHANGED << y, z >>\0a\0ac == /\\ pc = "c"\0a     /\\ y\' = y + 1\0a     /\\ pc\' = "d"\0a     /\\ UNCHANGED << x, z >>\0a\0ad == /\\ pc = "d"\0a     /\\ \\/ /\\ x = 0\0a           /\\ z\' = z + 1\0a        \\/ /\\ x = 2\0a           /\\ z\' = z + 3\0a     /\\ Assert(x+y = 2, "Failure of assertion at line 13, column 16.")\0a     /\\ Assert(z\' = x + 1, "Failure of assertion at line 14, column 16.")\0a     /\\ pc\' = "Done"\0a     /\\ UNCHANGED << x, y >>\0a\0a(* Allow infinite stuttering to prevent deadlock on termination. *)\0aTerminating == pc = "Done" /\\ UNCHANGED vars\0a\0aNext == a \\/ b \\/ c \\/ d\0a           \\/ Terminating\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ WF_vars(Next)\0a\0aTermination == <>(pc = "Done")\0a\0a\\* END TRANSLATION\0a\0a=============================================================================\0a']]]
      ['pcal/Either3' 'Either3' %accept ~[['Either3' '------------------------------- MODULE Either3 ------------------------------ \0aEXTENDS Naturals, Sequences, TLC\0a\0a(* --algorithm Either\0a      variables x = 0 ; y = 0 ; z = 0 ;\0a      begin a: either    x := 1 ; \0a                      b: x := x + 1; \0a                   or y := 1 ; c: y := y + 1;\0a                   or z := 100\0a               end either ;\0a            d: either when x = 0 ; z := z + 1 ;\0a                   or when x = 2 ; z := z + 3 ;\0a               end either ;     \0a               assert (x+y = 2) \\/ ((z = 101) /\\ (x+y=0));\0a               assert (z < 100) => (z = x + 1) ;\0a     end algorithm\0a*)\0a\0a\\* BEGIN TRANSLATION (chksum(pcal) = "bcbce20" /\\ chksum(tla) = "24b6654e")\0aVARIABLES pc, x, y, z\0a\0avars == << pc, x, y, z >>\0a\0aInit == (* Global variables *)\0a        /\\ x = 0\0a        /\\ y = 0\0a        /\\ z = 0\0a        /\\ pc = "a"\0a\0aa == /\\ pc = "a"\0a     /\\ \\/ /\\ x\' = 1\0a           /\\ pc\' = "b"\0a           /\\ UNCHANGED <<y, z>>\0a        \\/ /\\ y\' = 1\0a           /\\ pc\' = "c"\0a           /\\ UNCHANGED <<x, z>>\0a        \\/ /\\ z\' = 100\0a           /\\ pc\' = "d"\0a           /\\ UNCHANGED <<x, y>>\0a\0ab == /\\ pc = "b"\0a     /\\ x\' = x + 1\0a     /\\ pc\' = "d"\0a     /\\ UNCHANGED << y, z >>\0a\0ac == /\\ pc = "c"\0a     /\\ y\' = y + 1\0a     /\\ pc\' = "d"\0a     /\\ UNCHANGED << x, z >>\0a\0ad == /\\ pc = "d"\0a     /\\ \\/ /\\ x = 0\0a           /\\ z\' = z + 1\0a        \\/ /\\ x = 2\0a           /\\ z\' = z + 3\0a     /\\ Assert((x+y = 2) \\/ ((z\' = 101) /\\ (x+y=0)), \0a               "Failure of assertion at line 14, column 16.")\0a     /\\ Assert((z\' < 100) => (z\' = x + 1), \0a               "Failure of assertion at line 15, column 16.")\0a     /\\ pc\' = "Done"\0a     /\\ UNCHANGED << x, y >>\0a\0a(* Allow infinite stuttering to prevent deadlock on termination. *)\0aTerminating == pc = "Done" /\\ UNCHANGED vars\0a\0aNext == a \\/ b \\/ c \\/ d\0a           \\/ Terminating\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ WF_vars(Next)\0a\0aTermination == <>(pc = "Done")\0a\0a\\* END TRANSLATION\0a\0a=============================================================================\0a']]]
      ['pcal/Either4' 'Either4' %accept ~[['Either4' '------------------------------- MODULE Either4 ------------------------------ \0aEXTENDS Naturals, Sequences, TLC\0a\0a(* --algorithm Either\0a      process Foo \\in {1, 2}\0a      variables x = 0 ; y = 0 ; z = 0 ;\0a      begin a: either    x := 1 ; \0a                      b: x := x + 1; \0a                   or y := 1 ; c: y := y + 1;\0a                   or z := 100\0a               end either ;\0a            d: either when x = 0 ; z := z + 1 ;\0a                   or when x = 2 ; z := z + 3 ;\0a               end either ;     \0a               assert (x+y = 2) \\/ ((z = 101) /\\ (x+y=0));\0a               assert (z < 100) => (z = x + 1) ;\0a     end process\0a     end algorithm\0a*)\0a\0a\\* BEGIN TRANSLATION - the hash of the PCal code: PCal-9a6afbc4f2a88a20f8db8f24ec88b676\0aVARIABLES pc, x, y, z\0a\0avars == << pc, x, y, z >>\0a\0aProcSet == ({1, 2})\0a\0aInit == (* Process Foo *)\0a        /\\ x = [self \\in {1, 2} |-> 0]\0a        /\\ y = [self \\in {1, 2} |-> 0]\0a        /\\ z = [self \\in {1, 2} |-> 0]\0a        /\\ pc = [self \\in ProcSet |-> "a"]\0a\0aa(self) == /\\ pc[self] = "a"\0a           /\\ \\/ /\\ x\' = [x EXCEPT ![self] = 1]\0a                 /\\ pc\' = [pc EXCEPT ![self] = "b"]\0a                 /\\ UNCHANGED <<y, z>>\0a              \\/ /\\ y\' = [y EXCEPT ![self] = 1]\0a                 /\\ pc\' = [pc EXCEPT ![self] = "c"]\0a                 /\\ UNCHANGED <<x, z>>\0a              \\/ /\\ z\' = [z EXCEPT ![self] = 100]\0a                 /\\ pc\' = [pc EXCEPT ![self] = "d"]\0a                 /\\ UNCHANGED <<x, y>>\0a\0ab(self) == /\\ pc[self] = "b"\0a           /\\ x\' = [x EXCEPT ![self] = x[self] + 1]\0a           /\\ pc\' = [pc EXCEPT ![self] = "d"]\0a           /\\ UNCHANGED << y, z >>\0a\0ac(self) == /\\ pc[self] = "c"\0a           /\\ y\' = [y EXCEPT ![self] = y[self] + 1]\0a           /\\ pc\' = [pc EXCEPT ![self] = "d"]\0a           /\\ UNCHANGED << x, z >>\0a\0ad(self) == /\\ pc[self] = "d"\0a           /\\ \\/ /\\ x[self] = 0\0a                 /\\ z\' = [z EXCEPT ![self] = z[self] + 1]\0a              \\/ /\\ x[self] = 2\0a                 /\\ z\' = [z EXCEPT ![self] = z[self] + 3]\0a           /\\ Assert((x[self]+y[self] = 2) \\/ ((z\'[self] = 101) /\\ (x[self]+y[self]=0)), \0a                     "Failure of assertion at line 15, column 16.")\0a           /\\ Assert((z\'[self] < 100) => (z\'[self] = x[self] + 1), \0a                     "Failure of assertion at line 16, column 16.")\0a           /\\ pc\' = [pc EXCEPT ![self] = "Done"]\0a           /\\ UNCHANGED << x, y >>\0a\0aFoo(self) == a(self) \\/ b(self) \\/ c(self) \\/ d(self)\0a\0a(* Allow infinite stuttering to prevent deadlock on termination. *)\0aTerminating == /\\ \\A self \\in ProcSet: pc[self] = "Done"\0a               /\\ UNCHANGED vars\0a\0aNext == (\\E self \\in {1, 2}: Foo(self))\0a           \\/ Terminating\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ \\A self \\in {1, 2} : WF_vars(Foo(self))\0a\0aTermination == <>(\\A self \\in ProcSet: pc[self] = "Done")\0a\0a\\* END TRANSLATION - the hash of the generated TLA code (remove to silence divergence warnings): TLA-8050fab129ad8ea32f6a8eefb5f96b57\0a\0a=============================================================================\0a']]]
      ['pcal/Either5' 'Either5' %accept ~[['Either5' '------------------------------- MODULE Either5 ------------------------------ \0aEXTENDS Naturals, Sequences, TLC\0a\0a(* --algorithm Either\0a      variables x = 0 ; y = 0 ; z = 0 ;\0a      procedure Foo(a) \0a       begin c: x := x + a ;\0a                return \0a       end procedure;           \0a      begin a: either x := 1 ; y := 0 ;\0a                   or y := 1 ; \0a                   or call Foo(1) ; \0a                     b: assert x = 1 ;\0a               end either ;\0a             d:  assert x+y = 1 ;\0a     end algorithm\0a*)\0a\0a\\* BEGIN TRANSLATION (chksum(pcal) = "145cbee8" /\\ chksum(tla) = "7faba95b")\0a\\* Label a at line 10 col 16 changed to a_\0aCONSTANT defaultInitValue\0aVARIABLES pc, x, y, z, stack, a\0a\0avars == << pc, x, y, z, stack, a >>\0a\0aInit == (* Global variables *)\0a        /\\ x = 0\0a        /\\ y = 0\0a        /\\ z = 0\0a        (* Procedure Foo *)\0a        /\\ a = defaultInitValue\0a        /\\ stack = << >>\0a        /\\ pc = "a_"\0a\0ac == /\\ pc = "c"\0a     /\\ x\' = x + a\0a     /\\ pc\' = Head(stack).pc\0a     /\\ a\' = Head(stack).a\0a     /\\ stack\' = Tail(stack)\0a     /\\ UNCHANGED << y, z >>\0a\0aFoo == c\0a\0aa_ == /\\ pc = "a_"\0a      /\\ \\/ /\\ x\' = 1\0a            /\\ y\' = 0\0a            /\\ pc\' = "d"\0a            /\\ UNCHANGED <<stack, a>>\0a         \\/ /\\ y\' = 1\0a            /\\ pc\' = "d"\0a            /\\ UNCHANGED <<x, stack, a>>\0a         \\/ /\\ /\\ a\' = 1\0a               /\\ stack\' = << [ procedure |->  "Foo",\0a                                pc        |->  "b",\0a                                a         |->  a ] >>\0a                            \\o stack\0a            /\\ pc\' = "c"\0a            /\\ UNCHANGED <<x, y>>\0a      /\\ z\' = z\0a\0ab == /\\ pc = "b"\0a     /\\ Assert(x = 1, "Failure of assertion at line 13, column 25.")\0a     /\\ pc\' = "d"\0a     /\\ UNCHANGED << x, y, z, stack, a >>\0a\0ad == /\\ pc = "d"\0a     /\\ Assert(x+y = 1, "Failure of assertion at line 15, column 18.")\0a     /\\ pc\' = "Done"\0a     /\\ UNCHANGED << x, y, z, stack, a >>\0a\0a(* Allow infinite stuttering to prevent deadlock on termination. *)\0aTerminating == pc = "Done" /\\ UNCHANGED vars\0a\0aNext == Foo \\/ a_ \\/ b \\/ d\0a           \\/ Terminating\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ WF_vars(Next)\0a\0aTermination == <>(pc = "Done")\0a\0a\\* END TRANSLATION\0a\0a=============================================================================\0a']]]
      ['pcal/Github136' 'Github136' %accept ~[['Github136' '------------------------------ MODULE Github136 -----------------------------\0a\\* Regression test for https://github.com/tlaplus/tlaplus/issues/136\0a\\* The PlusCal translator used to choke on a top-level comma inside an\0a\\* INSTANCE ... WITH clause appearing within a `define\' block.\0a\0aEXTENDS Naturals\0a\0a(*--algorithm Github136\0avariables x = 0;\0adefine\0a    Inner == INSTANCE Github136Inner WITH Foo1 <- 3, Foo2 <- 4\0aend define;\0abegin\0a    Step: x := Inner!Sum;\0aend algorithm; *)\0a\\* BEGIN TRANSLATION (chksum(pcal) = "a38a0cc5" /\\ chksum(tla) = "81c563ad")\0aVARIABLES pc, x\0a\0a(* define statement *)\0aInner == INSTANCE Github136Inner WITH Foo1 <- 3, Foo2 <- 4\0a\0a\0avars == << pc, x >>\0a\0aInit == (* Global variables *)\0a        /\\ x = 0\0a        /\\ pc = "Step"\0a\0aStep == /\\ pc = "Step"\0a        /\\ x\' = Inner!Sum\0a        /\\ pc\' = "Done"\0a\0a(* Allow infinite stuttering to prevent deadlock on termination. *)\0aTerminating == pc = "Done" /\\ UNCHANGED vars\0a\0aNext == Step\0a           \\/ Terminating\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aTermination == <>(pc = "Done")\0a\0a\\* END TRANSLATION \0a\0aXCorrect == x \\in {0, 7}\0a=============================================================================\0a'] ['Github136Inner' '------------------------------ MODULE Github136Inner ------------------------------\0aEXTENDS Naturals\0a\0aCONSTANTS Foo1, Foo2\0a\0aSum == Foo1 + Foo2\0a=============================================================================\0a']]]
      ['pcal/Github136Inner' 'Github136Inner' %accept ~[['Github136Inner' '------------------------------ MODULE Github136Inner ------------------------------\0aEXTENDS Naturals\0a\0aCONSTANTS Foo1, Foo2\0a\0aSum == Foo1 + Foo2\0a=============================================================================\0a']]]
      ['pcal/Github776' 'Github776' %accept ~[['Github776' '------------------------------ MODULE Github776 -----------------------------\0a\0aEXTENDS Naturals, Sequences, TLC\0a\0a(*--algorithm Playground {\0a\0a    \\* PlusCal does not have return values, but we can fake them\0a    variables\0a        retval,\0a        output\0a\0a    procedure add(x, y) {\0a        do_add:\0a            retval := x + y;\0a            return;\0a    }\0a\0a    procedure to_string(int) {\0a        do_to_string:\0a            assert int = 10; \\* this model only needs to be able to convert one value to a string\0a            retval := "10";\0a            return;\0a    }\0a\0a    fair process (main = 1) {\0a        step1: call add(3, 7);\0a        step2: call to_string(retval);\0a        step3: output := retval;\0a        step4: assert output = "10";\0a    }\0a\0a}*)\0a\\* BEGIN TRANSLATION (chksum(pcal) = "90defa92" /\\ chksum(tla) = "375b0aff")\0aCONSTANT defaultInitValue\0aVARIABLES pc, retval, output, stack, x, y, int\0a\0avars == << pc, retval, output, stack, x, y, int >>\0a\0aProcSet == {1}\0a\0aInit == (* Global variables *)\0a        /\\ retval = defaultInitValue\0a        /\\ output = defaultInitValue\0a        (* Procedure add *)\0a        /\\ x = [ self \\in ProcSet |-> defaultInitValue]\0a        /\\ y = [ self \\in ProcSet |-> defaultInitValue]\0a        (* Procedure to_string *)\0a        /\\ int = [ self \\in ProcSet |-> defaultInitValue]\0a        /\\ stack = [self \\in ProcSet |-> << >>]\0a        /\\ pc = [self \\in ProcSet |-> "step1"]\0a\0ado_add(self) == /\\ pc[self] = "do_add"\0a                /\\ retval\' = x[self] + y[self]\0a                /\\ pc\' = [pc EXCEPT ![self] = Head(stack[self]).pc]\0a                /\\ x\' = [x EXCEPT ![self] = Head(stack[self]).x]\0a                /\\ y\' = [y EXCEPT ![self] = Head(stack[self]).y]\0a                /\\ stack\' = [stack EXCEPT ![self] = Tail(stack[self])]\0a                /\\ UNCHANGED << output, int >>\0a\0aadd(self) == do_add(self)\0a\0ado_to_string(self) == /\\ pc[self] = "do_to_string"\0a                      /\\ Assert(int[self] = 10, \0a                                "Failure of assertion at line 20, column 13.")\0a                      /\\ retval\' = "10"\0a                      /\\ pc\' = [pc EXCEPT ![self] = Head(stack[self]).pc]\0a                      /\\ int\' = [int EXCEPT ![self] = Head(stack[self]).int]\0a                      /\\ stack\' = [stack EXCEPT ![self] = Tail(stack[self])]\0a                      /\\ UNCHANGED << output, x, y >>\0a\0ato_string(self) == do_to_string(self)\0a\0astep1 == /\\ pc[1] = "step1"\0a         /\\ /\\ stack\' = [stack EXCEPT ![1] = << [ procedure |->  "add",\0a                                                  pc        |->  "step2",\0a                                                  x         |->  x[1],\0a                                                  y         |->  y[1] ] >>\0a                                              \\o stack[1]]\0a            /\\ x\' = [x EXCEPT ![1] = 3]\0a            /\\ y\' = [y EXCEPT ![1] = 7]\0a         /\\ pc\' = [pc EXCEPT ![1] = "do_add"]\0a         /\\ UNCHANGED << retval, output, int >>\0a\0astep2 == /\\ pc[1] = "step2"\0a         /\\ /\\ int\' = [int EXCEPT ![1] = retval]\0a            /\\ stack\' = [stack EXCEPT ![1] = << [ procedure |->  "to_string",\0a                                                  pc        |->  "step3",\0a                                                  int       |->  int[1] ] >>\0a                                              \\o stack[1]]\0a         /\\ pc\' = [pc EXCEPT ![1] = "do_to_string"]\0a         /\\ UNCHANGED << retval, output, x, y >>\0a\0astep3 == /\\ pc[1] = "step3"\0a         /\\ output\' = retval\0a         /\\ pc\' = [pc EXCEPT ![1] = "step4"]\0a         /\\ UNCHANGED << retval, stack, x, y, int >>\0a\0astep4 == /\\ pc[1] = "step4"\0a         /\\ Assert(output = "10", \0a                   "Failure of assertion at line 29, column 16.")\0a         /\\ pc\' = [pc EXCEPT ![1] = "Done"]\0a         /\\ UNCHANGED << retval, output, stack, x, y, int >>\0a\0amain == step1 \\/ step2 \\/ step3 \\/ step4\0a\0a(* Allow infinite stuttering to prevent deadlock on termination. *)\0aTerminating == /\\ \\A self \\in ProcSet: pc[self] = "Done"\0a               /\\ UNCHANGED vars\0a\0aNext == main\0a           \\/ (\\E self \\in ProcSet: add(self) \\/ to_string(self))\0a           \\/ Terminating\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ WF_vars(main) /\\ WF_vars(add(1)) /\\ WF_vars(to_string(1))\0a\0aTermination == <>(\\A self \\in ProcSet: pc[self] = "Done")\0a\0a\\* END TRANSLATION \0a\0a\0aLiveness == []<>(pc[1] = "Done")\0a=============================================================================\0a\0a------------ CONFIG Github776 -----------------\0aSPECIFICATION Spec\0aCONSTANT defaultInitValue = defaultInitValue\0aPROPERTY Liveness\0a=======================================\0a']]]
      ['pcal/NotSoSimpleLoop' 'NotSoSimpleLoop' %accept ~[['NotSoSimpleLoop' '--------------------------- MODULE NotSoSimpleLoop -------------------------- \0aEXTENDS Naturals, TLC\0a\0a(*   --algorithm NotSoSimpleLoop                                             \0a     variable x = 0;                                                     \0a     begin a : while x < 10                                              \0a                 do x := x+1 ;                                           \0a                    skip ;                                               \0a                    assert x \\in 1..10\0a               end while ;                                               \0a               x := 4*x ;                                                \0a               assert x = 40 ;                                                 \0a           b : assert 2 * x = 80;                                             \0a     end algorithm                  *)\0a\0a                    \0a\\* BEGIN TRANSLATION (chksum(pcal) = "3acbf16a" /\\ chksum(tla) = "f1d2d847")\0aVARIABLES pc, x\0a\0avars == << pc, x >>\0a\0aInit == (* Global variables *)\0a        /\\ x = 0\0a        /\\ pc = "a"\0a\0aa == /\\ pc = "a"\0a     /\\ IF x < 10\0a           THEN /\\ x\' = x+1\0a                /\\ TRUE\0a                /\\ Assert(x\' \\in 1..10, \0a                          "Failure of assertion at line 9, column 21.")\0a                /\\ pc\' = "a"\0a           ELSE /\\ x\' = 4*x\0a                /\\ Assert(x\' = 40, \0a                          "Failure of assertion at line 12, column 16.")\0a                /\\ pc\' = "b"\0a\0ab == /\\ pc = "b"\0a     /\\ Assert(2 * x = 80, "Failure of assertion at line 13, column 16.")\0a     /\\ pc\' = "Done"\0a     /\\ x\' = x\0a\0a(* Allow infinite stuttering to prevent deadlock on termination. *)\0aTerminating == pc = "Done" /\\ UNCHANGED vars\0a\0aNext == a \\/ b\0a           \\/ Terminating\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ WF_vars(Next)\0a\0aTermination == <>(pc = "Done")\0a\0a\\* END TRANSLATION\0a=============================================================================\0a']]]
      ['pcal/RAB' 'RAB' %accept ~[['RAB' '------------------------------- MODULE RAB -------------------------------\0a\0aEXTENDS Naturals, Sequences, TLC\0a\0a\0a(**************************************************************************)\0a(* The Remoting Attributes bug.                                           *)\0a(*                                                                        *)\0a(*                                                                        *)\0a(* Simplified version of the c program (comment in the original):         *)\0a(*                                                                        *)\0a(*                                                                        *)\0a(*    class Attributes {                                                  *)\0a(*        int flags = 0;                                                  *)\0a(*                                                                        *)\0a(*        boolean CalcA () { ... }                                        *)\0a(*        boolean CalcB () { ... }                                        *)\0a(*                                                                        *)\0a(*        // We are not protecting against a race.                        *)\0a(*        // If there is a race while setting flags we                    *)\0a(*        // will have to compute the result again, but                   *)\0a(*        // we will always return the correct result.                    *)\0a(*                                                                        *)\0a(*        boolean isA () {                                                *)\0a(*            if ((flags & 0x02) == 0) {                                  *)\0a(*                int temp = (CalcA() ? 0x03 : 0x02);                     *)\0a(*                flags |= temp;                                          *)\0a(*            }                                                           *)\0a(*            return (flags & 0x01) != 0;                                 *)\0a(*        }                                                               *)\0a(*                                                                        *)\0a(*        boolean isB () {                                                *)\0a(*            if ((flags & 0x20) == 0) {                                  *)\0a(*                int temp = (CalcB() ? 0x30 : 0x20);                     *)\0a(*                flags |= temp;                                          *)\0a(*            }                                                           *)\0a(*            return (flags & 0x10) != 0;                                 *)\0a(*        }                                                               *)\0a(*    }                                                                   *)\0a(*                                                                        *)\0a(*                                                                        *)\0a(* CalcA and CalcB are assumed to be functions that each always returns   *)\0a(* the same value; we just do not know what value that is.  We model this *)\0a(* using an "oracle" global variable named calc.                          *)\0a(*                                                                        *)\0a(* We model the environment as a set of processes Pid.  Each process runs *)\0a(* in a loop, selecting a random attribute ("A" or "B") to access on each *)\0a(* iteration.                                                             *)\0a(*                                                                        *)\0a(**************************************************************************)\0a\0aCONSTANT Pid        \\* set of process ids\0a\0aAttr == { "A", "B" }         \\* what are the attributes\0aBoolean == { FALSE, TRUE }\0a\0aFlags == [ Attr -> [ valid: Boolean, value: Boolean ]]\0a\0a\0a\0a(**************************************************************************)\0a(* How to compute the "bitwise or" of two Flags.                          *)\0a(**************************************************************************)\0af | g == [ a \\in DOMAIN f |-> [ n \\in DOMAIN f[a] |-> f[a][n] \\/ g[a][n] ]]\0a\0a\0a\0a\0a\0a\0a\0a(*--algorithm rab\0a\0a    variables\0a        (****************************************************************)\0a        (* Global variable containing flags for all attributes.   The   *)\0a        (* initial state has all valid and value bits as FALSE.         *)\0a        (****************************************************************)\0a        flags = [ a \\in Attr |-> [ valid |-> FALSE, value |-> FALSE ]];\0a\0a\0a        (****************************************************************)\0a        (* Oracle that says what the value is for each attribute.       *)\0a        (* Technically this is a variable, but we never change it.      *)\0a        (****************************************************************)\0a        calc \\in [ Attr -> { FALSE, TRUE } ];\0a\0a\0a\0a\0a    process work \\in Pid\0a        variables\0a            (************************************************************)\0a            (* Arbitrary initial values of the correct type.            *)\0a            (************************************************************)\0a            temp = CHOOSE f \\in Flags : TRUE;\0a            myattr = CHOOSE a \\in Attr : TRUE;\0a    begin\0a      Loop:\0a        while TRUE do\0a            (************************************************************)\0a            (* Choose an attribute to access.                           *)\0a            (************************************************************)\0a            with attr \\in Attr do myattr := attr; end with;\0a\0a            if \\lnot flags[myattr].valid then\0a                (********************************************************)\0a                (* My component of the global flags variable is not     *)\0a                (* valid.   Compute the temporary.                      *)\0a                (********************************************************)\0a                temp :=\0a                [ a \\in Attr |->\0a                    IF a = myattr\0a                    THEN [ valid |-> TRUE, value |-> calc[myattr] ]\0a                    ELSE [ valid |-> FALSE, value |-> FALSE ]\0a                ];\0a\0a              FetchFlags:\0a                (********************************************************)\0a                (* Fetch the global flags variable and "bitwise or" it  *)\0a                (* into the temporary.                                  *)\0a                (********************************************************)\0a                temp := flags | temp;\0a\0a              StoreFlags:\0a                (********************************************************)\0a                (* Store the temporary back into the global flags       *)\0a                (* variable.                                            *)\0a                (********************************************************)\0a    \0a                flags := temp;\0a            end if;\0a\0a          ReadFlags:\0a            (************************************************************)\0a            (* Read my component of the global flags variable.  It is   *)\0a            (* supposed to be consistent with the oracle.               *)\0a            (************************************************************)\0a            \\* assert flags[myattr].value = calc[myattr];\0a            skip;\0a        end while;\0a    end process;\0aend algorithm\0a\0a*)    \0a\0a\0a\\* BEGIN TRANSLATION (chksum(pcal) = "da7526ed" /\\ chksum(tla) = "4913b402")\0aVARIABLES pc, flags, calc, temp, myattr\0a\0avars == << pc, flags, calc, temp, myattr >>\0a\0aProcSet == (Pid)\0a\0aInit == (* Global variables *)\0a        /\\ flags = [ a \\in Attr |-> [ valid |-> FALSE, value |-> FALSE ]]\0a        /\\ calc \\in [ Attr -> { FALSE, TRUE } ]\0a        (* Process work *)\0a        /\\ temp = [self \\in Pid |-> CHOOSE f \\in Flags : TRUE]\0a        /\\ myattr = [self \\in Pid |-> CHOOSE a \\in Attr : TRUE]\0a        /\\ pc = [self \\in ProcSet |-> "Loop"]\0a\0aLoop(self) == /\\ pc[self] = "Loop"\0a              /\\ \\E attr \\in Attr:\0a                   myattr\' = [myattr EXCEPT ![self] = attr]\0a              /\\ IF \\lnot flags[myattr\'[self]].valid\0a                    THEN /\\ temp\' = [temp EXCEPT ![self] = [ a \\in Attr |->\0a                                                               IF a = myattr\'[self]\0a                                                               THEN [ valid |-> TRUE, value |-> calc[myattr\'[self]] ]\0a                                                               ELSE [ valid |-> FALSE, value |-> FALSE ]\0a                                                           ]]\0a                         /\\ pc\' = [pc EXCEPT ![self] = "FetchFlags"]\0a                    ELSE /\\ pc\' = [pc EXCEPT ![self] = "ReadFlags"]\0a                         /\\ temp\' = temp\0a              /\\ UNCHANGED << flags, calc >>\0a\0aReadFlags(self) == /\\ pc[self] = "ReadFlags"\0a                   /\\ TRUE\0a                   /\\ pc\' = [pc EXCEPT ![self] = "Loop"]\0a                   /\\ UNCHANGED << flags, calc, temp, myattr >>\0a\0aFetchFlags(self) == /\\ pc[self] = "FetchFlags"\0a                    /\\ temp\' = [temp EXCEPT ![self] = flags | temp[self]]\0a                    /\\ pc\' = [pc EXCEPT ![self] = "StoreFlags"]\0a                    /\\ UNCHANGED << flags, calc, myattr >>\0a\0aStoreFlags(self) == /\\ pc[self] = "StoreFlags"\0a                    /\\ flags\' = temp[self]\0a                    /\\ pc\' = [pc EXCEPT ![self] = "ReadFlags"]\0a                    /\\ UNCHANGED << calc, temp, myattr >>\0a\0awork(self) == Loop(self) \\/ ReadFlags(self) \\/ FetchFlags(self)\0a                 \\/ StoreFlags(self)\0a\0aNext == (\\E self \\in Pid: work(self))\0a\0aSpec == Init /\\ [][Next]_vars\0a\0a\\* END TRANSLATION\0a\0a\0aConsistency ==\0a    \\A self \\in ProcSet :\0a    pc[self] = "ReadFlags" =>\0a        flags[myattr[self]].value = calc[myattr[self]]\0a\0a\0a============================================================================\0a']]]
      ['pcal/SBB' 'SBB' %accept ~[['SBB' '------------------------------- MODULE SBB -------------------------------\0a\0aEXTENDS Naturals, Sequences, TLC\0a\0a\0a(**************************************************************************)\0a(* The StringBuilder bug.                                                 *)\0a(**************************************************************************)\0a\0aCONSTANT Pid        \\* set of process ids\0aNoPid == CHOOSE p : p \\notin Pid\0a\0aCONSTANT Buf        \\* set of buffers\0aNoBuf == CHOOSE b : b \\notin Buf\0a\0a\0a\0a(*--algorithm sbb\0a\0a    variables\0a        sb = [ owner |-> NoPid, buf |-> CHOOSE b \\in Buf : TRUE ];\0a        availablebuffers = Buf \\ {sb.buf};\0a        publishedbuffers = {};\0a\0a\0a    process work \\in Pid\0a        variable\0a            buf = NoBuf;\0a        op = {};\0a    begin\0a      Loop:\0a        while TRUE do\0a            with lop \\in { "Publish", "Modify" } do\0a                op := lop;\0a            end with;\0a\0a        if (op = "Publish") then\0a                buf := sb.buf;          \0a              Publish1:\0a                if sb.owner # self /\\ sb.owner # NoPid then\0a                    buf := CHOOSE b \\in availablebuffers : TRUE;\0a                    availablebuffers := availablebuffers \\ {buf};\0a                else\0a                  Publish2:\0a                    sb.owner := NoPid;\0a                end if;\0a              Publish3:\0a                publishedbuffers := publishedbuffers \\cup {buf};\0a\0a\0a            else\0a                buf := sb.buf;\0a              Modify1:\0a                if sb.owner # self then\0a                    buf := CHOOSE b \\in availablebuffers : TRUE;\0a                    availablebuffers := availablebuffers \\ {buf};\0a                end if;\0a              Modify2:\0a              \\* assert buf \\notin publishedbuffers;\0a                sb.owner := self;\0a              Modify3:\0a                sb.buf := buf;\0a            end if\0a        end while;\0a    end process;\0aend algorithm\0a\0a*)    \0a\0a\0a\\* BEGIN TRANSLATION (chksum(pcal) = "a8cd067d" /\\ chksum(tla) = "17cf9c0")\0aVARIABLES pc, sb, availablebuffers, publishedbuffers, buf, op\0a\0avars == << pc, sb, availablebuffers, publishedbuffers, buf, op >>\0a\0aProcSet == (Pid)\0a\0aInit == (* Global variables *)\0a        /\\ sb = [ owner |-> NoPid, buf |-> CHOOSE b \\in Buf : TRUE ]\0a        /\\ availablebuffers = Buf \\ {sb.buf}\0a        /\\ publishedbuffers = {}\0a        (* Process work *)\0a        /\\ buf = [self \\in Pid |-> NoBuf]\0a        /\\ op = [self \\in Pid |-> {}]\0a        /\\ pc = [self \\in ProcSet |-> "Loop"]\0a\0aLoop(self) == /\\ pc[self] = "Loop"\0a              /\\ \\E lop \\in { "Publish", "Modify" }:\0a                   op\' = [op EXCEPT ![self] = lop]\0a              /\\ IF (op\'[self] = "Publish")\0a                    THEN /\\ buf\' = [buf EXCEPT ![self] = sb.buf]\0a                         /\\ pc\' = [pc EXCEPT ![self] = "Publish1"]\0a                    ELSE /\\ buf\' = [buf EXCEPT ![self] = sb.buf]\0a                         /\\ pc\' = [pc EXCEPT ![self] = "Modify1"]\0a              /\\ UNCHANGED << sb, availablebuffers, publishedbuffers >>\0a\0aPublish1(self) == /\\ pc[self] = "Publish1"\0a                  /\\ IF sb.owner # self /\\ sb.owner # NoPid\0a                        THEN /\\ buf\' = [buf EXCEPT ![self] = CHOOSE b \\in availablebuffers : TRUE]\0a                             /\\ availablebuffers\' = availablebuffers \\ {buf\'[self]}\0a                             /\\ pc\' = [pc EXCEPT ![self] = "Publish3"]\0a                        ELSE /\\ pc\' = [pc EXCEPT ![self] = "Publish2"]\0a                             /\\ UNCHANGED << availablebuffers, buf >>\0a                  /\\ UNCHANGED << sb, publishedbuffers, op >>\0a\0aPublish2(self) == /\\ pc[self] = "Publish2"\0a                  /\\ sb\' = [sb EXCEPT !.owner = NoPid]\0a                  /\\ pc\' = [pc EXCEPT ![self] = "Publish3"]\0a                  /\\ UNCHANGED << availablebuffers, publishedbuffers, buf, op >>\0a\0aPublish3(self) == /\\ pc[self] = "Publish3"\0a                  /\\ publishedbuffers\' = (publishedbuffers \\cup {buf[self]})\0a                  /\\ pc\' = [pc EXCEPT ![self] = "Loop"]\0a                  /\\ UNCHANGED << sb, availablebuffers, buf, op >>\0a\0aModify1(self) == /\\ pc[self] = "Modify1"\0a                 /\\ IF sb.owner # self\0a                       THEN /\\ buf\' = [buf EXCEPT ![self] = CHOOSE b \\in availablebuffers : TRUE]\0a                            /\\ availablebuffers\' = availablebuffers \\ {buf\'[self]}\0a                       ELSE /\\ TRUE\0a                            /\\ UNCHANGED << availablebuffers, buf >>\0a                 /\\ pc\' = [pc EXCEPT ![self] = "Modify2"]\0a                 /\\ UNCHANGED << sb, publishedbuffers, op >>\0a\0aModify2(self) == /\\ pc[self] = "Modify2"\0a                 /\\ sb\' = [sb EXCEPT !.owner = self]\0a                 /\\ pc\' = [pc EXCEPT ![self] = "Modify3"]\0a                 /\\ UNCHANGED << availablebuffers, publishedbuffers, buf, op >>\0a\0aModify3(self) == /\\ pc[self] = "Modify3"\0a                 /\\ sb\' = [sb EXCEPT !.buf = buf[self]]\0a                 /\\ pc\' = [pc EXCEPT ![self] = "Loop"]\0a                 /\\ UNCHANGED << availablebuffers, publishedbuffers, buf, op >>\0a\0awork(self) == Loop(self) \\/ Publish1(self) \\/ Publish2(self)\0a                 \\/ Publish3(self) \\/ Modify1(self) \\/ Modify2(self)\0a                 \\/ Modify3(self)\0a\0aNext == (\\E self \\in Pid: work(self))\0a\0aSpec == Init /\\ [][Next]_vars\0a\0a\\* END TRANSLATION\0a\0a\0aImmutability ==\0a    \\A self \\in ProcSet :\0a    pc[self] = "Modify2" => buf[self] \\notin publishedbuffers\0a\0aConstraint ==\0a    availablebuffers # {}\0a\0a\0a============================================================================\0a']]]
      ['sany/RecursiveDefDeclMismatch' 'RecursiveDefDeclMismatch' %reject ~[['RecursiveDefDeclMismatch' '------------------------- MODULE RecursiveDefDeclMismatch -------------------\0a\0aRECURSIVE CountDown(_,_)\0aCountDown(n) == IF n = 0 THEN TRUE ELSE CountDown(n - 1)\0a\0a=============================================================================\0a']]]
      ['simulation/BasicMultiTrace/BasicMultiTrace' 'BasicMultiTrace' %accept ~[['BasicMultiTrace' '------------------------------ MODULE BasicMultiTrace ------------------------------\0aEXTENDS Integers\0a\0a\\*\0a\\* This spec attempts to define a simple state machine that has multiple behaviors. \0a\\* Originally added to verify correctness of simulation mode in both single and multi-threaded mode.\0a\\*\0a\0aVARIABLE branch, depth\0a\0aMaxDepth == 5\0aWidth == 10\0a\0aInit == \0a    /\\ branch = 0\0a    /\\ depth = 0\0a\0aNext == \0a    \\* Pick a branch\0a    \\/ /\\ branch = 0\0a       /\\ branch\' \\in 1..Width /\\ UNCHANGED depth\0a    \\* Traverse down that branch.\0a    \\/ /\\ branch > 0 \0a       /\\ depth < MaxDepth\0a       /\\ depth\' = depth + 1 /\\ UNCHANGED branch\0a\0aSpec == Init /\\ [][Next]_<<branch, depth>>\0a\0aUnderspecifiedNext == branch\' = 0\0aUnderspecifiedInit == branch = 0\0a\0aUnderspecifiedInitSpec == UnderspecifiedInit /\\ [][Next]_<<branch, depth>>\0aUnderspecifiedNextSpec == Init /\\ [][UnderspecifiedNext]_<<branch, depth>>\0a\0a\\* A valid invariant that should be violated by the initial state.\0aInvInitState == ~(branch = 0)\0a\0a\\* A valid invariant that should be violated by the spec.\0aInv == ~(depth = 2)\0a\0a\\* A nonsensical invariant that will cause a runtime evaluation error on the initial state.\0aInvBadEvalInitState == (0 = "a")\0a\0a\\* A nonsensical invariant that will cause a runtime evaluation error on a non-initial state.\0aInvBadEvalNonInitState == IF branch = 0 THEN TRUE ELSE (0 = "a")\0a\0a\\* A valid action property that should be violated by the spec.\0aActionProp == [][branch\' > branch]_<<branch, depth>>\0a\0a\\* A nonsensical action property that will cause a runtime evaluation error.\0aActionPropBadEval == [][IF branch = 0 THEN TRUE ELSE 0 = "a"]_<<branch, depth>>\0a\0a\\* A simple state and action constraint, and an invariant that should hold true \0a\\* given either constraint.\0aStateConstraint == depth < 4\0aActionConstraint == ~(depth\' = 4 /\\ depth = 3)\0aInvConstraint   == depth <= 4\0a\0a\\* A liveness property that should be violated.\0aLivenessProp == <>(branch = -1)\0a\0a\0a=============================================================================']]]
      ['simulation/BenchmarkSpec/BenchmarkSpec' 'BenchmarkSpec' %accept ~[['BenchmarkSpec' '------------------------------ MODULE BenchmarkSpec ------------------------------\0aEXTENDS Integers, Sequences\0a\0a\\*\0a\\* This spec produces a state space with a simple tree-like structure. The maximum depth and branching\0a\\* factor of the state space tree can be controlled by setting the constant values of the spec. The goal\0a\\* is to give a spec whose state space structure is easily understandable and controllable, for the sake\0a\\* of running performance and/or correctness tests of TLC.\0a\\*\0a\0aVARIABLE hist\0a\0aInit == hist = <<>>\0a\0aCONSTANTS Depth, BranchingFactor\0a    \0aNext ==\0a    \\E e \\in 1..BranchingFactor :\0a    hist\' = Append(hist, e)    \0a\0aSpec == Init /\\ [][Next]_<<hist>>\0a\0aConstraint == Len(hist) < Depth\0a\0a\\* An arbitrary state of max length. It\'s just a sequence filled with all 1\'s.\0aInv == hist # [i \\in 1..Depth |-> 1]\0a\0a=============================================================================']]]
      ['simulation/Example1' 'Example1' %accept ~[['Example1' '------------------------------ MODULE Example1 ------------------------------\0aEXTENDS Integers, TLC, TLCExt\0a\0aVARIABLE x\0a\0aInit == x = 0\0a\0aNext == x\' = ( x + 1 ) % 10\0a\0aSpec == Init /\\ [][Next]_<<x>> /\\ []<><<TRUE>>_<<x>> \0a\0aLiveness1 == <>(x = -10)\0a\0aneg_Liveness1 == ~(Liveness1)\0a\0aXCyclesToZero == []<>(x = 0)\0a\0aAlias == [ x |-> x, l |-> TLCGet("level") ]\0a\0aPostCondition ==\0a\09CounterExample =\0a\09\09[ state |->\0a\09\09      { <<1, [x |-> 0, l |-> 1]>>,\0a\09\09        <<2, [x |-> 1, l |-> 2]>>,\0a\09\09        <<3, [x |-> 2, l |-> 3]>>,\0a\09\09        <<4, [x |-> 3, l |-> 4]>>,\0a\09\09        <<5, [x |-> 4, l |-> 5]>>,\0a\09\09        <<6, [x |-> 5, l |-> 6]>>,\0a\09\09        <<7, [x |-> 6, l |-> 7]>>,\0a\09\09        <<8, [x |-> 7, l |-> 8]>>,\0a\09\09        <<9, [x |-> 8, l |-> 9]>>,\0a\09\09        <<10, [x |-> 9, l |-> 10]>> },\0a\09\09  action |->\0a\09\09      { << <<1, [x |-> 0, l |-> 1]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<2, [x |-> 1, l |-> 2]>> >>,\0a\09\09        << <<2, [x |-> 1, l |-> 2]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<3, [x |-> 2, l |-> 3]>> >>,\0a\09\09        << <<3, [x |-> 2, l |-> 3]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<4, [x |-> 3, l |-> 4]>> >>,\0a\09\09        << <<4, [x |-> 3, l |-> 4]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<5, [x |-> 4, l |-> 5]>> >>,\0a\09\09        << <<5, [x |-> 4, l |-> 5]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<6, [x |-> 5, l |-> 6]>> >>,\0a\09\09        << <<6, [x |-> 5, l |-> 6]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<7, [x |-> 6, l |-> 7]>> >>,\0a\09\09        << <<7, [x |-> 6, l |-> 7]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<8, [x |-> 7, l |-> 8]>> >>,\0a\09\09        << <<8, [x |-> 7, l |-> 8]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<9, [x |-> 8, l |-> 9]>> >>,\0a\09\09        << <<9, [x |-> 8, l |-> 9]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<10, [x |-> 9, l |-> 10]>> >>,\0a\09\09        << <<10, [x |-> 9, l |-> 10]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example1" ] ],\0a\09\09           <<1, [x |-> 0, l |-> 1]>> >> } ]\0a\0a=============================================================================']]]
      ['simulation/Example2' 'Example2' %accept ~[['Example2' '------------------------------ MODULE Example2 ------------------------------\0aEXTENDS Integers, TLC, TLCExt\0a\0aVARIABLE x\0a\0aInit == x = 0\0a\0aNext == x\' = ( x + 1 ) % 10\0a\0aSpec == Init /\\ [][Next]_<<x>> /\\ []<><<TRUE>>_<<x>> \0a\0aLiveness2 == <>(x = 11)\0a\0aneg_Liveness2 == ~(Liveness2)\0a\0aXCyclesToZero == []<>(x = 0)\0a\0aAlias == [ x |-> x, l |-> TLCGet("level") ]\0a\0aPostCondition ==\0a\09CounterExample =\0a\09\09[ state |->\0a\09\09      { <<1, [x |-> 0, l |-> 1]>>,\0a\09\09        <<2, [x |-> 1, l |-> 2]>>,\0a\09\09        <<3, [x |-> 2, l |-> 3]>>,\0a\09\09        <<4, [x |-> 3, l |-> 4]>>,\0a\09\09        <<5, [x |-> 4, l |-> 5]>>,\0a\09\09        <<6, [x |-> 5, l |-> 6]>>,\0a\09\09        <<7, [x |-> 6, l |-> 7]>>,\0a\09\09        <<8, [x |-> 7, l |-> 8]>>,\0a\09\09        <<9, [x |-> 8, l |-> 9]>>,\0a\09\09        <<10, [x |-> 9, l |-> 10]>> },\0a\09\09  action |->\0a\09\09      { << <<1, [x |-> 0, l |-> 1]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<2, [x |-> 1, l |-> 2]>> >>,\0a\09\09        << <<2, [x |-> 1, l |-> 2]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<3, [x |-> 2, l |-> 3]>> >>,\0a\09\09        << <<3, [x |-> 2, l |-> 3]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<4, [x |-> 3, l |-> 4]>> >>,\0a\09\09        << <<4, [x |-> 3, l |-> 4]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<5, [x |-> 4, l |-> 5]>> >>,\0a\09\09        << <<5, [x |-> 4, l |-> 5]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<6, [x |-> 5, l |-> 6]>> >>,\0a\09\09        << <<6, [x |-> 5, l |-> 6]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<7, [x |-> 6, l |-> 7]>> >>,\0a\09\09        << <<7, [x |-> 6, l |-> 7]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<8, [x |-> 7, l |-> 8]>> >>,\0a\09\09        << <<8, [x |-> 7, l |-> 8]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<9, [x |-> 8, l |-> 9]>> >>,\0a\09\09        << <<9, [x |-> 8, l |-> 9]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<10, [x |-> 9, l |-> 10]>> >>,\0a\09\09        << <<10, [x |-> 9, l |-> 10]>>,\0a\09\09           [ name |-> "Next",\0a\09\09             location |->\0a\09\09                 [ beginLine |-> 8,\0a\09\09                   beginColumn |-> 9,\0a\09\09                   endLine |-> 8,\0a\09\09                   endColumn |-> 27,\0a\09\09                   module |-> "Example2" ] ],\0a\09\09           <<1, [x |-> 0, l |-> 1]>> >> } ]\0a\0a=============================================================================']]]
      ['simulation/NQSpec/NQSpec' 'NQSpec' %accept ~[['NQSpec' '------------------------------- MODULE NQSpec -------------------------------\0aEXTENDS Integers, Sequences, TLC\0a\0aCONSTANTS EnQers, DeQers, Data, InitData, Ids, Busy, NoData\0a\0aASSUME InitData \\in Data\0a\0aDone == CHOOSE D : D \\notin Data\0a\\*Busy == CHOOSE D : D \\notin Data\0aNotAnId == CHOOSE i : i \\notin Ids\0a\\*NoData == CHOOSE D : D \\notin Data\0aElements == [data : Data, id : Ids]\0aNotAnElement == CHOOSE E : E \\notin Elements\0a\0aVARIABLES enq, deq, after, adding\0avars == <<enq, deq, after, adding>>\0a\0aelts == DOMAIN after\0a\0adoneElts == elts \\ {adding[e] : e \\in EnQers}\0a\0aTypeOK == /\\ enq \\in [EnQers -> Data \\cup {Done}]\0a          /\\ deq \\in [DeQers -> Data \\cup {Busy}]\0a          /\\ elts \\in SUBSET Elements\0a          /\\ after \\in [elts -> SUBSET doneElts]\0a          /\\ adding \\in [EnQers -> Elements \\cup {NotAnElement}]\0a\0aInit ==         \0a        /\\ TLCSet(42, 1)\0a        /\\ enq = [e \\in EnQers |-> Done]\0a        /\\ deq = [d \\in DeQers |-> InitData]\0a        /\\ after = << >>\0a        /\\ adding = [e \\in EnQers |-> NotAnElement]\0a-----------------------------------------------------------------------------\0a\0aAssign(var, idx, val) == var\' = [var EXCEPT ![idx] = val]\0a\0aIdsBeingAdded == {adding[el].id : el \\in {e \\in EnQers : adding[e] # NotAnElement}}\0a\0aUnusedIds == (Ids \\ {el.id : el \\in elts}) \\ IdsBeingAdded\0a\0a\0aAddElt(el) == \0a  after\' = [x \\in elts \\cup {el} |-> \0a                 IF x = el THEN doneElts\0a                           ELSE after[x] ]\0a                           \0aRemoveElt(el) == \0a  after\' = [x \\in elts \\ {el} |-> after[x] \\ {el}]\0a\0aMinimalElts(After) == {el \\in DOMAIN After : After[el] = {}}\0aminimalElts == MinimalElts(after)\0a      \0aBeginEnq(e) == /\\ enq[e] = Done \0a               /\\ \\E D \\in Data, id \\in UnusedIds : \0a                     LET el == [data |-> D, id |-> id]\0a                     IN  /\\ Assign(enq, e, D)\0a                         /\\ AddElt(el)\0a                         /\\ Assign(adding, e, el)\0a               /\\ UNCHANGED deq\0a                           \0aEndEnq(e) == /\\ enq[e] # Done\0a             /\\ Assign(enq, e, Done)\0a             /\\ Assign(adding, e, NotAnElement)\0a             /\\ UNCHANGED <<deq, after>>\0a\0a\\*  enq, deq, elts, after, adding\0aBeginDeq(d) == /\\ deq[d] # Busy\0a               /\\ Assign(deq, d, Busy)\0a               /\\ UNCHANGED <<enq, after, adding>>\0a               \0aEndDeq(d) == /\\ deq[d] = Busy\0a             /\\ \\E el \\in minimalElts :\0a                  /\\ RemoveElt(el)\0a                  /\\ Assign(deq, d, el.data)\0a             /\\ UNCHANGED <<enq, adding>>\0a             \0aNext == \\/ \\E e \\in EnQers : BeginEnq(e)  \\/ EndEnq(e)\0a        \\/ \\E d \\in DeQers : BeginDeq(d)  \\/ EndDeq(d)\0a\0aLiveness == /\\ \\A e \\in EnQers : WF_vars(BeginEnq(e)  \\/ EndEnq(e))\0a            /\\ \\A d \\in DeQers :  WF_vars(BeginDeq(d)  \\/ EndDeq(d))\0a            \0aSpec == Init /\\ [][Next]_vars  /\\ Liveness\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Sat Nov 14 16:00:53 PST 2015 by lamport\0a\\* Created Thu Nov 05 15:07:25 PST 2015 by lamport\0a']]]
      ['simulation/NQSpec/NQSpecImpliesQSpec' 'NQSpecImpliesQSpec' %accept ~[['NQSpecImpliesQSpec' '------------------------- MODULE NQSpecImpliesQSpec -------------------------\0aEXTENDS NQSpec, FiniteSets, TLC\0a\0a\\*NoData == NotData\0aNatSetMax(S) == IF S = {} THEN 0 ELSE CHOOSE n \\in S : \\A m \\in S : n >=m\0aVARIABLE p, \\* The prophecy variable = sequence of next values read,\0a            \\* of length Cardinality(elts)\0a         Q, \\* The queue of QSpec, except as Elements with their Ids,\0a            \\* and except that it is changed only on the actions\0a            \\* of NQSpec.  Added as a history variable.\0a         s,\0a            \\* A stuttering variable to add the actions\0a            \\* corresponding to the DoEnq and DoDeq actions of QSpec\0a         enqInner, deqInner\0a            \\* History variables implementing the corresponding variables\0a            \\* of  QSpec, except deqInner gets set to an Element el instead\0a            \\* of el.data\0a\0a\\* The order of adding the variables is:\0a\\*   s, p, Q, {queue, enqInner, deqInner}\0avarsI == <<vars, p, Q,  s, enqInner, deqInner>>\0a\0atop == CHOOSE t : t \\notin {}\0abot == [EndEnq |-> TRUE, EndDeq |-> TRUE]\0a\0aTypeOKI == /\\ TypeOK\0a           /\\ Q \\in Seq(Elements)\0a           /\\ p \\in Seq(Elements)\0a           /\\ s \\in {top} \0a                 \\cup [type : {"EndDeq"}, name : DeQers \\X Elements, val : {FALSE, TRUE}]\0a                 \\cup [type : {"EndEnq"}, name : EnQers, val : {TRUE}]\0a                 \\cup [type : {"BeginEnq"}, name : EnQers, val : Seq(Elements)] \0a           /\\ enqInner \\in [EnQers -> {Done, Busy}]\0a           /\\ deqInner \\in [DeQers -> {NoData} \\cup Elements]\0a\0aInitI == /\\ Init\0a         /\\ Q = << >>\0a         /\\ enqInner = [e \\in EnQers |-> Done]\0a         /\\ \\E i \\in Ids : deqInner = [d \\in DeQers |-> [data |-> InitData,\0a                                                         id |-> i]]\0a         /\\ p = << >>\0a         /\\ s = top\0a         /\\ TLCSet(1, {})\0a\0aRemoveFrom(E, After) == [x \\in (DOMAIN After) \\  E |-> After[x] \\ E]\0aRECURSIVE IsConsistent(_, _)\0aIsConsistent(seq, After) ==\0a  IF seq = << >>\0a    THEN TRUE\0a    ELSE LET hd == Head(seq)\0a             Elts == DOMAIN After\0a         IN /\\ (hd \\in DOMAIN After) /\\ (After[hd] = {})\0a            /\\ IsConsistent(Tail(seq),\0a                            RemoveFrom({hd}, After))\0a                            \0aIsBlocking(el, After) == LET Elts == DOMAIN After\0a                             MinElts == MinimalElts(After)\0a                         IN  (el \\notin MinElts) /\\ (doneElts # {})\0a\0a\0aAllEnabled == s = top\0a\0aPostStutterEnabled(type, name) == (s # top) /\\ (s.type = type) /\\ (s.name = name)\0aPreStutterEnabled(type, name) ==  (s # top) =>\0a                                     /\\ (s.type = type) /\\ (s.name = name)\0a                                     /\\ s.val # bot[s.type]\0aAfterPreStutterEnabled(type, name) == /\\ s # top\0a                                      /\\ (s.type = type) /\\ (s.name = name)\0a                                      /\\ s.val = bot[s.type]\0a                              \0aSetStutter(type, name, val) == \0a   /\\ (s # top) =>  Assert(s.type = type /\\ s.name = name,\0a                           "SetStutter not executed by owner of stuttering variable")\0a   /\\ s\' = [type |-> type, name |-> name, val |-> val]\0a   \0aPrefix(n, seq) == [i \\in 1..n |-> seq[i]]\0aSuffix(n, seq) == [i \\in 1..(Len(seq)-n) |-> seq[i+n]]\0aSeqElts(seq) == {seq[i] : i \\in 1..Len(seq)}\0a\0aPInv == /\\ Cardinality(elts) = Len(p)\0a\0aQInv == /\\ Cardinality(SeqElts(Q)) = Len(Q) \0a        /\\ SeqElts(Q) \\subseteq elts\0a        /\\ IsConsistent(Q, after)\0a        /\\ LET n == NatSetMax({i \\in 1..Len(Q) : Prefix(i, Q) = Prefix(i, p)})\0a           IN (n < Len(Q)) => IsBlocking(p[n+1], \0a                                         RemoveFrom(SeqElts(Prefix(n, Q)), after))  \0a\0aWriter(elt) == CHOOSE e \\in EnQers : adding[e] = elt\0a\0aBeginEnqI(e) == /\\ AllEnabled \0a                /\\ BeginEnq(e) \0a                /\\ \\E el \\in Elements : p\' = Append(p, el)\0a\\*                /\\ TLCSet(1, {p\'} \\cup TLCGet(1))\0a\\*                /\\ IF (Elements \\X Elements \\subseteq TLCGet(1))\0a\\*                     THEN /\\ PrintT(TLCGet(1))\0a\\*                          /\\ Assert (FALSE, "There")\0a\\*                     ELSE TRUE\0a\\*\\*                /\\ PrintT(<<e, p, p\', after\'>>)\0a                /\\ LET RECURSIVE ToAdd(_, _)\0a                       ToAdd(i, After) == \0a                         IF (i > Len(p\')) \\/ p\'[i] \\notin MinimalElts(After)\0a                           THEN << >> \0a                           ELSE <<p\'[i]>> \\o ToAdd(i+1, RemoveFrom({p\'[i]}, After))\0a                       TA == ToAdd(Len(Q)+1, RemoveFrom(SeqElts(Q), after\'))\0a                   IN  IF TA # << >>\0a                         THEN SetStutter("BeginEnq", e, TA) \0a                         ELSE s\' = s\0a               /\\ Assign(enqInner, e, Busy)\0a               /\\ UNCHANGED <<Q, deqInner>>\0a                 \0aBeginEnqIDo(e) == /\\ PostStutterEnabled("BeginEnq", e)\0a                  /\\ Q\' = Append(Q, Head(s.val))\0a                  /\\ Assign(enqInner, Writer(Head(s.val)), Done)\0a                  /\\ IF Tail(s.val) # << >> THEN SetStutter("BeginEnq", e, Tail(s.val))\0a                                            ELSE s\' = top\0a                  /\\ UNCHANGED <<vars, p, deqInner>>\0a                  \0aDoEnqI(e) == /\\ PreStutterEnabled("EndEnq", e)\0a             /\\ enq[e] # Done \0a             /\\ IF enqInner[e] # Done \\* adding[e] \\notin SeqElts(Q)\0a                 THEN /\\ Q\' = Append(Q, adding[e])\0a                      /\\ Assign(enqInner, e, Done)\0a                 ELSE UNCHANGED <<Q, enqInner>>\0a             /\\ SetStutter("EndEnq", e, TRUE)\0a             /\\ UNCHANGED <<vars, p, deqInner>>\0a                              \0aEndEnqI(e) ==  /\\ AfterPreStutterEnabled("EndEnq", e) \0a               /\\ EndEnq(e) \0a               /\\ s\' = top\0a               /\\ UNCHANGED << p, Q, enqInner, deqInner>>\0a\0aBeginDeqI(d) == /\\ AllEnabled\0a                /\\ BeginDeq(d) \0a                /\\ Assign(deqInner, d, NoData)\0a                /\\ UNCHANGED <<p, Q, s, enqInner>>\0a\0a\\* OLD DEFS:\0a\\*DoDeqI(d) == /\\ PreStutterEnabled("EndDeq", d)\0a\\*             /\\ deq[d] = Busy\0a\\*             /\\ minimalElts # {}\0a\\*             /\\ IF s = top /\\ Q = << >>\0a\\*                  THEN /\\ \\E el \\in minimalElts : \0a\\*                             /\\ Q\' = <<el>>\0a\\*                             /\\ Assign(enqInner, Writer(el), Done)                      \0a\\*                       /\\ SetStutter("EndDeq", d, FALSE)\0a\\*                       /\\ UNCHANGED deqInner\0a\\*                  ELSE /\\ Q\' = Tail(Q)\0a\\*                       /\\ SetStutter("EndDeq", d, TRUE)\0a\\*                       /\\ Assign(deqInner, d, Head(Q))\0a\\*                       /\\ UNCHANGED enqInner\0a\\*             /\\ UNCHANGED <<vars, p>>\0a\\*\0a\\*EndDeqI(d) == /\\ AfterPreStutterEnabled("EndDeq", d) \0a\\*              /\\ EndDeq(d) \0a\\*              /\\ p = << >> \\/ Head(p) = deqInner[d]\0a\\*              /\\ p\' = Tail(p)\0a\\*              /\\ s\' = top\0a\\*              /\\ UNCHANGED <<Q, enqInner, deqInner>>\0a(***************************************************************************\0aXEndDeq(d, el) defined so that\0a\0a   EndDeq(d) == \\E el \\in Elements : XEndDeq(d, el)\0a ***************************************************************************)\0aXEndDeq(d, el) == /\\ deq[d] = Busy\0a                  /\\ el \\in minimalElts\0a                  /\\ RemoveElt(el)\0a                  /\\ Assign(deq, d, el.data)\0a             /\\ UNCHANGED <<enq, adding>>\0a\0aDoDeqI(d, el) == /\\ PreStutterEnabled("EndDeq", <<d, el>>)\0a                 /\\ deq[d] = Busy\0a                 /\\ el \\in minimalElts\0a                 /\\  \\/ p = << >> /\\ p\' = << >> /\\ Assert(FALSE, "shouldn\'t happen")\0a                     \\/ Head(p) = el /\\ p\' = Tail(p)\0a                 /\\ IF s = top /\\ Q = << >>\0a                      THEN \\* I believe this case should never occur\0a                           /\\ Q\' = <<el>>\0a                           /\\ Assign(enqInner, Writer(el), Done)                      \0a                           /\\ SetStutter("EndDeq", <<d, el>>,  FALSE)\0a                           /\\ UNCHANGED deqInner\0a                      ELSE /\\ el = Head(Q)\0a                           /\\ Q\' = Tail(Q)\0a                           /\\ SetStutter("EndDeq", <<d, el>>, TRUE)\0a                           /\\ Assign(deqInner, d, Head(Q))\0a                           /\\ UNCHANGED enqInner\0a                 /\\ UNCHANGED <<vars>>\0a\0aEndDeqI(d, el) == /\\ AfterPreStutterEnabled("EndDeq", <<d, el>>) \0a                  /\\ XEndDeq(d, el) \0a\\*                  /\\ p = << >> \\/ Head(p) = deqInner[d]\0a\\*                  /\\ p\' = Tail(p)\0a                  /\\ s\' = top\0a                  /\\ UNCHANGED <<Q, enqInner, deqInner, p>>\0a\0aNextI == \\/ \\E e \\in EnQers : BeginEnqI(e) \\/ BeginEnqIDo(e) \0a                                  \\/ DoEnqI(e) \\/ EndEnqI(e)\0a         \\/ \\E d \\in DeQers : \\/ BeginDeqI(d) \0a                              \\/ \\E el \\in Elements : DoDeqI(d, el) \\/ EndDeqI(d, el)\0a\0aSpecI == InitI /\\ [][NextI]_varsI    \0a-----------------------------------------------------------------------------\0aqueue == [i \\in 1..Len(Q) |-> Q[i].data]\0a\0adeqInnerBar == [d \\in DeQers |-> IF deqInner[d] = NoData THEN NoData\0a                                                         ELSE deqInner[d].data]\0aI == INSTANCE QSpec WITH deqInner <- deqInnerBar\0a            \0a=============================================================================\0a\\* Modification History\0a\\* Last modified Sat Nov 14 17:54:40 PST 2015 by lamport\0a\\* Created Fri Nov 06 11:05:33 PST 2015 by lamport\0a'] ['QSpec' '------------------------------- MODULE QSpec -------------------------------\0aEXTENDS Integers, Sequences, TLC\0a\0aCONSTANTS EnQers, DeQers, Data, Done, Busy, NoData, InitData\0a\0aASSUME /\\ Done     \\notin Data\0a       /\\ Busy     \\notin Data\0a       /\\ NoData   \\notin Data\0a       /\\ InitData \\in Data\0a\0aVARIABLES enq, deq, queue, enqInner, deqInner\0avars == <<enq, deq, queue, enqInner, deqInner>>\0a\0aTypeOK == /\\ enq \\in [EnQers -> Data \\cup {Done}]\0a          /\\ deq \\in [DeQers -> Data \\cup {Busy}]\0a          /\\ queue \\in Seq(Data)\0a          /\\ enqInner \\in [EnQers -> {Done, Busy}]\0a          /\\ deqInner \\in [DeQers -> {NoData} \\cup Data]\0a\0aInit == \\* /\\ PrintT("begin")\0a        /\\ enq = [e \\in EnQers |-> Done]\0a        /\\ deq = [d \\in DeQers |-> InitData]\0a        /\\ queue = << >>\0a        /\\ enqInner = [e \\in EnQers |-> Done] \\* /\\ PrintT("foo")\0a        /\\ deqInner = [d \\in DeQers |-> InitData] \\* /\\ PrintT("bar")\0a        \0aBeginEnq(e) == /\\ enq[e] = Done \0a               /\\ \\E D \\in Data : enq\' = [enq EXCEPT ![e] = D]\0a               /\\ enqInner\' = [enqInner EXCEPT ![e] = Busy]\0a               /\\ UNCHANGED <<deq, queue, deqInner>>\0a               \0aDoEnq(e) == /\\ enqInner[e] = Busy\0a            /\\ queue\' = Append(queue, enq[e])\0a            /\\ enqInner\' = [enqInner EXCEPT ![e] = Done]\0a            /\\ UNCHANGED <<deq, enq, deqInner>>\0a            \0aEndEnq(e) == /\\ enq[e] # Done\0a             /\\ enqInner[e] = Done\0a             /\\ enq\' = [enq EXCEPT ![e] = Done]\0a             /\\ UNCHANGED <<deq, queue, enqInner, deqInner>>\0a\0aBeginDeq(d) == /\\ deq[d] # Busy\0a               /\\ deq\' = [deq EXCEPT ![d] = Busy]\0a               /\\ deqInner\' = [deqInner EXCEPT ![d] = NoData]\0a               /\\ UNCHANGED <<enq, queue, enqInner>>\0a               \0aDoDeq(d) == /\\ deq[d] = Busy\0a            /\\ deqInner[d] = NoData\0a            /\\ queue # << >>\0a            /\\ deqInner\' = [deqInner EXCEPT ![d] = Head(queue)]\0a            /\\ queue\' = Tail(queue)\0a            /\\ UNCHANGED <<enq, deq, enqInner>>\0a\0aEndDeq(d) == /\\ deq[d] = Busy\0a             /\\ deqInner[d] # NoData\0a             /\\ deq\' = [deq EXCEPT ![d] = deqInner[d]]\0a             /\\ UNCHANGED <<enq, queue, enqInner, deqInner>>\0a             \0aNext == \0a    /\\ TLCSet(42, TLCGet(42))\0a    /\\  \\/ \\E e \\in EnQers : BeginEnq(e) \\/ DoEnq(e) \\/ EndEnq(e)\0a        \\/ \\E d \\in DeQers : BeginDeq(d) \\/ DoDeq(d) \\/ EndDeq(d)\0a        \0aSpec == Init /\\ [][Next]_vars\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Sat Nov 14 12:56:11 PST 2015 by lamport\0a\\* Created Wed Nov 04 15:29:04 PST 2015 by lamport\0a'] ['NQSpec' '------------------------------- MODULE NQSpec -------------------------------\0aEXTENDS Integers, Sequences, TLC\0a\0aCONSTANTS EnQers, DeQers, Data, InitData, Ids, Busy, NoData\0a\0aASSUME InitData \\in Data\0a\0aDone == CHOOSE D : D \\notin Data\0a\\*Busy == CHOOSE D : D \\notin Data\0aNotAnId == CHOOSE i : i \\notin Ids\0a\\*NoData == CHOOSE D : D \\notin Data\0aElements == [data : Data, id : Ids]\0aNotAnElement == CHOOSE E : E \\notin Elements\0a\0aVARIABLES enq, deq, after, adding\0avars == <<enq, deq, after, adding>>\0a\0aelts == DOMAIN after\0a\0adoneElts == elts \\ {adding[e] : e \\in EnQers}\0a\0aTypeOK == /\\ enq \\in [EnQers -> Data \\cup {Done}]\0a          /\\ deq \\in [DeQers -> Data \\cup {Busy}]\0a          /\\ elts \\in SUBSET Elements\0a          /\\ after \\in [elts -> SUBSET doneElts]\0a          /\\ adding \\in [EnQers -> Elements \\cup {NotAnElement}]\0a\0aInit ==         \0a        /\\ TLCSet(42, 1)\0a        /\\ enq = [e \\in EnQers |-> Done]\0a        /\\ deq = [d \\in DeQers |-> InitData]\0a        /\\ after = << >>\0a        /\\ adding = [e \\in EnQers |-> NotAnElement]\0a-----------------------------------------------------------------------------\0a\0aAssign(var, idx, val) == var\' = [var EXCEPT ![idx] = val]\0a\0aIdsBeingAdded == {adding[el].id : el \\in {e \\in EnQers : adding[e] # NotAnElement}}\0a\0aUnusedIds == (Ids \\ {el.id : el \\in elts}) \\ IdsBeingAdded\0a\0a\0aAddElt(el) == \0a  after\' = [x \\in elts \\cup {el} |-> \0a                 IF x = el THEN doneElts\0a                           ELSE after[x] ]\0a                           \0aRemoveElt(el) == \0a  after\' = [x \\in elts \\ {el} |-> after[x] \\ {el}]\0a\0aMinimalElts(After) == {el \\in DOMAIN After : After[el] = {}}\0aminimalElts == MinimalElts(after)\0a      \0aBeginEnq(e) == /\\ enq[e] = Done \0a               /\\ \\E D \\in Data, id \\in UnusedIds : \0a                     LET el == [data |-> D, id |-> id]\0a                     IN  /\\ Assign(enq, e, D)\0a                         /\\ AddElt(el)\0a                         /\\ Assign(adding, e, el)\0a               /\\ UNCHANGED deq\0a                           \0aEndEnq(e) == /\\ enq[e] # Done\0a             /\\ Assign(enq, e, Done)\0a             /\\ Assign(adding, e, NotAnElement)\0a             /\\ UNCHANGED <<deq, after>>\0a\0a\\*  enq, deq, elts, after, adding\0aBeginDeq(d) == /\\ deq[d] # Busy\0a               /\\ Assign(deq, d, Busy)\0a               /\\ UNCHANGED <<enq, after, adding>>\0a               \0aEndDeq(d) == /\\ deq[d] = Busy\0a             /\\ \\E el \\in minimalElts :\0a                  /\\ RemoveElt(el)\0a                  /\\ Assign(deq, d, el.data)\0a             /\\ UNCHANGED <<enq, adding>>\0a             \0aNext == \\/ \\E e \\in EnQers : BeginEnq(e)  \\/ EndEnq(e)\0a        \\/ \\E d \\in DeQers : BeginDeq(d)  \\/ EndDeq(d)\0a\0aLiveness == /\\ \\A e \\in EnQers : WF_vars(BeginEnq(e)  \\/ EndEnq(e))\0a            /\\ \\A d \\in DeQers :  WF_vars(BeginDeq(d)  \\/ EndDeq(d))\0a            \0aSpec == Init /\\ [][Next]_vars  /\\ Liveness\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Sat Nov 14 16:00:53 PST 2015 by lamport\0a\\* Created Thu Nov 05 15:07:25 PST 2015 by lamport\0a']]]
      ['simulation/NQSpec/QSpec' 'QSpec' %accept ~[['QSpec' '------------------------------- MODULE QSpec -------------------------------\0aEXTENDS Integers, Sequences, TLC\0a\0aCONSTANTS EnQers, DeQers, Data, Done, Busy, NoData, InitData\0a\0aASSUME /\\ Done     \\notin Data\0a       /\\ Busy     \\notin Data\0a       /\\ NoData   \\notin Data\0a       /\\ InitData \\in Data\0a\0aVARIABLES enq, deq, queue, enqInner, deqInner\0avars == <<enq, deq, queue, enqInner, deqInner>>\0a\0aTypeOK == /\\ enq \\in [EnQers -> Data \\cup {Done}]\0a          /\\ deq \\in [DeQers -> Data \\cup {Busy}]\0a          /\\ queue \\in Seq(Data)\0a          /\\ enqInner \\in [EnQers -> {Done, Busy}]\0a          /\\ deqInner \\in [DeQers -> {NoData} \\cup Data]\0a\0aInit == \\* /\\ PrintT("begin")\0a        /\\ enq = [e \\in EnQers |-> Done]\0a        /\\ deq = [d \\in DeQers |-> InitData]\0a        /\\ queue = << >>\0a        /\\ enqInner = [e \\in EnQers |-> Done] \\* /\\ PrintT("foo")\0a        /\\ deqInner = [d \\in DeQers |-> InitData] \\* /\\ PrintT("bar")\0a        \0aBeginEnq(e) == /\\ enq[e] = Done \0a               /\\ \\E D \\in Data : enq\' = [enq EXCEPT ![e] = D]\0a               /\\ enqInner\' = [enqInner EXCEPT ![e] = Busy]\0a               /\\ UNCHANGED <<deq, queue, deqInner>>\0a               \0aDoEnq(e) == /\\ enqInner[e] = Busy\0a            /\\ queue\' = Append(queue, enq[e])\0a            /\\ enqInner\' = [enqInner EXCEPT ![e] = Done]\0a            /\\ UNCHANGED <<deq, enq, deqInner>>\0a            \0aEndEnq(e) == /\\ enq[e] # Done\0a             /\\ enqInner[e] = Done\0a             /\\ enq\' = [enq EXCEPT ![e] = Done]\0a             /\\ UNCHANGED <<deq, queue, enqInner, deqInner>>\0a\0aBeginDeq(d) == /\\ deq[d] # Busy\0a               /\\ deq\' = [deq EXCEPT ![d] = Busy]\0a               /\\ deqInner\' = [deqInner EXCEPT ![d] = NoData]\0a               /\\ UNCHANGED <<enq, queue, enqInner>>\0a               \0aDoDeq(d) == /\\ deq[d] = Busy\0a            /\\ deqInner[d] = NoData\0a            /\\ queue # << >>\0a            /\\ deqInner\' = [deqInner EXCEPT ![d] = Head(queue)]\0a            /\\ queue\' = Tail(queue)\0a            /\\ UNCHANGED <<enq, deq, enqInner>>\0a\0aEndDeq(d) == /\\ deq[d] = Busy\0a             /\\ deqInner[d] # NoData\0a             /\\ deq\' = [deq EXCEPT ![d] = deqInner[d]]\0a             /\\ UNCHANGED <<enq, queue, enqInner, deqInner>>\0a             \0aNext == \0a    /\\ TLCSet(42, TLCGet(42))\0a    /\\  \\/ \\E e \\in EnQers : BeginEnq(e) \\/ DoEnq(e) \\/ EndEnq(e)\0a        \\/ \\E d \\in DeQers : BeginDeq(d) \\/ DoDeq(d) \\/ EndDeq(d)\0a        \0aSpec == Init /\\ [][Next]_vars\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Sat Nov 14 12:56:11 PST 2015 by lamport\0a\\* Created Wed Nov 04 15:29:04 PST 2015 by lamport\0a']]]
      ['suite/etest1' 'etest1' %reject ~[['etest1' '--------------- MODULE etest1 -------------\0a\0a(* Test that TLC complains if an operator is called with too many arguments. *)\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == \0a  /\\ Print("Should complain that operator Foo is called with too many arguments", TRUE)\0a  /\\ x = TRUE\0a\0aNext == UNCHANGED x\0a\0a\0aFoo(a) == a \0a\0aInv ==  Foo(x, x)\0a\0a=========================================\0a']]]
      ['suite/etest10' 'etest10' %accept ~[['etest10' '--------------- MODULE etest10  -------------\0a\0a\\* Test that TLC doesn\'t accept x \\in Int if x not a number\0a\0aEXTENDS TLC, Integers\0a\0aVARIABLE x\0a\0aInit == /\\ x = "a"\0a        /\\ Print("Should report error here", TRUE)\0a        /\\ Print(x \\in Int, TRUE)\0a\0aNext == /\\ x\'=x\0a        /\\ Print("Test failed--error not reported", TRUE)\0a=========================================\0a']]]
      ['suite/etest11' 'etest11' %accept ~[['etest11' '--------------- MODULE etest11  -------------\0a\0a\\* Test that TLC doesn\'t accept x \\in STRING if x not a string\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0aInit == /\\ x = 1\0a        /\\ Print("Should report error here", TRUE)\0a        /\\ Print(x \\in STRING, TRUE)\0a\0aNext == /\\ x\'=x\0a        /\\ Print("Test failed--error not reported", TRUE)\0a=========================================\0a']]]
      ['suite/etest12' 'etest12' %accept ~[['etest12' '-------------------------- MODULE etest12 --------------------------------\0aEXTENDS Naturals, TLC, FiniteSets\0a\\* Test of error reporting when computing Cardinality of a huge set.\0a\0aASSUME\0a     IF Cardinality ([0..2 -> 1..2000]) = Cardinality ([2..4 -> 1..2000]) \0a       THEN Print("Test 22 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 22 Failed")\0a==========================================================================']]]
      ['suite/etest13' 'etest13' %accept ~[['etest13' '-------------------------- MODULE etest13 --------------------------------\0aEXTENDS Naturals, TLC, FiniteSets\0a\\* Test of error reporting when computing Cardinality of a huge set.\0a\0aASSUME\0a     IF Cardinality ([0..2 -> 1..2000]) = Cardinality ([2..4 -> 1..2000]) \0a       THEN Print("Test 22 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 22 Failed")\0a==========================================================================']]]
      ['suite/etest14' 'etest14' %accept ~[['etest14' '----------------------  MODULE etest14 -----------------------------\0a\0a\\* Test of CHOOSEing element of empty set.\0aASSUME\0a  /\\ (CHOOSE y \\in {} : TRUE) = (CHOOSE y \\in {} : TRUE)\0a=====================================================================\0a']]]
      ['suite/etest15' 'etest15' %accept ~[['etest15' '----------------------  MODULE etest15 -----------------------------\0a\\* Test that TLC distinguishes <<x>> from x in function expressions.\0a\0aEXTENDS Naturals\0a\0aS == {<<y>> : y \\in {1, 2, 3, 4}}\0a\0aASSUME  [<<y>> \\in S |-> y+1][2] = [<<y>> \\in S |-> y+1][2] \0a  \0a=====================================================================\0a']]]
      ['suite/etest16' 'etest16' %reject ~[['etest16' '--------------- MODULE etest16 -----------\0a\0a\\* Test of detecting duplicate record elements\0a\0aFoo == [a |-> 1, b |-> 2, a |-> 1]\0a\0aBar == [a : {1}, b : {2}, a : {1}]\0a=============================================================================\0a\0a\0a\0a']]]
      ['suite/etest2' 'etest2' %reject ~[['etest2' '--------------- MODULE etest2 -------------\0a\0a(* Test that TLC complains if a operator is called with too few arguments. *)\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == \0a  /\\ Print("Should complain that operator Foo is called with too few arguments", TRUE)\0a  /\\ x = TRUE\0a\0aNext == UNCHANGED x\0a\0a\0aFoo(a, b) == a /\\ b\0a\0aInv ==  Foo(x)\0a\0a=========================================\0a']]]
      ['suite/etest3' 'etest3' %accept ~[['etest3' '--------------- MODULE etest3  -------------\0a\0a(* Testing deadlock and number of states found. *)\0a\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aVARIABLE x, y, z\0a\0aInit == /\\ Print("This test should deadlock after finding two states", TRUE)\0a        /\\ x = {}\0a        /\\ y = {}\0a        /\\ z = 1\0a\0aNext == /\\ x = {}\0a        /\\ x\' = {1}        \0a        /\\ y\' \\in SUBSET x\'\0a        /\\ z\' = z\0a        /\\ y\' = {}\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/etest4' 'etest4' %accept ~[['etest4' '--------------- MODULE etest4  -------------\0a\0a(* Evaluates m[v] for model-value m. *)\0a\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aVARIABLE x\0aCONSTANT A\0a\0a\0a\0aReq == [  mask |-> A  ]\0aInit == /\\ x = 1\0a        /\\ Print("Should report error for applying model value to arg", TRUE)\0a        /\\ Req.mask[1] = 1\0a        /\\ Print("Should never get this far", TRUE)\0a\0aNext == UNCHANGED x\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/etest5' 'etest5' %reject ~[['etest5' '--------------- MODULE etest5  -------------\0a\0a(* M!Ident for nonexistent module M. *)\0a\0aEXTENDS TLC, Naturals\0a\0aVARIABLE x\0a\0aInit == /\\ x = 1\0a        /\\ Print("Should report error for nonexistent module M", TRUE)\0a\0aNext == /\\ UNCHANGED x\0a        /\\ IF M!Init THEN TRUE\0a                     ELSE TRUE\0a        /\\ Print("Should not get this far", TRUE)\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/etest6' 'etest6' %accept ~[['etest6' '--------------- MODULE etest6 -------------\0a\0a(* Defining x\' in terms of x\' *)\0a\0aEXTENDS TLC, Integers, Sequences, FiniteSets\0a\0aVARIABLE x\0a\0aInit == /\\ Print("Should complain about undefined value of x.", TRUE)\0a        /\\ x = [i \\in {1,2} |-> i]\0a\0a\0aAction(c) == c\' = [c EXCEPT ![1] = (c[2])\']\0a\0aNext ==  \\/ /\\ x[1] = 1\0a            /\\ Action(x)\0a            /\\ Print("Should not get this far", TRUE)\0a\0a         \\/ UNCHANGED x\0a\0aInv ==  TRUE\0a         \0a\0aConstraint == TRUE\0a=========================================\0a']]]
      ['suite/etest7' 'etest7' %accept ~[['etest7' '--------------- MODULE etest7  -------------\0a\0a(* Test replacement of constant with nonconstant operator. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aCONSTANT C\0a\0aVARIABLE x\0a\0aFoo == x\0a\0aNext == x\' = C\0a\0aInit == /\\ Print("TLC should complain about replacing the constant C", TRUE)\0a        /\\ Print("by the nonconstant Foo", TRUE)\0a        /\\ x = 2\0a\0aInv ==  x = 2\0a\0a=========================================\0a']]]
      ['suite/etest8' 'etest8' %accept ~[['etest8' '--------------- MODULE etest8  -------------\0a\0a(* Test that simulation mode doesn\'t check for deadlock. *)\0a\0aEXTENDS TLC\0a\0a\0aVARIABLE x\0a\0aInit == /\\ x \\in {"a", "b"}\0a        /\\ Print("This spec can deadlock, but shouldn\'t.", TRUE)\0a\0aNext == \\/ /\\ x = "b"\0a           /\\ x\' = "c"\0a        \\/ /\\ x = "c"\0a           /\\ x\' = "d"\0a        \\/ /\\ x = "d"\0a           /\\ x\' = "d"\0a           /\\ Assert(FALSE, "Test successfully completed.")\0a\0a=========================================\0a']]]
      ['suite/etest9' 'etest9' %accept ~[['etest9' '--------------- MODULE etest9  -------------\0a\0a\\* Test that TLC doesn\'t accept x \\in Nat if x not a number\0a\0aEXTENDS TLC, Naturals\0a\0aVARIABLE x\0a\0aInit == /\\ x = "a"\0a        /\\ Print("Should report error here", TRUE)\0a        /\\ Print(x \\in Nat, TRUE)\0a\0aNext == /\\ x\'=x\0a        /\\ Print("Test failed--error not reported", TRUE)\0a=========================================\0a']]]
      ['suite/test' 'test' %reject ~[['test' '------------- MODULE Foo  --------------\0aEXTENDS Naturals\0a\0aFoo == \\A x \\in {1} : lab(x) :: x = 1\0a\0aBar == Foo!lab(1)\0a\0aASSUME Bar\0a=============================================\0a']]]
      ['suite/test1' 'test1' %accept ~[['test1' '--------------- MODULE test1 -------------\0a\0a(* test equality of various representations of sets.    *)\0a\0aEXTENDS Naturals, TLC\0a\0aVARIABLE x\0a\0a\0aType == x \\in {1}\0aInv  == \0a /\\ IF {1, 2, 3} # {3, 2, 2, 1}\0a      THEN Assert(FALSE, "Failed Test 1")\0a      ELSE Print("Test 1 OK", TRUE)\0a\0a /\\ IF  {1, 2, 3} # {i \\in {5, 4, 3, 2, 1} : i < 4}\0a      THEN Assert(FALSE, "Failed Test 2")\0a      ELSE Print("Test 2 OK", TRUE)\0a\0a /\\ IF {1, 2, 3} # {i-3 : i \\in {4, 6, 5, 6, 5, 6}}\0a      THEN Assert(FALSE, "Failed Test 3")\0a      ELSE Print("Test 3 OK", TRUE)\0a\0a /\\ IF SUBSET {1, 2, 3} # {{}, {1}, {2,1,2}, {3,1}, {2}, {3}, {3,2,3}, {1,2,3}}\0a      THEN Assert(FALSE, "Failed Test 4")\0a      ELSE Print("Test 4 OK", TRUE)\0a\0a /\\ IF {1,2,3} # UNION (SUBSET {1, 2, 3})\0a      THEN Assert(FALSE, "Failed Test 5")\0a      ELSE Print("Test 5 OK", TRUE)    \0a\0a /\\ IF {1,2,3} # UNION {{1}, {2}, {3, 2, 1}}\0a      THEN Assert(FALSE, "Failed Test 6")\0a      ELSE Print("Test 6 OK", TRUE)\0a\0a /\\ IF {1,2,3} # {1} \\cup {3, 2} \\cup {}\0a      THEN Assert(FALSE, "Failed Test 7")\0a      ELSE Print("Test 7 OK", TRUE)\0a\0a /\\ IF {1,2,3} # {5, 4, 3, 2, 1} \\cap {1, 3, 0, 2}\0a      THEN Assert(FALSE, "Failed Test 8")\0a      ELSE Print("Test 8 OK", TRUE)\0a\0a /\\ IF {1,2,3} \\subseteq {5, 3, 3, 4, 2}\0a      THEN Assert(FALSE, "Failed Test 9")\0a      ELSE Print("Test 9 OK", TRUE)\0a\0a /\\ IF {1,2,3} # {5, 3, 3, 4, 2,1} \\ {4, 5}\0a      THEN Assert(FALSE, "Failed Test 10")\0a      ELSE Print("Test 10 OK", TRUE)\0a\0a /\\ IF {1,2,3} # 1..3\0a      THEN Assert(FALSE, "Failed Test 11")\0a      ELSE Print("Test 11 OK", TRUE)\0a\0a /\\ IF {1,2,3} # DOMAIN <<"a", "b", "c">>\0a      THEN Assert(FALSE, "Failed Test 12")\0a      ELSE Print("Test 12 OK", TRUE)\0a\0a /\\ IF {1,2,3} # DOMAIN [i \\in {3,2,2,1} |-> i+1]\0a      THEN Assert(FALSE, "Failed Test 13")\0a      ELSE Print("Test 13 OK", TRUE)\0a\0a /\\ IF {"a", "b", "c"} # DOMAIN [a |-> 1, b |-> 2, c |-> 3]\0a      THEN Assert(FALSE, "Failed Test 14")\0a      ELSE Print("Test 14 OK", TRUE)\0a\0a /\\ IF {} # [{1, 2, 3} -> {}]\0a      THEN Assert(FALSE, "Failed Test 15")\0a      ELSE Print("Test 15 OK", TRUE)\0a\0a /\\ Print("Test Completed", TRUE)\0a\0aInit == x = 1\0a\0aNext == UNCHANGED x\0a=========================================\0a']]]
      ['suite/test10' 'test10' %accept ~[['test10' '--------------- MODULE test10 -------------\0a\0a(* Test of function definition and application *)\0a\0aEXTENDS Integers, TLC\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0af1[i \\in Int]  == i+2\0af2[i, j \\in Int] == i+j\0af3[i, j \\in Int, <<k,l>> \\in Int \\X Int, m \\in {5, 7,8}] == \0a        i + 2*j + 3*k + 4*l + 5*m\0af4[i, j \\in Int] == [a |-> i, b |-> j]\0a\0af5[i, j, k \\in Int] == i+j+k\0a\0af6[i, j, k \\in Int, <<l, m, n>> \\in Int \\X Int \\X Int, p \\in {5,7,8}] ==\0a        i + 2*j + 3*k + 4*l + 5*m + 6*n + 7*p\0a\0aInv  ==  \0a\0aLET r1 == [a |-> f1, b |-> f2]\0a    g1 == [f4 EXCEPT ![1,2].a = 22, ![1,3].b = 33]\0a    g2 == [[<<i, j>> \\in (1..10) \\X (1..10) \0a            |-> [a |-> i, b |-> j]] EXCEPT ![1,2].a = 22, ![1,3].b = 33]\0aIN\0a  /\\ IF f1[3] # 5\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF f2[3,4] # 7\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF f2[<<3,4>>] # 7\0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF f3[1, 2, <<3, 4>>, 5] # 55\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF f3[<<1, 2, <<3, 4>>, 5>>] # 55\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a\0a  /\\ IF [i \\in Int |-> i+2][3] # 5\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF [i, j \\in Int |-> i+j][3,4] # 7\0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF [i, j \\in Int |-> i+j][<<3,4>>] # 7\0a       THEN Assert(FALSE, "Test 8 Failed")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF [i, j \\in Int, <<k,l>> \\in Int \\X Int, m \\in {5,7,8} \0a         |-> i + 2*j + 3*k + 4*l + 5*m][1, 2, <<3, 4>>, 5] # 55\0a       THEN Assert(FALSE, "Test 9 Failed")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF [i, j \\in Int, <<k,l>> \\in Int \\X Int, m \\in {5,7,8} \0a         |-> i + 2*j + 3*k + 4*l + 5*m][<<1, 2, <<3, 4>>, 5>>] # 55\0a       THEN Assert(FALSE, "Test 10 Failed")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF [f1 EXCEPT ![3] = [i \\in Int |-> @ + i]][3][7] # 12\0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF [f1 EXCEPT ![3] = [i \\in Int |-> @ + i],  ![3][6] = 44][3][6] # 44\0a       THEN Assert(FALSE, "Test 12 Failed")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF [f1 EXCEPT ![3] = [i \\in Int |-> @ + i], ![3][6] = 44][3][7] # 12\0a       THEN Assert(FALSE, "Test 13 Failed")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0a  /\\ IF f4[3,4].a # 3\0a       THEN Assert(FALSE, "Test 14 Failed")\0a       ELSE Print("Test 14 OK", TRUE)\0a\0a  /\\ IF [f4 EXCEPT ![3,4].b = 17][3,4].b # 17\0a       THEN Assert(FALSE, "Test 15 Failed")\0a       ELSE Print("Test 15 OK", TRUE)\0a\0a  /\\ IF [f4 EXCEPT ![3,4].b = 17][3,4].a # 3\0a       THEN Assert(FALSE, "Test 16 Failed")\0a       ELSE Print("Test 16 OK", TRUE)\0a\0a  /\\ IF [f4 EXCEPT ![3,4].b = 17][2,4].b # 4\0a       THEN Assert(FALSE, "Test 17 Failed")\0a       ELSE Print("Test 17 OK", TRUE)\0a\0a  /\\ IF [f4 EXCEPT ![3,4].b = 17, ![3,4].a = 18][3,4].b # 17\0a       THEN Assert(FALSE, "Test 18 Failed")\0a       ELSE Print("Test 18 OK", TRUE)\0a\0a  /\\ IF [f4 EXCEPT ![3,4].b = 17, ![3,4].a = 18][3,4].a # 18\0a       THEN Assert(FALSE, "Test 19 Failed")\0a       ELSE Print("Test 19 OK", TRUE)\0a\0a  /\\ IF [f4 EXCEPT ![3,4].b = 17, ![3,4].a = 18, ![3,4].b= @+5][3,4].b # 22\0a       THEN Assert(FALSE, "Test 20 Failed")\0a       ELSE Print("Test 20 OK", TRUE)\0a\0a  /\\ IF [f4 EXCEPT ![3,4].b = 17, ![3,4].a = 18, ![<<3,4>>].b= @+5][3,4].b # 22\0a       THEN Assert(FALSE, "Test 21 Failed")\0a       ELSE Print("Test 21 OK", TRUE)\0a\0a  /\\ IF g1[1,3].a # 1 \\/ g1[1,3].a # 1\0a       THEN Assert(FALSE, "Test 22 Failed")\0a       ELSE Print("Test 22 OK", TRUE)\0a\0a  /\\ IF g2[1,3].a # 1 \\/ g2[1,3].a # 1\0a       THEN Assert(FALSE, "Test 23 Failed")\0a       ELSE Print("Test 23 OK", TRUE)\0a\0a  /\\ IF g1[1,2].a # 22 \\/ g1[1,2].a # 22\0a       THEN Assert(FALSE, "Test 24 Failed")\0a       ELSE Print("Test 24 OK", TRUE)\0a\0a  /\\ IF g2[1,2].a # 22 \\/ g2[1,2].a # 22\0a       THEN Assert(FALSE, "Test 25 Failed")\0a       ELSE Print("Test 25 OK", TRUE)\0a\0a  /\\ IF f5[3,4,5] # 12\0a       THEN Assert(FALSE, "Test 26 Failed")\0a       ELSE Print("Test 26 OK", TRUE)\0a\0a  /\\ IF f5[<<3,4,5>>] # 12\0a       THEN Assert(FALSE, "Test 27 Failed")\0a       ELSE Print("Test 27  OK", TRUE)\0a\0a  /\\ IF f6[1, 2, 3, <<4,5,6>>, 7] # 140\0a       THEN Assert(FALSE, "Test 28 Failed")\0a       ELSE Print("Test 28 OK", TRUE)\0a\0a  /\\ IF f6[<<1, 2, 3, <<4,5,6>>, 7>>] # 140\0a       THEN Assert(FALSE, "Test 29 Failed")\0a       ELSE Print("Test 29 OK", TRUE)\0a\0a  /\\ IF [i, j, k \\in Int |-> i+j+k][3,4,5] # 12\0a       THEN Assert(FALSE, "Test 30 Failed")\0a       ELSE Print("Test 30 OK", TRUE)\0a\0a  /\\ IF [i, j, k \\in Int |-> i+j+k][<<3,4,5>>] # 12\0a       THEN Assert(FALSE, "Test 31 Failed")\0a       ELSE Print("Test 31 OK", TRUE)\0a\0a\0a\0a\0a=========================================\0a']]]
      ['suite/test11' 'test11' %accept ~[['test11' '--------------- MODULE test11 -------------\0a\0a(* Test of DOMAIN and Function Sets *)\0a\0aEXTENDS Integers, TLC, FiniteSets\0a\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0af1[i \\in Int] == i+3\0a\0aS == [1..4 -> Nat]\0a\0aInv  ==  \0a  /\\ IF 5 \\notin DOMAIN f1\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF 5 \\notin DOMAIN [i \\in Int |-> i+3]\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF {1,2,3} \\notin DOMAIN [T \\in SUBSET Int |-> T \\cup {1}]\0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF Cardinality(DOMAIN [i \\in {1,3,5} |-> i+7]) # 3\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF Cardinality(DOMAIN [f \\in [{1,3,5} -> {1,2}] |-> f[3]]) # 8\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF Cardinality(DOMAIN [f \\in {g \\in [{1,3,5} -> {1,2}] : g[3]=1} \0a                              |-> f[3]]) # 4\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF [i \\in {1,3, 5} |-> i-2] \\notin \0a            {g \\in [{1,3,5} -> -2..3] : g[3]=1}\0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF ~ ((DOMAIN [a |-> 1, b |-> 2]) \\subseteq {"a", "b", "cde"})\0a       THEN Assert(FALSE, "Test 8 Failed")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF <<1, 2, 3, 4>> \\notin S\0a       THEN Assert(FALSE, "Test 9 Failed")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF <<1, 2, -3, 4>> \\in S\0a       THEN Assert(FALSE, "Test 10 Failed")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF <<1, 2, 4>> \\in S\0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF [i \\in {1, 2} |-> i] \\in S\0a       THEN Assert(FALSE, "Test 12 Failed")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF [i \\in {1, 2, 3, 4} |-> i+1] \\notin S\0a       THEN Assert(FALSE, "Test 13 Failed")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0a  /\\ IF [i \\in {1, 2, 3, 4} |-> i-2] \\in S\0a       THEN Assert(FALSE, "Test 14 Failed")\0a       ELSE Print("Test 14 OK", TRUE)\0a\0a  /\\ IF [i \\in 1..100 |-> i+1]    \\notin [1..100 -> Nat]\0a       THEN Assert(FALSE, "Test 15 Failed")\0a       ELSE Print("Test 15 OK", TRUE)\0a\0a  /\\ IF [i \\in 1..10  |-> i+1]    \\in [1..100 -> Nat]\0a       THEN Assert(FALSE, "Test 16 Failed")\0a       ELSE Print("Test 16 OK", TRUE)\0a\0a  /\\ IF [i \\in {99, 100} |-> i+1] \\in [1..100 -> Nat]\0a       THEN Assert(FALSE, "Test 17 Failed")\0a       ELSE Print("Test 17 OK", TRUE)\0a\0a  /\\ IF [i \\in {"a", "b"} |-> i]  \\in [1..100 -> Nat]\0a       THEN Assert(FALSE, "Test 18 Failed")\0a       ELSE Print("Test 18 OK", TRUE)\0a\0a  /\\ IF [a |-> 1, b |-> 2]        \\in [1..100 -> Nat]\0a       THEN Assert(FALSE, "Test 19 Failed")\0a       ELSE Print("Test 19 OK", TRUE)\0a\0a  /\\ Print("Test 20: Enumeration of [{1+1,2} -> {3-1,2,1+1}]", TRUE)\0a  /\\ \\A f \\in [{1+1,2} -> {3-1,2,1+1}] : Print(f, TRUE)\0a\0a  /\\ Print(<<"Test 21: evaluation of [{1+1,2} -> {3-1,2,1+1}] = ", \0a                [{1+1,2} -> {3-1,2,1+1}]>>, TRUE)\0a\0a  /\\ IF /\\ Cardinality ([0..1 -> 1..2000]) = 4000000\0a        /\\ Cardinality (1..8099) = 8099\0a       THEN Print("Test 22 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 22 Failed")\0a\0a  /\\ IF DOMAIN [i \\in {1,2}, j \\in {3,4} |-> i+j] # {1,2} \\X {3, 4}\0a       THEN Assert(FALSE, "Test 23 Failed")\0a       ELSE Print("Test 23 OK", TRUE)\0a\0a  /\\ IF DOMAIN [i \\in {1,2}, j \\in {3,4}, k \\in {5,6} |-> i+j+k] \0a                    # {1,2} \\X {3, 4} \\X {5, 6}\0a       THEN Assert(FALSE, "Test 24 Failed")\0a       ELSE Print("Test 24 OK", TRUE)\0a\0a  /\\ IF <<1,3,5>> \\notin \0a           DOMAIN [i \\in {1,2}, j \\in {3,4}, k \\in {5,6} |-> i+j+k] \0a       THEN Assert(FALSE, "Test 25 Failed")\0a       ELSE Print("Test 25 OK", TRUE)\0a=========================================\0a']]]
      ['suite/test12' 'test12' %accept ~[['test12' '--------------- MODULE test12 -------------\0a\0a(* Test of Record constructs. *)\0a\0aEXTENDS Integers, TLC, FiniteSets\0a\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0a\0aInv  ==  \0aLET r1 == [l1 |-> 1, l2 |-> 2, l3 |-> 3]\0a   r2 == [l1 |-> r1, l2 |-> [r1 EXCEPT !.l2 = 22], l3 |-> [r1 EXCEPT !.l3 = 33]]\0a   r3 == [l1 |-> [i \\in Int |-> i+1], \0a          l2 |-> [i , j \\in Int |-> [m1 |->i+2, m2 |-> j+3]]]\0a   \0a   r4 == [a |-> [i \\in 1..1 |-> i],\0a          b |-> [i \\in 1..1 |-> 2]]\0a\0a   S1 == [l1 : Int, l2 : [{1,2} -> {i \\in Int : i > 5}]]\0a   S2(j) == [l1 : {1,3}, l2 : {f \\in [{1,2} -> 1..10] : f[1] > j /\\ f[2] > j}]\0a   S3 == [l1 : Int, l2 : SUBSET [{1,2} -> {2,3}]]\0a\0aIN\0a  /\\ IF r1.l1 # 1 \\/ r1.l1 # 1\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF r1["l1"] # 1 \\/ r1["l1"] # 1\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF [l1 |-> 1, l2 |-> 2, l3 |-> 3].l1 # 1\0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF [l1 |-> 1, l2 |-> 2, l3 |-> 3]["l1"] # 1\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF [1l |-> 1, 2l |-> 2, 3l |-> 3]["2l"] # 2\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF r2.l1 # r1 \\/ r2.l1 # r1\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF r2.l2.l2 # 22 \\/ r2.l2.l2 # 22\0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF r2.l2.l1 # 1 \\/ r2.l2.l1 # 1\0a       THEN Assert(FALSE, "Test 8 Failed")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF [r2 EXCEPT !.l2.l1 = 44, !.l2.l3=55].l2.l1 # 44\0a       THEN Assert(FALSE, "Test 9 Failed")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF [r2 EXCEPT !.l2.l1 = 44, !.l2.l3=55].l2.l2 # 22\0a       THEN Assert(FALSE, "Test 10 Failed")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF r3.l2[5,6].m1 # 7 \\/ r3.l2[5,6].m1 # 7\0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF [i , j \\in Int |-> [m1 |->i+2, m2 |-> j+3]][5,6].m2 # 9\0a       THEN Assert(FALSE, "Test 12 Failed")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF r3.l2[5,6].m2 # 9 \\/ r3.l2[5,6].m2 # 9\0a       THEN Assert(FALSE, "Test 14 Failed")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0a  /\\ IF [l1 |-> 1, l2 |-> [i \\in {1,2} |-> i+5]] \\notin S1\0a       THEN Assert(FALSE, "Test 14 Failed")\0a       ELSE Print("Test 14 OK", TRUE)\0a\0a  /\\ IF [l1 |-> 1, l2 |-> [i \\in {1,2} |-> i+4]] \\in S1\0a       THEN Assert(FALSE, "Test 15 Failed")\0a       ELSE Print("Test 15 OK", TRUE)\0a\0a  /\\ IF ~(S2(5) \\subseteq S1) \\/ ~(S2(5) \\subseteq S1)\0a       THEN Assert(FALSE, "Test 16 Failed")\0a       ELSE Print("Test 16 OK", TRUE)\0a\0a  /\\ IF S2(4) \\subseteq S1 \\/ S2(4) \\subseteq S1\0a       THEN Assert(FALSE, "Test 17 Failed")\0a       ELSE Print("Test 17 OK", TRUE)\0a  /\\ IF Cardinality(S2(5)) # 50 \\/ Cardinality(S2(5)) # 50\0a       THEN Assert(FALSE, "Test 18 Failed")\0a       ELSE Print("Test 18 OK", TRUE)\0a\0a  /\\ IF Cardinality([l1 : {1,2}, \0a                     l2 : {1, 2, 3, 4, 4, 4, 4}, l3 : {3, 3, 2, 1}]) # 24\0a       THEN Assert(FALSE, "Test 19 Failed")\0a       ELSE Print("Test 19 OK", TRUE)\0a\0a  /\\ IF ~(\\A r \\in S2(5) : r.l2[1] > 5) \\/ ~(\\A r \\in S2(5) : r.l2[1] > 5)\0a       THEN Assert(FALSE, "Test 20 Failed")\0a       ELSE Print("Test 20 OK", TRUE)\0a\0a  /\\ IF [l1 |-> -4, l2 |-> {<<3,2>>}] \\notin S3\0a       THEN Assert(FALSE, "Test 21 Failed")\0a       ELSE Print("Test 21 OK", TRUE)\0a\0a  /\\ IF [l1 |-> -4, l2 |-> {<<3,4>>}] \\in S3\0a       THEN Assert(FALSE, "Test 22 Failed")\0a       ELSE Print("Test 22 OK", TRUE)\0a\0a  /\\ IF [r4 EXCEPT !["a"][1] = 2]["a"][1] # 2\0a       THEN Assert(FALSE, "Test 23 Failed")\0a       ELSE Print("Test 23 OK", TRUE)\0a\0a=========================================\0a']]]
      ['suite/test13' 'test13' %accept ~[['test13' '--------------- MODULE test13 -------------\0a\0a(* Test of Tuples and Cartesian products. *)\0a\0aEXTENDS Integers, TLC, FiniteSets, Sequences\0a\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0aInv  ==  \0aLET S1 == {1,2,3} \\X {"a", "b", "c", "d"}\0a    S2 == Int \\X [{1,2,3} -> {4, 5, 6}]\0a    S3 == {1,2,3} \\X {"a", "b", "c", "d"} \\X {4,5}\0a    S4 == Int \\X [{1,2,3} -> {4, 5, 6}] \\X Seq(Int)\0a\0aIN\0a  /\\ IF Cardinality(S1) # 12 \\/ Cardinality(S3) # 24\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF \\/ <<-5, <<4,4,4>> >> \\notin S2\0a        \\/ <<-5, <<4,4,4>>, <<-1,-2,-3>> >>  \\notin S4\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF <<-5, -4>> \\notin Int \\X Int\0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF <<-5, <<4,4,3>>>> \\in S2\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF {<<"a", "b", "c">>[i] : i \\in 1..3} \0a          # DOMAIN [a |-> 1, b |-> 2, c |-> {}]\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF [i \\in {1, 2} |-> IF i = 1 THEN "a" ELSE 22] # <<"a", 22>>\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF [i \\in {1, 2} |-> IF i = 1 THEN "a" ELSE 22] =  <<"a", 23>>\0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF <<1,2>> \\notin Seq(Int)\0a       THEN Assert(FALSE, "Test 8 Failed")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF <<1,2>> \\notin Seq({n \\in Int : n < 22})\0a       THEN Assert(FALSE, "Test 9 Failed")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF <<1,2>> \\in Seq({n \\in Int : n > 22})\0a       THEN Assert(FALSE, "Test 9 Failed")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF <<-5, -4, -3>> \\notin Int \\X Int \\X Int\0a       THEN Assert(FALSE, "Test 10 Failed")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF <<-5, <<4,4,3>>, <<1,-1>> >> \\in S4\0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a =========================================\0a']]]
      ['suite/test14' 'test14' %accept ~[['test14' '--------------- MODULE test14 -------------\0a\0a(* Test of IF and CASE and nested junctions *)\0a\0aEXTENDS Integers, TLC, FiniteSets, Sequences\0a\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0aInv  ==  \0a\0a  /\\ IF (IF TRUE THEN IF FALSE THEN 3 ELSE 2 ELSE 1) # 2\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF (CASE FALSE -> 1 [] TRUE -> CASE FALSE -> 2 [] TRUE -> 3 [] OTHER -> 4)\0a          # 3\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF (CASE FALSE -> 1 [] FALSE -> CASE FALSE -> 2 [] TRUE -> 3 \0a               [] OTHER -> 4 [] TRUE -> 5) # 5\0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF (CASE FALSE -> 1 [] TRUE -> CASE FALSE -> 2 [] FALSE -> 3 \0a          [] OTHER -> 4 [] TRUE -> 5) # 4\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF (CASE FALSE -> 1 [] FALSE -> CASE TRUE -> 2 [] TRUE -> 3 \0a                 [] OTHER -> 4 [] OTHER -> 5) # 5\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF (CASE TRUE -> 1 [] TRUE -> CASE TRUE -> 2 [] TRUE -> 3 \0a            [] OTHER -> 4 [] OTHER -> 5) \\notin {1, 2, 3}\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF  ~ \\/ /\\ 1=3\0a              /\\ "a" = 1\0a           \\/ /\\ 1 = 2\0a              /\\ "b" = 1\0a           \\/ /\\ 1 = 1\0a              /\\ 2 = 2\0a           \\/ "c" = 1\0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a=========================================\0a']]]
      ['suite/test15' 'test15' %accept ~[['test15' '--------------- MODULE test15 -------------\0a(* Test of handling the empty set *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0a\0a\0aInv ==  \0a  /\\ IF SUBSET {} # {{}}\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF UNION {} # {}\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF {y \\in {} : y = y} # {}\0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF [y \\in {} |-> y] # << >>\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF (\\E S \\in {} : TRUE) # FALSE\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF (\\A S \\in {} : FALSE) # TRUE\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF DOMAIN <<>> # {}\0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF 1..0 # {}\0a       THEN Assert(FALSE, "Test 8 Failed")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF <<>> \\notin Seq({})\0a       THEN Assert(FALSE, "Test 9 Failed")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF <<{}>> \\in Seq ({})\0a       THEN Assert(FALSE, "Test 10 Failed")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF \\E S \\in SUBSET {} : S # {}\0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a  /\\ IF [{} -> {1, 2, 3}] # {<<>>}\0a       THEN Assert(FALSE, "Test 12 Failed")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF [{1, 2, 3} -> {}] # {}\0a       THEN Assert(FALSE, "Test 13 Failed")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0a\0a  /\\ IF (UNION {{1,2,3}, {}}) # (UNION {{1,2,3}}) \0a       THEN Assert(FALSE, "Test 14 Failed")\0a       ELSE Print("Test 14 OK", TRUE)\0a\0a  /\\ IF 1..0 # {}\0a       THEN Assert(FALSE, "Test 15 Failed")\0a       ELSE Print("Test 15 OK", TRUE)\0a\0a  /\\ IF 1..0 # 5..2\0a       THEN Assert(FALSE, "Test 16 Failed")\0a       ELSE Print("Test 16 OK", TRUE)\0a\0a=========================================\0a']]]
      ['suite/test16' 'test16' %accept ~[['test16' '--------------- MODULE test16 -------------\0a(* Test of handling of one-tuples *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0aS == {<<y>> : y \\in {1, 2, 3, 4}}\0a\0aInv ==  \0a\0a  /\\ IF <<1>> \\notin S\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF ~(\\E <<y>> \\in S : y = 2) \0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF ~(\\E y \\in S : y[1] = 2) \0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF {<<y>> \\in S : y > 3} # {<<4>>}\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF <<1>> \\o <<2>> # <<1, 2>>\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF [<<y>> \\in S |-> y+1][<<2>>] # 3\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a\0a=========================================\0a']]]
      ['suite/test17' 'test17' %accept ~[['test17' '--------------- MODULE test17 -------------\0a\0a(* Test of handling of handling expressions with primes. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x, y\0a\0aInit == /\\ Print("There should be two distinct states", TRUE)\0a        /\\ x = 1\0a        /\\ y = 1\0a\0af[i \\in Nat ] == x\'+ x + 2*i\0ag == [i \\in {x\'} |-> x+i]\0a\0a\0aFoo(a) == a\' = x+1\0a\0aInv == TRUE\0a\0aTNext == \0a  /\\ x\' = x+1\0a  /\\ x\' = 2\0a  /\\ \\/ UNCHANGED y\0a\0a     \\/ /\\ Print("Starting Test 1", TRUE)\0a        /\\ y\' = IF x\' = 2 \0a                  THEN 1 \0a                   ELSE Assert(FALSE, "Failed Test 1")\0a\0a     \\/ /\\ Print("Starting Test 2", TRUE)\0a        /\\ IF x\' = 2 \0a             THEN y\' = 1 \0a             ELSE Assert(FALSE, "Failed Test 2")\0a\0a     \\/ /\\ Print("Starting Test 3", TRUE)\0a        /\\ x\' # 2\0a        /\\ Assert(FALSE, "Failed Test 3")\0a\0a     \\/ /\\ Print("Starting Test 4", TRUE)\0a        /\\ ~(\\E i \\in {x\'} : i = 2)\0a        /\\ Assert(FALSE, "Failed Test 4")\0a\0a     \\/ /\\ Print("Starting Test 5", TRUE)\0a        /\\ ~ (\\A i \\in {x\'} : i = 2)\0a        /\\ Assert(FALSE, "Failed Test 5")\0a\0a     \\/ /\\ Print("Starting Test 6", TRUE)\0a        /\\ (CHOOSE i \\in {x\'} : TRUE) # 2\0a        /\\ Assert(FALSE, "Failed Test 6")\0a\0a     \\/ /\\ Print("Starting Test 7", TRUE)\0a        /\\ 2 \\notin {x\'}\0a        /\\ Assert(FALSE, "Failed Test 7")\0a\0a     \\/ /\\ Print("Starting Test 8", TRUE)\0a        /\\ {i \\in {x\'} : TRUE} # {2}\0a        /\\ Assert(FALSE, "Failed Test 8")\0a\0a     \\/ /\\ Print("Starting Test 9", TRUE)\0a        /\\ {i\' : i \\in {x\'}} # {2}\0a        /\\ Assert(FALSE, "Failed Test 9")\0a\0a     \\/ /\\ Print("Starting Test 10", TRUE)\0a        /\\ {2} \\notin SUBSET {x\'}\0a        /\\ Assert(FALSE, "Failed Test 10")\0a\0a     \\/ /\\ Print("Starting Test 11", TRUE)\0a        /\\ {2} # UNION {{x\'}, {}}\0a        /\\ Assert(FALSE, "Failed Test 11")\0a\0a     \\/ /\\ Print("Starting Test 12", TRUE)\0a        /\\ f[1] # 5\0a        /\\ Assert(FALSE, "Failed Test 12")\0a\0a     \\/ /\\ Print("Starting Test 13", TRUE)\0a        /\\ f[x\'] # 7\0a        /\\ Assert(FALSE, "Failed Test 13")\0a\0a     \\/ /\\ Print("Starting Test 14", TRUE)\0a        /\\ [f EXCEPT ![x\'] = x\'+x+3][2] # 6\0a        /\\ Assert(FALSE, "Failed Test 14")\0a\0a     \\/ /\\ Print("Starting Test 15", TRUE)\0a        /\\ [f EXCEPT ![2] = x\'+x+3][x\'] # 6\0a        /\\ Assert(FALSE, "Failed Test 15")\0a\0a     \\/ /\\ Print("Starting Test 16", TRUE)\0a        /\\ [{x\'-1} -> {x\'}] # {<<2>>}\0a        /\\ Assert(FALSE, "Failed Test 16")\0a\0a     \\/ /\\ Print("Starting Test 17", TRUE)\0a        /\\ [{x\',x} -> {x\'}] # {<<2, 2>>}\0a        /\\ Assert(FALSE, "Failed Test 17")\0a\0a     \\/ /\\ Print("Starting Test 18", TRUE)\0a        /\\ [{x\',x} -> {x}] # {<<1, 1>>}\0a        /\\ Assert(FALSE, "Failed Test 18")\0a\0a     \\/ /\\ Print("Starting Test 19", TRUE)\0a        /\\ x\'=2 => x\'=3\0a        /\\ Assert(FALSE, "Failed Test 19")\0a\0a     \\/ /\\ Print("Starting Test 20", TRUE)\0a        /\\ CASE x\'= x+1 -> FALSE\0a             [] x\'# x+1 -> TRUE\0a        /\\ Assert(FALSE, "Failed Test 20")\0a\0a     \\/ /\\ Print("Starting Test 21", TRUE)\0a        /\\ DOMAIN g # {2}\0a        /\\ Assert(FALSE, "Failed Test 21")\0a\0a     \\/ /\\ Print("Starting Test 22", TRUE)\0a        /\\ g[2] # 3\0a        /\\ Assert(FALSE, "Failed Test 22")\0a\0a     \\/ /\\ Print("Starting Test 23", TRUE)\0a        /\\ CASE x\' # 2 -> Assert(FALSE, "Failed Test 23")\0a             [] x\' = 2 -> y\' = 1\0a\0a     \\/ /\\ Print("Starting Test 24", TRUE)\0a        /\\ ~Foo(x)\0a        /\\ Assert(FALSE, "Failed Test 24")\0a\0a     \\/ /\\ Print("Starting Test 25", TRUE)\0a        /\\ ~Foo(x)\0a        /\\ Assert(FALSE, "Failed Test 25")\0a\0a\0aNext == TNext \\/ UNCHANGED <<x, y>>\0a=========================================\0a']]]
      ['suite/test18' 'test18' %accept ~[['test18' '--------------- MODULE test18 -------------\0a\0a(* Test of fingerprinting. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x, y, z, w, u\0a\0af == [i \\in {1,2}, j \\in {3,4} |-> i+j]\0ag == [p \\in {1,2} \\X {3,4} |-> p[1] + p[2]]\0am == [i \\in {3,4} |-> <<i, 7>>]\0a\0aInit == /\\ Print("There should be only one distinct state", TRUE)\0a        /\\ x = [a |-> 1, b |-> 2]\0a        /\\ y = <<3, 4>>\0a        /\\ z = {1, 2, 3}\0a        /\\ w = f\0a        /\\ u = [m EXCEPT ![4] = <<4, 8>>]\0a        /\\ IF y # [i \\in {1, 2} |-> IF i = 1 THEN 3 ELSE 4]\0a             THEN Print("Error in comparing seq and fcn", TRUE)\0a             ELSE TRUE\0a        \0a\0aInv == /\\ TRUE\0a\0aNext == \0a  \\/ UNCHANGED <<x, y, z, w, u>>\0a\0a  \\/ /\\ x\' = [i \\in {"a", "b"} |-> IF i = "a" THEN 1 ELSE 2]\0a     /\\ UNCHANGED <<y, z, w, u>>\0a\0a  \\/ /\\ y\' = [i \\in {1, 2} |-> IF i = 1 THEN 3 ELSE 4]\0a     /\\ UNCHANGED <<x, z, w, u>>\0a\0a  \\/ /\\ y\' = <<3>> \\o <<4>>\0a     /\\ UNCHANGED <<x, z, w, u>>  \0a\0a  \\/ /\\ y\' = [y EXCEPT ![2]=4]\0a     /\\ UNCHANGED <<x, z, w, u>>\0a\0a  \\/ /\\ y\' = [<<3, 7>> EXCEPT ![2]=4]\0a     /\\ UNCHANGED <<x, z, w, u>>\0a\0a  \\/ /\\ y\' = <<3>> \\o <<4>>\0a     /\\ UNCHANGED <<x, z, w, u>>\0a\0a  \\/ /\\ z\' = {3, 3, 2, 2, 1}\0a     /\\ UNCHANGED <<x, y, w, u>>\0a\0a  \\/ /\\ z\' = 1..3\0a     /\\ UNCHANGED <<x, y, w, u>>\0a\0a  \\/ /\\ z\' = {i - 3 : i \\in {4, 5, 6, 4, 5}}\0a     /\\ UNCHANGED <<x, y, w, u>>\0a\0a  \\/ /\\ z\' = DOMAIN <<"a", "b", 4>>\0a     /\\ UNCHANGED <<x, y, w, u>>\0a\0a  \\/ /\\ w\' = g\0a     /\\ UNCHANGED <<x, y, z, u>>\0a\0a  \\/ /\\ u\' = [m EXCEPT ![4][2] = @+1]\0a     /\\ UNCHANGED <<x, y, z, w>>         \0a=========================================\0a']]]
      ['suite/test19' 'test19' %accept ~[['test19' '--------------- MODULE test19 -------------\0a\0a(* Test of large initial state space *)\0a\0aEXTENDS Naturals, Sequences\0a\0aVARIABLE x, y, z \0aInit == /\\ x \\in 1..100\0a        /\\ y \\in 1..200\0a        /\\ z \\in 1..20\0a\0aNext == UNCHANGED <<x, y, z>>\0a\0aInv == TRUE\0a=========================================\0a']]]
      ['suite/test2' 'test2' %accept ~[['test2' '--------------- MODULE test2 -------------\0a\0a(* test equality of various representations of functions. *)\0a\0aEXTENDS Naturals, TLC\0a\0aVARIABLE x\0aCONSTANT a, b, c\0af == [i \\in {1,2}, j \\in {3,4} |-> i+j]\0ag == [p \\in {1,2} \\X {3,4} |-> p[1] + p[2]]\0ah == [i \\in {1,2} |-> [j \\in {3,4} |-> i+j]]\0a\0am == [i \\in {3,4} |-> <<i, 7>>]\0a\0a\0aType == x \\in {1}\0aInv  == \0a /\\ TRUE\0a\0a /\\ IF [i \\in {3, 2, 1} |-> i+2] # <<3, 4, 5>>\0a      THEN Assert(FALSE, "Failed Test 1") \0a      ELSE Print("Test 1 OK", TRUE)\0a\0a /\\ IF [i \\in {"a", "b", "c"} |-> \0a         CASE i = "a" -> 1 [] i = "b" -> 2 [] i = "c" -> 3]\0a         # [c |-> 3, a |-> 1, b |-> 2]\0a      THEN Assert(FALSE, "Failed Test 2")\0a      ELSE Print("Test 2 OK", TRUE)\0a\0a /\\ IF [c |-> 3, a |-> 1, b |-> 2] # \0a        [[a |-> 1, b |-> 3, c |-> 4] EXCEPT !.b =2 , !.c=3]\0a      THEN Assert(FALSE, "Failed Test 3") \0a      ELSE Print("Test 3 OK", TRUE)\0a\0a /\\ IF <<3, 4, 5>> # [<<3, 42, 75>> EXCEPT ![3]=5, ![2]=4]\0a      THEN Assert(FALSE, "Failed Test 4") \0a      ELSE Print("Test 4 OK", TRUE)\0a\0a /\\ IF [i \\in {3, 2, 1} |-> i+2] # [ j \\in 1..3 |-> j+2]\0a      THEN Assert(FALSE, "Failed Test 5") \0a      ELSE Print("Test 5 OK", TRUE)\0a\0a /\\ IF [i \\in {} |-> i] # <<>>\0a      THEN Assert(FALSE, "Failed Test 6") \0a      ELSE Print("Test 6 OK", TRUE)\0a\0a /\\ IF {i \\in [{1,2} -> {a, b, c}] : i[1] = a} # {<<a, a>>, <<a, b>>, <<a, c>>}\0a      THEN Assert(FALSE, "Failed Test 7") \0a      ELSE Print("Test 7 OK", TRUE)\0a\0a /\\ IF [{"a", "bc"} -> {1, 2, 3}] # [bc : {1,2,3}, a : {1,2,3}]\0a      THEN Assert(FALSE, "Failed Test 8") \0a      ELSE Print("Test 8 OK", TRUE)\0a\0a /\\ IF f # g\0a      THEN Assert(FALSE, "Test 9 Failed")\0a      ELSE Print("Test 9 OK", TRUE)\0a\0a /\\ IF f = h\0a      THEN Assert(FALSE, "Test 10 Failed")\0a      ELSE Print("Test 10 OK", TRUE)\0a\0a /\\ IF [m EXCEPT ![4] = <<4, 8>>] # [m EXCEPT ![4][2] = @+1]\0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a /\\ IF m#[m EXCEPT ![4][2] = 7]\0a       THEN Assert(FALSE, "Test 12 Failed")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a /\\ IF f # [f EXCEPT ![1,3] = 4]\0a       THEN Assert(FALSE, "Test 13 Failed")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0aInit == x = 1\0a\0aNext == UNCHANGED x\0a=========================================\0a']]]
      ['suite/test20' 'test20' %accept ~[['test20' '--------------- MODULE test20 -------------\0a\0a(* Test of ENABLED *)\0a\0aEXTENDS Naturals, Sequences, TLC\0a\0aVARIABLE x, y\0a\0aInit == x = 1 /\\ y = 1\0a\0aStep(p) == x\' = p\0a\0aFoo(A) == ENABLED((x\' = x) /\\ (A\'=x+1))\0a\0aNext == \0a  \\/ /\\ x\'=x\0a     /\\ y\'=y\0a\0a  \\/ /\\ Print("Test N1 begun", TRUE)\0a     /\\ ~ENABLED (x\'=2)\0a     /\\ Assert(FALSE, "Test N1 Failed")\0a\0a  \\/ IF ENABLED (x\'=2)\0a       THEN /\\ Print("Test N2 Passed", TRUE)\0a            /\\ UNCHANGED <<x, y>>\0a       ELSE Assert(FALSE, "Test N2 Failed")\0a  \\/ IF ENABLED Step(17)\0a       THEN /\\ Print("Test N3 Passed", TRUE)\0a            /\\  UNCHANGED <<x, y>>\0a       ELSE Assert(FALSE, "Test N3 Failed")\0a\0a  \\/ IF \\A p \\in 1..3 : ENABLED Step(p)\0a       THEN /\\ Print("Test N4 Passed", TRUE)\0a            /\\  UNCHANGED <<x, y>>\0a       ELSE Assert(FALSE, "Test N4 Failed")\0a\0aInv == \0a  /\\ IF ENABLED <<x\'=1 /\\ y\'=y>>_<<x,y>>\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF ~ ENABLED (x\'="a" /\\ y\'=y)\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF ENABLED (x > 2)\0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF ~ENABLED (x=1)\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF ENABLED ((x > 2) /\\ Next)\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF ~ENABLED ((x=1) /\\ Next)\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF ~ ENABLED (x\'=1) \0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF Foo(x)\0a       THEN Assert(FALSE, "Test 8 Failed")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ LET A == x\0a     IN  IF Foo(A) \0a           THEN Assert(FALSE, "Test 9 Failed")\0a           ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF ~Foo(y) \0a       THEN Assert(FALSE, "Test 10 Failed")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ LET A == x\0a     IN  IF ~Foo(y) \0a           THEN Assert(FALSE, "Test 11 Failed")\0a           ELSE Print("Test 11 OK", TRUE)\0a\0a\0a=========================================\0a']]]
      ['suite/test201' 'test201' %accept ~[['test201' '-------------------- MODULE test201 ----------------\0a\\* Test of lambda expressions\0a\0aEXTENDS Naturals, TLC\0aOp(A(_)) == A(4)\0a\0abar == Op(LAMBDA x : x^2)\0a\0aASSUME /\\ Op(LAMBDA x : {x,2} ) = {4,2}\0a       /\\ PrintT("Test1 OK")\0a\0aASSUME /\\ bar = 16 \0a       /\\ PrintT("Test2 OK")\0a\0afoo == INSTANCE test201a WITH A <- LAMBDA y : y^3, b <- 4\0a\0aASSUME /\\ foo!def = 64\0a       /\\ PrintT("Test201 OK")\0a=================================================\0a\0a'] ['test201a' '-------------------- MODULE test201a ----------------\0a\0aCONSTANT A(_), b\0a\0adef == A(b)\0a\0a=============================================================================']]]
      ['suite/test201a' 'test201a' %accept ~[['test201a' '-------------------- MODULE test201a ----------------\0a\0aCONSTANT A(_), b\0a\0adef == A(b)\0a\0a=============================================================================']]]
      ['suite/test202' 'test202' %accept ~[['test202' '-------------------- MODULE test202 ----------------\0a\\* Test of recursion\0a\0aEXTENDS Naturals, TLC\0a\0aRECURSIVE g(_)\0af(a) == IF a = 0 THEN 1 ELSE a * g(a-1)\0ag(a) == f(a) \0a\0a\0aASSUME /\\ f(0) = 1\0a       /\\ f(4) = 24\0a       /\\ \\A i \\in 1..5 : f(i) = i * f(i-1)\0a       /\\ PrintT("Test 1 OK")\0a\0aASSUME /\\ g(0) = 1\0a       /\\ g(4) = 24\0a       /\\ \\A i \\in 1..5 : g(i) = i * g(i-1)\0a       /\\ PrintT("Test 2 OK")\0a\0aRECURSIVE fact\0afact1[n \\in Nat] == fact[n]\0afact[n \\in Nat] == IF n = 0 THEN 1 ELSE n * fact1[n-1]\0a\0aASSUME /\\ fact1[3] = 6\0a       /\\ fact[4] = 24\0a       /\\ \\A i \\in 0..5 : fact[i] = g(i)     \0a       /\\ PrintT("Test 3 OK")\0a\0a\0a=================================================\0a\0a']]]
