      ['suite/test204' 'test204' %accept ~[['test204' '--------------- MODULE test204 -------------\0a\0a(***************************************************************************)\0a(* Test definability and use of all user-defined operators as prefix       *)\0a(* operators, as in +(a, b).  It does not work with binary minus.          *)\0a(***************************************************************************)\0a\0az - y == <<1, z, y>>\0a\\* ASSUME -(4, 6) = <<1, 4, 6>>\0az + y == <<2, z, y>>\0aASSUME +(4, 6) = <<2, 4, 6>>\0az * y == <<3, z, y>>\0aASSUME *(4, 6) = <<3, 4, 6>>\0az / y == <<4, z, y>>\0aASSUME /(4, 6) = <<4, 4, 6>>\0az ^ y == <<5, z, y>>\0aASSUME ^(4, 6) = <<5, 4, 6>>\0az < y == <<6, z, y>>\0aASSUME <(4, 6) = <<6, 4, 6>>\0az > y == <<7, z, y>>\0aASSUME >(4, 6) = <<7, 4, 6>>\0az .. y == <<8, z, y>>\0aASSUME ..(4, 6) = <<8, 4, 6>>\0az ... y == <<9, z, y>>\0aASSUME ...(4, 6) = <<9, 4, 6>>\0az | y == <<10, z, y>>\0aASSUME |(4, 6) = <<10, 4, 6>>\0az || y == <<11, z, y>>\0aASSUME ||(4, 6) = <<11, 4, 6>>\0az & y == <<12, z, y>>\0aASSUME &(4, 6) = <<12, 4, 6>>\0az && y == <<13, z, y>>\0aASSUME &&(4, 6) = <<13, 4, 6>>\0az $ y == <<14, z, y>>\0aASSUME $(4, 6) = <<14, 4, 6>>\0az $$ y == <<15, z, y>>\0aASSUME $$(4, 6) = <<15, 4, 6>>\0az ?? y == <<16, z, y>>\0aASSUME ??(4, 6) = <<16, 4, 6>>\0az %% y == <<17, z, y>>\0aASSUME %%(4, 6) = <<17, 4, 6>>\0az ## y == <<18, z, y>>\0aASSUME ##(4, 6) = <<18, 4, 6>>\0az ++ y == <<19, z, y>>\0aASSUME ++(4, 6) = <<19, 4, 6>>\0az -- y == <<20, z, y>>\0aASSUME --(4, 6) = <<20, 4, 6>>\0az ** y == <<21, z, y>>\0aASSUME **(4, 6) = <<21, 4, 6>>\0az // y == <<22, z, y>>\0aASSUME //(4, 6) = <<22, 4, 6>>\0az ^^ y == <<23, z, y>>\0aASSUME ^^(4, 6) = <<23, 4, 6>>\0az @@ y == <<23, z, y>> \0aASSUME @@(4, 6) = <<23, 4, 6>>\0az !! y == <<24, z, y>>\0aASSUME !!(4, 6) = <<24, 4, 6>>\0az |- y == <<25, z, y>>\0aASSUME |-(4, 6) = <<25, 4, 6>>\0az |= y == <<26, z, y>>\0aASSUME |=(4, 6) = <<26, 4, 6>>\0az -| y == <<27, z, y>>\0aASSUME -|(4, 6) = <<27, 4, 6>>\0az =| y == <<28, z, y>>\0aASSUME =|(4, 6) = <<28, 4, 6>>\0az <: y == <<29, z, y>>\0aASSUME <:(4, 6) = <<29, 4, 6>>\0az :> y == <<29, z, y>>\0aASSUME :>(4, 6) = <<29, 4, 6>>\0az := y == <<30, z, y>>\0aASSUME :=(4, 6) = <<30, 4, 6>>\0az ::= y == <<31, z, y>>\0aASSUME ::=(4, 6) = <<31, 4, 6>>\0az \\uplus y == <<32, z, y>>\0aASSUME \\uplus(4, 6) = <<32, 4, 6>>\0az \\sqcap y == <<33, z, y>>\0aASSUME \\sqcap(4, 6) = <<33, 4, 6>>\0az \\sqcup y == <<34, z, y>>\0aASSUME \\sqcup(4, 6) = <<34, 4, 6>>\0az \\div y == <<35, z, y>>\0aASSUME \\div(4, 6) = <<35, 4, 6>>\0az \\wr y == <<36, z, y>>\0aASSUME \\wr(4, 6) = <<36, 4, 6>>\0az \\star y == <<37, z, y>>\0aASSUME \\star(4, 6) = <<37, 4, 6>>\0az \\bigcirc y == <<38, z, y>>\0aASSUME \\bigcirc(4, 6) = <<38, 4, 6>>\0az \\bullet y == <<39, z, y>>\0aASSUME \\bullet(4, 6) = <<39, 4, 6>>\0az \\prec y == <<40, z, y>>\0aASSUME \\prec(4, 6) = <<40, 4, 6>>\0az \\succ y == <<41, z, y>>\0aASSUME \\succ(4, 6) = <<41, 4, 6>>\0az \\preceq y == <<42, z, y>>\0aASSUME \\preceq(4, 6) = <<42, 4, 6>>\0az \\succeq y == <<43, z, y>>\0aASSUME \\succeq(4, 6) = <<43, 4, 6>>\0az \\sim y == <<44, z, y>>\0aASSUME \\sim(4, 6) = <<44, 4, 6>>\0az \\simeq y == <<45, z, y>>\0aASSUME \\simeq(4, 6) = <<45, 4, 6>>\0az \\ll y == <<46, z, y>>\0aASSUME \\ll(4, 6) = <<46, 4, 6>>\0az \\gg y == <<47, z, y>>\0aASSUME \\gg(4, 6) = <<47, 4, 6>>\0az \\asymp y == <<48, z, y>>\0aASSUME \\asymp(4, 6) = <<48, 4, 6>>\0az \\subset y == <<49, z, y>>\0aASSUME \\subset(4, 6) = <<49, 4, 6>>\0az \\supset y == <<50, z, y>>\0aASSUME \\supset(4, 6) = <<50, 4, 6>>\0az \\supseteq y == <<51, z, y>>\0aASSUME \\supseteq(4, 6) = <<51, 4, 6>>\0az \\approx y == <<52, z, y>>\0aASSUME \\approx(4, 6) = <<52, 4, 6>>\0az \\cong y == <<53, z, y>>\0aASSUME \\cong(4, 6) = <<53, 4, 6>>\0az \\sqsubset y == <<54, z, y>>\0aASSUME \\sqsubset(4, 6) = <<54, 4, 6>>\0az \\sqsupset y == <<55, z, y>>\0aASSUME \\sqsupset(4, 6) = <<55, 4, 6>>\0az \\sqsubseteq y == <<56, z, y>>\0aASSUME \\sqsubseteq(4, 6) = <<56, 4, 6>>\0az \\sqsupseteq y == <<57, z, y>>\0aASSUME \\sqsupseteq(4, 6) = <<57, 4, 6>>\0az \\doteq y == <<58, z, y>>\0aASSUME \\doteq(4, 6) = <<58, 4, 6>>\0az \\propto y == <<59, z, y>>\0aASSUME \\propto(4, 6) = <<59, 4, 6>>\0a\0az ^+ == <<60, z>>\0aASSUME ^+(4) = <<60, 4>>\0az ^* == <<61, z>>\0aASSUME ^*(4) = <<61, 4>>\0az ^# == <<62, z>>\0aASSUME ^#(4) = <<62, 4>>\0a-. z == <<63, z>>\0aASSUME -.(4) = <<63, 4>>\0a\0az \\leq y == <<64, z, y>>\0aASSUME \\leq(4, 6) = <<64, 4, 6>>\0aASSUME <=(4, 6) = <<64, 4, 6>>\0aASSUME =<(4, 6) = <<64, 4, 6>>\0a\0az \\geq y == <<65, z, y>>\0aASSUME \\geq(4, 6) = <<65, 4, 6>>\0aASSUME >=(4, 6) = <<65, 4, 6>>\0a\0az \\oplus y == <<66, z, y>>\0aASSUME \\oplus(4, 6) = <<66, 4, 6>>\0aASSUME (+) (4, 6) = <<66, 4, 6>>\0a\0az \\ominus y == <<67, z, y>>\0aASSUME \\ominus(4, 6) = <<67, 4, 6>>\0aASSUME (-) (4, 6) = <<67, 4, 6>>\0a\0a\0az \\odot y == <<68, z, y>>\0aASSUME \\odot(4, 6) = <<68, 4, 6>>\0aASSUME (.) (4, 6) = <<68, 4, 6>>\0a\0az \\otimes y == <<69, z, y>>\0aASSUME \\otimes(4, 6) = <<69, 4, 6>>\0aASSUME (\\X) (4, 6) = <<69, 4, 6>>\0a\0az \\oslash y == <<70, z, y>>\0aASSUME \\oslash(4, 6) = <<70, 4, 6>>\0aASSUME (/) (4, 6) = <<70, 4, 6>>\0a\0az \\circ y == <<71, z, y>>\0aASSUME \\circ(4, 6) = <<71, 4, 6>>\0aASSUME \\o (4, 6) = <<71, 4, 6>>\0a\0aASSUME \\in(1, {1})\0a\0aASSUME \\cup({1}, {2}) = {1,2}\0a\0a=============================================================================\0a']]]
      ['suite/test205' 'test205' %accept ~[['test205' '--------------- MODULE test205 -------------\0a\0a(***************************************************************************)\0a(* Test use of notation R!+(a, b) for instantiated *-fix operators.        *)\0a(***************************************************************************)\0a\0aF == INSTANCE test204\0a\0a\\*z - y == <<1, z, y>>\0aASSUME F!-(4, 6) = <<1, 4, 6>>\0a\\*z + y == <<2, z, y>>\0aASSUME F!+(4, 6) = <<2, 4, 6>>\0a\\*z * y == <<3, z, y>>\0aASSUME F!*(4, 6) = <<3, 4, 6>>\0a\\*z / y == <<4, z, y>>\0aASSUME F!/(4, 6) = <<4, 4, 6>>\0a\\*z ^ y == <<5, z, y>>\0aASSUME F!^(4, 6) = <<5, 4, 6>>\0a\\*z < y == <<6, z, y>>\0aASSUME F!<(4, 6) = <<6, 4, 6>>\0a\\*z > y == <<7, z, y>>\0aASSUME F!>(4, 6) = <<7, 4, 6>>\0a\\*z .. y == <<8, z, y>>\0aASSUME F!..(4, 6) = <<8, 4, 6>>\0a\\*z ... y == <<9, z, y>>\0aASSUME F!...(4, 6) = <<9, 4, 6>>\0a\\*z | y == <<10, z, y>>\0aASSUME F!|(4, 6) = <<10, 4, 6>>\0a\\*z || y == <<11, z, y>>\0aASSUME F!||(4, 6) = <<11, 4, 6>>\0a\\*z & y == <<12, z, y>>\0aASSUME F!&(4, 6) = <<12, 4, 6>>\0a\\*z && y == <<13, z, y>>\0aASSUME F!&&(4, 6) = <<13, 4, 6>>\0a\\*z $ y == <<14, z, y>>\0aASSUME F!$(4, 6) = <<14, 4, 6>>\0a\\*z $$ y == <<15, z, y>>\0aASSUME F!$$(4, 6) = <<15, 4, 6>>\0a\\*z ?? y == <<16, z, y>>\0aASSUME F!??(4, 6) = <<16, 4, 6>>\0a\\*z %% y == <<17, z, y>>\0aASSUME F!%%(4, 6) = <<17, 4, 6>>\0a\\*z ## y == <<18, z, y>>\0aASSUME F!##(4, 6) = <<18, 4, 6>>\0a\\*z ++ y == <<19, z, y>>\0aASSUME F!++(4, 6) = <<19, 4, 6>>\0a\\*z -- y == <<20, z, y>>\0aASSUME F!--(4, 6) = <<20, 4, 6>>\0a\\*z ** y == <<21, z, y>>\0aASSUME F!**(4, 6) = <<21, 4, 6>>\0a\\*z // y == <<22, z, y>>\0aASSUME F!//(4, 6) = <<22, 4, 6>>\0a\\*z ^^ y == <<23, z, y>>\0aASSUME F!^^(4, 6) = <<23, 4, 6>>\0a\\*z @@ y == <<23, z, y>> \0aASSUME F!@@(4, 6) = <<23, 4, 6>>\0a\\*z !! y == <<24, z, y>>\0aASSUME F ! !!(4, 6) = <<24, 4, 6>>\0a\\*z |- y == <<25, z, y>>\0aASSUME F!|-(4, 6) = <<25, 4, 6>>\0a\\*z |= y == <<26, z, y>>\0aASSUME F!|=(4, 6) = <<26, 4, 6>>\0a\\*z -| y == <<27, z, y>>\0aASSUME F!-|(4, 6) = <<27, 4, 6>>\0a\\*z =| y == <<28, z, y>>\0aASSUME F!=|(4, 6) = <<28, 4, 6>>\0a\\*z <: y == <<29, z, y>>\0aASSUME F!<:(4, 6) = <<29, 4, 6>>\0a\\*z :> y == <<29, z, y>>\0aASSUME F!:>(4, 6) = <<29, 4, 6>>\0a\\*z := y == <<30, z, y>>\0aASSUME F!:=(4, 6) = <<30, 4, 6>>\0a\\*z ::= y == <<31, z, y>>\0aASSUME F!::=(4, 6) = <<31, 4, 6>>\0a\\*z \\uplus y == <<32, z, y>>\0aASSUME F!\\uplus(4, 6) = <<32, 4, 6>>\0a\\*z \\sqcap y == <<33, z, y>>\0aASSUME F!\\sqcap(4, 6) = <<33, 4, 6>>\0a\\*z \\sqcup y == <<34, z, y>>\0aASSUME F!\\sqcup(4, 6) = <<34, 4, 6>>\0a\\*z \\div y == <<35, z, y>>\0aASSUME F!\\div(4, 6) = <<35, 4, 6>>\0a\\*z \\wr y == <<36, z, y>>\0aASSUME F!\\wr(4, 6) = <<36, 4, 6>>\0a\\*z \\star y == <<37, z, y>>\0aASSUME F!\\star(4, 6) = <<37, 4, 6>>\0a\\*z \\bigcirc y == <<38, z, y>>\0aASSUME F!\\bigcirc(4, 6) = <<38, 4, 6>>\0a\\*z \\bullet y == <<39, z, y>>\0aASSUME F!\\bullet(4, 6) = <<39, 4, 6>>\0a\\*z \\prec y == <<40, z, y>>\0aASSUME F!\\prec(4, 6) = <<40, 4, 6>>\0a\\*z \\succ y == <<41, z, y>>\0aASSUME F!\\succ(4, 6) = <<41, 4, 6>>\0a\\*z \\preceq y == <<42, z, y>>\0aASSUME F!\\preceq(4, 6) = <<42, 4, 6>>\0a\\*z \\succeq y == <<43, z, y>>\0aASSUME F!\\succeq(4, 6) = <<43, 4, 6>>\0a\\*z \\sim y == <<44, z, y>>\0aASSUME F!\\sim(4, 6) = <<44, 4, 6>>\0a\\*z \\simeq y == <<45, z, y>>\0aASSUME F!\\simeq(4, 6) = <<45, 4, 6>>\0a\\*z \\ll y == <<46, z, y>>\0aASSUME F!\\ll(4, 6) = <<46, 4, 6>>\0a\\*z \\gg y == <<47, z, y>>\0aASSUME F!\\gg(4, 6) = <<47, 4, 6>>\0a\\*z \\asymp y == <<48, z, y>>\0aASSUME F!\\asymp(4, 6) = <<48, 4, 6>>\0a\\*z \\subset y == <<49, z, y>>\0aASSUME F!\\subset(4, 6) = <<49, 4, 6>>\0a\\*z \\supset y == <<50, z, y>>\0aASSUME F!\\supset(4, 6) = <<50, 4, 6>>\0a\\*z \\supseteq y == <<51, z, y>>\0aASSUME F!\\supseteq(4, 6) = <<51, 4, 6>>\0a\\*z \\approx y == <<52, z, y>>\0aASSUME F!\\approx(4, 6) = <<52, 4, 6>>\0a\\*z \\cong y == <<53, z, y>>\0aASSUME F!\\cong(4, 6) = <<53, 4, 6>>\0a\\*z \\sqsubset y == <<54, z, y>>\0aASSUME F!\\sqsubset(4, 6) = <<54, 4, 6>>\0a\\*z \\sqsupset y == <<55, z, y>>\0aASSUME F!\\sqsupset(4, 6) = <<55, 4, 6>>\0a\\*z \\sqsubseteq y == <<56, z, y>>\0aASSUME F!\\sqsubseteq(4, 6) = <<56, 4, 6>>\0a\\*z \\sqsupseteq y == <<57, z, y>>\0aASSUME F!\\sqsupseteq(4, 6) = <<57, 4, 6>>\0a\\*z \\doteq y == <<58, z, y>>\0aASSUME F!\\doteq(4, 6) = <<58, 4, 6>>\0a\\*z \\propto y == <<59, z, y>>\0aASSUME F!\\propto(4, 6) = <<59, 4, 6>>\0a\0a\\*z ^+ == <<60, z>>\0aASSUME F!^+(4) = <<60, 4>>\0a\\*z ^* == <<61, z>>\0aASSUME F!^*(4) = <<61, 4>>\0a\\*z ^# == <<62, z>>\0aASSUME F!^#(4) = <<62, 4>>\0a\\*-. z == <<63, z>>\0aASSUME F!-.(4) = <<63, 4>>\0a\0a\\*z \\leq y == <<64, z, y>>\0aASSUME F!\\leq(4, 6) = <<64, 4, 6>>\0aASSUME F!<=(4, 6) = <<64, 4, 6>>\0aASSUME F!=<(4, 6) = <<64, 4, 6>>\0a\0a\\*z \\geq y == <<65, z, y>>\0aASSUME F!\\geq(4, 6) = <<65, 4, 6>>\0aASSUME F!>=(4, 6) = <<65, 4, 6>>\0a\0a\\*z \\oplus y == <<66, z, y>>\0aASSUME F!\\oplus(4, 6) = <<66, 4, 6>>\0aASSUME F!(+) (4, 6) = <<66, 4, 6>>\0a\0a\\*z \\ominus y == <<67, z, y>>\0aASSUME F!\\ominus(4, 6) = <<67, 4, 6>>\0aASSUME F!(-) (4, 6) = <<67, 4, 6>>\0a\0a\0a\\*z \\odot y == <<68, z, y>>\0aASSUME F!\\odot(4, 6) = <<68, 4, 6>>\0aASSUME F!(.) (4, 6) = <<68, 4, 6>>\0a\0a\\*z \\otimes y == <<69, z, y>>\0aASSUME F!\\otimes(4, 6) = <<69, 4, 6>>\0aASSUME F!(\\X) (4, 6) = <<69, 4, 6>>\0a\0a\\*z \\oslash y == <<70, z, y>>\0aASSUME F!\\oslash(4, 6) = <<70, 4, 6>>\0aASSUME F!(/) (4, 6) = <<70, 4, 6>>\0a\0a\\*z \\circ y == <<71, z, y>>\0aASSUME F!\\circ(4, 6) = <<71, 4, 6>>\0aASSUME F!\\o (4, 6) = <<71, 4, 6>>\0a\0a=============================================================================\0a'] ['test204' '--------------- MODULE test204 -------------\0a\0a(***************************************************************************)\0a(* Test definability and use of all user-defined operators as prefix       *)\0a(* operators, as in +(a, b).  It does not work with binary minus.          *)\0a(***************************************************************************)\0a\0az - y == <<1, z, y>>\0a\\* ASSUME -(4, 6) = <<1, 4, 6>>\0az + y == <<2, z, y>>\0aASSUME +(4, 6) = <<2, 4, 6>>\0az * y == <<3, z, y>>\0aASSUME *(4, 6) = <<3, 4, 6>>\0az / y == <<4, z, y>>\0aASSUME /(4, 6) = <<4, 4, 6>>\0az ^ y == <<5, z, y>>\0aASSUME ^(4, 6) = <<5, 4, 6>>\0az < y == <<6, z, y>>\0aASSUME <(4, 6) = <<6, 4, 6>>\0az > y == <<7, z, y>>\0aASSUME >(4, 6) = <<7, 4, 6>>\0az .. y == <<8, z, y>>\0aASSUME ..(4, 6) = <<8, 4, 6>>\0az ... y == <<9, z, y>>\0aASSUME ...(4, 6) = <<9, 4, 6>>\0az | y == <<10, z, y>>\0aASSUME |(4, 6) = <<10, 4, 6>>\0az || y == <<11, z, y>>\0aASSUME ||(4, 6) = <<11, 4, 6>>\0az & y == <<12, z, y>>\0aASSUME &(4, 6) = <<12, 4, 6>>\0az && y == <<13, z, y>>\0aASSUME &&(4, 6) = <<13, 4, 6>>\0az $ y == <<14, z, y>>\0aASSUME $(4, 6) = <<14, 4, 6>>\0az $$ y == <<15, z, y>>\0aASSUME $$(4, 6) = <<15, 4, 6>>\0az ?? y == <<16, z, y>>\0aASSUME ??(4, 6) = <<16, 4, 6>>\0az %% y == <<17, z, y>>\0aASSUME %%(4, 6) = <<17, 4, 6>>\0az ## y == <<18, z, y>>\0aASSUME ##(4, 6) = <<18, 4, 6>>\0az ++ y == <<19, z, y>>\0aASSUME ++(4, 6) = <<19, 4, 6>>\0az -- y == <<20, z, y>>\0aASSUME --(4, 6) = <<20, 4, 6>>\0az ** y == <<21, z, y>>\0aASSUME **(4, 6) = <<21, 4, 6>>\0az // y == <<22, z, y>>\0aASSUME //(4, 6) = <<22, 4, 6>>\0az ^^ y == <<23, z, y>>\0aASSUME ^^(4, 6) = <<23, 4, 6>>\0az @@ y == <<23, z, y>> \0aASSUME @@(4, 6) = <<23, 4, 6>>\0az !! y == <<24, z, y>>\0aASSUME !!(4, 6) = <<24, 4, 6>>\0az |- y == <<25, z, y>>\0aASSUME |-(4, 6) = <<25, 4, 6>>\0az |= y == <<26, z, y>>\0aASSUME |=(4, 6) = <<26, 4, 6>>\0az -| y == <<27, z, y>>\0aASSUME -|(4, 6) = <<27, 4, 6>>\0az =| y == <<28, z, y>>\0aASSUME =|(4, 6) = <<28, 4, 6>>\0az <: y == <<29, z, y>>\0aASSUME <:(4, 6) = <<29, 4, 6>>\0az :> y == <<29, z, y>>\0aASSUME :>(4, 6) = <<29, 4, 6>>\0az := y == <<30, z, y>>\0aASSUME :=(4, 6) = <<30, 4, 6>>\0az ::= y == <<31, z, y>>\0aASSUME ::=(4, 6) = <<31, 4, 6>>\0az \\uplus y == <<32, z, y>>\0aASSUME \\uplus(4, 6) = <<32, 4, 6>>\0az \\sqcap y == <<33, z, y>>\0aASSUME \\sqcap(4, 6) = <<33, 4, 6>>\0az \\sqcup y == <<34, z, y>>\0aASSUME \\sqcup(4, 6) = <<34, 4, 6>>\0az \\div y == <<35, z, y>>\0aASSUME \\div(4, 6) = <<35, 4, 6>>\0az \\wr y == <<36, z, y>>\0aASSUME \\wr(4, 6) = <<36, 4, 6>>\0az \\star y == <<37, z, y>>\0aASSUME \\star(4, 6) = <<37, 4, 6>>\0az \\bigcirc y == <<38, z, y>>\0aASSUME \\bigcirc(4, 6) = <<38, 4, 6>>\0az \\bullet y == <<39, z, y>>\0aASSUME \\bullet(4, 6) = <<39, 4, 6>>\0az \\prec y == <<40, z, y>>\0aASSUME \\prec(4, 6) = <<40, 4, 6>>\0az \\succ y == <<41, z, y>>\0aASSUME \\succ(4, 6) = <<41, 4, 6>>\0az \\preceq y == <<42, z, y>>\0aASSUME \\preceq(4, 6) = <<42, 4, 6>>\0az \\succeq y == <<43, z, y>>\0aASSUME \\succeq(4, 6) = <<43, 4, 6>>\0az \\sim y == <<44, z, y>>\0aASSUME \\sim(4, 6) = <<44, 4, 6>>\0az \\simeq y == <<45, z, y>>\0aASSUME \\simeq(4, 6) = <<45, 4, 6>>\0az \\ll y == <<46, z, y>>\0aASSUME \\ll(4, 6) = <<46, 4, 6>>\0az \\gg y == <<47, z, y>>\0aASSUME \\gg(4, 6) = <<47, 4, 6>>\0az \\asymp y == <<48, z, y>>\0aASSUME \\asymp(4, 6) = <<48, 4, 6>>\0az \\subset y == <<49, z, y>>\0aASSUME \\subset(4, 6) = <<49, 4, 6>>\0az \\supset y == <<50, z, y>>\0aASSUME \\supset(4, 6) = <<50, 4, 6>>\0az \\supseteq y == <<51, z, y>>\0aASSUME \\supseteq(4, 6) = <<51, 4, 6>>\0az \\approx y == <<52, z, y>>\0aASSUME \\approx(4, 6) = <<52, 4, 6>>\0az \\cong y == <<53, z, y>>\0aASSUME \\cong(4, 6) = <<53, 4, 6>>\0az \\sqsubset y == <<54, z, y>>\0aASSUME \\sqsubset(4, 6) = <<54, 4, 6>>\0az \\sqsupset y == <<55, z, y>>\0aASSUME \\sqsupset(4, 6) = <<55, 4, 6>>\0az \\sqsubseteq y == <<56, z, y>>\0aASSUME \\sqsubseteq(4, 6) = <<56, 4, 6>>\0az \\sqsupseteq y == <<57, z, y>>\0aASSUME \\sqsupseteq(4, 6) = <<57, 4, 6>>\0az \\doteq y == <<58, z, y>>\0aASSUME \\doteq(4, 6) = <<58, 4, 6>>\0az \\propto y == <<59, z, y>>\0aASSUME \\propto(4, 6) = <<59, 4, 6>>\0a\0az ^+ == <<60, z>>\0aASSUME ^+(4) = <<60, 4>>\0az ^* == <<61, z>>\0aASSUME ^*(4) = <<61, 4>>\0az ^# == <<62, z>>\0aASSUME ^#(4) = <<62, 4>>\0a-. z == <<63, z>>\0aASSUME -.(4) = <<63, 4>>\0a\0az \\leq y == <<64, z, y>>\0aASSUME \\leq(4, 6) = <<64, 4, 6>>\0aASSUME <=(4, 6) = <<64, 4, 6>>\0aASSUME =<(4, 6) = <<64, 4, 6>>\0a\0az \\geq y == <<65, z, y>>\0aASSUME \\geq(4, 6) = <<65, 4, 6>>\0aASSUME >=(4, 6) = <<65, 4, 6>>\0a\0az \\oplus y == <<66, z, y>>\0aASSUME \\oplus(4, 6) = <<66, 4, 6>>\0aASSUME (+) (4, 6) = <<66, 4, 6>>\0a\0az \\ominus y == <<67, z, y>>\0aASSUME \\ominus(4, 6) = <<67, 4, 6>>\0aASSUME (-) (4, 6) = <<67, 4, 6>>\0a\0a\0az \\odot y == <<68, z, y>>\0aASSUME \\odot(4, 6) = <<68, 4, 6>>\0aASSUME (.) (4, 6) = <<68, 4, 6>>\0a\0az \\otimes y == <<69, z, y>>\0aASSUME \\otimes(4, 6) = <<69, 4, 6>>\0aASSUME (\\X) (4, 6) = <<69, 4, 6>>\0a\0az \\oslash y == <<70, z, y>>\0aASSUME \\oslash(4, 6) = <<70, 4, 6>>\0aASSUME (/) (4, 6) = <<70, 4, 6>>\0a\0az \\circ y == <<71, z, y>>\0aASSUME \\circ(4, 6) = <<71, 4, 6>>\0aASSUME \\o (4, 6) = <<71, 4, 6>>\0a\0aASSUME \\in(1, {1})\0a\0aASSUME \\cup({1}, {2}) = {1,2}\0a\0a=============================================================================\0a']]]
      ['suite/test206' 'test206' %accept ~[['test206' '------------------------------- MODULE test206 ------------------------------ \0a\\* Test of labels and their use in subexpression selectors.\0a\0aEXTENDS TLC, Integers\0a\0aCONSTANT C  \\* Test with C = 4\0a\0aOp(Arg(_), p) == \0a   \\A x \\in {1,2}, <<y, z>> \\in {<<3, 4>>} :\0a                      lab(x,y,z) ::  LET a ++ b ==  \0a                                          Arg(a) + b + x + 2*y + 3*z\0a                                     IN  (Arg(1) + Arg(p) + C + \0a                                            2*x  + 4*y + 6*z) =\0a                                         1 ++ ( label2 :: p ++ C)\0a\\*                                IN /\\label2::  PrintT("FOO")\0a\\*                                   /\\ PrintT(Arg(1))\0a\\*                                   /\\ PrintT("FOO2")\0a\\*                                   /\\ PrintT(<<p, Arg(p)>>)\0a\\*                                   /\\ PrintT("FOO3")\0a\\*                                   /\\ PrintT(<<p, C>>)\0a\\*                                   /\\ PrintT("FOO3a")\0a\\*                                   /\\ PrintT(1++2)\0a\\*                                   /\\ PrintT(p++C)\0a\\*                                   /\\ PrintT("FOO4")\0a\\*                                   /\\ PrintT(<<x, y, z>>)\0a\0aFoo(u) == 2*u \0a\0aASSUME Foo(5) = Foo(5)!:\0a\0aTHEOREM Thm == ASSUME FALSE\0a               PROVE  lab:: C > 0\0a\0aTHEOREM Thm2 == lab3 :: TRUE\0a\0a\0aASSUME Foo(25) = 50\0a\0aBar == Op(Foo, 9)!lab(1,2,3)\0a\0aASSUME Op(Foo, 9) \0a\0aASSUME Thm2!lab3\0a\0aASSUME Bar\0a\0aASSUME Op(Foo, 9)!lab(1,2,3)!label2 = Op(Foo, 9)!lab(1,2,3)!:!++(9, 4) \0a\0aOp3(A(_,_,_), a1, a2, a3) == A(a1, a2, a3)\0a\0aOp1(a) == \\A x \\in {} : lab(x) :: IF TRUE\0a                             THEN LET Op1a(c) == 4 * c + a*x\0a                                  IN  a + Op1a(x) \0a                             ELSE 1\0aSOp1(a) == a\0aOOp1(A(_), a) == A(a)\0aASSUME OOp1(SOp1, 2) = 2\0a\0aSOp1a(a) == {x \\in {1,2} : a = x}\0aOOp2(A(_,_), a, b) == A(a, b)\0aASSUME OOp2(SOp1a!@, 2, 2) = TRUE\0a\0aSOp1b(a) == {x + a : x \\in {1,2}}\0aASSUME OOp2(SOp1b!@, 2, 3) = 5\0a\0aSOp1c(a) == {(LET c == a * x IN x + a)  : x \\in {1,2}}\0aASSUME OOp2(SOp1c!@!c, 2, 3) = 2 * 3\0a\0aSOp1d(a) == {(LET c(y) == (a * x) + y IN x + a)  : x \\in {1,2}}\0aOOp3(A(_,_,_), a, b, c) == A(a, b, c)\0aASSUME OOp3(SOp1d!@!c, 2, 3, 4) = 2 * 3 + 4\0a\0aOOp4(A(_,_,_,_), a, b, c, d) == A(a, b, c, d)\0a\0a\0a\\* Foo1 == Op1(2)!(3)!2!1\0aASSUME Op1(2)!(3)!2!1 = 2 + 4*3 + 6\0aASSUME Op1(2)!(3)!2!Op1a(4) = 16 + 6\0aASSUME Op3(Op1!@!2!Op1a, 2, 3, 4) = 22\0a\0aCOp(q, p) == \0a   CHOOSE x : lab(x) ::  LET a ++ b ==  {a, b, q, p, x}\0a                         IN  <<q, 99 ++ p >>\0a\0a\0aASSUME COp(1, 2)!(3)!++(4, 5) = {2,1, 3, 4, 5}\0a\0aASSUME COp(1, 2)!(3) = <<1, {99, 1, 2, 3} >>\0aASSUME COp(1, 2)!(3)!1 = <<1, {99, 1, 2, 3} >>\0aASSUME COp(1, 2)!(3)!1!>> = {99, 1, 2, 3}\0a\0aOOp5(A(_, _, _, _, _), a1, a2, a3, a4, a5) == A(a1, a2, a3, a4, a5)\0a\0aASSUME OOp5(COp!@!++, 1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0aASSUME COp(1, 2)!lab(3)!:!++(4, 5) = {2,1, 3, 4, 5}\0a\0aInst == INSTANCE test206a WITH A5 <- COp!@!++\0aASSUME Inst!Foo(1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0aASSUME Inst!Bar(3)!>> = 3\0aASSUME Inst!Bar2(3)!>> = 3\0aASSUME Inst!Bar3!>> = 2\0aASSUME Inst!Bar4(1)!(2)!<< = 2\0aASSUME Inst!Bar4(1)!(2)!>> = 1\0aASSUME Inst!Bar4(1)!lab(2)!<< = 2\0aASSUME Inst!Bar4(1)!lab(2)!>> = 1\0aASSUME OOp2(Inst!Bar4!@!<<, 1, 2) = 2\0aASSUME OOp2(Inst!Bar4!@!>>, 1, 2) = 1\0aASSUME OOp2(Inst!Bar4!lab!<<, 1, 2) = 2\0aASSUME OOp2(Inst!Bar4!lab!>>, 1, 2) = 1\0aASSUME Inst!Bar5(1)!lab(2)!:!++(3, 4) = <<1, 3, 4, 2>>\0aASSUME Inst!Bar5(1)!(2)!++(3, 4) = <<1, 3, 4, 2>>\0aASSUME OOp4(Inst!Bar5!lab!:!++, 1, 2, 3, 4) = <<1, 3, 4, 2>>\0a\0aInst2(A5(_, _, _, _, _)) ==  INSTANCE test206a \0aASSUME Inst2(COp!@!++)!Foo(1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0a\0a\0aCOp2(q, p) == \0a   CHOOSE x : lab(x) ::  LET a ++ b ==  {lab(y):: y + a + b : y \\in {1}}\0a                         IN  <<q, 99 ++ p >>\0a\0aASSUME COp2(1,2)!lab(3)!:!++(9,10)!lab(11) = 30\0aASSUME COp2(1,2)!(3)!++(9,10)!lab(11) = 30\0aASSUME COp2(1,2)!lab(3)!:!++(9,10)!(11) = 30\0aOOp6(A(_, _, _, _, _, _), a1, a2, a3, a4, a5, a6) == A(a1, a2, a3, a4, a5, a6)\0aASSUME OOp6(COp2!lab!:!++!lab, 1, 2, 3, 9, 10, 11) = 30\0aASSUME OOp6(COp2!@!++!lab, 1, 2, 3, 9, 10, 11) = 30\0aASSUME OOp6(COp2!lab!:!++!@, 1, 2, 3, 9, 10, 11) = 30\0a\0a\\* Let\'s test all the different kinds of operators\0a\0aDef1 == {1, 2, 3, 4}\0aASSUME Def1!2 = 2\0a\0aDef2 == {x \\in {1, 2, 3} : x > 17}\0aASSUME Def2!1 = {1, 2, 3}\0aASSUME Def2!(14)!<< = 14\0a\0aDef3 == {<<x, y>> : x \\in {1}, y \\in {2}}\0aASSUME Def3!2!1 = 2\0aASSUME Def3!(1, 2)!<< = 1\0a\0aDef4 == SUBSET UNION {{1}, {2}}\0aASSUME Def4!<<!<<!2 = {2}\0a\0aDef5 == [i \\in 1..10 |-> i+1][3]\0aASSUME Def5!>> = 3\0aASSUME Def5!<<[4] = 5\0aASSUME Def5!<<!1!>> = 10\0a\0aDef6 == [[i \\in 1..10 |-> i+1] EXCEPT ![2] = 1, ![3] = 2]\0aASSUME Def6!1[3] = 4\0a\\* The following two subexpression expressions are now\0a\\* considered to be illegal because they could contain\0a\\* a "@".\0a\\* ASSUME Def6!2=1\0a\\* ASSUME Def6!3=2\0a\0aDef7 == 3.a\0aASSUME Def7!1 = 3\0aASSUME Def7!2 = "a"\0a\0aDef8 == [a |-> 1, b |-> 2]\0aASSUME Def8!2 = 2\0a\0aDef9 == [a : 1, b : 2]\0aASSUME Def9!2 = 2\0a\0aDef10 == <<1, 2, 3>>\0aASSUME Def10!2 = 2\0a\0aDef11 == {1} \\X {2} \\X {3}\0aASSUME Def11!3!1 = 3\0a\0aDef12 == IF 2=3 THEN 2 ELSE 3\0aASSUME /\\ Def12!1!<< = 2\0a       /\\ Def12!2 = 2\0a       /\\ Def12!3 = 3\0a\0aDef13 == \\A x : CASE x=1 -> 1\0a                  [] x=2 -> 2\0a                  [] OTHER -> 3\0aASSUME /\\ Def13!(42)!1!<<!<< = 42\0a       /\\ Def13!(42)!1!>> = 1\0a       /\\ Def13!(42)!2!>> = 2\0a       /\\ Def13!(42)!3!>> = 3\0a\0aDef14 == \\A x \\in {1} : x = 1\0aASSUME /\\ Def14!(2)!<< = 2\0a       /\\ Def14!1!1 = 1\0a\0aDef15 == \\A x \\in {1}, y \\in {2} : (x = 1) /\\ (y = 2)\0aASSUME /\\ Def15!(2,3)!<<!<< = 2\0a       /\\ Def15!(2,3)!>>!<< = 3\0a       /\\ Def15!2!<< = 2\0a\0aDef16 == \\E x \\in {1}, <<y, z>> \\in {<<2,3>>} : /\\ ((x = 1))\0a                                                /\\ y = 2 \0a                                                /\\ (z=3)\0aASSUME /\\ Def16!(2,3,4)!1!1 = 2\0a       /\\ Def16!(2,3,4)!2!1 = 3\0a       /\\ Def16!2!1!<< = 2\0a\0aDef17 == \\E x , y, z : /\\ ((x = 1))\0a                       /\\ y = 2 \0a                       /\\ (z=3)\0aASSUME /\\ Def17!(2,3,4)!1!1 = 2\0a       /\\ Def17!(2,3,4)!2!1 = 3\0a\0aDef18 == CHOOSE x : (x=1)\0aASSUME Def18!(2)!<< = 2\0a\0aDef19 == CHOOSE x \\in {42}: (x=1)\0aASSUME /\\ Def19!(2)!<< = 2\0a       /\\ Def19!1!1 = 42\0a\0aDef20 == [12]_(23)\0aASSUME /\\ Def20!1 = 12\0a       /\\ Def20!>> = 23\0a\0aDef21 == <<12>>_(23)\0aASSUME /\\ Def21!1 = 12\0a       /\\ Def21!>> = 23\0a\0aDef22 == WF_(12)(23)\0aASSUME /\\ Def22!1 = 12\0a       /\\ Def22!>> = 23\0a\0aDef23 == \\EE x , y, z : /\\ ((x = 1))\0a                        /\\ y = 2 \0a                        /\\ (z=3)\0aASSUME /\\ Def23!(2,3,4)!1!1 = 2\0a       /\\ Def23!(2,3,4)!2!1 = 3\0a\0a\0a=============================================================================\0a\0alast modified on Tue  9 March 2010 at 11:49:54 PST by lamport'] ['test206a' '----------------------------- MODULE test206a -----------------------------\0a\0aCONSTANT A5(_, _, _, _, _)\0a\0aFoo(a1, a2, a3, a4, a5) == A5(a1, a2, a3, a4, a5) \0aBar(a) == <<1, a>>\0aBar2(a) == <<1, lab::a>>\0aBar3 == <<1, 2>>\0aBar4(a) == {x \\in {1} : lab(x) :: <<x, a>>}\0aBar5(a) == {x \\in {1} : lab(x) :: LET b ++ c == <<a, b, c, x>>\0a                                  IN 42 }\0a=============================================================================']]]
      ['suite/test206a' 'test206a' %accept ~[['test206a' '----------------------------- MODULE test206a -----------------------------\0a\0aCONSTANT A5(_, _, _, _, _)\0a\0aFoo(a1, a2, a3, a4, a5) == A5(a1, a2, a3, a4, a5) \0aBar(a) == <<1, a>>\0aBar2(a) == <<1, lab::a>>\0aBar3 == <<1, 2>>\0aBar4(a) == {x \\in {1} : lab(x) :: <<x, a>>}\0aBar5(a) == {x \\in {1} : lab(x) :: LET b ++ c == <<a, b, c, x>>\0a                                  IN 42 }\0a=============================================================================']]]
      ['suite/test207' 'test207' %accept ~[['test207' '\\* SANY2 test.\0a\\* Test of scope of NEW declarations.  They should be restricted\0a\\* to the statement\'s proof, except for SUFFICES which should be \0a\\* visible to the rest of the current proof.\0a\0a-------------------- MODULE test207 ----------------\0aEXTENDS TLC\0aa + b == <<a, b>>\0aTHEOREM Thm == ASSUME NEW J PROVE lab :: TRUE\0a<1>1 ASSUME NEW I\0a     PROVE  Thm!lab\0a  <2>1 I = J\0a  <2>2 QED\0a<1> DEFINE I == 1\0a<1>2 ASSUME NEW K\0a     PROVE  TRUE\0a<1>3 SUFFICES ASSUME NEW K\0a              PROVE  TRUE\0a  <2>1. \\A K : TRUE\0a  <2>2. SUFFICES ASSUME NEW L\0a                 PROVE  TRUE\0a  <2>3. QED\0a<1>3a. DEFINE L == 0\0a<1>4.  K = 0      \\* 12 June 14 Changed from <*>4 which is now illegal.\0a  <2>1. DEFINE F == 7\0a  <2>4. TRUE   \\* 12 June 14 Changed from <*>4 which is now illegal.\0a  <2>2. QED\0a     BY <2>4\0a<1>4a. DEFINE F == 42\0a<1>5 QED\0a  BY <1>4\0aJ == 0\0aI == 0\0aF == 1\0a\0aASSUME PrintT("SANY2 Test")\0a\0a=============================\0a']]]
      ['suite/test21' 'test21' %accept ~[['test21' '--------------- MODULE test21 -------------\0a\0a(* Test of priming and variable confusion *)\0a\0aEXTENDS Naturals, Sequences, TLC\0a\0aBar(z)    == z\' = 2\0aFoo(y)    == y = 2\0aFooBar(y) == y = 1\0a\0aVARIABLE x, y\0a\0aLetTest == LET s == x=1\0a           IN  s\0a\0a\0aOp(a) ==  x+a\0a\0aInit == /\\ x = 1\0a        /\\ y = 3\0aNext == \0a\0a  \\/ /\\ x = 1\0a     /\\ x\'=x+1\0a     /\\ y\' = y\0a     /\\ IF Bar(x)\0a          THEN Print("Test 1 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 1 Failed")\0a\0a  \\/ /\\ x = 1\0a     /\\ x\'=x+1\0a     /\\ y\' = y\0a     /\\ IF Foo(x)\'\0a          THEN Print("Test 2 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 2 Failed")\0a\0a  \\/ /\\ x = 1\0a     /\\ x\'=x+1\0a     /\\ y\' = y\0a     /\\ IF FooBar(x)\0a          THEN Print("Test 3 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 3 Failed")\0a     /\\ IF LetTest\' THEN Assert(FALSE, "Test 4 Failed")\0a                    ELSE Print("Test 4 OK", TRUE)\0a     /\\ LET a == x\0a        IN  IF a\' = 2 THEN Print("Test 5 OK", TRUE)\0a                      ELSE Assert(FALSE, "Test 5 Failed")\0a\0a     /\\ IF FooBar(x)\' THEN Assert(FALSE, "Test 6 Failed")\0a                      ELSE Print("Test 6 OK", TRUE)\0a\0a     /\\ IF FooBar(x\') THEN Assert(FALSE, "Test 7 Failed")\0a                      ELSE Print("Test 7 OK", TRUE)\0a\0a  \\/ IF (x = 1)\0a       THEN /\\ x\'=x+1\0a            /\\ y\'=y\0a            /\\ Print("Test 8 OK", TRUE)\0a       ELSE /\\ x\'=x+1\0a            /\\ y\'=y\0a            /\\ Print("Test 12 OK", FALSE)  \0a\0a  \\/ /\\ x = 1\0a     /\\ x\'=x+1\0a     /\\ y\'=y\0a     /\\ IF Op(1)\' = 3\0a          THEN Print("Test 9 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 9 Failed")\0a     /\\ IF LET LetOp(a) ==  x+a\0a           IN  LetOp(1)\' = 3\0a          THEN Print("Test 10 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 10 Failed")\0a\0a     /\\ IF (LET LetOp(a) ==  x+a\0a            IN  LetOp(1) = 3     )\'\0a          THEN Print("Test 11 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 11 Failed")\0a\0a  \\/ UNCHANGED <<x,y>>\0a\0aInv == TRUE\0a\0a=========================================\0a']]]
      ['suite/test212' 'test212' %reject ~[['test212' '--------------------------- MODULE test212 --------------------------\0a\\* Test of Leibniz checking\0a\\*   Uses the fact that you can\'t substitute a non-Leibniz operator\0a\\*   for a constant operator.\0aVARIABLE x\0a\0aLeibniz(a2) == {a2 , x\'}\0aNonLeibniz2(a, b) == <<a, b\'>>\0aL ==  INSTANCE test212b WITH y <- x\0a\0aNonLeibniz(a1) == a1\'\0aLeibniz2(a, b) == <<a, b, x\'>>\0a\0aI(a) == INSTANCE test212b WITH y <- a\0aLL == INSTANCE test212b WITH y <- ENABLED (x\'=x)\0aNonL(a) ==INSTANCE test212b WITH y <- ENABLED a\0a\0a\\* Legal\0aL1 == INSTANCE test212a WITH Op <- Leibniz, Op2 <- Leibniz2\0aL2 == INSTANCE test212a WITH Op <- LAMBDA a : I(a)!Leibniz(1), \0a                             Op2 <- Leibniz2\0aL3 == INSTANCE test212a WITH Op <- Leibniz, Op2 <- I!Leibniz\0aL4 == INSTANCE test212a WITH Op <- Leibniz, Op2 <- LL!Leibniz2\0aL5 == INSTANCE test212a WITH Op <- LL!Leibniz, Op2 <- Leibniz2\0a\0a\\* Illegal\0aI1 == INSTANCE test212a WITH Op <- Leibniz, Op2 <- NonLeibniz2\0aI2 == INSTANCE test212a WITH Op <- NonLeibniz, Op2 <- Leibniz2\0aI3 == INSTANCE test212a WITH Op <- NonL!NoArg, Op2 <- Leibniz2\0aI4 == INSTANCE test212a WITH Op <- Leibniz, Op2 <- L!NonLeibniz2\0aI5 == INSTANCE test212a WITH Op <- Leibniz, Op2 <- NonL!Leibniz\0aI6 == INSTANCE test212a WITH Op <- Leibniz, Op2 <- I!NonLeibniz\0a=================================================================='] ['test212b' '-------------------------- MODULE test212b -------------------------\0aVARIABLE y\0aNoArg == y\'\0aLeibniz(a4) == <<a4, y>>\0aLeibniz2(a44, a45) == <<a44, a45, y>>\0aNonLeibniz(a5) == ENABLED a5\0aNonLeibniz2(a6, a7) == {a6\', a7}\0a\0a=============================================================================\0a'] ['test212a' '-------------------------- MODULE test212a -------------------------\0a\0aCONSTANT Op(_) , Op2(_,_) \0a\0a=============================================================================']]]
      ['suite/test212a' 'test212a' %accept ~[['test212a' '-------------------------- MODULE test212a -------------------------\0a\0aCONSTANT Op(_) , Op2(_,_) \0a\0a=============================================================================']]]
      ['suite/test212b' 'test212b' %accept ~[['test212b' '-------------------------- MODULE test212b -------------------------\0aVARIABLE y\0aNoArg == y\'\0aLeibniz(a4) == <<a4, y>>\0aLeibniz2(a44, a45) == <<a44, a45, y>>\0aNonLeibniz(a5) == ENABLED a5\0aNonLeibniz2(a6, a7) == {a6\', a7}\0a\0a=============================================================================\0a']]]
      ['suite/test213' 'test213' %reject ~[['test213' '------------------------------- MODULE test213 ------------------------------ \0a\\* Test that \0a\\* - A non-temporal theorem or proof step cannot have a\0a\\*   temporal formula in its proof.\0a\\* - A declared constant that appears in an ASSUME or an ASSUME/PROVE\0a\\*   cannot be instantiated with a temporal formula \0a\\*\0a\\* Parsing only; produces errors.\0a\0aVARIABLE x\0a\0aI1 == INSTANCE test213b WITH C <- x\', D <- x\' \0aI2 == INSTANCE test213b WITH C <- [](x=0), D <- TRUE \\* ERROR\0aI3 == INSTANCE test213b WITH C <- TRUE, D <- [](x=0) \\* ERROR\0a\0aTHEOREM [](x=0)\0a<1>1. CASE FALSE\0a  <2>1. [](x=0)\0a  <2>2. QED\0a    <3>1. [](x # 0)\0a      BY [](x # 0)\0a    <3>2. QED\0a<1>2. x=0        \\* ERROR\0a  <2>1. (x=0)   \0a  <2>2. QED\0a    <3>1. [](x=0)  \0a    <3>2. QED\0a<1>3. CASE TRUE\0a <2>1. CASE x=0  \\* ERROR\0a <2>1a. CASE FALSE\0a <2>2. HAVE x=0  \\* ERROR\0a <2>2a HAVE TRUE \0a <2>3. WITNESS 3 \\in x \\* ERROR\0a <2>4. WITNESS 2 \\in {}\0a <2>5. QED\0a<1>4. QED\0a  <2>1. [](x=0)\0a  <2>2. QED\0a \0a\0a\0aTHEOREM x=0  \\* ERROR\0a <1>1. x\'=0     \\* ERROR\0a   BY [](x=0)   \\* This BY causes an error, though it needn\'t \0a <1>2. [](x=0)  \\* this causes error in THEOREM\0a <1>3. QED\0a============================================================================='] ['test213b' '------------------------------ MODULE test213b ------------------------------ \0aCONSTANT C, D\0aASSUME C = {}\0a\0aTHEOREM ASSUME D\0a        PROVE  TRUE\0a=============================================================================\0a']]]
      ['suite/test213b' 'test213b' %accept ~[['test213b' '------------------------------ MODULE test213b ------------------------------ \0aCONSTANT C, D\0aASSUME C = {}\0a\0aTHEOREM ASSUME D\0a        PROVE  TRUE\0a=============================================================================\0a']]]
      ['suite/test214' 'test214' %reject ~[['test214' '------------------------------ MODULE test214 ------------------------------ \0a\\* Test that USE and HIDE cannot contain arbitrary expressions as \0a\\* facts.\0a\0aTHEOREM bar == <<1, 2>>\0a\0aUSE bar, bar!1 (*ERROR*)\0a         \0a\0aHIDE bar, TRUE (*ERROR*)\0a\0aTHEOREM xx == ASSUME TRUE PROVE FALSE \0a <1>2. USE TRUE (*ERROR*), bar , xx , xx!1 (*ERROR*)\0a <1>3. QED\0a\0a=============================================================================\0a']]]
      ['suite/test215' 'test215' %reject ~[['test215' '------------------------- MODULE test215 ------------------------- \0a\\* Test of constraints on levels of temporal operators that\0a\\* outlaw any form of raw TLA.\0a\0aVARIABLE x\0a\0aa == x ~> []x\0ab == x\' ~> []x    \\* ERROR\0ac == []x ~> x\'    \\* ERROR\0a\0ad == x -+-> []x\0ae == x\' -+-> []x  \\* ERROR\0af == []x -+-> x\'  \\* ERROR\0a\0ag == <><<x\'>>_x\0ah == <>(x\')       \\* ERROR\0a\0afoo == [][x\']_x\0a\0abar == [](x\')    \\* ERROR\0a\0am == \\A i \\in {}, j \\in x : []x\0an == \\A i \\in {}, j \\in x\' : []x   \\* ERROR\0a\0amm == \\E i \\in {}, j \\in x : []x\0ann == \\E i \\in {}, j \\in x\' : []x   \\* ERROR\0a\0am2 == \\A i \\in x\' : x\'\0a=======================================================================']]]
      ['suite/test216' 'test216' %accept ~[['test216' '---------------------------- MODULE test216 ------------------------\0aEXTENDS TLC, Naturals\0a\0aINSTANCE test216a WITH D <- 42\0aFoo == INSTANCE test216a WITH D <- 43\0aFooG == INSTANCE test216a WITH D <- 42\0aVARIABLE x\0aCONSTANT C\0a\0aTHEOREM Thm1 == x \\in 0..C\0a \0aTHEOREM Thm1Prime == x\' \\in 0..C\0a\0aTHEOREM Thm1a == 1+1=2\0aBar == x \\in 0..C\0aInit == Bar \\/ Thm1!: \\/ (Thm1 /\\ ENABLED Thm1Prime!:)\0aNext == x\'=(x+1)%C  /\\  Thm1!: \0a             /\\ Thm1Prime!: /\\ Thm1 /\\ Thm1Prime\0aSpec == /\\ Init \0a        /\\ [][Next]_x\0a        /\\ WF_x(Next)\0a\0a\0a\0a\0aInv == Thm1\0aInv2 == Thm1!<< \\in Thm1!>>\0a\0aTHEOREM Thm1b == Spec => /\\ []Inv \0a                         /\\  []<>(x=0)\0a\0aSpec1 == Thm1b!1\0a\\* need to build two tests, since there are two specs\0a\0aTHEOREM Thm1c == [][Next]_x\0aSpec2 == Init /\\ Thm1c \\* Doesn\'t work\0a\0aThm1d == []<>(x=0)\0aProp3 == Thm1d\0a\0aProp1 == Thm1b!2!1\0aProp2 == Thm1b!2!2\0a\0aASSUME Thm2\0aASSUME ~ Foo!Thm2\0aASSUME ~Foo!Thm3\0aASSUME ~Foo!I!Thm3\0aASSUME  FooG!Thm2\0aASSUME FooG!Thm3 \0aASSUME FooG!I!Thm3\0aASSUME Thm2!:\0aASSUME ~ Foo!Thm2!:\0aASSUME Thm2!1 = 42\0aASSUME Foo!Thm2!1 = 43\0a\0aTHEOREM Thm3!:\0aTHEOREM ~ Foo!Thm3!:\0aASSUME Foo!Thm3!2!2 = 42\0aASSUME Foo!I!Thm3!2!2 = 42\0aASSUME I!Thm3!2!2 = 42\0aASSUME Thm3!2!2 = 42\0a\0a\0aJ == INSTANCE test216c\0aProp4 == J!ThmC!1 /\\ J!ThmC!2 /\\ J!ThmC2!:\0a\0aThm1aDef == Thm1a\0a\0aINSTANCE test216c\0aThmC3Def == ThmC3\0aProp5 == ThmC!1 /\\ ThmC!2   /\\ ThmC3!: /\\ Thm1aDef /\\ ThmC3Def\0a====================================================================\0a'] ['test216c' '------------------ MODULE test216c ---------------------\0aEXTENDS Naturals\0aVARIABLE x\0a\0aInitC == x = 0\0aNextC == x\'=(x+1) %6\0a\0aSpecC == [][NextC]_x\0a\0aTHEOREM ThmC == SpecC => [](x \\in Nat)\0a\0aTHEOREM ThmC2 == [](x \\in Nat)\0a\0aTHEOREM ThmC3 == 1+1 = 2\0a======================================================'] ['test216a' '---------------------------- MODULE test216a ------------------------\0aEXTENDS Naturals\0aCONSTANT D\0a\0aASSUME Ass2 == D + 0 = 42 \0aTHEOREM Thm2 == D + 0 = 42\0aThm2Def == D + 0 = 42\0a\0aINSTANCE test216b WITH E <- D, y <- 0   \0a  \\* 12 June 2014: Changed from Test216b, which is now illegal\0aI == INSTANCE test216b WITH E <- D, y <- 0\0a  \\* 12 June 2014: Changed from Test216b, which is now illegal\0a\0a\0a====================================================================\0a'] ['test216b' '---------------------------- MODULE test216b ------------------------\0aCONSTANT E, y\0a\0aTHEOREM Thm3 == y \\in {y} /\\ E = 42\0a\0a\0a====================================================================\0a']]]
      ['suite/test216a' 'test216a' %accept ~[['test216a' '---------------------------- MODULE test216a ------------------------\0aEXTENDS Naturals\0aCONSTANT D\0a\0aASSUME Ass2 == D + 0 = 42 \0aTHEOREM Thm2 == D + 0 = 42\0aThm2Def == D + 0 = 42\0a\0aINSTANCE test216b WITH E <- D, y <- 0   \0a  \\* 12 June 2014: Changed from Test216b, which is now illegal\0aI == INSTANCE test216b WITH E <- D, y <- 0\0a  \\* 12 June 2014: Changed from Test216b, which is now illegal\0a\0a\0a====================================================================\0a'] ['test216b' '---------------------------- MODULE test216b ------------------------\0aCONSTANT E, y\0a\0aTHEOREM Thm3 == y \\in {y} /\\ E = 42\0a\0a\0a====================================================================\0a']]]
      ['suite/test216b' 'test216b' %accept ~[['test216b' '---------------------------- MODULE test216b ------------------------\0aCONSTANT E, y\0a\0aTHEOREM Thm3 == y \\in {y} /\\ E = 42\0a\0a\0a====================================================================\0a']]]
      ['suite/test216c' 'test216c' %accept ~[['test216c' '------------------ MODULE test216c ---------------------\0aEXTENDS Naturals\0aVARIABLE x\0a\0aInitC == x = 0\0aNextC == x\'=(x+1) %6\0a\0aSpecC == [][NextC]_x\0a\0aTHEOREM ThmC == SpecC => [](x \\in Nat)\0a\0aTHEOREM ThmC2 == [](x \\in Nat)\0a\0aTHEOREM ThmC3 == 1+1 = 2\0a======================================================']]]
      ['suite/test217' 'test217' %reject ~[['test217' 'Sany should produce two level errors when parsing this module.\0a\0a---- MODULE test217 ----\0a    \\* 12 June 2014: Changed module name from Test217, which is now illegal\0aEXTENDS test217a\0a    \\* 12 June 2014: Changed from Test217a, which is now illegal\0aVARIABLE x\0a\0aI(z) == INSTANCE test217a WITH y <- z\0a    \\* 12 June 2014: Changed from Test217a, which is now illegal\0a\0aFooBar == I(x\')!Foo\0aTHEOREM I({x\'})!Foo\0a==============================='] ['test217a' '---- MODULE test217a ----\0aVARIABLE y\0a\0aTHEOREM Foo == y\'=0\0a=========================']]]
      ['suite/test217a' 'test217a' %accept ~[['test217a' '---- MODULE test217a ----\0aVARIABLE y\0a\0aTHEOREM Foo == y\'=0\0a=========================']]]
      ['suite/test219' 'test219' %accept ~[['test219' '------------------------------- MODULE test219 ------------------------------ \0a\\* Test of use of labels from instantiated theorems, and repeat\0a\\* test of some instantiations\0a\0aEXTENDS TLC , Integers\0a\0aI(x) == INSTANCE test219a WITH C <- 4  \0aJ == INSTANCE test219a WITH C <- 4  \0aINSTANCE test219a WITH C <- 4 \0a\0aLOCAL K(x) == INSTANCE test219a WITH C <- 4  \0aLOCAL L == INSTANCE test219a WITH C <- 4  \0a\0a\0aASSUME J!Thm2!lab3\0aASSUME I(55)!Thm2!lab3\0aASSUME L!Thm2!lab3\0aASSUME K(55)!Thm2!lab3\0aASSUME Thm2!lab3\0a\0a\0aASSUME Op(Foo, 9) \0a\0aASSUME Thm2!lab3\0a\0aASSUME Bar\0a\0aASSUME Op(Foo, 9)!lab(1,2,3)!label2 = Op(Foo, 9)!lab(1,2,3)!:!++(9, 4) \0aASSUME OOp1(SOp1, 2) = 2\0aASSUME OOp2(SOp1b!@, 2, 3) = 5\0aASSUME OOp2(SOp1c!@!c, 2, 3) = 2 * 3\0aASSUME OOp3(SOp1d!@!c, 2, 3, 4) = 2 * 3 + 4\0aASSUME Op1(2)!(3)!2!1 = 2 + 4*3 + 6\0aASSUME Op1(2)!(3)!2!Op1a(4) = 16 + 6\0aASSUME Op3(Op1!@!2!Op1a, 2, 3, 4) = 22\0aASSUME COp(1, 2)!(3)!++(4, 5) = {2,1, 3, 4, 5}\0aASSUME COp(1, 2)!(3) = <<1, {99, 1, 2, 3} >>\0aASSUME COp(1, 2)!(3)!1 = <<1, {99, 1, 2, 3} >>\0aASSUME COp(1, 2)!(3)!1!>> = {99, 1, 2, 3}\0aASSUME OOp5(COp!@!++, 1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0aASSUME COp(1, 2)!lab(3)!:!++(4, 5) = {2,1, 3, 4, 5}\0aASSUME Inst!Foo(1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0aASSUME Inst!Bar(3)!>> = 3\0aASSUME Inst!Bar2(3)!>> = 3\0aASSUME Inst!Bar3!>> = 2\0aASSUME Inst!Bar4(1)!(2)!<< = 2\0aASSUME Inst!Bar4(1)!(2)!>> = 1\0aASSUME Inst!Bar4(1)!lab(2)!<< = 2\0aASSUME Inst!Bar4(1)!lab(2)!>> = 1\0aASSUME OOp2(Inst!Bar4!@!<<, 1, 2) = 2\0aASSUME OOp2(Inst!Bar4!@!>>, 1, 2) = 1\0aASSUME OOp2(Inst!Bar4!lab!<<, 1, 2) = 2\0aASSUME OOp2(Inst!Bar4!lab!>>, 1, 2) = 1\0aASSUME Inst!Bar5(1)!lab(2)!:!++(3, 4) = <<1, 3, 4, 2>>\0aASSUME Inst!Bar5(1)!(2)!++(3, 4) = <<1, 3, 4, 2>>\0aASSUME OOp4(Inst!Bar5!lab!:!++, 1, 2, 3, 4) = <<1, 3, 4, 2>>\0aASSUME Inst2(COp!@!++)!Foo(1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0aASSUME COp2(1,2)!lab(3)!:!++(9,10)!lab(11) = 30\0aASSUME COp2(1,2)!(3)!++(9,10)!lab(11) = 30\0aASSUME COp2(1,2)!lab(3)!:!++(9,10)!(11) = 30\0aASSUME OOp6(COp2!lab!:!++!lab, 1, 2, 3, 9, 10, 11) = 30\0aASSUME OOp6(COp2!@!++!lab, 1, 2, 3, 9, 10, 11) = 30\0aASSUME OOp6(COp2!lab!:!++!@, 1, 2, 3, 9, 10, 11) = 30\0aASSUME Def1!2 = 2\0aASSUME Def2!(14)!<< = 14\0aASSUME Def3!2!1 = 2\0aASSUME Def3!(1, 2)!<< = 1\0aASSUME Def4!<<!<<!2 = {2}\0aASSUME Def5!>> = 3\0aASSUME Def5!<<[4] = 5\0aASSUME Def5!<<!1!>> = 10\0aASSUME Def6!1[3] = 4\0aASSUME Def7!1 = 3\0aASSUME Def7!2 = "a"\0aASSUME Def8!2 = 2\0aASSUME Def9!2 = 2\0aASSUME Def10!2 = 2\0aASSUME Def11!3!1 = 3\0a\0aASSUME L!Op(Foo, 9)!lab(1,2,3)!label2 = Op(Foo, 9)!lab(1,2,3)!:!++(9, 4) \0aASSUME L!OOp1(SOp1, 2) = 2\0aASSUME L!OOp2(SOp1b!@, 2, 3) = 5\0aASSUME L!OOp2(SOp1c!@!c, 2, 3) = 2 * 3\0aASSUME L!OOp3(SOp1d!@!c, 2, 3, 4) = 2 * 3 + 4\0aASSUME L!Op1(2)!(3)!2!1 = 2 + 4*3 + 6\0aASSUME L!Op1(2)!(3)!2!Op1a(4) = 16 + 6\0aASSUME L!Op3(Op1!@!2!Op1a, 2, 3, 4) = 22\0aASSUME L!COp(1, 2)!(3)!++(4, 5) = {2,1, 3, 4, 5}\0aASSUME L!COp(1, 2)!(3) = <<1, {99, 1, 2, 3} >>\0aASSUME L!COp(1, 2)!(3)!1 = <<1, {99, 1, 2, 3} >>\0aASSUME L!COp(1, 2)!(3)!1!>> = {99, 1, 2, 3}\0aASSUME L!OOp5(COp!@!++, 1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0aASSUME L!COp(1, 2)!lab(3)!:!++(4, 5) = {2,1, 3, 4, 5}\0aASSUME L!Inst!Foo(1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0aASSUME L!Inst!Bar(3)!>> = 3\0aASSUME L!Inst!Bar2(3)!>> = 3\0aASSUME L!Inst!Bar3!>> = 2\0aASSUME L!Inst!Bar4(1)!(2)!<< = 2\0aASSUME L!Inst!Bar4(1)!(2)!>> = 1\0aASSUME L!Inst!Bar4(1)!lab(2)!<< = 2\0aASSUME L!Inst!Bar4(1)!lab(2)!>> = 1\0aASSUME L!OOp2(Inst!Bar4!@!<<, 1, 2) = 2\0aASSUME L!OOp2(Inst!Bar4!@!>>, 1, 2) = 1\0aASSUME L!OOp2(Inst!Bar4!lab!<<, 1, 2) = 2\0aASSUME L!OOp2(Inst!Bar4!lab!>>, 1, 2) = 1\0aASSUME L!Inst!Bar5(1)!lab(2)!:!++(3, 4) = <<1, 3, 4, 2>>\0aASSUME L!Inst!Bar5(1)!(2)!++(3, 4) = <<1, 3, 4, 2>>\0aASSUME L!OOp4(Inst!Bar5!lab!:!++, 1, 2, 3, 4) = <<1, 3, 4, 2>>\0aASSUME L!Inst2(COp!@!++)!Foo(1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0aASSUME L!COp2(1,2)!lab(3)!:!++(9,10)!lab(11) = 30\0aASSUME L!COp2(1,2)!(3)!++(9,10)!lab(11) = 30\0aASSUME L!COp2(1,2)!lab(3)!:!++(9,10)!(11) = 30\0aASSUME L!OOp6(COp2!lab!:!++!lab, 1, 2, 3, 9, 10, 11) = 30\0aASSUME L!OOp6(COp2!@!++!lab, 1, 2, 3, 9, 10, 11) = 30\0aASSUME L!OOp6(COp2!lab!:!++!@, 1, 2, 3, 9, 10, 11) = 30\0aASSUME L!Def1!2 = 2\0aASSUME L!Def2!(14)!<< = 14\0aASSUME L!Def3!2!1 = 2\0aASSUME L!Def3!(1, 2)!<< = 1\0aASSUME L!Def4!<<!<<!2 = {2}\0aASSUME L!Def5!>> = 3\0aASSUME L!Def5!<<[4] = 5\0aASSUME L!Def5!<<!1!>> = 10\0aASSUME L!Def6!1[3] = 4\0aASSUME L!Def7!1 = 3\0aASSUME L!Def7!2 = "a"\0aASSUME L!Def8!2 = 2\0aASSUME L!Def9!2 = 2\0aASSUME L!Def10!2 = 2\0aASSUME L!Def11!3!1 = 3\0a\0aASSUME I(55)!Op(Foo, 9)!lab(1,2,3)!label2 = Op(Foo, 9)!lab(1,2,3)!:!++(9, 4) \0aASSUME I(55)!OOp1(SOp1, 2) = 2\0aASSUME I(55)!OOp2(SOp1b!@, 2, 3) = 5\0aASSUME I(55)!OOp2(SOp1c!@!c, 2, 3) = 2 * 3\0aASSUME I(55)!OOp3(SOp1d!@!c, 2, 3, 4) = 2 * 3 + 4\0aASSUME I(55)!Op1(2)!(3)!2!1 = 2 + 4*3 + 6\0aASSUME I(55)!Op1(2)!(3)!2!Op1a(4) = 16 + 6\0aASSUME I(55)!Op3(Op1!@!2!Op1a, 2, 3, 4) = 22\0aASSUME I(55)!COp(1, 2)!(3)!++(4, 5) = {2,1, 3, 4, 5}\0aASSUME I(55)!COp(1, 2)!(3) = <<1, {99, 1, 2, 3} >>\0aASSUME I(55)!COp(1, 2)!(3)!1 = <<1, {99, 1, 2, 3} >>\0aASSUME I(55)!COp(1, 2)!(3)!1!>> = {99, 1, 2, 3}\0aASSUME I(55)!OOp5(COp!@!++, 1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0aASSUME I(55)!COp(1, 2)!lab(3)!:!++(4, 5) = {2,1, 3, 4, 5}\0aASSUME I(55)!Inst!Foo(1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0aASSUME I(55)!Inst!Bar(3)!>> = 3\0aASSUME I(55)!Inst!Bar2(3)!>> = 3\0aASSUME I(55)!Inst!Bar3!>> = 2\0aASSUME I(55)!Inst!Bar4(1)!(2)!<< = 2\0aASSUME I(55)!Inst!Bar4(1)!(2)!>> = 1\0aASSUME I(55)!Inst!Bar4(1)!lab(2)!<< = 2\0aASSUME I(55)!Inst!Bar4(1)!lab(2)!>> = 1\0aASSUME I(55)!OOp2(Inst!Bar4!@!<<, 1, 2) = 2\0aASSUME I(55)!OOp2(Inst!Bar4!@!>>, 1, 2) = 1\0aASSUME I(55)!OOp2(Inst!Bar4!lab!<<, 1, 2) = 2\0aASSUME I(55)!OOp2(Inst!Bar4!lab!>>, 1, 2) = 1\0aASSUME I(55)!Inst!Bar5(1)!lab(2)!:!++(3, 4) = <<1, 3, 4, 2>>\0aASSUME I(55)!Inst!Bar5(1)!(2)!++(3, 4) = <<1, 3, 4, 2>>\0aASSUME I(55)!OOp4(Inst!Bar5!lab!:!++, 1, 2, 3, 4) = <<1, 3, 4, 2>>\0aASSUME I(55)!Inst2(COp!@!++)!Foo(1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0aASSUME I(55)!COp2(1,2)!lab(3)!:!++(9,10)!lab(11) = 30\0aASSUME I(55)!COp2(1,2)!(3)!++(9,10)!lab(11) = 30\0aASSUME I(55)!COp2(1,2)!lab(3)!:!++(9,10)!(11) = 30\0aASSUME I(55)!OOp6(COp2!lab!:!++!lab, 1, 2, 3, 9, 10, 11) = 30\0aASSUME I(55)!OOp6(COp2!@!++!lab, 1, 2, 3, 9, 10, 11) = 30\0aASSUME I(55)!OOp6(COp2!lab!:!++!@, 1, 2, 3, 9, 10, 11) = 30\0aASSUME I(55)!Def1!2 = 2\0aASSUME I(55)!Def2!(14)!<< = 14\0aASSUME I(55)!Def3!2!1 = 2\0aASSUME I(55)!Def3!(1, 2)!<< = 1\0aASSUME I(55)!Def4!<<!<<!2 = {2}\0aASSUME I(55)!Def5!>> = 3\0aASSUME I(55)!Def5!<<[4] = 5\0aASSUME I(55)!Def5!<<!1!>> = 10\0aASSUME I(55)!Def6!1[3] = 4\0aASSUME I(55)!Def7!1 = 3\0aASSUME I(55)!Def7!2 = "a"\0aASSUME I(55)!Def8!2 = 2\0aASSUME I(55)!Def9!2 = 2\0aASSUME I(55)!Def10!2 = 2\0aASSUME I(55)!Def11!3!1 = 3\0a\0aASSUME /\\ Def12!1!<< = 2\0a       /\\ Def12!2 = 2\0a       /\\ Def12!3 = 3\0aASSUME /\\ Def13!(42)!1!<<!<< = 42\0a       /\\ Def13!(42)!1!>> = 1\0a       /\\ Def13!(42)!2!>> = 2\0a       /\\ Def13!(42)!3!>> = 3\0a\0aASSUME /\\ Def14!(2)!<< = 2\0a       /\\ Def14!1!1 = 1\0a\0aASSUME /\\ Def15!(2,3)!<<!<< = 2\0a       /\\ Def15!(2,3)!>>!<< = 3\0a       /\\ Def15!2!<< = 2\0a\0aASSUME /\\ Def16!(2,3,4)!1!1 = 2\0a       /\\ Def16!(2,3,4)!2!1 = 3\0a       /\\ Def16!2!1!<< = 2\0a\0aASSUME /\\ Def17!(2,3,4)!1!1 = 2\0a       /\\ Def17!(2,3,4)!2!1 = 3\0a\0aASSUME Def18!(2)!<< = 2\0a\0aASSUME /\\ Def19!(2)!<< = 2\0a       /\\ Def19!1!1 = 42\0a\0aASSUME /\\ Def20!1 = 12\0a       /\\ Def20!>> = 23\0a\0aASSUME /\\ Def21!1 = 12\0a       /\\ Def21!>> = 23\0a\0aASSUME /\\ Def22!1 = 12\0a       /\\ Def22!>> = 23\0a\0aASSUME /\\ Def23!(2,3,4)!1!1 = 2\0a       /\\ Def23!(2,3,4)!2!1 = 3\0a\0a\0a=============================================================================\0a\0alast modified on Thu  1 November 2012 at 10:11:43 PST by lamport\0a=============================================================================='] ['test219a' '------------------------------- MODULE test219a ------------------------------ \0a\\* Test of labels and their use in subexpression selectors.\0a\0aEXTENDS TLC, Integers\0a\0aCONSTANT C\0a\\* C  == 4\0a\0aOp(Arg(_), p) == \0a   \\A x \\in {1,2}, <<y, z>> \\in {<<3, 4>>} :\0a                      lab(x,y,z) ::  LET a ++ b ==  \0a                                          Arg(a) + b + x + 2*y + 3*z\0a                                     IN  (Arg(1) + Arg(p) + C + \0a                                            2*x  + 4*y + 6*z) =\0a                                         1 ++ ( label2 :: p ++ C)\0a\\*                                IN /\\label2::  PrintT("FOO")\0a\\*                                   /\\ PrintT(Arg(1))\0a\\*                                   /\\ PrintT("FOO2")\0a\\*                                   /\\ PrintT(<<p, Arg(p)>>)\0a\\*                                   /\\ PrintT("FOO3")\0a\\*                                   /\\ PrintT(<<p, C>>)\0a\\*                                   /\\ PrintT("FOO3a")\0a\\*                                   /\\ PrintT(1++2)\0a\\*                                   /\\ PrintT(p++C)\0a\\*                                   /\\ PrintT("FOO4")\0a\\*                                   /\\ PrintT(<<x, y, z>>)\0a\0aFoo(u) == 2*u \0a\0a\\* ASSUME Foo(5) = Foo(5)!:\0a\0aTHEOREM Thm == ASSUME FALSE\0a               PROVE  lab:: C > 0\0a\0aTHEOREM Thm2 == lab3 :: TRUE\0a\0a\0a\\* ASSUME Foo(25) = 50\0a\0aBar == Op(Foo, 9)!lab(1,2,3)\0a\0a\\* ASSUME Op(Foo, 9) \0a\\* \0a\\* ASSUME Thm2!lab3\0a\\* \0a\\* ASSUME Bar\0a\\* \0a\\* ASSUME Op(Foo, 9)!lab(1,2,3)!label2 = Op(Foo, 9)!lab(1,2,3)!:!++(9, 4) \0a\0aOp3(A(_,_,_), a1, a2, a3) == A(a1, a2, a3)\0a\0aOp1(a) == \\A x \\in {} : lab(x) :: IF TRUE\0a                             THEN LET Op1a(c) == 4 * c + a*x\0a                                  IN  a + Op1a(x) \0a                             ELSE 1\0aSOp1(a) == a\0aOOp1(A(_), a) == A(a)\0a\\* ASSUME OOp1(SOp1, 2) = 2\0a\0aSOp1a(a) == {x \\in {1,2} : a = x}\0aOOp2(A(_,_), a, b) == A(a, b)\0a\\* ASSUME OOp2(SOp1a!@, 2, 2) = TRUE\0a\0aSOp1b(a) == {x + a : x \\in {1,2}}\0a\\* ASSUME OOp2(SOp1b!@, 2, 3) = 5\0a\0aSOp1c(a) == {(LET c == a * x IN x + a)  : x \\in {1,2}}\0a\\* ASSUME OOp2(SOp1c!@!c, 2, 3) = 2 * 3\0a\0aSOp1d(a) == {(LET c(y) == (a * x) + y IN x + a)  : x \\in {1,2}}\0aOOp3(A(_,_,_), a, b, c) == A(a, b, c)\0a\\* ASSUME OOp3(SOp1d!@!c, 2, 3, 4) = 2 * 3 + 4\0a\0aOOp4(A(_,_,_,_), a, b, c, d) == A(a, b, c, d)\0a\0a\0a\\* Foo1 == Op1(2)!(3)!2!1\0a\\* ASSUME Op1(2)!(3)!2!1 = 2 + 4*3 + 6\0a\\* ASSUME Op1(2)!(3)!2!Op1a(4) = 16 + 6\0a\\* ASSUME Op3(Op1!@!2!Op1a, 2, 3, 4) = 22\0a\0aCOp(q, p) == \0a   CHOOSE x : lab(x) ::  LET a ++ b ==  {a, b, q, p, x}\0a                         IN  <<q, 99 ++ p >>\0a\0a\0a\\* ASSUME COp(1, 2)!(3)!++(4, 5) = {2,1, 3, 4, 5}\0a\0a\\* ASSUME COp(1, 2)!(3) = <<1, {99, 1, 2, 3} >>\0a\\* ASSUME COp(1, 2)!(3)!1 = <<1, {99, 1, 2, 3} >>\0a\\* ASSUME COp(1, 2)!(3)!1!>> = {99, 1, 2, 3}\0a\0aOOp5(A(_, _, _, _, _), a1, a2, a3, a4, a5) == A(a1, a2, a3, a4, a5)\0a\0a\\* ASSUME OOp5(COp!@!++, 1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0a\\* ASSUME COp(1, 2)!lab(3)!:!++(4, 5) = {2,1, 3, 4, 5}\0a\0aInst == INSTANCE test206a WITH A5 <- COp!@!++\0a\\* ASSUME Inst!Foo(1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0a\\* ASSUME Inst!Bar(3)!>> = 3\0a\\* ASSUME Inst!Bar2(3)!>> = 3\0a\\* ASSUME Inst!Bar3!>> = 2\0a\\* ASSUME Inst!Bar4(1)!(2)!<< = 2\0a\\* ASSUME Inst!Bar4(1)!(2)!>> = 1\0a\\* ASSUME Inst!Bar4(1)!lab(2)!<< = 2\0a\\* ASSUME Inst!Bar4(1)!lab(2)!>> = 1\0a\\* ASSUME OOp2(Inst!Bar4!@!<<, 1, 2) = 2\0a\\* ASSUME OOp2(Inst!Bar4!@!>>, 1, 2) = 1\0a\\* ASSUME OOp2(Inst!Bar4!lab!<<, 1, 2) = 2\0a\\* ASSUME OOp2(Inst!Bar4!lab!>>, 1, 2) = 1\0a\\* ASSUME Inst!Bar5(1)!lab(2)!:!++(3, 4) = <<1, 3, 4, 2>>\0a\\* ASSUME Inst!Bar5(1)!(2)!++(3, 4) = <<1, 3, 4, 2>>\0a\\* ASSUME OOp4(Inst!Bar5!lab!:!++, 1, 2, 3, 4) = <<1, 3, 4, 2>>\0a\0aInst2(A5(_, _, _, _, _)) ==  INSTANCE test206a \0a\\* ASSUME Inst2(COp!@!++)!Foo(1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0a\0a\0aCOp2(q, p) == \0a   CHOOSE x : lab(x) ::  LET a ++ b ==  {lab(y):: y + a + b : y \\in {1}}\0a                         IN  <<q, 99 ++ p >>\0a\0a\\* ASSUME COp2(1,2)!lab(3)!:!++(9,10)!lab(11) = 30\0a\\* ASSUME COp2(1,2)!(3)!++(9,10)!lab(11) = 30\0a\\* ASSUME COp2(1,2)!lab(3)!:!++(9,10)!(11) = 30\0aOOp6(A(_, _, _, _, _, _), a1, a2, a3, a4, a5, a6) == A(a1, a2, a3, a4, a5, a6)\0a\\* ASSUME OOp6(COp2!lab!:!++!lab, 1, 2, 3, 9, 10, 11) = 30\0a\\* ASSUME OOp6(COp2!@!++!lab, 1, 2, 3, 9, 10, 11) = 30\0a\\* ASSUME OOp6(COp2!lab!:!++!@, 1, 2, 3, 9, 10, 11) = 30\0a\0a\\* Let\'s test all the different kinds of operators\0a\0aDef1 == {1, 2, 3, 4}\0a\\* ASSUME Def1!2 = 2\0a\0aDef2 == {x \\in {1, 2, 3} : x > 17}\0a\\* ASSUME Def2!1 = {1, 2, 3}\0a\\* ASSUME Def2!(14)!<< = 14\0a\0aDef3 == {<<x, y>> : x \\in {1}, y \\in {2}}\0a\\* ASSUME Def3!2!1 = 2\0a\\* ASSUME Def3!(1, 2)!<< = 1\0a\0aDef4 == SUBSET UNION {{1}, {2}}\0a\\* ASSUME Def4!<<!<<!2 = {2}\0a\0aDef5 == [i \\in 1..10 |-> i+1][3]\0a\\* ASSUME Def5!>> = 3\0a\\* ASSUME Def5!<<[4] = 5\0a\\* ASSUME Def5!<<!1!>> = 10\0a\0aDef6 == [[i \\in 1..10 |-> i+1] EXCEPT ![2] = 1, ![3] = 2]\0a\\* ASSUME Def6!1[3] = 4\0a\\* The following two subexpression expressions are now\0a\\* considered to be illegal because they could contain\0a\\* a "@".\0a\\* ASSUME Def6!2=1\0a\\* ASSUME Def6!3=2\0a\0aDef7 == 3.a\0a\\* ASSUME Def7!1 = 3\0a\\* ASSUME Def7!2 = "a"\0a\0aDef8 == [a |-> 1, b |-> 2]\0a\\* ASSUME Def8!2 = 2\0a\0aDef9 == [a : 1, b : 2]\0a\\* ASSUME Def9!2 = 2\0a\0aDef10 == <<1, 2, 3>>\0a\\* ASSUME Def10!2 = 2\0a\0aDef11 == {1} \\X {2} \\X {3}\0a\\* ASSUME Def11!3!1 = 3\0a\0aDef12 == IF 2=3 THEN 2 ELSE 3\0a\\* ASSUME /\\ Def12!1!<< = 2\0a\\*       /\\ Def12!2 = 2\0a\\*       /\\ Def12!3 = 3\0a\0aDef13 == \\A x : CASE x=1 -> 1\0a                  [] x=2 -> 2\0a                  [] OTHER -> 3\0a\\* ASSUME /\\ Def13!(42)!1!<<!<< = 42\0a\\*       /\\ Def13!(42)!1!>> = 1\0a\\*       /\\ Def13!(42)!2!>> = 2\0a\\*       /\\ Def13!(42)!3!>> = 3\0a\0aDef14 == \\A x \\in {1} : x = 1\0a\\* ASSUME /\\ Def14!(2)!<< = 2\0a\\*       /\\ Def14!1!1 = 1\0a\0aDef15 == \\A x \\in {1}, y \\in {2} : (x = 1) /\\ (y = 2)\0a\\* ASSUME /\\ Def15!(2,3)!<<!<< = 2\0a\\*       /\\ Def15!(2,3)!>>!<< = 3\0a\\*       /\\ Def15!2!<< = 2\0a\0aDef16 == \\E x \\in {1}, <<y, z>> \\in {<<2,3>>} : /\\ ((x = 1))\0a                                                /\\ y = 2 \0a                                                /\\ (z=3)\0a\\* ASSUME /\\ Def16!(2,3,4)!1!1 = 2\0a\\*       /\\ Def16!(2,3,4)!2!1 = 3\0a\\*       /\\ Def16!2!1!<< = 2\0a\0aDef17 == \\E x , y, z : /\\ ((x = 1))\0a                       /\\ y = 2 \0a                       /\\ (z=3)\0a\\* ASSUME /\\ Def17!(2,3,4)!1!1 = 2\0a\\*       /\\ Def17!(2,3,4)!2!1 = 3\0a\0aDef18 == CHOOSE x : (x=1)\0a\\* ASSUME Def18!(2)!<< = 2\0a\0aDef19 == CHOOSE x \\in {42}: (x=1)\0a\\* ASSUME /\\ Def19!(2)!<< = 2\0a\\*       /\\ Def19!1!1 = 42\0a\0aDef20 == [12]_(23)\0a\\* ASSUME /\\ Def20!1 = 12\0a\\*       /\\ Def20!>> = 23\0a\0aDef21 == <<12>>_(23)\0a\\* ASSUME /\\ Def21!1 = 12\0a\\*       /\\ Def21!>> = 23\0a\0aDef22 == WF_(12)(23)\0a\\* ASSUME /\\ Def22!1 = 12\0a\\*     /\\ Def22!>> = 23\0a\0aDef23 == \\EE x , y, z : /\\ ((x = 1))\0a                        /\\ y = 2 \0a                        /\\ (z=3)\0a\\* ASSUME /\\ Def23!(2,3,4)!1!1 = 2\0a\\*       /\\ Def23!(2,3,4)!2!1 = 3\0a\0a\0a=============================================================================\0a\0alast modified on Wed 31 October 2012 at 14:45:24 PST by lamport'] ['test206a' '----------------------------- MODULE test206a -----------------------------\0a\0aCONSTANT A5(_, _, _, _, _)\0a\0aFoo(a1, a2, a3, a4, a5) == A5(a1, a2, a3, a4, a5) \0aBar(a) == <<1, a>>\0aBar2(a) == <<1, lab::a>>\0aBar3 == <<1, 2>>\0aBar4(a) == {x \\in {1} : lab(x) :: <<x, a>>}\0aBar5(a) == {x \\in {1} : lab(x) :: LET b ++ c == <<a, b, c, x>>\0a                                  IN 42 }\0a=============================================================================']]]
      ['suite/test219a' 'test219a' %accept ~[['test219a' '------------------------------- MODULE test219a ------------------------------ \0a\\* Test of labels and their use in subexpression selectors.\0a\0aEXTENDS TLC, Integers\0a\0aCONSTANT C\0a\\* C  == 4\0a\0aOp(Arg(_), p) == \0a   \\A x \\in {1,2}, <<y, z>> \\in {<<3, 4>>} :\0a                      lab(x,y,z) ::  LET a ++ b ==  \0a                                          Arg(a) + b + x + 2*y + 3*z\0a                                     IN  (Arg(1) + Arg(p) + C + \0a                                            2*x  + 4*y + 6*z) =\0a                                         1 ++ ( label2 :: p ++ C)\0a\\*                                IN /\\label2::  PrintT("FOO")\0a\\*                                   /\\ PrintT(Arg(1))\0a\\*                                   /\\ PrintT("FOO2")\0a\\*                                   /\\ PrintT(<<p, Arg(p)>>)\0a\\*                                   /\\ PrintT("FOO3")\0a\\*                                   /\\ PrintT(<<p, C>>)\0a\\*                                   /\\ PrintT("FOO3a")\0a\\*                                   /\\ PrintT(1++2)\0a\\*                                   /\\ PrintT(p++C)\0a\\*                                   /\\ PrintT("FOO4")\0a\\*                                   /\\ PrintT(<<x, y, z>>)\0a\0aFoo(u) == 2*u \0a\0a\\* ASSUME Foo(5) = Foo(5)!:\0a\0aTHEOREM Thm == ASSUME FALSE\0a               PROVE  lab:: C > 0\0a\0aTHEOREM Thm2 == lab3 :: TRUE\0a\0a\0a\\* ASSUME Foo(25) = 50\0a\0aBar == Op(Foo, 9)!lab(1,2,3)\0a\0a\\* ASSUME Op(Foo, 9) \0a\\* \0a\\* ASSUME Thm2!lab3\0a\\* \0a\\* ASSUME Bar\0a\\* \0a\\* ASSUME Op(Foo, 9)!lab(1,2,3)!label2 = Op(Foo, 9)!lab(1,2,3)!:!++(9, 4) \0a\0aOp3(A(_,_,_), a1, a2, a3) == A(a1, a2, a3)\0a\0aOp1(a) == \\A x \\in {} : lab(x) :: IF TRUE\0a                             THEN LET Op1a(c) == 4 * c + a*x\0a                                  IN  a + Op1a(x) \0a                             ELSE 1\0aSOp1(a) == a\0aOOp1(A(_), a) == A(a)\0a\\* ASSUME OOp1(SOp1, 2) = 2\0a\0aSOp1a(a) == {x \\in {1,2} : a = x}\0aOOp2(A(_,_), a, b) == A(a, b)\0a\\* ASSUME OOp2(SOp1a!@, 2, 2) = TRUE\0a\0aSOp1b(a) == {x + a : x \\in {1,2}}\0a\\* ASSUME OOp2(SOp1b!@, 2, 3) = 5\0a\0aSOp1c(a) == {(LET c == a * x IN x + a)  : x \\in {1,2}}\0a\\* ASSUME OOp2(SOp1c!@!c, 2, 3) = 2 * 3\0a\0aSOp1d(a) == {(LET c(y) == (a * x) + y IN x + a)  : x \\in {1,2}}\0aOOp3(A(_,_,_), a, b, c) == A(a, b, c)\0a\\* ASSUME OOp3(SOp1d!@!c, 2, 3, 4) = 2 * 3 + 4\0a\0aOOp4(A(_,_,_,_), a, b, c, d) == A(a, b, c, d)\0a\0a\0a\\* Foo1 == Op1(2)!(3)!2!1\0a\\* ASSUME Op1(2)!(3)!2!1 = 2 + 4*3 + 6\0a\\* ASSUME Op1(2)!(3)!2!Op1a(4) = 16 + 6\0a\\* ASSUME Op3(Op1!@!2!Op1a, 2, 3, 4) = 22\0a\0aCOp(q, p) == \0a   CHOOSE x : lab(x) ::  LET a ++ b ==  {a, b, q, p, x}\0a                         IN  <<q, 99 ++ p >>\0a\0a\0a\\* ASSUME COp(1, 2)!(3)!++(4, 5) = {2,1, 3, 4, 5}\0a\0a\\* ASSUME COp(1, 2)!(3) = <<1, {99, 1, 2, 3} >>\0a\\* ASSUME COp(1, 2)!(3)!1 = <<1, {99, 1, 2, 3} >>\0a\\* ASSUME COp(1, 2)!(3)!1!>> = {99, 1, 2, 3}\0a\0aOOp5(A(_, _, _, _, _), a1, a2, a3, a4, a5) == A(a1, a2, a3, a4, a5)\0a\0a\\* ASSUME OOp5(COp!@!++, 1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0a\\* ASSUME COp(1, 2)!lab(3)!:!++(4, 5) = {2,1, 3, 4, 5}\0a\0aInst == INSTANCE test206a WITH A5 <- COp!@!++\0a\\* ASSUME Inst!Foo(1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0a\\* ASSUME Inst!Bar(3)!>> = 3\0a\\* ASSUME Inst!Bar2(3)!>> = 3\0a\\* ASSUME Inst!Bar3!>> = 2\0a\\* ASSUME Inst!Bar4(1)!(2)!<< = 2\0a\\* ASSUME Inst!Bar4(1)!(2)!>> = 1\0a\\* ASSUME Inst!Bar4(1)!lab(2)!<< = 2\0a\\* ASSUME Inst!Bar4(1)!lab(2)!>> = 1\0a\\* ASSUME OOp2(Inst!Bar4!@!<<, 1, 2) = 2\0a\\* ASSUME OOp2(Inst!Bar4!@!>>, 1, 2) = 1\0a\\* ASSUME OOp2(Inst!Bar4!lab!<<, 1, 2) = 2\0a\\* ASSUME OOp2(Inst!Bar4!lab!>>, 1, 2) = 1\0a\\* ASSUME Inst!Bar5(1)!lab(2)!:!++(3, 4) = <<1, 3, 4, 2>>\0a\\* ASSUME Inst!Bar5(1)!(2)!++(3, 4) = <<1, 3, 4, 2>>\0a\\* ASSUME OOp4(Inst!Bar5!lab!:!++, 1, 2, 3, 4) = <<1, 3, 4, 2>>\0a\0aInst2(A5(_, _, _, _, _)) ==  INSTANCE test206a \0a\\* ASSUME Inst2(COp!@!++)!Foo(1, 2, 3, 4, 5) = {2,1, 3, 4, 5}\0a\0a\0aCOp2(q, p) == \0a   CHOOSE x : lab(x) ::  LET a ++ b ==  {lab(y):: y + a + b : y \\in {1}}\0a                         IN  <<q, 99 ++ p >>\0a\0a\\* ASSUME COp2(1,2)!lab(3)!:!++(9,10)!lab(11) = 30\0a\\* ASSUME COp2(1,2)!(3)!++(9,10)!lab(11) = 30\0a\\* ASSUME COp2(1,2)!lab(3)!:!++(9,10)!(11) = 30\0aOOp6(A(_, _, _, _, _, _), a1, a2, a3, a4, a5, a6) == A(a1, a2, a3, a4, a5, a6)\0a\\* ASSUME OOp6(COp2!lab!:!++!lab, 1, 2, 3, 9, 10, 11) = 30\0a\\* ASSUME OOp6(COp2!@!++!lab, 1, 2, 3, 9, 10, 11) = 30\0a\\* ASSUME OOp6(COp2!lab!:!++!@, 1, 2, 3, 9, 10, 11) = 30\0a\0a\\* Let\'s test all the different kinds of operators\0a\0aDef1 == {1, 2, 3, 4}\0a\\* ASSUME Def1!2 = 2\0a\0aDef2 == {x \\in {1, 2, 3} : x > 17}\0a\\* ASSUME Def2!1 = {1, 2, 3}\0a\\* ASSUME Def2!(14)!<< = 14\0a\0aDef3 == {<<x, y>> : x \\in {1}, y \\in {2}}\0a\\* ASSUME Def3!2!1 = 2\0a\\* ASSUME Def3!(1, 2)!<< = 1\0a\0aDef4 == SUBSET UNION {{1}, {2}}\0a\\* ASSUME Def4!<<!<<!2 = {2}\0a\0aDef5 == [i \\in 1..10 |-> i+1][3]\0a\\* ASSUME Def5!>> = 3\0a\\* ASSUME Def5!<<[4] = 5\0a\\* ASSUME Def5!<<!1!>> = 10\0a\0aDef6 == [[i \\in 1..10 |-> i+1] EXCEPT ![2] = 1, ![3] = 2]\0a\\* ASSUME Def6!1[3] = 4\0a\\* The following two subexpression expressions are now\0a\\* considered to be illegal because they could contain\0a\\* a "@".\0a\\* ASSUME Def6!2=1\0a\\* ASSUME Def6!3=2\0a\0aDef7 == 3.a\0a\\* ASSUME Def7!1 = 3\0a\\* ASSUME Def7!2 = "a"\0a\0aDef8 == [a |-> 1, b |-> 2]\0a\\* ASSUME Def8!2 = 2\0a\0aDef9 == [a : 1, b : 2]\0a\\* ASSUME Def9!2 = 2\0a\0aDef10 == <<1, 2, 3>>\0a\\* ASSUME Def10!2 = 2\0a\0aDef11 == {1} \\X {2} \\X {3}\0a\\* ASSUME Def11!3!1 = 3\0a\0aDef12 == IF 2=3 THEN 2 ELSE 3\0a\\* ASSUME /\\ Def12!1!<< = 2\0a\\*       /\\ Def12!2 = 2\0a\\*       /\\ Def12!3 = 3\0a\0aDef13 == \\A x : CASE x=1 -> 1\0a                  [] x=2 -> 2\0a                  [] OTHER -> 3\0a\\* ASSUME /\\ Def13!(42)!1!<<!<< = 42\0a\\*       /\\ Def13!(42)!1!>> = 1\0a\\*       /\\ Def13!(42)!2!>> = 2\0a\\*       /\\ Def13!(42)!3!>> = 3\0a\0aDef14 == \\A x \\in {1} : x = 1\0a\\* ASSUME /\\ Def14!(2)!<< = 2\0a\\*       /\\ Def14!1!1 = 1\0a\0aDef15 == \\A x \\in {1}, y \\in {2} : (x = 1) /\\ (y = 2)\0a\\* ASSUME /\\ Def15!(2,3)!<<!<< = 2\0a\\*       /\\ Def15!(2,3)!>>!<< = 3\0a\\*       /\\ Def15!2!<< = 2\0a\0aDef16 == \\E x \\in {1}, <<y, z>> \\in {<<2,3>>} : /\\ ((x = 1))\0a                                                /\\ y = 2 \0a                                                /\\ (z=3)\0a\\* ASSUME /\\ Def16!(2,3,4)!1!1 = 2\0a\\*       /\\ Def16!(2,3,4)!2!1 = 3\0a\\*       /\\ Def16!2!1!<< = 2\0a\0aDef17 == \\E x , y, z : /\\ ((x = 1))\0a                       /\\ y = 2 \0a                       /\\ (z=3)\0a\\* ASSUME /\\ Def17!(2,3,4)!1!1 = 2\0a\\*       /\\ Def17!(2,3,4)!2!1 = 3\0a\0aDef18 == CHOOSE x : (x=1)\0a\\* ASSUME Def18!(2)!<< = 2\0a\0aDef19 == CHOOSE x \\in {42}: (x=1)\0a\\* ASSUME /\\ Def19!(2)!<< = 2\0a\\*       /\\ Def19!1!1 = 42\0a\0aDef20 == [12]_(23)\0a\\* ASSUME /\\ Def20!1 = 12\0a\\*       /\\ Def20!>> = 23\0a\0aDef21 == <<12>>_(23)\0a\\* ASSUME /\\ Def21!1 = 12\0a\\*       /\\ Def21!>> = 23\0a\0aDef22 == WF_(12)(23)\0a\\* ASSUME /\\ Def22!1 = 12\0a\\*     /\\ Def22!>> = 23\0a\0aDef23 == \\EE x , y, z : /\\ ((x = 1))\0a                        /\\ y = 2 \0a                        /\\ (z=3)\0a\\* ASSUME /\\ Def23!(2,3,4)!1!1 = 2\0a\\*       /\\ Def23!(2,3,4)!2!1 = 3\0a\0a\0a=============================================================================\0a\0alast modified on Wed 31 October 2012 at 14:45:24 PST by lamport'] ['test206a' '----------------------------- MODULE test206a -----------------------------\0a\0aCONSTANT A5(_, _, _, _, _)\0a\0aFoo(a1, a2, a3, a4, a5) == A5(a1, a2, a3, a4, a5) \0aBar(a) == <<1, a>>\0aBar2(a) == <<1, lab::a>>\0aBar3 == <<1, 2>>\0aBar4(a) == {x \\in {1} : lab(x) :: <<x, a>>}\0aBar5(a) == {x \\in {1} : lab(x) :: LET b ++ c == <<a, b, c, x>>\0a                                  IN 42 }\0a=============================================================================']]]
      ['suite/test22' 'test22' %accept ~[['test22' '--------------- MODULE test22 -------------\0a\0a(* Test of fingerprinting. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x, y\0a\0aS == {1}\0aT == {2, 3, 4}\0a\0a\0a\0aInit ==  /\\ Print("Distinct States should equal Distinct Initial States", TRUE)\0a         /\\ x \\in [S -> [S -> SUBSET T]]\0a         /\\ y \\in [S -> [S -> SUBSET [a : {2}, b : {3, 4, 5}]]]\0a\0aInv == IF [S -> [S -> SUBSET [b : {4, 4, 3, 5, 4}, a : {2, 2}]]] # \0a               [S -> [S -> SUBSET [a : {2}, b : {3, 4, 5}]]]\0a          THEN Assert(FALSE, "Test 1 Failed")\0a          ELSE TRUE\0a\0aNext ==     \0a  \\/ UNCHANGED <<x, y>>\0a\0a  \\/ /\\ x\' \\in [S -> [S -> SUBSET {4, 4, 4, 3, 2, 2}]]\0a     /\\ UNCHANGED y\0a\0a  \\/ /\\ y\' \\in [S -> [S -> SUBSET [b : {4, 4, 3, 5, 4}, a : {2, 2}]]]\0a     /\\ UNCHANGED x\0a\0a  \\/ /\\ y\' = [y EXCEPT ![1][1] = {[b |-> 4, a |-> 2]}]\0a     /\\ UNCHANGED x\0a\0a  \\/ /\\ y\' = [y EXCEPT ![1][1] = {[b |-> 3, a |-> 2]}]\0a     /\\ UNCHANGED x\0a\0a  \\/ /\\ y\' = [y EXCEPT ![1][1] = {[b |-> 5, a |-> 2]}]\0a     /\\ UNCHANGED x\0a=========================================\0a']]]
      ['suite/test220' 'test220' %accept ~[['test220' '--------------- MODULE test220  -------------\0a\0a(* Testing deadlock and number of states found. *)\0a\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aASSUME TLCGet("config").deadlock = FALSE\0a\0aVARIABLE x, y, z\0a\0aInit == /\\ Print("This test should not deadlock when configured with CHECK_DEADLOCK=FALSE", TRUE)\0a        /\\ x = {}\0a        /\\ y = {}\0a        /\\ z = 1\0a\0aNext == /\\ x = {}\0a        /\\ x\' = {1}        \0a        /\\ y\' \\in SUBSET x\'\0a        /\\ z\' = z\0a        /\\ y\' = {}\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test23' 'test23' %accept ~[['test23' '--------------- MODULE test23 -------------\0a\0a(* Test of definitions from the Bags module *)\0a\0aEXTENDS Naturals, FiniteSets, TLC\0a\0aIsABag(B) == \0a  (************************************************************************)\0a  (* True iff B is a bag.                                                 *)\0a  (************************************************************************)\0a  B \\in [DOMAIN B -> {n \\in Nat : n > 0}]\0a\0aBagToSet(B) == DOMAIN B\0a  (************************************************************************)\0a  (* The set of elements at least one copy of which is in B.              *)\0a  (************************************************************************)\0a\0aSetToBag(S) == [e \\in S |-> 1]  \0a  (************************************************************************)\0a  (* The bag that contains one copy of every element of the set S.        *)\0a  (************************************************************************)\0a  \0aBagIn(e,B) == e \\in BagToSet(B)\0a  (************************************************************************)\0a  (* The \\in operator for bags.                                           *)\0a  (************************************************************************)\0a\0aEmptyBag == SetToBag({})\0a\0aBagCup(B1, B2)  ==\0a  (************************************************************************)\0a  (* The union of bags B1 and B2.                                         *)\0a  (************************************************************************)\0a  [e \\in (DOMAIN B1) \\cup (DOMAIN B2) |->\0a      (IF e \\in DOMAIN B1 THEN B1[e] ELSE 0) \0a    + (IF e \\in DOMAIN B2 THEN B2[e] ELSE 0) ]\0a\0aB1 ++ B2 == BagCup(B1, B2)\0a  \0aBagDiff(B1, B2)  == \0a  (************************************************************************)\0a  (* The bag B1 with the elements of B2 removed--that is, with one copy   *)\0a  (* of an element removed from B1 for each copy of the same element in   *)\0a  (* B2.  If B2 has at least as many copies of e as B1, then B1 -- B2    *)\0a  (* has no copies of e.                                                  *)\0a  (************************************************************************)\0a  LET B == [e \\in DOMAIN B1 |-> IF e \\in DOMAIN B2 THEN B1[e] - B2[e]\0a                                                   ELSE B1[e]]\0a  IN  [e \\in {d \\in DOMAIN B : B[d] > 0} |-> B[e]]\0a\0aB1 -- B2 == BagDiff(B1, B2)\0a\0aLOCAL Sum(f) ==\0a        (******************************************************************)\0a        (* The sum of f[x] for all x in DOMAIN f.  The definition assumes *)\0a        (* that f is a Nat-valued function and that f[x] equals 0 for all *)\0a        (* but a finite number of elements x in DOMAIN f.                 *)\0a        (******************************************************************)\0a        LET D == {e \\in DOMAIN f : f[e] > 0}\0a            DSum[S \\in SUBSET DOMAIN f] ==\0a               LET elt == CHOOSE e \\in S : TRUE\0a               IN  IF S = {} THEN 0\0a                             ELSE f[elt] + DSum[S \\ {elt}]\0a        IN  DSum[DOMAIN f]\0a\0aBagUnion(S) ==\0a  (************************************************************************)\0a  (* The bag union of all elements of the set S of bags.                  *)\0a  (************************************************************************)\0a  [e \\in UNION {BagToSet(B) : B \\in S} |->\0a    Sum( [B \\in S |-> IF BagIn(e, B) THEN B[e] ELSE 0] ) ]\0a\0aB1 \\sqsubseteq B2  ==\0a  (************************************************************************)\0a  (* The subset operator for bags.  B1 \\sqsubseteq B2 iff, for all e, bag *)\0a  (* B2 has at least as many copies of e as bag B1 does.                  *)\0a  (************************************************************************)\0a  /\\ (DOMAIN B1) \\subseteq (DOMAIN B2)\0a  /\\ \\A e \\in DOMAIN B1 : B1[e] \\leq B2[e]\0a\0aSubBag(B) ==\0a  (************************************************************************)\0a  (* The set of all subbags of bag B.                                     *)\0a  (************************************************************************)\0a  LET AllBagsOfSubset == \0a        (******************************************************************)\0a        (* The set of all bags SB such that BagToSet(SB) \\subseteq        *)\0a        (* BagToSet(B).                                                   *)\0a        (******************************************************************)\0a        UNION {[SB -> {n \\in Nat : n > 0}] : SB \\in SUBSET BagToSet(B)}  \0a  IN  {SB \\in AllBagsOfSubset : \\A e \\in DOMAIN SB : SB[e] \\leq B[e]}\0a\0aBagOfAll(F(_), B) ==\0a  (************************************************************************)\0a  (* The bag analog of the set {F(x) : x \\in B} for a set B. It\'s the bag *)\0a  (* that contains, for each element e of B, one copy of F(e) for every   *)\0a  (* copy of e in B. This defines a bag iff, for any value v, the set of  *)\0a  (* e in B such that F(e) = v is finite.                                 *)\0a  (************************************************************************)\0a  [e \\in {F(d) : d \\in BagToSet(B)} |-> \0a     Sum( [d \\in BagToSet(B) |-> IF F(d) = e THEN B[d] ELSE 0] ) ]\0a\0aBagCardinality(B) ==\0a  (************************************************************************)\0a  (* If B is a finite bag (one such that BagToSet(B) is a finite set),    *)\0a  (* then this is its cardinality (the total number of copies of elements *)\0a  (* in B).  Its value is unspecified if B is infinite.                   *)\0a  (************************************************************************)\0a  Sum(B)\0a\0aCopiesIn(e, B) ==\0a  (************************************************************************)\0a  (* If B is a bag, then CopiesIn(e, B) is the number of copies of e in   *)\0a  (* B. If ~BagIn(e, B), then CopiesIn(e, B) = 0.                         *)\0a  (************************************************************************)\0a  IF BagIn(e, B) THEN B[e] ELSE 0\0a\0a\0a\0aMax(a, b) == IF a < b THEN b ELSE a\0aMaxCopies(B) ==\0a  (*************************************************************************)\0a  (* Maximum of B[e] s.t. e \\in DOMAIN B                                   *)\0a  (*************************************************************************)\0a  LET MC[S \\in SUBSET(DOMAIN B)] ==\0a        LET elt == CHOOSE elt \\in S : TRUE\0a        IN  IF S = {} THEN 0\0a                      ELSE Max(B[elt], MC[S \\ {elt}])\0a  IN MC[DOMAIN B]\0a\0aMCSubBag(B) ==\0a  (*************************************************************************)\0a  (* Definition of SubBag that TLC can handle.                             *)\0a  (*************************************************************************)\0a  LET AllBagsOfSubset == \0a        (******************************************************************)\0a        (* The set of all bags SB such that BagToSet(SB) \\subseteq        *)\0a        (* BagToSet(B).                                                   *)\0a        (******************************************************************)\0a        UNION {[SB -> {n \\in 1..MaxCopies(B) : n > 0}] : SB \\in SUBSET BagToSet(B)}  \0a  IN  {SB \\in AllBagsOfSubset : \\A e \\in DOMAIN SB : SB[e] \\leq B[e]}\0a         \0aVARIABLES x\0a\0a(* S == {"a"} *)\0aS == {"a", "b", "c"} \0a\0aB1 == SetToBag(S)\0aB2 == BagCup(SetToBag(S), SetToBag({"a"}))\0aB3 == [i \\in S |-> 3]\0aB4 == BagUnion({B1, B2, B3})\0aB9 == BagCup(SetToBag(S), SetToBag({"a"}))\0a\0aF1(e) == CASE e = "a" -> "fa"\0a           [] e = "b" -> "fa"\0a           [] e = "c" -> "fc"\0a           [] e = "d" -> "fc"\0a\0aInit == /\\ Print("Computing Init", TRUE) \0a        /\\ x = 1\0a\0aNext == UNCHANGED x\0a\0aInv ==\0a  /\\ Print("Computing Inv", TRUE) \0a  /\\ Print(<<"B1", B1>>, TRUE)\0a  /\\ Print(SetToBag({"a"}), TRUE)\0a\0a  /\\ LET B7    == (DOMAIN B1) \\cup (DOMAIN SetToBag({"a"})) \0a         e1(e, BB) == (IF e \\in DOMAIN BB THEN BB[e] ELSE 0)\0a     IN /\\ IF B7 = {}\0a            THEN Assert(FALSE, "Failed Test 0a")\0a            ELSE Print("Test 0a OK", TRUE)\0a\0a        /\\ IF [e \\in B7 |-> 2]["a"] # 2\0a             THEN Assert(FALSE, "Failed Test 0b")\0a             ELSE Print("Test 0b OK", TRUE)\0a\0a        /\\ IF [e \\in B7 |-> e1(e, B1)]["a"] # 1\0a             THEN Assert(FALSE, "Failed Test 0c")\0a             ELSE Print("Test 0c OK", TRUE)\0a\0a        /\\ IF [e \\in B7 |-> e1(e, SetToBag({"a"}))]["a"] # 1\0a             THEN Assert(FALSE, "Failed Test 0d")\0a             ELSE Print("Test 0d OK", TRUE)\0a\0a        /\\ IF [e \\in B7 |-> e1(e, B1) + e1(e,SetToBag({"a"}))]["a"] # 2\0a             THEN Assert(FALSE, "Failed Test 0e")\0a             ELSE Print("Test 0e OK", TRUE)\0a\0a  /\\ IF B9["a"] # 2\0a       THEN Assert(FALSE, "Failed Test 1aa")\0a       ELSE Print("Test 1aa OK", TRUE)\0a  /\\ Print("Finished test 1aa", TRUE)\0a\0a  /\\ IF B2["a"] # 2\0a       THEN Assert(FALSE, "Failed Test 1a")\0a       ELSE Print("Test 1a OK", TRUE)\0a  /\\ Print("Finished test 1a", TRUE)\0a\0a  /\\ IF BagToSet(B9) # S\0a       THEN Assert(FALSE, "Failed Test 1b")\0a       ELSE Print("Test 1b OK", TRUE)\0a\0a  /\\ IF BagToSet(B2) # S\0a       THEN Assert(FALSE, "Failed Test 1c")\0a       ELSE Print("Test 1c OK", TRUE)\0a\0a  /\\ IF BagToSet(B1 -- SetToBag({"a"})) # {"c", "b"}\0a       THEN Assert(FALSE, "Failed Test 2")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF BagToSet(B3) # BagToSet(B1)\0a       THEN Assert(FALSE, "Failed Test 3")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF BagIn("a", B1 -- SetToBag({"a"}))\0a       THEN Assert(FALSE, "Failed Test 4")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF ~BagIn("a", B2)\0a       THEN Assert(FALSE, "Failed Test 5")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF EmptyBag # B1 -- B1\0a       THEN Assert(FALSE, "Failed Test 6")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF ~(B1 \\sqsubseteq B2)\0a       THEN Assert(FALSE, "Failed Test 7")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF ~(B2 \\sqsubseteq B3)\0a       THEN Assert(FALSE, "Failed Test 8")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF B2 \\sqsubseteq B1\0a       THEN Assert(FALSE, "Failed Test 9")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF BagCup(B1, SetToBag({"d"})) \\sqsubseteq B1\0a       THEN Assert(FALSE, "Failed Test 10")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF ~(B1 \\sqsubseteq (B1 ++ SetToBag({"d"})) )\0a       THEN Assert(FALSE, "Failed Test 11")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF BagToSet(B2 ++ SetToBag({"d"})) # S \\cup {"d"}\0a       THEN Assert(FALSE, "Failed Test 12")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF Cardinality(SubBag(B1)) # Cardinality(SUBSET S)\0a       THEN Assert(FALSE, "Failed Test 13")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0a  /\\ IF Cardinality(SubBag(B3)) # 64\0a       THEN Assert(FALSE, "Failed Test 14")\0a       ELSE Print("Test 14 OK", TRUE)\0a\0a  /\\ IF CopiesIn("fa", BagOfAll(F1, B1)) # 2\0a       THEN Assert(FALSE, "Failed Test 15")\0a       ELSE Print("Test 15 OK", TRUE)\0a\0a  /\\ IF CopiesIn("a", BagOfAll(F1, B1)) # 0\0a       THEN Assert(FALSE, "Failed Test 16")\0a       ELSE Print("Test 16 OK", TRUE)\0a\0a  /\\ IF CopiesIn("fa", BagOfAll(F1, B3)) # 6\0a       THEN Assert(FALSE, "Failed Test 17")\0a       ELSE Print("Test 17 OK", TRUE)\0a\0a  /\\ IF BagCardinality(B1) # 3\0a       THEN Assert(FALSE, "Failed Test 18")\0a       ELSE Print("Test 18 OK", TRUE)\0a\0a  /\\ IF BagCardinality(B3) # 9\0a       THEN Assert(FALSE, "Failed Test 19")\0a       ELSE Print("Test 19 OK", TRUE)\0a\0a==========================================================================\0a\0a\0a=============================================================================\0a']]]
      ['suite/test23bis' 'test23bis' %reject ~[['test23bis' '--------------- MODULE test23 -------------\0a\0aEXTENDS Naturals, FiniteSets, Bags, TLC\0a\0aVARIABLES x\0a\0a(* S == {"a"} *)\0aS == {"a", "b", "c"} \0a\0aB1 == SetToBag(S)\0aB2 == BagCup(SetToBag(S), SetToBag({"a"}))\0aB3 == [i \\in S |-> 3]\0aB4 == BagUnion({B1, B2, B3})\0aB9 == BagCup(SetToBag(S), SetToBag({"a"}))\0a\0aF1(e) == CASE e = "a" -> "fa"\0a           [] e = "b" -> "fa"\0a           [] e = "c" -> "fc"\0a           [] e = "d" -> "fc"\0a\0aInit == /\\ Print("Computing Init", TRUE) \0a        /\\ x = 1\0a\0aNext == UNCHANGED x\0a\0aInv ==\0a  /\\ Print("Computing Inv", TRUE) \0a  /\\ Print(<<"B1", B1>>, TRUE)\0a  /\\ Print(SetToBag({"a"}), TRUE)\0a\0a  /\\ LET B7    == (DOMAIN B1) \\cup (DOMAIN SetToBag({"a"})) \0a         e1(e, BB) == (IF e \\in DOMAIN BB THEN BB[e] ELSE 0)\0a     IN /\\ IF B7 = {}\0a            THEN Assert(FALSE, "Failed Test 0a")\0a            ELSE Print("Test 0a OK", TRUE)\0a\0a        /\\ IF [e \\in B7 |-> 2]["a"] # 2\0a             THEN Assert(FALSE, "Failed Test 0b")\0a             ELSE Print("Test 0b OK", TRUE)\0a\0a        /\\ IF [e \\in B7 |-> e1(e, B1)]["a"] # 1\0a             THEN Assert(FALSE, "Failed Test 0c")\0a             ELSE Print("Test 0c OK", TRUE)\0a\0a        /\\ IF [e \\in B7 |-> e1(e, SetToBag({"a"}))]["a"] # 1\0a             THEN Assert(FALSE, "Failed Test 0d")\0a             ELSE Print("Test 0d OK", TRUE)\0a\0a        /\\ IF [e \\in B7 |-> e1(e, B1) + e1(e,SetToBag({"a"}))]["a"] # 2\0a             THEN Assert(FALSE, "Failed Test 0e")\0a             ELSE Print("Test 0e OK", TRUE)\0a\0a  /\\ IF B9["a"] # 2\0a       THEN Assert(FALSE, "Failed Test 1aa")\0a       ELSE Print("Test 1aa OK", TRUE)\0a  /\\ Print("Finished test 1aa", TRUE)\0a\0a  /\\ IF B2["a"] # 2\0a       THEN Assert(FALSE, "Failed Test 1a")\0a       ELSE Print("Test 1a OK", TRUE)\0a  /\\ Print("Finished test 1a", TRUE)\0a\0a  /\\ IF BagToSet(B9) # S\0a       THEN Assert(FALSE, "Failed Test 1b")\0a       ELSE Print("Test 1b OK", TRUE)\0a\0a  /\\ IF BagToSet(B2) # S\0a       THEN Assert(FALSE, "Failed Test 1c")\0a       ELSE Print("Test 1c OK", TRUE)\0a\0a  /\\ IF BagToSet(B1 -- SetToBag({"a"})) # {"c", "b"}\0a       THEN Assert(FALSE, "Failed Test 2")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF BagToSet(B3) # BagToSet(B1)\0a       THEN Assert(FALSE, "Failed Test 3")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF BagIn("a", B1 -- SetToBag({"a"}))\0a       THEN Assert(FALSE, "Failed Test 4")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF ~BagIn("a", B2)\0a       THEN Assert(FALSE, "Failed Test 5")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF EmptyBag # B1 -- B1\0a       THEN Assert(FALSE, "Failed Test 6")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF ~(B1 \\sqsubseteq B2)\0a       THEN Assert(FALSE, "Failed Test 7")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF ~(B2 \\sqsubseteq B3)\0a       THEN Assert(FALSE, "Failed Test 8")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF B2 \\sqsubseteq B1\0a       THEN Assert(FALSE, "Failed Test 9")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF BagCup(B1, SetToBag({"d"})) \\sqsubseteq B1\0a       THEN Assert(FALSE, "Failed Test 10")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF ~(B1 \\sqsubseteq (B1 ++ SetToBag({"d"})) )\0a       THEN Assert(FALSE, "Failed Test 11")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF BagToSet(B2 ++ SetToBag({"d"})) # S \\cup {"d"}\0a       THEN Assert(FALSE, "Failed Test 12")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF Cardinality(SubBag(B1)) # Cardinality(SUBSET S)\0a       THEN Assert(FALSE, "Failed Test 13")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0a  /\\ IF Cardinality(SubBag(B3)) # 64\0a       THEN Assert(FALSE, "Failed Test 14")\0a       ELSE Print("Test 14 OK", TRUE)\0a\0a  /\\ IF CopiesIn("fa", BagOfAll(F1, B1)) # 2\0a       THEN Assert(FALSE, "Failed Test 15")\0a       ELSE Print("Test 15 OK", TRUE)\0a\0a  /\\ IF CopiesIn("a", BagOfAll(F1, B1)) # 0\0a       THEN Assert(FALSE, "Failed Test 16")\0a       ELSE Print("Test 16 OK", TRUE)\0a\0a  /\\ IF CopiesIn("fa", BagOfAll(F1, B3)) # 6\0a       THEN Assert(FALSE, "Failed Test 17")\0a       ELSE Print("Test 17 OK", TRUE)\0a\0a  /\\ IF BagCardinality(B1) # 3\0a       THEN Assert(FALSE, "Failed Test 18")\0a       ELSE Print("Test 18 OK", TRUE)\0a\0a  /\\ IF BagCardinality(B3) # 9\0a       THEN Assert(FALSE, "Failed Test 19")\0a       ELSE Print("Test 19 OK", TRUE)\0a\0a==========================================================================\0a\0a\0a=============================================================================\0a']]]
      ['suite/test24' 'test24' %accept ~[['test24' '--------------- MODULE test24 -------------\0a\0a(* Test of UNCHANGED *)\0a\0aEXTENDS Naturals, TLC\0a\0aVARIABLES x, y\0a\0aInit == /\\ x = [i \\in 1..3 |-> i]\0a        /\\ y = 1\0aNext == \0a\0a  \\/ /\\ UNCHANGED <<x, y>>\0a     /\\ \\A i \\in 1..3 : (x[i])\' = x[i]\0a     /\\ Print("Test 1 OK", TRUE)\0a\0a  \\/ /\\ UNCHANGED <<x, y>>\0a     /\\ \\A i \\in 1..3 : UNCHANGED x[i]\0a     /\\ Print("Test 2 OK", TRUE)\0a\0a  \\/ /\\ UNCHANGED <<x, y>>\0a     /\\ \\A i \\in 1..3 : UNCHANGED [a |-> x[i], b |-> x[i]+1]\0a     /\\ Print("Test 3 OK", TRUE)\0a\0a  \\/ /\\ UNCHANGED <<x, y>>\0a     /\\ IF UNCHANGED \\E i \\in 1..3 : x[i]=3\0a          THEN Print("Test 4 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 4 Failed")\0a\0a  \\/ /\\ UNCHANGED <<x, y>>\0a     /\\ IF UNCHANGED \\A i \\in 1..3 : x[i]=3\0a          THEN Print("Test 5 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 5 Failed")\0a\0a  \\/ /\\ UNCHANGED <<x, y>>\0a     /\\ IF UNCHANGED CHOOSE i \\in DOMAIN x : x[i] = 2\0a          THEN Print("Test 6 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 6 Failed")\0a\0a  \\/ /\\ UNCHANGED <<x, y>>\0a     /\\ IF UNCHANGED {x[i] : i \\in 1..2}\0a          THEN Print("Test 7 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 7 Failed")\0a\0a  \\/ /\\ UNCHANGED <<x, y>>\0a     /\\ IF UNCHANGED {i \\in 3..5 : \\E j \\in 1..3 : x[j]=i}\0a          THEN Print("Test 8 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 8 Failed")\0a\0a  \\/ /\\ UNCHANGED <<x, y>>\0a     /\\ IF UNCHANGED DOMAIN x\0a          THEN Print("Test 9 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 9 Failed")\0a\0a  \\/ /\\ (y=1) /\\ (y\' = y+1)\0a     /\\ UNCHANGED <<x>>\0a     /\\ IF UNCHANGED {x}\0a          THEN Print("Test 10 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 10 Failed")\0a\0a  \\/ /\\ (y=1) /\\ (y\' = y+1)\0a     /\\ UNCHANGED <<x>>\0a     /\\ IF UNCHANGED {1, 2, y}\0a          THEN Print("Test 11 OK", TRUE)\0a          ELSE Assert(FALSE, "Test 11 Failed")\0a\0aInv == TRUE\0a==========================================================================\0a\0a\0a=============================================================================\0a']]]
      ['suite/test25' 'test25' %accept ~[['test25' '---------------------- MODULE test25 ----------------------\0a\0a(* test of fingerprinting elements of [S -> [B -> C]]  *)\0a\0aEXTENDS Naturals, Sequences, TLC\0a\0aCONSTANT S, T, s1, t1, c\0a\0aVARIABLES x, y, z, w\0a\0aInit ==  /\\ Print("Should find only one state", TRUE)\0a         /\\ x = [i \\in 1..3 |-> [j \\in {4,5} |-> i+j]]\0a         /\\ y = [a |-> <<"b", "c">>, b |-> <<"c", "d", "e">>]\0a         /\\ z = [i \\in S |-> [j \\in {2,3} |-> j+1]]\0a         /\\ w = [i \\in S |-> [j \\in T |-> c]]\0a\0aInv == TRUE\0a\0aNext == \0a  \\/ UNCHANGED <<x, y, z, w>>\0a\0a  \\/ /\\ x\' = << [j \\in {4,5} |-> 1+j], [j \\in {4,5} |-> 2+j], [j \\in {4,5} |-> 3+j]>>\0a     /\\ y\' = [i \\in {"a", "b"} |->\0a               IF i = "a" THEN [j \\in {1,2} |-> IF j = 1 THEN "b" ELSE "c"]\0a                          ELSE [<<"x", "d", "e">> EXCEPT ![1]= "c"]]\0a     /\\ z\' = [[z EXCEPT ![s1] = [@ EXCEPT ![3] = 77]] EXCEPT ![s1][3] = 4]\0a     /\\ w\' = [[w EXCEPT ![s1][t1] = s1] EXCEPT ![s1][t1] = c]\0a      \0a\0a===========================================================\0a']]]
      ['suite/test26' 'test26' %accept ~[['test26' '--------------- MODULE test26 -------------\0a\0a(* Test of LET *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0a\0aInit ==  x = 0\0a\0aFcnSubst(f, e(_)) ==\0a  (* A recursive definition of [i \\in DOMAIN f |-> e(i)] *)\0a  LET Range == {f[i] : i \\in DOMAIN f}\0a      FSet == UNION { [U -> Range] : U \\in SUBSET DOMAIN f}\0a      FSub[g \\in FSet] == \0a        IF g = << >> \0a          THEN g\0a          ELSE LET el == CHOOSE el \\in DOMAIN g : TRUE\0a               IN  [ i \\in DOMAIN g |-> \0a                     IF i = el \0a                      THEN e(i)\0a                      ELSE FSub[[j \\in (DOMAIN g) \\ {el} |-> f[j]]][i]]\0a  IN FSub[f]\0a\0a\0aInv == \0a\0a  /\\ LET A == {}\0a         B == A\0a     IN  IF B = {}\0a           THEN Print("Test 1 OK", TRUE)\0a           ELSE Assert(FALSE, "Test 1 Failed")\0a\0a  /\\ LET A == {}\0a         B == A\0a         C[i \\in B] == 17\0a     IN  IF C = << >> \0a           THEN Print("Test 2 OK", TRUE)\0a           ELSE Assert(FALSE, "Test 2 Failed")\0a\0a  /\\ LET e(i) == i+1\0a     IN  IF FcnSubst(<<1,2,3>>, e) = <<2,3,4>>\0a           THEN Print("Test 3 OK", TRUE)\0a           ELSE Assert(FALSE, "Test 3 Failed")\0a           \0aNext ==  UNCHANGED x\0a=========================================\0a']]]
      ['suite/test27' 'test27' %accept ~[['test27' '--------------------------- MODULE test27 ----------------------------------\0a(***************************************************************************)\0a(* A fingerprint test that models LazyCache.                               *)\0a(***************************************************************************)\0a\0aEXTENDS Naturals, Sequences, FiniteSets, TLC\0a\0aCONSTANT Addr,         (* A set                         *)\0a         Data,         (* A set                         *)\0a         InitData,     (* A subset of Data              *)\0a         ND,           (* A model value                 *)\0a         N,            (* The number of processors      *)\0a         InLen, OutLen (* Maximum lengths of in and out *)\0a\0aVARIABLE mem, c, in, out\0a\0aProc == 1..N\0a\0a\0aExp(a, m) ==\0a  (*************************************************************************)\0a  (* Recursive definition of a^n.                                          *)\0a  (*************************************************************************)\0a  LET E[n \\in Nat] == IF n = 0 THEN 1 ELSE a * E[n-1]\0a  IN  E[m]\0a\0aCountSeq(S, len) ==\0a  (*************************************************************************)\0a  (* Number of elements in Seq(S) of length \\leq len.                      *)\0a  (*************************************************************************)\0a  LET CS[n \\in Nat] == \0a        (*******************************************************************)\0a        (* Recursive definition of CountSeq(S, n).  There are              *)\0a        (* (Cardinality(S))^n sequences of length n.                       *)\0a        (*******************************************************************)\0a         IF n = 0 THEN 1\0a                  ELSE Exp(Cardinality(S), n) + CS[n-1]       \0a  IN  CS[len]\0a\0a\0aOp  ==  (Data \\X Addr) \\cup {<<d, a, "*">> : d \\in Data, a \\in Addr}\0a                            (***********************************************)\0a                            (* Have to write Data \\X Addr \\X {"*"}         *)\0a                            (* in this way.                                *)\0a                            (***********************************************)\0a                            \0aRestrict(f) == \0a    { g \\in  [Addr -> Data \\cup  { ND  }] :\0a                   \\A  a \\in  Addr: g[a] \\in  { f[a] , ND  } } \0a\0aInit == /\\ Print(LET D == Cardinality(Data)\0a                     A == Cardinality(Addr)\0a                     P == Cardinality(Proc)\0a                 IN <<"Number of distinct states =", \0a                        Exp(D, A)                    (* No. of values of mem *)\0a                      * Exp(D+1, P * A)              (* No. of values of c   *)\0a                      * Exp(CountSeq(Op, InLen), P)  (* No. of values of in  *)\0a                      * Exp(CountSeq(Data \\X Addr, OutLen), P) (* No. of values of out *)\0a                    >>, TRUE)\0a        /\\ mem \\in  [Addr -> InitData] \0a        /\\ c \\in  [Proc -> Restrict(mem)] \0a        /\\ in  = [i \\in  Proc |-> <<>>]    \0a        /\\ out = [i \\in  Proc |-> <<>>]                  \0a\0aInv ==\0a  /\\ IF mem \\in [Addr -> Data] \0a       THEN TRUE\0a       ELSE /\\ Print("Conj 1 False", TRUE)\0a            /\\ FALSE\0a  /\\ IF c   \\in [Proc -> [Addr -> (Data \\cup {ND})] ] \0a       THEN TRUE\0a       ELSE /\\ Print("Conj 2 False", TRUE)\0a            /\\ FALSE\0a  /\\ IF in  \\in [Proc -> Seq(Op)]\0a       THEN TRUE\0a       ELSE /\\ Print("Conj 3 False", TRUE)\0a            /\\ FALSE\0a  /\\ IF \\A p \\in Proc: Len(in[p]) \\leq InLen\0a       THEN TRUE\0a       ELSE /\\ Print("Conj 4 False", TRUE)\0a            /\\ FALSE\0a  /\\ IF out \\in [Proc -> Seq(Data \\X Addr)] \0a       THEN TRUE\0a       ELSE /\\ Print("Conj 5 False", TRUE)\0a            /\\ FALSE\0a  /\\ IF \\A p \\in Proc: Len(out[p]) \\leq OutLen\0a       THEN TRUE\0a       ELSE /\\ Print("Conj 6 False", TRUE)\0a            /\\ FALSE\0a\0aNext ==\0a  \\/ UNCHANGED <<mem, c, in, out>>\0a\0a  \\/ /\\ \\E a \\in Addr, d \\in Data : mem\' = [mem EXCEPT ![a] = d]\0a     /\\ UNCHANGED <<c, in, out>>\0a\0a  \\/ \\E p \\in Proc : \0a\0a        \\/ /\\ \\E a \\in Addr,  d \\in Data \\cup {ND} :\0a                  c\' = [c EXCEPT ![p][a] = d]\0a           /\\ UNCHANGED <<mem,  in, out>>\0a\0a        \\/ /\\ Len(out[p]) < OutLen\0a           /\\ \\E o \\in Data \\X Addr : out\' = [out EXCEPT ![p] = @ \\o <<o>>]\0a           /\\ UNCHANGED <<mem, c, in>>\0a\0a        \\/ /\\ Len(in[p]) < InLen\0a           /\\ \\E o \\in Op : in\' = [in EXCEPT ![p] = @ \\o <<o>>]\0a           /\\ UNCHANGED <<mem, c, out>>\0a\0a        \\/ /\\ out[p] # << >> \0a           /\\ out\' = [out EXCEPT ![p] = Tail(@)]\0a           /\\ UNCHANGED <<mem, c, in>>\0a\0a        \\/ /\\ in[p] # << >> \0a           /\\ in\' = [in EXCEPT ![p] = Tail(@)]\0a           /\\ UNCHANGED <<mem, c, out>>\0a\0a\0a\0a=============================================================================\0a']]]
      ['suite/test28' 'test28' %accept ~[['test28' '--------------- MODULE test28  -------------\0a\\* Some random test\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0a\0aBdedSeq(S, n) == UNION {[1..i -> S] : i \\in 0..n}\0a\0aInit == /\\ x = 2\0a        /\\ x > 1 \0a        /\\ Print("Test 1 OK", TRUE)\0a        /\\ 1..x = {1,2}\0a        /\\ Print("Test 2 OK", TRUE)\0a        /\\ {i + 1 : i \\in {x}} = {3}\0a        /\\ Print("Test 3 OK", TRUE)\0a        /\\ {i \\in {x} : i = 2} = {2}\0a        /\\ Print("Test 4 OK", TRUE)\0a        /\\ \\E i \\in {x} : i = 2\0a        /\\ Print("Test 5 OK", TRUE)\0a        /\\ \\E i \\in 1..x : i < x\0a        /\\ Print("Test 6 OK", TRUE)\0a        /\\ IF BdedSeq({x}, 2) # {<<>>, <<2>>, <<2,2>>}\0a             THEN Print("Failed Test 7", TRUE)\0a             ELSE Print("Test 7 OK", TRUE)\0a\0aNext == UNCHANGED x\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test29' 'test29' %accept ~[['test29' '--------------- MODULE test29  -------------\0a\0a\\* Testing proper evaluation of primed variables in action\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0a\0a\0aInit == x = 2\0a\0aNext == /\\ x\' = 2\0a        /\\ x\' > 1 \0a        /\\ Print("Test 1 OK", TRUE)\0a        /\\ 1..x\' = {1,2}\0a        /\\ Print("Test 2 OK", TRUE)\0a        /\\ {i + 1 : i \\in {x\'}} = {3}\0a        /\\ Print("Test 3 OK", TRUE)\0a        /\\ {i \\in {x\'} : i = 2} = {2}\0a        /\\ Print("Test 4 OK", TRUE)\0a        /\\ \\E i \\in {x\'} : i = 2\0a        /\\ Print("Test 5 OK", TRUE)\0a        /\\ \\E i \\in 1..x\' : i < x\'\0a        /\\ Print("Test 6 OK", TRUE)\0a\0a\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test3' 'test3' %accept ~[['test3' '--------------- MODULE test3 -------------\0a\0a(* Test of function application. *)\0a\0aEXTENDS Naturals, TLC\0a\0aVARIABLE x\0aCONSTANT a, b, c\0a\0aType == x \\in {1}\0aInv  == \0a /\\ TRUE\0a\0a /\\ IF [i \\in {3, 2, 1} |-> i+1][3] # 4\0a      THEN Assert(FALSE, "Test 1")\0a      ELSE Print("Test 1", TRUE)\0a\0a /\\ IF <<a, b, c>>[2] # b\0a      THEN Assert(FALSE, "Test 2")\0a      ELSE Print("Test 2", TRUE)\0a\0a /\\ IF [a |-> 1, b |-> 42, c |-> 99]["b"] # 42\0a      THEN Assert(FALSE, "Test 3" )\0a      ELSE Print("Test 3" , TRUE) \0a\0a /\\ IF [i \\in Nat |-> i+1][3] # 4\0a      THEN Assert(FALSE, "Test 4" )\0a      ELSE Print("Test 4" , TRUE) \0a\0a /\\ IF [[i \\in Nat |-> i+1] EXCEPT ![42] = 3, ![42] = 5][42] # 5\0a      THEN Assert(FALSE, "Test 5" )\0a      ELSE Print("Test 5" , TRUE) \0a\0a /\\ IF [[i \\in Nat |-> i+1] EXCEPT ![42] = 3, ![42] = 5][79] # 80\0a      THEN Assert(FALSE, "Test 6" )\0a      ELSE Print("Test 6" , TRUE) \0a\0a /\\ IF [i \\in Nat |-> [j \\in Nat |-> 2*i + j]][5][3] # 13\0a      THEN Assert(FALSE, "Test 7" )\0a      ELSE Print("Test 7" , TRUE) \0a\0a /\\ IF [[i \\in Nat |-> [j \\in Nat |-> 2*i + j]] EXCEPT ![5] = 11][5] # 11\0a      THEN Assert(FALSE, "Test 8" )\0a      ELSE Print("Test 8" , TRUE) \0a /\\ IF [[i \\in Nat |-> [j \\in Nat |-> 2*i + j]] EXCEPT ![5][3] = @+1][5][3] # 14\0a      THEN Assert(FALSE, "Test 9" )\0a      ELSE Print("Test 9" , TRUE) \0a\0a /\\ IF [[i \\in Nat |-> [j \\in Nat |-> 2*i + j]] \0a            EXCEPT ![5][4] = @+2, ![5][3] = @+1][5][3] # 14\0a      THEN Assert(FALSE, "Test 10" )\0a      ELSE Print("Test 10" , TRUE) \0a\0a /\\ IF [[i \\in Nat |-> [j \\in Nat |-> 2*i + j]] \0a            EXCEPT ![5][3] = @+1, ![5][4] = @+2][5][3] # 14\0a      THEN Assert(FALSE, "Test 11" )\0a      ELSE Print("Test 11" , TRUE) \0a\0a /\\ IF [[i \\in Nat |-> [j \\in Nat |-> 2*i + j]] \0a        EXCEPT ![5][3] = @+1, ![5][3] = @+2][5][3] # 16\0a      THEN Assert(FALSE, "Test 12" )\0a      ELSE Print("Test 12" , TRUE) \0a\0a /\\ IF [i \\in Nat, j \\in STRING |-> <<i+1, j>>][22, "b"] # <<23, "b">>\0a      THEN Assert(FALSE, "Test 13" )\0a      ELSE Print("Test 13" , TRUE) \0a\0a /\\ IF [i \\in Nat, j \\in STRING |-> <<i+1, j>>][<<22, "b">>] # <<23, "b">>\0a      THEN Assert(FALSE, "Test 14" )\0a      ELSE Print("Test 14" , TRUE) \0a\0a /\\ IF [[i \\in Nat, j \\in STRING |-> <<i+1, j>>] \0a        EXCEPT ![22, "c"] = 15] [22, "b"] # <<23, "b">>\0a      THEN Assert(FALSE, "Test 15" )\0a      ELSE Print("Test 15" , TRUE) \0a\0a /\\ IF [[i \\in Nat, j \\in STRING |-> <<i+1, j>>] \0a          EXCEPT ![22, "c"] = 15] [22, "c"] # 15\0a      THEN Assert(FALSE, "Test 16" )\0a      ELSE Print("Test 16" , TRUE) \0a\0a /\\ IF [[i \\in Nat, j \\in STRING |-> <<i+1, j>>] \0a        EXCEPT ![22, "c"] = 15] [<<22, "c">>] # 15\0a      THEN Assert(FALSE, "Test 17" )\0a      ELSE Print("Test 17" , TRUE) \0a\0a /\\ IF [[i \\in Nat, j \\in STRING |-> <<i+1, j>>] \0a          EXCEPT ![22, "c"] = 15, ![22, "d"] = 33] [22, "c"] # 15\0a      THEN Assert(FALSE, "Test 18" )\0a      ELSE Print("Test 18" , TRUE) \0a\0a /\\ IF [[i \\in Nat, j \\in STRING |-> <<i+1, j>>] \0a          EXCEPT ![22, "d"] = 33, ![22, "c"] = 15] [22, "c"] # 15\0a      THEN Assert(FALSE, "Test 19" )\0a      ELSE Print("Test 19" , TRUE) \0a\0a /\\ IF [[i \\in Nat, j \\in STRING |-> <<i+1, j>>] \0a          EXCEPT ![22, "d"] = 33, ![22, "d"] = 15] [22, "d"] # 15\0a      THEN Assert(FALSE, "Test 20" )\0a      ELSE Print("Test 20" , TRUE) \0a\0a /\\ IF [[i \\in Nat, j \\in STRING |-> <<i+1, j>>] \0a        EXCEPT ![22, "d"] = @[1]] [22, "d"] # 23\0a      THEN Assert(FALSE, "Test 21" )\0a      ELSE Print("Test 21" , TRUE) \0a\0a\0a /\\ IF [[i \\in Nat, j \\in Nat |-> <<i+1, j>>] \0a         EXCEPT ![22, 3] = @[1]] [22, 3] # 23\0a      THEN Assert(FALSE, "Test 22" )\0a      ELSE Print("Test 22" , TRUE) \0a\0a /\\ Print("Tests completed", TRUE)\0a\0a\0a /\\ Print("Tests completed", TRUE)\0a\0aInit == x = 1\0a\0aNext == UNCHANGED x\0a=========================================\0a']]]
      ['suite/test30-true' 'test30-true' %reject ~[['test30-true' '--------------- MODULE test31  -------------\0a\0a(* Test replacement of and by infix operators and overridden operators. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0a\0aCONSTANT P(_,_), _++_ , Plus(_, _), PLen(_)\0a\0aPlusPlus(a, b) == <<a, b>>\0a\0aPRep(a, b) == {a, b}\0a\0aMCSeq(a) = {a}\0a\0aMCCat(a, b) == a + b\0a\0aInit == /\\ x = 1\0a        /\\ IF P(2, x+3) = {2, 4}\0a             THEN Print("Test 1 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 1 Failed")\0a        /\\ IF (2++(x+3)) = <<2, 4>>\0a             THEN Print("Test 2 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 2 Failed")\0a        /\\ IF PLen(<<1, 2, 3>>) = 3\0a             THEN Print("Test 3 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 3 Failed")\0a        /\\ IF Plus(2, x+3) = 6\0a             THEN Print("Test 4 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 4 Failed")\0a        /\\ IF Seq(22) = {22}\0a             THEN Print("Test 5 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 5 Failed")\0a        /\\ IF 1 \\o 2 = 3                          (* Huh???? *)\0a             THEN Print("Test 6 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 6 Failed")\0a        /\\ LET a \\prec b == a < b\0a           IN  IF 1 \\prec 2\0a                 THEN Print("Test 7 OK", TRUE)\0a                 ELSE Assert(FALSE, "Test 7 Failed")\0a\0aNext == UNCHANGED x\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test30' 'test30' %accept ~[['test30' '--------------- MODULE test30  -------------\0a\0a(* Test replacement of and by infix operators and overridden operators. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0a\0aCONSTANT P(_,_), _++_ , Plus(_, _), PLen(_)\0a\0aPlusPlus(a, b) == <<a, b>>\0a\0aPRep(a, b) == {a, b}\0a\0aMCSeq(a) == {a}\0a\0aMCCat(a, b) == a + b\0a\0aInit == /\\ x = 1\0a        /\\ IF P(2, x+3) = {2, 4}\0a             THEN Print("Test 1 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 1 Failed")\0a        /\\ IF (2++(x+3)) = <<2, 4>>\0a             THEN Print("Test 2 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 2 Failed")\0a        /\\ IF PLen(<<1, 2, 3>>) = 3\0a             THEN Print("Test 3 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 3 Failed")\0a        /\\ IF Plus(2, x+3) = 6\0a             THEN Print("Test 4 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 4 Failed")\0a        /\\ IF Seq(22) = {22}\0a             THEN Print("Test 5 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 5 Failed")\0a        /\\ IF 1 \\o 2 = 3                          (* Huh???? *)\0a             THEN Print("Test 6 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 6 Failed")\0a        /\\ LET a \\prec b == a < b\0a           IN  IF 1 \\prec 2\0a                 THEN Print("Test 7 OK", TRUE)\0a                 ELSE Assert(FALSE, "Test 7 Failed")\0a\0aNext == UNCHANGED x\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test31' 'test31' %accept ~[['test31' '--------------- MODULE test31  -------------\0a\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aVARIABLE x, y\0a\0aInit == /\\ Print("This test should generate 3 distinct state", TRUE)\0a        /\\ x = 1\0a        /\\ y = 1\0a\0aNext == \\/ /\\ Print("1", TRUE)\0a           /\\ x\' \\in {1, 2, 3}\0a           /\\ y\' = 1\0a           /\\ Print(<<"Generated state", x\', y\'>>, TRUE)\0a\0a        \\/ UNCHANGED <<x, y>>\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test32' 'test32' %accept ~[['test32' '--------------- MODULE test32  -------------\0a\0a(* Test of [A]_e and <<A>>_e *)\0a\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aVARIABLE x, y\0a\0aInit == /\\ x = 1\0a        /\\ y = 1\0a\0aAct1 == /\\ x\' = 1\0a        /\\ y\' = 1\0a\0aNext == \\/ /\\ UNCHANGED <<x, y>>\0a           /\\ IF [x # x]_<<x,y>>\0a                THEN Print("Test1 OK", TRUE)\0a                ELSE Assert(FALSE, "Test 1 Failed") \0a           /\\ IF <<Act1>>_<<x,y>>\0a                THEN Assert(FALSE, "Test 2 Failed")\0a                ELSE Print("Test2 OK", TRUE)\0a\0a        \\/ /\\ <<x\'= 1 /\\ y\'=1>>_y\0a           /\\ Assert(FALSE, "Test 3 Failed")\0a\0a        \\/ /\\ Print("Test 4 started -- should finish", TRUE)\0a           /\\ [FALSE]_<<x,y>>\0a           /\\ Print("Test 4 completed" , TRUE)\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/test33' 'test33' %accept ~[['test33' '--------------- MODULE test33  -------------\0a\0a(* Test of large sets of functions *)\0a\0aEXTENDS TLC, Naturals\0a\0aVARIABLE x\0a\0aInit == /\\ Print(<<"Computing", 7^6, "States">>, TRUE)\0a        /\\ x \\in [1..6 -> 1..7]   \0a\0aNext == UNCHANGED x\0a\0aInv ==  TRUE\0a=========================================\0a\0aWorks for 7^6 = 117649 states on dix in     43.049u   3.729s  1:16.97 60.7%  \0a                                           (1529 states/sec)\0aWorks for 6^7 = 279936 states on dix in    113.333u  19.494s  3:37.24 61.1%\0a                                           (1289 states/sec)\0aworks for 7^7 = 823543 states on rowdy in  655.835u 158.050s 11:03.11 122.7%\0a                                           (1242 states/sec)\0aDoesn\'t work for 7^7 = 823543 states on dix\0a']]]
      ['suite/test34' 'test34' %accept ~[['test34' '--------------- MODULE test34  -------------\0a\0a(* Test Model Values *)\0a\0aEXTENDS TLC, Naturals, Sequences, FiniteSets\0a\0aCONSTANTS a, b, c\0a\0aVARIABLE x\0a\0aInit == x = 1\0a\0aNext == UNCHANGED x\0a\0aInv ==  /\\ IF a \\in STRING THEN Assert(FALSE, "Test 1 failed")\0a                           ELSE Print("Test 1 OK", TRUE)\0a        /\\ IF a = {1, 2}   THEN Assert(FALSE, "Test 2 failed")\0a                           ELSE Print("Test 2 OK", TRUE)\0a        /\\ IF a \\in {i \\in Nat : i > 7} \0a             THEN Assert(FALSE, "Test 3 failed")\0a             ELSE Print("Test 3 OK", TRUE)\0a        /\\ IF a \\in {b, c} THEN Assert(FALSE, "Test 4 failed")\0a                           ELSE Print("Test 4 OK", TRUE)\0a\0a=========================================\0a']]]
      ['suite/test35' 'test35' %accept ~[['test35' '------------------------------ MODULE test35 -----------------------------\0a(* Test of standard Sequences module.    *)\0a\0aEXTENDS Sequences, Integers, TLC\0a\0aVARIABLES x\0a\0aInit == x = 0\0a\0aNext == UNCHANGED x\0a\0aInv == \0a       /\\ IF  <<1, 2, 3>> \\in Seq(Nat)\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed")\0a\0a       /\\ IF  <<1, -2, 3>> \\notin Seq(Nat)\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed")        \0a\0a       /\\ IF <<1, 2, 3>> \\o <<4, 5>> = <<1, 2, 3, 4, 5>>\0a            THEN Print("Test 3 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")\0a\0a       /\\ IF << >> \\o << >> = << >>\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4 Failed")\0a\0a       /\\ IF << >> \\o <<1, 2 >> = <<1, 2 >>\0a            THEN Print("Test 5 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 5 Failed")\0a\0a       /\\ IF Len(<< >>) = 0\0a            THEN Print("Test 6 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 6 Failed")\0a\0a       /\\ IF Len(<<1, 2, 3>>) = 3\0a            THEN Print("Test 7 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 7 Failed")\0a\0a       /\\ IF Append(<<1, 2, 3>>, 4) = <<1, 2, 3, 4>>\0a            THEN Print("Test 8 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 8 Failed")\0a\0a       /\\ IF Append(<< >>, "a") = <<"a">>\0a            THEN Print("Test 9 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 9 Failed")\0a\0a       /\\ IF Head(<< 1 >>) = 1\0a            THEN Print("Test 10 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 10 Failed")\0a\0a       /\\ IF Head(<<1, 2, 3>>) = 1\0a            THEN Print("Test 11 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 11 Failed")\0a\0a       /\\ IF Tail(<<1>>) = << >>\0a            THEN Print("Test 12 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 12 Failed")\0a\0a       /\\ IF Tail (<<1, 2, 3>>) = <<2, 3>>\0a            THEN Print("Test 13 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 13 Failed")\0a\0a(*       /\\ IF SubSeq(<<1, 2, 3, 4, 5>>, 2, 4) = <<2, 3, 4>>\0a            THEN Print("Test 14 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 14 Failed")  \0a\0a       /\\ IF SubSeq(<<1, 2, 3, 4, 5>>, 1, 1) = <<1>>\0a            THEN Print("Test 15 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 15 Failed")   *)\0a\0a       /\\ IF SubSeq(<<1, 2, 3, 4, 5>>, 2, 1) = <<>>\0a            THEN Print("Test 16 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 16 Failed")\0a\0a(*       /\\ IF SubSeq(<<1, 2, 3, 4, 5>>, 5, 5) = <<5>>\0a            THEN Print("Test 17 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 17 Failed")   *)\0a\0a       /\\ IF LET T(a) == a \\in Nat\0a             IN  SelectSeq(<<-1, 2, -3, 4, -5, 6>>, T) = <<2, 4, 6>>\0a            THEN Print("Test 18 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 18 Failed")\0a\0a       /\\ IF LET T(a) == a \\in Nat\0a             IN  SelectSeq(<<0, -1, 2, -3, 4, -5>>, T) = <<0, 2, 4>>\0a            THEN Print("Test 19 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 19 Failed")\0a\0a       /\\ IF LET T(a) == a \\in Nat\0a             IN  SelectSeq(<<-1, -3, -5>>, T) = << >>\0a            THEN Print("Test 20 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 20 Failed")\0a\0a=============================================================================\0a']]]
      ['suite/test36' 'test36' %accept ~[['test36' '----------------------------- MODULE test36 --------------------------------\0a\0a(* Test of standard Bags module *)\0a\0aEXTENDS Naturals, TLC, Sequences, FiniteSets, Bags\0a\0aBag1 == SetToBag({"a", "b"})\0aBag2 == Bag1 (+) SetToBag({"a"})\0a\0aVARIABLES x\0aInit == x = 0\0aNext == x\'=x\0a\0aInv ==\0a       /\\ IF IsABag( Bag1 )\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed")\0a\0a       /\\ IF BagToSet(Bag2) = {"a", "b"}\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed")\0a\0a       /\\ IF BagIn("a", Bag2)\0a            THEN Print("Test 3 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")\0a\0a       /\\ IF ~BagIn("c", Bag2)\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4 Failed")\0a\0a       /\\ IF BagToSet(EmptyBag) = {}\0a            THEN Print("Test 5 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 5 Failed")\0a\0a       /\\ IF EmptyBag (+) Bag2 = Bag2\0a            THEN Print("Test 6 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 6 Failed")\0a\0a       /\\ IF Bag2 (-) SetToBag({"a"}) = Bag1\0a            THEN Print("Test 7 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 7 Failed")             \0a\0a       /\\ IF Bag1 (-) SetToBag({"a"}) = SetToBag({"b"})\0a            THEN Print("Test 8 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 8 Failed")            \0a\0a       /\\ IF BagUnion({Bag1, Bag2}) = Bag1 (+) Bag2\0a            THEN Print("Test 9 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 9 Failed")         \0a\0a       /\\ IF Bag1 \\sqsubseteq Bag2\0a            THEN Print("Test 10 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 10 Failed")   \0a\0a       /\\ Print("TLC Fails Tests 11 & 12 because SubBag not implemented", TRUE)\0a(*       /\\ IF Bag1 \\in SubBag(Bag2)\0a            THEN Print("Test 11 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 11 Failed")\0a\0a       /\\ IF Cardinality(SubBag(Bag2)) = 6\0a            THEN Print("Test 12 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 12 Failed")  *)\0a\0a       /\\ IF LET f(a) == <<"c", a>>\0a             IN  CopiesIn(<<"c", "a">>, BagOfAll(f, Bag2)) = 2\0a            THEN Print("Test 13 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 13 Failed")  \0a\0a       /\\ IF BagCardinality(Bag2) = 3\0a            THEN Print("Test 14 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 14 Failed")\0a\0a       /\\ IF CopiesIn("a", Bag2) = 2\0a            THEN Print("Test 15 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 15 Failed")\0a\0a       /\\ IF CopiesIn("c", Bag2) = 0\0a            THEN Print("Test 16 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 16 Failed")\0a\0a\0a\0a=============================================================================\0a\0a(* Last modified on Thu Aug 08 13:28:29 PT 2002 by lamport *)\0a\0a 6 Apr 99 : Modified version for standard module set\0a 7 Dec 98 : Corrected error found by Stephan Merz.\0a 6 Dec 98 : Modified comments based on suggestions by Lyle Ramshaw.\0a 5 Dec 98 : Initial version.']]]
      ['suite/test37' 'test37' %accept ~[['test37' '---------------------------- MODULE test37 -----------------------------\0a\0a(* Test of standard FiniteSets module *)\0a\0aEXTENDS FiniteSets, TLC\0a\0aVARIABLES x\0a\0aInit == x = 0\0aNext == x\'=x\0aInv  ==\0a       /\\ IF IsFiniteSet({"a", "b"})\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed")\0a\0a       /\\ IF IsFiniteSet({})\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed")\0a\0a       /\\ IF Cardinality({}) = 0\0a            THEN Print("Test 3 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")\0a\0a       /\\ IF Cardinality({"a", "b"}) = 2\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4 Failed")\0a\0a\0a=============================================================================\0a']]]
      ['suite/test38' 'test38' %accept ~[['test38' '---------------------------- MODULE test38 -----------------------------\0a\0a(* Test of EXTENDS *)\0a\0aEXTENDS test38a, TLC\0a\0aVARIABLES x\0a\\* CONSTANT c\0a\0aInit == MInit(x)\0aNext == x\'=c\0aInv  == IF (x=c) THEN Print("Test OK", TRUE)\0a                 ELSE Print("Test Failed", TRUE)\0a\0a\0a=============================================================================\0a'] ['test38a' '---------------------------- MODULE test38a -----------------------------\0a\0a(* Test of EXTENDS *)\0a\0a\\* VARIABLES x    multiple declarations no longer allowed.\0a CONSTANT c\0a\0aMInit(x) == x = c\0a\0a=============================================================================\0a']]]
      ['suite/test38a' 'test38a' %accept ~[['test38a' '---------------------------- MODULE test38a -----------------------------\0a\0a(* Test of EXTENDS *)\0a\0a\\* VARIABLES x    multiple declarations no longer allowed.\0a CONSTANT c\0a\0aMInit(x) == x = c\0a\0a=============================================================================\0a']]]
      ['suite/test39' 'test39' %accept ~[['test39' '--------------- MODULE test39 -------------\0a\0a(* Test priming and operator arguments *)\0a\0aEXTENDS TLC, Integers, Sequences, FiniteSets\0a\0aVARIABLE x, y\0a\0aInit == /\\ x = [i \\in {1,2} |-> i]\0a        /\\ y = 1\0a\0aAction1(c,d) == c\' = [c EXCEPT ![1] = d\']\0aAction2(c,d) == c\' = [c EXCEPT ![1] = d]\0a\0a\0aNext ==  \\/ /\\ y = 1\0a            /\\ y\' = 2\0a            /\\ Action1(x, y)\0a            /\\ IF x[1]\' = 2\0a                 THEN Print("Test1 OK", TRUE)\0a                 ELSE Assert(FALSE, "Test1 Failed") \0a\0a         \\/ /\\ y = 1\0a            /\\ y\' = 2\0a            /\\ Action2(x, y)\0a            /\\ IF x[1]\' = 1\0a                 THEN Print("Test2 OK", TRUE)\0a                 ELSE Assert(FALSE, "Test2 Failed")\0a\0a         \\/ UNCHANGED <<x, y>>\0a\0aInv ==  TRUE\0a         \0a\0aConstraint == TRUE\0a=========================================\0a']]]
      ['suite/test4' 'test4' %accept ~[['test4' '--------------- MODULE test4 -------------\0a\0a(* Test of fingerprinting of sets. *)\0a\0aEXTENDS Naturals, TLC, Sequences\0a\0aVARIABLE x, y, z, w\0a\0aType == \0a  /\\ x \\in {{1, 2, 3}}\0a  /\\ y \\in {{"a", "b", "c"}}\0a  /\\ z \\in {[a : {1, 2, 3}, b : {1, 2, 3}, c : {1, 2, 3}]}\0a  /\\ w \\in {[{1, 2, 3} -> {1, 2, 3}]}\0a\0a\0aInit == \0a  /\\ Print("Should find only one distinct state", TRUE)\0a  /\\ x = {1, 2, 3}\0a  /\\ y = {"a", "b", "c"}\0a  /\\ z = [a : {1, 2, 3}, b : {1, 2, 3}, c : {1, 2, 3}]\0a  /\\ w = [{1, 2, 3} -> {1, 2, 3}]\0a\0aInv  == \0a  /\\ TRUE\0a  /\\ x = {1, 2, 3}\0a  /\\ y = {"a", "b", "c"}\0a  /\\ z = [a : {1, 2, 3}, b : {1, 2, 3}, c : {1, 2, 3}]\0a  /\\ w = [{1, 2, 3} -> {1, 2, 3}]\0a\0a\0aNext ==\0a  \\/ /\\ x\' = {3, 3, 2, 1}\0a     /\\ UNCHANGED <<y, z, w>>\0a     /\\ Print("Test 1", TRUE)\0a\0a  \\/ /\\ x\' = 1..3\0a     /\\ UNCHANGED <<y, z, w>>\0a     /\\ Print("Test 2", TRUE)\0a\0a  \\/ /\\ x\' = {i \\in {5, 4, 3, 3, 2, 2, 1} : i \\leq 3}\0a     /\\ UNCHANGED <<y, z, w>>\0a     /\\ Print("Test 2", TRUE)\0a\0a  \\/ /\\ x\' = {i-3 : i \\in 4..6}\0a     /\\ UNCHANGED <<y, z, w>>\0a     /\\ Print("Test 2", TRUE)\0a\0a  \\/ /\\ x\' = {i-3 : i \\in {6, 6, 5, 4, 4, 5, 5}}\0a     /\\ UNCHANGED <<y, z, w>>\0a     /\\ Print("Test 2", TRUE)\0a\0a  \\/ /\\ x\' = { f[i] : i \\in 1..3, f \\in [{1,2,3} -> {1,2,3}] }\0a     /\\ UNCHANGED <<y, z, w>>\0a     /\\ Print("Test 3", TRUE)\0a\0a  \\/ /\\ y\' = DOMAIN [a |-> 1, b |-> 2, c |-> 3]\0a     /\\ UNCHANGED <<x, z, w>>\0a     /\\ Print("Test 4", TRUE)\0a  \\/ /\\ z\' = [{"a", "b", "c"} -> {1, 2, 3}]\0a     /\\ UNCHANGED <<y, x, w>>\0a     /\\ Print("Test 5", TRUE)\0a\0a  \\/ /\\ w\' = [{3,1, 2} -> {1, 3, 2}]\0a     /\\ UNCHANGED <<y, x, z>>\0a     /\\ Print("Test 6", TRUE)\0a\0a  \\/ /\\ w\' = [{3,1, 3, 3, 3, 2} -> {2, 2, 1, 3, 2}]\0a     /\\ UNCHANGED <<y, x, z>>\0a     /\\ Print("Test 6", TRUE)\0a\0a\0a============================================\0a']]]
      ['suite/test40' 'test40' %accept ~[['test40' '------------------------------ MODULE test40 -----------------------------\0a(* Test of standard Naturals module.    *)\0a\0aEXTENDS Naturals, TLC\0a\0aVARIABLES x\0a\0aInit == x = 0\0a\0aNext == UNCHANGED x\0a\0aInv == \0a       /\\ IF  2^10 + 2^10 = 2^11\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed")    \0a\0a       /\\ IF 0^20 = 0\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed")    \0a\0a       /\\ IF 2^21 - 2^20 = 2^20\0a            THEN Print("Test 2a OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2a Failed") \0a\0a       /\\ IF 2 - 3 \\notin Nat\0a            THEN Print("Test 3 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")\0a\0a       /\\ IF 123 * 345 = 42435\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4 Failed")\0a\0a       /\\ IF 123 < 124\0a            THEN Print("Test 5 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 5 Failed")\0a\0a       /\\ IF 12345 > 12344\0a            THEN Print("Test 6 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 6 Failed")\0a\0a       /\\ IF 123 \\leq 123\0a            THEN Print("Test 7 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 7 Failed")\0a\0a       /\\ IF 12345 \\geq 12345\0a            THEN Print("Test 8 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 8 Failed")\0a\0a       /\\ IF 123 \\leq 124\0a            THEN Print("Test 9 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 9 Failed")\0a\0a       /\\ IF 12344 \\geq 12333\0a            THEN Print("Test 10 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 10 Failed")\0a\0a       /\\ IF 145939 = 487 * (145939 \\div 487) + (145939 % 487) \0a            THEN Print("Test 11 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 11 Failed")  \0a\0a       /\\ IF 139982 \\div 1 = 139982 \0a            THEN Print("Test 12 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 12 Failed")\0a\0a       /\\ IF 123099 % 1 = 0\0a            THEN Print("Test 13 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 13 Failed")\0a\0a       /\\ IF 0 % 345 = 0\0a            THEN Print("Test 14 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 14 Failed")  \0a\0a       /\\ IF 24 % 9 = 6\0a            THEN Print("Test 15 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 15 Failed")   \0a\0a       /\\ IF 4566799 = 423 * (4566799 \\div 423) + (4566799 % 423)\0a            THEN Print("Test 16 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 16 Failed")    \0a\0a       /\\ IF 2222222 = 18 * (2222222 \\div 18) + (2222222 % 18)\0a            THEN Print("Test 17 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 17 Failed")   \0a\0a       /\\ IF 3 .. 2 = {}\0a            THEN Print("Test 18 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 18 Failed")\0a\0a       /\\ IF 2..4 = {2, 3, 4}\0a            THEN Print("Test 19 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 19 Failed")\0a\0a       /\\ IF (0-1) * (0-3) = 3\0a            THEN Print("Test 20 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 20 Failed")\0a\0a       /\\ IF (0-1) % 3 = 2\0a            THEN Print("Test 21 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 21 Failed")\0a\0a=============================================================================\0a']]]
      ['suite/test41' 'test41' %accept ~[['test41' '------------------------------ MODULE test41 -----------------------------\0a(* Test of standard Integers module.    *)\0a\0aEXTENDS Integers, TLC\0a\0aVARIABLES x\0a\0aInit == x = 0\0a\0aNext == UNCHANGED x\0a\0aInv == \0a       /\\ IF  2^10 + 2^10 = 2^11\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed")    \0a\0a       /\\ IF 0^20 = 0\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed")   \0a\0a       /\\ IF 2 - 3 \\in Int\0a            THEN Print("Test 3 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")\0a\0a       /\\ IF (-123) * (-345) = 42435\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4 Failed")\0a\0a       /\\ IF -123 > -124\0a            THEN Print("Test 5 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 5 Failed")\0a\0a       /\\ IF -12345 < -12344\0a            THEN Print("Test 6 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 6 Failed")\0a\0a       /\\ IF -123 \\leq -123\0a            THEN Print("Test 7 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 7 Failed")\0a\0a       /\\ IF -12345 \\geq -12345\0a            THEN Print("Test 8 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 8 Failed")\0a\0a       /\\ IF -123 \\geq -124\0a            THEN Print("Test 9 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 9 Failed")\0a\0a       /\\ IF -12344 \\leq 12333\0a            THEN Print("Test 10 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 10 Failed")\0a\0a       /\\ IF -145939 = 487 * ((-145939) \\div 487) + ((-145939) % 487) \0a            THEN Print("Test 11 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 11 Failed")    \0a\0a       /\\ IF -139982 \\div 1 = -139982 \0a            THEN Print("Test 12 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 12 Failed")\0a\0a       /\\ IF -123099 % 1 = 0\0a            THEN Print("Test 13 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 13 Failed")\0a\0a       /\\ IF (-1) % 345 = 344\0a            THEN Print("Test 14 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 14 Failed")  \0a\0a       /\\ IF (-24) % 9 = 3\0a            THEN Print("Test 15 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 15 Failed")   \0a\0a       /\\ IF -4566799 = 423 * ((-4566799) \\div 423) + ((-4566799) % 423)\0a            THEN Print("Test 16 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 16 Failed")    \0a\0a       /\\ IF -2222222 = 18 * ((-2222222) \\div 18) + (-2222222 % 18)\0a            THEN Print("Test 17 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 17 Failed")   \0a\0a       /\\ IF (-2) .. (-3) = {}\0a            THEN Print("Test 18 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 18 Failed")\0a\0a       /\\ IF (-4)..(-2) = {-2, -3, -4}\0a            THEN Print("Test 19 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 19 Failed")\0a\0a       /\\ IF 2*3+4 = 10\0a            THEN Print("Test 20 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 20 Failed")\0a\0a       /\\ IF 2^3*3 = 24\0a            THEN Print("Test 21 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 21 Failed")\0a\0a\0a       /\\ IF 4+2*3 = 10\0a            THEN Print("Test 22 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 22 Failed") \0a\0a\0a       /\\ IF 3*2^3 = 24\0a            THEN Print("Test 23 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 23 Failed")\0a\0a\0a       /\\ IF 1 + -2 = -1\0a            THEN Print("Test 24 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 24 Failed")\0a\0a\0a       /\\ IF 5 + 5 \\div 2 = 7\0a            THEN Print("Test 25 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 25 Failed")\0a\0a       /\\ IF  5 \\div 2 + 2 = 4\0a            THEN Print("Test 26 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 26 Failed") \0a\0a       /\\ IF 3 - 2 * 5 = -7\0a            THEN Print("Test 27 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 27 Failed")\0a\0a       /\\ IF 4 * 2 % 3 = 2\0a            THEN Print("Test 28 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 28 Failed")\0a\0a\0a=============================================================================\0a']]]
      ['suite/test42' 'test42' %accept ~[['test42' '--------------- MODULE test42 -------------\0a\0a(* Test of operator arguments  *)\0a\0aEXTENDS TLC, Integers, Sequences\0a\0aVARIABLE x\0a\0aa ++ b == a + b\0a\0aFoo(a, _--_) == a -- 0\0a\0a\0aInit == x = 1\0a\0a\0aNext ==  x\' = x\0a         \0aFooBar(a, Op(_,_)) == Op(a, 0)\0a\0aPlus(a, b) == a + b\0a\0aInv ==  /\\ IF FooBar(7, Plus) = 7\0a             THEN Print("Test 1 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 1 Failed")  \0a\0a        /\\ IF FooBar(7,+) = 7 \0a             THEN Print("Test 2 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 2 Failed")  \0a\0a        /\\ IF Foo(7, *) = 0 \0a             THEN Print("Test 3 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 3 Failed")  \0a\0a        /\\ IF Foo(7,+) = 7 \0a             THEN Print("Test 4 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 4 Failed")  \0a\0a        /\\ IF Foo(7,++) = 7 \0a             THEN Print("Test 5 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 5 Failed")  \0a\0aConstraint == TRUE\0a=========================================\0a']]]
      ['suite/test43' 'test43' %accept ~[['test43' '--------------- MODULE test43  -------------\0a\0a(* Test of TLC module *)\0a\0aEXTENDS TLC, Integers, Sequences\0a\0aVARIABLE x\0a\0aFApply(f, Op(_,_), Identity) ==\0a  LET fa[S \\in SUBSET DOMAIN f] ==\0a        IF S = { } THEN Identity\0a                   ELSE LET s == CHOOSE s \\in S : TRUE\0a                        IN  Op(f[s], fa[S \\ {s}])\0a                            \0a  IN  fa[DOMAIN f]\0a\0aBoundedSeq(S, n) == UNION {[1..i -> S] : i \\in 0..n}\0aPlus(a, b) == a + b\0a\0aTimes(a, b) == a * b\0a\0aInit == x = 1\0a\0aNext ==  x\' = x\0a\0aInv ==  \0a\0a        /\\ IF FApply([i \\in {"a", "b", "c"} |-> 3], Times, 1) = 27\0a             THEN Print("Test 1 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 1 Failed")\0a\0a        /\\ IF FApply(<<3, 4, 5, 6>> , Plus, 0) = 18\0a             THEN Print("Test 2 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 2 Failed")\0a        \0a        /\\ IF FApply(<<3>> , Plus, 0) = 3\0a             THEN Print("Test 3 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 3 Failed")\0a        \0a        /\\ IF FApply(<<>> , Plus, 7) = 7\0a             THEN Print("Test 4 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 4 Failed")  \0a\0a        /\\ IF <<1, 2>> \\in BoundedSeq(1..3, 3)\0a             THEN Print("Test 5 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 5 Failed")\0a\0a        /\\ IF <<1, 2, 3>> \\notin BoundedSeq(1..3, 2)\0a             THEN Print("Test 6 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 6 Failed")         \0a\0a        /\\ IF <<-1, 2>> \\notin BoundedSeq(1..4, 6)\0a             THEN Print("Test 7 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 7 Failed")\0a\0a        /\\ IF << >> \\in BoundedSeq({"a", "b"}, 2)\0a             THEN Print("Test 8 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 8 Failed")\0a\0a        /\\ IF \\A s \\in BoundedSeq({"a", "b", "c"}, 2) :\0a                Len(s) \\leq 2\0a             THEN Print("Test 9 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 10 Failed")\0a\0a        /\\ IF SortSeq(<<3, 2, 4, 2>>, \\leq) = <<2, 2, 3, 4>>\0a             THEN Print("Test 10 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 12 Failed")\0a\0a        /\\ IF SortSeq(<<3, 2, 4, 2>>, <) = <<2, 2, 3, 4>>\0a             THEN Print("Test 11 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 13 Failed")\0a\0a        /\\ IF SortSeq(<<>>, >) = <<>>\0a             THEN Print("Test 12 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 14 Failed")\0a\0a        /\\ IF SortSeq(<<1>>, >) = <<1>>\0a             THEN Print("Test 13 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 15 Failed")\0a\0a\0aConstraint == TRUE\0a=========================================\0a']]]
      ['suite/test44' 'test44' %accept ~[['test44' '--------------- MODULE test44  -------------\0a\0a(* Test of operator precedence and associativity . *)\0a\0aEXTENDS TLC, Integers, Sequences\0a\0aVARIABLE x\0a\0aInit == x = 1\0a\0a\0aNext ==  x\' = x\0a         \0a\0aa | b == <<a, b>>\0aa || b == <<a, b>>\0aa & b == <<a, b>>\0aa && b == <<a, b>>\0aa $ b == <<a, b>>\0aa $$ b == <<a, b>>\0aa ?? b == <<a, b>>\0aa %% b == <<a, b>>\0aa ## b == <<a, b>>\0aa ++ b == <<a, b>>\0aa -- b == <<a, b>>\0aa ** b == <<a, b>>\0aa (+) b == <<a, b>>\0aa (-) b == <<a, b>>\0aa (.) b == <<a, b>>\0a\0aa (\\X) b == <<a, b>>         \0a\0a\\* a \\otimes b == <<a, b>> \0aa \\uplus b == <<a, b>>\0aa \\sqcap b == <<a, b>>\0aa \\sqcup b == <<a, b>>\0aa \\star b == <<a, b>>\0aa \\bigcirc b == <<a, b>>\0aa \\bullet b == <<a, b>>\0a\0aa ... b == <<a, b>>\0aa // b == <<a, b>>\0aa ^^ b == <<a, b>>\0aa !! b == <<a, b>>\0aa |- b == <<a, b>>\0aa |= b == <<a, b>>\0aa -| b == <<a, b>>\0aa =| b == <<a, b>>\0a\0aa <: b == <<a, b>> \0a\0a\0aa := b == <<a, b>>\0aa ::= b == <<a, b>>\0aa (/) b == <<a, b>>\0a\\* a \\oslash b == <<a, b>> \0aa \\wr b == <<a, b>>\0aa \\prec b == <<a, b>>\0aa \\succ b == <<a, b>>\0aa \\preceq b == <<a, b>>\0aa \\succeq b == <<a, b>>\0aa \\sim b == <<a, b>>\0aa \\simeq b == <<a, b>>\0aa \\ll b == <<a, b>>\0aa \\gg b == <<a, b>>\0aa \\asymp b == <<a, b>>\0aa \\subset b == <<a, b>>\0aa \\supset b == <<a, b>>\0aa \\supseteq b == <<a, b>>\0aa \\approx b == <<a, b>>\0aa \\cong b == <<a, b>>\0aa \\sqsubset b == <<a, b>>\0aa \\sqsupset b == <<a, b>>\0aa \\sqsubseteq b == <<a, b>>\0aa \\sqsupseteq b == <<a, b>>\0aa \\doteq b == <<a, b>>\0aa \\propto b == <<a, b>>\0a\0a\0aInv ==\0a        /\\ IF (3 - 2 - 1) = 0\0a             THEN Print("Test 1 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 1 Failed")\0a\0a        /\\ IF 1 | 2 | 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 2 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 2 Failed")\0a\0a        /\\ IF 1 || 2 || 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 3 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 3 Failed")\0a\0a        /\\ IF 1 & 2 & 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 4 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 4 Failed")\0a\0a        /\\ IF 1 && 2 && 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 5 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 5 Failed")\0a\0a        /\\ IF 1 $ 2 $ 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 6 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 6 Failed")\0a\0a        /\\ IF 1 $$ 2 $$ 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 7 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 7 Failed")\0a\0a        /\\ IF 1 ?? 2 ?? 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 8 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 8 Failed")\0a\0a        /\\ IF TRUE\0a             THEN Print("Test 9 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 9 Failed")\0a\0a        /\\ IF 1 %% 2 %% 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 10 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 10 Failed")\0a\0a        /\\ IF 1 ## 2 ## 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 11 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 11 Failed")\0a\0a        /\\ IF 1 ++ 2 ++ 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 12 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 12 Failed")\0a\0a        /\\ IF 1 -- 2 -- 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 13 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 13 Failed")\0a\0a        /\\ IF 1 ** 2 ** 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 14 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 14 Failed")\0a\0a        /\\ IF 1 (+) 2 (+) 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 15 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 15 Failed") \0a\0a        /\\ IF 1 (-) 2 (-) 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 16 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 16 Failed") \0a\0a        /\\ IF 1 (.) 2 (.) 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 17 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 17 Failed") \0a\0a        /\\ IF 1 (\\X) 2 (\\X) 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 18 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 18 Failed")\0a\0a        /\\ IF 1 \\oplus 2 \\oplus 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 19 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 19 Failed")\0a\0a        /\\ IF 1 \\ominus 2 \\ominus 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 20 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 20 Failed")\0a\0a        /\\ IF 1 \\odot 2 \\odot 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 21 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 21 Failed")\0a\0a        /\\ IF 1 \\otimes 2 \\otimes 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 22 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 22 Failed")\0a\0a        /\\ IF 1 \\uplus 2 \\uplus 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 23 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 23 Failed")\0a\0a\0a        /\\ IF 1 \\sqcap 2 \\sqcap 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 24 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 24 Failed")\0a\0a        /\\ IF 1 \\sqcup 2 \\sqcup 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 25 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 25 Failed")\0a\0a        /\\ IF 1 \\star 2 \\star 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 26 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 26 Failed")\0a\0a        /\\ IF <<1>> \\o <<2>> \\o <<3>> = <<1, 2, 3>>\0a             THEN Print("Test 27 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 27 Failed")\0a\0a        /\\ IF 1 \\bigcirc 2 \\bigcirc 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 28 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 28 Failed")\0a\0a        /\\ IF 1 \\bullet 2 \\bullet 3 = <<<<1, 2>>, 3>>\0a             THEN Print("Test 29 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 29 Failed")\0a\0a        /\\ IF 1 ... 2 = <<1, 2>>\0a             THEN Print("Test 30 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 30 Failed")\0a\0a        /\\ IF 1 // 2 = <<1, 2>>\0a             THEN Print("Test 31 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 31 Failed")\0a\0a        /\\ IF 1 ^^ 2 = <<1, 2>>\0a             THEN Print("Test 32 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 32 Failed")\0a\0a        /\\ IF 1 !! 2 = <<1, 2>>\0a             THEN Print("Test 33 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 33 Failed")\0a\0a        /\\ IF (1 |- 2) = <<1, 2>>\0a             THEN Print("Test 34 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 34 Failed")\0a\0a        /\\ IF (1 |= 2) = <<1, 2>>\0a             THEN Print("Test 35 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 35 Failed")\0a\0a        /\\ IF (1 -| 2) = <<1, 2>>\0a             THEN Print("Test 36 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 36 Failed")\0a\0a        /\\ IF (1 =| 2) = <<1, 2>>\0a             THEN Print("Test 37 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 37 Failed")\0a\0a        /\\ IF 1 <: 2 = <<1, 2>>\0a             THEN Print("Test 38 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 38 Failed")\0a\0a        /\\ IF TRUE\0a             THEN Print("Test 39 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 39 Failed")\0a\0a        /\\ IF (1 := 2) = <<1, 2>>\0a             THEN Print("Test 40 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 40 Failed")\0a\0a        /\\ IF (1 ::= 2) = <<1, 2>>\0a             THEN Print("Test 41 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 41 Failed")\0a\0a        /\\ IF 1 (/) 2 = <<1, 2>>\0a             THEN Print("Test 42 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 42 Failed") \0a\0a        /\\ IF 1 \\oslash 2 = <<1, 2>> \0a             THEN Print("Test 43 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 43 Failed")\0a\0a        /\\ IF 1 \\wr 2 = <<1, 2>>\0a             THEN Print("Test 44 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 44 Failed")\0a\0a        /\\ IF (1 \\prec 2) = <<1, 2>>\0a             THEN Print("Test 45 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 45 Failed")\0a\0a        /\\ IF (1 \\succ 2) = <<1, 2>>\0a             THEN Print("Test 46 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 46 Failed")\0a\0a        /\\ IF (1 \\preceq 2) = <<1, 2>>\0a             THEN Print("Test 47 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 47 Failed")\0a\0a        /\\ IF (1 \\succeq 2) = <<1, 2>>\0a             THEN Print("Test 48 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 48 Failed")\0a\0a        /\\ IF (1 \\sim 2) = <<1, 2>>\0a             THEN Print("Test 49 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 49 Failed")\0a\0a        /\\ IF (1 \\simeq 2) = <<1, 2>>\0a             THEN Print("Test 50 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 50 Failed")\0a\0a        /\\ IF (1 \\ll 2) = <<1, 2>>\0a             THEN Print("Test 51 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 51 Failed")\0a\0a        /\\ IF (1 \\gg 2) = <<1, 2>>\0a             THEN Print("Test 52 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 52 Failed")\0a\0a        /\\ IF (1 \\asymp 2) = <<1, 2>>\0a             THEN Print("Test 53 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 53 Failed")\0a\0a        /\\ IF (1 \\subset 2) = <<1, 2>>\0a             THEN Print("Test 54 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 54 Failed")\0a\0a        /\\ IF (1 \\supset 2) = <<1, 2>>\0a             THEN Print("Test 55 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 55 Failed")\0a\0a        /\\ IF (1 \\supseteq 2) = <<1, 2>>\0a             THEN Print("Test 56 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 56 Failed")\0a\0a        /\\ IF (1 \\approx 2) = <<1, 2>>\0a             THEN Print("Test 57 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 57 Failed")\0a\0a        /\\ IF (1 \\cong 2) = <<1, 2>>\0a             THEN Print("Test 58 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 58 Failed")\0a\0a        /\\ IF (1 \\sqsubset 2) = <<1, 2>>\0a             THEN Print("Test 59 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 59 Failed")\0a\0a        /\\ IF (1 \\sqsupset 2) = <<1, 2>>\0a             THEN Print("Test 60 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 60 Failed")\0a\0a        /\\ IF (1 \\sqsubseteq 2) = <<1, 2>>\0a             THEN Print("Test 61 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 61 Failed")\0a\0a        /\\ IF (1 \\sqsupseteq 2) = <<1, 2>>\0a             THEN Print("Test 62 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 62 Failed")\0a\0a        /\\ IF (1 \\doteq 2) = <<1, 2>>\0a             THEN Print("Test 63 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 63 Failed")\0a\0a        /\\ IF (1 \\propto 2) = <<1, 2>>\0a             THEN Print("Test 64 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 64 Failed")\0a\0a        /\\ IF << <<1, 2>>, 3 >> = 1 & 2 ... 3\0a             THEN Print("Test 65 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 65 Failed")\0a\0a\0a        /\\ IF << <<1, 2>>, 3 >> = 1 && 2 ... 3\0a             THEN Print("Test 66 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 66 Failed")\0a\0a\0a        /\\ IF << <<1, 2>>, 3 >> = 1 ** 2 ... 3\0a             THEN Print("Test 67 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 67 Failed")\0a\0a        /\\ IF << <<1, 2>>, 3 >> = 1 // 2 ... 3\0a             THEN Print("Test 68 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 68 Failed")\0a\0a        /\\ IF << <<1, 2>>, 3 >> = 1 ^^ 2 ... 3\0a             THEN Print("Test 69 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 69 Failed")\0a\0a        /\\ IF << <<1, 2>>, 3 >> = 1 (/) 2 ... 3\0a             THEN Print("Test 70 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 70 Failed")  \0a\0a        /\\ IF << <<1, 2>>, 3 >> =  1 (.) 2 ... 3\0a             THEN Print("Test 71 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 71 Failed")  \0a\0a        /\\ IF << <<1, 2>>, 3 >> = 1 \\star 2 ... 3\0a             THEN Print("Test 72 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 72 Failed")\0a\0a        /\\ IF << <<1, 2>>, 3 >> =  1 \\bigcirc  2 ... 3\0a             THEN Print("Test 73 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 73 Failed")\0a\0a        /\\ IF << <<1, 2>>, 3 >> =  1 \\bullet 2 ... 3\0a             THEN Print("Test 74 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 74 Failed")\0a\0a\0a        /\\ IF << <<1, 2>>, 3 >> = (1 $ 2 \\sim 3)\0a             THEN Print("Test 75 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 75 Failed") \0a\0a\0a        /\\ IF << <<1, 2>>, 3 >> = (1 $$ 2 \\simeq 3)\0a             THEN Print("Test 76 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 76 Failed") \0a\0a\0a        /\\ IF << <<1, 2>>, 3 >> = (1 $ 2 \\gg 3)\0a             THEN Print("Test 77 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 77 Failed") \0a\0a        /\\ IF << <<1, 2>>, 3 >> = (1 -- 2 ++ 3)\0a             THEN Print("Test 78 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 78 Failed")\0a\0a        /\\ IF << <<1, 2>>, 3 >> = (1 -- 2 <: 3)\0a             THEN Print("Test 79 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 79 Failed") \0a\0a\0a        /\\ IF << <<1, 2>>, 3 >> = (1 !! 2 \\ll 3)\0a             THEN Print("Test 80 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 80 Failed") \0a\0a        /\\ IF << <<1, 2>>, 3 >> =  1 (-) 2 (+) 3\0a             THEN Print("Test 81 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 81 Failed") \0a\0a        /\\ IF << <<1, 2>>, 3 >> = (1 ++ 2 |- 3)\0a             THEN Print("Test 82 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 82 Failed")\0a\0a        /\\ IF << <<1, 2>>, 3 >> = 1 (.) 2 (-) 3\0a             THEN Print("Test 83 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 83 Failed")  \0a\0a        /\\ IF << <<1, 2>>, 3 >> = (1 \\bullet 2 \\prec 3)\0a             THEN Print("Test 84 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 84 Failed")\0a\0a        /\\ IF << <<1, 2>>, 3 >> = (1 \\uplus 2 \\approx 3)\0a             THEN Print("Test 85 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 85 Failed")\0a\0a\0a        /\\ IF << <<1, 2>>, 3 >> = (1 ++ 2 \\sim 3)\0a             THEN Print("Test 86 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 86 Failed")\0a\0a        /\\ IF << <<1, 2>>, 3 >> = (1 (/) 2 (-) 3)\0a             THEN Print("Test 87 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 87 Failed")  \0a\0a\0a\0aConstraint == TRUE\0a=========================================\0a\0a<< {"..."},         "Infix", <<P.dotdot,   P.dotdot>>,   "none" >>,\0a<< {"//"},          "Infix", <<P.times,    P.times>>,    "none" >>,\0a<< {"^^"},          "Infix", <<P.exponent, P.exponent>>, "none" >>,\0a<< {"!!"},          "Infix", <<P.dotdot,   P.times>>,    "none" >>,\0a<< {"|-"},          "Infix", <<P.equals,   P.equals>>,   "none" >>,\0a<< {"|="},          "Infix", <<P.equals,   P.equals>>,   "none" >>,\0a<< {"-|"},          "Infix", <<P.equals,   P.equals>>,   "none" >>,\0a<< {"=|"},          "Infix", <<P.equals,   P.equals>>,   "none" >>,\0a<< {"<:"},          "Infix", <<P.colongt,  P.colongt>>,  "none" >>,\0a<< {":>"},          "Infix", <<P.colongt,  P.colongt>>,  "none" >>,\0a<< {":="},          "Infix", <<P.equals,   P.equals>>,   "none" >>,\0a<< {"::="},         "Infix", <<P.equals,   P.equals>>,   "none" >>,\0a<< {"(/)", "\\oslash"}, "Infix", <<P.times, P.times>>, "none"  >>,\0a<< {"\\wr"},             "Infix", <<P.dotdot, P.exponent>>, "none" >>,\0a<< {"\\prec"},           "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\succ"},           "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\preceq"},         "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\succeq"},         "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\sim"},            "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\simeq"},          "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\ll"},             "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\gg"},             "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\asymp"},          "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\subset"},         "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\supset"},         "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\supseteq"},       "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\approx"},         "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\cong"},           "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\sqsubset"},       "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\sqsupset"},       "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\sqsubseteq"},     "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\sqsupseteq"},     "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\doteq"},          "Infix", <<P.equals, P.equals>>,   "none" >>,\0a<< {"\\propto"},         "Infix", <<P.equals, P.equals>>,   "none" >>\0a\0a\0a\0a\0a']]]
      ['suite/test45' 'test45' %accept ~[['test45' '------------------------------ MODULE test45 -----------------------------\0a(* Test of recursive function definitions. *)\0a\0aEXTENDS Naturals, TLC\0a\0aVARIABLES x\0a\0aInit == x = 2\0a\0aNext == UNCHANGED x\0a\0af[i \\in 0..5] == [j \\in 0..5 |-> \0a                    IF j = 0 \0a                      THEN [k \\in 0..i |-> \0a                              IF k = 0 THEN i\0a                                       ELSE f[i][1] + 1]\0a                      ELSE IF i = 0\0a                             THEN j\0a                             ELSE f[i-1][j] + 1 ]\0a\0ag[i \\in 0..5] == [j \\in 0..i |-> \0a                   IF j = 0 \0a                     THEN IF i = 0 THEN 0\0a                                   ELSE g[i-1][i-1]\0a                     ELSE g[i][j-1]+x]\0a\0a\0ah[i \\in 0..3, j \\in 0..3] == [k \\in 0..3 |->\0a                               IF k = 0\0a                                 THEN IF j = 0 \0a                                        THEN IF i = 0 THEN 0\0a                                                      ELSE h[i-1,j][k] + 1\0a                                        ELSE h[i,j-1][k]+1\0a                                 ELSE h[i,j][k-1] + 1]\0a\0a(* g[0][0] = 0  \0a   g[0][j] = j * x\0a   g[i][j] = j * x + g[i-1][i-1] \0a           = (j + i-1) * x + g[i-2][i-2]\0a           = (j + i + i-1) * x  + g[i-3][i-2] \0a           = ... *)\0a\0aInv == /\\ IF  f[4][3] = 7\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed")    \0a\0a       /\\ IF f[4][0][2] = 6\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed")    \0a\0a       /\\ IF DOMAIN g[3] = 0..3\0a            THEN Print("Test 3  OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")\0a\0a       /\\ IF DOMAIN f[5][0] = 0..5\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4 Failed")\0a\0a       /\\ IF g[0][0] = 0\0a            THEN Print("Test 5 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 5 Failed")\0a\0a       /\\ IF g[3][3] = 12\0a            THEN Print("Test 6 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 6 Failed")\0a\0a       /\\ IF g[3][1] = 8\0a            THEN Print("Test 7 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 7 Failed")\0a\0a       /\\ IF g[2][0] = 2\0a            THEN Print("Test 8 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 8 Failed")\0a\0a       /\\ IF DOMAIN h[1,2] = 0..3\0a            THEN Print("Test 9 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 9 Failed")\0a\0a       /\\ IF DOMAIN h = (0..3) \\X (0..3)\0a            THEN Print("Test 10 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 10 Failed")\0a\0a       /\\ IF h[2, 3] = [i \\in 0..3 |-> i+5]\0a            THEN Print("Test 11 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 11 Failed")\0a\0a       /\\ IF h[1, 2][3] = 6\0a            THEN Print("Test 12 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 12 Failed")\0a\0a\0a=============================================================================\0a']]]
      ['suite/test46' 'test46' %accept ~[['test46' '--------------------- MODULE test46 -----------------------\0a\0a(* This found a bug in Version 1.03 of 18 Oct 1999 *)\0a\0aEXTENDS Naturals, Sequences, FiniteSets, TLC\0aCONSTANT Reg, Adr, Val, Proc\0aVARIABLE reqQ, reqOrder\0a\0aRequest    == [adr : Adr, val : Val, op : {"Rd", "Wr"}]\0aFreeRegVal == [adr : Adr, val : Val, op : {"Free"}]\0a\0areqId == UNION { [proc : {p}, idx : DOMAIN reqQ[p]] : p \\in Proc }\0a\0aoi \\prec oj == <<oi, oj>> \\in reqOrder\0a\0aTypeInvariant == \0a  /\\ reqQ \\in [Proc -> Seq(Request \\cup [reg : Reg])]\0a  /\\ reqOrder \\in SUBSET (reqId \\X reqId)\0a\0aInit == /\\ reqQ = [p \\in Proc |-> << >>]\0a        /\\ reqOrder = {}\0a\0aGoodReqOrder ==\0a  /\\ \\A oi, oj, ok \\in reqId : (oi \\prec oj) /\\ (oj \\prec ok) => (oi \\prec ok)\0a  /\\ \\A oi \\in reqId : ~(oi \\prec oi)\0a  /\\ \\A oi, oj \\in reqId : \0a        (oi.proc = oj.proc) /\\ (oi.idx < oj.idx) => (oi \\prec oj)\0a\0a-----------------------------------------------------------------------------\0aUpdateReqOrder == \0a  /\\ reqOrder\' \\in SUBSET(reqId\' \\X reqId\')\0a  /\\ reqOrder \\subseteq reqOrder\'\0a  /\\ GoodReqOrder\'\0a\0aIssueRequest(proc, req, reg) ==\0a  (*************************************************************************)\0a  (* The action by which processor proc issues request req in register     *)\0a  (* reg.                                                                  *)\0a  (*************************************************************************)\0a  /\\ reqQ\' = [reqQ EXCEPT ![proc] = Append(@, [reg |-> reg])]\0a  /\\ UpdateReqOrder\0a\0a\0aNext == \\E proc \\in Proc, reg \\in Reg :\0a           \\E req \\in Request : IssueRequest(proc, req, reg)\0a\0a\0aConstraint == \\A p \\in Proc : Len(reqQ[p]) < 2\0a=============================================================================\0a']]]
      ['suite/test47' 'test47' %accept ~[['test47' '------- MODULE test47 -----\0a\0a\\* Checks EXTENDing of both Naturals and Integers\0a\0aEXTENDS test47a , Integers \0a\0aInit == x = -1\0a\0aNext == x\'= IF x = -3 THEN x ELSE x - 1\0a\0aInv == TRUE\0a==========================\0a'] ['test47a' '------------- MODULE test47a  --------------\0a\0aEXTENDS Naturals, TLC\0a\0a\0aVARIABLE x\0a=============================================\0a']]]
      ['suite/test47a' 'test47a' %accept ~[['test47a' '------------- MODULE test47a  --------------\0a\0aEXTENDS Naturals, TLC\0a\0a\0aVARIABLE x\0a=============================================\0a']]]
      ['suite/test48' 'test48' %accept ~[['test48' '--------------- MODULE test48 -------------\0a\0a(* test definability of all user-definable infix, prefix, and postfix  \0a   operators *)\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0a\0az - y == z\0az + y == z\0az * y == z\0az / y == z\0az ^ y == z\0az < y == z\0az > y == z\0az .. y == z\0az ... y == z\0az | y == z\0az || y == z\0az & y == z\0az && y == z\0az $ y == z\0az $$ y == z\0az ?? y == z\0az %% y == z\0az ## y == z\0az ++ y == z\0az -- y == z\0az ** y == z\0az // y == z\0az ^^ y == z\0a\\* z @@ y == z  \\* THIS IS DEFINED IN THE TLC MODULE\0az !! y == z\0az |- y == z\0az |= y == z\0az -| y == z\0az =| y == z\0az <: y == z  \0a\\* z :> y == z  \\* THIS IS DEFINED IN THE TLC MODULE\0az := y == z\0az ::= y == z\0az \\uplus y == z\0az \\sqcap y == z\0az \\sqcup y == z\0az \\div y == z\0az \\wr y == z\0az \\star y == z\0az \\bigcirc y == z\0az \\bullet y == z\0az \\prec y == z\0az \\succ y == z\0az \\preceq y == z\0az \\succeq y == z\0az \\sim y == z\0az \\simeq y == z\0az \\ll y == z\0az \\gg y == z\0az \\asymp y == z\0az \\subset y == z\0az \\supset y == z\0az \\supseteq y == z\0az \\approx y == z  \0az \\cong y == z\0az \\sqsubset y == z\0az \\sqsupset y == z\0az \\sqsubseteq y == z\0az \\sqsupseteq y == z\0az \\doteq y == z\0az \\propto y == z\0a\0az ^+ == z\0az ^* == z\0az ^# == z\0a-. z == z\0a\0a\0aInit == \0a /\\ x = 0\0a\0aNext ==\0a/\\ x = 0\0a/\\ \0a   \\/ x\' = x - 1   \0a   \\/ x\' = x + 1\0a   \\/ x\' = x * 1\0a   \\/ x\' = x / 1\0a   \\/ x\' = x ^ 1\0a   \\/ x\' = (x < 1)  \0a   \\/ x\' = (x > 1)  \0a   \\/ x\' = x .. 1\0a   \\/ x\' = x ... 1\0a   \\/ x\' = x | 1\0a   \\/ x\' = x || 1\0a   \\/ x\' = x & 1\0a   \\/ x\' = x && 1\0a   \\/ x\' = x $ 1\0a   \\/ x\' = x $$ 1\0a   \\/ x\' = x ?? 1\0a   \\/ x\' = x %% 1\0a   \\/ x\' = x ## 1\0a   \\/ x\' = x ++ 1\0a   \\/ x\' = x -- 1\0a   \\/ x\' = x ** 1\0a   \\/ x\' = x // 1\0a   \\/ x\' = x ^^ 1\0a   \\/ x\' = x !! 1\0a   \\/ x\' = (x |- 1)\0a   \\/ x\' = (x |= 1)\0a   \\/ x\' = (x -| 1)\0a   \\/ x\' = (x =| 1)\0a   \\/ x\' = (x <: 1)\0a   \\/ x\' = (x := 1)\0a   \\/ x\' = (x ::= 1)\0a   \\/ x\' = (x \\uplus 1)\0a   \\/ x\' = (x \\sqcap 1)\0a   \\/ x\' = (x \\sqcup 1)\0a   \\/ x\' = x \\div 1\0a   \\/ x\' = x \\wr 1\0a   \\/ x\' = x \\star 1\0a   \\/ x\' = x \\bigcirc 1\0a   \\/ x\' = x \\bullet 1\0a   \\/ x\' = (x \\prec 1 )\0a   \\/ x\' = (x \\succ 1)\0a   \\/ x\' = (x \\preceq 1)\0a   \\/ x\' = (x \\succeq 1)\0a   \\/ x\' = (x \\sim 1)\0a   \\/ x\' = (x \\simeq 1)\0a   \\/ x\' = (x \\ll 1)\0a   \\/ x\' = (x \\gg 1)\0a   \\/ x\' = (x \\asymp 1)\0a   \\/ x\' = (x \\subset 1)\0a   \\/ x\' = (x \\supset 1)\0a   \\/ x\' = (x \\supseteq 1)\0a   \\/ x\' = (x \\approx 1)\0a   \\/ x\' = (x \\cong 1)\0a   \\/ x\' = (x \\sqsubset 1)\0a   \\/ x\' = (x \\sqsupset 1)\0a   \\/ x\' = (x \\sqsubseteq 1)\0a   \\/ x\' = (x \\sqsupseteq 1)\0a   \\/ x\' = (x \\doteq 1)\0a   \\/ x\' = (x \\propto 1)\0a   \\/ x\' = x ^+ \0a   \\/ x\' = x ^* \0a   \\/ x\' = x ^# \0a   \\/ x\' = -x  \0a=============================================================================\0a']]]
  ==
::
++  test-sany-sub-5
  %+  expect-eq
    !>  ^-  (list @t)
    :~  'suite/test51 -> hoon=reject'  'suite/test52 -> hoon=reject'  'suite/test7 -> hoon=reject'  'suite/test9 -> hoon=reject'  'suite/test999 -> hoon=reject'
    ==
  !>
  %-  sub-batch-run
  ^-  (list [@t @t ?(%accept %reject) (list [@t @t])])
  :~
      ['suite/test49' 'test49' %accept ~[['test49' '--------------- MODULE test49 -------------\0a\0a(* test definability of operators with aliases *)\0a\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0au (+) v == u\0au (-) v == u\0au (.) v == u\0au (/) v == u\0au (\\X) v == u \0au \\o v == u\0au % v == u\0au \\leq  v == u\0au \\geq v == u\0a\0a\0aInit == \0a /\\ x = 0\0a\0aNext ==\0a   /\\ x = 0\0a   /\\ \0a      \\/ x\' = x (+) 1    \0a      \\/ x\' = x (-) 1    \0a      \\/ x\' = x (.) 1    \0a      \\/ x\' = x (/) 1    \0a      \\/ x\' = x (\\X) 1   \0a      \\/ x\' = x \\o 1 \0a      \\/ x\' = x % 1 \0a      \\/ x\' = (x \\leq  1) \0a      \\/ x\' = (x \\geq 1 ) \0a=======================================\0a']]]
      ['suite/test49a' 'test49a' %accept ~[['test49a' '--------------- MODULE test49a -------------\0a\0a(* test definability of operators with aliases *)\0a\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0au (+) v == u\0au (-) v == u\0au (.) v == u\0au (/) v == u\0au (\\X) v == u \\* parser can\'t cope with this\0au \\o v == u\0au % v == u\0au \\leq  v == u\0au \\geq v == u\0a\0a\0aInit == \0a /\\ x = 0\0a /\\ Print("******************************************************", TRUE)\0a /\\ Print("Several tests have been commented out because of bugs.", TRUE)\0a /\\ Print("******************************************************", TRUE)\0a\0aNext ==\0a   /\\ x = 0\0a   /\\ \0a      \\/ x\' = x (+) 1    \\* caused TLC bug\0a      \\/ x\' = x (-) 1    \\* caused TLC bug\0a      \\/ x\' = x (.) 1    \\* caused TLC bug\0a      \\/ x\' = x (/) 1    \\* caused TLC bug\0a      \\/ x\' = x (\\X) 1   \\* parser can\'t cope with this.\0a      \\/ x\' = x \\o 1 \0a      \\/ x\' = x % 1 \0a      \\/ x\' = (x \\leq  1) \0a      \\/ x\' = (x \\geq 1 ) \0a=======================================\0a']]]
      ['suite/test49b' 'test49b' %reject ~[['test49b' '--------------- MODULE test49b -------------\0a\0a(* test definability of operators with aliases *)\0a\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0au \\oplus v == u\0au \\ominus v == u\0au \\odot v == u\0au \\oslash v == u\0au \\otimes v == u \0au \\circ v == u\0au \\mod v == u\0au =<  v == u\0au >= v == u\0a\0a\0aInit == \0a /\\ x = 0\0a /\\ Print("******************************************************", TRUE)\0a /\\ Print("Several tests have been commented out because of bugs.", TRUE)\0a /\\ Print("******************************************************", TRUE)\0a\0aNext ==\0a   /\\ x = 0\0a   /\\ \0a      \\/ x\' = x \\oplus 1  \0a      \\/ x\' = x \\ominus 1  \0a      \\/ x\' = x \\odot 1  \0a      \\/ x\' = x \\oslash 1  \0a      \\/ x\' = x \\otimes 1 \0a\\*      \\/ x\' = x \\circ 1 \0a\\*      \\/ x\' = x \\mod 1   \\* causes TLC bug\0a\\*      \\/ x\' = (x =<  1)  \\* causes TLC bug \0a\\*      \\/ x\' = (x >= 1 )  \\* causes TLC bug \0a=======================================\0a']]]
      ['suite/test49c' 'test49c' %reject ~[['test49c' '--------------- MODULE test49c -------------\0a\0a(* test definability of operators with aliases *)\0a\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0au \\oplus v == u\0au \\ominus v == u\0au \\odot v == u\0au \\oslash v == u\0au \\otimes v == u \0au \\o v == u\0au \\mod v == u\0au =<  v == u\0au >= v == u\0a\0a\0aInit == \0a /\\ x = 0\0a /\\ Print("*************************************************************", TRUE)\0a /\\ Print("Almost all the tests have been commented out because of bugs.", TRUE)\0a /\\ Print("*************************************************************", TRUE)\0a\0aNext ==\0a   /\\ x = 0\0a   /\\ \0a\\*      \\/ x\' = x (+) 1     \\* causes TLC bug\0a\\*      \\/ x\' = x (-) 1     \\* causes TLC bug\0a\\*      \\/ x\' = x (.) 1     \\* causes TLC bug\0a\\*      \\/ x\' = x (/) 1     \\* causes TLC bug\0a\\*      \\/ x\' = x (\\X) 1  \\* parser can\'t handle this\0a\\*      \\/ x\' = x \\circ 1   \\* causes TLC bug\0a      \\/ x\' = x % 1   \0a\\*      \\/ x\' = (x =<  1)  \\* TLC bug : sets x\' to TRUE\0a\\*      \\/ x\' = (x >= 1 )    \\* TLC bug : sets x\' to FALSE\0a=======================================\0a']]]
      ['suite/test5' 'test5' %accept ~[['test5' '--------------- MODULE test5 -------------\0a\0a(* test of Cartesian Product. *)\0a\0aEXTENDS Integers, TLC\0a\0aVARIABLE x\0aType == x \\in {1}\0aInit == x = 1\0aNext == UNCHANGED x\0a\0aInv  == \0a  /\\ IF {1, 2} \\X {"a", "b"} # {<<1, "a">>, <<2, "a">>, <<2, "b">>, <<1, "b">>}\0a      THEN Assert(FALSE, "Test 1 failed")\0a      ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF [p \\in Nat \\X Int |-> p[1] - 2*p[2]][2, -3] # 8\0a      THEN Assert(FALSE, "Test 2 failed")\0a      ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF [p \\in Int \\X Int |-> p[1] - 2*p[2]][2, -3] # 8\0a      THEN Assert(FALSE, "Test 3 failed")\0a      ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF <<1, 3>> \\notin Nat \\X Nat\0a      THEN Assert(FALSE, "Test 4 failed")\0a      ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF <<1, 3>> \\notin (Int \\X Int)\0a      THEN Assert(FALSE, "Test 5 failed")\0a      ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF [1..2 -> {1, 2, 3}] \\cap ({1} \\X {2}) # {<<1,2>>}\0a      THEN Assert(FALSE, "Test 6 failed")\0a      ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF {<<1, 4>>, <<2,3>>} \\notin SUBSET ({1,2} \\X {3,4})\0a      THEN Assert(FALSE, "Test 7 failed")\0a      ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF <<1,3>> \\notin {1,2,3} \\X {2,3,4}\0a      THEN Assert(FALSE, "Test 8 failed")\0a      ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF {1, 2} \\X {"a", "b"} \\X {"c"} # \0a           {<<1, "a", "c">>, <<2, "a", "c">>, <<2, "b", "c">>, <<1, "b", "c">>}\0a      THEN Assert(FALSE, "Test 9 failed")\0a      ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF [p \\in Nat \\X Int \\X Nat |-> p[1] - 2*p[2] + p[3]][2, -3, 4] # 12\0a      THEN Assert(FALSE, "Test 10 failed")\0a      ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF [p \\in Int \\X Int \\X Int |-> p[1] - 2*p[2] - p[3]][2, -3, -4] # 12\0a      THEN Assert(FALSE, "Test 11 failed")\0a      ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF <<1, 2, 3, 4>> \\notin Nat \\X Nat \\X Nat \\X Nat\0a      THEN Assert(FALSE, "Test 12 failed")\0a      ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF <<1, 2, 3, 4>> \\notin (Int \\X Int \\X Int \\X Int)\0a      THEN Assert(FALSE, "Test 13 failed")\0a      ELSE Print("Test 13 OK", TRUE)\0a\0a  /\\ IF [1..2 -> {1, 2, 3}] \\cap ({1} \\X {2}) # {<<1,2>>}\0a      THEN Assert(FALSE, "Test 14 failed")\0a      ELSE Print("Test 14 OK", TRUE)\0a\0a  /\\ IF {<<1, 4, 2>>, <<2,3,3>>} \\notin SUBSET ({1,2} \\X {3,4} \\X {2, 3})\0a      THEN Assert(FALSE, "Test 15 failed")\0a      ELSE Print("Test 15 OK", TRUE)\0a\0a  /\\ IF <<1,3, 5>> \\notin {1,2,3} \\X {2,3,4} \\X {5,6}\0a      THEN Assert(FALSE, "Test 16 failed")\0a      ELSE Print("Test 16 OK", TRUE)\0a  /\\ \\* Test 17 added 4 June 2014\0a     IF \\/ {} \\X {1,2} # {2,3,4} \\X {}\0a        \\/ {1, 2} \\X {} \\X {3,4} # {2} \\X {4,4} \\X {}\0a        \\/ {1} \\X {2} \\X {} # {} \\X {3,3}\0a      THEN Assert(FALSE, "Test 17 failed")\0a      ELSE Print("Test 17 OK", TRUE)\0a  /\\ \\* Test 18 added 12 Jun 2014\0a     IF \\/ [a: {12}, b : {}] # [c: {22}, d: {xyz \\in {1,2,3} : xyz < 0}]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: 2..1]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: {1,2,3} \\cap 4..6]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: {} \\cup {xz \\in {1,2,3} : xz < 0}]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: {2,3,4} \\X {}]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: [a: {}, b : {1}]]\0a        \\/ [a: {12}, b : {}] = [c: {22}, d: SUBSET {}]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: UNION {}]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: {2,3,4} \\ 1..5]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: [{1,2,3} -> {}]]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: {}]\0a        \\/ [a: {12}, b : {}] # [c: {22}, d: {xyz+1 : xyz \\in 2..1}]\0a      THEN Assert(FALSE, "Test 18 failed")\0a      ELSE Print("Test 18 OK", TRUE)\0a  /\\ \\* Test 19 added 12 Jun 2014\0a     IF \\/ {1} \\X {2} \\X {} # {22} \\X  {xyz \\in {1,2,3} : xyz < 0}\0a        \\/ {1} \\X {2} \\X {} # {22} \\X  (2..1)\0a        \\/ {1} \\X {2} \\X {} # {22} \\X  ({1,2,3} \\cap (4..6))\0a        \\/ {1} \\X {2} \\X {} # {22} \\X ({} \\cup {xz \\in {1,2,3} : xz < 0})\0a        \\/ {1} \\X {2} \\X {} # {22} \\X ({2,3,4} \\X {})\0a        \\/ {1} \\X {2} \\X {} # {22} \\X ([a: {}, b : {1}])\0a        \\/ {1} \\X {2} \\X {} = {22} \\X (SUBSET {})\0a        \\/ {1} \\X {2} \\X {} # {22} \\X (UNION {})\0a        \\/ {1} \\X {2} \\X {} # {22} \\X ({2,3,4} \\ (1..5))\0a        \\/ {1} \\X {2} \\X {} # {22} \\X ([{1,2,3} -> {}])\0a        \\/ {1} \\X {2} \\X {} # {22} \\X ({})\0a        \\/ {1} \\X {2} \\X {} # {22} \\X ({xyz+1 : xyz \\in 2..1})\0a      THEN Assert(FALSE, "Test 19 failed")\0a      ELSE Print("Test 19 OK", TRUE)\0a=========================================\0a']]]
      ['suite/test50' 'test50' %accept ~[['test50' '--------------- MODULE test50 -------------\0a\0a(* test usability of the following aliases with the standard modules:\0a   <=  and >=  of Naturals\0a   \\circ of Sequences\0a   (+) and (-) of Bags \0a\0a*)\0a\0a\0aEXTENDS Naturals, Sequences, Bags, TLC\0a\0aBag1 == SetToBag({"a", "b"})\0aBag2 == Bag1 \\oplus  SetToBag({"a"}) \\* causes TLC bug\0aBag3 == Bag2 \\ominus Bag1\0aBag2a == Bag1 (+) SetToBag({"a"})\0aBag3a == Bag2 (-) Bag1\0a\0a\0aVARIABLES x\0aInit == x = 0\0aNext == x\'=x\0a\0aInv == \0a       /\\ IF Bag2 = Bag2a\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed") \0a\0a       /\\ IF Bag3 = Bag3a\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed") \0a\0a       /\\ IF <<"a">> \\o <<"b">> = <<"a">> \\circ <<"b">>\0a            THEN Print("Test 3 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")  \0a    \0a       /\\ IF 1 \\leq 2\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4  Failed") \0a\0a       /\\ IF 1 <= 2\0a            THEN Print("Test 5 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 5  Failed") \0a    \0a       /\\ IF 2 \\geq 1 \0a            THEN Print("Test 6 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 6  Failed") \0a\0a       /\\ IF 2 >= 1 \0a            THEN Print("Test 7 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 7  Failed") \0a\0a=======================================\0a']]]
      ['suite/test51' 'test51' %accept ~[['test51' '----------------------   MODULE test51 -----------------------\0a\\* Test of handling of infix operator symbols\0a\0aEXTENDS TLC\0a\0a\\* Test parser on action/temporal infix operators\0a\0aFooA == INSTANCE test51a\0aFooB == INSTANCE test51b\0a\0aTempTest(_+_) == TRUE + FALSE\0aFoo1 == TempTest(-+->)\0aFoo2 == TempTest(~>)\0aFoo3 == TempTest(\\cdot)\0a\0a\\* Definining all undefined infix operators \0a\0aa + b == {a, b}\0aa - b == {a, b}\0aa * b == {a, b}\0aa / b == {a, b}\0aa ..b == {a, b}\0aa < b == {a, b}\0aa > b == {a, b}\0aa \\leq b == {a, b}\0aa \\geq b == {a, b}\0aa % b == {a, b}\0aa ^b == {a, b}\0aa \\o b == {a, b}\0aa ++ b == {a, b}\0aa \\div b == {a, b}\0aa ...b == {a, b}\0aa -- b == {a, b}\0aa (+)b == {a, b}\0aa (-)b == {a, b}\0aa (\\X)b == {a, b}\0aa (/)b == {a, b}\0aa (.)b == {a, b}\0aa ** b == {a, b}\0aa \\sqcap b == {a, b}\0aa // b == {a, b}\0aa \\prec b == {a, b}\0aa \\succ b == {a, b}\0aa \\preceq b == {a, b}\0aa \\succeq b == {a, b}\0aa \\sqcup b == {a, b}\0aa ^^b == {a, b}\0aa \\ll b == {a, b}\0aa \\gg b == {a, b}\0aa <: b == {a, b}\0aa & b == {a, b}\0aa && b == {a, b}\0aa \\sqsubset b == {a, b}\0aa \\sqsupset b == {a, b}\0aa \\sqsubseteq b == {a, b}\0aa \\sqsupseteq b == {a, b}\0aa | b == {a, b}\0aa || b == {a, b}\0aa \\subset b == {a, b}\0aa \\supset b == {a, b}\0aa \\supseteq b == {a, b}\0aa \\star b == {a, b}\0aa %% b == {a, b}\0aa |- b == {a, b}\0aa -|b == {a, b}\0aa |= b == {a, b}\0aa =|b == {a, b}\0aa \\bullet b == {a, b}\0aa ##b == {a, b}\0aa \\sim b == {a, b}\0aa \\simeq b == {a, b}\0aa \\approx b == {a, b}\0aa \\cong b == {a, b}\0aa $b == {a, b}\0aa $$b == {a, b}\0aa := b == {a, b}\0aa ::= b == {a, b}\0aa \\asymp b == {a, b}\0aa \\doteq b == {a, b}\0aa ?? b == {a, b}\0aa !! b == {a, b}\0aa \\propto b == {a, b}\0aa \\wr b == {a, b}\0aa \\uplus b == {a, b}\0aa \\bigcirc b == {a, b}\0a\0aTestOpArg(Foo(_,_)) == Foo("a", "b")\0a\0aTestTLCOps(colongt(_,_), atat(_,_)) ==\0a   atat( colongt(1, "ab"), colongt(2, "cd"))\0a \\* 1 :> "ab" @@ 2 :> "cd"\0a\0aTestDefinedSetOp(Foo(_,_)) == Foo({"a", "b"}, {"b", "c"})\0aTestDefinedBooleanOp(Foo(_,_)) == Foo(TRUE,FALSE)\0aTestIn(Foo(_,_)) == Foo("a", {"b", "c"})\0a\0aASSUME\0a  /\\ IF TestOpArg(+ ) = {"a", "b"}\0a       THEN Print("Test 1 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 1 Failed")\0a  /\\ IF TestOpArg( - ) = {"a", "b"}\0a       THEN Print("Test 2 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 2 Failed")\0a  /\\ IF TestOpArg( * ) = {"a", "b"}\0a       THEN Print("Test 3 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 3 Failed")\0a  /\\ IF TestOpArg(/ ) = {"a", "b"}\0a       THEN Print("Test 4 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 4 Failed")\0a  /\\ IF TestOpArg(..) = {"a", "b"}\0a       THEN Print("Test 5 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 5 Failed")\0a  /\\ IF TestOpArg(< ) = {"a", "b"}\0a       THEN Print("Test 6 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 6 Failed")\0a  /\\ IF TestOpArg(> ) = {"a", "b"}\0a       THEN Print("Test 7 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 7 Failed")\0a  /\\ IF TestOpArg(\\leq ) = {"a", "b"}\0a       THEN Print("Test 8 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 8 Failed")\0a  /\\ IF TestOpArg(=<) = {"a", "b"}\0a       THEN Print("Test 9 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 9 Failed")\0a  /\\ IF TestOpArg(<=) = {"a", "b"}\0a       THEN Print("Test 10 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 10 Failed")\0a  /\\ IF TestOpArg(\\geq ) = {"a", "b"}\0a       THEN Print("Test 11 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 11 Failed")\0a  /\\ IF TestOpArg(>=) = {"a", "b"}\0a       THEN Print("Test 12 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 12 Failed")\0a  /\\ IF TestOpArg(% ) = {"a", "b"}\0a       THEN Print("Test 13 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 13 Failed")\0a  /\\ IF TestOpArg(^) = {"a", "b"}\0a       THEN Print("Test 14 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 14 Failed")\0a  /\\ IF TestOpArg(\\circ ) = {"a", "b"}\0a   