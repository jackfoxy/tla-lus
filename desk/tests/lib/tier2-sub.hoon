      ['EWD840/EWD840' 'EWD840' %accept ~[['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor \\in Color\0a\0a(* Initially the token is at node 0, and it is black. There\0a   are no constraints on the status and color of the nodes. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos = 0\0a  /\\ tcolor = "black"\0a\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i]\0a        \\/ color[i] = "black"\0a        \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0aNext ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a  \\/ \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0aSystem ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aFairness == WF_vars(System)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aLInv == [][Next]_vars => WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0aNeverBlack == \\A i \\in Nodes : color[i] # "black"\0a\0aNeverChangeColor == [][ \\A i \\in Nodes : UNCHANGED color[i] ]_vars\0a\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a  /\\ color[1] = "white"\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0aLiveness ==\0a  /\\ (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0aAllNodesTerminateIfNoMessages ==\0a  <>[][~ \\E i \\in Nodes : SendMsg(i)]_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a=============================================================================\0a']]]
      ['EWD840/Error02' 'Error02' %accept ~[['Error02' '---- CONFIG Error02 ----\0aCONSTANT\0aN = 2\0aSPECIFICATION SillySpec\0aCONSTRAINT StateConstraint\0aACTION_CONSTRAINT ActionConstraint\0aPROPERTIES Liveness\0aINVARIANT Inv\0a========================\0a---- MODULE Error02 ----\0aEXTENDS EWD840, TLC, Sequences\0a\0aSillySpec ==\0a    Spec /\\ 42 = "abc" \\* Silly expression as the level of the behavior spec.\0a\0aStateConstraint ==\0a    \\* For the tests to be interesting, this triggers the evaluation \0a    \\* of a Java module override in one of TLC\'s standard modules that\0a    \\* accesses a variable (the state) and involves EvalControl.\0a    \\* Since we don\'t care about constraining the state space, this is\0a    \\* a tautology.\0a    SelectSeq([i \\in 1..N+1 |-> i - 1], LAMBDA node: node = "abc" ) = <<tpos>>\0a\0aActionConstraint ==\0a    LET foo(vv) == SelectSeq([i \\in 1..N+1 |-> i - 1], LAMBDA node: node = vv )\0a    IN \\/ foo("abc") = <<tpos>>\'\0a       \\/ foo("abc") # <<tpos\'>>\0a    \0a=============================================================================\0a'] ['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor \\in Color\0a\0a(* Initially the token is at node 0, and it is black. There\0a   are no constraints on the status and color of the nodes. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos = 0\0a  /\\ tcolor = "black"\0a\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i]\0a        \\/ color[i] = "black"\0a        \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0aNext ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a  \\/ \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0aSystem ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aFairness == WF_vars(System)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aLInv == [][Next]_vars => WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0aNeverBlack == \\A i \\in Nodes : color[i] # "black"\0a\0aNeverChangeColor == [][ \\A i \\in Nodes : UNCHANGED color[i] ]_vars\0a\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a  /\\ color[1] = "white"\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0aLiveness ==\0a  /\\ (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0aAllNodesTerminateIfNoMessages ==\0a  <>[][~ \\E i \\in Nodes : SendMsg(i)]_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a=============================================================================\0a']]]
      ['EWD840/Error03' 'Error03' %accept ~[['Error03' '---- CONFIG Error03 ----\0aCONSTANT\0aN = 2\0aSPECIFICATION Spec\0aACTION_CONSTRAINT ActionConstraint\0aPROPERTIES Liveness\0aINVARIANT Inv\0a========================\0a---- MODULE Error03 ----\0aEXTENDS EWD840, TLC, Sequences\0a\0aActionConstraint ==\0a    LET foo(vv) == SelectSeq([i \\in 1..N+1 |-> i - 1], LAMBDA node: node = vv )\0a    IN \\/ foo("abc") = <<tpos>>\'\0a       \\/ foo("abc") # <<tpos\'>>\0a    \0a=============================================================================\0a'] ['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor \\in Color\0a\0a(* Initially the token is at node 0, and it is black. There\0a   are no constraints on the status and color of the nodes. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos = 0\0a  /\\ tcolor = "black"\0a\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i]\0a        \\/ color[i] = "black"\0a        \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0aNext ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a  \\/ \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0aSystem ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aFairness == WF_vars(System)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aLInv == [][Next]_vars => WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0aNeverBlack == \\A i \\in Nodes : color[i] # "black"\0a\0aNeverChangeColor == [][ \\A i \\in Nodes : UNCHANGED color[i] ]_vars\0a\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a  /\\ color[1] = "white"\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0aLiveness ==\0a  /\\ (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0aAllNodesTerminateIfNoMessages ==\0a  <>[][~ \\E i \\in Nodes : SendMsg(i)]_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a=============================================================================\0a']]]
      ['EWD840/MC' 'MC' %accept ~[['MC' '---- MODULE MC ----\0aEXTENDS EWD840, TLC\0a\0a\\* CONSTANT definitions @modelParameterConstants:0N\0aconst_143073460396411000 == \0a10\0a----\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_143073460397412000 ==\0aSpec\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_143073460398413000 ==\0aLiveness\0a----\0a=============================================================================\0a\\* Modification History\0a\\* Created Mon May 04 12:16:43 CEST 2015 by markus\0a'] ['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor \\in Color\0a\0a(* Initially the token is at node 0, and it is black. There\0a   are no constraints on the status and color of the nodes. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos = 0\0a  /\\ tcolor = "black"\0a\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i]\0a        \\/ color[i] = "black"\0a        \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0aNext ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a  \\/ \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0aSystem ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aFairness == WF_vars(System)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aLInv == [][Next]_vars => WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0aNeverBlack == \\A i \\in Nodes : color[i] # "black"\0a\0aNeverChangeColor == [][ \\A i \\in Nodes : UNCHANGED color[i] ]_vars\0a\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a  /\\ color[1] = "white"\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0aLiveness ==\0a  /\\ (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0aAllNodesTerminateIfNoMessages ==\0a  <>[][~ \\E i \\in Nodes : SendMsg(i)]_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a=============================================================================\0a']]]
      ['EWD840/MC02' 'MC02' %accept ~[['MC02' '---- MODULE MC02 ----\0aEXTENDS EWD840, TLC, Sequences\0a\0aconst_143073460396411000 == \0a    2\0a\0aspec_143073460397412000 ==\0a    Spec /\\ ENABLED Next /\\ ENABLED (SelectSeq([i \\in 1..N+1 |-> i - 1], LAMBDA node: node = tpos ) = <<tpos>>)\0a\0aStateConstraint ==\0a    \\* For the tests to be interesting, this triggers the evaluation \0a    \\* of a Java module override in one of TLC\'s standard modules that\0a    \\* accesses a variable (the state) and involves EvalControl.\0a    \\* Since we don\'t care about constraining the state space, this is\0a    \\* a tautology.\0a    SelectSeq([i \\in 1..N+1 |-> i - 1], LAMBDA node: node = tpos ) = <<tpos>>\0a\0aActionConstraint ==\0a    LET foo == SelectSeq([i \\in 1..N+1 |-> i - 1], LAMBDA node: node = tpos )\0a    IN \\/ foo = <<tpos>>\'\0a       \\/ foo # <<tpos\'>>\0a\0a-----------------------------------------------------------------------------\0a\0aStop == TLCGet("distinct") < 38\0a\0aAlias ==\0a    [\0a         active |-> active,\0a         color |-> color,\0a         tpos |-> tpos,\0a         tcolor |-> tpos,\0a         enbld |-> ENABLED <<InitiateProbe>>_vars\0a    ]\0a    \0a=============================================================================\0a'] ['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor \\in Color\0a\0a(* Initially the token is at node 0, and it is black. There\0a   are no constraints on the status and color of the nodes. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos = 0\0a  /\\ tcolor = "black"\0a\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i]\0a        \\/ color[i] = "black"\0a        \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0aNext ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a  \\/ \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0aSystem ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aFairness == WF_vars(System)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aLInv == [][Next]_vars => WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0aNeverBlack == \\A i \\in Nodes : color[i] # "black"\0a\0aNeverChangeColor == [][ \\A i \\in Nodes : UNCHANGED color[i] ]_vars\0a\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a  /\\ color[1] = "white"\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0aLiveness ==\0a  /\\ (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0aAllNodesTerminateIfNoMessages ==\0a  <>[][~ \\E i \\in Nodes : SendMsg(i)]_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a=============================================================================\0a']]]
      ['EWD840/MC02Sim' 'MC02Sim' %accept ~[['MC02Sim' '---- MODULE MC02Sim ----\0aEXTENDS EWD840, TLC, Sequences\0a\0aconst_143073460396411000 == \0a    2\0a\0aspec_143073460397412000 ==\0a    Spec /\\ ENABLED Next /\\ ENABLED (SelectSeq([i \\in 1..N+1 |-> i - 1], LAMBDA node: node = tpos ) = <<tpos>>)\0a\0aStateConstraint ==\0a    \\* For the tests to be interesting, this triggers the evaluation \0a    \\* of a Java module override in one of TLC\'s standard modules that\0a    \\* accesses a variable (the state) and involves EvalControl.\0a    \\* Since we don\'t care about constraining the state space, this is\0a    \\* a tautology.\0a    SelectSeq([i \\in 1..N+1 |-> i - 1], LAMBDA node: node = tpos ) = <<tpos>>\0a\0aActionConstraint ==\0a    LET foo == SelectSeq([i \\in 1..N+1 |-> i - 1], LAMBDA node: node = tpos )\0a    IN \\/ foo = <<tpos>>\'\0a       \\/ foo # <<tpos\'>>\0a\0a-----------------------------------------------------------------------------\0a\0aStop == TLCGet("level") < 6\0a\0aAlias ==\0a    [\0a         active |-> active,\0a         color |-> color,\0a         tpos |-> tpos,\0a         tcolor |-> tpos,\0a         enbld |-> ENABLED <<InitiateProbe>>_vars\0a    ]\0a    \0a=============================================================================\0a'] ['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor \\in Color\0a\0a(* Initially the token is at node 0, and it is black. There\0a   are no constraints on the status and color of the nodes. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos = 0\0a  /\\ tcolor = "black"\0a\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i]\0a        \\/ color[i] = "black"\0a        \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0aNext ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a  \\/ \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0aSystem ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aFairness == WF_vars(System)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aLInv == [][Next]_vars => WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0aNeverBlack == \\A i \\in Nodes : color[i] # "black"\0a\0aNeverChangeColor == [][ \\A i \\in Nodes : UNCHANGED color[i] ]_vars\0a\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a  /\\ color[1] = "white"\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0aLiveness ==\0a  /\\ (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0aAllNodesTerminateIfNoMessages ==\0a  <>[][~ \\E i \\in Nodes : SendMsg(i)]_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a=============================================================================\0a']]]
      ['EWD840/MC03Sim' 'MC03Sim' %accept ~[['MC03Sim' '---- MODULE MC03Sim ----\0aEXTENDS EWD840, TLC, Sequences\0a\0aLevel ==\0a    TLCGet("level") < 15\0a\0aActionConstraint ==\0a    vars\' # vars\0a=============================================================================\0a'] ['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor \\in Color\0a\0a(* Initially the token is at node 0, and it is black. There\0a   are no constraints on the status and color of the nodes. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos = 0\0a  /\\ tcolor = "black"\0a\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i]\0a        \\/ color[i] = "black"\0a        \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0aNext ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a  \\/ \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0aSystem ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aFairness == WF_vars(System)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aLInv == [][Next]_vars => WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0aNeverBlack == \\A i \\in Nodes : color[i] # "black"\0a\0aNeverChangeColor == [][ \\A i \\in Nodes : UNCHANGED color[i] ]_vars\0a\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a  /\\ color[1] = "white"\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0aLiveness ==\0a  /\\ (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0aAllNodesTerminateIfNoMessages ==\0a  <>[][~ \\E i \\in Nodes : SendMsg(i)]_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a=============================================================================\0a']]]
      ['EWD840/MC06' 'MC06' %accept ~[['MC06' '---- MODULE MC06 ----\0aEXTENDS EWD840, TLC\0a\0a\\* CONSTANT definitions @modelParameterConstants:0N\0aconst_143073460396411000 == \0a7\0a----\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_143073460397412000 ==\0aSpec\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_143073460398413000 ==\0aLiveness\0a----\0a=============================================================================\0a'] ['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor \\in Color\0a\0a(* Initially the token is at node 0, and it is black. There\0a   are no constraints on the status and color of the nodes. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos = 0\0a  /\\ tcolor = "black"\0a\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i]\0a        \\/ color[i] = "black"\0a        \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a  /\\ UNCHANGED <<active>>\0a\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0aNext ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a  \\/ \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0aSystem ==\0a  \\/ InitiateProbe\0a  \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aFairness == WF_vars(System)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aLInv == [][Next]_vars => WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0aNeverBlack == \\A i \\in Nodes : color[i] # "black"\0a\0aNeverChangeColor == [][ \\A i \\in Nodes : UNCHANGED color[i] ]_vars\0a\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a  /\\ color[1] = "white"\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0aLiveness ==\0a  /\\ (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0aAllNodesTerminateIfNoMessages ==\0a  <>[][~ \\E i \\in Nodes : SendMsg(i)]_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a=============================================================================\0a']]]
      ['EWD998/EWD998' 'EWD998' %accept ~[['EWD998' '------------------------------- MODULE EWD998 -------------------------------\0a(***************************************************************************)\0a(* TLA+ specification of an algorithm for distributed termination          *)\0a(* detection on a ring, due to Shmuel Safra, published as EWD 998:         *)\0a(* Shmuel Safra\'s version of termination detection.                        *)\0a(* https://www.cs.utexas.edu/users/EWD/ewd09xx/EWD998.PDF                  *)\0a(***************************************************************************)\0aEXTENDS Integers, FiniteSets, Utils, TLC, TLCExt\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0} \\* At least one node.\0a\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0aToken == [pos : Nodes, q : Int, color : Color]\0a\0aVARIABLES \0a active,     \\* activation status of nodes\0a color,      \\* color of nodes\0a counter,    \\* nb of sent messages - nb of rcvd messages per node\0a pending,    \\* nb of messages in transit to node\0a token       \\* token structure\0a  \0avars == <<active, color, counter, pending, token>>\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ counter \\in [Nodes -> Int]  \\* Negative, iff a node receives more messages than it sends.\0a  /\\ pending \\in [Nodes -> Nat]\0a  /\\ token \\in Token\0a------------------------------------------------------------------------------\0a \0aInit ==\0a  (* EWD840 but nodes *) \0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  (* Rule 0 *)\0a  /\\ counter = [i \\in Nodes |-> 0] \\* c properly initialized\0a  /\\ pending = [i \\in Nodes |-> 0]\0a  /\\ token = [pos |-> 0, q |-> 0, color |-> "black"]\0a\0aInitiateProbe ==\0a  (* Rules 1 + 5 + 6 *)\0a  /\\ token.pos = 0\0a  /\\ \\* previous round not conclusive if:\0a     \\/ token.color = "black"\0a     \\/ color[0] = "black"\0a     \\/ counter[0] + token.q > 0\0a  /\\ token\' = [pos |-> N-1, q |-> 0, color |-> "white"]\0a  /\\ color\' = [ color EXCEPT ![0] = "white" ]\0a  \\* The state of the nodes remains unchanged by token-related actions.\0a  /\\ UNCHANGED <<active, counter, pending>>                            \0a  \0aPassToken(i) ==\0a  (* Rules 2 + 4 + 7 *)\0a  /\\ ~ active[i] \\* If machine i is active, keep the token.\0a  /\\ token.pos = i\0a  /\\ token\' = [token EXCEPT !.pos = @ - 1,\0a                            !.q = @ + counter[i],\0a                            !.color = IF color[i] = "black" THEN "black" ELSE @]\0a  /\\ color\' = [ color EXCEPT ![i] = "white" ]\0a  \\* The state of the nodes remains unchanged by token-related actions.\0a  /\\ UNCHANGED <<active, counter, pending>>\0a\0aSystem == \\/ InitiateProbe\0a          \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0a-----------------------------------------------------------------------------\0a\0aSendMsg(i) ==\0a  \\* Only allowed to send msgs if node i is active.\0a  /\\ active[i]\0a  (* Rule 0 *)\0a  /\\ counter\' = [counter EXCEPT ![i] = @ + 1]\0a  \\* Non-deterministically choose a receiver node.\0a  /\\ \\E j \\in Nodes \\ {i} : pending\' = [pending EXCEPT ![j] = @ + 1]\0a          \\* Note that we don\'t blacken node i as in EWD840 if node i\0a          \\* sends a message to node j with j > i\0a  /\\ UNCHANGED <<active, color, token>>\0a\0aRecvMsg(i) ==\0a  /\\ pending[i] > 0\0a  /\\ pending\' = [pending EXCEPT ![i] = @ - 1]\0a  (* Rule 0 *)\0a  /\\ counter\' = [counter EXCEPT ![i] = @ - 1]\0a  (* Rule 3 *)\0a  /\\ color\' = [ color EXCEPT ![i] = "black" ]\0a  \\* Receipt of a message activates i.\0a  /\\ active\' = [ active EXCEPT ![i] = TRUE ]\0a  /\\ UNCHANGED <<token>>                           \0a\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, counter, pending, token>>\0a\0aEnvironment == \\E i \\in Nodes : SendMsg(i) \\/ RecvMsg(i) \\/ Deactivate(i)\0a\0a-----------------------------------------------------------------------------\0a\0aNext ==\0a  System \\/ Environment\0a\0aSpec == Init /\\ [][Next]_vars /\\ WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Bound the otherwise infinite state space that TLC has to check.         *)\0a(***************************************************************************)\0aStateConstraint ==\0a  /\\ \\A i \\in Nodes : counter[i] <= 3 /\\ pending[i] <= 3\0a  /\\ token.q <= 3\0a\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Main safety property: if there is a white token at node 0 and there are *)\0a(* no in-flight messages then every node is inactive.                      *)\0a(***************************************************************************)\0aterminationDetected ==\0a  /\\ token.pos = 0\0a  /\\ token.color = "white"\0a  /\\ token.q + counter[0] = 0\0a  /\\ color[0] = "white"\0a  /\\ ~ active[0]\0a  /\\ pending[0] = 0\0a\0a(***************************************************************************)\0a(* The number of messages on their way. "in-flight"                        *)\0a(***************************************************************************)\0aB == Reduce(sum, pending, 0, N-1, 0)\0a\0a(***************************************************************************)\0a(* The system has terminated if no node is active and there are no         *)\0a(* in-flight messages.                                                     *)\0a(***************************************************************************)\0aTermination == \0a  /\\ \\A i \\in Nodes : ~ active[i]\0a  /\\ B = 0\0a\0aTerminationDetection ==\0a  terminationDetected => Termination\0a\0a(***************************************************************************)\0a(* Safra\'s inductive invariant                                             *)\0a(***************************************************************************)\0aInv == \0a  /\\ P0:: B = Reduce(sum, counter, 0, N-1, 0)\0a     (* (Ai: t < i < N: machine nr.i is passive) /\\ *)\0a     (* (Si: t < i < N: ci.i) = q *)\0a  /\\ \\/ P1:: /\\ \\A i \\in (token.pos+1)..N-1: ~ active[i] \\* machine nr.i is passive\0a             /\\ IF token.pos = N-1 \0a                THEN token.q = 0 \0a                ELSE token.q = Reduce(sum, counter, (token.pos+1), N-1, 0)\0a     (* (Si: 0 <= i <= t: c.i) + q > 0. *)\0a     \\/ P2:: Reduce(sum, counter, 0, token.pos, 0) + token.q > 0\0a     (* Ei: 0 <= i <= t : machine nr.i is black. *)\0a     \\/ P3:: \\E i \\in 0..token.pos : color[i] = "black"\0a     (* The token is black. *)\0a     \\/ P4:: token.color = "black"\0a\0a(***************************************************************************)\0a(* Liveness property: termination is eventually detected.                  *)\0a(***************************************************************************)\0aLiveness ==\0a  Termination ~> terminationDetected\0a\0aActionConstraint ==\0a    token \\in Token \\* Some non-constant expression that would otherwise optimized out.\0a\0a-----------------------------------------------------------------------------\0a\0aLvl ==\0a\09TLCGet("level") < 100\0a   \0aMyAlias ==\0a    LET Pairwise(f,g,Op(_,_)) == [ e \\in DOMAIN f |-> Op(f[e], g[e]) ]\0a    IN \0a    [\0a        active |-> active,\0a        pending |-> pending,\0a        color |-> color,\0a        counter |-> counter,\0a        token |-> token,\0a\0a        TokenInits  |-> TLCGetAndSet(0, +, IF InitiateProbe THEN 1 ELSE 0, 0),\0a        \0a        TokenPasses |-> TLCGetAndSet(1, +, IF \\E i \\in Nodes: PassToken(i) THEN 1 ELSE 0, 0),\0a\0a        Activations |-> TLCGetAndSet(2, \0a                            LAMBDA o, v: Pairwise(o, v, +), \0a                                        [ n \\in Nodes |-> IF ~active[n] /\\ active\'[n] THEN 1 ELSE 0 ],\0a                            [ n \\in Nodes |-> 0 ]),\0a                            \0a        Activations2|-> TLCGetAndSet(3, \0a                            LAMBDA o, v: [ n \\in Nodes |-> o[n] + IF ~v[n] /\\ v\'[n] THEN 1 ELSE 0 ], \0a                                        active,\0a                            [ n \\in Nodes |-> 0 ]),\0a\0a        Actives     |-> TLCGetAndSet(4, \\cup, {active}, {active}),\0a        \0a        SumQ        |-> TLCGetAndSet(5, +, token.q, 0),\0a        SumQP       |-> TLCGetAndSet(6, +, token.q\', 0)\0a    ]\0a\0a=============================================================================\0a'] ['Utils' '------------------------------- MODULE Utils -------------------------------\0aEXTENDS Integers, Sequences, FiniteSets\0a\0a\\* This are mostly copy&pasted from various TLA+ community modules at:\0a\\* https://github.com/tlaplus/CommunityModules/modules\0a\0aReduce(op(_,_), fun, from, to, base) == \0a  (**************************************************************************)\0a  (* Reduce the elements in the range from..to of the function\'s co-domain. *)\0a  (**************************************************************************)\0a  LET reduced[i \\in from..to] ==\0a          IF i = from THEN op(base, fun[i])\0a          ELSE op(reduced[i - 1], fun[i])\0a  IN reduced[to]\0a\0asum(a, b) ==\0a  a + b\0a\0aContains(s, e) ==\0a  (**************************************************************************)\0a  (* TRUE iff the element e \\in ToSet(s).                                   *)\0a  (**************************************************************************)\0a  \\E i \\in 1..Len(s) : s[i] = e\0a  \0aRemoveAt(s, i) == \0a  (**************************************************************************)\0a  (* Replaces the element at position i shortening the length of s by one.  *)\0a  (**************************************************************************)\0a  SubSeq(s, 1, i-1) \\o SubSeq(s, i+1, Len(s))\0a\0aRange(f) ==\0a  { f[x] : x \\in DOMAIN f }\0a\0a\\* No support for RECURSIVE in PlusPy.\0aIsSimpleCycle(S, r) ==\0a  (* View r as a graph s.t. S is the graph\'s set of vertices and there \0a     exists an edge from s to t iff f[s] = t. IsFiniteSet(DOMAIN r). *)\0a  LET \0a   F[ i \\in 1..Cardinality(S) ] == \0a         IF i = 1 THEN << CHOOSE s \\in S : TRUE >>\0a         ELSE LET seq == F[i-1]\0a                  head == Head(seq)\0a              IN << r[head] >> \\o F[i-1]\0a  IN Range(F[Cardinality(S)]) = S\0a\0a=============================================================================\0a']]]
      ['EWD998/Utils' 'Utils' %accept ~[['Utils' '------------------------------- MODULE Utils -------------------------------\0aEXTENDS Integers, Sequences, FiniteSets\0a\0a\\* This are mostly copy&pasted from various TLA+ community modules at:\0a\\* https://github.com/tlaplus/CommunityModules/modules\0a\0aReduce(op(_,_), fun, from, to, base) == \0a  (**************************************************************************)\0a  (* Reduce the elements in the range from..to of the function\'s co-domain. *)\0a  (**************************************************************************)\0a  LET reduced[i \\in from..to] ==\0a          IF i = from THEN op(base, fun[i])\0a          ELSE op(reduced[i - 1], fun[i])\0a  IN reduced[to]\0a\0asum(a, b) ==\0a  a + b\0a\0aContains(s, e) ==\0a  (**************************************************************************)\0a  (* TRUE iff the element e \\in ToSet(s).                                   *)\0a  (**************************************************************************)\0a  \\E i \\in 1..Len(s) : s[i] = e\0a  \0aRemoveAt(s, i) == \0a  (**************************************************************************)\0a  (* Replaces the element at position i shortening the length of s by one.  *)\0a  (**************************************************************************)\0a  SubSeq(s, 1, i-1) \\o SubSeq(s, i+1, Len(s))\0a\0aRange(f) ==\0a  { f[x] : x \\in DOMAIN f }\0a\0a\\* No support for RECURSIVE in PlusPy.\0aIsSimpleCycle(S, r) ==\0a  (* View r as a graph s.t. S is the graph\'s set of vertices and there \0a     exists an edge from s to t iff f[s] = t. IsFiniteSet(DOMAIN r). *)\0a  LET \0a   F[ i \\in 1..Cardinality(S) ] == \0a         IF i = 1 THEN << CHOOSE s \\in S : TRUE >>\0a         ELSE LET seq == F[i-1]\0a                  head == Head(seq)\0a              IN << r[head] >> \\o F[i-1]\0a  IN Range(F[Cardinality(S)]) = S\0a\0a=============================================================================\0a']]]
      ['Echo/MCEcho' 'MCEcho' %accept ~[['MCEcho' '---------- MODULE MCEcho ----------\0aEXTENDS Echo, TLC\0a\0a\\* A tiny graph with three nodes.\0aN1 == {"a", "b", "c"}\0a\0a\\* We don\'t care which node gets\0a\\* picked as the initiator.\0aI1 == CHOOSE n \\in N1 : TRUE\0a\0a\\* The tiny graph is fully meshed: \0a\\*      <<"a", "a">> :> FALSE @@\0a\\*      <<"a", "b">> :> TRUE  @@\0a\\*      <<"b", "a">> :> TRUE  @@\0a\\*      <<"b", "b">> :> FALSE @@\0a\\*      <<"a", "c">> :> TRUE @@\0a\\*      <<"c", "a">> :> TRUE @@\0a\\*      <<"b", "c">> :> TRUE  @@\0a\\*      <<"c", "b">> :> TRUE  @@\0a\\*      <<"c", "c">> :> FALSE\0a\\* More concisely defined as:\0aR1 == [ edge \\in (N1 \\X N1) |-> IF edge[1] = edge[2] \0a                                THEN FALSE\0a                                ELSE TRUE ]\0a\0a\\* To get a graph that satisfies the\0a\\* assumptions in Echo, we simply \0a\\* define R to be:\0aR2 == CHOOSE r \\in [ N1 \\X N1 -> BOOLEAN ] : \0a        /\\ IsConnected(r, N1)\0a        /\\ IsSymmetric(r, N1)\0a        /\\ IsIrreflexive(r, N1)\0a\0a\\* Print R to stdout at startup.\0aTestSpec == PrintT(R) /\\ Spec\0a\0aView ==\0a\09vars\0a\0aPostCondition ==\0a    TLCSet(42, TLCGet("generated"))\0a==================================='] ['Echo' '-------------------------------- MODULE Echo --------------------------------\0a(***************************************************************************)\0a(* The Echo algorithm for constructing a spanning tree in an undirected    *)\0a(* graph starting from a single initiator, as a PlusCal algorithm.         *)\0a(***************************************************************************)\0aEXTENDS Naturals, FiniteSets, Relation, TLC\0a\0aCONSTANTS Node,      \\* set of nodes\0a          initiator, \\* single initiator, will be the root of the tree\0a          R          \\* neighborhood relation, represented as a Boolean function over nodes \0a\0aASSUME /\\ initiator \\in Node\0a       /\\ R \\in [Node \\X Node -> BOOLEAN]\0a       \\* No edge from a node to itself (self-loops).\0a       /\\ IsIrreflexive(R, Node)\0a       \\* Undirected graph (there exists an edge from b \0a       \\* to a if there exists an edge from a to b).\0a       /\\ IsSymmetric(R, Node)\0a       \\* There exists a spanning tree consisting of *all* nodes.\0a       \\* (no forest of spanning trees). \0a       /\\ IsConnected(R, Node)\0a\0aNoNode == CHOOSE x : x \\notin Node\0aneighbors(n) == { m \\in Node : R[m,n] }\0a\0a(**\0a--algorithm Echo {\0a    variable inbox = [n \\in Node |-> {}];  \\* model communication between nodes\0a    define { \\* sending and receiving messages\0a      \\* network obtained from net when p sends message of kind knd to q\0a      send(net, p, q, knd) == [net EXCEPT ![q] = @ \\cup {[kind |-> knd, sndr |-> p]}]\0a      \\* network obtained from net when p receives a message\0a      receive(net, p, msg) == [net EXCEPT ![p] = @ \\ {msg}]\0a      \\* network obtained from net when p send message of kind knd to all nodes in dest\0a      multicast(net, p, dest, knd) ==\0a        [m \\in Node |-> IF m \\in dest THEN net[m] \\cup {[kind |-> knd, sndr |-> p]}\0a                        ELSE net[m]]\0a    }\0a\0a  process (node \\in Node) \0a    variables parent = NoNode,\0a              children = {},\0a              rcvd = 0,\0a              nbrs = neighbors(self);        {\0a  n0: if (self = initiator) {\0a         \\* initiator sends first message to all its neighbors\0a         inbox := multicast(inbox, self, nbrs, "m")\0a      };\0a  n1: while (rcvd < Cardinality(nbrs)) {\0a         \\* receive some message from a neighbor\0a         with (msg \\in inbox[self],\0a               net = receive(inbox, self, msg)) {\0a            rcvd := rcvd+1;\0a            if (self # initiator /\\ rcvd = 1) {\0a               assert(msg.kind = "m");  \\* the first received message is always of type "m"\0a               \\* note the sender as the node\'s parent and send an "m" message to all remaining neighbors\0a               parent := msg.sndr;\0a               inbox := multicast(net, self, nbrs \\ {msg.sndr}, "m")\0a            }\0a            else {\0a               \\* subsequent messages are counted but don\'t give rise to another message\0a               inbox := net\0a            };\0a            if (msg.kind = "c") { children := children \\cup {msg.sndr} }\0a         }  \\* end with\0a      }; \\* end while\0a  n2: if (self # initiator) {\0a         \\* when non-initiator has received messages from all neighbors, acknowledge\0a         \\* child relationship to the parent\0a         assert(parent \\in nbrs);\0a         inbox := send(inbox, self, parent, "c")\0a      }\0a  } \\* end process\0a}\0a**)\0a\\* BEGIN TRANSLATION\0aVARIABLES inbox, pc\0a\0a(* define statement *)\0asend(net, p, q, knd) == [net EXCEPT ![q] = @ \\cup {[kind |-> knd, sndr |-> p]}]\0a\0areceive(net, p, msg) == [net EXCEPT ![p] = @ \\ {msg}]\0a\0amulticast(net, p, dest, knd) ==\0a  [m \\in Node |-> IF m \\in dest THEN net[m] \\cup {[kind |-> knd, sndr |-> p]}\0a                  ELSE net[m]]\0a\0aVARIABLES parent, children, rcvd, nbrs\0a\0avars == << inbox, pc, parent, children, rcvd, nbrs >>\0a\0aProcSet == (Node)\0a\0aInit == (* Global variables *)\0a        /\\ inbox = [n \\in Node |-> {}]\0a        (* Process node *)\0a        /\\ parent = [self \\in Node |-> NoNode]\0a        /\\ children = [self \\in Node |-> {}]\0a        /\\ rcvd = [self \\in Node |-> 0]\0a        /\\ nbrs = [self \\in Node |-> neighbors(self)]\0a        /\\ pc = [self \\in ProcSet |-> "n0"]\0a\0an0(self) == /\\ pc[self] = "n0"\0a            /\\ IF self = initiator\0a                  THEN /\\ inbox\' = multicast(inbox, self, nbrs[self], "m")\0a                  ELSE /\\ TRUE\0a                       /\\ inbox\' = inbox\0a            /\\ pc\' = [pc EXCEPT ![self] = "n1"]\0a            /\\ UNCHANGED << parent, children, rcvd, nbrs >>\0a\0an1(self) == /\\ pc[self] = "n1"\0a            /\\ IF rcvd[self] < Cardinality(nbrs[self])\0a                  THEN /\\ \\E msg \\in inbox[self]:\0a                            LET net == receive(inbox, self, msg) IN\0a                              /\\ rcvd\' = [rcvd EXCEPT ![self] = rcvd[self]+1]\0a                              /\\ IF self # initiator /\\ rcvd\'[self] = 1\0a                                    THEN /\\ Assert((msg.kind = "m"), \0a                                                   "Failure of assertion at line 50, column 16.")\0a                                         /\\ parent\' = [parent EXCEPT ![self] = msg.sndr]\0a                                         /\\ inbox\' = multicast(net, self, nbrs[self] \\ {msg.sndr}, "m")\0a                                    ELSE /\\ inbox\' = net\0a                                         /\\ UNCHANGED parent\0a                              /\\ IF msg.kind = "c"\0a                                    THEN /\\ children\' = [children EXCEPT ![self] = children[self] \\cup {msg.sndr}]\0a                                    ELSE /\\ TRUE\0a                                         /\\ UNCHANGED children\0a                       /\\ pc\' = [pc EXCEPT ![self] = "n1"]\0a                  ELSE /\\ pc\' = [pc EXCEPT ![self] = "n2"]\0a                       /\\ UNCHANGED << inbox, parent, children, rcvd >>\0a            /\\ nbrs\' = nbrs\0a\0an2(self) == /\\ pc[self] = "n2"\0a            /\\ IF self # initiator\0a                  THEN /\\ Assert((parent[self] \\in nbrs[self]), \0a                                 "Failure of assertion at line 65, column 10.")\0a                       /\\ inbox\' = send(inbox, self, parent[self], "c")\0a                  ELSE /\\ TRUE\0a                       /\\ inbox\' = inbox\0a            /\\ pc\' = [pc EXCEPT ![self] = "Done"]\0a            /\\ UNCHANGED << parent, children, rcvd, nbrs >>\0a\0anode(self) == n0(self) \\/ n1(self) \\/ n2(self)\0a\0a(* Allow infinite stuttering to prevent deadlock on termination. *)\0aTerminating == /\\ \\A self \\in ProcSet: pc[self] = "Done"\0a               /\\ UNCHANGED vars\0a\0aNext == (\\E self \\in Node: node(self))\0a           \\/ Terminating\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aTermination == <>(\\A self \\in ProcSet: pc[self] = "Done")\0a\0a\\* END TRANSLATION\0a\0a(***************************************************************************)\0a(* Correctness properties.                                                 *)\0a(***************************************************************************)\0aTypeOK ==\0a  /\\ parent \\in [Node -> (Node \\cup {NoNode})]\0a  /\\ children \\in [Node -> SUBSET Node]\0a  /\\ rcvd \\in [Node -> Nat]\0a  /\\ nbrs \\in [Node -> SUBSET Node]\0a  /\\ \\A n \\in Node : nbrs[n] = neighbors(n) /\\ rcvd[n] <= Cardinality(nbrs[n])\0a  /\\ inbox \\in [Node -> SUBSET [kind : {"m","c"}, sndr : Node]]\0a  /\\ \\A n \\in Node : \\A msg \\in inbox[n] : msg.sndr \\in nbrs[n]\0a\0a\0a(* The initiator never has a parent *)\0aInitiatorNoParent == parent[initiator] = NoNode\0a\0a(* If a node has a parent, it is a neighbor node *)\0aParentIsNeighbor == \\A n \\in Node : parent[n] \\in neighbors(n) \\cup {NoNode}\0a\0a(* A node n is a child of node m only if m is the parent of n.\0a   At the end of the computation, this is "if and only if". *)\0aParentChild == \\A m,n \\in Node :\0a  /\\ n \\in children[m] => m = parent[n]\0a  /\\ m = parent[n] /\\ pc[m] = "Done" => n \\in children[m]\0a\0a(* Compute the ancestor relation *)\0aIsParent == [m,n \\in Node |-> n = parent[m]]\0aIsAncestor == TransitiveClosure(IsParent, Node)\0a\0a(* At the end of the computation, the initiator is an ancestor of every other node\0a   and the ancestor relation is acyclic.\0a   Beware: evaluating this property over any but tiny graphs is costly.\0a*)\0aAncestorProperties ==\0a  (\\A n \\in Node : pc[n] = "Done")\0a  => LET anc == IsAncestor\0a     IN  /\\ \\A n \\in Node \\ {initiator} : anc[n, initiator]\0a         /\\ IsIrreflexive(anc, Node)\0a\0aDebugExpression(self) ==\0a\09self # initiator\0a\0aDebugExpression2(self) ==\0a\09self = initiator\0a\0aNotNotTypeOK ==\0a\09~~TypeOK\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Wed Jun 17 09:23:17 PDT 2020 by markus\0a\\* Last modified Sun Jun 14 17:11:39 CEST 2020 by merz\0a\\* Created Tue Apr 26 09:42:23 CEST 2016 by merz\0a'] ['Relation' '----------------------------- MODULE Relation ------------------------------\0aEXTENDS Naturals, FiniteSets\0a\0a(***************************************************************************)\0a(* This module provides some basic operations on relations, represented    *)\0a(* as binary Boolean functions over some set S.                            *)\0a(***************************************************************************)\0a\0a(***************************************************************************)\0a(* Is the relation R reflexive over S?                                     *)\0a(***************************************************************************)\0aIsReflexive(R, S) == \\A x \\in S : R[x,x]\0a\0a(***************************************************************************)\0a(* Is the relation R irreflexive over set S?                               *)\0a(***************************************************************************)\0aIsIrreflexive(R, S) == \\A x \\in S : ~ R[x,x]\0a\0a(***************************************************************************)\0a(* Is the relation R symmetric over set S?                                 *)\0a(***************************************************************************)\0aIsSymmetric(R, S) == \\A x,y \\in S : R[x,y] <=> R[y,x]\0a\0a(***************************************************************************)\0a(* Is the relation R asymmetric over set S?                                *)\0a(***************************************************************************)\0aIsAsymmetric(R, S) == \\A x,y \\in S : ~(R[x,y] /\\ R[y,x])\0a\0a(***************************************************************************)\0a(* Is the relation R transitive over set S?                                *)\0a(***************************************************************************)\0aIsTransitive(R, S) == \\A x,y,z \\in S : R[x,y] /\\ R[y,z] => R[x,z]\0a\0a(***************************************************************************)\0a(* Compute the transitive closure of relation R over set S.                *)\0a(***************************************************************************)\0aTransitiveClosure(R, S) ==\0a  LET N == Cardinality(S)\0a      trcl[n \\in Nat] == \0a          [x,y \\in S |-> IF n=0 THEN R[x,y]\0a                         ELSE \\/ trcl[n-1][x,y]\0a                              \\/ \\E z \\in S : trcl[n-1][x,z] /\\ trcl[n-1][z,y]]\0a  IN  trcl[N]\0a\0a(***************************************************************************)\0a(* Compute the reflexive transitive closure of relation R over set S.      *)\0a(***************************************************************************)\0aReflexiveTransitiveClosure(R, S) ==\0a  LET trcl == TransitiveClosure(R,S)\0a  IN  [x,y \\in S |-> x=y \\/ trcl[x,y]]\0a\0a(***************************************************************************)\0a(* Is the relation R connected over set S, i.e. does there exist a path    *)\0a(* between two arbitrary elements of S?                                    *)\0a(***************************************************************************)\0aIsConnected(R, S) ==\0a  LET rtrcl == ReflexiveTransitiveClosure(R,S)\0a  IN  \\A x,y \\in S : rtrcl[x,y]\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Sun Jun 14 15:32:47 CEST 2020 by merz\0a\\* Created Tue Apr 26 10:24:07 CEST 2016 by merz\0a']]]
      ['Echo/Relation' 'Relation' %accept ~[['Relation' '----------------------------- MODULE Relation ------------------------------\0aEXTENDS Naturals, FiniteSets\0a\0a(***************************************************************************)\0a(* This module provides some basic operations on relations, represented    *)\0a(* as binary Boolean functions over some set S.                            *)\0a(***************************************************************************)\0a\0a(***************************************************************************)\0a(* Is the relation R reflexive over S?                                     *)\0a(***************************************************************************)\0aIsReflexive(R, S) == \\A x \\in S : R[x,x]\0a\0a(***************************************************************************)\0a(* Is the relation R irreflexive over set S?                               *)\0a(***************************************************************************)\0aIsIrreflexive(R, S) == \\A x \\in S : ~ R[x,x]\0a\0a(***************************************************************************)\0a(* Is the relation R symmetric over set S?                                 *)\0a(***************************************************************************)\0aIsSymmetric(R, S) == \\A x,y \\in S : R[x,y] <=> R[y,x]\0a\0a(***************************************************************************)\0a(* Is the relation R asymmetric over set S?                                *)\0a(***************************************************************************)\0aIsAsymmetric(R, S) == \\A x,y \\in S : ~(R[x,y] /\\ R[y,x])\0a\0a(***************************************************************************)\0a(* Is the relation R transitive over set S?                                *)\0a(***************************************************************************)\0aIsTransitive(R, S) == \\A x,y,z \\in S : R[x,y] /\\ R[y,z] => R[x,z]\0a\0a(***************************************************************************)\0a(* Compute the transitive closure of relation R over set S.                *)\0a(***************************************************************************)\0aTransitiveClosure(R, S) ==\0a  LET N == Cardinality(S)\0a      trcl[n \\in Nat] == \0a          [x,y \\in S |-> IF n=0 THEN R[x,y]\0a                         ELSE \\/ trcl[n-1][x,y]\0a                              \\/ \\E z \\in S : trcl[n-1][x,z] /\\ trcl[n-1][z,y]]\0a  IN  trcl[N]\0a\0a(***************************************************************************)\0a(* Compute the reflexive transitive closure of relation R over set S.      *)\0a(***************************************************************************)\0aReflexiveTransitiveClosure(R, S) ==\0a  LET trcl == TransitiveClosure(R,S)\0a  IN  [x,y \\in S |-> x=y \\/ trcl[x,y]]\0a\0a(***************************************************************************)\0a(* Is the relation R connected over set S, i.e. does there exist a path    *)\0a(* between two arbitrary elements of S?                                    *)\0a(***************************************************************************)\0aIsConnected(R, S) ==\0a  LET rtrcl == ReflexiveTransitiveClosure(R,S)\0a  IN  \\A x,y \\in S : rtrcl[x,y]\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Sun Jun 14 15:32:47 CEST 2020 by merz\0a\\* Created Tue Apr 26 10:24:07 CEST 2016 by merz\0a']]]
      ['EvalOrder/Base' 'Base' %accept ~[['Base' '-------------------------------- MODULE Base --------------------------------\0aVARIABLES clk\0avars == <<clk>>\0a\0aInit == clk = 0\0a        \0aSpec == Init /\\ [][UNCHANGED vars]_vars\0a\0a=============================================================================\0a']]]
      ['EvalOrder/InitEvalOrder' 'InitEvalOrder' %accept ~[['InitEvalOrder' '--------------------------- MODULE InitEvalOrder ---------------------------\0aVARIABLE Clk1\0aS1 == INSTANCE Base  WITH  clk <- Clk1\0a\0aVARIABLE Clk2\0aS2 == INSTANCE Base  WITH  clk <- Clk2\0a\0aSpec1 == \0a       /\\ S1!Init /\\ S2!Init /\\ (Clk2 = Clk1)\0a       /\\ [][UNCHANGED <<Clk1, Clk2>>]_<<S1!vars, S2!vars>>\0a\0aSpec2 == \0a       /\\ S2!Init /\\ S1!Init /\\ (Clk1 = Clk2)\0a       /\\ [][UNCHANGED <<Clk1, Clk2>>]_<<S1!vars, S2!vars>>\0a\0aSpec3 == \0a       /\\ S1!Init /\\ S2!Init /\\ (Clk1 = Clk2)\0a       /\\ [][UNCHANGED <<Clk1, Clk2>>]_<<S1!vars, S2!vars>>\0a\0aSpec4 == \0a       /\\ S2!Init /\\ S1!Init /\\ (Clk2 = Clk1)\0a       /\\ [][UNCHANGED <<Clk1, Clk2>>]_<<S1!vars, S2!vars>>\0a=============================================================================\0a'] ['Base' '-------------------------------- MODULE Base --------------------------------\0aVARIABLES clk\0avars == <<clk>>\0a\0aInit == clk = 0\0a        \0aSpec == Init /\\ [][UNCHANGED vars]_vars\0a\0a=============================================================================\0a']]]
      ['EvalOrder/InitEvalOrderBasic' 'InitEvalOrderBasic' %accept ~[['InitEvalOrderBasic' '--------------------------- MODULE InitEvalOrderBasic ---------------------------\0aVARIABLES x, y\0a\0aSpec == /\\ (y=0) /\\ (x=0) /\\ (y = x)\0a        /\\ [][UNCHANGED <<x,y>>]_<<x,y>>\0a=============================================================================\0a']]]
      ['Loop/SystemLoop' 'SystemLoop' %accept ~[['SystemLoop' '----------------------------- MODULE SystemLoop -----------------------------\0a\0a(* System LOOP as described by Manna & Pneuli on page 423ff *)\0a\0aVARIABLES x\0avars == <<x>>\0a\0aInit == x = 0\0a\0aOne == x = 0 /\\ x\' = 1\0aTwo == x = 1 /\\ x\' = 2\0aThree == x = 2 /\\ x\' = 3\0aBack == x = 3 /\\ x\' = 0\0a\0aNext == One \\/ Two \\/ Three \\/ Back\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aSpecWeakFair == Spec /\\ WF_vars(Next)\0a\0aLiveness == []<>(x=3)\0a\0aneg_Liveness == ~(Liveness)\0a\0aXInitZero == <>(x = 0)\0a\0aTautology == (vars = vars) ~> (vars = vars)\0a=============================================================================\0a']]]
      ['ModuleOverwrites/ModuleOverwrites' 'ModuleOverwrites' %accept ~[['ModuleOverwrites' '-------------------------- MODULE ModuleOverwrites --------------------------\0aEXTENDS Integers, Sequences\0a\0aVARIABLES t\0a\0aInit == t = [ i \\in 1..10 |-> i ]\0a\0aNext == t\' = t\0a\0a-----------------------------------------------------------------------------\0a\0anoDupesOverwrite(arr, emp) == FALSE\0a\0aInvAsModuleOverwrite == noDupesOverwrite(t, -1)\0a\0a-----------------------------------------------------------------------------\0a\0anoDupesOverwriteLinear(arr, emp) == FALSE\0a\0aInvAsModuleOverwriteLinear == noDupesOverwriteLinear(t, -1)\0a\0a-----------------------------------------------------------------------------\0a\0anoDupes(arr, emp) == LET sub == SelectSeq(t, LAMBDA e: e # -1)\0a                         abs(number) == IF number < 0 THEN -1 * number ELSE number\0a                     IN IF Len(sub) < 2 THEN TRUE\0a                        ELSE \\A i \\in 1..(Len(sub) - 1):\0a                                \\A j \\in (i+1)..Len(sub):\0a                                   abs(sub[i]) # abs(sub[j]) \0a\0aInvNoModuleOverwrite == noDupes(t, -1)\0a=============================================================================\0a']]]
      ['PrintTraceRace/MC' 'MC' %accept ~[['MC' '---- MODULE MC ----\0aEXTENDS PrintTraceRace, TLC\0a\0a\\* INIT definition @modelBehaviorInit:0\0ainit_143958263805435000 ==\0aTestInit\0a----\0a\\* NEXT definition @modelBehaviorNext:0\0anext_143958263806436000 ==\0aTestNext\0a----\0a\\* INVARIANT definition @modelCorrectnessInvariants:0\0ainv_143958263807437000 ==\0aTestTypeInv\0a----\0a=============================================================================\0a'] ['PrintTraceRace' '---------------------- MODULE PrintTraceRace -------------------------\0aEXTENDS Naturals, Sequences\0aVARIABLES S\0a\0aTestTypeInv == S \\in [ q: Seq({1..2}),\0a                       i: 0..3]\0a\0aTestInit == S = [q |->  << >>,\0a                 i |-> 1]\0a\0aSend == /\\ (S.i \\leq 2)\0a        /\\ (S\' = [S EXCEPT !.i = (S.i + 1),!.q = Append(S.q,S.i)])\0a\0aDone == /\\ S.i > 2\0a        /\\ UNCHANGED << S >>\0a\0aTestNext == \\/ Send\0a            \\/ Done\0a============================================================']]]
      ['PrintTraceRace/PrintTraceRace' 'PrintTraceRace' %accept ~[['PrintTraceRace' '---------------------- MODULE PrintTraceRace -------------------------\0aEXTENDS Naturals, Sequences\0aVARIABLES S\0a\0aTestTypeInv == S \\in [ q: Seq({1..2}),\0a                       i: 0..3]\0a\0aTestInit == S = [q |->  << >>,\0a                 i |-> 1]\0a\0aSend == /\\ (S.i \\leq 2)\0a        /\\ (S\' = [S EXCEPT !.i = (S.i + 1),!.q = Append(S.q,S.i)])\0a\0aDone == /\\ S.i > 2\0a        /\\ UNCHANGED << S >>\0a\0aTestNext == \\/ Send\0a            \\/ Done\0a============================================================']]]
      ['TESpecTest/TESpecDeadlockTest' 'TESpecDeadlockTest' %accept ~[['TESpecDeadlockTest' '---------- MODULE TESpecDeadlockTest -----------\0a\0aEXTENDS Naturals\0a\0aVARIABLES x, y\0a\0aInit ==\0a    /\\ x = 0\0a    /\\ y = FALSE\0a\0aNext ==\0a    /\\ x <= 3\0a    /\\ x\' = x + 1\0a    /\\ y\' = ~y\0a\0aSpec ==\0a    /\\ Init\0a    /\\ [][Next]_<<x, y>>\0a\0a==============================================\0a']]]
      ['TESpecTest/TESpecNoErrorTest' 'TESpecNoErrorTest' %accept ~[['TESpecNoErrorTest' '---------- MODULE TESpecNoErrorTest -----------\0a\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aInit == x = 0\0a\0aNext ==\0a    \\/  /\\ x < 3\0a        /\\ x\' = x + 1\0a    \\/  /\\ x >= 3\0a        /\\ UNCHANGED x\0a\0aSpec ==\0a    /\\ Init\0a    /\\ [][Next]_<<x>>\0a\0a==============================================\0a']]]
      ['TESpecTest/TESpecPlusCalTest' 'TESpecPlusCalTest' %accept ~[['TESpecPlusCalTest' '---------- MODULE TESpecPlusCalTest -----------\0a\0aEXTENDS Naturals, TLC\0a\0a(* --algorithm Steps\0avariables x = 1, y = FALSE;\0abegin\0a    while TRUE do\0a        x := x + 1;\0a        y := ~y;\0a        assert x < 5;\0a    end while;\0aend algorithm; *)\0a\\* BEGIN TRANSLATION (chksum(pcal) = "2f1a7a64" /\\ chksum(tla) = "93b619e3")\0aVARIABLES x, y\0a\0avars == << x, y >>\0a\0aInit == (* Global variables *)\0a        /\\ x = 1\0a        /\\ y = FALSE\0a\0aNext == /\\ x\' = x + 1\0a        /\\ y\' = ~y\0a        /\\ Assert(x\' < 5, "Failure of assertion at line 11, column 9.")\0a\0aSpec == Init /\\ [][Next]_vars\0a\0a\\* END TRANSLATION \0a\0a==============================================\0a']]]
      ['TESpecTest/TESpecRuntimeErrorTest' 'TESpecRuntimeErrorTest' %accept ~[['TESpecRuntimeErrorTest' '---------- MODULE TESpecRuntimeErrorTest -----------\0a\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aInit == x = [val |-> 0]\0a\0aNext ==\0a    \\/  /\\ x.val < 3\0a        /\\ x\' = [val |-> x.val + 1]\0a    \\/  /\\ x.val >= 3\0a        /\\ x\' = [val2 |-> x.val + 1]\0a\0aSpec ==\0a    /\\ Init\0a    /\\ [][Next]_<<x>>\0a\0a==============================================\0a']]]
      ['TESpecTest/TESpecTest' 'TESpecTest' %accept ~[['TESpecTest' '---------- MODULE TESpecTest -----------\0a\0aEXTENDS Naturals\0a\0aCONSTANT Limit\0a\0aASSUME Limit \\in Nat\0a\0aVARIABLES x, y\0a\0aSafety ==\0a    /\\ x /= Limit\0a\0aLiveness ==\0a    /\\ <>(x = Limit)\0a\0aInit ==\0a    /\\ x = 0\0a    /\\ y = FALSE\0a\0aIncrement ==\0a    /\\ x\' = x + 1\0a    /\\ y\' = ~y\0a\0aDecrement ==\0a    /\\ x > 0\0a    /\\ x\' = x - 1\0a    /\\ y\' = ~y\0a\0aNext ==\0a    \\/ Increment\0a    \\/ Decrement\0a\0aSpec ==\0a    /\\ Init\0a    /\\ [][Next]_<<x, y>>\0a\0aLiveSpec ==\0a    /\\ Init\0a    /\\ [][Next]_<<x, y>>\0a    /\\ WF_<<x, y>>(Increment)\0a\0aEqAlias ==\0a    [x |-> x,\0a    y |-> y]\0a\0aMapAlias ==\0a    [x |-> x + 1,\0a    y |-> ~y]\0a\0aSupersetAlias ==\0a    [x |-> x,\0a    y |-> y,\0a    z |-> ~y]\0a\0aSubsetAlias ==\0a    [x |-> x]\0a\0a==============================================\0a']]]
      ['TSnapShot/MC' 'MC' %accept ~[['MC' '---- MODULE MC ----\0aEXTENDS TSnapShot, TLC\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0aw1\0a----\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0ar1\0a----\0a\0a\\* MV CONSTANT definitions Writer\0aconst_1446808092434108000 == \0a{w1}\0a----\0a\0a\\* MV CONSTANT definitions Reader\0aconst_1446808092444109000 == \0a{r1}\0a----\0a\0a\\* CONSTANT definition @modelParameterDefinitions:0\0adef_ov_1446808092454110000 ==\0a0..2\0a----\0a\\* CONSTRAINT definition @modelParameterContraint:0\0aconstr_1446808092464111000 ==\0aLET maxNat == CHOOSE n \\in Nat : \\A m \\in Nat : n >= m IN\0a\\A w \\in Writer : iwriter[w] < maxNat\0a----\0a\\* Constant expression definition @modelExpressionEval\0aconst_expr_1446808092474112000 == \0a(w1 :> (w1 :> (w1 :> 0)) @@ r1 :> (w1 :> (w1 :> 0))) \\in [Process -> [Writer -> Memory]]\0a----\0a\0a\\* Constant expression ASSUME statement @modelExpressionEval\0aASSUME PrintT(<<"$!@$!@$!@$!@$!",const_expr_1446808092474112000>>)\0a----\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_1446808092484113000 ==\0aSpec\0a----\0a\\* INVARIANT definition @modelCorrectnessInvariants:0\0ainv_1446808092494114000 ==\0aTypeOK2\0a----\0a=============================================================================\0a\\* Modification History\0a\\* Created Fri Nov 06 12:08:12 CET 2015 by markus\0a'] ['TSnapShot' '----------------------------- MODULE TSnapShot -----------------------------\0a(****************************************************************************\0aThis spec describes an algorithm by Afek et al. described in\0a\0a   https://en.wikipedia.org/wiki/Shared_snapshot_objects\0a   \0aThis is the unbounded memory algorithm described there.\0a\0aThis implementation satisfies the TSnapSpec spec, with internal\0avariables hidden.  \0a****************************************************************************)\0aEXTENDS Integers, TLC\0a\0aCONSTANTS Reader, Writer\0a\0aASSUME Reader \\cap Writer = { }\0a\0aProcess == Reader \\cup Writer\0a(***************************************************************************)\0a(* To make it easier to modify the spec to one in which processes write    *)\0a(* values in some arbitrary set, we write `Value\' instead of `Nat\'.        *)\0a(***************************************************************************)\0aValue == Nat\0aMemory == [Writer -> Value]\0aInitMemory == [w \\in Writer |-> 0]\0aNotAMemory ==  [w \\in Writer |-> -1]\0a\0aVARIABLES \0a  rstate,  wstate,  \\* These variables are the same as in TSnapSpec, since\0a                    \\* they describe the externally visible state.\0a  rwstate,          \\* Like rstate, except has a copy for the writer\'s state\0a                    \\* of reading as well\0a  mem, iwriter,     \\* The same as in TSnapSpec\0a  snap,             \\* snap[w] is the last snapshot value obtained by\0a                    \\* writer w during its read. \0a  \\* The following are arrays indexed by Reader \\cup Writer, since\0a  \\* both readers and writers perform a read operation.\0a  rd1, rd2,         \\* Two arrays of arrays holding the values obtained in \0a                    \\* the two reads.\0a  (*view1,*) view2, \\* Two arrays of arrays holding the snap obtained in \0a                    \\* the second reads.\0a  notRd1, notRd2,   \\* Two arrays holding the sets of writers whose values\0a                    \\* haven\'t yet been read by each of the reads.\0a  moved             \\* moved[r][w] is the number of times different\0a                    \\* values of mem[w] have been read by r during its\0a                    \\* current read operation.\0a \0avars ==  <<rstate, wstate, rwstate, mem, iwriter, rd1, rd2, \0a           (*view1,*) view2, notRd1, notRd2, moved, snap>>\0a            \0aTypeOK == (* /\\ rstate  \\in [Reader -> Memory \\cup {NotAMemory}]\0a          /\\ wstate  \\in [Writer -> {"idle", "busy"}]\0a          /\\ rwstate \\in [Process -> Memory \\cup {NotAMemory}]\0a          /\\ mem     \\in Memory\0a          /\\ iwriter \\in [Writer -> Nat]\0a          /\\ snap    \\in [Writer -> Memory]\0a          /\\ rd1     \\in [Process -> Memory]\0a          /\\ rd2     \\in [Process -> Memory] *)\0a\\*          /\\ view1   \\in [Process -> [Writer -> Memory]]\0a          /\\ view2   \\in [Process -> [Writer -> Memory]]\0a(*          /\\ notRd1  \\in [Process -> SUBSET Writer]\0a          /\\ notRd2  \\in [Process -> SUBSET Writer]\0a          /\\ moved   \\in [Process -> [Writer -> BOOLEAN]] *)\0aTypeOK2 == view2   \\in [Process -> [Writer -> Memory]]\0aInit == /\\ rstate  = [r \\in Reader |-> InitMemory]\0a        /\\ rwstate = [r \\in Process |-> InitMemory]\0a        /\\ wstate  = [r \\in Writer |-> "idle"]\0a        /\\ mem     = InitMemory\0a        /\\ iwriter = [r \\in Writer |-> 0]\0a        /\\ rd1     = [r \\in Process |-> InitMemory]\0a        /\\ rd2     = [r \\in Process |-> InitMemory]\0a\\*        /\\ view1   = [r \\in Process |-> [w \\in Writer |-> Memory]]\0a        /\\ view2   = [r \\in Process |-> [w \\in Writer |-> InitMemory]]\0a        /\\ notRd1  = [r \\in Process |-> Writer]\0a        /\\ notRd2  = [r \\in Process |-> Writer]\0a        /\\ moved   = [r \\in Process |-> [w \\in Writer |-> FALSE]]\0a        /\\ snap    = [r \\in Writer |-> InitMemory]\0a\0aTypeOK3 == PrintT(TypeOK2)\0a(***************************************************************************)\0a(* Define Assign(array, idx, val) to essentially mean                      *)\0a(*                                                                         *)\0a(*   array[idx] := val                                                     *)\0a(*                                                                         *)\0a(* so the reader of the spec doesn\'t have to deal with EXCEPT.             *)\0a(***************************************************************************)\0aAssign(array, idx, val) == array\' = [array EXCEPT ![idx] = val]\0a\0a(***************************************************************************)\0a(* Define Assign(array, idx1, idx2, val) to essentially mean               *)\0a(*                                                                         *)\0a(*   array[idx1][idx2] := val                                              *)\0a(*                                                                         *)\0a(* so the reader of the spec doesn\'t have to deal with EXCEPT.             *)\0a(***************************************************************************)\0aAAssign(array, idx1, idx2, val) == array\' = [array EXCEPT ![idx1][idx2] = val]\0a\0a \0aBeginRead(r) == /\\ rstate[r] # NotAMemory\0a                /\\ Assign(rstate, r, NotAMemory)\0a                /\\ Assign(rwstate, r, NotAMemory)\0a                /\\ UNCHANGED <<wstate, mem, iwriter, rd1, rd2, \0a                               view2, notRd1, notRd2, moved, snap>>\0a                    \0a\\*vars ==  <<rstate, wstate, rwstate, mem, iwriter, rd1, rd2, \0a\\*           (*view1,*) view2, notRd1, notRd2, moved, snap>>\0aDoRd1(r) == /\\ rwstate[r] = NotAMemory\0a            /\\ \\E w \\in notRd1[r] : /\\ Assign(notRd1, r, notRd1[r] \\ {w})\0a                                    /\\ AAssign(rd1, r, w, mem[w])\0a\\*                                    /\\ AAssign(view1, r, w, scan[w])\0a            /\\ UNCHANGED <<rstate, rwstate, wstate, mem, iwriter, rd2, view2, notRd2,\0a                           moved, snap>>\0a            \0aDoRd2(r) == /\\ (rwstate[r] = NotAMemory) /\\ (notRd1[r] = {})\0a            /\\ \\E w \\in notRd2[r] : /\\ Assign(notRd2, r, notRd2[r] \\ {w})\0a                                    /\\ AAssign(rd2, r, w, mem[w])\0a                                    /\\ AAssign(view2, r, w, snap[w])\0a            /\\ UNCHANGED <<rstate, rwstate, wstate, mem, iwriter, rd1, notRd1,\0a                           moved, snap>>\0a\0aTryEnding(r) == /\\ (rwstate[r] = NotAMemory) /\\ (notRd1[r] = {})\0a                /\\ IF rd1[r] = rd2[r] \0a                     THEN Assign(rwstate, r, rd1[r]) \0a                     ELSE LET F(w) == /\\ rd1[r][w] # rd2[r][w]\0a                                      /\\ moved[r][w]\0a                          IN  IF \\E w \\in Writer : F(w)\0a                                THEN Assign(rwstate,r, \0a                                            view2[CHOOSE w \\in Writer : F(w)])\0a                                ELSE /\\ UNCHANGED rwstate\0a                                     /\\ moved[r] = [w \\in Writer |-> \0a                                                     moved[r] \\/ (rd1[r][w] # rd2[r][w])]\0a                /\\ IF r \\in Reader\0a                     THEN Assign(rstate, r, rwstate\'[r])\0a                     ELSE UNCHANGED rstate\0a                /\\ Assign(moved, r, [w \\in Writer |-> FALSE])            \0a                /\\ Assign(notRd1, r, Writer)  \0a                /\\ Assign(notRd2, r, Writer)    \0a                /\\ Assign(rd1, r, InitMemory)   \\* To reduce state space\0a                /\\ Assign(rd2, r, InitMemory)   \\* To reduce state space\0a                /\\ Assign(view2, r, InitMemory) \\* To reduce state space     \0a                /\\ UNCHANGED <<wstate, mem, snap, iwriter>>\0a\0a\0aBeginWrite(w) == /\\ wstate[w] = "idle"\0a                 /\\ Assign(wstate, w, "busy")\0a                 /\\ Assign(iwriter, w, iwriter[w] + 1)\0a                 /\\ Assign(rwstate, w, NotAMemory)\0a                 /\\ UNCHANGED <<rstate, mem, rd1, rd2, view2, notRd1, notRd2, moved, snap>>\0a                 \0aDoWrite(w) == /\\ iwriter[w] # mem[w]\0a              /\\ rwstate[w] # NotAMemory\0a              /\\ Assign(mem, w, mem[w]+1)\0a              /\\ Assign(snap, w, rwstate[w])\0a              /\\ UNCHANGED <<rstate, wstate, iwriter, rd1, rd2, view2, notRd1, \0a                             notRd2, moved>>\0a              \0aEndWrite(w) == /\\ wstate[w] = "busy"\0a               /\\ Assign(wstate, w, "idle")\0a               /\\ UNCHANGED <<rstate, rwstate, mem, snap, iwriter, rd1, rd2, \0a                              view2, notRd1, notRd2, moved>>\0a\0aNext == \\/ \\E w \\in Writer : BeginWrite(w) \\/ DoWrite(w) \\/ EndWrite(w)\0a        \\/ \\E r \\in Reader : \0a              BeginRead(r) \\/ DoRd1(r) \\/ DoRd2(r) \\/ TryEnding(r)\0a\0aSpec == Init /\\ [][Next]_vars                     \0a=============================================================================\0a\\* Modification History\0a\\* Last modified Mon Nov 02 18:16:48 PST 2015 by lamport\0a\\* Created Mon Nov 02 13:33:53 PST 2015 by lamport\0a']]]
      ['TSnapShot/TSnapShot' 'TSnapShot' %accept ~[['TSnapShot' '----------------------------- MODULE TSnapShot -----------------------------\0a(****************************************************************************\0aThis spec describes an algorithm by Afek et al. described in\0a\0a   https://en.wikipedia.org/wiki/Shared_snapshot_objects\0a   \0aThis is the unbounded memory algorithm described there.\0a\0aThis implementation satisfies the TSnapSpec spec, with internal\0avariables hidden.  \0a****************************************************************************)\0aEXTENDS Integers, TLC\0a\0aCONSTANTS Reader, Writer\0a\0aASSUME Reader \\cap Writer = { }\0a\0aProcess == Reader \\cup Writer\0a(***************************************************************************)\0a(* To make it easier to modify the spec to one in which processes write    *)\0a(* values in some arbitrary set, we write `Value\' instead of `Nat\'.        *)\0a(***************************************************************************)\0aValue == Nat\0aMemory == [Writer -> Value]\0aInitMemory == [w \\in Writer |-> 0]\0aNotAMemory ==  [w \\in Writer |-> -1]\0a\0aVARIABLES \0a  rstate,  wstate,  \\* These variables are the same as in TSnapSpec, since\0a                    \\* they describe the externally visible state.\0a  rwstate,          \\* Like rstate, except has a copy for the writer\'s state\0a                    \\* of reading as well\0a  mem, iwriter,     \\* The same as in TSnapSpec\0a  snap,             \\* snap[w] is the last snapshot value obtained by\0a                    \\* writer w during its read. \0a  \\* The following are arrays indexed by Reader \\cup Writer, since\0a  \\* both readers and writers perform a read operation.\0a  rd1, rd2,         \\* Two arrays of arrays holding the values obtained in \0a                    \\* the two reads.\0a  (*view1,*) view2, \\* Two arrays of arrays holding the snap obtained in \0a                    \\* the second reads.\0a  notRd1, notRd2,   \\* Two arrays holding the sets of writers whose values\0a                    \\* haven\'t yet been read by each of the reads.\0a  moved             \\* moved[r][w] is the number of times different\0a                    \\* values of mem[w] have been read by r during its\0a                    \\* current read operation.\0a \0avars ==  <<rstate, wstate, rwstate, mem, iwriter, rd1, rd2, \0a           (*view1,*) view2, notRd1, notRd2, moved, snap>>\0a            \0aTypeOK == (* /\\ rstate  \\in [Reader -> Memory \\cup {NotAMemory}]\0a          /\\ wstate  \\in [Writer -> {"idle", "busy"}]\0a          /\\ rwstate \\in [Process -> Memory \\cup {NotAMemory}]\0a          /\\ mem     \\in Memory\0a          /\\ iwriter \\in [Writer -> Nat]\0a          /\\ snap    \\in [Writer -> Memory]\0a          /\\ rd1     \\in [Process -> Memory]\0a          /\\ rd2     \\in [Process -> Memory] *)\0a\\*          /\\ view1   \\in [Process -> [Writer -> Memory]]\0a          /\\ view2   \\in [Process -> [Writer -> Memory]]\0a(*          /\\ notRd1  \\in [Process -> SUBSET Writer]\0a          /\\ notRd2  \\in [Process -> SUBSET Writer]\0a          /\\ moved   \\in [Process -> [Writer -> BOOLEAN]] *)\0aTypeOK2 == view2   \\in [Process -> [Writer -> Memory]]\0aInit == /\\ rstate  = [r \\in Reader |-> InitMemory]\0a        /\\ rwstate = [r \\in Process |-> InitMemory]\0a        /\\ wstate  = [r \\in Writer |-> "idle"]\0a        /\\ mem     = InitMemory\0a        /\\ iwriter = [r \\in Writer |-> 0]\0a        /\\ rd1     = [r \\in Process |-> InitMemory]\0a        /\\ rd2     = [r \\in Process |-> InitMemory]\0a\\*        /\\ view1   = [r \\in Process |-> [w \\in Writer |-> Memory]]\0a        /\\ view2   = [r \\in Process |-> [w \\in Writer |-> InitMemory]]\0a        /\\ notRd1  = [r \\in Process |-> Writer]\0a        /\\ notRd2  = [r \\in Process |-> Writer]\0a        /\\ moved   = [r \\in Process |-> [w \\in Writer |-> FALSE]]\0a        /\\ snap    = [r \\in Writer |-> InitMemory]\0a\0aTypeOK3 == PrintT(TypeOK2)\0a(***************************************************************************)\0a(* Define Assign(array, idx, val) to essentially mean                      *)\0a(*                                                                         *)\0a(*   array[idx] := val                                                     *)\0a(*                                                                         *)\0a(* so the reader of the spec doesn\'t have to deal with EXCEPT.             *)\0a(***************************************************************************)\0aAssign(array, idx, val) == array\' = [array EXCEPT ![idx] = val]\0a\0a(***************************************************************************)\0a(* Define Assign(array, idx1, idx2, val) to essentially mean               *)\0a(*                                                                         *)\0a(*   array[idx1][idx2] := val                                              *)\0a(*                                                                         *)\0a(* so the reader of the spec doesn\'t have to deal with EXCEPT.             *)\0a(***************************************************************************)\0aAAssign(array, idx1, idx2, val) == array\' = [array EXCEPT ![idx1][idx2] = val]\0a\0a \0aBeginRead(r) == /\\ rstate[r] # NotAMemory\0a                /\\ Assign(rstate, r, NotAMemory)\0a                /\\ Assign(rwstate, r, NotAMemory)\0a                /\\ UNCHANGED <<wstate, mem, iwriter, rd1, rd2, \0a                               view2, notRd1, notRd2, moved, snap>>\0a                    \0a\\*vars ==  <<rstate, wstate, rwstate, mem, iwriter, rd1, rd2, \0a\\*           (*view1,*) view2, notRd1, notRd2, moved, snap>>\0aDoRd1(r) == /\\ rwstate[r] = NotAMemory\0a            /\\ \\E w \\in notRd1[r] : /\\ Assign(notRd1, r, notRd1[r] \\ {w})\0a                                    /\\ AAssign(rd1, r, w, mem[w])\0a\\*                                    /\\ AAssign(view1, r, w, scan[w])\0a            /\\ UNCHANGED <<rstate, rwstate, wstate, mem, iwriter, rd2, view2, notRd2,\0a                           moved, snap>>\0a            \0aDoRd2(r) == /\\ (rwstate[r] = NotAMemory) /\\ (notRd1[r] = {})\0a            /\\ \\E w \\in notRd2[r] : /\\ Assign(notRd2, r, notRd2[r] \\ {w})\0a                                    /\\ AAssign(rd2, r, w, mem[w])\0a                                    /\\ AAssign(view2, r, w, snap[w])\0a            /\\ UNCHANGED <<rstate, rwstate, wstate, mem, iwriter, rd1, notRd1,\0a                           moved, snap>>\0a\0aTryEnding(r) == /\\ (rwstate[r] = NotAMemory) /\\ (notRd1[r] = {})\0a                /\\ IF rd1[r] = rd2[r] \0a                     THEN Assign(rwstate, r, rd1[r]) \0a                     ELSE LET F(w) == /\\ rd1[r][w] # rd2[r][w]\0a                                      /\\ moved[r][w]\0a                          IN  IF \\E w \\in Writer : F(w)\0a                                THEN Assign(rwstate,r, \0a                                            view2[CHOOSE w \\in Writer : F(w)])\0a                                ELSE /\\ UNCHANGED rwstate\0a                                     /\\ moved[r] = [w \\in Writer |-> \0a                                                     moved[r] \\/ (rd1[r][w] # rd2[r][w])]\0a                /\\ IF r \\in Reader\0a                     THEN Assign(rstate, r, rwstate\'[r])\0a                     ELSE UNCHANGED rstate\0a                /\\ Assign(moved, r, [w \\in Writer |-> FALSE])            \0a                /\\ Assign(notRd1, r, Writer)  \0a                /\\ Assign(notRd2, r, Writer)    \0a                /\\ Assign(rd1, r, InitMemory)   \\* To reduce state space\0a                /\\ Assign(rd2, r, InitMemory)   \\* To reduce state space\0a                /\\ Assign(view2, r, InitMemory) \\* To reduce state space     \0a                /\\ UNCHANGED <<wstate, mem, snap, iwriter>>\0a\0a\0aBeginWrite(w) == /\\ wstate[w] = "idle"\0a                 /\\ Assign(wstate, w, "busy")\0a                 /\\ Assign(iwriter, w, iwriter[w] + 1)\0a                 /\\ Assign(rwstate, w, NotAMemory)\0a                 /\\ UNCHANGED <<rstate, mem, rd1, rd2, view2, notRd1, notRd2, moved, snap>>\0a                 \0aDoWrite(w) == /\\ iwriter[w] # mem[w]\0a              /\\ rwstate[w] # NotAMemory\0a              /\\ Assign(mem, w, mem[w]+1)\0a              /\\ Assign(snap, w, rwstate[w])\0a              /\\ UNCHANGED <<rstate, wstate, iwriter, rd1, rd2, view2, notRd1, \0a                             notRd2, moved>>\0a              \0aEndWrite(w) == /\\ wstate[w] = "busy"\0a               /\\ Assign(wstate, w, "idle")\0a               /\\ UNCHANGED <<rstate, rwstate, mem, snap, iwriter, rd1, rd2, \0a                              view2, notRd1, notRd2, moved>>\0a\0aNext == \\/ \\E w \\in Writer : BeginWrite(w) \\/ DoWrite(w) \\/ EndWrite(w)\0a        \\/ \\E r \\in Reader : \0a              BeginRead(r) \\/ DoRd1(r) \\/ DoRd2(r) \\/ TryEnding(r)\0a\0aSpec == Init /\\ [][Next]_vars                     \0a=============================================================================\0a\\* Modification History\0a\\* Last modified Mon Nov 02 18:16:48 PST 2015 by lamport\0a\\* Created Mon Nov 02 13:33:53 PST 2015 by lamport\0a']]]
      ['VoteProof/FiniteSets' 'FiniteSets' %accept ~[['FiniteSets' '---------------------------- MODULE FiniteSets -----------------------------\0aLOCAL INSTANCE Naturals\0aLOCAL INSTANCE Sequences\0a  (*************************************************************************)\0a  (* Imports the definitions from Naturals and Sequences, but doesn\'t      *)\0a  (* export them.                                                          *)\0a  (*************************************************************************)\0a\0aIsFiniteSet(S) == \0a  (*************************************************************************)\0a  (* A set S is finite iff there is a finite sequence containing all its   *)\0a  (* elements.                                                             *)\0a  (*************************************************************************)\0a  \\E seq \\in Seq(S) : \\A s \\in S : \\E n \\in 1..Len(seq) : seq[n] = s\0a\0aCardinality(S) ==\0a  (*************************************************************************)\0a  (* Cardinality is defined only for finite sets.                          *)\0a  (*************************************************************************)\0a  LET CS[T \\in SUBSET S] == IF T = {} THEN 0\0a                                      ELSE 1 + CS[T \\ {CHOOSE x : x \\in T}]\0a  IN  CS[S]\0a=============================================================================\0a']]]
      ['cdot/ActionComposition' 'ActionComposition' %accept ~[['ActionComposition' '------ MODULE ActionComposition ------\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aInit ==\0a    x = 0\0a\0aA ==\0a    \\/ /\\ x  \\in {0}\0a       /\\ x\' \\in {1, 2, 3}\0a    \\/ /\\ x  \\in {4}\0a       /\\ x\' \\in {5}\0a\0aB ==\0a    \\/ /\\ x  \\in {1, 2}\0a       /\\ x\' \\in {2, 4}\0a    \\/ /\\ x  \\in {5}\0a       /\\ x\' \\in {6}\0a\0aNext ==\0a    A \\cdot B\0a\0aSpec ==\0a    Init /\\ [][Next]_x\0a\0aInv ==\0a    x \\in {0, 1, 2, 4, 6}\0a\0aInv2 ==\0a\09x < 3 \\/ ENABLED Next\0a\0aProp ==\0a\09[][~(B \\cdot A)]_x\0a\0aProp2 ==\0a\09[][Next]_x\0a\0aActionConstraint ==\0a    <<Next>>_x\0a======\0a']]]
      ['cdot/CdotWithContextA' 'CdotWithContextA' %accept ~[['CdotWithContextA' '-------- MODULE CdotWithContextA ---------\0aEXTENDS Naturals\0a\0aVARIABLE x, S\0a\0aInit ==\0a    x = 0 /\\ S = {1,2}\0a\0aA(n) ==\0a    /\\ x\' = n\0a    /\\ UNCHANGED S\0a    \0a\0aB(n) ==\0a    /\\ x\' = n + 1\0a\09/\\ UNCHANGED S\0a\0aNext ==\0a\09/\\ x = 0\0a    /\\ \\E n \\in S :\0a          /\\ n \\in S\0a          /\\ A(n) \\cdot B(n)\0a\0aSpec ==\0a    Init /\\ [][Next]_<<S, x>>\0a\0a=======']]]
      ['cdot/CdotWithContextB' 'CdotWithContextB' %accept ~[['CdotWithContextB' '-------- MODULE CdotWithContextB ---------\0aEXTENDS Naturals\0a\0aVARIABLE x, S\0a\0aInit ==\0a    x = 0 /\\ S = {1,2}\0a\0aA(n) ==\0a    x\' = n\0a\0aB(n) ==\0a    x\' = n + 1\0a\0aNext ==\0a\09/\\ x = 0\0a\09/\\ UNCHANGED S\0a    /\\ \\E n \\in S :\0a          /\\ n \\in S\0a          /\\ A(n) \\cdot B(n)\0a\0aSpec ==\0a    Init /\\ [][Next]_<<S,x>>\0a\0aProp ==\0a\09[][Next]_<<S,x>>\0a\0aProp2 ==\0a\09ENABLED Next\0a\0a=======']]]
      ['cdot/CdotWithContextC' 'CdotWithContextC' %accept ~[['CdotWithContextC' '-------- MODULE CdotWithContextC ---------\0aEXTENDS Naturals\0a\0aVARIABLE x, S\0a\0aInit ==\0a    x = 0 /\\ S = {1,2}\0a\0aA(n) ==\0a    x\' = n\0a\0aB(n) ==\0a    /\\ x\' = n + 1\0a\0aNext ==\0a\09/\\ x = 0\0a    /\\ \\E n \\in S :\0a          /\\ n \\in S\0a          /\\ A(n) \\cdot B(n)\0a          /\\ UNCHANGED S\0a\0aSpec ==\0a    Init /\\ [][Next]_<<S, x>>\0a\0a=======']]]
      ['cdot/CdotWithContextD' 'CdotWithContextD' %accept ~[['CdotWithContextD' '-------- MODULE CdotWithContextD ---------\0aEXTENDS Naturals\0a\0aVARIABLE x, S\0a\0aInit ==\0a    x = 0 /\\ S = {1,2}\0a\0aA(n) ==\0a    x\' = n\0a\0aB(n) ==\0a    x\' = n + 1\0a\0aNext ==\0a\09/\\ x = 0\0a\09/\\ UNCHANGED S\0a    /\\ \\E n \\in S :\0a          /\\ n \\in S\0a          /\\ ( A(n) /\\ S\' = {} ) \\cdot B(n) \\* Next false\0a\0aSpec ==\0a    Init /\\ [][Next]_<<S,x>>\0a\0aProp ==\0a\09[][Next]_<<S,x>>\0a\0aProp2 ==\0a\09~(ENABLED Next)\0a\0a=======']]]
      ['cdot/ChainedCdots' 'ChainedCdots' %accept ~[['ChainedCdots' '-------- MODULE ChainedCdots ---------\0aEXTENDS Naturals, TLC\0a\0aASSUME TLCSet(0, 0)\0a\0aVARIABLE x\0a\0aInit ==\0a    x = 0\0a\0aA(S) ==\0a\09\\E n \\in S:\0a\09\09/\\ x\' = x + n\0a\09\09/\\ TLCSet(0, TLCGet(0) + x\')\0a\0aNext ==\0a\09/\\ x = 0\0a    /\\ A({1,2}) \\cdot A({3,4}) \\cdot A({5})\0a\0aSpec ==\0a    Init /\\ [][Next]_x\0a\0aPostCondition ==\0a\09/\\ TLCSet(42, TLCGet("generated"))\0a\09/\\ TLCGet(0) = 63\0a\0a=======']]]
      ['checkpoint/InfiniteStateSpace' 'InfiniteStateSpace' %accept ~[['InfiniteStateSpace' '------------------------------ MODULE InfiniteStateSpace ------------------------------\0aEXTENDS Naturals\0a\0aVARIABLES x,y\0a\0aSpec == x = 0 /\\ y \\in 1..1000 /\\ [][x\'= x + 1 /\\ UNCHANGED y]_<<x,y>>\0a=============================================================================\0a']]]
      ['coverage/A' 'A' %accept ~[['A' '---------------------------- MODULE A ----------------------------\0aEXTENDS Naturals, FiniteSets\0aVARIABLE x\0a\0aOp1(S) == \\A e \\in SUBSET S : Cardinality(e) >= 0\0a\0aInit == /\\ x = 0\0a        /\\ Op1(1..17)\0a\0a\\* Max(s)\0aOp2(n) == CHOOSE i \\in 1..n : \\A j \\in ((1..n) \\ {i}) : i > j\0a\0aA(n) == x\' = Op2(n)\0a\0aB(n) == x\' = Op2(n)\0a\0aNext == A(10) \\/ B(3)\0a=============================================================================\0a']]]
      ['coverage/B' 'B' %accept ~[['B' '---------------------------- MODULE B ----------------------------\0aVARIABLE x\0a\0aInit == x = FALSE\0a\0aSwitch(var) == ~var\0a\0aA == x\' = Switch(x)\0a\0aB == x\' = Switch(x)\0a\0aNext == A \\/ B\0a=============================================================================\0a']]]
      ['coverage/C' 'C' %accept ~[['C' '---------------------------- MODULE C ----------------------------\0aEXTENDS Naturals, FiniteSets\0aVARIABLES x,y\0a\0ac == x\0ad == y\0a\0avars == <<x,y>>\0a\0aa == x\'\0a\0aOp(S) == \\A e \\in SUBSET S : Cardinality(e) >= 0\0a\0aInit == /\\ x \\in 1..3\0a        /\\ y = 0\0a\0aA == /\\ c \\in Nat\0a     /\\ y \\in Nat\0a     /\\ a = x + 1\0a     /\\ UNCHANGED y\0a\0aB == /\\ x \\in Nat\0a     /\\ Op(1..5)\0a     /\\ UNCHANGED <<x,d>>\0a\0aC == /\\ x = 42\0a     /\\ c\' = TRUE\0a     /\\ y\' = FALSE\0a\0aD == x\' \\in 0..x /\\ UNCHANGED y\0a\0aU1 == x < 0 /\\ UNCHANGED vars\0a\0aU2 == x < 0 /\\ UNCHANGED <<x,y>>\0a\0aU3 == x < 0 /\\ UNCHANGED x /\\ UNCHANGED y\0a\0aNext == A \\/ B \\/ C \\/ D \\/ U1 \\/ U2 \\/ U3\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aConstraint == x < 20\0a\0a(* Coverage/Cost statistics for Invariants too. *)\0a\0aexpensive(N) == \\A e \\in SUBSET (1..N) : \\A f \\in e : f \\in 1..N \0a\0aInv == /\\ x \\in Nat\0a       /\\ y \\in Nat\0a       /\\ expensive(8)\0a       /\\ LET frob == TRUE  \0a          IN /\\ frob = TRUE\0a             /\\ \\A i \\in 1..5: i \\in Nat \0a             /\\ 42 \\in Nat\0a\0aInv2 == /\\ x \\in Nat\0a        /\\ y \\in Nat\0a        /\\ expensive(9)\0a        /\\ LET frob == TRUE\0a           IN /\\ frob = TRUE\0a             /\\ \\A i \\in 1..5: i \\in Nat \0a              /\\ 42 \\in Nat\0a=============================================================================\0a']]]
      ['coverage/CoverageStatistics' 'CoverageStatistics' %accept ~[['CoverageStatistics' '---------------------------- MODULE CoverageStatistics ----------------------------\0aEXTENDS Naturals, FiniteSets\0aVARIABLES x,y\0a\0ac == x\0ad == y\0a\0avars == <<x,y>>\0a\0aa == x\'\0a\0aInit == /\\ x \\in 1..3\0a        /\\ y = 0\0a\0aA == /\\ c \\in Nat\0a     /\\ y \\in Nat\0a     /\\ a = x + 1\0a     /\\ UNCHANGED d \\* 18 should be covered (6 should be omitted)\0a\0aB == /\\ x \\in Nat\0a     /\\ UNCHANGED <<x,d>> \\* 21 and 6 should be covered (6 should actually be omitted)\0a\0aB2 == /\\ x \\in Nat\0a     /\\ UNCHANGED vars \\* 21 and 6 should be covered (6 should actually be omitted)\0a     \0aC == /\\ x = 42\0a     /\\ c\' = TRUE\0a     /\\ y\' = FALSE\0a\0aU1 == x < 0 /\\ UNCHANGED vars \\* vars should be reported as uncovered instead of x and y on line 8\0a\0aU2 == x < 0 /\\ UNCHANGED <<x,y>> \\* col 28 & 30 \0a\0aU3 == x < 0 /\\ UNCHANGED x /\\ UNCHANGED y \\* col 26 & 41\0a\0aU4 == x < 0 /\\ UNCHANGED x /\\ UNCHANGED d (* d itself instead of y is marked uncovered *)\0a\0aUC1 == x \\in Nat /\\ UNCHANGED <<x,y>>\0a\0aUC2 == x \\in Nat /\\ UNCHANGED x /\\ UNCHANGED y\0a\0aUC3 == x \\in Nat /\\ UNCHANGED vars \\* Do not mark vars on line 8 as covered\0a\0aNext == A \\/ B \\/ C \\/ U1 \\/ U2 \\/ U3 \\/ U4 \\/ UC1 \\/ UC2 \\/ UC3\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aConstraint == x < 20\0a\0a=============================================================================\0a']]]
      ['coverage/D' 'D' %accept ~[['D' '---------------------------- MODULE D ----------------------------\0aEXTENDS Naturals\0aVARIABLE x\0a\0aInit == x = 0\0a\0a(* No endless recursion in Coverage/Cost with RECURSIVE. *)\0aRECURSIVE fact(_)\0afact(n) == IF n = 1 THEN 1 ELSE n * fact(n - 1)\0a\0aA == x\' = fact(3)\0a\0aB == x\' = fact(9)\0a\0aNext == A \\/ B\0a\0aSpec == Init /\\ [][Next]_<<x>>\0a=============================================================================\0a']]]
  ==
::
++  test-sany-sub-2
  %+  expect-eq
    !>  ^-  (list @t)
    :~  'examples/SingleLaneBridge/SingleLaneBridge -> hoon=reject'  'gh1134/MultiUser -> hoon=reject'  'gh1134/SingleUser -> hoon=reject'
    ==
  !>
  %-  sub-batch-run
  ^-  (list [@t @t ?(%accept %reject) (list [@t @t])])
  :~
      ['coverage/E' 'E' %accept ~[['E' '---------------------------- MODULE E ----------------------------\0aCONSTANT Op(_)\0a\0aVARIABLE x\0a\0aId(n) == SUBSET {1,2,3}\0a\0aForty2(n) == Id(n)\0a\0aInit == x = 0\0a\0aNext == x\' \\in Op(x)\0a=============================================================================\0a']]]
      ['coverage/F' 'F' %accept ~[['F' '---------------------------- MODULE F ----------------------------\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aOp(S, P(_), Q(_, _)) == { s \\in S : P(s) /\\ Q(s, TRUE) }\0a\0aInit == x \\in Op({1,2,3,4,5}, LAMBDA s: s > 1, LAMBDA odd, b: odd % 2 # 0 /\\ b) \0a\0aNext == UNCHANGED x\0a=============================================================================\0a']]]
      ['coverage/G' 'G' %accept ~[['G' '---------------------------- MODULE G ----------------------------\0aVARIABLES u1\0a\0avars == << u1 >>\0a\0aInit == /\\ u1 = TRUE\0a\0aNext == /\\ UNCHANGED vars\0a        /\\ UNCHANGED <<u1>>\0a        /\\ UNCHANGED u1\0a\0aProp == ENABLED Next\0a=============================================================================\0a']]]
      ['coverage/Github377' 'Github377' %accept ~[['Github377' '---- MODULE Github377 ----\0aEXTENDS Integers\0aVARIABLES x\0a\0aSpec == x = TRUE /\\ [][UNCHANGED x]_x\0a\0a--------------\0a\0a1Inv ==\0a LET recfcn[ i \\in {1,2,3} ] == IF i = 1 THEN x = TRUE ELSE recfcn[1]\0a IN recfcn[1]\0a\0a--------------\0a\0a1InvNonRec ==\0a LET recfcn[ i \\in {1,2,3} ] == x = TRUE\0a IN recfcn[1]\0a\0a--------------\0a\0a2Inv ==\0a  LET outer ==\0a      LET innerA[ i \\in {1} ] == IF i = 1 THEN x = TRUE ELSE innerA[i]\0a          innerB[ i \\in {1} ] == innerA[i] \0a      IN innerB[1] /\\ 42 = 31 + 11 /\\ innerA[1]\0a  IN  outer\0a\0a2aInv ==\0a  LET outer ==\0a      LET innerA[ i \\in {1} ] == IF i = 1 THEN x = TRUE ELSE innerA[i]\0a          innerB[ i \\in {1} ] == innerA[i]\0a      IN /\\ innerA[1]\0a         /\\ innerB[1] \0a  IN  outer\0a  \0a2bInv ==\0a  LET outer ==\0a      LET innerA[ i \\in {1} ] == IF i = 1 THEN x = TRUE ELSE innerA[i]\0a          innerB[ i \\in {1} ] == innerA[i]\0a      IN innerA[1] /\\ innerB[1]\0a  IN  outer\0a--------------\0a\0a3aInv ==\0a  LET outer ==\0a      LET innerA[ i \\in {1} ] == IF i = 1 THEN x = TRUE ELSE innerA[i]\0a          innerB[ i \\in {1} ] == innerA[1]\0a      IN /\\ LET foo(i) == innerA[i]\0a            IN foo(1)\0a         /\\ innerB[1] \0a  IN  outer\0a\0a--------------\0a\0a3bInv ==\0a  LET outer ==\0a      LET innerA[ i \\in {1} ] == IF i = 1 THEN x = TRUE ELSE innerA[i]\0a          innerB[ i \\in {1} ] == innerA[1]\0a      IN LET foo(i) == innerA[i]\0a         IN foo(1) /\\ innerB[1] \0a  IN  outer\0a  \0a\0a--------------\0a\0a4Inv ==\0a  LET outer ==\0a      LET inner[ i \\in {1} ] ==\0a          LET innerst[ j \\in {1} ] == x = TRUE\0a          IN  innerst[1]\0a      IN  inner[1]\0a  IN  outer\0a  \0a====\0a  ']]]
      ['coverage/Github649' 'Github649' %accept ~[['Github649' '---- MODULE Github649 ----\0aEXTENDS Naturals\0a\0aVARIABLE clock\0a\0aRECURSIVE Check(_,_)\0aCheck(c,n) == IF n = 0 THEN c \\in BOOLEAN ELSE Check(c, n - 1)\0a\0aTypeOK == Check(clock,1)\0a\0aRECURSIVE Flip(_,_,_)\0aFlip(v, b, n) == IF n = 0 THEN v = ~b ELSE Flip(v, b, n - 1)\0a\0aInit == Flip(clock, FALSE, 1)  \\* The expression Flip(..) does *not* appear in the coverage result. Some of its parameters are covered (invoked),\0a                               \\* but the Flip(..) itself gets skipped over by TLC.  It correctly does not get marked as uncovered.\0aNext == clock\' = ~clock\0a\0aConstraint ==\0a    Flip(clock, ~clock, 2)\0a====']]]
      ['coverage/H' 'H' %accept ~[['H' '------------------------------ MODULE H ------------------------------\0aEXTENDS Naturals\0aVARIABLES x\0a\0aMyNat == 0..30\0a\0aTypeOK == x \\in MyNat\0a\0aInit == x = 0\0a\0aA == x\' = 23\0a\0aBandC == \\/ /\\ x \\in MyNat\0a            /\\ x\' \\in 23..25\0a         \\/ /\\ x < 25\0a            /\\ x\' = 26\0a\0aDandE == (x = 23 /\\ x\' = 42) \\/ (x = 123 /\\ x\' = 4711)\0a\0aNext == A \\/ BandC \\/ DandE\0a\0aInv == /\\ TypeOK\0a       /\\ x = 0\0a\0aSpec == Inv /\\ [][Next]_x\0a\0a============\0a']]]
      ['coverage/I' 'I' %accept ~[['I' '------------------------------ MODULE I ------------------------------\0aEXTENDS Naturals\0aVARIABLES x\0a\0aF[ i \\in {1,2,3,4,5} ] == \0a   IF i = 1 THEN 1 ELSE F[i-1] + 1 \\* Recursive Function Definition\0a\0aN[n \\in {1,2,3}] == \0a    /\\ UNCHANGED <<x>>\0a\0aSpec == x \\in {1,2,3,4,5} /\\ [][\\E i \\in {1,2,3} : N[i] ]_x\0a\0aInv == \\E i \\in DOMAIN F: F[i] = x\0a\0a============\0a']]]
      ['coverage/J' 'J' %accept ~[['J' '------------------------------ MODULE J ------------------------------\0a\0aVARIABLES x, y\0a\0aInit == /\\ x \\in {1,2,3,4,5}\0a        /\\ y = [i \\in {1,2,3,4,5} |-> 0]\0a\0aFoo(rcds) ==\0a CASE x = 1 -> [ rcds EXCEPT ![x] = 42 ]\0a   [] OTHER -> rcds\0a\0aNext == /\\ y\' = Foo(y)\0a        /\\ UNCHANGED x \0a\0aSpec == Init /\\ [][Next]_<<x,y>>\0a============\0a']]]
      ['coverage/K' 'K' %accept ~[['K' '------------------------------ MODULE K ------------------------------\0a\0aEXTENDS Naturals\0a\0aFoo(Op(_), S) == \\A s \\in S: Op(s)\0a\0aBar(S) == Foo(LAMBDA e: e \\in Nat, S)\0a\0aVARIABLE x\0a\0aSpec == x = Bar({1,2,3}) /\\ [][UNCHANGED x]_x \0a============\0a']]]
      ['coverage/L' 'L' %accept ~[['L' '------------------------------ MODULE L ------------------------------\0aEXTENDS Naturals\0a\0aVARIABLE v\0a\0aChooseOne(S, P(_)) == CHOOSE x \\in S : P(x) /\\ \\A y \\in S : P(y)\0a\0aSpec == v = ChooseOne({1}, LAMBDA x : TRUE) /\\ [][UNCHANGED v]_v\0a\0a============\0a']]]
      ['coverage/M' 'M' %accept ~[['M' '------------------------------ MODULE M ------------------------------\0aEXTENDS Naturals, FiniteSets\0a\0aVARIABLES active, color, tpos, tcolor\0avars == <<active, color, tpos, tcolor>>\0a\0aNodes == 0 .. 2\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]    \\* status of nodes (active or passive)\0a  /\\ color \\in [Nodes -> Color]       \\* color of nodes\0a  /\\ tpos \\in Nodes                   \\* token position\0a  /\\ tcolor \\in Color                 \\* token color\0a\0aInit ==\0a  /\\ active \\in [{23,42,56} -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor = "black"\0a\0aNext ==\0a  /\\ active\' \\in [{23,42,56} -> BOOLEAN]\0a  /\\ color\' \\in [Nodes -> Color]\0a  /\\ tpos\' \\in Nodes\0a  /\\ tcolor\' = "black"\0a  \0aSpec ==\0a  Init /\\ [][Next]_vars\0a\0a============\0a']]]
      ['debug/Debug02' 'Debug02' %accept ~[['Debug02' '\0a  I didn\'t want to update the line numbers in the JUnit test.\0a\0a------------------------------- MODULE Debug02 -------------------------------\0aVARIABLE x\0aInit == x = TRUE\0aNext == x\' =~x\0aSpec == Init /\\ [][Next]_x\0aCONSTANT C\0aval == 42\0a==================================================================================\0a------------------------------- CONFIG Debug02 -------------------------------\0aSPECIFICATION Spec\0aCONSTANT C <- val\0a==================================================================================\0a']]]
      ['debug/Debug03' 'Debug03' %accept ~[['Debug03' '------------------------------- MODULE Debug03 -------------------------------\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aInit ==\0a    x \\in 0..1\0a\0aNext == \0a    /\\ x < 10\0a    /\\ x\' \\in 1..9\0a\0aSpec == \0a    Init /\\ [][Next]_x\0a\0a==================================================================================\0a------------------------------- CONFIG Debug03 -------------------------------\0aSPECIFICATION Spec\0a==================================================================================\0a']]]
      ['debug/Debug05' 'Debug05' %accept ~[['Debug05' '--------------------------------- MODULE Debug05 ---------------------------------\0aEXTENDS Naturals\0aVARIABLE b, i\0aInit == b = FALSE /\\ i = 1\0aNext == b\' \\in BOOLEAN /\\ i\' = i + 1\0aSpec == Init /\\ [][Next]_<<b, i>>\0a==================================================================================\0a--------------------------------- CONFIG Debug05 ---------------------------------\0aSPECIFICATION Spec\0a==================================================================================\0a']]]
      ['debug/ExpressionBreakpointTest' 'ExpressionBreakpointTest' %accept ~[['ExpressionBreakpointTest' '---- MODULE ExpressionBreakpointTest ----\0aEXTENDS Naturals\0aVARIABLE i\0aCONSTANT j\0aASSUME j \\in Nat\0aop(k) ==\0a  \\A l \\in 0 .. (j - k) :\0a    i \\in Nat\0aInv == op(5)\0aInit == i = 0\0aNext == IF i < j THEN i\' = i + 1 ELSE UNCHANGED i\0a====\0a---- CONFIG ExpressionBreakpointTest ----\0aCONSTANT j = 10\0aINVARIANTS Inv\0aINIT Init\0aNEXT Next\0a====\0a\0a']]]
      ['examples/BlockingQueue/BlockingQueuePoisonApple' 'BlockingQueuePoisonApple' %accept ~[['BlockingQueuePoisonApple' '---------------------- MODULE BlockingQueuePoisonApple ----------------------\0aEXTENDS Naturals, Sequences, FiniteSets, TLC, TLCExt\0a\0aCONSTANTS Producers,   (* the (nonempty) set of producers                       *)\0a          Consumers,   (* the (nonempty) set of consumers                       *)\0a          BufCapacity, (* the maximum number of messages in the bounded buffer  *)\0a          Poison\0a\0aASSUME Assumption ==\0a       /\\ Producers # {}                      (* at least one producer *)\0a       /\\ Consumers # {}                      (* at least one consumer *)\0a       /\\ Producers \\intersect Consumers = {} (* no thread is both consumer and producer *)\0a       /\\ BufCapacity \\in (Nat \\ {0})         (* buffer capacity is at least 1 *)\0a       \0a-----------------------------------------------------------------------------\0a\0a\\* prod maps each producer to its apple slices that it will eventually send to\0a\\* consumers. cons maps each consumer to the apple slices it has eaten so far. \0aVARIABLES prod, cons\0a\0a-----------------------------------------------------------------------------\0a\0aap ==\0a    \\* The set of active producers, i.e., producers that have yet to send out\0a    \\* some bites of their poison apple.\0a    {p \\in DOMAIN prod: prod[p] > 0} \\* <=> prod \\notin [P -> {0}]\0a\0aac == \0a    \\* The set of active consumers, i.e., consumers that have yet to take a\0a    \\* bite of poison apples before they die/can terminate.\0a    {c \\in DOMAIN cons: cons[c] > 0} \\* <=> cons \\notin [C -> {0}]\0a\0a-----------------------------------------------------------------------------\0a\0aVARIABLES buffer, waitSet\0avars == <<buffer, waitSet, prod, cons>>\0a\0aNotifyOther(Others) == \0a    IF waitSet \\cap Others # {}\0a    THEN \\E t \\in waitSet \\cap Others : waitSet\' = waitSet \\ {t}\0a    ELSE UNCHANGED waitSet\0a\0a(* @see java.lang.Object#wait *)\0aWait(t) == /\\ waitSet\' = waitSet \\cup {t}\0a           /\\ UNCHANGED <<buffer>>\0a\0a-----------------------------------------------------------------------------\0a\0a(* \0a  Contrary to PoisonPill, there is no dedicated "janitor" process that requires\0a  some form of *external* synchronization. Global termination is achieved without\0a  synchronizing producers.  Instead, the tradeoff of this variant is a tighter\0a  coupling between producers and consumers because producers *and* consumers\0a  need to know the number (cardinality) of the other role (see the definition of\0a  prod  and cons  in  Init  below to see why that is).\0a  Why is this complexity necessary, why can\'t we just have each producer send\0a  a poison pill to one consumer (and some producers send more than one pill iff\0a  |C| > |P|)? While this would work iff |C| >= |P|, it fails if |C| < |P|. Let\0a  P_p be the subset of P such that |P_p| = |C|, i.e. the producers that poison\0a  consumers. If one or more of the producers not in P_p remain active after all\0a  producers in P_p terminated, there are no (active) consumers left.\0a*)\0aPut(t, d) ==\0a    /\\ t \\notin waitSet\0a    \\* The Producer t must not have initiated its termination.\0a    /\\ prod[t] > 0\0a    /\\ \\/ /\\ Len(buffer) < BufCapacity\0a          /\\ \\/ /\\ buffer\' = Append(buffer, d)\0a                /\\ UNCHANGED prod\0a             \\/ /\\ buffer\' = Append(buffer, Poison)\0a                \\* Producer t messages one consumer.\0a                /\\ prod\' = [ prod EXCEPT ![t] = @ - 1]\0a          /\\ NotifyOther(Consumers)\0a       \\/ /\\ Len(buffer) = BufCapacity\0a          /\\ Wait(t)\0a          /\\ UNCHANGED prod\0a    /\\ UNCHANGED <<cons>>\0a   \0aGet(t) ==\0a/\\ t \\notin waitSet\0a/\\ cons[t] > 0\0a/\\ \\/ /\\ buffer # <<>>\0a      /\\ buffer\' = Tail(buffer)\0a      /\\ NotifyOther(Producers)\0a      /\\ \\/ /\\ Head(buffer) # Poison\0a            /\\ UNCHANGED <<prod,cons>>\0a         \\/ /\\ Head(buffer) = Poison\0a            /\\ cons\' = [ cons EXCEPT ![t] = @ - 1]\0a            /\\ UNCHANGED <<prod>>\0a   \\/ /\\ buffer = <<>>\0a      /\\ Wait(t)\0a      /\\ UNCHANGED <<prod,cons>>\0a\0a-----------------------------------------------------------------------------\0a\0a(* Initially, the buffer is empty and no thread is waiting. *)\0aInit == \0a    /\\ buffer = <<>>\0a    /\\ waitSet = {}\0a    \\* The system requires |C| * |P| poison pills to terminate reliably. Perhaps,\0a    \\* this is what Goetz et. al. mean by "unwiedly" on page 156 in their book\0a    \\* Java Concurrency in Practice. However, it is unclear why the authors write\0a    \\* on the same page that "Poison pills work reliably only with unbounded queues."\0a    /\\ cons = [ c \\in Consumers |-> Cardinality(Producers) ]\0a    /\\ prod = [ p \\in Producers |-> Cardinality(Consumers) ]\0a\0a(* Then, pick a thread out of all running threads and have it do its thing. *)\0aNext == \0a    \\/ \\E p \\in Producers: Put(p, p) \\* Add some data to buffer\0a    \\/ \\E c \\in Consumers: Get(c)\0a\0aSpec ==\0a    /\\ Init \0a    /\\ [][Next]_vars\0a    /\\ \\A c \\in Consumers : WF_vars(Get(c)) \0a    /\\ \\A p \\in Producers : WF_vars(Put(p, p))\0a\0a-----------------------------------------------------------------------------\0a\0a(* TLA+ is untyped, thus lets verify the range of some values in each state. *)\0aTypeInv == \0a    /\\ buffer \\in Seq(Producers \\cup {Poison})\0a    /\\ Len(buffer) \\in 0..BufCapacity\0a    /\\ waitSet \\in SUBSET (Producers \\cup Consumers)\0a    /\\ prod \\in [ Producers -> 0..Cardinality(Consumers) ]\0a    /\\ cons \\in [ Consumers -> 0..Cardinality(Producers) ]\0a\0a(* No Deadlock *)\0aNoDeadlock == waitSet # (Producers \\cup Consumers)\0a\0aTHEOREM Spec => [](TypeInv /\\ NoDeadlock)\0a-----------------------------------------------------------------------------\0a\0a\\* The queue is empty after (global) termination.\0aQueueEmpty ==\0a    []((ap \\cup ac) = {}) => (buffer = <<>>)\0a\0a\\* The system terminates iff all producers terminate.\0aGlobalTermination ==\0a    (ap = {}) ~> [](ac = {})\0a\0aTHEOREM Spec => QueueEmpty /\\ GlobalTermination\0a-----------------------------------------------------------------------------\0a\0aSSpec ==\0a    /\\ Init \0a    /\\ [][Next]_vars\0a    /\\ \\A c \\in Consumers : WF_vars(Get(c))\0a    \\* This fairness constraint causes all producers to eventually terminate.\0a    /\\ \\A p \\in Producers : SF_vars(Put(p, p) /\\ prod\' # prod)\0a\0aTerminates ==\0a    <>[](ap = {})\0a\0aTHEOREM SSpec => Terminates\0a\0aBufferInfOftenNonEmpty == \\A p \\in Producers: []<><<Put(p, p)>>_vars\0a\0aCONSTANT p1, p2, c1, c2\0aPostCondition ==\0a   CounterExample =\0a   [ action |->\0a      { << << 1,\0a              [ prod |-> (p1 :> 2 @@ p2 :> 2),\0a                cons |-> (c1 :> 2 @@ c2 :> 2),\0a                buffer |-> <<>>,\0a                waitSet |-> {} ] >>,\0a           [ name |-> "Put",\0a             location |->\0a                 [ beginLine |-> 64,\0a                   beginColumn |-> 5,\0a                   endLine |-> 77,\0a                   endColumn |-> 25,\0a                   module |-> "BlockingQueuePoisonApple" ],\0a             context |-> [t |-> p2, d |-> p2],\0a             parameters |-> <<"t", "d">> ],\0a           << 2,\0a              [ prod |-> (p1 :> 2 @@ p2 :> 1),\0a                cons |-> (c1 :> 2 @@ c2 :> 2),\0a                buffer |-> <<Poison>>,\0a                waitSet |-> {} ] >> >>,\0a        << << 2,\0a              [ prod |-> (p1 :> 2 @@ p2 :> 1),\0a                cons |-> (c1 :> 2 @@ c2 :> 2),\0a                buffer |-> <<Poison>>,\0a                waitSet |-> {} ] >>,\0a           [ name |-> "Get",\0a             location |->\0a                 [ beginLine |-> 80,\0a                   beginColumn |-> 1,\0a                   endLine |-> 92,\0a                   endColumn |-> 32,\0a                   module |-> "BlockingQueuePoisonApple" ],\0a             context |-> [t |-> c2],\0a             parameters |-> <<"t">> ],\0a           << 3,\0a              [ prod |-> (p1 :> 2 @@ p2 :> 1),\0a                cons |-> (c1 :> 2 @@ c2 :> 1),\0a                buffer |-> <<>>,\0a                waitSet |-> {} ] >> >>,\0a        << << 3,\0a              [ prod |-> (p1 :> 2 @@ p2 :> 1),\0a                cons |-> (c1 :> 2 @@ c2 :> 1),\0a                buffer |-> <<>>,\0a                waitSet |-> {} ] >>,\0a           [ name |-> "Put",\0a             location |->\0a                 [ beginLine |-> 64,\0a                   beginColumn |-> 5,\0a                   endLine |-> 77,\0a                   endColumn |-> 25,\0a                   module |-> "BlockingQueuePoisonApple" ],\0a             context |-> [t |-> p2, d |-> p2],\0a             parameters |-> <<"t", "d">> ],\0a           << 4,\0a              [ prod |-> (p1 :> 2 @@ p2 :> 0),\0a                cons |-> (c1 :> 2 @@ c2 :> 1),\0a                buffer |-> <<Poison>>,\0a                waitSet |-> {} ] >> >>,\0a        << << 4,\0a              [ prod |-> (p1 :> 2 @@ p2 :> 0),\0a                cons |-> (c1 :> 2 @@ c2 :> 1),\0a                buffer |-> <<Poison>>,\0a                waitSet |-> {} ] >>,\0a           [ name |-> "Get",\0a             location |->\0a                 [ beginLine |-> 80,\0a                   beginColumn |-> 1,\0a                   endLine |-> 92,\0a                   endColumn |-> 32,\0a                   module |-> "BlockingQueuePoisonApple" ],\0a             context |-> [t |-> c1],\0a             parameters |-> <<"t">> ],\0a           << 5,\0a              [ prod |-> (p1 :> 2 @@ p2 :> 0),\0a                cons |-> (c1 :> 1 @@ c2 :> 1),\0a                buffer |-> <<>>,\0a                waitSet |-> {} ] >> >>,\0a        << << 5,\0a              [ prod |-> (p1 :> 2 @@ p2 :> 0),\0a                cons |-> (c1 :> 1 @@ c2 :> 1),\0a                buffer |-> <<>>,\0a                waitSet |-> {} ] >>,\0a           [ name |-> "Put",\0a             location |->\0a                 [ beginLine |-> 64,\0a                   beginColumn |-> 5,\0a                   endLine |-> 77,\0a                   endColumn |-> 25,\0a                   module |-> "BlockingQueuePoisonApple" ],\0a             context |-> [t |-> p1, d |-> p1],\0a             parameters |-> <<"t", "d">> ],\0a           << 6,\0a              [ prod |-> (p1 :> 1 @@ p2 :> 0),\0a                cons |-> (c1 :> 1 @@ c2 :> 1),\0a                buffer |-> <<Poison>>,\0a                waitSet |-> {} ] >> >>,\0a        << << 6,\0a              [ prod |-> (p1 :> 1 @@ p2 :> 0),\0a                cons |-> (c1 :> 1 @@ c2 :> 1),\0a                buffer |-> <<Poison>>,\0a                waitSet |-> {} ] >>,\0a           [ name |-> "Put",\0a             location |->\0a                 [ beginLine |-> 64,\0a                   beginColumn |-> 5,\0a                   endLine |-> 77,\0a                   endColumn |-> 25,\0a                   module |-> "BlockingQueuePoisonApple" ],\0a             context |-> [t |-> p1, d |-> p1],\0a             parameters |-> <<"t", "d">> ],\0a           << 7,\0a              [ prod |-> (p1 :> 0 @@ p2 :> 0),\0a                cons |-> (c1 :> 1 @@ c2 :> 1),\0a                buffer |-> <<Poison, Poison>>,\0a                waitSet |-> {} ] >> >>,\0a        << << 7,\0a              [ prod |-> (p1 :> 0 @@ p2 :> 0),\0a                cons |-> (c1 :> 1 @@ c2 :> 1),\0a                buffer |-> <<Poison, Poison>>,\0a                waitSet |-> {} ] >>,\0a           [ name |-> "Get",\0a             location |->\0a                 [ beginLine |-> 80,\0a                   beginColumn |-> 1,\0a                   endLine |-> 92,\0a                   endColumn |-> 32,\0a                   module |-> "BlockingQueuePoisonApple" ],\0a             context |-> [t |-> c2],\0a             parameters |-> <<"t">> ],\0a           << 8,\0a              [ prod |-> (p1 :> 0 @@ p2 :> 0),\0a                cons |-> (c1 :> 1 @@ c2 :> 0),\0a                buffer |-> <<Poison>>,\0a                waitSet |-> {} ] >> >>,\0a        << << 8,\0a              [ prod |-> (p1 :> 0 @@ p2 :> 0),\0a                cons |-> (c1 :> 1 @@ c2 :> 0),\0a                buffer |-> <<Poison>>,\0a                waitSet |-> {} ] >>,\0a           [ name |-> "Get",\0a             location |->\0a                 [ beginLine |-> 80,\0a                   beginColumn |-> 1,\0a                   endLine |-> 92,\0a                   endColumn |-> 32,\0a                   module |-> "BlockingQueuePoisonApple" ],\0a             context |-> [t |-> c1],\0a             parameters |-> <<"t">> ],\0a           << 9,\0a              [ prod |-> (p1 :> 0 @@ p2 :> 0),\0a                cons |-> (c1 :> 0 @@ c2 :> 0),\0a                buffer |-> <<>>,\0a                waitSet |-> {} ] >> >>,\0a        << << 9,\0a              [ prod |-> (p1 :> 0 @@ p2 :> 0),\0a                cons |-> (c1 :> 0 @@ c2 :> 0),\0a                buffer |-> <<>>,\0a                waitSet |-> {} ] >>,\0a           [ name |-> "Get",\0a             location |->\0a                 [ beginLine |-> 80,\0a                   beginColumn |-> 1,\0a                   endLine |-> 92,\0a                   endColumn |-> 32,\0a                   module |-> "BlockingQueuePoisonApple" ],\0a             context |-> [t |-> c1],\0a             parameters |-> <<"t">> ],\0a           << 9,\0a              [ prod |-> (p1 :> 0 @@ p2 :> 0),\0a                cons |-> (c1 :> 0 @@ c2 :> 0),\0a                buffer |-> <<>>,\0a                waitSet |-> {} ] >> >> },\0a  state |->\0a      { << 1,\0a           [ prod |-> (p1 :> 2 @@ p2 :> 2),\0a             cons |-> (c1 :> 2 @@ c2 :> 2),\0a             buffer |-> <<>>,\0a             waitSet |-> {} ] >>,\0a        << 2,\0a           [ prod |-> (p1 :> 2 @@ p2 :> 1),\0a             cons |-> (c1 :> 2 @@ c2 :> 2),\0a             buffer |-> <<Poison>>,\0a             waitSet |-> {} ] >>,\0a        << 3,\0a           [ prod |-> (p1 :> 2 @@ p2 :> 1),\0a             cons |-> (c1 :> 2 @@ c2 :> 1),\0a             buffer |-> <<>>,\0a             waitSet |-> {} ] >>,\0a        << 4,\0a           [ prod |-> (p1 :> 2 @@ p2 :> 0),\0a             cons |-> (c1 :> 2 @@ c2 :> 1),\0a             buffer |-> <<Poison>>,\0a             waitSet |-> {} ] >>,\0a        << 5,\0a           [ prod |-> (p1 :> 2 @@ p2 :> 0),\0a             cons |-> (c1 :> 1 @@ c2 :> 1),\0a             buffer |-> <<>>,\0a             waitSet |-> {} ] >>,\0a        << 6,\0a           [ prod |-> (p1 :> 1 @@ p2 :> 0),\0a             cons |-> (c1 :> 1 @@ c2 :> 1),\0a             buffer |-> <<Poison>>,\0a             waitSet |-> {} ] >>,\0a        << 7,\0a           [ prod |-> (p1 :> 0 @@ p2 :> 0),\0a             cons |-> (c1 :> 1 @@ c2 :> 1),\0a             buffer |-> <<Poison, Poison>>,\0a             waitSet |-> {} ] >>,\0a        << 8,\0a           [ prod |-> (p1 :> 0 @@ p2 :> 0),\0a             cons |-> (c1 :> 1 @@ c2 :> 0),\0a             buffer |-> <<Poison>>,\0a             waitSet |-> {} ] >>,\0a        << 9,\0a           [ prod |-> (p1 :> 0 @@ p2 :> 0),\0a             cons |-> (c1 :> 0 @@ c2 :> 0),\0a             buffer |-> <<>>,\0a             waitSet |-> {} ] >> } ]\0a\0a=============================================================================\0a']]]
      ['examples/CoffeeCan/CoffeeCan100Beans' 'CoffeeCan100Beans' %accept ~[['CoffeeCan100Beans' '---------------------------- MODULE CoffeeCan100Beans -------------------------------\0a(***************************************************************************)\0a(* This is a spec for the Coffee Can problem, a math problem usually       *)\0a(* attributed to David Gries in his 1987 book The Science of Programming.  *)\0a(* However, on page 301 section 23.2 of the same book Gries attributes the *)\0a(* problem to a 1979 letter by Edsger W. Dijkstra, who himself credits the *)\0a(* problem to his colleague Carel S. Scholten.                             *)\0a(*                                                                         *)\0a(* The problem as presented on page 165 of The Science of Programming:     *)\0a(*                                                                         *)\0a(* A coffee can contains some black beans and white beans. The following   *)\0a(* process is to be repeated as long as possible:                          *)\0a(*                                                                         *)\0a(* Randomly select two beans from the can. If they are the same color,     *)\0a(* throw them out, but put another black bean in. (Enough extra black      *)\0a(* beans are available to do this.) If they are different colors, place    *)\0a(* the white one back into the can and throw the black one away.           *)\0a(*                                                                         *)\0a(* Execution of this process reduces the number of beans in the can by     *)\0a(* one. Repetition of this process must terminate with exactly one bean in *)\0a(* the can, for then two beans cannot be selected. The question is: what,  *)\0a(* if anything, can be said about the color of the final bean based on the *)\0a(* number of white beans and the number of black beans initially in the    *)\0a(* can?                                                                    *)\0a(*                                                                         *)\0a(* We model this problem in TLA⁺ with a focus on two things:               *)\0a(*  1. Validate a monotonic decrease in number of beans at each step       *)\0a(*  2. Identify a loop/inductive invariant                                 *)\0a(*  3. Form a hypothesis about the final bean and modelcheck it            *)\0a(*                                                                         *)\0a(* Finite modelchecking can only check our properties for a finite number  *)\0a(* of beans, while we want to show that it holds for all Natural numbers.  *)\0a(* TLA⁺\'s built-in proof language can be used for this purpose, although   *)\0a(* such a proof is not currently included in this spec.                    *)\0a(*                                                                         *)\0a(***************************************************************************)\0a\0aEXTENDS Naturals\0a\0aCONSTANT MaxBeanCount\0a\0aASSUME MaxBeanCount \\in Nat /\\ MaxBeanCount >= 1\0a\0aVARIABLES can\0a\0a\\* The set of all possible cans\0aCan == [black : 0..MaxBeanCount, white : 0..MaxBeanCount]\0a\0a\\* Possible values the can variable can take on\0aTypeInvariant == can \\in Can\0a\0a\\* Initialize can so it contains between 1 and MaxBeanCount beans\0aInit == can \\in {c \\in Can : c.black + c.white \\in 1..MaxBeanCount}\0a\0a\\* Number of beans currently in the can\0aBeanCount == can.black + can.white\0a\0a\\* Pick two black beans; throw both away, put one black bean in\0aPickSameColorBlack ==\0a    /\\ BeanCount > 1\0a    /\\ can.black >= 2\0a    /\\ can\' = [can EXCEPT !.black = @ - 1]\0a\0a\\* Pick two white beans; throw both away, put one black bean in\0aPickSameColorWhite ==\0a    /\\ BeanCount > 1\0a    /\\ can.white >= 2\0a    /\\ can\' = [can EXCEPT !.black = @ + 1, !.white = @ - 2]\0a\0a\\* Pick one bean of each color; put white back, throw away black\0aPickDifferentColor ==\0a    /\\ BeanCount > 1\0a    /\\ can.black >= 1\0a    /\\ can.white >= 1\0a    /\\ can\' = [can EXCEPT !.black = @ - 1]\0a\0a\\* Termination action to avoid triggering deadlock detection\0aTermination ==\0a    /\\ BeanCount = 1\0a    /\\ UNCHANGED can\0a\0a\\* Next-state relation: what actions can be taken?\0aNext ==\0a    \\/ PickSameColorWhite\0a    \\/ PickSameColorBlack\0a    \\/ PickDifferentColor\0a    \\/ Termination\0a\0a\\* Action formula: every step decreases the number of beans in the can\0aMonotonicDecrease == [][BeanCount\' < BeanCount]_can\0a\0a\\* Liveness property: we eventually end up with one bean left\0aEventuallyTerminates == <>(ENABLED Termination)\0a\0a\\* Loop invariant: every step preserves white bean count mod 2\0aLoopInvariant == [][can.white % 2 = 0 <=> can\'.white % 2 = 0]_can\0a\0a\\* Hypothesis: If we start out with an even number of white beans, we end up\0a\\* with a single black bean. Otherwise, we end up with a single white bean.\0aTerminationHypothesis ==\0a    IF can.white % 2 = 0\0a    THEN <>(can.black = 1 /\\ can.white = 0)\0a    ELSE <>(can.black = 0 /\\ can.white = 1)\0a\0a\\* Start out in a state defined by the Init operator and every step is one\0a\\* defined by the Next operator. Assume weak fairness so the system can\'t\0a\\* stutter indefinitely: we eventually take some beans out of the can.\0aSpec ==\0a    /\\ Init\0a    /\\ [][Next]_can\0a    /\\ WF_can(Next)\0a\0a\\* What we want to show: that if our system follows the rules set out by the\0a\\* Spec operator, then all our properties and assumptions will be satisfied.\0aTHEOREM Spec =>\0a    /\\ TypeInvariant\0a    /\\ MonotonicDecrease\0a    /\\ EventuallyTerminates\0a    /\\ LoopInvariant\0a    /\\ TerminationHypothesis\0a\0a=============================================================================\0a\0a\0a']]]
      ['examples/SingleLaneBridge/MC' 'MC' %accept ~[['MC' '---- MODULE MC ----\0aEXTENDS SingleLaneBridge, TLC\0a\0a\\* CONSTANT definitions @modelParameterConstants:0CarsRight\0aconst_1615720459299211000 == \0a{"r1","r2"}\0a----\0a\0a\\* CONSTANT definitions @modelParameterConstants:1CarsLeft\0aconst_1615720459299212000 == \0a{"l1","l2"}\0a----\0a\0a\\* CONSTANT definitions @modelParameterConstants:2Bridge\0aconst_1615720459299213000 == \0a{4,5}\0a----\0a\0a\\* CONSTANT definitions @modelParameterConstants:3Positions\0aconst_1615720459299214000 == \0a{1,2,3,4,5,6,7,8}\0a----\0a\0aCarsInfOftenOnBridge == \\A car \\in CarsRight : []<>(Location[car] \\in Bridge)\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Sun Oct 10 22:023:42 CEST 2021 by youne\0a'] ['SingleLaneBridge' '-------------------------- MODULE SingleLaneBridge --------------------------\0a\0a\\* A bridge over a river is only wide enough to permit a single lane of traffic.\0a\\* Consequently, cars can only move concurrently if they are moving in the same \0a\\* direction. A safety violation occurs if two cars moving in different directions\0a\\* enter the bridge at the same time.\0a\\* To visualize the problem, refer to https://flylib.com/books/en/2.752.1.48/1/\0a   \0aEXTENDS Naturals, FiniteSets, Sequences\0a\0aCONSTANTS CarsRight, CarsLeft, Bridge, Positions\0a\0aVARIABLES Location, WaitingBeforeBridge\0avars == <<Location, WaitingBeforeBridge>>\0a\0aStartPos == CHOOSE min \\in Positions : \\A p \\in Positions : min <= p\0aEndPos   == CHOOSE max \\in Positions : \\A p \\in Positions : max >= p\0a\0aStartBridge == CHOOSE min \\in Bridge : \\A e \\in Bridge : min <= e\0aEndBridge   == CHOOSE max \\in Bridge : \\A e \\in Bridge : max >= e\0a\0aASSUME CarsRight \\cap CarsLeft = {}\0aASSUME Cardinality(CarsRight \\union CarsLeft ) # 0\0aASSUME StartPos < StartBridge /\\ EndPos > EndBridge /\\ Cardinality(Bridge) < Cardinality(Positions)\0a\0a\0aRECURSIVE SeqFromSet(_)\0aSeqFromSet(S) == \0a  IF S = {} THEN << >> \0a  ELSE LET x == CHOOSE x \\in S : TRUE\0a       IN  << x >> \\o SeqFromSet(S \\ {x})\0a\0aCars == CarsRight \\union CarsLeft\0aCarsInBridge == { c \\in Cars : Location[c] \\in Bridge }\0aCarsBeforeBridge == { car \\in CarsRight : EndPos - EndBridge = 1 } \\cup { car \\in CarsLeft : StartBridge - StartPos = 1 }\0a\0aRMove(pos) == IF pos > StartPos THEN pos - 1 ELSE EndPos\0aLMove(pos) == IF pos < EndPos THEN pos + 1 ELSE StartPos\0a\0aNextLocation(car) == IF car \\in CarsRight THEN RMove(Location[car]) ELSE LMove(Location[car])\0a\0aChangeLocation(car) ==\0a    /\\ IF \\/ car \\in CarsRight /\\ NextLocation(car) = EndBridge + 1\0a          \\/ car \\in CarsLeft /\\ NextLocation(car) = StartBridge - 1\0a        THEN WaitingBeforeBridge\' = Append(WaitingBeforeBridge, car)\0a        ELSE UNCHANGED WaitingBeforeBridge\0a    /\\ Location\' = [ Location EXCEPT ![car] = NextLocation(car) ]\0a\0aHaveSameDirection(car) ==\0a    \\/ car \\in CarsRight /\\ \\A c \\in CarsInBridge : c \\in CarsRight\0a    \\/ car \\in CarsLeft /\\ \\A c \\in CarsInBridge : c \\in CarsLeft\0a\0a\\* Actions\0aMoveOutsideBridge(car) ==\0a    /\\ NextLocation(car) \\notin Bridge\0a    /\\ ChangeLocation(car)\0a\0aMoveInsideBridge(car) ==\0a    /\\ car \\in CarsInBridge\0a    /\\ \\A c \\in Cars : Location[c] # NextLocation(car)\0a    /\\ ChangeLocation(car)\0a\0aEnterBridge ==\0a    \\/  /\\ CarsInBridge = {}\0a        /\\ Len(WaitingBeforeBridge) # 0\0a        /\\ Location\' = [ Location EXCEPT ![Head(WaitingBeforeBridge)] = NextLocation(Head(WaitingBeforeBridge)) ]\0a        /\\ WaitingBeforeBridge\' = Tail(WaitingBeforeBridge)\0a    \\/  /\\ Len(WaitingBeforeBridge) # 0\0a        /\\ Head(WaitingBeforeBridge) \\notin CarsInBridge\0a        /\\ HaveSameDirection(Head(WaitingBeforeBridge))\0a        /\\ \\A c \\in Cars : Location[c] # NextLocation(Head(WaitingBeforeBridge))\0a        /\\ Location\' = [ Location EXCEPT ![Head(WaitingBeforeBridge)] = NextLocation(Head(WaitingBeforeBridge)) ]\0a        /\\ WaitingBeforeBridge\' = Tail(WaitingBeforeBridge)\0a\0aInit == \0a    /\\ Location = [ c \\in Cars |-> IF c \\in CarsRight THEN EndPos ELSE StartPos  ]\0a    /\\ WaitingBeforeBridge = SeqFromSet(CarsBeforeBridge)\0a\0aNext == \\E car \\in Cars : EnterBridge \\/ MoveOutsideBridge(car) \\/ MoveInsideBridge(car)\0a\0aFairness ==\0a    /\\ \\A car \\in Cars : WF_vars(MoveOutsideBridge(car))\0a    /\\ \\A car \\in Cars : WF_vars(MoveInsideBridge(car))\0a    /\\ \\A car \\in Cars : WF_vars(EnterBridge)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aInvariants ==\0a    \\* Two cars or more cannot be in the same location in the Bridge at the same time\0a    /\\ \\A a,b \\in Cars :\0a        /\\ Location[a] \\in Bridge\0a        /\\ Location[a] = Location[b]\0a        => a = b\0a    \\* The bridge capacity should be respected\0a    /\\ Cardinality(CarsInBridge) < Cardinality(Bridge) + 1\0a    \\* Two cars of different directions can never be in the bridge\0a    /\\ \\A <<r,l>> \\in CarsRight \\X CarsLeft :\0a        ~ (Location[r] \\in Bridge /\\ Location[l] \\in Bridge) \0a\0aTypeOK ==\0a    /\\ Location \\in [ Cars -> Positions ]\0a    /\\ Len(WaitingBeforeBridge) <= Cardinality(Cars)\0a\0aCarsInBridgeExitBridge ==\0a    \\* All cars eventually exit the Bridge \0a    \\A car \\in Cars : Location[car] \\in Bridge ~> Location[car] \\notin Bridge\0a\0aCarsEnterBridge ==\0a    \\* All cars eventually enter the bridge\0a    \\A car \\in Cars : Location[car] \\notin Bridge ~> Location[car] \\in Bridge\0a\0aTHEOREM Spec => [] Invariants\0a\0aTHEOREM Spec => [] TypeOK\0a\0aTHEOREM Spec => CarsInBridgeExitBridge\0aTHEOREM Spec => CarsEnterBridge\0a\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Tue Oct 12 00:20:28 CEST 2021 by youne\0a']]]
      ['examples/SingleLaneBridge/SingleLaneBridge' 'SingleLaneBridge' %accept ~[['SingleLaneBridge' '-------------------------- MODULE SingleLaneBridge --------------------------\0a\0a\\* A bridge over a river is only wide enough to permit a single lane of traffic.\0a\\* Consequently, cars can only move concurrently if they are moving in the same \0a\\* direction. A safety violation occurs if two cars moving in different directions\0a\\* enter the bridge at the same time.\0a\\* To visualize the problem, refer to https://flylib.com/books/en/2.752.1.48/1/\0a   \0aEXTENDS Naturals, FiniteSets, Sequences\0a\0aCONSTANTS CarsRight, CarsLeft, Bridge, Positions\0a\0aVARIABLES Location, WaitingBeforeBridge\0avars == <<Location, WaitingBeforeBridge>>\0a\0aStartPos == CHOOSE min \\in Positions : \\A p \\in Positions : min <= p\0aEndPos   == CHOOSE max \\in Positions : \\A p \\in Positions : max >= p\0a\0aStartBridge == CHOOSE min \\in Bridge : \\A e \\in Bridge : min <= e\0aEndBridge   == CHOOSE max \\in Bridge : \\A e \\in Bridge : max >= e\0a\0aASSUME CarsRight \\cap CarsLeft = {}\0aASSUME Cardinality(CarsRight \\union CarsLeft ) # 0\0aASSUME StartPos < StartBridge /\\ EndPos > EndBridge /\\ Cardinality(Bridge) < Cardinality(Positions)\0a\0a\0aRECURSIVE SeqFromSet(_)\0aSeqFromSet(S) == \0a  IF S = {} THEN << >> \0a  ELSE LET x == CHOOSE x \\in S : TRUE\0a       IN  << x >> \\o SeqFromSet(S \\ {x})\0a\0aCars == CarsRight \\union CarsLeft\0aCarsInBridge == { c \\in Cars : Location[c] \\in Bridge }\0aCarsBeforeBridge == { car \\in CarsRight : EndPos - EndBridge = 1 } \\cup { car \\in CarsLeft : StartBridge - StartPos = 1 }\0a\0aRMove(pos) == IF pos > StartPos THEN pos - 1 ELSE EndPos\0aLMove(pos) == IF pos < EndPos THEN pos + 1 ELSE StartPos\0a\0aNextLocation(car) == IF car \\in CarsRight THEN RMove(Location[car]) ELSE LMove(Location[car])\0a\0aChangeLocation(car) ==\0a    /\\ IF \\/ car \\in CarsRight /\\ NextLocation(car) = EndBridge + 1\0a          \\/ car \\in CarsLeft /\\ NextLocation(car) = StartBridge - 1\0a        THEN WaitingBeforeBridge\' = Append(WaitingBeforeBridge, car)\0a        ELSE UNCHANGED WaitingBeforeBridge\0a    /\\ Location\' = [ Location EXCEPT ![car] = NextLocation(car) ]\0a\0aHaveSameDirection(car) ==\0a    \\/ car \\in CarsRight /\\ \\A c \\in CarsInBridge : c \\in CarsRight\0a    \\/ car \\in CarsLeft /\\ \\A c \\in CarsInBridge : c \\in CarsLeft\0a\0a\\* Actions\0aMoveOutsideBridge(car) ==\0a    /\\ NextLocation(car) \\notin Bridge\0a    /\\ ChangeLocation(car)\0a\0aMoveInsideBridge(car) ==\0a    /\\ car \\in CarsInBridge\0a    /\\ \\A c \\in Cars : Location[c] # NextLocation(car)\0a    /\\ ChangeLocation(car)\0a\0aEnterBridge ==\0a    \\/  /\\ CarsInBridge = {}\0a        /\\ Len(WaitingBeforeBridge) # 0\0a        /\\ Location\' = [ Location EXCEPT ![Head(WaitingBeforeBridge)] = NextLocation(Head(WaitingBeforeBridge)) ]\0a        /\\ WaitingBeforeBridge\' = Tail(WaitingBeforeBridge)\0a    \\/  /\\ Len(WaitingBeforeBridge) # 0\0a        /\\ Head(WaitingBeforeBridge) \\notin CarsInBridge\0a        /\\ HaveSameDirection(Head(WaitingBeforeBridge))\0a        /\\ \\A c \\in Cars : Location[c] # NextLocation(Head(WaitingBeforeBridge))\0a        /\\ Location\' = [ Location EXCEPT ![Head(WaitingBeforeBridge)] = NextLocation(Head(WaitingBeforeBridge)) ]\0a        /\\ WaitingBeforeBridge\' = Tail(WaitingBeforeBridge)\0a\0aInit == \0a    /\\ Location = [ c \\in Cars |-> IF c \\in CarsRight THEN EndPos ELSE StartPos  ]\0a    /\\ WaitingBeforeBridge = SeqFromSet(CarsBeforeBridge)\0a\0aNext == \\E car \\in Cars : EnterBridge \\/ MoveOutsideBridge(car) \\/ MoveInsideBridge(car)\0a\0aFairness ==\0a    /\\ \\A car \\in Cars : WF_vars(MoveOutsideBridge(car))\0a    /\\ \\A car \\in Cars : WF_vars(MoveInsideBridge(car))\0a    /\\ \\A car \\in Cars : WF_vars(EnterBridge)\0a\0aSpec == Init /\\ [][Next]_vars /\\ Fairness\0a\0aInvariants ==\0a    \\* Two cars or more cannot be in the same location in the Bridge at the same time\0a    /\\ \\A a,b \\in Cars :\0a        /\\ Location[a] \\in Bridge\0a        /\\ Location[a] = Location[b]\0a        => a = b\0a    \\* The bridge capacity should be respected\0a    /\\ Cardinality(CarsInBridge) < Cardinality(Bridge) + 1\0a    \\* Two cars of different directions can never be in the bridge\0a    /\\ \\A <<r,l>> \\in CarsRight \\X CarsLeft :\0a        ~ (Location[r] \\in Bridge /\\ Location[l] \\in Bridge) \0a\0aTypeOK ==\0a    /\\ Location \\in [ Cars -> Positions ]\0a    /\\ Len(WaitingBeforeBridge) <= Cardinality(Cars)\0a\0aCarsInBridgeExitBridge ==\0a    \\* All cars eventually exit the Bridge \0a    \\A car \\in Cars : Location[car] \\in Bridge ~> Location[car] \\notin Bridge\0a\0aCarsEnterBridge ==\0a    \\* All cars eventually enter the bridge\0a    \\A car \\in Cars : Location[car] \\notin Bridge ~> Location[car] \\in Bridge\0a\0aTHEOREM Spec => [] Invariants\0a\0aTHEOREM Spec => [] TypeOK\0a\0aTHEOREM Spec => CarsInBridgeExitBridge\0aTHEOREM Spec => CarsEnterBridge\0a\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Tue Oct 12 00:20:28 CEST 2021 by youne\0a']]]
      ['examples/SpanningTree/SpanTree' 'SpanTree' %accept ~[['SpanTree' '------------------------------ MODULE SpanTree ------------------------------\0a(***************************************************************************)\0a(* This is an algorithm to compute a spanning tree of an undirected graph  *)\0a(* with a given root.  Look up "spanning tree" on the Web to see what that *)\0a(* means.  You may find pages for finding spanning trees of graphs with    *)\0a(* weighted edges.  The algorithm here effectively assumes each edge has   *)\0a(* weight 1.                                                               *)\0a(*                                                                         *)\0a(* A rooted tree is usually described by a set of nodes with a             *)\0a(* parent/child relation, where the root is the oldest ancestor of all     *)\0a(* other nodes.  The algorithm computes this relation as a function `mom\'  *)\0a(* where mom[n] equals the parent of node n, except that if n is the root  *)\0a(* then mom[n] = n.  If the graph is not connected, then the rooted tree   *)\0a(* does not contain nodes of the graph that have no path to the root.      *)\0a(* Such nodes n will have mom[n]=n.                                        *)\0a(*                                                                         *)\0a(* A simple algorithm to compute the rooted spanning tree computes a       *)\0a(* function dist where dist[n] is the distance of node n from the root.    *)\0a(* Initially, dist[n] equals 0 if n is the root and otherwise equals       *)\0a(* infinity.  The algorithm repeatedly performs the following action.  It  *)\0a(* chooses an arbitrary node n that has a neighbor m such that dist[n] >   *)\0a(* dist[m]+1, and it sets dist[n] to dist[m]+1.                            *)\0a(*                                                                         *)\0a(* For simplicity, we assume that we\'re also given a number MaxCardinality *)\0a(* that\'s greater than or equal to the number of nodes, and we use         *)\0a(* MaxCardinality instead of infinity.  For a reason to be given below, we *)\0a(* also modify the algorithm as follows.  For a node n with dist[n] >      *)\0a(* dist[m}+1, instead of setting dist[n] to dist[m]+1 the algorithm sets   *)\0a(* it to an arbitrary number d such that dist[n] > d >= dist[m} + 1.       *)\0a(***************************************************************************)\0aEXTENDS Integers, FiniteSets\0a\0a(***************************************************************************)\0a(* We represent the graph by a set of Nodes of nodes and a set Edges of    *)\0a(* edges.  We assume that there are no edges from a node to itself and     *)\0a(* there is at most one edge joining any two nodes.  We represent an edge  *)\0a(* joining nodes m and n by the set {m, n}.  We let Root be the root node. *)\0a(***************************************************************************)\0aCONSTANTS Nodes, Edges, Root, MaxCardinality\0a\0a(***************************************************************************)\0a(* This assumption asserts mathematically what we are assuming about the   *)\0a(* constants.                                                               *)\0a(***************************************************************************)\0aASSUME /\\ Root \\in Nodes\0a       /\\ \\A e \\in Edges : (e \\subseteq Nodes) /\\ (Cardinality(e) = 2)\0a       /\\ MaxCardinality \\in Nat\0a       /\\ MaxCardinality >= Cardinality(Nodes)\0a\0a(***************************************************************************)\0a(* This defines Nbrs(n) to be the set of neighbors of node n in the        *)\0a(* graph--that is, the set of nodes joined by an edge to n.                *)\0a(***************************************************************************)\0aNbrs(n) == {m \\in Nodes : {m, n} \\in Edges}\0a\0a(***************************************************************************)\0a(* The spec is a straightforward TLA+ spec of the algorithm described      *)\0a(* above.                                                                  *)\0a(***************************************************************************)       \0aVARIABLES mom, dist\0avars == <<mom, dist>>\0a\0aTypeOK == /\\ mom  \\in [Nodes -> Nodes]\0a          /\\ dist \\in [Nodes -> Nat]\0a\0aInit == /\\ mom = [n \\in Nodes |-> n]\0a        /\\ dist = [n \\in Nodes |-> IF n = Root THEN 0 ELSE MaxCardinality]\0a        \0aNext == \\E n \\in Nodes :\0a          \\E m \\in Nbrs(n) : \0a             /\\ dist[m] < 1 + dist[n]\0a             /\\ \\E d \\in (dist[m]+1) .. (dist[n] - 1) :\0a                    /\\ dist\' = [dist EXCEPT ![n] = d]\0a                    /\\ mom\'  = [mom  EXCEPT ![n] = m]\0a\0aSpec == Init /\\ [][Next]_vars /\\ WF_vars(Next)\0a   (************************************************************************)\0a   (* The formula WF_vars(Next) asserts that a behavior must not stop if   *)\0a   (* it\'s possible to take a Next step.  Thus, the algorithm must either  *)\0a   (* terminate (because Next equals FALSE for all values of dist\' and     *)\0a   (* mom\') or else it continues taking Next steps forever.  Don\'t worry   *)\0a   (* about it if you haven\'t learned how to express liveness in TLA+.     *)\0a   (************************************************************************)\0a-----------------------------------------------------------------------------\0a(***************************************************************************)\0a(* A direct mathematical definition of exactly what the function mom       *)\0a(* should be is somewhat complicated and cannot be efficiently evaluated   *)\0a(* by TLC.  Here is the definition of a postcondition (a condition to be   *)\0a(* satisfied when the algorithm terminates) that implies that mom has the  *)\0a(* correct value.                                                          *)\0a(***************************************************************************)\0aPostCondition == \0a  \\A n \\in Nodes :\0a    \\/ /\\ n = Root \0a       /\\ dist[n] = 0\0a       /\\ mom[n] = n\0a    \\/ /\\ dist[n] = MaxCardinality \0a       /\\ mom[n] = n\0a       /\\ \\A m \\in Nbrs(n) : dist[m] = MaxCardinality\0a    \\/ /\\ dist[n] \\in 1..(MaxCardinality-1)\0a       /\\ mom[n] \\in Nbrs(n)\0a       /\\ dist[n] = dist[mom[n]] + 1\0a\0a(***************************************************************************)\0a(* ENABLED Next is the TLA+ formula that is true of a state iff (if and    *)\0a(* only if) there is a step satisfying Next starting in the state.  Thus,  *)\0a(* ~ ENABLED Next asserts that the algorithm has terminated.  The safety   *)\0a(* property that algorithm should satisfy, that it\'s always true that if   *)\0a(* the algorithm has terminated then PostCondition is true, is asserted by  *)\0a(* this formula.                                                           *)\0a(***************************************************************************)\0aSafety == []((~ ENABLED Next) => PostCondition)\0a\0a(***************************************************************************)\0a(* This formula asserts the liveness condition that the algorithm          *)\0a(* eventually terminates                                                   *)\0a(***************************************************************************)\0aLiveness == <>(~ ENABLED Next) \0a-----------------------------------------------------------------------------\0a(***************************************************************************)\0a(* These properties of the spec can be checked with the model that should  *)\0a(* have come with this file.  That model has TLC check the algorithm       *)\0a(* satisfies properties Safety and Liveness for a single simple graph with *)\0a(* 6 nodes.  You should clone that model and change it to try a few        *)\0a(* different graphs.  However, this is tedious.  There are two better ways *)\0a(* to have TLC check the spec.  The best is to try it on all graphs with a *)\0a(* given number of nodes.  The spec with root file SpanTreeTest does this. *)\0a(* It can very quickly check all graphs with 4 nodes.  It takes about 25   *)\0a(* minutes on my laptop to check all graphs with 5 nodes.  TLC will        *)\0a(* probably run out of space after running for a long time if I tried it   *)\0a(* for all graphs with 6 nodes.  The spec SpanTreeRandom tests the         *)\0a(* algorithm for a randomly chosen graph with a given set of nodes.  This  *)\0a(* allows you easily to repeatedly check different graphs.                 *)\0a(*                                                                         *)\0a(* As a problem, you can now specify an algorithm that is a distributed    *)\0a(* implementation of this algorithm.  We can view the algorithm in the     *)\0a(* current module as one in which a node n sets its value of dist[n] by    *)\0a(* directly reading the values of dist[m] from all its neighbors m.  Your  *)\0a(* problem is to write an algorithm in which nodes learn the values of     *)\0a(* dist[m] from a neighbor m by receiving messages sent by m.  The root r  *)\0a(* sends an initial message informing its neighbors that dist[r] = 0.      *)\0a(* Subsequently, each node n sends a message containing dist[n] to all its *)\0a(* neighbors whenever its value of dist[n] changes.                        *)\0a(*                                                                         *)\0a(* Your algorithm should have variables mom and dist that implement the    *)\0a(* variables of the same name in the current algorithm.  (Hence, it should *)\0a(* implement the current algorithm with a trivial refinement mapping       *)\0a(* assigning to every variable and constant the variable or constant of    *)\0a(* the same name.) You can use TLC to check that your algorithm does       *)\0a(* indeed implement the algorithm in the current module.                   *)\0a(*                                                                         *)\0a(* You may not know how to write a suitable liveness condition for your    *)\0a(* algorithm.  (To find out how, you would have to look through the        *)\0a(* available TLA+ documentation.) In that case, just write a safety        *)\0a(* specification of the form Init /\\ [][Next]_vars and modify formula Spec *)\0a(* of the current module by comment out the /\\ WF_vars(Next) conjunction   *)\0a(* so it too becomes a safey spec.                                         *)\0a(*                                                                         *)\0a(*                                                                         *)\0a(* When writing your algorithm, you should realize why the Next action in  *)\0a(* the current module doesn\'t just set dist[n] to dist[m] + 1 rather than  *)\0a(* allowing it to be set to any value in (dist[m]+1) ..  (dist[n]-1) .  If *)\0a(* you don\'t see why, use TLC to find out for you.                         *)\0a(***************************************************************************)\0aAllNodesDirectChildren == \\A n \\in Nodes : <>(mom[n] = Root)\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Mon Jun 17 05:52:09 PDT 2019 by lamport\0a\\* Created Fri Jun 14 03:07:58 PDT 2019 by lamport\0a']]]
      ['examples/SpanningTree/SpanTreeRandom' 'SpanTreeRandom' %accept ~[['SpanTreeRandom' '------------------------------ MODULE SpanTreeRandom ------------------------------\0a(***************************************************************************)\0a(* The specification in this module is a modified version of the one in    *)\0a(* module SpanTree obtained by replacing the declared constant Edges with  *)\0a(* a defined constant that equals a randomly chosen set of edges joining   *)\0a(* the nodes in Nodes.  Thus it can be used to test the algorithm of       *)\0a(* SpanTree on a randomly chosen node, making it easy to check the         *)\0a(* algorithm on a sequence of different graphs.                            *)\0a(***************************************************************************)\0aEXTENDS Integers, FiniteSets, TLC\0a\0aCONSTANTS Nodes, Root, MaxCardinality\0a\0aEdges == \0a  UNION { {{n, m} : m \\in RandomElement(SUBSET (Nodes\\{n}))} : n \\in Nodes }\0a  (*************************************************************************)\0a  (* To understand this definition let\'s look at its subformulas, from the *)\0a  (* inside out.                                                           *)\0a  (*                                                                       *)\0a  (*  - SUBSET (Nodes \\ {n})  is the set of all subsets of the set         *)\0a  (*    Nodes \\ {n} , which is the set of all nodes other than n.          *)\0a  (*                                                                       *)\0a  (*  - RandomElement(...)  is a hack introduced in the TLC module.  TLC   *)\0a  (*    computes its value to be a randomly chosen element in the set      *)\0a  (*    ... . This is hack because, in math, an expression has the same    *)\0a  (*    value whenever it\'s computed.  The value of 2^{1/2} is the same    *)\0a  (*    next Thursday as it is today.  Every mathematical expression exp   *)\0a  (*    satisfies exp = exp.  However, TLC may evaluate                    *)\0a  (*                                                                       *)\0a  (*       RandomElement(S) = RandomElement(S)                             *)\0a  (*                                                                       *)\0a  (*    to equal FALSE if S is a set with more than 1 element, This is     *)\0a  (*    one of the few cases in which TLC does not obey the rules of math. *)\0a  (*                                                                       *)\0a  (*  - {{n, m} : m \\in RandomElement(...)}  is the set of  elements that  *)\0a  (*    equal the set {n, m} for m some element of RandomElement(...) .    *)\0a  (*                                                                       *)\0a  (*  - UNION { ... : n \\in Nodes }  is the union of all sets ...  for n   *)\0a  (*    an element of Nodes.  This expression makes sense if the           *)\0a  (*    expression equals a set that depends on the value of n.            *)\0a  (*************************************************************************)\0a\0aASSUME /\\ Root \\in Nodes\0a       /\\ MaxCardinality \\in Nat\0a       /\\ MaxCardinality >= Cardinality(Nodes)\0a       \0aVARIABLES mom, dist\0avars == <<mom, dist>>\0a\0aNbrs(n) == {m \\in Nodes : {m, n} \\in Edges}\0a\0aTypeOK == /\\ mom \\in [Nodes -> Nodes]\0a          /\\ dist \\in [Nodes -> Nat]\0a          /\\ \\A e \\in Edges : (e \\subseteq Nodes) /\\ (Cardinality(e) = 2)\0a\0aInit == /\\ mom = [n \\in Nodes |-> n]\0a        /\\ dist = [n \\in Nodes |-> IF n = Root THEN 0 ELSE MaxCardinality]\0a        \0aNext == \\E n \\in Nodes :\0a          \\E m \\in Nbrs(n) : \0a             /\\ dist[m] < 1 + dist[n]\0a             /\\ \\E d \\in (dist[m]+1) .. (dist[n] - 1) :\0a                    /\\ dist\' = [dist EXCEPT ![n] = d]\0a                    /\\ mom\'  = [mom  EXCEPT ![n] = m]\0a\0aSpec == Init /\\ [][Next]_vars /\\ WF_vars(Next)\0a-----------------------------------------------------------------------------\0aPostCondition == \0a  \\A n \\in Nodes :\0a    \\/ /\\ n = Root \0a       /\\ dist[n] = 0\0a       /\\ mom[n] = n\0a    \\/ /\\ dist[n] = MaxCardinality \0a       /\\ mom[n] = n\0a       /\\ \\A m \\in Nbrs(n) : dist[m] = MaxCardinality\0a    \\/ /\\ dist[n] \\in 1..(MaxCardinality-1)\0a       /\\ mom[n] \\in Nbrs(n)\0a       /\\ dist[n] = dist[mom[n]] + 1\0a\0aSafety == []((~ ENABLED Next) => PostCondition)\0a\0aLiveness == <>PostCondition\0a(***************************************************************************)\0a(* Model Model_1 has TLC check these correctness condition for a (randomly *)\0a(* chosen) graph with six nodes.  On a few tries, it took TLC an average   *)\0a(* of a little more than 30 seconds to do it.                              *)\0a(***************************************************************************)\0aNextAlwaysEnabled == []<>(ENABLED Next)\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Mon Jun 17 05:39:15 PDT 2019 by lamport\0a\\* Created Fri Jun 14 03:07:58 PDT 2019 by lamport\0a']]]
      ['examples/SpanningTree/SpanTreeTest' 'SpanTreeTest' %accept ~[['SpanTreeTest' '------------------------------ MODULE SpanTreeTest ------------------------------\0a(***************************************************************************)\0a(* The specification in this module is a modified version of the one in    *)\0a(* module SpanTree obtained by replacing the declared constant Edges with  *)\0a(* a variable of the same name that is set initially to any possible set   *)\0a(* of edges with nodes in Nodes.  Thus, it can be used to test the         *)\0a(* algorithm of SpanTree on all possible graphs having a particular number *)\0a(* of nodes.                                                               *)\0a(***************************************************************************)\0aEXTENDS Integers, FiniteSets, Randomization\0a\0aCONSTANTS Nodes, Root, MaxCardinality\0a\0aASSUME /\\ Root \\in Nodes\0a       /\\ MaxCardinality \\in Nat\0a       /\\ MaxCardinality >= Cardinality(Nodes)\0a       \0aVARIABLES mom, dist, Edges\0avars == <<mom, dist, Edges>>\0a\0aNbrs(n) == {m \\in Nodes : {m, n} \\in Edges}\0a\0aTypeOK == /\\ mom \\in [Nodes -> Nodes]\0a          /\\ dist \\in [Nodes -> Nat]\0a          /\\ \\A e \\in Edges : (e \\subseteq Nodes) /\\ (Cardinality(e) = 2)\0a\0aInit == /\\ mom = [n \\in Nodes |-> n]\0a        /\\ dist = [n \\in Nodes |-> IF n = Root THEN 0 ELSE MaxCardinality]\0a        /\\ Edges \\in {E \\in SUBSET (SUBSET Nodes) : \\A e \\in E : Cardinality(e) = 2}\0a           (****************************************************************)\0a           (* SUBSET S is the set of all subsets of a set S.  Thus, this   *)\0a           (* allows Edges to have as its initial value any set of sets of *)\0a           (* nodes containing exactly two nodes.                          *)\0a           (****************************************************************)\0a        \0aNext == \\E n \\in Nodes :\0a          \\E m \\in Nbrs(n) : \0a             /\\ dist[m] < 1 + dist[n]\0a             /\\ \\E d \\in (dist[m]+1) .. (dist[n] - 1) :\0a                    /\\ dist\' = [dist EXCEPT ![n] = d]\0a                    /\\ mom\'  = [mom  EXCEPT ![n] = m]\0a                    /\\ Edges\' = Edges\0a\0aSpec == Init /\\ [][Next]_vars /\\ WF_vars(Next)\0a-----------------------------------------------------------------------------\0aPostCondition == \0a  \\A n \\in Nodes :\0a    \\/ /\\ n = Root \0a       /\\ dist[n] = 0\0a       /\\ mom[n] = n\0a    \\/ /\\ dist[n] = MaxCardinality \0a       /\\ mom[n] = n\0a       /\\ \\A m \\in Nbrs(n) : dist[m] = MaxCardinality\0a    \\/ /\\ dist[n] \\in 1..(MaxCardinality-1)\0a       /\\ mom[n] \\in Nbrs(n)\0a       /\\ dist[n] = dist[mom[n]] + 1\0a\0aSafety == []((~ ENABLED Next) => PostCondition)\0a\0aLiveness == <>PostCondition\0a(***************************************************************************)\0a(* This took a few seconds to check for 4 nodes, and about 25 minutes for  *)\0a(* 5 nodes on my laptop.  To compute the initial value of Edges, TLC has   *)\0a(* to compute all the elements of SUBSET (SUBSET Nodes) (the set of all    *)\0a(* subsets of the set of all sets of nodes) and then throw away all the    *)\0a(* elements of that set that don\'t consist entirely of sets having         *)\0a(* cardinality 2.  For N nodes, SUBSET(SUBSET Nodes) contains 2^(2^N)      *)\0a(* elements.                                                               *)\0a(***************************************************************************)\0aAllDistancesOne == <>[](\\A n \\in Nodes : dist[n] = 1)\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Mon Jun 17 05:43:38 PDT 2019 by lamport\0a\\* Created Fri Jun 14 03:07:58 PDT 2019 by lamport\0a']]]
      ['examples/SpecifyingSystems/CachingMemory/InternalMemory' 'InternalMemory' %accept ~[['InternalMemory' '------------------ MODULE InternalMemory ---------------------\0aEXTENDS MemoryInterface\0aVARIABLES mem, ctl, buf\0a--------------------------------------------------------------\0aIInit == /\\ mem \\in [Adr->Val]\0a         /\\ ctl = [p \\in Proc |-> "rdy"] \0a         /\\ buf = [p \\in Proc |-> NoVal] \0a         /\\ memInt \\in InitMemInt\0a\0aTypeInvariant == \0a  /\\ mem \\in [Adr->Val]\0a  /\\ ctl \\in [Proc -> {"rdy", "busy","done"}] \0a  /\\ buf \\in [Proc -> MReq \\cup Val \\cup {NoVal}]\0a\0aReq(p) == /\\ ctl[p] = "rdy" \0a          /\\ \\E req \\in  MReq :\0a                /\\ Send(p, req, memInt, memInt\') \0a                /\\ buf\' = [buf EXCEPT ![p] = req]\0a                /\\ ctl\' = [ctl EXCEPT ![p] = "busy"]\0a          /\\ UNCHANGED mem \0a\0aDo(p) == \0a  /\\ ctl[p] = "busy" \0a  /\\ mem\' = IF buf[p].op = "Wr"\0a              THEN [mem EXCEPT ![buf[p].adr] = buf[p].val] \0a              ELSE mem \0a  /\\ buf\' = [buf EXCEPT ![p] = IF buf[p].op = "Wr"\0a                                  THEN NoVal\0a                                  ELSE mem[buf[p].adr]]\0a  /\\ ctl\' = [ctl EXCEPT ![p] = "done"] \0a  /\\ UNCHANGED memInt \0a\0aRsp(p) == /\\ ctl[p] = "done"\0a          /\\ Reply(p, buf[p], memInt, memInt\')\0a          /\\ ctl\' = [ctl EXCEPT ![p]= "rdy"]\0a          /\\ UNCHANGED <<mem, buf>> \0a\0aINext == \\E p \\in Proc: Req(p) \\/ Do(p) \\/ Rsp(p) \0a\0aISpec == IInit  /\\  [][INext]_<<memInt, mem, ctl, buf>>\0a--------------------------------------------------------------\0aTHEOREM ISpec => []TypeInvariant\0a==============================================================\0a'] ['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a']]]
      ['examples/SpecifyingSystems/CachingMemory/Memory' 'Memory' %accept ~[['Memory' '----------------------- MODULE Memory ------------------------\0aEXTENDS MemoryInterface\0aInner(mem, ctl, buf) == INSTANCE InternalMemory \0aSpec == \\EE mem, ctl, buf : Inner(mem, ctl, buf)!ISpec \0a==============================================================\0a\0a'] ['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a'] ['InternalMemory' '------------------ MODULE InternalMemory ---------------------\0aEXTENDS MemoryInterface\0aVARIABLES mem, ctl, buf\0a--------------------------------------------------------------\0aIInit == /\\ mem \\in [Adr->Val]\0a         /\\ ctl = [p \\in Proc |-> "rdy"] \0a         /\\ buf = [p \\in Proc |-> NoVal] \0a         /\\ memInt \\in InitMemInt\0a\0aTypeInvariant == \0a  /\\ mem \\in [Adr->Val]\0a  /\\ ctl \\in [Proc -> {"rdy", "busy","done"}] \0a  /\\ buf \\in [Proc -> MReq \\cup Val \\cup {NoVal}]\0a\0aReq(p) == /\\ ctl[p] = "rdy" \0a          /\\ \\E req \\in  MReq :\0a                /\\ Send(p, req, memInt, memInt\') \0a                /\\ buf\' = [buf EXCEPT ![p] = req]\0a                /\\ ctl\' = [ctl EXCEPT ![p] = "busy"]\0a          /\\ UNCHANGED mem \0a\0aDo(p) == \0a  /\\ ctl[p] = "busy" \0a  /\\ mem\' = IF buf[p].op = "Wr"\0a              THEN [mem EXCEPT ![buf[p].adr] = buf[p].val] \0a              ELSE mem \0a  /\\ buf\' = [buf EXCEPT ![p] = IF buf[p].op = "Wr"\0a                                  THEN NoVal\0a                                  ELSE mem[buf[p].adr]]\0a  /\\ ctl\' = [ctl EXCEPT ![p] = "done"] \0a  /\\ UNCHANGED memInt \0a\0aRsp(p) == /\\ ctl[p] = "done"\0a          /\\ Reply(p, buf[p], memInt, memInt\')\0a          /\\ ctl\' = [ctl EXCEPT ![p]= "rdy"]\0a          /\\ UNCHANGED <<mem, buf>> \0a\0aINext == \\E p \\in Proc: Req(p) \\/ Do(p) \\/ Rsp(p) \0a\0aISpec == IInit  /\\  [][INext]_<<memInt, mem, ctl, buf>>\0a--------------------------------------------------------------\0aTHEOREM ISpec => []TypeInvariant\0a==============================================================\0a']]]
      ['examples/SpecifyingSystems/CachingMemory/MemoryInterface' 'MemoryInterface' %accept ~[['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a']]]
      ['examples/SpecifyingSystems/CachingMemory/WriteThroughCache' 'WriteThroughCache' %accept ~[['WriteThroughCache' '------------------ MODULE WriteThroughCache ------------------\0aEXTENDS Naturals, Sequences, MemoryInterface \0aVARIABLES wmem, ctl, buf, cache, memQ \0aCONSTANT QLen\0aASSUME (QLen \\in Nat) /\\ (QLen > 0) \0aM == INSTANCE InternalMemory WITH mem <- wmem\0a--------------------------------------------------------------\0aInit == /\\ M!IInit \0a        /\\ cache = [p \\in Proc |-> [a \\in Adr |-> NoVal] ]\0a        /\\ memQ = << >>  \0a \0aTypeInvariant == \0a  /\\ wmem  \\in [Adr -> Val]\0a  /\\ ctl   \\in [Proc -> {"rdy", "busy", "waiting", "done"}] \0a  /\\ buf   \\in [Proc -> MReq \\cup Val \\cup {NoVal}]\0a  /\\ cache \\in [Proc -> [Adr -> Val \\cup {NoVal}]] \0a  /\\ memQ  \\in Seq(Proc \\X MReq) \0a\0aCoherence == \\A p, q \\in Proc, a \\in Adr : \0a                (NoVal \\notin {cache[p][a], cache[q][a]})\0a                      => (cache[p][a]=cache[q][a]) \0a--------------------------------------------------------------\0aReq(p) == M!Req(p) /\\ UNCHANGED <<cache, memQ>> \0aRsp(p) == M!Rsp(p) /\\ UNCHANGED <<cache, memQ>> \0a\0aRdMiss(p) ==  /\\ (ctl[p] = "busy") /\\ (buf[p].op = "Rd") \0a              /\\ cache[p][buf[p].adr] = NoVal \0a              /\\ Len(memQ) < QLen\0a              /\\ memQ\' = Append(memQ, <<p, buf[p]>>)\0a              /\\ ctl\' = [ctl EXCEPT ![p] = "waiting"]\0a              /\\ UNCHANGED <<memInt, wmem, buf, cache>>\0a\0aDoRd(p) == \0a  /\\ ctl[p] \\in {"busy","waiting"} \0a  /\\ buf[p].op = "Rd" \0a  /\\ cache[p][buf[p].adr] # NoVal\0a  /\\ buf\' = [buf EXCEPT ![p] = cache[p][buf[p].adr]]\0a  /\\ ctl\' = [ctl EXCEPT ![p] = "done"]\0a  /\\ UNCHANGED <<memInt, wmem, cache, memQ>> \0a\0aDoWr(p) == \0a  LET r == buf[p]\0a  IN  /\\ (ctl[p] = "busy") /\\ (r.op = "Wr") \0a      /\\ Len(memQ) < QLen\0a      /\\ cache\' = [q \\in Proc |-> \0a                    IF (p=q)  \\/  (cache[q][r.adr]#NoVal)\0a                      THEN [cache[q] EXCEPT ![r.adr] = r.val]\0a                      ELSE cache[q] ]\0a      /\\ memQ\' = Append(memQ, <<p, r>>)\0a      /\\ buf\' = [buf EXCEPT ![p] = NoVal]\0a      /\\ ctl\' = [ctl EXCEPT ![p] = "done"]\0a      /\\ UNCHANGED <<memInt, wmem>> \0a\0avmem  ==  \0a  LET f[i \\in 0 .. Len(memQ)] == \0a        IF i=0 THEN wmem\0a               ELSE IF memQ[i][2].op = "Rd"\0a                      THEN f[i-1]\0a                      ELSE [f[i-1] EXCEPT ![memQ[i][2].adr] =\0a                                              memQ[i][2].val]\0a  IN f[Len(memQ)] \0a\0aMemQWr == LET r == Head(memQ)[2] \0a          IN  /\\ (memQ # << >>)  /\\   (r.op = "Wr") \0a              /\\ wmem\' = [wmem EXCEPT ![r.adr] = r.val] \0a              /\\ memQ\' = Tail(memQ) \0a              /\\ UNCHANGED <<memInt, buf, ctl, cache>> \0a\0aMemQRd == \0a  LET p == Head(memQ)[1] \0a      r == Head(memQ)[2] \0a  IN  /\\ (memQ # << >> ) /\\ (r.op = "Rd")\0a      /\\ memQ\' = Tail(memQ)\0a      /\\ cache\' = [cache EXCEPT ![p][r.adr] = vmem[r.adr]]\0a      /\\ UNCHANGED <<memInt, wmem, buf, ctl>>  \0a\0aEvict(p,a) == /\\ (ctl[p] = "waiting") => (buf[p].adr # a) \0a              /\\ cache\' = [cache EXCEPT ![p][a] = NoVal]\0a              /\\ UNCHANGED <<memInt, wmem, buf, ctl, memQ>> \0a\0aNext == \\/ \\E p\\in Proc : \\/ Req(p) \\/ Rsp(p) \0a                          \\/ RdMiss(p) \\/ DoRd(p) \\/ DoWr(p) \0a                          \\/ \\E a \\in Adr : Evict(p, a)\0a        \\/ MemQWr \\/ MemQRd    \0a\0aSpec == \0a  Init /\\ [][Next]_<<memInt, wmem, buf, ctl, cache, memQ>>\0a--------------------------------------------------------------\0aTHEOREM Spec => [](TypeInvariant /\\ Coherence)\0a--------------------------------------------------------------\0aLM == INSTANCE Memory \0aTHEOREM Spec => LM!Spec \0a==============================================================\0a'] ['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a'] ['Memory' '----------------------- MODULE Memory ------------------------\0aEXTENDS MemoryInterface\0aInner(mem, ctl, buf) == INSTANCE InternalMemory \0aSpec == \\EE mem, ctl, buf : Inner(mem, ctl, buf)!ISpec \0a==============================================================\0a\0a'] ['InternalMemory' '------------------ MODULE InternalMemory ---------------------\0aEXTENDS MemoryInterface\0aVARIABLES mem, ctl, buf\0a--------------------------------------------------------------\0aIInit == /\\ mem \\in [Adr->Val]\0a         /\\ ctl = [p \\in Proc |-> "rdy"] \0a         /\\ buf = [p \\in Proc |-> NoVal] \0a         /\\ memInt \\in InitMemInt\0a\0aTypeInvariant == \0a  /\\ mem \\in [Adr->Val]\0a  /\\ ctl \\in [Proc -> {"rdy", "busy","done"}] \0a  /\\ buf \\in [Proc -> MReq \\cup Val \\cup {NoVal}]\0a\0aReq(p) == /\\ ctl[p] = "rdy" \0a          /\\ \\E req \\in  MReq :\0a                /\\ Send(p, req, memInt, memInt\') \0a                /\\ buf\' = [buf EXCEPT ![p] = req]\0a                /\\ ctl\' = [ctl EXCEPT ![p] = "busy"]\0a          /\\ UNCHANGED mem \0a\0aDo(p) == \0a  /\\ ctl[p] = "busy" \0a  /\\ mem\' = IF buf[p].op = "Wr"\0a              THEN [mem EXCEPT ![buf[p].adr] = buf[p].val] \0a              ELSE mem \0a  /\\ buf\' = [buf EXCEPT ![p] = IF buf[p].op = "Wr"\0a                                  THEN NoVal\0a                                  ELSE mem[buf[p].adr]]\0a  /\\ ctl\' = [ctl EXCEPT ![p] = "done"] \0a  /\\ UNCHANGED memInt \0a\0aRsp(p) == /\\ ctl[p] = "done"\0a          /\\ Reply(p, buf[p], memInt, memInt\')\0a          /\\ ctl\' = [ctl EXCEPT ![p]= "rdy"]\0a          /\\ UNCHANGED <<mem, buf>> \0a\0aINext == \\E p \\in Proc: Req(p) \\/ Do(p) \\/ Rsp(p) \0a\0aISpec == IInit  /\\  [][INext]_<<memInt, mem, ctl, buf>>\0a--------------------------------------------------------------\0aTHEOREM ISpec => []TypeInvariant\0a==============================================================\0a']]]
      ['examples/SpecifyingSystems/Liveness/HourClock' 'HourClock' %accept ~[['HourClock' '---------------------- MODULE HourClock ----------------------\0aEXTENDS Naturals\0aVARIABLE hr\0aHCini  ==  hr \\in (1 .. 12)\0aHCnxt  ==  hr\' = IF hr # 12 THEN hr + 1 ELSE 1\0aHC  ==  HCini /\\ [][HCnxt]_hr\0a--------------------------------------------------------------\0aTHEOREM  HC => []HCini\0a==============================================================\0a']]]
      ['examples/SpecifyingSystems/Liveness/InternalMemory' 'InternalMemory' %accept ~[['InternalMemory' '------------------ MODULE InternalMemory ---------------------\0aEXTENDS MemoryInterface\0aVARIABLES mem, ctl, buf\0a--------------------------------------------------------------\0aIInit == /\\ mem \\in [Adr->Val]\0a         /\\ ctl = [p \\in Proc |-> "rdy"] \0a         /\\ buf = [p \\in Proc |-> NoVal] \0a         /\\ memInt \\in InitMemInt\0a\0aTypeInvariant == \0a  /\\ mem \\in [Adr->Val]\0a  /\\ ctl \\in [Proc -> {"rdy", "busy","done"}] \0a  /\\ buf \\in [Proc -> MReq \\cup Val \\cup {NoVal}]\0a\0aReq(p) == /\\ ctl[p] = "rdy" \0a          /\\ \\E req \\in  MReq : \0a                /\\ Send(p, req, memInt, memInt\') \0a                /\\ buf\' = [buf EXCEPT ![p] = req]\0a                /\\ ctl\' = [ctl EXCEPT ![p] = "busy"]\0a          /\\ UNCHANGED mem \0a\0aDo(p) == \0a  /\\ ctl[p] = "busy" \0a  /\\ mem\' = IF buf[p].op = "Wr"\0a              THEN [mem EXCEPT ![buf[p].adr] = buf[p].val] \0a              ELSE mem \0a  /\\ buf\' = [buf EXCEPT ![p] = IF buf[p].op = "Wr"\0a                                  THEN NoVal\0a                                  ELSE mem[buf[p].adr]]\0a  /\\ ctl\' = [ctl EXCEPT ![p] = "done"] \0a  /\\ UNCHANGED memInt \0a\0aRsp(p) == /\\ ctl[p] = "done"\0a          /\\ Reply(p, buf[p], memInt, memInt\')\0a          /\\ ctl\' = [ctl EXCEPT ![p]= "rdy"]\0a          /\\ UNCHANGED <<mem, buf>> \0a\0aINext == \\E p \\in Proc: Req(p) \\/ Do(p) \\/ Rsp(p) \0a\0aISpec == IInit  /\\  [][INext]_<<memInt, mem, ctl, buf>>\0a--------------------------------------------------------------\0aTHEOREM ISpec => []TypeInvariant\0a==============================================================\0a'] ['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a']]]
      ['examples/SpecifyingSystems/Liveness/LiveHourClock' 'LiveHourClock' %accept ~[['LiveHourClock' '--------------------------- MODULE LiveHourClock ----------------------------\0a(***************************************************************************)\0a(* This module adds the liveness condition to the hour clock specification *)\0a(* of module HourClock.                                                    *)\0a(***************************************************************************)\0a\0aEXTENDS HourClock, TLC, TLCExt\0a\0aLSpec == HC /\\ WF_hr(HCnxt)\0a  (*************************************************************************)\0a  (* The specification with the liveness condition conjoined.              *)\0a  (*************************************************************************)\0a\0a(***************************************************************************)\0a(* We now define some properties that LSpec satisfies.                     *)\0a(***************************************************************************)\0aAlwaysTick == []<><<HCnxt>>_hr\0a  (*************************************************************************)\0a  (* Asserts that infinitely many <<HCnxt>>_hr steps occur.                *)\0a  (*************************************************************************)\0a\0aAllTimes == \\A n \\in 1..12 : []<>(hr = n)\0a  (*************************************************************************)\0a  (* Asserts that, for each time n in 1..12, hr infinitely often equals n. *)\0a  (*************************************************************************)\0a\0aTypeInvariance == []HCini\0a  (*************************************************************************)\0a  (* The temporal formula asserting that HCini is always true.  It is      *)\0a  (* stated in this way to show you another way of telling TLC to check an *)\0a  (* invariant.                                                            *)\0a  (*************************************************************************)\0a  \0a-----------------------------------------------------------------------------\0aTHEOREM  LSpec => AlwaysTick /\\ AllTimes /\\ TypeInvariance\0a\0aClockSettles == \\E n \\in 1..12 : <>[](hr = n)\0a\0aPostCondition ==\0a   CounterExample =\0a    [ action |->\0a      { << <<1, [hr |-> 1]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<2, [hr |-> 2]>> >>,\0a        << <<2, [hr |-> 2]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<3, [hr |-> 3]>> >>,\0a        << <<3, [hr |-> 3]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<4, [hr |-> 4]>> >>,\0a        << <<4, [hr |-> 4]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<5, [hr |-> 5]>> >>,\0a        << <<5, [hr |-> 5]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<6, [hr |-> 6]>> >>,\0a        << <<6, [hr |-> 6]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<7, [hr |-> 7]>> >>,\0a        << <<7, [hr |-> 7]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<8, [hr |-> 8]>> >>,\0a        << <<8, [hr |-> 8]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<9, [hr |-> 9]>> >>,\0a        << <<9, [hr |-> 9]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<10, [hr |-> 10]>> >>,\0a        << <<10, [hr |-> 10]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<11, [hr |-> 11]>> >>,\0a        << <<11, [hr |-> 11]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<12, [hr |-> 12]>> >>,\0a        << <<12, [hr |-> 12]>>,\0a           [ name |-> "HCnxt",\0a             location |->\0a                 [ beginLine |-> 5,\0a                   beginColumn |-> 12,\0a                   endLine |-> 5,\0a                   endColumn |-> 46,\0a                   module |-> "HourClock" ] ],\0a           <<1, [hr |-> 1]>> >> },\0a  state |->\0a      { <<1, [hr |-> 1]>>,\0a        <<2, [hr |-> 2]>>,\0a        <<3, [hr |-> 3]>>,\0a        <<4, [hr |-> 4]>>,\0a        <<5, [hr |-> 5]>>,\0a        <<6, [hr |-> 6]>>,\0a        <<7, [hr |-> 7]>>,\0a        <<8, [hr |-> 8]>>,\0a        <<9, [hr |-> 9]>>,\0a        <<10, [hr |-> 10]>>,\0a        <<11, [hr |-> 11]>>,\0a        <<12, [hr |-> 12]>> } ]\0a=============================================================================\0a\0a'] ['HourClock' '---------------------- MODULE HourClock ----------------------\0aEXTENDS Naturals\0aVARIABLE hr\0aHCini  ==  hr \\in (1 .. 12)\0aHCnxt  ==  hr\' = IF hr # 12 THEN hr + 1 ELSE 1\0aHC  ==  HCini /\\ [][HCnxt]_hr\0a--------------------------------------------------------------\0aTHEOREM  HC => []HCini\0a==============================================================\0a']]]
      ['examples/SpecifyingSystems/Liveness/LiveInternalMemory' 'LiveInternalMemory' %accept ~[['LiveInternalMemory' '------------------------ MODULE LiveInternalMemory --------------------------\0a\0a(***************************************************************************)\0a(* This module defines LISpec to be specification ISpec of module          *)\0a(* InternalMemory enhanced with the liveness condition described in the    *)\0a(* subsection "The Liveness Requirement" of the section "The Memory        *)\0a(* Specification".                                                         *)\0a(***************************************************************************)\0a\0aEXTENDS InternalMemory\0a\0avars == <<memInt, mem, ctl, buf>>\0a  (*************************************************************************)\0a  (* The tuple of all variables.                                           *)\0a  (*************************************************************************)\0a  \0aLiveness == \\A p \\in Proc : WF_vars(Do(p)) /\\ WF_vars(Rsp(p))\0aLiveness2 == \\A p \\in Proc : WF_vars(Do(p) \\/ Rsp(p))\0a  (*************************************************************************)\0a  (* The two versions of the liveness condition defined in the book.       *)\0a  (*************************************************************************)\0a  \0aLISpec == ISpec /\\ Liveness2\0a  (*************************************************************************)\0a  (* The spec with liveness.                                               *)\0a  (*************************************************************************)\0a\0a(***************************************************************************)\0a(* The following property asserts that, whenever any processor p has       *)\0a(* issued a request, so ctl[p] = "busy", then a response eventually occurs,*)\0a(* setting ctl[p] to "rdy".                                                *)\0a(***************************************************************************)\0a\0aLivenessProperty == \0a   \\A p \\in Proc : (ctl[p] = "busy") ~> (ctl[p] = "rdy")\0a\0a-----------------------------------------------------------------------------\0a(***************************************************************************)\0a(* The following theorem asserts that specification LISpec satisfies       *)\0a(* property LivenessProperty.  The accompanying configuration file has TLC *)\0a(* check this theorem.                                                     *)\0a(***************************************************************************)\0a\0aTHEOREM LISpec => LivenessProperty\0a=============================================================================\0a'] ['InternalMemory' '------------------ MODULE InternalMemory ---------------------\0aEXTENDS MemoryInterface\0aVARIABLES mem, ctl, buf\0a--------------------------------------------------------------\0aIInit == /\\ mem \\in [Adr->Val]\0a         /\\ ctl = [p \\in Proc |-> "rdy"] \0a         /\\ buf = [p \\in Proc |-> NoVal] \0a         /\\ memInt \\in InitMemInt\0a\0aTypeInvariant == \0a  /\\ mem \\in [Adr->Val]\0a  /\\ ctl \\in [Proc -> {"rdy", "busy","done"}] \0a  /\\ buf \\in [Proc -> MReq \\cup Val \\cup {NoVal}]\0a\0aReq(p) == /\\ ctl[p] = "rdy" \0a          /\\ \\E req \\in  MReq : \0a                /\\ Send(p, req, memInt, memInt\') \0a                /\\ buf\' = [buf EXCEPT ![p] = req]\0a                /\\ ctl\' = [ctl EXCEPT ![p] = "busy"]\0a          /\\ UNCHANGED mem \0a\0aDo(p) == \0a  /\\ ctl[p] = "busy" \0a  /\\ mem\' = IF buf[p].op = "Wr"\0a              THEN [mem EXCEPT ![buf[p].adr] = buf[p].val] \0a              ELSE mem \0a  /\\ buf\' = [buf EXCEPT ![p] = IF buf[p].op = "Wr"\0a                                  THEN NoVal\0a                                  ELSE mem[buf[p].adr]]\0a  /\\ ctl\' = [ctl EXCEPT ![p] = "done"] \0a  /\\ UNCHANGED memInt \0a\0aRsp(p) == /\\ ctl[p] = "done"\0a          /\\ Reply(p, buf[p], memInt, memInt\')\0a          /\\ ctl\' = [ctl EXCEPT ![p]= "rdy"]\0a          /\\ UNCHANGED <<mem, buf>> \0a\0aINext == \\E p \\in Proc: Req(p) \\/ Do(p) \\/ Rsp(p) \0a\0aISpec == IInit  /\\  [][INext]_<<memInt, mem, ctl, buf>>\0a--------------------------------------------------------------\0aTHEOREM ISpec => []TypeInvariant\0a==============================================================\0a'] ['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a']]]
      ['examples/SpecifyingSystems/Liveness/MCLiveInternalMemory' 'MCLiveInternalMemory' %accept ~[['MCLiveInternalMemory' '---------------------- MODULE MCLiveInternalMemory -------------------------\0a(***************************************************************************)\0a(* This is a module used for running TLC to check the specification LISpec *)\0a(* of LiveInternalMemory.  We need to tell TLC the values of the constant  *)\0a(* operators Send and Reply.  We define operators MCSend and MCReply and   *)\0a(* use the configuration file to tell TLC to substitute these operators    *)\0a(* for Send and Reply.  We also define MCInitMemInt, which is substituted  *)\0a(* for InitMemInt.                                                         *)\0a(*                                                                         *)\0a(* This module is identical to module MCInternalMemory                     *)\0a(* from folder CachingMemory, except it EXTENDS module LiveInternalMemory  *)\0a(* instead of InternalMemory.                                              *)\0a(***************************************************************************)\0a\0aEXTENDS LiveInternalMemory, TLC, TLCExt\0a\0a(***************************************************************************)\0a(* The operator Send is used in specifications in conjuncts of the form    *)\0a(*                                                                         *)\0a(* (+)  Send(p, d, memInt, memInt\')                                        *)\0a(*                                                                         *)\0a(* to specify the new value of memInt.  For TLC to handle such a           *)\0a(* conjunct, the definition of Send must make (+) equal something of the   *)\0a(* form                                                                    *)\0a(*                                                                         *)\0a(*   memInt\' = ...                                                         *)\0a(*                                                                         *)\0a(* (A similar observation holds for Reply.)  We define Send so that (+)    *)\0a(* equals                                                                  *)\0a(*                                                                         *)\0a(*   memInt\' = <<p, d>>                                                    *)\0a(*                                                                         *)\0a(* If we were doing serious model checking, we might try to reduce         *)\0a(* the state space by letting the value of memInt remain constant,         *)\0a(* so we would define Send so that (+) equals                              *)\0a(*                                                                         *)\0a(*   memInt\' = memInt.                                                     *)\0a(***************************************************************************)\0aMCSend(p, d, oldMemInt, newMemInt)  ==  newMemInt = <<p, d>>\0aMCReply(p, d, oldMemInt, newMemInt) ==  newMemInt = <<p, d>>\0a\0a(***************************************************************************)\0a(* We define MCInitMemInt, the set of initial values of memInt, to contain *)\0a(* the single element <<p, NoVal>>, for an arbitrary processor p.          *)\0a(***************************************************************************)\0aMCInitMemInt == {<<CHOOSE p \\in Proc : TRUE, NoVal>>}\0a\0aAlwaysBusy == \\A p \\in Proc : []<>(ctl[p] = "busy")\0a\0aCONSTANT p1, p2, a1, a2, a3, v1, v2\0a\0aPostCondition ==\0a   CounterExample = \0a   [ action |->\0a      { << << 1,\0a              [ ctl |-> (p1 :> "rdy" @@ p2 :> "rdy"),\0a                memInt |-> <<p1, NoVal>>,\0a                mem |-> (a1 :> v1 @@ a2 :> v1 @@ a3 :> v1),\0a                buf |-> (p1 :> NoVal @@ p2 :> NoVal) ] >>,\0a           [ name |-> "Req",\0a             location |->\0a                 [ beginLine |-> 15,\0a                   beginColumn |-> 11,\0a                   endLine |-> 20,\0a                   endColumn |-> 26,\0a                   module |-> "InternalMemory" ],\0a             context |-> [p |-> p2],\0a             parameters |-> <<"p">> ],\0a           << 2,\0a              [ ctl |-> (p1 :> "rdy" @@ p2 :> "busy"),\0a                memInt |-> <<p2, [val |-> v1, op |-> "Wr", adr |-> a2]>>,\0a                mem |-> (a1 :> v1 @@ a2 :> v1 @@ a3 :> v1),\0a                buf |->\0a                    ( p1 :> NoVal @@\0a                      p2 :> [val |-> v1, op |-> "Wr", adr |-> a2] ) ] >> >>,\0a        << << 2,\0a              [ ctl |-> (p1 :> "rdy" @@ p2 :> "busy"),\0a                memInt |-> <<p2, [val |-> v1, op |-> "Wr", adr |-> a2]>>,\0a                mem |-> (a1 :> v1 @@ a2 :> v1 @@ a3 :> v1),\0a                buf |->\0a                    ( p1 :> NoVal @@\0a                      p2 :> [val |-> v1, op |-> "Wr", adr |-> a2] ) ] >>,\0a           [ name |-> "Do",\0a             location |->\0a                 [ beginLine |-> 23,\0a                   beginColumn |-> 3,\0a                   endLine |-> 31,\0a                   endColumn |-> 21,\0a                   module |-> "InternalMemory" ],\0a             context |-> [p |-> p2],\0a             parameters |-> <<"p">> ],\0a           << 3,\0a              [ ctl |-> (p1 :> "rdy" @@ p2 :> "done"),\0a                memInt |-> <<p2, [val |-> v1, op |-> "Wr", adr |-> a2]>>,\0a                mem |-> (a1 :> v1 @@ a2 :> v1 @@ a3 :> v1),\0a                buf |-> (p1 :> NoVal @@ p2 :> NoVal) ] >> >>,\0a        << << 3,\0a              [ ctl |-> (p1 :> "rdy" @@ p2 :> "done"),\0a                memInt |-> <<p2, [val |-> v1, op |-> "Wr", adr |-> a2]>>,\0a                mem |-> (a1 :> v1 @@ a2 :> v1 @@ a3 :> v1),\0a                buf |-> (p1 :> NoVal @@ p2 :> NoVal) ] >>,\0a           [ name |-> "Rsp",\0a             location |->\0a                 [ beginLine |-> 33,\0a                   beginColumn |-> 11,\0a                   endLine |-> 36,\0a                   endColumn |-> 35,\0a                   module |-> "InternalMemory" ],\0a             context |-> [p |-> p2],\0a             parameters |-> <<"p">> ],\0a           << 4,\0a              [ ctl |-> (p1 :> "rdy" @@ p2 :> "rdy"),\0a                memInt |-> <<p2, NoVal>>,\0a                mem |-> (a1 :> v1 @@ a2 :> v1 @@ a3 :> v1),\0a                buf |-> (p1 :> NoVal @@ p2 :> NoVal) ] >> >>,\0a        << << 4,\0a              [ ctl |-> (p1 :> "rdy" @@ p2 :> "rdy"),\0a                memInt |-> <<p2, NoVal>>,\0a                mem |-> (a1 :> v1 @@ a2 :> v1 @@ a3 :> v1),\0a                buf |-> (p1 :> NoVal @@ p2 :> NoVal) ] >>,\0a           [ name |-> "Req",\0a             location |->\0a                 [ beginLine |-> 15,\0a                   beginColumn |-> 11,\0a                   endLine |-> 20,\0a                   endColumn |-> 26,\0a                   module |-> "InternalMemory" ],\0a             context |-> [p |-> p2],\0a             parameters |-> <<"p">> ],\0a           << 2,\0a              [ ctl |-> (p1 :> "rdy" @@ p2 :> "busy"),\0a                memInt |-> <<p2, [val |-> v1, op |-> "Wr", adr |-> a2]>>,\0a                mem |-> (a1 :> v1 @@ a2 :> v1 @@ a3 :> v1),\0a                buf |->\0a                    ( p1 :> NoVal @@\0a                      p2 :> [val |-> v1, op |-> "Wr", adr |-> a2] ) ] >> >> },\0a  state |->\0a      { << 1,\0a           [ ctl |-> (p1 :> "rdy" @@ p2 :> "rdy"),\0a             memInt |-> <<p1, NoVal>>,\0a             mem |-> (a1 :> v1 @@ a2 :> v1 @@ a3 :> v1),\0a             buf |-> (p1 :> NoVal @@ p2 :> NoVal) ] >>,\0a        << 2,\0a           [ ctl |-> (p1 :> "rdy" @@ p2 :> "busy"),\0a             memInt |-> <<p2, [val |-> v1, op |-> "Wr", adr |-> a2]>>,\0a             mem |-> (a1 :> v1 @@ a2 :> v1 @@ a3 :> v1),\0a             buf |->\0a                 ( p1 :> NoVal @@\0a                   p2 :> [val |-> v1, op |-> "Wr", adr |-> a2] ) ] >>,\0a        << 3,\0a           [ ctl |-> (p1 :> "rdy" @@ p2 :> "done"),\0a             memInt |-> <<p2, [val |-> v1, op |-> "Wr", adr |-> a2]>>,\0a             mem |-> (a1 :> v1 @@ a2 :> v1 @@ a3 :> v1),\0a             buf |-> (p1 :> NoVal @@ p2 :> NoVal) ] >>,\0a        << 4,\0a           [ ctl |-> (p1 :> "rdy" @@ p2 :> "rdy"),\0a             memInt |-> <<p2, NoVal>>,\0a             mem |-> (a1 :> v1 @@ a2 :> v1 @@ a3 :> v1),\0a             buf |-> (p1 :> NoVal @@ p2 :> NoVal) ] >> } ]\0a=============================================================================\0a\0a'] ['LiveInternalMemory' '------------------------ MODULE LiveInternalMemory --------------------------\0a\0a(***************************************************************************)\0a(* This module defines LISpec to be specification ISpec of module          *)\0a(* InternalMemory enhanced with the liveness condition described in the    *)\0a(* subsection "The Liveness Requirement" of the section "The Memory        *)\0a(* Specification".                                                         *)\0a(***************************************************************************)\0a\0aEXTENDS InternalMemory\0a\0avars == <<memInt, mem, ctl, buf>>\0a  (*************************************************************************)\0a  (* The tuple of all variables.                                           *)\0a  (*************************************************************************)\0a  \0aLiveness == \\A p \\in Proc : WF_vars(Do(p)) /\\ WF_vars(Rsp(p))\0aLiveness2 == \\A p \\in Proc : WF_vars(Do(p) \\/ Rsp(p))\0a  (*************************************************************************)\0a  (* The two versions of the liveness condition defined in the book.       *)\0a  (*************************************************************************)\0a  \0aLISpec == ISpec /\\ Liveness2\0a  (*************************************************************************)\0a  (* The spec with liveness.                                               *)\0a  (*************************************************************************)\0a\0a(***************************************************************************)\0a(* The following property asserts that, whenever any processor p has       *)\0a(* issued a request, so ctl[p] = "busy", then a response eventually occurs,*)\0a(* setting ctl[p] to "rdy".                                                *)\0a(***************************************************************************)\0a\0aLivenessProperty == \0a   \\A p \\in Proc : (ctl[p] = "busy") ~> (ctl[p] = "rdy")\0a\0a-----------------------------------------------------------------------------\0a(***************************************************************************)\0a(* The following theorem asserts that specification LISpec satisfies       *)\0a(* property LivenessProperty.  The accompanying configuration file has TLC *)\0a(* check this theorem.                                                     *)\0a(***************************************************************************)\0a\0aTHEOREM LISpec => LivenessProperty\0a=============================================================================\0a'] ['InternalMemory' '------------------ MODULE InternalMemory ---------------------\0aEXTENDS MemoryInterface\0aVARIABLES mem, ctl, buf\0a--------------------------------------------------------------\0aIInit == /\\ mem \\in [Adr->Val]\0a         /\\ ctl = [p \\in Proc |-> "rdy"] \0a         /\\ buf = [p \\in Proc |-> NoVal] \0a         /\\ memInt \\in InitMemInt\0a\0aTypeInvariant == \0a  /\\ mem \\in [Adr->Val]\0a  /\\ ctl \\in [Proc -> {"rdy", "busy","done"}] \0a  /\\ buf \\in [Proc -> MReq \\cup Val \\cup {NoVal}]\0a\0aReq(p) == /\\ ctl[p] = "rdy" \0a          /\\ \\E req \\in  MReq : \0a                /\\ Send(p, req, memInt, memInt\') \0a                /\\ buf\' = [buf EXCEPT ![p] = req]\0a                /\\ ctl\' = [ctl EXCEPT ![p] = "busy"]\0a          /\\ UNCHANGED mem \0a\0aDo(p) == \0a  /\\ ctl[p] = "busy" \0a  /\\ mem\' = IF buf[p].op = "Wr"\0a              THEN [mem EXCEPT ![buf[p].adr] = buf[p].val] \0a              ELSE mem \0a  /\\ buf\' = [buf EXCEPT ![p] = IF buf[p].op = "Wr"\0a                                  THEN NoVal\0a                                  ELSE mem[buf[p].adr]]\0a  /\\ ctl\' = [ctl EXCEPT ![p] = "done"] \0a  /\\ UNCHANGED memInt \0a\0aRsp(p) == /\\ ctl[p] = "done"\0a          /\\ Reply(p, buf[p], memInt, memInt\')\0a          /\\ ctl\' = [ctl EXCEPT ![p]= "rdy"]\0a          /\\ UNCHANGED <<mem, buf>> \0a\0aINext == \\E p \\in Proc: Req(p) \\/ Do(p) \\/ Rsp(p) \0a\0aISpec == IInit  /\\  [][INext]_<<memInt, mem, ctl, buf>>\0a--------------------------------------------------------------\0aTHEOREM ISpec => []TypeInvariant\0a==============================================================\0a'] ['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a']]]
      ['examples/SpecifyingSystems/Liveness/Memory' 'Memory' %accept ~[['Memory' '----------------------- MODULE Memory ------------------------\0aEXTENDS MemoryInterface\0aInner(mem, ctl, buf) == INSTANCE InternalMemory \0aSpec == \\EE mem, ctl, buf : Inner(mem, ctl, buf)!ISpec \0a==============================================================\0a\0a'] ['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a'] ['InternalMemory' '------------------ MODULE InternalMemory ---------------------\0aEXTENDS MemoryInterface\0aVARIABLES mem, ctl, buf\0a--------------------------------------------------------------\0aIInit == /\\ mem \\in [Adr->Val]\0a         /\\ ctl = [p \\in Proc |-> "rdy"] \0a         /\\ buf = [p \\in Proc |-> NoVal] \0a         /\\ memInt \\in InitMemInt\0a\0aTypeInvariant == \0a  /\\ mem \\in [Adr->Val]\0a  /\\ ctl \\in [Proc -> {"rdy", "busy","done"}] \0a  /\\ buf \\in [Proc -> MReq \\cup Val \\cup {NoVal}]\0a\0aReq(p) == /\\ ctl[p] = "rdy" \0a          /\\ \\E req \\in  MReq : \0a                /\\ Send(p, req, memInt, memInt\') \0a                /\\ buf\' = [buf EXCEPT ![p] = req]\0a                /\\ ctl\' = [ctl EXCEPT ![p] = "busy"]\0a          /\\ UNCHANGED mem \0a\0aDo(p) == \0a  /\\ ctl[p] = "busy" \0a  /\\ mem\' = IF buf[p].op = "Wr"\0a              THEN [mem EXCEPT ![buf[p].adr] = buf[p].val] \0a              ELSE mem \0a  /\\ buf\' = [buf EXCEPT ![p] = IF buf[p].op = "Wr"\0a                                  THEN NoVal\0a                                  ELSE mem[buf[p].adr]]\0a  /\\ ctl\' = [ctl EXCEPT ![p] = "done"] \0a  /\\ UNCHANGED memInt \0a\0aRsp(p) == /\\ ctl[p] = "done"\0a          /\\ Reply(p, buf[p], memInt, memInt\')\0a          /\\ ctl\' = [ctl EXCEPT ![p]= "rdy"]\0a          /\\ UNCHANGED <<mem, buf>> \0a\0aINext == \\E p \\in Proc: Req(p) \\/ Do(p) \\/ Rsp(p) \0a\0aISpec == IInit  /\\  [][INext]_<<memInt, mem, ctl, buf>>\0a--------------------------------------------------------------\0aTHEOREM ISpec => []TypeInvariant\0a==============================================================\0a']]]
      ['examples/SpecifyingSystems/Liveness/MemoryInterface' 'MemoryInterface' %accept ~[['MemoryInterface' '-------------------------- MODULE MemoryInterface ---------------------------\0aVARIABLE memInt\0aCONSTANTS  Send(_, _, _, _),\0a           Reply(_, _, _, _),\0a           InitMemInt, \0a           Proc,  \0a           Adr,  \0a           Val\0a\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0aNoVal == CHOOSE v : v \\notin Val\0a=============================================================================\0a']]]
      ['examples/SpecifyingSystems/TLC/ABCorrectness' 'ABCorrectness' %accept ~[['ABCorrectness' '------------------- MODULE ABCorrectness --------------------\0aEXTENDS Naturals\0aCONSTANTS Data\0aVARIABLES sBit, sAck, rBit, sent, rcvd  \0a-------------------------------------------------------------\0aABCInit == /\\ sBit \\in {0, 1}\0a           /\\ sAck = sBit\0a           /\\ rBit = sBit\0a           /\\ sent \\in Data\0a           /\\ rcvd \\in Data\0a\0aCSndNewValue(d) == /\\ sAck = sBit\0a                   /\\ sent\' = d\0a                   /\\ sBit\' = 1 - sBit\0a                   /\\ UNCHANGED <<sAck, rBit, rcvd>>\0a\0aCRcvMsg == /\\ rBit # sBit \0a           /\\ rBit\' = sBit\0a           /\\ rcvd\' = sent\0a           /\\ UNCHANGED <<sBit, sAck, sent>>\0a\0aCRcvAck == /\\ rBit # sAck\0a           /\\ sAck\' = rBit\0a           /\\ UNCHANGED <<sBit, rBit, sent, rcvd>>\0a\0aABCNext == \\/  \\E d \\in Data : CSndNewValue(d) \0a           \\/  CRcvMsg \\/ CRcvAck \0a-------------------------------------------------------------\0acvars == <<sBit, sAck, rBit, sent, rcvd>>\0a\0aTypeInv == /\\ sBit \\in {0, 1}\0a           /\\ sAck \\in {0, 1}\0a           /\\ rBit \\in {0, 1}\0a           /\\ sent \\in Data\0a           /\\ rcvd \\in Data\0a\0aABCFairness == WF_cvars(CRcvMsg) /\\ WF_cvars(CRcvAck)   \0a\0aABCSpec == ABCInit /\\ [][ABCNext]_cvars /\\ ABCFairness\0a\0aInfOftenOutOfSync == []<>(sBit # sAck)\0a==============================================================\0a']]]
      ['examples/SpecifyingSystems/TLC/AlternatingBit' 'AlternatingBit' %accept ~[['AlternatingBit' '--------------------------- MODULE AlternatingBit ---------------------------\0aEXTENDS Naturals, Sequences\0aCONSTANTS Data\0aVARIABLES msgQ, \0a          ackQ, \0a          sBit, \0a          sAck, \0a          rBit, \0a          sent, \0a          rcvd  \0a-----------------------------------------------------------------------------\0aABInit == /\\ msgQ = << >>\0a          /\\ ackQ = << >>\0a          /\\ sBit \\in {0, 1}\0a          /\\ sAck = sBit\0a          /\\ rBit = sBit\0a          /\\ sent \\in Data\0a          /\\ rcvd \\in Data\0a\0aABTypeInv == /\\ msgQ \\in Seq({0,1} \\X Data)\0a             /\\ ackQ \\in Seq({0,1})\0a             /\\ sBit \\in {0, 1}\0a             /\\ sAck \\in {0, 1}\0a             /\\ rBit \\in {0, 1}\0a             /\\ sent \\in Data\0a             /\\ rcvd \\in Data\0a-----------------------------------------------------------------------------\0aSndNewValue(d) == \0a  /\\ sAck = sBit\0a  /\\ sent\' = d\0a  /\\ sBit\' = 1 - sBit\0a  /\\ msgQ\' = Append(msgQ, <<sBit\', d>>) \0a  /\\ UNCHANGED <<ackQ, sAck, rBit, rcvd>>\0a\0aReSndMsg == \0a  /\\ sAck # sBit\0a  /\\ msgQ\' = Append(msgQ, <<sBit, sent>>)\0a  /\\ UNCHANGED <<ackQ, sBit, sAck, rBit, sent, rcvd>>\0a\0aRcvMsg == \0a  /\\ msgQ # <<>>\0a  /\\ msgQ\' = Tail(msgQ)\0a  /\\ rBit\' = Head(msgQ)[1] \0a  /\\ rcvd\' = Head(msgQ)[2] \0a  /\\ UNCHANGED <<ackQ, sBit, sAck, sent>>\0a\0aSndAck == /\\ ackQ\' = Append(ackQ, rBit)\0a          /\\ UNCHANGED <<msgQ, sBit, sAck, rBit, sent, rcvd>>\0a\0aRcvAck == /\\ ackQ # << >>\0a          /\\ ackQ\' = Tail(ackQ)\0a          /\\ sAck\' = Head(ackQ)\0a          /\\ UNCHANGED <<msgQ, sBit, rBit, sent, rcvd>>\0a\0aLose(q) == \0a   /\\ q # << >>\0a   /\\ \\E i \\in 1..Len(q) : \0a          q\' = [j \\in 1..(Len(q)-1) |-> IF j < i THEN q[j] \0a                                                 ELSE q[j+1] ]\0a   /\\ UNCHANGED <<sBit, sAck, rBit, sent, rcvd>>\0a\0aLoseMsg == Lose(msgQ) /\\ UNCHANGED ackQ\0a\0aLoseAck == Lose(ackQ) /\\ UNCHANGED msgQ\0a\0aABNext == \\/  \\E d \\in Data : SndNewValue(d) \0a          \\/  ReSndMsg \\/ RcvMsg \\/ SndAck \\/ RcvAck \0a          \\/  LoseMsg \\/ LoseAck \0a-----------------------------------------------------------------------------\0aabvars == << msgQ, ackQ, sBit, sAck, rBit, sent, rcvd>>\0a\0aABFairness == /\\ WF_abvars(ReSndMsg) /\\ WF_abvars(SndAck)   \0a              /\\ SF_abvars(RcvMsg) /\\ SF_abvars(RcvAck) \0a-----------------------------------------------------------------------------\0aABSpec == ABInit /\\ [][ABNext]_abvars /\\ ABFairness\0a-----------------------------------------------------------------------------\0aTHEOREM ABSpec => []ABTypeInv\0a=============================================================================\0a']]]
      ['examples/SpecifyingSystems/TLC/MCAlternatingBit' 'MCAlternatingBit' %accept ~[['MCAlternatingBit' '--------------------------- MODULE MCAlternatingBit -------------------------\0aEXTENDS AlternatingBit, TLC, TLCExt\0a\0aINSTANCE ABCorrectness \0a\0aCONSTANTS msgQLen, ackQLen\0a\0aSeqConstraint == /\\ Len(msgQ) \\leq msgQLen\0a                 /\\ Len(ackQ) \\leq ackQLen\0a\0aSentLeadsToRcvd == \\A d \\in Data : (sent = d) /\\ (sBit # sAck) ~> (rcvd = d)\0a\0aPermanentBitDisagreement == <>[](sBit # rBit)\0a\0aCONSTANT d1, d2\0a\0aPostCondition ==\0a   CounterExample = \0a   [ action |->\0a      { << << 1,\0a              [ msgQ |-> <<>>,\0a                ackQ |-> <<>>,\0a                sent |-> d1,\0a                sBit |-> 0,\0a                sAck |-> 0,\0a                rcvd |-> d1,\0a                rBit |-> 0 ] >>,\0a           [ name |-> "SndAck",\0a             location |->\0a                 [ beginLine |-> 47,\0a                   beginColumn |-> 11,\0a                   endLine |-> 48,\0a                   endColumn |-> 61,\0a                   module |-> "AlternatingBit" ] ],\0a           << 2,\0a              [ msgQ |-> <<>>,\0a                ackQ |-> <<0>>,\0a                sent |-> d1,\0a                sBit |-> 0,\0a                sAck |-> 0,\0a                rcvd |-> d1,\0a                rBit |-> 0 ] >> >>,\0a        << << 2,\0a              [ msgQ |-> <<>>,\0a                ackQ |-> <<0>>,\0a                sent |-> d1,\0a                sBit |-> 0,\0a                sAck |-> 0,\0a                rcvd |-> d1,\0a                rBit |-> 0 ] >>,\0a           [ name |-> "RcvAck",\0a             location |->\0a                 [ beginLine |-> 50,\0a                   beginColumn |-> 11,\0a                   endLine |-> 53,\0a                   endColumn |-> 55,\0a                   module |-> "AlternatingBit" ] ],\0a           << 1,\0a              [ msgQ |-> <<>>,\0a                ackQ |-> <<>>,\0a                sent |-> d1,\0a                sBit |-> 0,\0a                sAck |-> 0,\0a                rcvd |-> d1,\0a                rBit |-> 0 ] >> >> },\0a  state |->\0a      { << 1,\0a           [ msgQ |-> <<>>,\0a             ackQ |-> <<>>,\0a             sent |-> d1,\0a             sBit |-> 0,\0a             sAck |-> 0,\0a             rcvd |-> d1,\0a             rBit |-> 0 ] >>,\0a        << 2,\0a           [ msgQ |-> <<>>,\0a             ackQ |-> <<0>>,\0a             sent |-> d1,\0a             sBit |-> 0,\0a             sAck |-> 0,\0a             rcvd |-> d1,\0a             rBit |-> 0 ] >> } ]\0a=============================================================================\0a\0aImpliedAction == [ABCNext]_cvars\0a\0aTNext == WF_msgQ(~ABTypeInv\')\0aTProp == \\A d \\in Data : (sent = d) => [](sent = d)\0a\0aCSpec == ABSpec /\\ TNext\0a\0a\\* DataPerm == Permutations(Data)\0a==============================================================\0a'] ['AlternatingBit' '--------------------------- MODULE AlternatingBit ---------------------------\0aEXTENDS Naturals, Sequences\0aCONSTANTS Data\0aVARIABLES msgQ, \0a          ackQ, \0a          sBit, \0a          sAck, \0a          rBit, \0a          sent, \0a          rcvd  \0a-----------------------------------------------------------------------------\0aABInit == /\\ msgQ = << >>\0a          /\\ ackQ = << >>\0a          /\\ sBit \\in {0, 1}\0a          /\\ sAck = sBit\0a          /\\ rBit = sBit\0a          /\\ sent \\in Data\0a          /\\ rcvd \\in Data\0a\0aABTypeInv == /\\ msgQ \\in Seq({0,1} \\X Data)\0a             /\\ ackQ \\in Seq({0,1})\0a             /\\ sBit \\in {0, 1}\0a             /\\ sAck \\in {0, 1}\0a             /\\ rBit \\in {0, 1}\0a             /\\ sent \\in Data\0a             /\\ rcvd \\in Data\0a-----------------------------------------------------------------------------\0aSndNewValue(d) == \0a  /\\ sAck = sBit\0a  /\\ sent\' = d\0a  /\\ sBit\' = 1 - sBit\0a  /\\ msgQ\' = Append(msgQ, <<sBit\', d>>) \0a  /\\ UNCHANGED <<ackQ, sAck, rBit, rcvd>>\0a\0aReSndMsg == \0a  /\\ sAck # sBit\0a  /\\ msgQ\' = Append(msgQ, <<sBit, sent>>)\0a  /\\ UNCHANGED <<ackQ, sBit, sAck, rBit, sent, rcvd>>\0a\0aRcvMsg == \0a  /\\ msgQ # <<>>\0a  /\\ msgQ\' = Tail(msgQ)\0a  /\\ rBit\' = Head(msgQ)[1] \0a  /\\ rcvd\' = Head(msgQ)[2] \0a  /\\ UNCHANGED <<ackQ, sBit, sAck, sent>>\0a\0aSndAck == /\\ ackQ\' = Append(ackQ, rBit)\0a          /\\ UNCHANGED <<msgQ, sBit, sAck, rBit, sent, rcvd>>\0a\0aRcvAck == /\\ ackQ # << >>\0a          /\\ ackQ\' = Tail(ackQ)\0a          /\\ sAck\' = Head(ackQ)\0a          /\\ UNCHANGED <<msgQ, sBit, rBit, sent, rcvd>>\0a\0aLose(q) == \0a   /\\ q # << >>\0a   /\\ \\E i \\in 1..Len(q) : \0a          q\' = [j \\in 1..(Len(q)-1) |-> IF j < i THEN q[j] \0a                                                 ELSE q[j+1] ]\0a   /\\ UNCHANGED <<sBit, sAck, rBit, sent, rcvd>>\0a\0aLoseMsg == Lose(msgQ) /\\ UNCHANGED ackQ\0a\0aLoseAck == Lose(ackQ) /\\ UNCHANGED msgQ\0a\0aABNext == \\/  \\E d \\in Data : SndNewValue(d) \0a          \\/  ReSndMsg \\/ RcvMsg \\/ SndAck \\/ RcvAck \0a          \\/  LoseMsg \\/ LoseAck \0a-----------------------------------------------------------------------------\0aabvars == << msgQ, ackQ, sBit, sAck, rBit, sent, rcvd>>\0a\0aABFairness == /\\ WF_abvars(ReSndMsg) /\\ WF_abvars(SndAck)   \0a              /\\ SF_abvars(RcvMsg) /\\ SF_abvars(RcvAck) \0a-----------------------------------------------------------------------------\0aABSpec == ABInit /\\ [][ABNext]_abvars /\\ ABFairness\0a-----------------------------------------------------------------------------\0aTHEOREM ABSpec => []ABTypeInv\0a=============================================================================\0a'] ['ABCorrectness' '------------------- MODULE ABCorrectness --------------------\0aEXTENDS Naturals\0aCONSTANTS Data\0aVARIABLES sBit, sAck, rBit, sent, rcvd  \0a-------------------------------------------------------------\0aABCInit == /\\ sBit \\in {0, 1}\0a           /\\ sAck = sBit\0a           /\\ rBit = sBit\0a           /\\ sent \\in Data\0a           /\\ rcvd \\in Data\0a\0aCSndNewValue(d) == /\\ sAck = sBit\0a                   /\\ sent\' = d\0a                   /\\ sBit\' = 1 - sBit\0a                   /\\ UNCHANGED <<sAck, rBit, rcvd>>\0a\0aCRcvMsg == /\\ rBit # sBit \0a           /\\ rBit\' = sBit\0a           /\\ rcvd\' = sent\0a           /\\ UNCHANGED <<sBit, sAck, sent>>\0a\0aCRcvAck == /\\ rBit # sAck\0a           /\\ sAck\' = rBit\0a           /\\ UNCHANGED <<sBit, rBit, sent, rcvd>>\0a\0aABCNext == \\/  \\E d \\in Data : CSndNewValue(d) \0a           \\/  CRcvMsg \\/ CRcvAck \0a-------------------------------------------------------------\0acvars == <<sBit, sAck, rBit, sent, rcvd>>\0a\0aTypeInv == /\\ sBit \\in {0, 1}\0a           /\\ sAck \\in {0, 1}\0a           /\\ rBit \\in {0, 1}\0a           /\\ sent \\in Data\0a           /\\ rcvd \\in Data\0a\0aABCFairness == WF_cvars(CRcvMsg) /\\ WF_cvars(CRcvAck)   \0a\0aABCSpec == ABCInit /\\ [][ABCNext]_cvars /\\ ABCFairness\0a\0aInfOftenOutOfSync == []<>(sBit # sAck)\0a==============================================================\0a']]]
      ['examples/acp/ACP_SB' 'ACP_SB' %accept ~[['ACP_SB' '--------------------------------- MODULE ACP_SB --------------------------------\0a\\* Time-stamp: <10 Jun 2002 at 12:39:50 by charpov on berlioz.cs.unh.edu>\0a\0a\\* `^Atomic Committment Protocol^\' with Simple Broadcast primitive (ACP-SB)\0a\\* From:\0a\\* `^Sape Mullender^\', editor.  Distributed Systems.\0a\\* Chapter 6: Non-Blocking Atomic Commitment, by `^\\"O. Babao\\u{g}lu and S. Toueg.^\'\0a\\* 1993.\0a\0a\\*******************************************************************************\0a\\* Synchronous communication has been replaced with (implicit) asynchronous communication.\0a\\* Failures are detected "magically" instead or relying on timeouts.\0a\\*\0a\\* This version of the protocol uses a "simple broadcast" where a broadcast is simply a \0a\\* series of messages sent, possibly interrupted by a failure.  Consequently, this algorithm\0a\\* is "non terminating" and property AC5 does not hold.\0a\\*******************************************************************************\0a\0aCONSTANTS\0a  participants,             \\* set of participants\0a  yes, no,                  \\* vote\0a  undecided, commit, abort, \\* decision\0a  waiting,                  \\* coordinator state wrt a participant\0a  notsent                   \\* broadcast state wrt a participant\0a\0aVARIABLES\0a  participant, \\* participants (N)\0a  coordinator  \\* coordinator  (1)\0a\0a--------------------------------------------------------------------------------\0a\0aTypeInvParticipant  == participant \\in  [\0a                         participants -> [\0a                           vote      : {yes, no}, \0a                           alive     : BOOLEAN, \0a                           decision  : {undecided, commit, abort},\0a                           faulty    : BOOLEAN,\0a                           voteSent  : BOOLEAN\0a                         ]\0a                       ]\0a\0aTypeInvCoordinator == coordinator \\in  [\0a                        request   : [participants -> BOOLEAN],\0a                        vote      : [participants -> {waiting, yes, no}],\0a                        broadcast : [participants -> {commit, abort, notsent}],\0a                        decision  : {commit, abort, undecided},\0a                        alive     : BOOLEAN,\0a                        faulty    : BOOLEAN\0a                      ]\0a\0aTypeInv == TypeInvParticipant /\\ TypeInvCoordinator\0a\0a--------------------------------------------------------------------------------\0a\0a\\* Initially:\0a\\* All the participants:\0a\\*  have a yes/no vote\0a\\*  are alive and not faulty\0a\\*  have not sent in their votes yet\0a\\*  are undecided about final decision\0a\0a\\* The coordinator:\0a\\*  has not sent vote requests yet\0a\\*  has not recieved votes from any participant\0a\\*  is alive and not faulty\0a\\*  has not sent broadcast messages to any participant\0a\\*  is undecided about final decision\0a\0aInitParticipant == participant \\in [\0a                     participants -> [\0a                       vote     : {yes, no},\0a                       alive    : {TRUE},\0a                       decision : {undecided},\0a                       faulty   : {FALSE},\0a                       voteSent : {FALSE}\0a                     ]\0a                   ]\0a\0aInitCoordinator == coordinator \\in [\0a                     request   : [participants -> {FALSE}],\0a                     vote      : [participants -> {waiting}],\0a                     alive     : {TRUE},\0a                     broadcast : [participants -> {notsent}],\0a                     decision  : {undecided},\0a                     faulty    : {FALSE}\0a                   ]       \0a\0aInit == InitParticipant /\\ InitCoordinator\0a\0a--------------------------------------------------------------------------------\0a\\* COORDINATOR STATEMENTS\0a\0a\\* request(i):\0a\\* IF\0a\\*   coordinator is alive\0a\\*   request for vote has not been sent to participant i\0a\\* THEN `~ why isn\'t THEN left-justified? ~\'\0a\\*   request for vote is sent to participant i\0a\0arequest(i) == /\\ coordinator.alive\0a              /\\ ~coordinator.request[i]\0a              /\\ coordinator\' = [coordinator EXCEPT !.request =\0a                   [@ EXCEPT ![i] = TRUE]\0a                 ]\0a              /\\ UNCHANGED<<participant>>\0a\0a\0a\\* getVote(i):\0a\\* IF\0a\\*   coordinator is alive\0a\\*   coordinator is still undecided\0a\\*   coordinator has sent request for votes to all participants\0a\\*   coordinator is waiting to receive a vote from participant i\0a\\*   participant i has sent the vote message\0a\\* THEN\0a\\*   the coordinator can record the vote of participant i\0a\0agetVote(i) == /\\ coordinator.alive\0a              /\\ coordinator.decision = undecided\0a              /\\ \\A j \\in participants : coordinator.request[j]\0a              /\\ coordinator.vote[i] = waiting\0a              /\\ participant[i].voteSent\0a              /\\ coordinator\' = [coordinator EXCEPT !.vote = \0a                   [@ EXCEPT ![i] = participant[i].vote]\0a                 ]\0a              /\\ UNCHANGED<<participant>>\0a\0a\0a\\* detectFault(i):\0a\\* IF\0a\\*   coordinator is alive\0a\\*   coordinator is still undecided\0a\\*   coordinator has sent request for votes to all participants\0a\\*   coordinator is waiting for vote from participant i\0a\\*   participant i has died without sending its vote\0a\\* THEN\0a\\*   coordinator times out on participant i and decides to abort\0a\0adetectFault(i) == /\\ coordinator.alive\0a                  /\\ coordinator.decision = undecided\0a                  /\\ \\A j \\in participants : coordinator.request[j]\0a                  /\\ coordinator.vote[i] = waiting\0a                  /\\ ~participant[i].alive\0a                  /\\ ~participant[i].voteSent\0a                  /\\ coordinator\' = [coordinator EXCEPT !.decision = abort]\0a                  /\\ UNCHANGED<<participant>>\0a\0a\0a\\* makeDecision:\0a\\* IF\0a\\*   coordinator is alive\0a\\*   coordinator is undecided\0a\\*   coordinator has received votes from all participants\0a\\* THEN\0a\\*   IF\0a\\*     all votes are yes\0a\\*   THEN\0a\\*     coordinator decides commit\0a\\*   ELSE\0a\\*     coordinator decides abort\0a\0amakeDecision == /\\ coordinator.alive\0a                /\\ coordinator.decision = undecided\0a                /\\ \\A j \\in participants : coordinator.vote[j] \\in {yes, no}\0a                /\\ \\/ /\\ \\A j \\in participants : coordinator.vote[j] = yes\0a                      /\\ coordinator\' = [coordinator EXCEPT !.decision = commit]\0a                   \\/ /\\ \\E j \\in participants : coordinator.vote[j] = no\0a                      /\\ coordinator\' = [coordinator EXCEPT !.decision = abort]\0a                /\\ UNCHANGED<<participant>>\0a\0a\0a\\* coordBroadcast(i) (simple broadcast):\0a\\* IF \0a\\*   coordinator is alive\0a\\*   coordinator has made a decision\0a\\*   coordinator has not sent the decision to participant i\0a\\* THEN\0a\\*   coordinator sends its decision to participant i \0a\0acoordBroadcast(i) == /\\ coordinator.alive\0a                     /\\ coordinator.decision # undecided\0a                     /\\ coordinator.broadcast[i] = notsent\0a                     /\\ coordinator\' = [coordinator EXCEPT !.broadcast = \0a                          [@ EXCEPT ![i] = coordinator.decision]\0a                        ]\0a                     /\\ UNCHANGED<<participant>>\0a\0a\0a\\* coordDie:\0a\\* IF \0a\\*   coordinator is alive\0a\\* THEN\0a\\*   coordinator dies\0a\\*   coordinator is now faulty\0a\0acoordDie == /\\ coordinator.alive\0a            /\\ coordinator\' = [coordinator EXCEPT !.alive = FALSE, !.faulty = TRUE]\0a            /\\ UNCHANGED<<participant>>\0a\0a------------------------------------------------------------------------------\0a\0a\\* PARTICIPANT STATEMENTS \0a\0a\\* sendVote(i):\0a\\* IF \0a\\*   participant is alive\0a\\*   participant has received a request for vote\0a\\* THEN\0a\\*   participant sends vote\0a\0asendVote(i) == /\\ participant[i].alive\0a               /\\ coordinator.request[i]\0a               /\\ participant\' = [participant EXCEPT ![i] = \0a                    [@ EXCEPT !.voteSent = TRUE]\0a                  ]\0a               /\\ UNCHANGED<<coordinator>>\0a\0a\0a\\* abortOnVote(i):\0a\\* IF\0a\\*   participant is alive\0a\\*   participant is undecided\0a\\*   participant has sent its vote to the coordinator\0a\\*   participant\'s vote is no\0a\\* THEN\0a\\*   participant decides (unilaterally) to abort\0a\0aabortOnVote(i) == /\\ participant[i].alive\0a                  /\\ participant[i].decision = undecided\0a                  /\\ participant[i].voteSent\0a                  /\\ participant[i].vote = no\0a                  /\\ participant\' = [participant EXCEPT ![i] = \0a                       [@ EXCEPT !.decision = abort]\0a                     ]\0a                  /\\ UNCHANGED<<coordinator>>\0a\0a\0a\\* abortOnTimeoutRequest(i):\0a\\* IF\0a\\*   participant is alive\0a\\*   participant is still undecided\0a\\*   coordinator has died without sending request for vote\0a\\* THEN\0a\\*   participant decides (unilaterally) to abort\0a\0aabortOnTimeoutRequest(i) == /\\ participant[i].alive\0a                            /\\ participant[i].decision = undecided\0a                            /\\ ~coordinator.alive\0a                            /\\ ~coordinator.request[i]\0a                            /\\ participant\' = [participant EXCEPT ![i] = \0a                                 [@ EXCEPT !.decision = abort]\0a                               ]\0a                            /\\ UNCHANGED<<coordinator>>\0a\0a\0a\\* decide(i):\0a\\* IF\0a\\*   participant is alive\0a\\*   participant is undecided\0a\\*   participant has recieved decision from the coordinator\0a\\* THEN\0a\\*   participant decides according to decision from coordinator\0a\\*\0a\0adecide(i) == /\\ participant[i].alive\0a             /\\ participant[i].decision = undecided\0a             /\\ coordinator.broadcast[i] # notsent\0a             /\\ participant\' = [participant EXCEPT ![i] = \0a                  [@ EXCEPT !.decision = coordinator.broadcast[i]]\0a                ]\0a             /\\ UNCHANGED<<coordinator>>\0a\0a\0a\\* parDie(i):\0a\\* IF\0a\\*   participant is alive\0a\\* THEN\0a\\*   participant dies and is now faulty\0a\0aparDie(i) == /\\ participant[i].alive\0a             /\\ participant\' = [participant EXCEPT ![i] = \0a                  [@ EXCEPT !.alive = FALSE, !.faulty = TRUE]\0a                ]\0a             /\\ UNCHANGED<<coordinator>>\0a\0a-------------------------------------------------------------------------------\0a\0a\\* FOR N PARTICIPANTS\0a\0aparProg(i) == sendVote(i) \\/ abortOnVote(i) \\/ abortOnTimeoutRequest(i) \\/ decide(i)\0a\0aparProgN == \\E i \\in participants : parDie(i) \\/ parProg(i)\0a\0a\0acoordProgA(i) ==  request(i) \\/ getVote(i) \\/ detectFault(i) \\/ coordBroadcast(i)\0a\0acoordProgB == makeDecision \\/ \\E i \\in participants : coordProgA(i)\0a\0acoordProgN == coordDie \\/ coordProgB\0a\0a\0aprogN == parProgN \\/ coordProgN\0a\0a\\* Death transitions are left outside of fairness\0a\0afairness == /\\ \\A i \\in participants : WF_<<coordinator, participant>>(parProg(i))\0a            /\\ WF_<<coordinator, participant>>(coordProgB)\0a\0a\0aSpec == Init /\\ [][progN]_<<coordinator, participant>> /\\ fairness\0a\0a--------------------------------------------------------------------------------\0a\0a\\* CORRECTNESS SPECIFICATION\0a\0a\\*******************************************************************************\0a\\* This specification follows the original paper, except that AC3 is stronger:\0a\\* It forces participants to abort if one vote at least is NO (in the absence \0a\\* of failure).\0a\\*\0a\\* The specification is split between safety and liveness.\0a\\*******************************************************************************\0a\0a--------------------------------------------------------------------------------\0a\0a\\* SAFETY\0a\0a\\* All participants that decide reach the same decision\0aAC1 == [] \\A i, j \\in participants : \0a          \\/ participant[i].decision # commit \0a          \\/ participant[j].decision # abort\0a\0a\\* If any participant decides commit, then all participants must have votes YES\0aAC2 == [] (  (\\E i \\in participants : participant[i].decision = commit) \0a          => (\\A j \\in participants : participant[j].vote = yes))\0a\0a\\* If any participant decides abort, then:\0a\\*   at least one participant voted NO, or\0a\\*   at least one participant is faulty, or\0a\\*   coordinator is faulty\0aAC3_1 == [] (  (\\E i \\in participants : participant[i].decision = abort) \0a            => \\/ (\\E j \\in participants : participant[j].vote = no)\0a               \\/ (\\E j \\in participants : participant[j].faulty)\0a               \\/ coordinator.faulty)\0a\0a\\* Each participant decides at most once\0aAC4 == [] /\\ (\\A i \\in participants : participant[i].decision = commit \0a                                => [](participant[i].decision = commit))\0a          /\\ (\\A j \\in participants : participant[j].decision = abort  \0a                                => [](participant[j].decision = abort))\0a\0a--------------------------------------------------------------------------------\0a\0a\\* LIVENESS \0a\\* (stronger for AC3 than in the original paper)\0a\0aAC3_2 == <> \\/ \\A i \\in participants : participant[i].decision \\in {abort, commit}\0a            \\/ \\E j \\in participants : participant[j].faulty\0a            \\/ coordinator.faulty\0a\0a--------------------------------------------------------------------------------\0a\0a\\* (SOME) INTERMEDIATE PROPERTIES USED IN PROOFS\0a\0aFaultyStable == /\\ \\A i \\in participants : [](participant[i].faulty => []participant[i].faulty)\0a                /\\ [](coordinator.faulty => [] coordinator.faulty)\0a\0aVoteStable == \\A i \\in participants : \0a                \\/ [](participant[i].vote = yes)\0a                \\/ [](participant[i].vote = no)\0a\0aStrongerAC2 == [] (  (\\E i \\in participants : participant[i].decision = commit) \0a                  => /\\ (\\A j \\in participants : participant[j].vote = yes)\0a                     /\\ coordinator.decision = commit)\0a\0aStrongerAC3_1 == [] (  (\\E i \\in participants : participant[i].decision = abort) \0a                    => \\/ (\\E j \\in participants : participant[j].vote = no)\0a                       \\/ /\\ \\E j \\in participants : participant[j].faulty\0a                          /\\ coordinator.decision = abort\0a                       \\/ /\\ coordinator.faulty\0a                          /\\ coordinator.decision = undecided)\0a\0a\\* (AC1 follows from StrongerAC2 /\\ StrongerAC3_1)\0a\0aNoRecovery == [] /\\ \\A i \\in participants : participant[i].alive <=> ~participant[i].faulty\0a                 /\\ coordinator.alive <=> ~coordinator.faulty\0a\0a--------------------------------------------------------------------------------\0a\0a\\* (SOME) INVALID PROPERTIES \0a\0aDecisionReachedNoFault == (\\A i \\in participants : participant[i].alive)\0a                          ~> (\\A k \\in participants : participant[k].decision # undecided)\0a\0aAbortImpliesNoVote == [] (  (\\E i \\in participants : participant[i].decision = abort) \0a                  => (\\E j \\in participants : participant[j].vote = no))\0a\0a\\* The following is the termination property that this SB algorithm doesn\'t have\0aAC5 == <> \\A i \\in participants : \\/ participant[i].decision \\in {abort, commit} \0a                                  \\/ participant[i].faulty\0a\0a================================================================================']]]
      ['examples/acp/ACP_SB_TLC' 'ACP_SB_TLC' %accept ~[['ACP_SB_TLC' '------------------------------ MODULE ACP_SB_TLC -------------------------------\0a\0a\\* ACP_SB, TLC ready\0a\0aEXTENDS ACP_SB, TLC\0a\0aPerms == Permutations(participants) \\* to benefit from symmetries\0a\0a--------------------------------------------------------------------------------\0a\0a\\* AC4 rewritten in a way that is better handled by TLC\0a\0aAC4_alt == [][ /\\ (\\A i \\in participants : participant[i].decision = commit \0a                                => (participant\'[i].decision = commit))\0a               /\\ (\\A j \\in participants : participant[j].decision = abort  \0a                                => (participant\'[j].decision = abort))]_<<participant>>\0a\0aAllDecide == \\A p \\in participants : <>(participant[p].decision \\in {commit, abort})\0a\0a================================================================================\0a'] ['ACP_SB' '--------------------------------- MODULE ACP_SB --------------------------------\0a\\* Time-stamp: <10 Jun 2002 at 12:39:50 by charpov on berlioz.cs.unh.edu>\0a\0a\\* `^Atomic Committment Protocol^\' with Simple Broadcast primitive (ACP-SB)\0a\\* From:\0a\\* `^Sape Mullender^\', editor.  Distributed Systems.\0a\\* Chapter 6: Non-Blocking Atomic Commitment, by `^\\"O. Babao\\u{g}lu and S. Toueg.^\'\0a\\* 1993.\0a\0a\\*******************************************************************************\0a\\* Synchronous communication has been replaced with (implicit) asynchronous communication.\0a\\* Failures are detected "magically" instead or relying on timeouts.\0a\\*\0a\\* This version of the protocol uses a "simple broadcast" where a broadcast is simply a \0a\\* series of messages sent, possibly interrupted by a failure.  Consequently, this algorithm\0a\\* is "non terminating" and property AC5 does not hold.\0a\\*******************************************************************************\0a\0aCONSTANTS\0a  participants,             \\* set of participants\0a  yes, no,                  \\* vote\0a  undecided, commit, abort, \\* decision\0a  waiting,                  \\* coordinator state wrt a participant\0a  notsent                   \\* broadcast state wrt a participant\0a\0aVARIABLES\0a  participant, \\* participants (N)\0a  coordinator  \\* coordinator  (1)\0a\0a--------------------------------------------------------------------------------\0a\0aTypeInvParticipant  == participant \\in  [\0a                         participants -> [\0a                           vote      : {yes, no}, \0a                           alive     : BOOLEAN, \0a                           decision  : {undecided, commit, abort},\0a                           faulty    : BOOLEAN,\0a                           voteSent  : BOOLEAN\0a                         ]\0a                       ]\0a\0aTypeInvCoordinator == coordinator \\in  [\0a                        request   : [participants -> BOOLEAN],\0a                        vote      : [participants -> {waiting, yes, no}],\0a                        broadcast : [participants -> {commit, abort, notsent}],\0a                        decision  : {commit, abort, undecided},\0a                        alive     : BOOLEAN,\0a                        faulty    : BOOLEAN\0a                      ]\0a\0aTypeInv == TypeInvParticipant /\\ TypeInvCoordinator\0a\0a--------------------------------------------------------------------------------\0a\0a\\* Initially:\0a\\* All the participants:\0a\\*  have a yes/no vote\0a\\*  are alive and not faulty\0a\\*  have not sent in their votes yet\0a\\*  are undecided about final decision\0a\0a\\* The coordinator:\0a\\*  has not sent vote requests yet\0a\\*  has not recieved votes from any participant\0a\\*  is alive and not faulty\0a\\*  has not sent broadcast messages to any participant\0a\\*  is undecided about final decision\0a\0aInitParticipant == participant \\in [\0a                     participants -> [\0a                       vote     : {yes, no},\0a                       alive    : {TRUE},\0a                       decision : {undecided},\0a                       faulty   : {FALSE},\0a                       voteSent : {FALSE}\0a                     ]\0a                   ]\0a\0aInitCoordinator == coordinator \\in [\0a                     request   : [participants -> {FALSE}],\0a                     vote      : [participants -> {waiting}],\0a                     alive     : {TRUE},\0a                     broadcast : [participants -> {notsent}],\0a                     decision  : {undecided},\0a                     faulty    : {FALSE}\0a                   ]       \0a\0aInit == InitParticipant /\\ InitCoordinator\0a\0a--------------------------------------------------------------------------------\0a\\* COORDINATOR STATEMENTS\0a\0a\\* request(i):\0a\\* IF\0a\\*   coordinator is alive\0a\\*   request for vote has not been sent to participant i\0a\\* THEN `~ why isn\'t THEN left-justified? ~\'\0a\\*   request for vote is sent to participant i\0a\0arequest(i) == /\\ coordinator.alive\0a              /\\ ~coordinator.request[i]\0a              /\\ coordinator\' = [coordinator EXCEPT !.request =\0a                   [@ EXCEPT ![i] = TRUE]\0a                 ]\0a              /\\ UNCHANGED<<participant>>\0a\0a\0a\\* getVote(i):\0a\\* IF\0a\\*   coordinator is alive\0a\\*   coordinator is still undecided\0a\\*   coordinator has sent request for votes to all participants\0a\\*   coordinator is waiting to receive a vote from participant i\0a\\*   participant i has sent the vote message\0a\\* THEN\0a\\*   the coordinator can record the vote of participant i\0a\0agetVote(i) == /\\ coordinator.alive\0a              /\\ coordinator.decision = undecided\0a              /\\ \\A j \\in participants : coordinator.request[j]\0a              /\\ coordinator.vote[i] = waiting\0a              /\\ participant[i].voteSent\0a              /\\ coordinator\' = [coordinator EXCEPT !.vote = \0a                   [@ EXCEPT ![i] = participant[i].vote]\0a                 ]\0a              /\\ UNCHANGED<<participant>>\0a\0a\0a\\* detectFault(i):\0a\\* IF\0a\\*   coordinator is alive\0a\\*   coordinator is still undecided\0a\\*   coordinator has sent request for votes to all participants\0a\\*   coordinator is waiting for vote from participant i\0a\\*   participant i has died without sending its vote\0a\\* THEN\0a\\*   coordinator times out on participant i and decides to abort\0a\0adetectFault(i) == /\\ coordinator.alive\0a                  /\\ coordinator.decision = undecided\0a                  /\\ \\A j \\in participants : coordinator.request[j]\0a                  /\\ coordinator.vote[i] = waiting\0a                  /\\ ~participant[i].alive\0a                  /\\ ~participant[i].voteSent\0a                  /\\ coordinator\' = [coordinator EXCEPT !.decision = abort]\0a                  /\\ UNCHANGED<<participant>>\0a\0a\0a\\* makeDecision:\0a\\* IF\0a\\*   coordinator is alive\0a\\*   coordinator is undecided\0a\\*   coordinator has received votes from all participants\0a\\* THEN\0a\\*   IF\0a\\*     all votes are yes\0a\\*   THEN\0a\\*     coordinator decides commit\0a\\*   ELSE\0a\\*     coordinator decides abort\0a\0amakeDecision == /\\ coordinator.alive\0a                /\\ coordinator.decision = undecided\0a                /\\ \\A j \\in participants : coordinator.vote[j] \\in {yes, no}\0a                /\\ \\/ /\\ \\A j \\in participants : coordinator.vote[j] = yes\0a                      /\\ coordinator\' = [coordinator EXCEPT !.decision = commit]\0a                   \\/ /\\ \\E j \\in participants : coordinator.vote[j] = no\0a                      /\\ coordinator\' = [coordinator EXCEPT !.decision = abort]\0a                /\\ UNCHANGED<<participant>>\0a\0a\0a\\* coordBroadcast(i) (simple broadcast):\0a\\* IF \0a\\*   coordinator is alive\0a\\*   coordinator has made a decision\0a\\*   coordinator has not sent the decision to participant i\0a\\* THEN\0a\\*   coordinator sends its decision to participant i \0a\0acoordBroadcast(i) == /\\ coordinator.alive\0a                     /\\ coordinator.decision # undecided\0a                     /\\ coordinator.broadcast[i] = notsent\0a                     /\\ coordinator\' = [coordinator EXCEPT !.broadcast = \0a                          [@ EXCEPT ![i] = coordinator.decision]\0a                        ]\0a                     /\\ UNCHANGED<<participant>>\0a\0a\0a\\* coordDie:\0a\\* IF \0a\\*   coordinator is alive\0a\\* THEN\0a\\*   coordinator dies\0a\\*   coordinator is now faulty\0a\0acoordDie == /\\ coordinator.alive\0a            /\\ coordinator\' = [coordinator EXCEPT !.alive = FALSE, !.faulty = TRUE]\0a            /\\ UNCHANGED<<participant>>\0a\0a------------------------------------------------------------------------------\0a\0a\\* PARTICIPANT STATEMENTS \0a\0a\\* sendVote(i):\0a\\* IF \0a\\*   participant is alive\0a\\*   participant has received a request for vote\0a\\* THEN\0a\\*   participant sends vote\0a\0asendVote(i) == /\\ participant[i].alive\0a               /\\ coordinator.request[i]\0a               /\\ participant\' = [participant EXCEPT ![i] = \0a                    [@ EXCEPT !.voteSent = TRUE]\0a                  ]\0a               /\\ UNCHANGED<<coordinator>>\0a\0a\0a\\* abortOnVote(i):\0a\\* IF\0a\\*   participant is alive\0a\\*   participant is undecided\0a\\*   participant has sent its vote to the coordinator\0a\\*   participant\'s vote is no\0a\\* THEN\0a\\*   participant decides (unilaterally) to abort\0a\0aabortOnVote(i) == /\\ participant[i].alive\0a                  /\\ participant[i].decision = undecided\0a                  /\\ participant[i].voteSent\0a                  /\\ participant[i].vote = no\0a                  /\\ participant\' = [participant EXCEPT ![i] = \0a                       [@ EXCEPT !.decision = abort]\0a                     ]\0a                  /\\ UNCHANGED<<coordinator>>\0a\0a\0a\\* abortOnTimeoutRequest(i):\0a\\* IF\0a\\*   participant is alive\0a\\*   participant is still undecided\0a\\*   coordinator has died without sending request for vote\0a\\* THEN\0a\\*   participant decides (unilaterally) to abort\0a\0aabortOnTimeoutRequest(i) == /\\ participant[i].alive\0a                            /\\ participant[i].decision = undecided\0a                            /\\ ~coordinator.alive\0a                            /\\ ~coordinator.request[i]\0a                            /\\ participant\' = [participant EXCEPT ![i] = \0a                                 [@ EXCEPT !.decision = abort]\0a                               ]\0a                            /\\ UNCHANGED<<coordinator>>\0a\0a\0a\\* decide(i):\0a\\* IF\0a\\*   participant is alive\0a\\*   participant is undecided\0a\\*   participant has recieved decision from the coordinator\0a\\* THEN\0a\\*   participant decides according to decision from coordinator\0a\\*\0a\0adecide(i) == /\\ participant[i].alive\0a             /\\ participant[i].decision = undecided\0a             /\\ coordinator.broadcast[i] # notsent\0a             /\\ participant\' = [participant EXCEPT ![i] = \0a                  [@ EXCEPT !.decision = coordinator.broadcast[i]]\0a                ]\0a             /\\ UNCHANGED<<coordinator>>\0a\0a\0a\\* parDie(i):\0a\\* IF\0a\\*   participant is alive\0a\\* THEN\0a\\*   participant dies and is now faulty\0a\0aparDie(i) == /\\ participant[i].alive\0a             /\\ participant\' = [participant EXCEPT ![i] = \0a                  [@ EXCEPT !.alive = FALSE, !.faulty = TRUE]\0a                ]\0a             /\\ UNCHANGED<<coordinator>>\0a\0a-------------------------------------------------------------------------------\0a\0a\\* FOR N PARTICIPANTS\0a\0aparProg(i) == sendVote(i) \\/ abortOnVote(i) \\/ abortOnTimeoutRequest(i) \\/ decide(i)\0a\0aparProgN == \\E i \\in participants : parDie(i) \\/ parProg(i)\0a\0a\0acoordProgA(i) ==  request(i) \\/ getVote(i) \\/ detectFault(i) \\/ coordBroadcast(i)\0a\0acoordProgB == makeDecision \\/ \\E i \\in participants : coordProgA(i)\0a\0acoordProgN == coordDie \\/ coordProgB\0a\0a\0aprogN == parProgN \\/ coordProgN\0a\0a\\* Death transitions are left outside of fairness\0a\0afairness == /\\ \\A i \\in participants : WF_<<coordinator, participant>>(parProg(i))\0a            /\\ WF_<<coordinator, participant>>(coordProgB)\0a\0a\0aSpec == Init /\\ [][progN]_<<coordinator, participant>> /\\ fairness\0a\0a--------------------------------------------------------------------------------\0a\0a\\* CORRECTNESS SPECIFICATION\0a\0a\\*******************************************************************************\0a\\* This specification follows the original paper, except that AC3 is stronger:\0a\\* It forces participants to abort if one vote at least is NO (in the absence \0a\\* of failure).\0a\\*\0a\\* The specification is split between safety and liveness.\0a\\*******************************************************************************\0a\0a--------------------------------------------------------------------------------\0a\0a\\* SAFETY\0a\0a\\* All participants that decide reach the same decision\0aAC1 == [] \\A i, j \\in participants : \0a          \\/ participant[i].decision # commit \0a          \\/ participant[j].decision # abort\0a\0a\\* If any participant decides commit, then all participants must have votes YES\0aAC2 == [] (  (\\E i \\in participants : participant[i].decision = commit) \0a          => (\\A j \\in participants : participant[j].vote = yes))\0a\0a\\* If any participant decides abort, then:\0a\\*   at least one participant voted NO, or\0a\\*   at least one participant is faulty, or\0a\\*   coordinator is faulty\0aAC3_1 == [] (  (\\E i \\in participants : participant[i].decision = abort) \0a            => \\/ (\\E j \\in participants : participant[j].vote = no)\0a               \\/ (\\E j \\in participants : participant[j].faulty)\0a               \\/ coordinator.faulty)\0a\0a\\* Each participant decides at most once\0aAC4 == [] /\\ (\\A i \\in participants : participant[i].decision = commit \0a                                => [](participant[i].decision = commit))\0a          /\\ (\\A j \\in participants : participant[j].decision = abort  \0a                                => [](participant[j].decision = abort))\0a\0a--------------------------------------------------------------------------------\0a\0a\\* LIVENESS \0a\\* (stronger for AC3 than in the original paper)\0a\0aAC3_2 == <> \\/ \\A i \\in participants : participant[i].decision \\in {abort, commit}\0a            \\/ \\E j \\in participants : participant[j].faulty\0a            \\/ coordinator.faulty\0a\0a--------------------------------------------------------------------------------\0a\0a\\* (SOME) INTERMEDIATE PROPERTIES USED IN PROOFS\0a\0aFaultyStable == /\\ \\A i \\in participants : [](participant[i].faulty => []participant[i].faulty)\0a                /\\ [](coordinator.faulty => [] coordinator.faulty)\0a\0aVoteStable == \\A i \\in participants : \0a                \\/ [](participant[i].vote = yes)\0a                \\/ [](participant[i].vote = no)\0a\0aStrongerAC2 == [] (  (\\E i \\in participants : participant[i].decision = commit) \0a                  => /\\ (\\A j \\in participants : participant[j].vote = yes)\0a                     /\\ coordinator.decision = commit)\0a\0aStrongerAC3_1 == [] (  (\\E i \\in participants : participant[i].decision = abort) \0a                    => \\/ (\\E j \\in participants : participant[j].vote = no)\0a                       \\/ /\\ \\E j \\in participants : participant[j].faulty\0a                          /\\ coordinator.decision = abort\0a                       \\/ /\\ coordinator.faulty\0a                          /\\ coordinator.decision = undecided)\0a\0a\\* (AC1 follows from StrongerAC2 /\\ StrongerAC3_1)\0a\0aNoRecovery == [] /\\ \\A i \\in participants : participant[i].alive <=> ~participant[i].faulty\0a                 /\\ coordinator.alive <=> ~coordinator.faulty\0a\0a--------------------------------------------------------------------------------\0a\0a\\* (SOME) INVALID PROPERTIES \0a\0aDecisionReachedNoFault == (\\A i \\in participants : participant[i].alive)\0a                          ~> (\\A k \\in participants : participant[k].decision # undecided)\0a\0aAbortImpliesNoVote == [] (  (\\E i \\in participants : participant[i].decision = abort) \0a                  => (\\E j \\in participants : participant[j].vote = no))\0a\0a\\* The following is the termination property that this SB algorithm doesn\'t have\0aAC5 == <> \\A i \\in participants : \\/ participant[i].decision \\in {abort, commit} \0a                                  \\/ participant[i].faulty\0a\0a================================================================================']]]
      ['examples/allocator/SchedulingAllocator' 'SchedulingAllocator' %accept ~[['SchedulingAllocator' '------------------------ MODULE SchedulingAllocator ---------------------\0a(***********************************************************************)\0a(* Specification of an allocator managing a set of resources:          *)\0a(* - Clients can request sets of resources whenever all their previous *)\0a(*   requests have been satisfied.                                     *)\0a(* - Requests can be partly fulfilled, and resources can be returned   *)\0a(*   even before the full request has been satisfied. However, clients *)\0a(*   only have an obligation to return resources after they have       *)\0a(*   obtained all resources they requested.                            *)\0a(* This allocator operates by repeatedly choosing a schedule according *)\0a(* to which requests are satisfied. Resources can be allocated out of  *)\0a(* order as long as no client earlier in the schedule asks for them.   *)\0a(***********************************************************************)\0a\0aEXTENDS FiniteSets, Sequences, Naturals, TLC, TLCExt\0a\0aCONSTANTS\0a  Clients,     \\* set of all clients\0a  Resources    \\* set of all resources\0a\0aASSUME\0a  IsFiniteSet(Resources)\0a\0aVARIABLES\0a  unsat,       \\* set of all outstanding requests per process\0a  alloc,       \\* set of resources allocated to given process\0a  sched        \\* schedule represented as a sequence of clients\0a\0a\0aTypeInvariant ==\0a  /\\ unsat \\in [Clients -> SUBSET Resources]\0a  /\\ alloc \\in [Clients -> SUBSET Resources]\0a  /\\ sched \\in Seq(Clients)\0a\0a-------------------------------------------------------------------------\0a\0a(* The set of permutations of a finite set, represented as sequences.  *)\0aPermSeqs(S) ==\0a  LET perms[ss \\in SUBSET S] ==\0a       IF ss = {} THEN { << >> }\0a       ELSE LET ps == [ x \\in ss |-> \0a                        { Append(sq,x) : sq \\in perms[ss \\ {x}] } ]\0a            IN  UNION { ps[x] : x \\in ss }\0a  IN  perms[S]\0a\0a(* Remove element at index i from a sequence.                          *)\0a(* Assumes that i \\in 1..Len(seq)                                      *)\0aDrop(seq,i) == SubSeq(seq, 1, i-1) \\circ SubSeq(seq, i+1, Len(seq))\0a\0a(* Resources are available iff they have not been allocated. *)\0aavailable == Resources \\ (UNION {alloc[c] : c \\in Clients})\0a\0a(* Range of a function, e.g. elements of a sequence *)\0aRange(f) == { f[x] : x \\in DOMAIN f }\0a\0a(* Clients with pending requests that have not yet been scheduled *)\0atoSchedule == { c \\in Clients : unsat[c] # {} /\\ c \\notin Range(sched) }\0a\0a(* Initially, no resources have been requested or allocated. *)\0aInit == \0a  /\\ unsat = [c \\in Clients |-> {}]\0a  /\\ alloc = [c \\in Clients |-> {}]\0a  /\\ sched = << >>\0a\0a(* A client c may request a set of resources provided that all of its  *)\0a(* previous requests have been satisfied and that it doesn\'t hold any  *)\0a(* resources. The client is added to the pool of clients with          *)\0a(* outstanding requests.                                               *)\0aRequest(c,S) ==\0a  /\\ unsat[c] = {} /\\ alloc[c] = {}\0a  /\\ S # {} /\\ unsat\' = [unsat EXCEPT ![c] = S]\0a  /\\ UNCHANGED <<alloc,sched>>\0a\0a(* Allocation of a set of available resources to a client that has     *)\0a(* requested them (the entire request does not have to be filled).     *)\0a(* The process must appear in the schedule, and no process earlier in  *)\0a(* the schedule may have requested one of the resources.               *)\0aAllocate(c,S) ==\0a  /\\ S # {} /\\ S \\subseteq available \\cap unsat[c]\0a  /\\ \\E i \\in DOMAIN sched :\0a        /\\ sched[i] = c\0a        /\\ \\A j \\in 1..i-1 : unsat[sched[j]] \\cap S = {}\0a        /\\ sched\' = IF S = unsat[c] THEN Drop(sched,i) ELSE sched\0a  /\\ alloc\' = [alloc EXCEPT ![c] = @ \\cup S]\0a  /\\ unsat\' = [unsat EXCEPT ![c] = @ \\ S]\0a\0a(* Client c returns a set of resources that it holds. It may do so     *)\0a(* even before its full request has been honored.                      *)\0aReturn(c,S) ==\0a  /\\ S # {} /\\ S \\subseteq alloc[c]\0a  /\\ alloc\' = [alloc EXCEPT ![c] = @ \\ S]\0a  /\\ UNCHANGED <<unsat,sched>>\0a\0a(* The allocator extends its schedule by adding the processes from     *)\0a(* the set of clients to be scheduled, in some unspecified order.      *)\0aSchedule == \0a  /\\ toSchedule # {}\0a  /\\ \\E sq \\in PermSeqs(toSchedule) : sched\' = sched \\circ sq\0a  /\\ UNCHANGED <<unsat,alloc>>\0a\0a(* The next-state relation per client and set of resources.            *)\0aNext ==\0a  \\/ \\E c \\in Clients, S \\in SUBSET Resources :\0a        Request(c,S) \\/ Allocate(c,S) \\/ Return(c,S)\0a  \\/ Schedule\0a\0avars == <<unsat,alloc,sched>>\0a\0a-------------------------------------------------------------------------\0a\0a(***********************************************************************)\0a(* Liveness assumptions:                                               *)\0a(* - Clients must return resources if their request has been satisfied.*)\0a(* - The allocator must eventually allocate resources when possible.   *)\0a(* - The allocator must schedule the processes in the pool.            *)\0a(***********************************************************************)\0a\0aLiveness ==\0a  /\\ \\A c \\in Clients : WF_vars(unsat[c]={} /\\ Return(c,alloc[c]))\0a  /\\ \\A c \\in Clients : WF_vars(\\E S \\in SUBSET Resources : Allocate(c, S))\0a  /\\ WF_vars(Schedule)\0a\0a(* The specification of the scheduling allocator. *)\0aAllocator == Init /\\ [][Next]_vars /\\ Liveness\0a\0a-------------------------------------------------------------------------\0a\0aResourceMutex ==   \\** resources are allocated exclusively\0a  \\A c1,c2 \\in Clients : c1 # c2 => alloc[c1] \\cap alloc[c2] = {}\0a\0aUnscheduledClients ==    \\** clients that do not appear in the schedule\0a  Clients \\ Range(sched)\0a\0aPrevResources(i) ==\0a  \\** resources that will be available when client i has to be satisfied\0a  available\0a  \\cup (UNION {unsat[sched[j]] \\cup alloc[sched[j]] : j \\in 1..i-1})\0a  \\cup (UNION {alloc[c] : c \\in UnscheduledClients})\0a\0aAllocatorInvariant ==  \\** a lower-level invariant\0a  /\\ \\** all clients in the schedule have outstanding requests\0a     \\A i \\in DOMAIN sched : unsat[sched[i]] # {}\0a  /\\ \\** all clients that need to be scheduled have outstanding requests\0a     \\A c \\in toSchedule : unsat[c] # {}\0a  /\\ \\** clients never hold a resource requested by a process earlier\0a     \\** in the schedule\0a     \\A i \\in DOMAIN sched : \\A j \\in 1..i-1 : \0a        alloc[sched[i]] \\cap unsat[sched[j]] = {}\0a  /\\ \\** the allocator can satisfy the requests of any scheduled client\0a     \\** assuming that the clients scheduled earlier release their resources\0a     \\A i \\in DOMAIN sched : unsat[sched[i]] \\subseteq PrevResources(i)\0a\0aClientsWillReturn ==\0a  \\A c \\in Clients: (unsat[c]={} ~> alloc[c]={})\0a\0aClientsWillObtain ==\0a  \\A c \\in Clients, r \\in Resources : r \\in unsat[c] ~> r \\in alloc[c]\0a\0aInfOftenSatisfied == \0a  \\A c \\in Clients : []<>(unsat[c] = {})\0a\0a(* Used for symmetry reduction with TLC.\0a   Note: because of the schedule sequence, the specification is no\0a   longer symmetric with respect to the processes!\0a*)\0aSymmetry == Permutations(Resources)\0a\0a-------------------------------------------------------------------------\0a\0aTHEOREM Allocator => []TypeInvariant\0aTHEOREM Allocator => []ResourceMutex\0aTHEOREM Allocator => []AllocatorInvariant\0aTHEOREM Allocator => ClientsWillReturn\0aTHEOREM Allocator => ClientsWillObtain\0aTHEOREM Allocator => InfOftenSatisfied\0a\0aPermanentAllocation == \\A c \\in Clients : <>[](alloc[c] # {})\0a\0a\0a-------\0aCONSTANT c1, c2, c3, r1, r2\0aPostCondition ==\0aCounterExample =\0a[ action |->\0a      { << << 1,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                sched |-> <<>> ] >>,\0a           [ name |-> "Request",\0a             location |->\0a                 [ beginLine |-> 70,\0a                   beginColumn |-> 3,\0a                   endLine |-> 72,\0a                   endColumn |-> 30,\0a                   module |-> "SchedulingAllocator" ],\0a             context |-> [S |-> {r2}, c |-> c1],\0a             parameters |-> <<"c", "S">> ],\0a           << 2,\0a              [ unsat |-> (c1 :> {r2} @@ c2 :> {} @@ c3 :> {}),\0a                alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                sched |-> <<>> ] >> >>,\0a        << << 2,\0a              [ unsat |-> (c1 :> {r2} @@ c2 :> {} @@ c3 :> {}),\0a                alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                sched |-> <<>> ] >>,\0a           [ name |-> "Schedule",\0a             location |->\0a                 [ beginLine |-> 97,\0a                   beginColumn |-> 3,\0a                   endLine |-> 99,\0a                   endColumn |-> 30,\0a                   module |-> "SchedulingAllocator" ] ],\0a           << 3,\0a              [ unsat |-> (c1 :> {r2} @@ c2 :> {} @@ c3 :> {}),\0a                alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                sched |-> <<c1>> ] >> >>,\0a        << << 3,\0a              [ unsat |-> (c1 :> {r2} @@ c2 :> {} @@ c3 :> {}),\0a                alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                sched |-> <<c1>> ] >>,\0a           [ name |-> "Allocate",\0a             location |->\0a                 [ beginLine |-> 79,\0a                   beginColumn |-> 3,\0a                   endLine |-> 85,\0a                   endColumn |-> 41,\0a                   module |-> "SchedulingAllocator" ],\0a             context |-> [S |-> {r2}, c |-> c1],\0a             parameters |-> <<"c", "S">> ],\0a           << 4,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                alloc |-> (c1 :> {r2} @@ c2 :> {} @@ c3 :> {}),\0a                sched |-> <<>> ] >> >>,\0a        << << 4,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                alloc |-> (c1 :> {r2} @@ c2 :> {} @@ c3 :> {}),\0a                sched |-> <<>> ] >>,\0a           [ name |-> "Return",\0a             location |->\0a                 [ beginLine |-> 90,\0a                   beginColumn |-> 3,\0a                   endLine |-> 92,\0a                   endColumn |-> 30,\0a                   module |-> "SchedulingAllocator" ],\0a             context |-> [S |-> {r2}, c |-> c1],\0a             parameters |-> <<"c", "S">> ],\0a           << 1,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                sched |-> <<>> ] >> >> },\0a  state |->\0a      { << 1,\0a           [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a             alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a             sched |-> <<>> ] >>,\0a        << 2,\0a           [ unsat |-> (c1 :> {r2} @@ c2 :> {} @@ c3 :> {}),\0a             alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a             sched |-> <<>> ] >>,\0a        << 3,\0a           [ unsat |-> (c1 :> {r2} @@ c2 :> {} @@ c3 :> {}),\0a             alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a             sched |-> <<c1>> ] >>,\0a        << 4,\0a           [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a             alloc |-> (c1 :> {r2} @@ c2 :> {} @@ c3 :> {}),\0a             sched |-> <<>> ] >> } ]\0a=========================================================================\0a']]]
      ['examples/allocator/SimpleAllocator' 'SimpleAllocator' %accept ~[['SimpleAllocator' '------------------------ MODULE SimpleAllocator -------------------------\0a(***********************************************************************)\0a(* Specification of an allocator managing a set of resources:          *)\0a(* - Clients can request sets of resources whenever all their previous *)\0a(*   requests have been satisfied.                                     *)\0a(* - Requests can be partly fulfilled, and resources can be returned   *)\0a(*   even before the full request has been satisfied. However, clients *)\0a(*   only have an obligation to return resources after they have       *)\0a(*   obtained all resources they requested.                            *)\0a(***********************************************************************)\0a\0aEXTENDS FiniteSets, TLC, TLCExt\0a\0aCONSTANTS\0a  Clients,     \\* set of all clients\0a  Resources    \\* set of all resources\0a\0aASSUME\0a  IsFiniteSet(Resources)\0a\0aVARIABLES\0a  unsat,       \\* set of all outstanding requests per process\0a  alloc        \\* set of resources allocated to given process\0a\0aTypeInvariant ==\0a  /\\ unsat \\in [Clients -> SUBSET Resources]\0a  /\\ alloc \\in [Clients -> SUBSET Resources]\0a\0a-------------------------------------------------------------------------\0a\0a(* Resources are available iff they have not been allocated. *)\0aavailable == Resources \\ (UNION {alloc[c] : c \\in Clients})\0a\0a(* Initially, no resources have been requested or allocated. *)\0aInit == \0a  /\\ unsat = [c \\in Clients |-> {}]\0a  /\\ alloc = [c \\in Clients |-> {}]\0a\0a(* A client c may request a set of resources provided that all of its  *)\0a(* previous requests have been satisfied and that it doesn\'t hold any  *)\0a(* resources.                                                          *)\0aRequest(c,S) ==\0a  /\\ unsat[c] = {} /\\ alloc[c] = {}\0a  /\\ S # {} /\\ unsat\' = [unsat EXCEPT ![c] = S]\0a  /\\ UNCHANGED alloc\0a\0a(* Allocation of a set of available resources to a client that         *)\0a(* requested them (the entire request does not have to be filled).     *)\0aAllocate(c,S) ==\0a  /\\ S # {} /\\ S \\subseteq available \\cap unsat[c]\0a  /\\ alloc\' = [alloc EXCEPT ![c] = @ \\cup S]\0a  /\\ unsat\' = [unsat EXCEPT ![c] = @ \\ S]\0a\0a(* Client c returns a set of resources that it holds. It may do so     *)\0a(* even before its full request has been honored.                      *)\0aReturn(c,S) ==\0a  /\\ S # {} /\\ S \\subseteq alloc[c]\0a  /\\ alloc\' = [alloc EXCEPT ![c] = @ \\ S]\0a  /\\ UNCHANGED unsat\0a\0a(* The next-state relation. *)\0aNext == \0a  \\E c \\in Clients, S \\in SUBSET Resources :\0a     Request(c,S) \\/ Allocate(c,S) \\/ Return(c,S)\0a\0avars == <<unsat,alloc>>\0a\0a-------------------------------------------------------------------------\0a\0a(* The complete high-level specification. *)\0aSimpleAllocator == \0a  /\\ Init /\\ [][Next]_vars\0a  /\\ \\A c \\in Clients: WF_vars(Return(c, alloc[c]))\0a  /\\ \\A c \\in Clients: SF_vars(\\E S \\in SUBSET Resources: Allocate(c,S))\0a\0a-------------------------------------------------------------------------\0a\0aResourceMutex ==\0a  \\A c1,c2 \\in Clients : c1 # c2 => alloc[c1] \\cap alloc[c2] = {}\0a\0aClientsWillReturn ==\0a  \\A c \\in Clients : unsat[c]={} ~> alloc[c]={}\0a\0aClientsWillObtain ==\0a  \\A c \\in Clients, r \\in Resources : r \\in unsat[c] ~> r \\in alloc[c]\0a\0aInfOftenSatisfied == \0a  \\A c \\in Clients : []<>(unsat[c] = {})\0a\0a-------------------------------------------------------------------------\0a\0a(* Used for symmetry reduction with TLC *)\0aSymmetry == Permutations(Clients) \\cup Permutations(Resources)\0a\0a-------------------------------------------------------------------------\0a\0a(* The following version states a weaker fairness requirement for the  *)\0a(* clients: resources need be returned only if the entire request has  *)\0a(* been satisfied.                                                     *)\0a\0aSimpleAllocator2 == \0a  /\\ Init /\\ [][Next]_vars\0a  /\\ \\A c \\in Clients: WF_vars(unsat[c] = {} /\\ Return(c, alloc[c]))\0a  /\\ \\A c \\in Clients: SF_vars(\\E S \\in SUBSET Resources: Allocate(c,S))\0a\0a\0a-------------------------------------------------------------------------\0a\0aTHEOREM SimpleAllocator => []TypeInvariant\0aTHEOREM SimpleAllocator => []ResourceMutex\0aTHEOREM SimpleAllocator => ClientsWillReturn\0aTHEOREM SimpleAllocator2 => ClientsWillReturn\0aTHEOREM SimpleAllocator => ClientsWillObtain\0aTHEOREM SimpleAllocator => InfOftenSatisfied\0a(** The following do not hold:                          **)\0a(** THEOREM SimpleAllocator2 => ClientsWillObtain       **)\0a(** THEOREM SimpleAllocator2 => InfOftenSatisfied       **)\0a\0aAllocInfOftenEmpty == []<>(\\A c \\in Clients : alloc[c] = {})\0a\0aCONSTANT c1, c2, c3, r1, r2\0aPostCondition ==\0aCounterExample =\0a[ action |->\0a      { << << 1,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}) ] >>,\0a           [ name |-> "Request",\0a             location |->\0a                 [ beginLine |-> 43,\0a                   beginColumn |-> 3,\0a                   endLine |-> 45,\0a                   endColumn |-> 20,\0a                   module |-> "SimpleAllocator" ],\0a             context |-> [c |-> c3, S |-> {r1}],\0a             parameters |-> <<"c", "S">> ],\0a           << 2,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1}),\0a                alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}) ] >> >>,\0a        << << 2,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1}),\0a                alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}) ] >>,\0a           [ name |-> "Allocate",\0a             location |->\0a                 [ beginLine |-> 50,\0a                   beginColumn |-> 3,\0a                   endLine |-> 52,\0a                   endColumn |-> 41,\0a                   module |-> "SimpleAllocator" ],\0a             context |-> [c |-> c3, S |-> {r1}],\0a             parameters |-> <<"c", "S">> ],\0a           << 3,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1}) ] >> >>,\0a        << << 3,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1}) ] >>,\0a           [ name |-> "Request",\0a             location |->\0a                 [ beginLine |-> 43,\0a                   beginColumn |-> 3,\0a                   endLine |-> 45,\0a                   endColumn |-> 20,\0a                   module |-> "SimpleAllocator" ],\0a             context |-> [c |-> c2, S |-> {r2}],\0a             parameters |-> <<"c", "S">> ],\0a           << 4,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {r2} @@ c3 :> {}),\0a                alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1}) ] >> >>,\0a        << << 4,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {r2} @@ c3 :> {}),\0a                alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1}) ] >>,\0a           [ name |-> "Allocate",\0a             location |->\0a                 [ beginLine |-> 50,\0a                   beginColumn |-> 3,\0a                   endLine |-> 52,\0a                   endColumn |-> 41,\0a                   module |-> "SimpleAllocator" ],\0a             context |-> [c |-> c2, S |-> {r2}],\0a             parameters |-> <<"c", "S">> ],\0a           << 5,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                alloc |-> (c1 :> {} @@ c2 :> {r2} @@ c3 :> {r1}) ] >> >>,\0a        << << 5,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                alloc |-> (c1 :> {} @@ c2 :> {r2} @@ c3 :> {r1}) ] >>,\0a           [ name |-> "Return",\0a             location |->\0a                 [ beginLine |-> 57,\0a                   beginColumn |-> 3,\0a                   endLine |-> 59,\0a                   endColumn |-> 20,\0a                   module |-> "SimpleAllocator" ],\0a             context |-> [c |-> c3, S |-> {r1}],\0a             parameters |-> <<"c", "S">> ],\0a           << 6,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                alloc |-> (c1 :> {} @@ c2 :> {r2} @@ c3 :> {}) ] >> >>,\0a        << << 6,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                alloc |-> (c1 :> {} @@ c2 :> {r2} @@ c3 :> {}) ] >>,\0a           [ name |-> "Request",\0a             location |->\0a                 [ beginLine |-> 43,\0a                   beginColumn |-> 3,\0a                   endLine |-> 45,\0a                   endColumn |-> 20,\0a                   module |-> "SimpleAllocator" ],\0a             context |-> [c |-> c3, S |-> {r1, r2}],\0a             parameters |-> <<"c", "S">> ],\0a           << 7,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1, r2}),\0a                alloc |-> (c1 :> {} @@ c2 :> {r2} @@ c3 :> {}) ] >> >>,\0a        << << 7,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1, r2}),\0a                alloc |-> (c1 :> {} @@ c2 :> {r2} @@ c3 :> {}) ] >>,\0a           [ name |-> "Allocate",\0a             location |->\0a                 [ beginLine |-> 50,\0a                   beginColumn |-> 3,\0a                   endLine |-> 52,\0a                   endColumn |-> 41,\0a                   module |-> "SimpleAllocator" ],\0a             context |-> [c |-> c3, S |-> {r1}],\0a             parameters |-> <<"c", "S">> ],\0a           << 8,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r2}),\0a                alloc |-> (c1 :> {} @@ c2 :> {r2} @@ c3 :> {r1}) ] >> >>,\0a        << << 8,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r2}),\0a                alloc |-> (c1 :> {} @@ c2 :> {r2} @@ c3 :> {r1}) ] >>,\0a           [ name |-> "Return",\0a             location |->\0a                 [ beginLine |-> 57,\0a                   beginColumn |-> 3,\0a                   endLine |-> 59,\0a                   endColumn |-> 20,\0a                   module |-> "SimpleAllocator" ],\0a             context |-> [c |-> c2, S |-> {r2}],\0a             parameters |-> <<"c", "S">> ],\0a           << 9,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r2}),\0a                alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1}) ] >> >>,\0a        << << 9,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r2}),\0a                alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1}) ] >>,\0a           [ name |-> "Allocate",\0a             location |->\0a                 [ beginLine |-> 50,\0a                   beginColumn |-> 3,\0a                   endLine |-> 52,\0a                   endColumn |-> 41,\0a                   module |-> "SimpleAllocator" ],\0a             context |-> [c |-> c3, S |-> {r2}],\0a             parameters |-> <<"c", "S">> ],\0a           << 10,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1, r2}) ] >> >>,\0a        << << 10,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1, r2}) ] >>,\0a           [ name |-> "Return",\0a             location |->\0a                 [ beginLine |-> 57,\0a                   beginColumn |-> 3,\0a                   endLine |-> 59,\0a                   endColumn |-> 20,\0a                   module |-> "SimpleAllocator" ],\0a             context |-> [c |-> c3, S |-> {r2}],\0a             parameters |-> <<"c", "S">> ],\0a           << 3,\0a              [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a                alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1}) ] >> >> },\0a  state |->\0a      { << 1,\0a           [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a             alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}) ] >>,\0a        << 2,\0a           [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1}),\0a             alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}) ] >>,\0a        << 3,\0a           [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a             alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1}) ] >>,\0a        << 4,\0a           [ unsat |-> (c1 :> {} @@ c2 :> {r2} @@ c3 :> {}),\0a             alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1}) ] >>,\0a        << 5,\0a           [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a             alloc |-> (c1 :> {} @@ c2 :> {r2} @@ c3 :> {r1}) ] >>,\0a        << 6,\0a           [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a             alloc |-> (c1 :> {} @@ c2 :> {r2} @@ c3 :> {}) ] >>,\0a        << 7,\0a           [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1, r2}),\0a             alloc |-> (c1 :> {} @@ c2 :> {r2} @@ c3 :> {}) ] >>,\0a        << 8,\0a           [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r2}),\0a             alloc |-> (c1 :> {} @@ c2 :> {r2} @@ c3 :> {r1}) ] >>,\0a        << 9,\0a           [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r2}),\0a             alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1}) ] >>,\0a        << 10,\0a           [ unsat |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {}),\0a             alloc |-> (c1 :> {} @@ c2 :> {} @@ c3 :> {r1, r2}) ] >> } ]\0a\0a=========================================================================\0a']]]
      ['examples/bcastByz/bcastByz' 'bcastByz' %reject ~[['bcastByz' '------------------------------ MODULE bcastByz ------------------------------\0a\0a(* TLA+ encoding of a parameterized model of the broadcast distributed  \0a   algorithm with Byzantine faults.\0a  \0a   This is a one-round version of asynchronous reliable broadcast (Fig. 7) from:\0a  \0a   [1] T. K. Srikanth, Sam Toueg. Simulating authenticated broadcasts to derive\0a   simple fault-tolerant algorithms. Distributed Computing 1987,\0a   Volume 2, Issue 2, pp 80-94\0a                                                             \0a   A short description of the parameterized model is described in: Gmeiner,   \0a   Annu, et al. "Tutorial on parameterized model checking of fault-tolerant   \0a   distributed algorithms." International School on Formal Methods for the  \0a   Design of Computer, Communication and Software Systems. Springer  \0a   International Publishing, 2014.                   \0a  \0a   This specification has a TLAPS proof for property Unforgeability: if process p \0a   is correct and does not broadcast a message m, then no correct process ever \0a   accepts m. The formula InitNoBcast represents that the transmitter does not \0a   broadcast any message. So, our goal is to prove the  formula\0a        (InitNoBcast /\\ [][Next]_vars) => []Unforg                    \0a  \0a   We can use TLC to check two properties (for fixed parameters N, T, and F):\0a    - Correctness: if a correct process broadcasts, then every correct process accepts,\0a    - Replay: if a correct process accepts, then every correct process accepts.  \0a  \0a   Igor Konnov, Thanh Hai Tran, Josef Widder, 2016\0a  \0a   This file is a subject to the license that is bundled together with this package \0a   and can be found in the file LICENSE.\0a *)\0a\0a\0aEXTENDS Naturals, \0a        FiniteSets,\0a        Functions\0a        \0aCONSTANTS N, T, F\0a\0aVARIABLE Corr           (* the correct processes *)\0aVARIABLE Faulty         (* the faulty processes *)\0a                        (* Corr and Faulty are declared as variables since we want to \0a                           check all possible cases. And after the initial step, Corr\0a                           and Faulty are unchanged. *)\0aVARIABLE pc             (* the control state of each process *)\0aVARIABLE rcvd           (* the messages received by each process *)\0aVARIABLE sent           (* the messages sent by all correct processes *)\0aASSUME NTF == N \\in Nat /\\ T \\in Nat /\\ F \\in Nat /\\ (N > 3 * T) /\\ (T >= F) /\\ (F >= 0)\0a\0aProc == 1 .. N          (* all processes, including the faulty ones    *)\0aM == { "ECHO" }\0a(* ByzMsgs == { <<p, "ECHO">> : p \\in Faulty }: quite complicated to write a TLAPS proof \0a   for the cardinality of the expression { e : x \\in S}\0a *)\0aByzMsgs == Faulty \\X M\0a                            \0avars == << pc, rcvd, sent, Corr, Faulty >>\0a\0a(* Instead of modeling a broadcaster explicitly, two initial values V0 and V1 at correct\0a   processes are used to model whether a process has received the INIT message from the\0a   broadcaster or not, respectively. Then the precondition of correctness can be modeled \0a   that all correct processes initially have value V1, while the precondition of unforgeability  \0a   that all correct processes initially have value V0.\0a *)\0aInit == \0a  /\\ sent = {}                          (* No messages sent initially *)\0a  /\\ pc \\in [ Proc -> {"V0", "V1"} ]    (* Some processes received INIT messages, some didn\'t *)\0a  /\\ rcvd = [ i \\in Proc |-> {} ]       (* No messages received initially *)\0a  /\\ Corr \\in SUBSET Proc\0a  /\\ Cardinality(Corr) = N - F          (* N - F processes are correct, but their identities are unknown*)\0a  /\\ Faulty = Proc \\ Corr               (* The rest (F) are faulty*)  \0a        \0a(* This formula specifies restricted initial states: all correct processes initially have value V0.\0a   (This corresponds to the case when no correct process received an INIT message from a broadcaster.)\0a   Notice that in our modeling Byzantine processes also start in the local state V0.\0a *)\0aInitNoBcast == pc \\in [ Proc -> {"V0"} ] /\\ Init\0a\0a(* A correct process can receive all ECHO messages sent by the other correct processes,\0a   i.e., a subset of sent, and all possible ECHO messages from the Byzantine processes,\0a   i.e., a subset of ByzMsgs. If includeByz is FALSE, the messages from the Byzantine\0a   processes are not included.\0a *)\0aReceive(self, includeByz) ==\0a  \\E newMessages \\in SUBSET ( sent \\cup (IF includeByz THEN ByzMsgs ELSE {}) ) :\0a    rcvd\' = [ i \\in Proc |-> IF i # self THEN rcvd[i] ELSE rcvd[self] \\cup newMessages ]\0a\0aReceiveFromCorrectSender(self) == Receive(self, FALSE)\0a\0aReceiveFromAnySender(self) == Receive(self, TRUE)\0a\0a(* The first if-then expression in Figure 7 [1]: If process p received an INIT message and\0a   did not send <ECHO> before, then process p sends ECHO to all.\0a *)\0aUponV1(self) ==\0a  /\\ pc[self] = "V1"\0a  /\\ pc\' = [pc EXCEPT ![self] = "SE"]\0a  /\\ sent\' = sent \\cup { <<self, "ECHO">> }\0a  /\\ UNCHANGED << Corr, Faulty >>\0a\0a(* The 3rd if-then expression in Fig. 7 [1]: If correct process p received ECHO messages \0a   from at least N - 2*T distinct processes and did not send ECHO before, then process p sends\0a   ECHO messages to all. \0a  \0a   Since processes send only ECHO messages, the number of messages in rcvd[self] equals the   \0a   number of distinct processes from which process self received ECHO messages. \0a  \0a   The 3rd conjunction "Cardinality(rcvd\'[self]) < N - T" ensures that process p cannot accept\0a   or not execute the 2nd if-then expression in Fig. 7 [1]. If process p received ECHO messages\0a   from at least N - T distinct processes, the formula UponAcceptNotSentBefore is called.\0a *)         \0aUponNonFaulty(self) ==\0a  /\\ pc[self] \\in { "V0", "V1" }\0a  /\\ Cardinality(rcvd\'[self]) >= N - 2*T  \0a  /\\ Cardinality(rcvd\'[self]) < N - T\0a  /\\ pc\' = [ pc EXCEPT ![self] = "SE" ]\0a  /\\ sent\' = sent \\cup { <<self, "ECHO">> }\0a  /\\ UNCHANGED << Corr, Faulty >>\0a        \0a(* The 2nd and 3rd if-then expressions in Figure 7 [1]: If process p received <ECHO> from at \0a   least N - T distinct processes and did not send ECHO message before, then process p accepts       \0a   and sends <ECHO> to all.                  \0a *)        \0aUponAcceptNotSentBefore(self) ==\0a  /\\ pc[self] \\in { "V0", "V1" }\0a  /\\ Cardinality(rcvd\'[self]) >= N - T\0a  /\\ pc\' = [ pc EXCEPT ![self] = "AC" ]\0a  /\\ sent\' = sent \\cup { <<self, "ECHO">> }\0a  /\\ UNCHANGED << Corr, Faulty >>\0a        \0a(* Only the 2nd if-then expression in Fig. 7 [1]:  if process p sent ECHO messages and received \0a   ECHO messages from at least N - T distinct processes, it accepts.\0a  \0a   As pc[self] = "SE", the 3rd if-then expression cannot be executed.\0a *)        \0aUponAcceptSentBefore(self) ==\0a  /\\ pc[self] = "SE"\0a  /\\ Cardinality(rcvd\'[self]) >= N - T\0a  /\\ pc\' = [pc EXCEPT ![self] = "AC"]\0a  /\\ sent\' = sent\0a  /\\ UNCHANGED << Corr, Faulty >>\0a\0a(* All possible process steps.*)                \0aStep(self) == \0a  /\\ ReceiveFromAnySender(self)\0a  /\\ \\/ UponV1(self)\0a     \\/ UponNonFaulty(self)\0a     \\/ UponAcceptNotSentBefore(self)\0a     \\/ UponAcceptSentBefore(self)\0a\0a(* Some correct process does a transition step.*)                         \0aNext ==\0a     \\/ \\E self \\in Corr: Step(self)                     \0a     \\/ UNCHANGED vars (* add a self-loop for terminating computations *)\0a\0a(* Add weak fairness condition since we want to check liveness properties. We require that \0a   if UponV1 (or UponNonFaulty, UponAcceptNotSentBefore, UponAcceptSentBefore) ever becomes \0a   forever enabled, then this step must eventually occur.      \0a *)\0aSpec == Init /\\ [][Next]_vars \0a             /\\ WF_vars(\\E self \\in Corr: /\\ ReceiveFromCorrectSender(self)\0a                                          /\\ \\/ UponV1(self)\0a                                             \\/ UponNonFaulty(self)\0a                                             \\/ UponAcceptNotSentBefore(self)\0a                                             \\/ UponAcceptSentBefore(self))\0a\0a(* This formula SpecNoBcast is used to only check Unforgeability.\0a   No fairness is needed, as Unforgeability is a safety property.\0a *)\0aSpecNoBcast == InitNoBcast /\\ [][Next]_vars\0a\0a(* V0 - the initial state when process p doesn\'t receive an INIT message\0a   V1 - the initial state when process p receives an INIT message\0a   SE - the state when process p sends ECHO messages but doesn\'t accept \0a   AC - the accepted state when process p accepts            \0a *) \0aTypeOK == \0a  /\\ pc \\in [ Proc -> {"V0", "V1", "SE", "AC"} ]          \0a  /\\ Corr \\subseteq Proc\0a  /\\ Faulty \\subseteq Proc\0a  /\\ sent \\subseteq Proc \\times M     \0a  /\\ rcvd \\in [ Proc -> SUBSET ( sent \\cup ByzMsgs ) ]\0a\0a(* Constraints about the cardinalities of Faulty and Corr, their elements, and the upper bound  \0a   of the set of possible Byzantine messages. The FCConstraints is an invariant. One can probably\0a   prove the theorems below without FCConstraints (by applying facts from FiniteSetTheorems), \0a   but these proofs will be longer.\0a *)          \0aFCConstraints == \0a  /\\ Corr \\subseteq Proc\0a  /\\ Faulty \\subseteq Proc\0a  /\\ IsFiniteSet(Corr)\0a  /\\ IsFiniteSet(Faulty)\0a  /\\ Corr \\cup Faulty = Proc \0a  /\\ Faulty = Proc \\ Corr\0a  /\\ Cardinality(Corr) >= N - T\0a  /\\ Cardinality(Faulty) <= T   \0a  /\\ ByzMsgs \\subseteq Proc \\X M     \0a  /\\ IsFiniteSet(ByzMsgs)\0a  /\\ Cardinality(ByzMsgs) = Cardinality(Faulty)        \0a          \0a(****************************** SPECIFICATION ******************************)\0a\0a(* If a correct process broadcasts, then every correct process eventually accepts. *)\0aCorrLtl == (\\A i \\in Corr: pc[i] = "V1") => <>(\\A i \\in Corr: pc[i] = "AC")\0a\0a(* If a correct process accepts, then every correct process accepts. *)\0aRelayLtl == []((\\E i \\in Corr: pc[i] = "AC") => <>(\\A i \\in Corr: pc[i] = "AC"))\0a\0a(* If no correct process don\'t broadcast ECHO messages then no correct processes accept. *)  \0aUnforgLtl == (\\A i \\in Corr: pc[i] = "V0") => [](\\A i \\in Corr: pc[i] /= "AC")\0a\0a(* The special case of the unforgeability property. When our algorithms start with InitNoBcast,\0a   we can rewrite UnforgLtl as a first-order formula.     \0a *)          \0aUnforg == (\\A i \\in Proc: i \\in Corr => (pc[i] /= "AC")) \0a\0a\0a(* A typical proof for proving a safety property in TLA+ is to show inductive invariance:\0a      1/ Init => IndInv\0a      2/ IndInv /\\ [Next]_vars => IndInv\'\0a      3/ IndInv => Safety\0a  \0a   Therefore, finding an inductive invariant is one of the most important and difficult step\0a   in writing a full formal proof. Here, Safety is Unforgeability and the corresponding indutive\0a   invariant is IndInv_Unforg_NoBcast. I started with TypeOK and Safety, and then tried to add  \0a   new constraints (inductive strengthens) in order to have the inductive invariant. In this \0a   example, additional constraints are  relationships between the number of messages, pc, and \0a   the number of faulty processes.    \0a *)                \0aIndInv_Unforg_NoBcast ==  \0a  /\\ TypeOK\0a  /\\ FCConstraints\0a  /\\ sent = {}  \0a  /\\ pc = [ i \\in Proc |-> "V0" ]\0a\0a\0a(* Before doing an actual proof with TLAPS, we want to check the invariant candidate with TLC\0a   (for fixed parameters). One can do so by running depth-first search with TLC by setting \0a   depth to 2.  \0a  \0a   Unfortunately, checking Spec_IIU1 with TLC still takes too several hours even in small cases.\0a   The main reason is that the order of subformulas in IndInv_Unforg_NoBcast makes TLC consider\0a   unnecessary values and generate an enormous number of initial states which are unreachable \0a   in SpecNoBcast. For example, in order to evaluate the subformula in IndInv_Unforg_NoBcast\0a          pc \\in [ Proc -> {"V0", "V1", "SE", "AC"} ],       \0a   TLC needs to generate and consider (2^{Card(Proc)})^4 cases. However, most of them are \0a   elimitated by the last constraint pc = [ i \\in Proc |-> "V0" ].\0a  \0a   Therefore, it is better to use the following formula IndInv_Unforg_NoBcast_TLC which is \0a   obtained by rearranging the order of subformulas in IndInv_Unforg_NoBcast and eliminating\0a   duplicant constraints. Notice that in order to check an inductive invariant, we need to \0a   consider only executions which have only one transition step. Therefore, in the advanced \0a   settings of the TLC model checker, we can set the depth of executions to 2.                                                        \0a *)   \0aIndInv_Unforg_NoBcast_TLC ==  \0a  /\\ pc = [ i \\in Proc |-> "V0" ]\0a  /\\ Corr \\in SUBSET Proc\0a  /\\ Cardinality( Corr ) >= N - T\0a  /\\ Faulty = Proc \\ Corr\0a  /\\ \\A i \\in Proc : pc[i] /= "AC"\0a  /\\ sent = {}  \0a  /\\ rcvd \\in [ Proc -> sent \\cup SUBSET ByzMsgs ]   \0a        \0aProposeLeadsToAccept == \\A p \\in Proc : pc[p] = "V1" ~> pc[p] = "AC"\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Sat Sep 04 19:49:08 CEST 2021 by tran\0a\0a\0a\0a\0a']]]
      ['examples/cf1s-folklore/cf1s_folklore' 'cf1s_folklore' %accept ~[['cf1s_folklore' '------------------------------ MODULE cf1s_folklore ------------------------------\0a\0a(* An encoding of the consensus algorithm with Byzantine faults in one communication step [1]. Here \0a   we consider only the algorithm itself (Algorithm 2, lines 1--4), without looking at the underlying \0a   consensus algorithm. \0a   \0a   [1] Dobre, Dan, and Neeraj Suri. "One-step consensus with zero-degradation." Dependable Systems and \0a   Networks, 2006. DSN 2006. International Conference on. IEEE, 2006.\0a                                                               \0a   Igor Konnov, Thanh Hai Tran, Josef Widder, 2016\0a  \0a   This file is a subject to the license that is bundled together with this package and can be found \0a   in the file LICENSE.\0a *)\0a\0a\0aEXTENDS Naturals, FiniteSets, TLC\0a\0aCONSTANTS N, T, F\0a\0aVARIABLES nSnt0,    (* nSnt0, nSnt1 - the messages sent by correct processes *)\0a          nSnt1,\0a          nSnt0F,   (* nsnt0F, nsnt1F - the messages sent by faulty processes *)\0a          nSnt1F,  \0a          nFaulty,  (* the number of faulty processes *)\0a          pc,       (* process locations *)\0a          nRcvd0,   (* the number of received messages *)\0a          nRcvd1\0a          (* nStep - only for checking IndInv0 with TLC *)                \0a\0aASSUME NTF == N \\in Nat /\\ T \\in Nat /\\ F \\in Nat /\\ (N > 3 * T) /\\ (T >= F) /\\ (F >= 0)\0a\0aProc == 1 .. N\0aStatus == { "V0", "V1", "S0", "S1", "D0", "D1", "U0", "U1", "BYZ" }\0avars == << nSnt0, nSnt1, nSnt0F, nSnt1F, nFaulty, pc, nRcvd0, nRcvd1 >>\0a\0a\0aInit ==\0a  /\\ pc \\in [ Proc -> { "V0", "V1" } ]\0a  /\\ nSnt0 = 0\0a  /\\ nSnt1 = 0\0a  /\\ nSnt0F = 0\0a  /\\ nSnt1F = 0\0a  /\\ nFaulty = 0\0a  /\\ nRcvd0 = [ i \\in Proc |-> 0 ]\0a  /\\ nRcvd1 = [ i \\in Proc |-> 0 ]\0a  \0aFaulty(i) ==\0a  /\\ nFaulty < F\0a  /\\ pc[i] # "BYZ"\0a  /\\ pc\' = [ pc EXCEPT ![i] = "BYZ" ] \0a  /\\ nFaulty\' = nFaulty + 1  \0a  /\\ IF pc[i] = "V0" THEN nSnt0F\' = nSnt0F + 1 ELSE nSnt0F\' = nSnt0F\0a  /\\ IF pc[i] = "V1" THEN nSnt0F\' = nSnt1F + 1 ELSE nSnt1F\' = nSnt1F\0a  /\\ UNCHANGED << nSnt0, nSnt1, nRcvd0, nRcvd1 >>\0a  \0aPropose(i) ==\0a  \\/ /\\ pc[i] = "V0"\0a     /\\ pc\' = [ pc EXCEPT ![i] = "S0" ]\0a     /\\ nSnt0\' = nSnt0 + 1\0a     /\\ UNCHANGED << nSnt1, nSnt0F, nSnt1F, nFaulty, nRcvd0, nRcvd1 >>\0a  \\/ /\\ pc[i] = "V1"\0a     /\\ pc\' = [ pc EXCEPT ![i] = "S1" ]\0a     /\\ nSnt1\' = nSnt1 + 1\0a     /\\ UNCHANGED << nSnt0, nSnt0F, nSnt1F, nFaulty, nRcvd0, nRcvd1 >>\0a     \0aReceive(i) ==\0a  \\/ /\\ nRcvd0[i] < nSnt0 + nSnt0F\0a     /\\ nRcvd0\' = [ nRcvd0 EXCEPT ![i] = nRcvd0[i] + 1 ]\0a     /\\ UNCHANGED << nSnt0, nSnt1, nSnt0F, nFaulty, pc, nSnt1F, nRcvd1 >>     \0a  \\/ /\\ nRcvd1[i] < nSnt1 + nSnt1F\0a     /\\ nRcvd1\' = [ nRcvd1 EXCEPT ![i] = nRcvd1[i] + 1 ]\0a     /\\ UNCHANGED << nSnt0, nSnt1, nSnt0F, nFaulty, pc, nSnt1F, nRcvd0 >>    \0a  \\/ /\\ nRcvd0[i] = nSnt0\0a     /\\ nRcvd1[i] = nSnt1\0a     /\\ UNCHANGED vars \0a     \0aDecide(i) ==\0a  /\\ \\/ pc[i] = "S0"\0a     \\/ pc[i] = "S1"\0a  /\\ nRcvd0[i] + nRcvd1[i] >= N - T\0a  /\\ \\/ /\\ nRcvd0[i] >= N - T\0a        /\\ pc\' = [ pc EXCEPT ![i] = "D0" ]      \0a     \\/ /\\ nRcvd1[i] >= N - T\0a        /\\ pc\' = [ pc EXCEPT ![i] = "D1" ]\0a     \\/ /\\ nRcvd0[i] < N - T\0a        /\\ nRcvd1[i] < N - T\0a        /\\ pc[i] = "S0"\0a        /\\ pc\' = [ pc EXCEPT ![i] = "U0" ]\0a     \\/ /\\ nRcvd0[i] < N - T\0a        /\\ nRcvd1[i] < N - T\0a        /\\ pc[i] = "S1"\0a        /\\ pc\' = [ pc EXCEPT ![i] = "U1" ]\0a  /\\ UNCHANGED << nSnt0, nSnt1, nSnt0F, nSnt1F, nFaulty, nRcvd0, nRcvd1 >>\0a\0aNext ==\0a  /\\ \\E self \\in Proc : \0a        \\/ Receive(self) \0a        \\/ Propose(self) \0a        \\/ Decide(self) \0a        \\/ Faulty(self)\0a        \\/ UNCHANGED vars                  \0a\0a(* Add weak fairness condition since we want to check liveness properties.  *)\0a(* We require that if UponV1 (UponNonFaulty, UponAcceptNotSent, UponAccept) *)\0a(* ever becomes forever enabled, then this step must eventually occur.      *)\0aSpec == Init /\\ [][Next]_vars \0a             /\\ WF_vars(\\E self \\in Proc : \\/ Receive(self)\0a                                           \\/ Propose(self)\0a                                           \\/ Decide(self))\0a\0a(* All processes propose 0. *)\0aInit0 ==\0a  /\\ pc = [ i \\in Proc |-> "V0" ]\0a  /\\ nSnt0 = 0\0a  /\\ nSnt1 = 0\0a  /\\ nSnt0F = 0\0a  /\\ nSnt1F = 0\0a  /\\ nFaulty = 0\0a  /\\ nRcvd0 = [ i \\in Proc |-> 0 ]\0a  /\\ nRcvd1 = [ i \\in Proc |-> 0 ]\0a  (* /\\ nStep = 0 *)\0a  \0a(* All processes propose 1. *)  \0aInit1 ==\0a  /\\ pc = [ i \\in Proc |-> "V1" ]\0a  /\\ nSnt0 = 0\0a  /\\ nSnt1 = 0\0a  /\\ nSnt0F = 0\0a  /\\ nSnt1F = 0\0a  /\\ nFaulty = 0\0a  /\\ nRcvd0 = [ i \\in Proc |-> 0 ]\0a  /\\ nRcvd1 = [ i \\in Proc |-> 0 ]  \0a\0a\0aTypeOK == \0a  /\\ pc \\in [ Proc -> Status ]          \0a  /\\ nSnt0 \\in 0..N\0a  /\\ nSnt1 \\in 0..N\0a  /\\ nSnt0F \\in 0..N\0a  /\\ nSnt1F \\in 0..N\0a  /\\ nFaulty \\in 0..F\0a  /\\ nRcvd0 \\in [ Proc -> 0..N ]\0a  /\\ nRcvd1 \\in [ Proc -> 0..N ]\0a  \0a (* If all processes propose 0, then every process crashes or decides 0. *) \0aOneStep0_Ltl ==\0a  (\\A i \\in Proc : pc[i] = "V0") => [](\\A i \\in Proc : pc[i] # "U0" /\\ pc[i] # "U1" /\\ pc[i] # "D1")\0a\0a(* If all processes propose 1, then every process crashes or decides 1. *)\0aOneStep1_Ltl ==  \0a  (\\A i \\in Proc : pc[i] = "V1") => <>(\\A i \\in Proc : pc[i] # "U0" /\\ pc[i] # "U1" /\\ pc[i] # "D0")\0a \0aStateConstraint ==\0a    TLCGet("level") < 6\0a\0aAllDecideOne == \\A self \\in Proc : <>(pc[self] = "D1")\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Mon Jul 09 13:26:59 CEST 2018 by tthai\0a\\* Created Mon Jun 04 13:20:35 CEST 2018 by tthai\0a']]]
      ['examples/detector_chan96/Age_Channel' 'Age_Channel' %accept ~[['Age_Channel' '---------------------------- MODULE Age_Channel ----------------------------\0a\0aEXTENDS Integers, TLC\0a\0a\0aCONSTANT Messages,    (* All messages sent by correct processes. *)\0a         Boxes        (* Every message is put into a box which has information\0a                          about how long this message have been in transit. *) \0a       \0a\0aVARIABLES inTransit,  (* All messages are in transit. *)\0a          inDelivery  (* inDelivery contains messages which are delivered\0a                          to a process p_i in this transition. *)\0a\0a\0a(* Pack a message into a box with its age which shows how long a message\0a    have been in transit. *)\0aPack_WaitingTime(msgs) == { [ content |-> m, age |-> 0 ] : m \\in msgs }\0a\0a(*  - Unpack boxes to get messages. Ages is not delivered. \0a    - Those messages are delivered to a process in this transition. *)\0aUnpack(boxes) == { m.content : m \\in boxes } \0a\0a(* Initialization *)\0aInit ==  \0a  /\\ inTransit = {}   (* No boxes are in transit. *)\0a  /\\ inDelivery = {}  (* No messages are delivered. *)\0a\0a\0a(* Pack a set msgs of messages with ages and put them in transit *)\0aPickup(msgs) == \0a  /\\ inTransit\' = inTransit \\cup Pack_WaitingTime(msgs)\0a  /\\ inDelivery\' = {}  \0a\0a\0a(*  - Non-deterministically choose some boxes and deliver associated messages to rcver. \0a    - Messages which are delivered are removed from inTransit. *)\0aDeliver(rcver) ==\0a  \\E boxes \\in SUBSET inTransit :\0a      /\\ \\A box \\in boxes : box.content.to = rcver\0a      /\\ inDelivery\' = Unpack(boxes)\0a      /\\ inTransit\' = inTransit \\ boxes\0a\0a               \0a(*  - Every message in transit attains a new age at every tick of the environmental clock. \0a    - Recall that we don\'t directly specify the environmental clock  in this encoding way.\0a      At every tick of the global clock, we only increase ages of boxes in transit.  \0a    - We can keep inDelivery unchanged. However, I set inDelivery\' an empty set because it \0a      makes an execution path more (human) readable, at least for me.  *)               \0aAttainAge ==\0a  /\\ inTransit\' = { [ content |-> package.content, age |-> package.age + 1 ]  : \0a                        package \\in inTransit }\0a  /\\ inDelivery\' = {}  \0a  \0a(* Type invariant for inTransit and inDelivery. *)\0aTypeOK ==\0a  /\\ inTransit \\subseteq Boxes\0a  /\\ inDelivery \\subseteq Messages \0a\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Mon Jun 11 13:30:42 CEST 2018 by tthai\0a\\* Created Thu Jun 07 09:30:18 CEST 2018 by tthai\0a']]]
      ['examples/detector_chan96/EPFailureDetector' 'EPFailureDetector' %accept ~[['EPFailureDetector' '------------------------- MODULE EPFailureDetector -------------------------\0a\0aEXTENDS Integers, FiniteSets, TLC\0a\0aCONSTANTS \0a  Proc,\0a  d0,           (* The default time-out interval for all delta(p)(q) *)\0a  SendPoint,    (* Every correct process sends alive messages to others at every \0a                   SendPoint ticks of its local clock. *)           \0a  PredictPoint, (* Every correct process makes predictions about failures at every \0a                   PredictPoint ticks of its lock clock. *)\0a  Messages  \0a  \0a(* Assumptions about the constraints in our system.\0a    - SendPoint # PredictPoint: a process cannot both send messages and receive \0a      messages in one transition. \0a    - PredictPoint % SendPoint # 0 /\\ SendPoint % PredictPoint # 0 : the operation \0a      Predict cannot subsume the operation Predict and vice versa. *)\0aASSUME  /\\ 0 < PredictPoint /\\ 0 < SendPoint \0a        /\\ PredictPoint % SendPoint # 0 /\\ SendPoint % PredictPoint # 0 \0a        \0a(*  Variables\' role:\0a      - localClock[i]         a discrete integer-numbered local clock of a process p_i\0a      - suspected[i]          predictions about failures of p_i\0a      - delta[i][j]           a time-out interval which p_i waits for hearing something \0a                              from a process p_j    \0a      - mailbox[i]            messages which p_i has received in the current transition\0a      - outgoingMessages[i]   messages which p_i wants to send in the current transition                                        \0a    More information:\0a      1/ A process p_i make a transition at every tick of its local clock localClock[i].\0a      2/ At every tick of the global clock, at least one correct processes make a \0a         transition.\0a      3/ Processes can change their predictions. \0a      4/ Correct processes eventually make stable predictions.\0a      5/ Whenever p_i receives an "alive" message from p_j, p_i increases the time-out \0a         interval of j, removes j from its suspended list suspected[i], and updates its \0a         fromLastHeard[i][j]. *)    \0aVARIABLES suspected, delta, fromLastHeard, localClock, outgoingMessages\0a  \0avars == << suspected, delta, fromLastHeard, localClock, outgoingMessages >>\0a\0aNULL == -1\0a\0a(*  Create an "alive" message for every processes  *)\0aMakeAliveMsgsForAll(snder) == { [ from |-> snder, to |-> rcver, type |-> "alive" ] : \0a                                        rcver \\in Proc }\0a\0a(* The initial state of processes \0a    - 1st conj: No process p_is predicted as a faulty one. \0a    - 2nd conj: Set every default time-out interval with d0. \0a    - 3rd conj: No processes have received any messages from others. \0a    - 4th conj: Every local clock starts at 0.\0a    - 5th conj: No messages were sent. *)\0aInit ==  \0a  /\\ suspected = [ i \\in Proc |-> {} ]                        \0a  /\\ delta = [ i \\in Proc |-> [ j \\in Proc |-> d0 ] ]         \0a  /\\ fromLastHeard = [ i \\in Proc |-> [ j \\in Proc |-> 0 ] ]  \0a  /\\ localClock = [ i \\in Proc |-> 0 ]                                  \0a  /\\ outgoingMessages = [ i \\in Proc |-> {} ]                 \0a  \0a(*  - Whenever the value of its local clock is greater than SendPoint, PredictPoint, \0a      and delta[i][j], the local clock is reset to 0. \0a    - Because of the constraints about message delay and relative speeds of different\0a      processes in partial synchrony, the upper bound of local clocks exists.    *)  \0aLocallyTick(i) ==\0a  localClock\' = [ localClock EXCEPT ![i] = \0a                                IF /\\ \\A j \\in Proc : delta[i][j] < localClock[i] \0a                                   /\\ SendPoint < localClock[i]\0a                                   /\\ PredictPoint < localClock[i]     \0a                                THEN 0\0a                                ELSE localClock[i] + 1 ]  \0a                 \0a(*  - A process p_i sends an "alive" message to every process at every SendPoint ticks\0a      of its local clock.\0a    - p_i constructs an "alive" messages for every process by calling MakeAliveMsgs, \0a      and put these messages in its outgoingMessages which will be picked up by the \0a      environmental controller in the composition action.   \0a    - p_i does not know exactly how the communication system works. *)\0aSendAlive(i) ==    \0a  /\\ localClock[i] % PredictPoint # 0\0a  /\\ localClock[i] % SendPoint = 0\0a  /\\ LocallyTick(i)\0a  /\\ outgoingMessages\' = [ outgoingMessages EXCEPT ![i] = MakeAliveMsgsForAll(i)]\0a  /\\ fromLastHeard\' = [ fromLastHeard EXCEPT ![i] = \0a                              [ j \\in Proc |-> IF fromLastHeard[i][j] <= delta[i][j]\0a                                               THEN fromLastHeard[i][j]  + 1\0a                                               ELSE fromLastHeard[i][j] ] ]                                                           \0a  /\\ UNCHANGED << suspected, delta >>\0a                                                                                                                                                                                                             \0a(*  - incomingMessages: A process does not know exactly how messages are feed to it. \0a    - 1nd conj: A process p_i can perform the operation Receive if and only if it do\0a                not execute \0a      the operations Send and Predict.    \0a    - 2nd conj: Update the value of its local clock.\0a    - 3rd conj: Update fromLastHeard immediately after new messages are received.\0a                If p_i receives a messages from p_j, then fromLastHeard[i][j] is reset\0a                to 0. If p_i does not receive a messages from p_j, fromLastHeard[i][j] is\0a                increased by 1. However, if fromLastHeard[i][j] is already greater than\0a                delta[i][j], we keep fromLastHeard[i][j] unchanged.  \0a    - 4th conj: Increase the waiting time for processes from which a process p_i has \0a                received messages.\0a    - 5th conj: Update its predictions. All processes from which a process p_i has \0a                received some message in this transition are marked as correct ones. \0a    - 6th conj: outgoingMessages is irrelevant in this transition. *)            \0aReceive(i, incomingMessages) ==\0a  /\\ \\/ /\\ localClock[i] % PredictPoint = 0\0a        /\\ localClock[i] % SendPoint = 0\0a     \\/ /\\ localClock[i] % PredictPoint # 0\0a        /\\ localClock[i] % SendPoint # 0\0a  /\\ LocallyTick(i)\0a  /\\ fromLastHeard\' = [ fromLastHeard EXCEPT ![i] = \0a                              [ j \\in Proc |-> IF \\E m \\in incomingMessages : m.from = j \0a                                               THEN 0\0a                                               ELSE IF j \\notin suspected[i]\0a                                                    THEN IF fromLastHeard[i][j] <= delta[i][j]\0a                                                         THEN fromLastHeard[i][j] + 1\0a                                                         ELSE fromLastHeard[i][j]  \0a                                                    ELSE fromLastHeard[i][j] ] ]                                                         \0a  /\\ delta\' = [ delta EXCEPT ![i] = [ j \\in Proc |-> IF /\\ j \\in suspected[i]\0a                                                        /\\ \\E m \\in incomingMessages : m.from = j\0a                                                     THEN delta[i][j] + 1\0a                                                     ELSE delta[i][j] ] ]  \0a  /\\ suspected\' = [ suspected EXCEPT ![i] = suspected[i] \\ { j \\in Proc : (\\E msg \\in incomingMessages : msg.from = j) } ]  \0a  /\\ UNCHANGED outgoingMessages                                                                                                                                                        \0a\0a(*  - A process p_i makes predictions at every PredictPoint ticks of its local clock, based on messages \0a      which it has received until now.     \0a    - If a process p_i has not received any message from a process p_j after delta[i][j] time units,\0a      a process p_i predicts that a process p_j is faulty. \0a    - 6h conjunciton: outgoingMessages is irrelevant in this transition.  *)                                                                 \0aPredict(i) ==    \0a  /\\ localClock[i] % PredictPoint = 0\0a  /\\ localClock[i] % SendPoint # 0\0a  /\\ LocallyTick(i)\0a  /\\ suspected\' = [ suspected EXCEPT ![i] = suspected[i] \\cup { j \\in Proc : fromLastHeard[i][j] > delta[i][j] } ]\0a  /\\ UNCHANGED outgoingMessages\0a  /\\ fromLastHeard\' = [ fromLastHeard EXCEPT ![i] = [ j \\in Proc |-> IF fromLastHeard[i][j] <= delta[i][j]\0a                                                                     THEN fromLastHeard[i][j] + 1\0a                                                                     ELSE fromLastHeard[i][j] ] ]\0a  /\\ UNCHANGED << delta >>\0a    \0a(* Type invariant *)    \0aTypeOK ==        \0a  /\\ fromLastHeard \\in [ Proc -> [ Proc -> Int ] ]\0a  /\\ \\A p, q \\in Proc : fromLastHeard[p][q] \\in Int\0a  /\\ delta \\in [ Proc -> [ Proc -> Int ] ]\0a  /\\ suspected \\in [ Proc -> SUBSET Proc ]  \0a  /\\ outgoingMessages  \\in [ Proc -> SUBSET Messages ]                                                                               \0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Mon Jun 11 17:27:19 CEST 2018 by tthai\0a\\* Created Mon Jun 04 12:39:53 CEST 2018 by tthai\0a']]]
      ['examples/ewd840/EWD840' 'EWD840' %accept ~[['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0a(***************************************************************************)\0a(* TLA+ specification of an algorithm for distributed termination          *)\0a(* detection on a ring, due to Dijkstra, published as EWD 840:             *)\0a(* Derivation of a termination detection algorithm for distributed         *)\0a(* computations (with W.H.J.Feijen and A.J.M. van Gasteren).               *)\0a(***************************************************************************)\0aEXTENDS Naturals, TLC, TLCExt\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0a\0aNode == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Node -> BOOLEAN]    \\* status of nodes (active or passive)\0a  /\\ color \\in [Node -> Color]       \\* color of nodes\0a  /\\ tpos \\in Node                   \\* token position\0a  /\\ tcolor \\in Color                 \\* token color\0a\0a(***************************************************************************)\0a(* Initially the token is black. The other variables may take any          *)\0a(* "type-correct" values.                                                  *)\0a(***************************************************************************)\0aInit ==\0a  /\\ active \\in [Node -> BOOLEAN]\0a  /\\ color \\in [Node -> Color]\0a  /\\ tpos \\in Node\0a  /\\ tcolor = "black"\0a\0a(***************************************************************************)\0a(* Node 0 may initiate a probe when it has the token and when either it is *)\0a(* black or the token is black. It passes a white token to node N-1 and    *)\0a(* paints itself white.                                                    *)\0a(***************************************************************************)\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ active\' = active\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a\0a(***************************************************************************)\0a(* A node i different from 0 that possesses the token may pass it to node  *)\0a(* i-1 under the following circumstances:                                  *)\0a(*   - node i is inactive or                                               *)\0a(*   - node i is colored black or                                          *)\0a(*   - the token is black.                                                 *)\0a(* Note that the last two conditions will result in an inconclusive round, *)\0a(* since the token will be black. The token will be stained if node i is   *)\0a(* black, otherwise its color is unchanged. Node i will be made white.     *)\0a(***************************************************************************)\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i] \\/ color[i] = "black" \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ active\' = active\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a\0a(***************************************************************************)\0a(* token passing actions controlled by the termination detection algorithm *)\0a(***************************************************************************)\0aSystem == InitiateProbe \\/ \\E i \\in Node \\ {0} : PassToken(i)\0a\0a(***************************************************************************)\0a(* An active node i may activate another node j by sending it a message.   *)\0a(* If j>i (hence activation goes against the direction of the token being  *)\0a(* passed), then node i becomes black.                                     *)\0a(***************************************************************************)\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Node \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0a(***************************************************************************)\0a(* Any active node may become inactive at any moment.                      *)\0a(***************************************************************************)\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0a(***************************************************************************)\0a(* actions performed by the underlying algorithm                           *)\0a(***************************************************************************)\0aEnvironment == \\E i \\in Node : SendMsg(i) \\/ Deactivate(i)\0a\0a(***************************************************************************)\0a(* next-state relation: disjunction of above actions                       *)\0a(***************************************************************************)\0aNext == System \\/ Environment\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aSpec == Init /\\ [][Next]_vars /\\ WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Non-properties, useful for validating the specification with TLC.       *)\0a(***************************************************************************)\0aTokenAlwaysBlack == tcolor = "black"\0a\0aNeverChangeColor == [][ UNCHANGED color ]_vars\0a\0a(***************************************************************************)\0a(* Main safety property: if there is a white token at node 0 then every    *)\0a(* node is inactive.                                                       *)\0a(***************************************************************************)\0aterminated == \\A i \\in Node : ~ active[i]\0a\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a\0aTerminationDetection == terminationDetected => terminated\0a\0a(***************************************************************************)\0a(* Liveness property: termination is eventually detected.                  *)\0a(***************************************************************************)\0aLiveness == terminated ~> terminationDetected\0a\0a(***************************************************************************)\0a(* The following property asserts that when every process always           *)\0a(* eventually terminates then eventually termination will be detected.     *)\0a(* It does not hold since processes can wake up each other.                *)\0a(***************************************************************************)\0aFalseLiveness ==\0a  (\\A i \\in Node : []<> ~ active[i]) ~> terminationDetected\0a\0a(***************************************************************************)\0a(* The following property says that eventually all nodes will terminate    *)\0a(* assuming that from some point onwards no messages are sent. It is       *)\0a(* not supposed to hold: any node may indefinitely perform local           *)\0a(* computations. However, this property is verified if the fairness        *)\0a(* condition WF_vars(Next) is used instead of only WF_vars(System) that    *)\0a(* requires fairness of the actions controlled by termination detection.   *)\0a(***************************************************************************)\0aSpecWFNext == Init /\\ [][Next]_vars /\\ WF_vars(Next)\0aAllNodesTerminateIfNoMessages ==\0a  <>[][\\A i \\in Node : ~ SendMsg(i)]_vars => <>(\\A i \\in Node : ~ active[i])\0a\0a(***************************************************************************)\0a(* Dijkstra\'s inductive invariant                                          *)\0a(***************************************************************************)\0aInv == \0a  \\/ P0:: \\A i \\in Node : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a(***************************************************************************)\0a(* Use the following specification to let TLC check that the predicate     *)\0a(* TypeOK /\\ Inv is inductive for EWD 840: verify that it is an            *)\0a(* (ordinary) invariant of a specification obtained by replacing the       *)\0a(* initial condition by that conjunction.                                  *)\0a(***************************************************************************)\0aCheckInductiveSpec == TypeOK /\\ Inv /\\ [][Next]_vars\0a\0a(***************************************************************************)\0a(* The algorithm implements the high-level specification of termination    *)\0a(* detection in a ring with synchronous communication between nodes.       *)\0a(* Note that the parameters of the module SyncTerminationDetection are     *)\0a(* instantiated by the symbols of the same name in the present module.     *)\0a(***************************************************************************)\0aTD == INSTANCE SyncTerminationDetection\0aTDSpec == TD!Spec\0aTokenPermanentlyBlack == <>[](tcolor = "black")\0a\0a\0a----\0aPostCondition ==\0a  CounterExample =\0a   [ action |->\0a      { << << 1,\0a              [ active |-> (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE),\0a                color |-> (0 :> "white" @@ 1 :> "white" @@ 2 :> "white"),\0a                tpos |-> 0,\0a                tcolor |-> "black" ] >>,\0a           [ name |-> "InitiateProbe",\0a             location |->\0a                 [ beginLine |-> 40,\0a                   beginColumn |-> 3,\0a                   endLine |-> 45,\0a                   endColumn |-> 43,\0a                   module |-> "EWD840" ] ],\0a           << 2,\0a              [ active |-> (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE),\0a                color |-> (0 :> "white" @@ 1 :> "white" @@ 2 :> "white"),\0a                tpos |-> 2,\0a                tcolor |-> "white" ] >> >>,\0a        << << 2,\0a              [ active |-> (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE),\0a                color |-> (0 :> "white" @@ 1 :> "white" @@ 2 :> "white"),\0a                tpos |-> 2,\0a                tcolor |-> "white" ] >>,\0a           [ name |-> "PassToken",\0a             location |->\0a                 [ beginLine |-> 58,\0a                   beginColumn |-> 3,\0a                   endLine |-> 63,\0a                   endColumn |-> 43,\0a                   module |-> "EWD840" ],\0a             context |-> [i |-> 2],\0a             parameters |-> <<"i">> ],\0a           << 3,\0a              [ active |-> (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE),\0a                color |-> (0 :> "white" @@ 1 :> "white" @@ 2 :> "white"),\0a                tpos |-> 1,\0a                tcolor |-> "white" ] >> >>,\0a        << << 3,\0a              [ active |-> (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE),\0a                color |-> (0 :> "white" @@ 1 :> "white" @@ 2 :> "white"),\0a                tpos |-> 1,\0a                tcolor |-> "white" ] >>,\0a           [ name |-> "PassToken",\0a             location |->\0a                 [ beginLine |-> 58,\0a                   beginColumn |-> 3,\0a                   endLine |-> 63,\0a                   endColumn |-> 43,\0a                   module |-> "EWD840" ],\0a             context |-> [i |-> 1],\0a             parameters |-> <<"i">> ],\0a           << 4,\0a              [ active |-> (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE),\0a                color |-> (0 :> "white" @@ 1 :> "white" @@ 2 :> "white"),\0a                tpos |-> 0,\0a                tcolor |-> "white" ] >> >>,\0a        << << 4,\0a              [ active |-> (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE),\0a                color |-> (0 :> "white" @@ 1 :> "white" @@ 2 :> "white"),\0a                tpos |-> 0,\0a                tcolor |-> "white" ] >>,\0a           [ name |-> "PassToken",\0a             location |->\0a                 [ beginLine |-> 58,\0a                   beginColumn |-> 3,\0a                   endLine |-> 63,\0a                   endColumn |-> 43,\0a                   module |-> "EWD840" ],\0a             context |-> [i |-> 1],\0a             parameters |-> <<"i">> ],\0a           << 4,\0a              [ active |-> (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE),\0a                color |-> (0 :> "white" @@ 1 :> "white" @@ 2 :> "white"),\0a                tpos |-> 0,\0a                tcolor |-> "white" ] >> >> },\0a  state |->\0a      { << 1,\0a           [ active |-> (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE),\0a             color |-> (0 :> "white" @@ 1 :> "white" @@ 2 :> "white"),\0a             tpos |-> 0,\0a             tcolor |-> "black" ] >>,\0a        << 2,\0a           [ active |-> (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE),\0a             color |-> (0 :> "white" @@ 1 :> "white" @@ 2 :> "white"),\0a             tpos |-> 2,\0a             tcolor |-> "white" ] >>,\0a        << 3,\0a           [ active |-> (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE),\0a             color |-> (0 :> "white" @@ 1 :> "white" @@ 2 :> "white"),\0a             tpos |-> 1,\0a             tcolor |-> "white" ] >>,\0a        << 4,\0a           [ active |-> (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE),\0a             color |-> (0 :> "white" @@ 1 :> "white" @@ 2 :> "white"),\0a             tpos |-> 0,\0a             tcolor |-> "white" ] >> } ]\0a   \0a=============================================================================\0a\\* Modification History\0a\\* Created Mon Sep 09 11:33:10 CEST 2013 by merz\0a'] ['SyncTerminationDetection' '---------------------- MODULE SyncTerminationDetection ----------------------\0a(***************************************************************************)\0a(* This module contains an abstract specification of the termination       *)\0a(* detection problem in a ring with synchronous communication. We will     *)\0a(* prove that the EWD840 algorithm refines this specification.             *)\0a(***************************************************************************)\0aEXTENDS Naturals\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aNode == 0 .. N-1\0a\0aVARIABLES \0a  active,               \\* activation status of nodes\0a  terminationDetected   \\* has termination been detected?\0a\0aTypeOK ==\0a  /\\ active \\in [Node -> BOOLEAN]\0a  /\\ terminationDetected \\in BOOLEAN\0a\0aterminated == \\A n \\in Node : ~ active[n]\0a\0a(***************************************************************************)\0a(* Initial condition: the nodes can be active or inactive, termination     *)\0a(* may (but need not) be detected immediately if all nodes are inactive.   *)\0a(***************************************************************************)\0aInit ==\0a  /\\ active \\in [Node -> BOOLEAN]\0a  /\\ terminationDetected \\in {FALSE, terminated}\0a\0aTerminate(i) ==  \\* node i terminates\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a     (* possibly (but not necessarily) detect termination if all nodes are inactive *)\0a  /\\ terminationDetected\' \\in {terminationDetected, terminated\'}\0a\0aWakeup(i,j) ==  \\* node i activates node j\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![j] = TRUE]\0a  /\\ UNCHANGED terminationDetected\0a\0aDetectTermination ==\0a  /\\ terminated\0a  /\\ terminationDetected\' = TRUE\0a  /\\ UNCHANGED active\0a\0aNext ==\0a  \\/ \\E i \\in Node : Terminate(i)\0a  \\/ \\E i,j \\in Node : Wakeup(i,j)\0a  \\/ DetectTermination\0a\0avars == <<active, terminationDetected>>\0aSpec == Init /\\ [][Next]_vars /\\ WF_vars(DetectTermination)\0a\0a------------------------------------------------------------------------------\0a(* Correctness properties *)\0a\0aTDCorrect == terminationDetected => terminated\0a\0aQuiescence == [](terminated => []terminated)\0a\0aLiveness == terminated ~> terminationDetected\0a\0aDetectionLeadsToReactivation == terminationDetected ~> (\\E n \\in Node : active[n])\0a\0a=============================================================================\0a\\* Modification History\0a\\* Created Sun Jan 10 15:19:20 CET 2021 by merz\0a']]]
      ['examples/ewd840/SyncTerminationDetection' 'SyncTerminationDetection' %accept ~[['SyncTerminationDetection' '---------------------- MODULE SyncTerminationDetection ----------------------\0a(***************************************************************************)\0a(* This module contains an abstract specification of the termination       *)\0a(* detection problem in a ring with synchronous communication. We will     *)\0a(* prove that the EWD840 algorithm refines this specification.             *)\0a(***************************************************************************)\0aEXTENDS Naturals\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aNode == 0 .. N-1\0a\0aVARIABLES \0a  active,               \\* activation status of nodes\0a  terminationDetected   \\* has termination been detected?\0a\0aTypeOK ==\0a  /\\ active \\in [Node -> BOOLEAN]\0a  /\\ terminationDetected \\in BOOLEAN\0a\0aterminated == \\A n \\in Node : ~ active[n]\0a\0a(***************************************************************************)\0a(* Initial condition: the nodes can be active or inactive, termination     *)\0a(* may (but need not) be detected immediately if all nodes are inactive.   *)\0a(***************************************************************************)\0aInit ==\0a  /\\ active \\in [Node -> BOOLEAN]\0a  /\\ terminationDetected \\in {FALSE, terminated}\0a\0aTerminate(i) ==  \\* node i terminates\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a     (* possibly (but not necessarily) detect termination if all nodes are inactive *)\0a  /\\ terminationDetected\' \\in {terminationDetected, terminated\'}\0a\0aWakeup(i,j) ==  \\* node i activates node j\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![j] = TRUE]\0a  /\\ UNCHANGED terminationDetected\0a\0aDetectTermination ==\0a  /\\ terminated\0a  /\\ terminationDetected\' = TRUE\0a  /\\ UNCHANGED active\0a\0aNext ==\0a  \\/ \\E i \\in Node : Terminate(i)\0a  \\/ \\E i,j \\in Node : Wakeup(i,j)\0a  \\/ DetectTermination\0a\0avars == <<active, terminationDetected>>\0aSpec == Init /\\ [][Next]_vars /\\ WF_vars(DetectTermination)\0a\0a------------------------------------------------------------------------------\0a(* Correctness properties *)\0a\0aTDCorrect == terminationDetected => terminated\0a\0aQuiescence == [](terminated => []terminated)\0a\0aLiveness == terminated ~> terminationDetected\0a\0aDetectionLeadsToReactivation == terminationDetected ~> (\\E n \\in Node : active[n])\0a\0a=============================================================================\0a\\* Modification History\0a\\* Created Sun Jan 10 15:19:20 CET 2021 by merz\0a']]]
      ['examples/ewd998/AsyncTerminationDetection' 'AsyncTerminationDetection' %accept ~[['AsyncTerminationDetection' '---------------------- MODULE AsyncTerminationDetection ---------------------\0a(***************************************************************************)\0a(* An abstract specification of the termination detection problem in a     *)\0a(* ring with asynchronous communication.                                   *)\0a(***************************************************************************)\0aEXTENDS Naturals, TLC, TLCExt\0aCONSTANT\0a  \\* @type: Int; \0a  N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aNode == 0 .. N-1\0a\0aVARIABLES \0a  \\* @type: Int -> Bool;\0a  active,               \\* activation status of nodes\0a  \\* @type: Int -> Int;\0a  pending,              \\* number of messages pending at a node\0a  \\* @type: Bool;\0a  terminationDetected   \\* has termination been detected?\0a\0aTypeOK ==\0a  /\\ active \\in [Node -> BOOLEAN]\0a  /\\ pending \\in [Node -> Nat]\0a  /\\ terminationDetected \\in BOOLEAN\0a\0aterminated == \\A n \\in Node : ~ active[n] /\\ pending[n] = 0\0a\0a(***************************************************************************)\0a(* Initial condition: the nodes can be active or inactive, no pending      *)\0a(* messages. Termination may (but need not) be detected immediately if all *)\0a(* nodes are inactive.                                                     *)\0a(***************************************************************************)\0aInit ==\0a  /\\ active \\in [Node -> BOOLEAN]\0a  /\\ pending = [n \\in Node |-> 0]\0a  /\\ terminationDetected \\in {FALSE, terminated}\0a\0aTerminate(i) ==  \\* node i terminates\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ pending\' = pending\0a     (* possibly (but not necessarily) detect termination if all nodes are inactive *)\0a  /\\ terminationDetected\' \\in {terminationDetected, terminated\'}\0a\0aSendMsg(i,j) ==  \\* node i sends a message to node j\0a  /\\ active[i]\0a  /\\ pending\' = [pending EXCEPT ![j] = @ + 1]\0a  /\\ UNCHANGED <<active, terminationDetected>>\0a\0aRcvMsg(i) == \\* node i receives a pending message\0a  /\\ pending[i] > 0\0a  /\\ active\' = [active EXCEPT ![i] = TRUE]\0a  /\\ pending\' = [pending EXCEPT ![i] = @ - 1]\0a  /\\ UNCHANGED terminationDetected\0a\0aDetectTermination ==\0a  /\\ terminated\0a  /\\ terminationDetected\' = TRUE\0a  /\\ UNCHANGED <<active, pending>>\0a\0aNext ==\0a  \\/ \\E i \\in Node : RcvMsg(i) \\/ Terminate(i)\0a  \\/ \\E i,j \\in Node : SendMsg(i,j)\0a  \\/ DetectTermination\0a\0avars == <<active, pending, terminationDetected>>\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ WF_vars(DetectTermination)\0a           \\* reasonable but not necessary for detecting termination\0a           \\* /\\ \\A i \\in Node : WF_vars(Wakeup(i))\0a\0a\\* a temporary solution for Apalache, until it translates [][Next]_vars\0aNextOrUnchanged ==\0a    Next \\/ UNCHANGED vars\0a\0a(***************************************************************************)\0a(* Restrict TLC model checking to a finite fragment of the state space.    *)\0a(***************************************************************************)\0aStateConstraint == \\A n \\in Node : pending[n] <= 3\0a\0a(***************************************************************************)\0a(* Correctness properties.                                                 *)\0a(***************************************************************************)\0aSafe == terminationDetected => terminated\0a\0aQuiescence == [](terminated => []terminated)\0a\0aLive == terminated ~> terminationDetected\0a\0a(***************************************************************************)\0a(* An inductive invariant to be checked with Apalache.                     *)\0a(***************************************************************************)\0aIndInv ==\0a    /\\ TypeOK\0a    /\\ Safe\0a\0a\\* By proving QuiescenceAsActionInv, we show that Quiescence holds true\0aQuiescenceAsActionInv ==\0a    terminated => terminated\'\0a\0a\\* @typeAlias: STATE =\0a\\*   [ active: Int -> Bool, pending: Int -> Int, terminationDetected: Bool ];\0a\\* @type: Seq(STATE) => Bool;\0aQuiescenceAsTraceInv(hist) ==\0a    LET terminatedAt(i) ==\0a        \\A n \\in Node: ~hist[i].active[n] /\\ hist[i].pending[n] = 0\0a    IN\0a    \\A i \\in DOMAIN hist:\0a        terminatedAt(i) =>\0a            \\A j \\in DOMAIN hist: j >= i => terminatedAt(j)\0a\0a(***************************************************************************)\0a(* Use Apalache to verify Quiescence by checking the action formula        *)\0a(* StableActionInvariant for a model with initial-state predicate TypeOK   *)\0a(* and next-state relation Next.                                           *)\0a(***************************************************************************)\0aStableActionInvariant == terminated => terminated\'\0a\0aPendingInfOften == <>[][DetectTermination]_vars\0a\0aPostCondition ==\0a  CounterExample =\0a   [ action |->\0a      { << << 1,\0a              [ active |->\0a                    (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE @@ 3 :> TRUE),\0a                pending |-> (0 :> 0 @@ 1 :> 0 @@ 2 :> 0 @@ 3 :> 0),\0a                terminationDetected |-> FALSE ] >>,\0a           [ name |-> "SendMsg",\0a             location |->\0a                 [ beginLine |-> 47,\0a                   beginColumn |-> 3,\0a                   endLine |-> 49,\0a                   endColumn |-> 46,\0a                   module |-> "AsyncTerminationDetection" ],\0a             context |-> [i |-> 3, j |-> 3],\0a             parameters |-> <<"i", "j">> ],\0a           << 2,\0a              [ active |->\0a                    (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE @@ 3 :> TRUE),\0a                pending |-> (0 :> 0 @@ 1 :> 0 @@ 2 :> 0 @@ 3 :> 1),\0a                terminationDetected |-> FALSE ] >> >>,\0a        << << 2,\0a              [ active |->\0a                    (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE @@ 3 :> TRUE),\0a                pending |-> (0 :> 0 @@ 1 :> 0 @@ 2 :> 0 @@ 3 :> 1),\0a                terminationDetected |-> FALSE ] >>,\0a           [ name |-> "RcvMsg",\0a             location |->\0a                 [ beginLine |-> 52,\0a                   beginColumn |-> 3,\0a                   endLine |-> 55,\0a                   endColumn |-> 34,\0a                   module |-> "AsyncTerminationDetection" ],\0a             context |-> [i |-> 3],\0a             parameters |-> <<"i">> ],\0a           << 1,\0a              [ active |->\0a                    (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE @@ 3 :> TRUE),\0a                pending |-> (0 :> 0 @@ 1 :> 0 @@ 2 :> 0 @@ 3 :> 0),\0a                terminationDetected |-> FALSE ] >> >> },\0a  state |->\0a      { << 1,\0a           [ active |-> (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE @@ 3 :> TRUE),\0a             pending |-> (0 :> 0 @@ 1 :> 0 @@ 2 :> 0 @@ 3 :> 0),\0a             terminationDetected |-> FALSE ] >>,\0a        << 2,\0a           [ active |-> (0 :> FALSE @@ 1 :> FALSE @@ 2 :> FALSE @@ 3 :> TRUE),\0a             pending |-> (0 :> 0 @@ 1 :> 0 @@ 2 :> 0 @@ 3 :> 1),\0a             terminationDetected |-> FALSE ] >> } ]\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Tue Apr 12 15:04:08 CEST 2022 by merz\0a\\* Last modified Wed Jun 02 14:21:31 PDT 2021 by markus\0a\\* Created Sun Jan 10 15:19:20 CET 2021 by merz\0a']]]
      ['examples/locks_auxiliary_vars/Stuttering' 'Stuttering' %accept ~[['Stuttering' '----------------------------- MODULE Stuttering ----------------------------\0a(***************************************************************************)\0a(* This module is explained in Section 5 of the paper "Auxiliary Variables *)\0a(* in TLA+".  It defines operators used to add a stuttering variable s to  *)\0a(* a specification `Spec\' to form a specification SpecS.  It is mean to be *)\0a(* instantiated with s replaced by the stuttering variable to be added and *)\0a(* vars replaced by the tuple of all variables in the original             *)\0a(* specification.                                                          *)\0a(*                                                                         *)\0a(* If Init is the initial predicate of `Spec\', then the initial predicate  *)\0a(* of SpecS is Init /\\ (s = top) , where top is defined below.             *)\0a(*                                                                         *)\0a(* The next-state action of SpecS is obtained by replacing each subaction  *)\0a(* `A\' of a disjunctive representation of the next-state action Next of    *)\0a(* `Spec\' with an action `AS\' written in terms of operators defined below. *)\0a(* (Disjunctive representations are described in Section 3.2 of "Auxiliary *)\0a(* Variables in TLA+".) Action `AS\' executes `A\' and stuttering steps      *)\0a(* added either before or after an `A\' step.  The basic idea is that s     *)\0a(* equals top except while stuttering steps are being taken, when it is a  *)\0a(* record with the following fields:                                       *)\0a(*                                                                         *)\0a(*   id: A value that identifies the action `A\'.                           *)\0a(*                                                                         *)\0a(*   ctxt: A value identifying the context under which `A\' is executed.    *)\0a(*         For example, if `A\' appears in a formula `\\E i, j \\in S : A\' ,  *)\0a(*         this would equal the value of the pair <<i, j>> for             *)\0a(*         which `A\' is being executed.                                    *)\0a(*                                                                         *)\0a(*   val: A value that is decremented by each stuttering step, until       *)\0a(*        it reaches a minimum value.                                      *)\0a(*                                                                         *)\0a(* The arguments of the operators defined in this module have the          *)\0a(* following meanings.                                                     *)\0a(*                                                                         *)\0a(* `A\'                                                                     *)\0a(*   The subaction `A\' of Next.                                            *)\0a(*                                                                         *)\0a(* id                                                                      *)\0a(*   A string identifying action `A\'.                                      *)\0a(*                                                                         *)\0a(* `Sigma\'                                                                 *)\0a(*   A set of values ordered by some "less-than" relation.  This is        *)\0a(*   the set of possible values of s.val when executing stuttering         *)\0a(*   steps before or after subaction `A\'.                                  *)\0a(*                                                                         *)\0a(* bot                                                                     *)\0a(*   The minimum element of Sigma under its less-than relation.            *)\0a(*                                                                         *)\0a(* initVal                                                                 *)\0a(*   The initial value to which s.val is set for executing stuttering      *)\0a(*   steps before or after `A\'.                                            *)\0a(*                                                                         *)\0a(* decr                                                                    *)\0a(*   An operator such that each stuttering step changes s.val to           *)\0a(*   decr(s.val).                                                          *)\0a(*                                                                         *)\0a(* `context\'                                                               *)\0a(*   The context in which `A\' appears.  It is the expression that is       *)\0a(*   evaluated to determine the value to which s.ctxt is set.              *)\0a(*                                                                         *)\0a(* `enabled\'                                                               *)\0a(*   A formula equivalent to `ENABLED A\'.  You can always take it to be    *)\0a(*   `ENABLED A\', but you can usually find an expression that equals       *)\0a(*   `ENABLED A\' in every reachable state of `Spec\' but is easier for      *)\0a(*   TLC to compute.                                                       *)\0a(***************************************************************************)\0aEXTENDS Naturals, TLC\0atop == [top |-> "top"] \0a\0aVARIABLES s, vars\0a\0a(***************************************************************************)\0a(* Equals `AS\' when no stuttering steps are being added before or after    *)\0a(* `A\'.                                                                    *)\0a(***************************************************************************)\0aNoStutter(A) == (s = top) /\\ A /\\ (s\' = s)\0a\0a(***************************************************************************)\0a(* The PostStutter and PreStutter operators define actions that perform    *)\0a(* stuttering steps after xecuting `A\' and before executing `A\',           *)\0a(* respectively.  If bot = 1, initVal = 42, and decr(i) = i-1, then the    *)\0a(* actions they define add 42 stuttering steps.  They always add at least  *)\0a(* one stuttering step.                                                    *)\0a(***************************************************************************)\0aPostStutter(A, actionId, context, bot, initVal, decr(_)) ==\0a  IF s = top THEN /\\ A \0a                  /\\ s\' = [id |-> actionId, ctxt |-> context, val |-> initVal]\0a             ELSE /\\ s.id = actionId\0a                  /\\ s.ctxt = context \\* MODIFIED HERE\0a                  /\\ UNCHANGED vars \0a                  /\\ s\'= IF s.val = bot THEN top \0a                                        ELSE [s EXCEPT !.val = decr(s.val)]\0a\0aPreStutter(A, enabled, actionId, context, bot, initVal, decr(_)) == \0a  IF s = top \0a    THEN /\\ enabled\0a         /\\ UNCHANGED vars \0a         /\\ s\' = [id |-> actionId, ctxt |-> context, val |-> initVal] \0a    ELSE /\\ s.id = actionId\0a         /\\ s.ctxt = context \\* MODIFIED HERE\0a         /\\ IF s.val = bot THEN /\\ s.ctxt = context\0a                                /\\ A \0a                                /\\ s\' = top\0a                           ELSE /\\ UNCHANGED vars  \0a                                /\\ s\' = [s EXCEPT !.val = decr(s.val)]\0a\0a(***************************************************************************)\0a(* The operators MayPostStutter and MayPreStutter are like PostStutter and *)\0a(* PreStutter, except they add one fewer stuttering step.  For example, if *)\0a(* bot = 1, initVal = 42, and decr(i) = i-1, then they add 42 steps.  If   *)\0a(* initVal = bot, then they simply execute A without any added stuttering  *)\0a(* steps.                                                                  *)\0a(***************************************************************************)                                 \0aMayPostStutter(A, actionId, context, bot, initVal, decr(_)) ==\0a  IF s = top THEN /\\ A \0a                  /\\ s\' = IF initVal = bot\0a                            THEN s\0a                            ELSE [id |-> actionId, ctxt |-> context, \0a                                  val |-> initVal]\0a             ELSE /\\ s.id = actionId\0a                  /\\ s.ctxt = context \\* MODIFIED HERE\0a                  /\\ UNCHANGED vars \0a                  /\\ s\'= IF decr(s.val) = bot \0a                           THEN top \0a                           ELSE [s EXCEPT !.val = decr(s.val)]\0a\0aMayPreStutter(A, enabled, actionId, context, bot, initVal, decr(_)) == \0a  IF s = top \0a    THEN /\\ enabled\0a         /\\ IF initVal = bot\0a              THEN A /\\ (s\' = s)\0a              ELSE /\\ s\' = [id |-> actionId, ctxt |-> context, val |-> initVal]\0a                   /\\ UNCHANGED vars         \0a    ELSE /\\ s.id = actionId\0a         /\\ s.ctxt = context \\* MODIFIED HERE \0a         /\\ IF s.val = bot THEN /\\ s.ctxt = context\0a                                /\\ A \0a                                /\\ s\' = top\0a                           ELSE /\\ UNCHANGED vars  \0a                                /\\ s\' = [s EXCEPT !.val = decr(s.val)] \0a-----------------------------------------------------------------------------\0a(***************************************************************************)\0a(* The following operator is true iff repeatedly apply decr to any element *)\0a(* sig of Sigma produces a sequence sig, decr(sig), decr(decr(sig)), ...   *)\0a(* that eventually arrives at bot.  This condition should be satisfied by  *)\0a(* the values of Sigma, bot, and decr used with the operators defined      *)\0a(* above to add stuttering steps to an action.                             *)\0a(***************************************************************************)\0aStutterConstantCondition(Sigma, bot, decr(_)) ==\0a  LET InverseDecr(S) == {sig \\in Sigma \\ S : decr(sig) \\in S}\0a      R[n \\in Nat] == IF n = 0 THEN {bot}\0a                               ELSE LET T == R[n-1] \0a                                    IN  T \\cup InverseDecr(T)\0a                        \0a  IN Sigma = UNION {R[n] : n \\in Nat}\0a\0a(***************************************************************************)\0a(* TLC can evaluate StutterConstantCondition only in a model that replaces *)\0a(* Nat by the set 0..n for some integer n.  The following operator is      *)\0a(* equivalent to StutterConstantCondition when Sigma is a finite set, but  *)\0a(* doesn\'t require modifying any definitions.                              *)\0a(***************************************************************************)\0aAltStutterConstantCondition(Sigma, bot, decr(_)) ==\0a   LET InverseDecr(S) == {sig \\in Sigma \\ S : decr(sig) \\in S}\0a       ReachBot[S \\in SUBSET Sigma] ==\0a          IF InverseDecr(S) = {} THEN S \0a                                 ELSE ReachBot[S \\cup InverseDecr(S)]\0a   IN  ReachBot[{bot}] = Sigma\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Sat Dec 31 17:47:02 PST 2016 by lamport\0a\\* Created Tue Dec 08 11:51:34 PST 2015 by lamport\0a\0a(*****************************************************************************)\0a(* This module comes from :                                                  *)\0a(* L. Lamport and S. Merz, "Auxiliary variables in TLA+",                    *)\0a(*   arXiv preprint arXiv:1703.05121, 2017.                                  *)\0a(*                                                                           *)\0a(* It has been modified slightly to ensure correctness whenever actions are  *)\0a(* are taken during a stuttering step (e.g. modifying a history variable)    *)\0a(* Search for the lines containing "MODIFIED HERE".                          *)\0a(* Indeed, the context variable is not always verified whenever a stutter    *)\0a(* step is taken.                                                            *)\0a(* Using specifications created from PlusCal and wanting to add stuttering   *)\0a(* to a certain transition, one might to put the label as an actionId and    *)\0a(* the process identifier as a context. Without modifications, and in the    *)\0a(* previously mentioned context, the stuttering does not behave correctly,   *)\0a(* as another process could advance the stuttering and possibly break the    *)\0a(* updating of variables.                                                    *)\0a(* Another solution could be to set the actionId to the <<label, procId>>    *)\0a(* tuple. (this has not been verified)                                       *)\0a(*****************************************************************************)']]]
      ['examples/nbacg_guer01/nbacg_guer01' 'nbacg_guer01' %accept ~[['nbacg_guer01' '------------------------------ MODULE nbacg_guer01 ------------------------------\0a\0a(* An encoding of a parameterized model of the asynchronous non-blocking atomic commitment \0a   algorithm with failure detectors in TLA+. The algorithm is described in the following paper:\0a \0a   [1] Guerraoui, Rachid. "On the hardness of failure-sensitive agreement problems." Information \0a   Processing Letters 79.2 (2001): 99-104.\0a \0a   Thanh Hai Tran, Igor Konnov, Josef Widder, 2016\0a \0a   This file is a subject to the license that is bundled together with this package and can \0a   be found in the file LICENSE.\0a *)\0a\0a\0aEXTENDS Naturals, FiniteSets\0a\0aCONSTANTS N\0a\0aVARIABLES nSntNo,     (* the number of YES messages sent by correct processes *)\0a          nSntYes,    (* the number of NO messages sent by correct processes *)\0a          nSntNoF,    (* the upper bound of the number of NO messages sent by faulty processes *)\0a          nSntYesF,   (* the upper bound of the number of NO messages sent by faulty processes *)\0a          nRcvdYes,   (* the number of Yes messages which have been received *)\0a          nRcvdNo,    (* the number of NO messages which have been received *)\0a          someFail,   (* a failure detector satisfies: \0a                          - every faulty processes is permanently suspected \0a                          - no process is suspected unless it crashes *)\0a          pc          (* process counters *)\0a                          \0a\0aProc == 1 .. N\0aStatus == { "YES", "NO", "SENT", "ABORT", "COMMIT", "BYZ" }\0avars == << nSntNo, nSntYes, nSntYesF, nSntNoF, nRcvdNo, nRcvdYes, someFail, pc >>\0a\0a\0a\0aInit ==  \0a  /\\ nSntNo = 0                         (* no message has been sent or received *)\0a  /\\ nSntYes = 0\0a  /\\ nSntNoF = 0 \0a  /\\ nSntYesF = 0    \0a  /\\ nRcvdYes = [ i \\in Proc |-> 0 ]\0a  /\\ nRcvdNo = [ i \\in Proc |-> 0 ]  \0a  /\\ pc \\in [ Proc -> { "NO", "YES" } ] (* a process can vote YES or NO *)\0a  /\\ someFail \\in [ Proc -> BOOLEAN ]   (* initialization of failure detector *)\0a  \0aInitYes ==  \0a  /\\ nSntNo = 0                         (* no message has been sent or received *)  \0a  /\\ nSntYes = 0\0a  /\\ nSntNoF = 0\0a  /\\ nSntYesF = 0    \0a  /\\ nRcvdYes = [ i \\in Proc |-> 0 ]    \0a  /\\ nRcvdNo = [ i \\in Proc |-> 0 ]  \0a  /\\ pc \\in [ Proc -> { "YES" } ]       (* all processes vote YES *)\0a  /\\ someFail \\in [ Proc -> BOOLEAN ]   (* initialization of failure detector *)\0a  \0aInitNo ==  \0a  /\\ nSntNo = 0                         (* no message has been sent or received *)\0a  /\\ nSntYes = 0\0a  /\\ nSntNoF = 0\0a  /\\ nSntYesF = 0    \0a  /\\ nRcvdYes = [ i \\in Proc |-> 0 ]\0a  /\\ nRcvdNo = [ i \\in Proc |-> 0 ]  \0a  /\\ pc \\in [ Proc -> { "NO" } ]        (* all processes vote NO *)\0a  /\\ someFail \\in [ Proc -> BOOLEAN ]   (* initialization of failure detector *)\0a  \0a(* Some process will crash in the next state. If the process has not proposed its initial \0a   value, the upper bound of the number of messages with the same value will be increased. \0a *)  \0aCrash(i) ==\0a  /\\ pc[i] # "BYZ"                      \0a  /\\ pc\' = [ pc EXCEPT ![i] = "BYZ" ]\0a  /\\ IF pc[i] = "YES"\0a     THEN nSntYesF\' = nSntYesF + 1\0a     ELSE nSntYesF\' = nSntYesF\0a  /\\ IF pc[i] = "NO"\0a     THEN nSntNoF\' = nSntNoF + 1\0a     ELSE nSntNoF\' = nSntNoF      \0a  /\\ UNCHANGED << nSntNo, nSntYes, nRcvdNo, nRcvdYes, someFail >>\0a\0a(* A process starts receiving messages after sending its vote. If a process crashed or decides, \0a   it stops receiving messages. \0a *)    \0aReceive(i) ==\0a  \\/ /\\ pc[i] = "SENT"\0a     /\\ nRcvdYes[i] < nSntYes + nSntYesF    (* receives a YES message *)                       \0a     /\\ nRcvdYes\' = [ nRcvdYes EXCEPT ![i] = nRcvdYes[i] + 1 ]\0a     /\\ UNCHANGED << nSntYes, nSntNo, nSntYesF, nSntNoF, nRcvdNo, someFail, pc >>     \0a  \\/ /\\ pc[i] = "SENT"\0a     /\\ nRcvdNo[i] < nSntNo + nSntNoF       (* receives a NO message *)\0a     /\\ nRcvdNo\' = [ nRcvdNo EXCEPT ![i] = nRcvdNo[i] + 1 ]\0a     /\\ UNCHANGED << nSntYes, nSntNo, nSntYesF, nSntNoF, nRcvdYes, someFail, pc >>  \0a  \\/ /\\ pc[i] = "SENT"\0a     /\\ nRcvdYes[i] =  nSntYes + nSntYesF     (* all messages are received *) \0a     /\\ nRcvdNo[i] = nSntNo + nSntNoF  \0a     /\\ UNCHANGED vars                       (* this conditions is added to avoid deadlocks *)       \0a\0a(* A correct process sends YES messages to all processes. *)\0aSendYes(i) ==\0a  /\\ pc[i] = "YES"    \0a  /\\ someFail[i] = FALSE\0a  /\\ pc\' = [ pc EXCEPT ![i] = "SENT" ]\0a  /\\ nSntYes\' = nSntYes + 1\0a  /\\ UNCHANGED << nSntNo, nSntYesF, nSntNoF, nRcvdNo, nRcvdYes, someFail >>\0a  \0a(* A correct process sends NO messages to all processes. *)  \0aSendNo(i) ==\0a  /\\ pc[i] = "NO"   \0a  /\\ someFail[i] = FALSE \0a  /\\ pc\' = [ pc EXCEPT ![i] = "SENT" ]\0a  /\\ nSntNo\' = nSntNo + 1\0a  /\\ UNCHANGED << nSntYes, nSntYesF, nSntNoF, nRcvdNo, nRcvdYes, someFail >>  \0a  \0a(* A suspicious process aborts. *)\0aAbortNoYes(i) ==\0a  /\\ someFail[i] = TRUE\0a  /\\ \\/ pc[i] = "YES"\0a     \\/ pc[i] = "NO" \0a  /\\ pc\' = [ pc EXCEPT ![i] = "ABORT" ]\0a  /\\ UNCHANGED << nSntNo, nSntYes, nSntYesF, nSntNoF, nRcvdNo, nRcvdYes, someFail >>\0a  \0a(* A correct process aborts after it received a NO message *)  \0aAbortSent(i) ==\0a  /\\ pc[i] = "SENT"\0a  /\\ nRcvdNo[i] > 0  \0a  /\\ pc\' = [ pc EXCEPT ![i] = "ABORT" ]\0a  /\\ UNCHANGED << nSntNo, nSntYes, nSntYesF, nSntNoF, nRcvdNo, nRcvdYes, someFail >>   \0a\0a(* A correct process commits since it knows that all processes propose YES *)     \0aCommit(i) ==\0a  /\\ pc[i] = "SENT"     \0a  /\\ nRcvdNo[i] = 0\0a  /\\ nRcvdYes[i] >= N\0a  /\\ pc\' = [ pc EXCEPT ![i] = "COMMIT" ]\0a  /\\ UNCHANGED << nSntNo, nSntYes, nSntYesF, nSntNoF, nRcvdNo, nRcvdYes, someFail >>\0a  \0aNext ==\0a  /\\ \\E self \\in Proc : \0a        \\/ Crash(self)\0a        \\/ Receive(self)\0a        \\/ SendYes(self) \0a        \\/ SendNo(self) \0a        \\/ AbortNoYes(self)\0a        \\/ AbortSent(self)\0a        \\/ Commit(self)  \0a        \\/ UNCHANGED vars     (* Avoid deadlocks. \0a                                 After deciding, a correct process does nothing. *)\0a                   \0a\0a(* \0a  In this specification, a process can vote YES or NO. Weak fairness condition is added \0a  since we want to check liveness properties.        \0a *)\0aSpec == Init /\\ [][Next]_vars \0a             /\\ WF_vars(\\E self \\in Proc : \0a                  \\/ Receive(self)                 \0a                  \\/ SendYes(self) \0a                  \\/ SendNo(self) \0a                  \\/ AbortNoYes(self)\0a                  \\/ AbortSent(self)\0a                  \\/ Commit(self))   \0a\0a                                           \0a(* All processes vote YES. *)                                           \0aSpecYes == InitYes /\\ [][Next]_vars \0a                   /\\ WF_vars(\\E self \\in Proc : \0a                                  \\/ Receive(self)                 \0a                                  \\/ SendYes(self) \0a                                  \\/ SendNo(self) \0a                                  \\/ AbortNoYes(self)\0a                                  \\/ AbortSent(self)\0a                                  \\/ Commit(self))\0a\0a(* All processes vote NO. *)                                             \0aSpecNo == InitNo /\\ [][Next]_vars \0a                 /\\ WF_vars(\\E self \\in Proc : \0a                                \\/ Receive(self)                 \0a                                \\/ SendYes(self) \0a                                \\/ SendNo(self) \0a                                \\/ AbortNoYes(self)\0a                                \\/ AbortSent(self)\0a                                \\/ Commit(self))\0a\0a\0a(* Type invariant *)\0aTypeOK == \0a  /\\ nSntNo \\in 0..N\0a  /\\ nSntYes \\in 0..N\0a  /\\ nSntNoF \\in 0..N\0a  /\\ nSntYesF \\in 0..N    \0a  /\\ nRcvdYes \\in [ Proc -> 0..(nSntYes + nSntYesF) ]\0a  /\\ nRcvdNo \\in [ Proc -> 0..(nSntNo + nSntNoF) ] \0a  /\\ pc \\in [ Proc -> Status ]\0a  /\\ someFail \\in [ Proc -> BOOLEAN ]      \0a   \0a(* No two correct processes decide differently. *)   \0aAgrrLtl ==\0a  [](~(\\E i \\in Proc, j \\in Proc :  pc[i] = "COMMIT" /\\ pc[j] = "ABORT"))\0a  \0a(* If some process votes NO, no process commits. *)  \0aAbortValidityLtl ==\0a  (\\E i \\in Proc : pc[i] = "NO") => [](\\A i \\in Proc : pc[i] # "COMMIT")\0a    \0a(* If every processes votes YES and no process is suspected, then no process crashes or aborts. *)    \0aCommitValidityLtl ==\0a  (\\A i \\in Proc : pc[i] = "YES" /\\ someFail[i] = FALSE) => [](\\A i \\in Proc : pc[i] = "BYZ" \\/ pc[i] # "ABORT")    \0a  \0a(* If no process crashes or is suspicious, then every process eventually commits. *)  \0aTerminationLtl ==\0a  ([](\\A i \\in Proc : pc[i] # "BYZ" /\\ someFail[i] = FALSE)) => <>(\\A i \\in Proc : pc[i] = "COMMIT" \\/ pc[i] = "ABORT")      \0a\0aAllCommit == \\A self \\in Proc : <>(pc[self] = "COMMIT")\0a\0a=============================================================================\0a']]]
