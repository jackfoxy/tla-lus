      ['suite/test52' 'test52' %accept ~[['test52' '----------------------   MODULE test52 -----------------------\0a\0a\\* Test of prefix and postfix operators as arguments\0a\0aEXTENDS TLC\0a\0aVARIABLES x, y\0a\0aBoxTest(-._) == -(x=0)\0aFoo1 == BoxTest([])\0aFoo2 == BoxTest(<>)\0a\0a-. a == {{"a"}, {"b"}} \\ a\0aa ^+  == {{"a"}, {"b"}} \\ a\0aa ^*  == {{"a"}, {"b"}} \\ a\0aa ^#  == {{"a"}, {"b"}} \\ a\0a\0aSetOpTest(Foo(_)) == Foo({{"b"}, {"c"}})\0aDomainTest(Foo(_)) == Foo([i\\in {"a", "b"} |-> i])\0a\0aASSUME\0a  /\\ Print("Test1 Begun", TRUE)\0a  /\\ SetOpTest(-.) =  - {{"b"}, {"c"}}\0a  /\\ SetOpTest(^+) =   {{"b"}, {"c"}} ^+\0a  /\\ SetOpTest(^*) =   {{"b"}, {"c"}} ^*\0a  /\\ SetOpTest(^#) =   {{"b"}, {"c"}} ^#\0a  /\\ SetOpTest(SUBSET) = SUBSET {{"b"}, {"c"}}\0a  /\\ SetOpTest(UNION) = UNION {{"b"}, {"c"}}\0a  /\\ DomainTest(DOMAIN) = DOMAIN [i\\in {"a", "b"} |-> i]\0a  /\\ Print("Test1 Finished", TRUE)\0a\0a\0aInit == /\\ x = {"a"}\0a        /\\ y = {"a"}\0aNext == /\\ x\'= x \\cup {"a"}\0a        /\\ y\'= y \\cup {"b"}\0aSpec == Init /\\ [][Next]_<<x, y>>\0a\0aEnabledTest(Foo(_)) == Foo(x\'=x)\0aUnchangedTest(Foo(_)) == Foo(x)\0aPrimeTest(Foo(_)) == Foo(x) = x\0a\0aInvariant ==\0a /\\ EnabledTest(ENABLED)\0a\0aImpliedAction ==\0a /\\ UnchangedTest(UNCHANGED)\0a /\\ PrimeTest(\')\0a\0aProperty == [][ImpliedAction]_<<x, y>>\0a\0a==================================================================\0a\\* Prefix Operators\0a~\0aENABLED\0aUNCHANGED\0a[]\0a<>\0aSUBSET\0aUNION\0aDOMAIN\0a-\0a\0a\\* Postfix Operators\0a\\* Predefined\0a\'\0a\0a\\* Undefined\0a^+\0a^*\0a^#\0a']]]
      ['suite/test53' 'test53' %accept ~[['test53' '--------------- MODULE test53 -------------\0a\0a(* test definability of operators with aliases *)\0a\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0au \\oplus v == u\0au \\ominus v == u\0au \\odot v == u\0au \\oslash v == u\0au \\otimes v == u \0au \\circ v == u\0au % v == u\0au =<  v == u\0au >= v == u\0a\0a\0aInit == \0a /\\ x = 0\0a\0aNext ==\0a   /\\ x = 0\0a   /\\ \0a      \\/ x\' = x \\oplus 1  \0a      \\/ x\' = x \\ominus 1  \0a      \\/ x\' = x \\odot 1  \0a      \\/ x\' = x \\oslash 1  \0a      \\/ x\' = x \\otimes 1 \0a      \\/ x\' = x \\circ 1 \0a      \\/ x\' = x % 1   \\* causes TLC bug\0a      \\/ x\' = (x =<  1)  \\* causes TLC bug \0a      \\/ x\' = (x >= 1 )  \\* causes TLC bug \0a=======================================\0a']]]
      ['suite/test54' 'test54' %accept ~[['test54' '--------------- MODULE test54 -------------\0a\0a(* test definability of operators with aliases *)\0a\0a\0aEXTENDS TLC\0a\0aVARIABLE x\0a\0au \\oplus v == u\0au \\ominus v == u\0au \\odot v == u\0au \\oslash v == u\0au \\otimes v == u \0au \\o v == u\0au % v == u\0au =<  v == u\0au >= v == u\0a\0a\0aInit == \0a /\\ x = 0\0a\0aNext ==\0a   /\\ x = 0\0a   /\\ \0a      \\/ x\' = x (+) 1     \\* causes TLC bug\0a      \\/ x\' = x (-) 1     \\* causes TLC bug\0a      \\/ x\' = x (.) 1     \\* causes TLC bug\0a      \\/ x\' = x (/) 1     \\* causes TLC bug\0a      \\/ x\' = x (\\X) 1  \\* parser can\'t handle this\0a      \\/ x\' = x \\circ 1   \\* causes TLC bug\0a      \\/ x\' = x % 1   \0a      \\/ x\' = (x =<  1)  \\* TLC bug : sets x\' to TRUE\0a      \\/ x\' = (x >= 1 )    \\* TLC bug : sets x\' to FALSE\0a=======================================\0a']]]
      ['suite/test55a' 'test55a' %accept ~[['test55a' '------------------------------- MODULE test55a ------------------------------\0aEXTENDS Naturals\0aVARIABLES x, y\0a\0aF == ENABLED (x\'=0 /\\ y\'=1)\0aG == ENABLED ((x # y) /\\ (x\'=0) /\\ (y\'=1))\0a\0aInit == (x = 0) /\\ (y = 0)\0aNext == /\\ x\' = 1 - x\0a        /\\ y\' = y\0a\0aSafeSpec == Init /\\ [][Next]_<<x,y>>\0aLiveSpec == SafeSpec /\\ WF_<<x,y>>(Next)\0a=============================================================================\0a']]]
      ['suite/test58' 'test58' %accept ~[['test58' '------------------- MODULE test58 --------------------\0a\\* Test of binary, octal, and hexadecimal numbers\0a\0aEXTENDS Naturals\0a\0aASSUME\0a  /\\ 63 = \\b111111\0a  /\\ 63 = \\o77\0a  /\\ 63 = \\h3F\0a  /\\ 63 = \\B111111\0a  /\\ 63 = \\O77\0a  /\\ 63 = \\H3f\0a  /\\ 63 = \\H3F\0a  /\\ 63 = \\h3f\0a\0a=======================================================\0a']]]
      ['suite/test6' 'test6' %accept ~[['test6' '--------------- MODULE test6 -------------\0a\0a(* test of Propositional Logic. *)\0a\0aEXTENDS Integers, TLC\0a\0aVARIABLE x, y, z, w\0aType == /\\ x \\in BOOLEAN\0a        /\\ y \\in BOOLEAN\0a        /\\ z \\in BOOLEAN\0a        /\\ w = 0\0aInit == /\\ x = TRUE\0a        /\\ y = TRUE\0a        /\\ z = FALSE\0a        /\\ w = 0\0aNext ==  /\\ \\/ (w = 1) /\\ Assert(FALSE, "This is a bug")\0a            \\/ (w=0)\0a         /\\ (w=0) \\* \\/ Assert(FALSE, "This is a bug, too")\0a                  \\* Commented out because I now don\'t think it\'s a bug.\0a         /\\ UNCHANGED <<w, x, y, z>>\0a\0aInv  ==  \0a\0a  /\\ IF ~(x /\\ y /\\ ~z)\0a      THEN Assert(FALSE, "Test 1 failed")\0a      ELSE Print("Test 1 OK", TRUE)\0a \0a  /\\ IF ~(~z /\\ y)\0a      THEN Assert(FALSE, "Test 2 failed")\0a      ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF ~(x \\/ ~y \\/ z)\0a      THEN Assert(FALSE, "Test 3 failed")\0a      ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF ~(z \\/ ~y \\/ x)\0a      THEN Assert(FALSE, "Test 4 failed")\0a      ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF ~(x /\\ y)\0a      THEN Assert(FALSE, "Test 5 failed")\0a      ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF (x /\\ z)\0a      THEN Assert(FALSE, "Test 6 failed")\0a      ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF (z /\\ x)\0a      THEN Assert(FALSE, "Test 7 failed")\0a      ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF (z /\\ ~x)\0a      THEN Assert(FALSE, "Test 8 failed")\0a      ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF (z /\\ (x=1))\0a      THEN Assert(FALSE, "Test 9 failed")\0a      ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF ~(x \\/ (z=1))\0a      THEN Assert(FALSE, "Test 10 failed")\0a      ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF ~(x => y)\0a      THEN Assert(FALSE, "Test 11 failed")\0a      ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF ~(~x => y)\0a      THEN Assert(FALSE, "Test 12 failed")\0a      ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF ~(~x => z)\0a      THEN Assert(FALSE, "Test 13 failed")\0a      ELSE Print("Test 13 OK", TRUE)\0a\0a  /\\ IF (x => z)\0a      THEN Assert(FALSE, "Test 14 failed")\0a      ELSE Print("Test 14 OK", TRUE)\0a\0a  /\\ IF ~x\0a      THEN Assert(FALSE, "Test 15 failed")\0a      ELSE Print("Test 15 OK", TRUE)\0a\0a  /\\ IF ~~z\0a      THEN Assert(FALSE, "Test 16 failed")\0a      ELSE Print("Test 16 OK", TRUE)\0a\0a  /\\ IF ~(x <=> y)\0a      THEN Assert(FALSE, "Test 17 failed")\0a      ELSE Print("Test 17 OK", TRUE)\0a\0a  /\\ IF ~(~x <=> z)\0a      THEN Assert(FALSE, "Test 18 failed")\0a      ELSE Print("Test 18 OK", TRUE)\0a\0a  /\\ IF (x <=> z)\0a      THEN Assert(FALSE, "Test 19 failed")\0a      ELSE Print("Test 19 OK", TRUE)\0a\0a  /\\ IF (z <=> x)\0a      THEN Assert(FALSE, "Test 20 failed")\0a      ELSE Print("Test 20 OK", TRUE)\0a\0a  /\\ IF ~(x \\equiv y)\0a      THEN Assert(FALSE, "Test 21 failed")\0a      ELSE Print("Test 21 OK", TRUE)\0a\0a  /\\ IF ~(~x \\equiv z)\0a      THEN Assert(FALSE, "Test 22 failed")\0a      ELSE Print("Test 22 OK", TRUE)\0a\0a  /\\ IF (x \\equiv z)\0a      THEN Assert(FALSE, "Test 23 failed")\0a      ELSE Print("Test 23 OK", TRUE)\0a\0a  /\\ IF (z \\equiv x)\0a      THEN Assert(FALSE, "Test 24 failed")\0a      ELSE Print("Test 24 OK", TRUE)\0a\0a  /\\ IF TRUE \\notin BOOLEAN\0a      THEN Assert(FALSE, "Test 25 failed")\0a      ELSE Print("Test 25 OK", TRUE)\0a\0a  /\\ IF FALSE \\notin BOOLEAN\0a      THEN Assert(FALSE, "Test 26 failed")\0a      ELSE Print("Test 26 OK", TRUE)\0a\0a  /\\ IF {TRUE, FALSE} # BOOLEAN\0a      THEN Assert(FALSE, "Test 27 failed")\0a      ELSE Print("Test 27 OK", TRUE)\0a\0a=========================================\0a']]]
      ['suite/test60' 'test60' %accept ~[['test60' '-------------------- MODULE test60 --------------------\0a(***************************************************************************)\0a(* Test of handling strings as sequences.                                  *)\0a(***************************************************************************)\0a\0aEXTENDS Sequences, TLC\0a\0aASSUME "abc" \\o "def" = "abcdef"\0aASSUME Len("abcdef") = 6\0aASSUME "a\\\\b\\"c\\nd" = "a\\\\b\\"" \\o "c\\nd" \0aASSUME Len("a\\\\b\\"c\\nd") = 7\0a\0a========================================\0a\0a']]]
      ['suite/test61' 'test61' %accept ~[['test61' '-------------------- MODULE test61 --------------------\0a(***************************************************************************)\0a(* Test of parametrized INSTANCE                                            *)\0a(***************************************************************************)\0a\\* Because of bug, it Handles JSpec but not ISpec\0a\0aEXTENDS Naturals\0a\0aVARIABLE y\0a\0aIM(x) == INSTANCE test61a\0a\0aISpec == IM(y)!Spec\0a\0aInvariant == y \\in 0..4\0a\0aJM == INSTANCE test61a WITH x <- y\0aJSpec == JM!Spec\0a\0a========================================\0a\0a'] ['test61a' '-------------------- MODULE test61a --------------------\0a(***************************************************************************)\0a(* Test of parametrized INSTANCE                                            *)\0a(***************************************************************************)\0a\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aSpec == (x = 0) /\\ [][x\'=(x+1)%5]_x\0a========================================\0a']]]
      ['suite/test61a' 'test61a' %accept ~[['test61a' '-------------------- MODULE test61a --------------------\0a(***************************************************************************)\0a(* Test of parametrized INSTANCE                                            *)\0a(***************************************************************************)\0a\0aEXTENDS Naturals\0a\0aVARIABLE x\0a\0aSpec == (x = 0) /\\ [][x\'=(x+1)%5]_x\0a========================================\0a']]]
      ['suite/test62' 'test62' %accept ~[['test62' '----------------------- MODULE test62 --------------------------\0aEXTENDS TLC\0aASSUME Print("Should print this", TRUE)\0aASSUME PrintT("And this")\0a=================================================================\0a']]]
      ['suite/test63' 'test63' %accept ~[['test63' '\\* Test of use of [A]_v within the next-state relation, checking\0a\\* bug fix of 11 Mar 2009\0a------------------------- MODULE test63 --------------------------\0aEXTENDS Naturals, test63a\0aVARIABLE now \0aCONSTANT Rho, MaxReal, SecondsPerHour\0a-----------------------------------------------------------------------------\0a\0aReal == 0 .. MaxReal\0a\0aASSUME (Rho \\in Real) /\\  (Rho > 0) \0a\0a   VARIABLE t  \0a   TNext == t\' = IF HCnxt THEN 0 ELSE t+(now\'-now) \0a   IsTimer == (t = 0)  /\\  [][TNext]_<<t,hr,now>>\0a   MaxTime == [](t \\leq  SecondsPerHour + Rho)  \0a   MinTime == [][HCnxt => t \\geq SecondsPerHour - Rho]_hr\0a   HCTime == IsTimer /\\ MaxTime /\\ MinTime \0a\0a\0aNowNext == /\\ now\' \\in {r \\in Real : r > now} \0a           /\\ UNCHANGED hr  \0a\0aBigNext == /\\ [NowNext]_now\0a           /\\ [HCnxt]_hr\0a           /\\ TNext\0a           /\\ HCnxt => t \\geq SecondsPerHour - Rho\0a           /\\ t\' \\leq  SecondsPerHour + Rho\0a\0aBigNextX == \0a           /\\ NowNext \\/ now\'=now\0a           /\\ HCnxt \\/ hr\'=hr\0a           /\\ TNext\0a           /\\ HCnxt => t \\geq SecondsPerHour - Rho\0a           /\\ t\' \\leq  SecondsPerHour + Rho\0a\0aBigInit == /\\ HCini\0a           /\\ t = 0\0a           /\\ now \\in Real \0a\0aFairness == \\A r \\in Real : WF_now(NowNext /\\ (now\'>r))\0a\0aNonZeno == \\A r \\in Real : <>(now \\geq r)\0a\0a\\* ImpliedTemporal == \\A h \\in 1..12 : []<>(hr = h)\0a\0aSpec == BigInit /\\ [][BigNext]_<<hr, now, t>>\\*  /\\ Fairness\0a\0aTypeOK == /\\ now \\in Nat\0a          /\\ hr \\in 1..12\0a\0aI == INSTANCE test63a\0a\0aProperty == I!HC\0a\0aRT == /\\ now \\in Real \0a      /\\ [][NowNext]_now\0a      /\\ \\A r \\in Real : WF_now(NowNext /\\ (now\'>r))\0a\0aErrorTemporal == []((now # 4) => <>[](now # 4))\0a=============================================================================\0a '] ['test63a' '---------------------- MODULE test63a ----------------------\0aEXTENDS Naturals\0aVARIABLE hr\0aHCini  ==  hr \\in (1 .. 12)\0aHCnxt  ==  hr\' = IF hr # 12 THEN hr + 1 ELSE 1\0aHC  ==  HCini /\\ [][HCnxt]_hr\0a--------------------------------------------------------------\0aTHEOREM  HC => []HCini\0a==============================================================\0a']]]
      ['suite/test63a' 'test63a' %accept ~[['test63a' '---------------------- MODULE test63a ----------------------\0aEXTENDS Naturals\0aVARIABLE hr\0aHCini  ==  hr \\in (1 .. 12)\0aHCnxt  ==  hr\' = IF hr # 12 THEN hr + 1 ELSE 1\0aHC  ==  HCini /\\ [][HCnxt]_hr\0a--------------------------------------------------------------\0aTHEOREM  HC => []HCini\0a==============================================================\0a']]]
      ['suite/test64' 'test64' %accept ~[['test64' '-------------------------------- MODULE test64 --------------------------------\0aVARIABLE y   \0a \0aI == INSTANCE test64a WITH x <- y  \0a  \\* Changed from Test64a on 12 June 2014 because that\'s now illegal\0a\0aSpec == I!Spec\0a=======================================================================\0a'] ['test64a' '----------------------- MODULE test64a -----------------------\0aVARIABLE x\0a\0aASet == {r \\in  [{0} -> {0}]  : x}\0a\0aSpec == x = TRUE /\\ [][x\' = (ASet = {})]_x\0a=============================================================\0a ']]]
      ['suite/test64a' 'test64a' %accept ~[['test64a' '----------------------- MODULE test64a -----------------------\0aVARIABLE x\0a\0aASet == {r \\in  [{0} -> {0}]  : x}\0a\0aSpec == x = TRUE /\\ [][x\' = (ASet = {})]_x\0a=============================================================\0a ']]]
      ['suite/test65' 'test65' %accept ~[['test65' '-------------------------------- MODULE test65 --------------------------------\0aEXTENDS test65a\0a \0aI == INSTANCE test65a WITH c <- 42\0aJ == INSTANCE test65a WITH c <- 44\0aASSUME /\\ <<I!foo, J!foo>>  = <<42, 44>>\0a       /\\ foo = c\0a=======================================================================\0a'] ['test65a' '----------------------- MODULE test65a -----------------------\0aCONSTANT c\0a\0abar == c\0afoo == bar\0a=============================================================\0a ']]]
      ['suite/test65a' 'test65a' %accept ~[['test65a' '----------------------- MODULE test65a -----------------------\0aCONSTANT c\0a\0abar == c\0afoo == bar\0a=============================================================\0a ']]]
      ['suite/test7' 'test7' %accept ~[['test7' '--------------- MODULE test7 -------------\0a\0a(* test of Predicate Logic and CHOOSE *)\0a\0aEXTENDS Integers, TLC\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0aInv  ==  \0a\0a  /\\ IF ~ \\E i \\in {1,2,3} : i=2\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF ~ \\exists i \\in {1,2,3} : i=2\0a       THEN Assert(FALSE, "Test 1a Failed")\0a       ELSE Print("Test 1a OK", TRUE)\0a\0a  /\\ IF \\A i \\in {3,3,3,3,2,1} : i=3\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF \\forall i \\in {3,3,3,3,2,1} : i=3\0a       THEN Assert(FALSE, "Test 2a Failed")\0a       ELSE Print("Test 2a OK", TRUE)\0a\0a  /\\ IF \\E i \\in {1,2,3} : FALSE\0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF ~\\A i \\in {1,2,3} : TRUE\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF \\E i \\in {} : TRUE\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF \\exists i \\in {} : TRUE\0a       THEN Assert(FALSE, "Test 5a Failed")\0a       ELSE Print("Test 5a OK", TRUE)\0a\0a  /\\ IF ~\\A i \\in {} : FALSE\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF ~\\forall i \\in {} : FALSE\0a       THEN Assert(FALSE, "Test 6a Failed")\0a       ELSE Print("Test 6a OK", TRUE)\0a\0a  /\\ IF ~\\E <<i, j>> \\in {1,2} \\X {3,4}, \0a             k, l \\in {4, 5}, m \\in {6,7} : i + j + k + l + m = 23\0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF ~\\A <<i, j>> \\in {1,2} \\X {3,4}, \0a        k, l \\in {4, 5}, m \\in {6,7} : i + j + k + l + m > 17\0a       THEN Assert(FALSE, "Test 8 Failed")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF (CHOOSE i \\in {1,2,3} : i > 2) # 3\0a       THEN Assert(FALSE, "Test 9 Failed")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF (CHOOSE i \\in {1,2,3, 4} : i > 2) \\leq 2\0a       THEN Assert(FALSE, "Test 10 Failed")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF <<1, 3>> # CHOOSE <<i, j>> \\in {1,2} \\X {3,4} : (i < 2) /\\ (j = i+2)\0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF ~(\\A i \\in {1,2}, <<j, k>> \\in {3,4} \\X {5, 6}, m, n \\in {7,8} :\0a            i+j+k+m+n \\geq 23)\0a       THEN Assert(FALSE, "Test 12 Failed")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF \\E i \\in {1,2}, <<j, k>> \\in {3,4} \\X {5, 6}, m, n \\in {7,8} :\0a            i+j+k+m+n < 23\0a       THEN Assert(FALSE, "Test 13 Failed")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0a\0a  /\\ IF \\A i \\in CHOOSE j \\in {{Nat}, {Int}} : \\E k \\in j : -1 \\in k :\0a           -4 \\in i\0a       THEN Print("Test 14 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 14 Failed")\0a=========================================\0a\0aThe following test is not expected to work because\0aTLC does not preserve the semantics of CHOOSE\0a\0a  /\\ IF (CHOOSE i \\in {1,2,3, 4} : i > 2) \0a           # (CHOOSE i \\in {4, 1, 3 , 2} : i > 2) \0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a']]]
      ['suite/test8' 'test8' %accept ~[['test8' '--------------- MODULE test8 -------------\0a\0a(* Test of set operators \\cup, \\cap, \\subseteq, \\ *)\0a\0aEXTENDS Integers, TLC, Sequences\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0aInv  ==  \0a\0a  /\\ IF {1, 2, 3} \\cup {3, 4, 5} # 1..5\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF {1, 2, 3} \\cap {3, 4, 5} # {3}\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF -5 \\notin Int \\cup Nat \0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF -5 \\notin Nat \\cup Int\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF {1, 2, 3, 4} \\cap {i \\in Int : i > 2} # {3, 4}\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF {1, 2, 3} \\cap {} # {}\0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF {} \\cap {1, 2, 3} # {}\0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF {1, 2, 3, 4} \\ {i \\in Int : i > 2} # {2, 1}\0a       THEN Assert(FALSE, "Test 8 Failed")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF {1, 2, 3} \\ {} # {3,1,2}\0a       THEN Assert(FALSE, "Test 9 Failed")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF {} \\ {1, 2, 3} # {}\0a       THEN Assert(FALSE, "Test 10 Failed")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF -5 \\in {-5} \\ Int\0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF <<1, 2>> \\in Seq({1,2,3}) \\ Seq({1,2})\0a       THEN Assert(FALSE, "Test 12 Failed")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF <<1, 2>> \\notin Seq({1,2,3}) \0a       THEN Assert(FALSE, "Test 12a Failed")\0a       ELSE Print("Test 12a OK", TRUE)\0a\0a  /\\ IF <<1, 2>> \\notin Seq({1,2,3}) \\cap  Seq({0,1,2})\0a       THEN Assert(FALSE, "Test 13 Failed")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0a  /\\ IF <<1, 2>> \\notin Seq({0,1}) \\cup  Seq({1,2,3}) \0a       THEN Assert(FALSE, "Test 14 Failed")\0a       ELSE Print("Test 14 OK", TRUE)\0a\0a  /\\ IF <<1, 2>> \\in [1..2 ->{1,2,3}] \\ [1..2 ->{1,2}]\0a       THEN Assert(FALSE, "Test 16 Failed")\0a       ELSE Print("Test 16 OK", TRUE)\0a\0a  /\\ IF <<1, 2>> \\notin [1..2 ->{1,2,3}] \0a       THEN Assert(FALSE, "Test 17 Failed")\0a       ELSE Print("Test 17 OK", TRUE)\0a\0a  /\\ IF <<1, 2>> \\notin [1..2 ->{1,2,3}] \\cap  [1..2 ->{0,1,2}]\0a       THEN Assert(FALSE, "Test 18 Failed")\0a       ELSE Print("Test 18 OK", TRUE)\0a\0a  /\\ IF <<1, 2>> \\notin [1..2 ->{0,1}] \\cup [1..2 ->{1,2,3}] \0a       THEN Assert(FALSE, "Test 19 Failed")\0a       ELSE Print("Test 19 OK", TRUE)\0a\0a  /\\ IF ~({1,2,3} \\subseteq Int)\0a       THEN Assert(FALSE, "Test 20 Failed")\0a       ELSE Print("Test 20 OK", TRUE)\0a\0a  /\\ IF {1,2,3} \\subseteq {i \\in Int : i < 3}\0a       THEN Assert(FALSE, "Test 21 Failed")\0a       ELSE Print("Test 21 OK", TRUE)\0a\0a  /\\ IF <<1,2>> \\in ({1,2} \\X Nat) \\cup {<<3,4>>, <<5,6>>}\0a       THEN Print("Test 22 OK", TRUE)\0a       ELSE Assert(FALSE, "Test 22 Failed")\0a\0a=========================================\0a']]]
      ['suite/test9' 'test9' %accept ~[['test9' '--------------- MODULE test9 -------------\0a\0a(* Test of set constructors {x \\in S : P(x)} and {e(x) : x \\in S} *)\0a\0aEXTENDS Integers, TLC, FiniteSets\0a\0aVARIABLE x\0aType == x \\in BOOLEAN\0aInit == x = TRUE\0aNext == UNCHANGED x\0a\0aInv  ==  \0a\0a  /\\ IF {i \\in {1,3,3,3,4} : i > 1} # {4,3}\0a       THEN Assert(FALSE, "Test 1 Failed")\0a       ELSE Print("Test 1 OK", TRUE)\0a\0a  /\\ IF {<<i, j>> \\in {1,2} \\X {2,3} : j > i} # {<<1,2>>, <<1,3>>, <<2,3>>}\0a       THEN Assert(FALSE, "Test 2 Failed")\0a       ELSE Print("Test 2 OK", TRUE)\0a\0a  /\\ IF 2 \\notin {i \\in Int : i > 1}\0a       THEN Assert(FALSE, "Test 3 Failed")\0a       ELSE Print("Test 3 OK", TRUE)\0a\0a  /\\ IF <<3,4>> \\notin {<<i,j>> \\in Int \\X Int : j > i}\0a       THEN Assert(FALSE, "Test 4 Failed")\0a       ELSE Print("Test 4 OK", TRUE)\0a\0a  /\\ IF {i+j+k+l+m  : i, j \\in {1, 2, 3}, \0a                      <<k, l>> \\in {4,5} \\X {6,7}, m \\in {8}} # 20..26\0a       THEN Assert(FALSE, "Test 5 Failed")\0a       ELSE Print("Test 5 OK", TRUE)\0a\0a  /\\ IF 24 \\notin {i+j+k+l+m  : i, j \\in {1, 2, 3}, \0a                                <<k, l>> \\in {4,5} \\X {6,7}, m \\in {8}} \0a       THEN Assert(FALSE, "Test 6 Failed")\0a       ELSE Print("Test 6 OK", TRUE)\0a\0a  /\\ IF {i+j : i \\in {1,2,3}, j \\in {}} # {}\0a       THEN Assert(FALSE, "Test 7 Failed")\0a       ELSE Print("Test 7 OK", TRUE)\0a\0a  /\\ IF {i \\in {} : i > 2} # {}\0a       THEN Assert(FALSE, "Test 8 Failed")\0a       ELSE Print("Test 8 OK", TRUE)\0a\0a  /\\ IF {<<i, j>>  \\in {1,3} \\X {} : i > 2} # {}\0a       THEN Assert(FALSE, "Test 9 Failed")\0a       ELSE Print("Test 9 OK", TRUE)\0a\0a  /\\ IF <<1,2>> \\notin {f \\in UNION {[S -> {1,2,3}] : \0a                          S \\in SUBSET {1,2,3}} : f[2] = 2}\0a       THEN Assert(FALSE, "Test 10 Failed")\0a       ELSE Print("Test 10 OK", TRUE)\0a\0a  /\\ IF Cardinality({f \\in [{1,2,3} -> {1,2,3}] : f[2] > 1}) # 18\0a       THEN Assert(FALSE, "Test 11 Failed")\0a       ELSE Print("Test 11 OK", TRUE)\0a\0a  /\\ IF Cardinality([{1,2,3} -> {1,2,3,4}]) # 64\0a       THEN Assert(FALSE, "Test 12 Failed")\0a       ELSE Print("Test 12 OK", TRUE)\0a\0a  /\\ IF Cardinality([ {5, 5, 5, 3, 5, 2} -> {1, 3, 3, 3} ]) # 8\0a       THEN Assert(FALSE, "Test 13 Failed")\0a       ELSE Print("Test 13 OK", TRUE)\0a\0a  /\\ IF [ {5, 5, 5, 3, 5, 2} -> {1, 3, 3, 3} ] # [{2,3,5} -> {1,3}]\0a       THEN Assert(FALSE, "Test 14 Failed")\0a       ELSE Print("Test 14 OK", TRUE)\0a\0a=========================================\0a']]]
      ['suite/test99' 'test99' %accept ~[['test99' '------------------------------ MODULE test99 -----------------------------\0a(* Test of standard Naturals module.    *)\0a\0aEXTENDS Integers, TLC\0a\0aVARIABLES x\0a\0aInit == x = 0\0a\0aNext == UNCHANGED x\0a\0aInv == \0a(*       /\\ IF  2^10 + 2^10 = 2^11\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed")    \0a\0a       /\\ IF 0^20 = 0\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed")    *)    \0a\0a       /\\ IF 2 - 3 \\notin Nat\0a            THEN Print("Test 3 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")\0a\0a       /\\ IF 123 * 345 = 42435\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4 Failed")\0a\0a       /\\ IF 123 < 124\0a            THEN Print("Test 5 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 5 Failed")\0a\0a       /\\ IF 12345 > 12344\0a            THEN Print("Test 6 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 6 Failed")\0a\0a       /\\ IF 123 \\leq 123\0a            THEN Print("Test 7 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 7 Failed")\0a\0a       /\\ IF 12345 \\geq 12345\0a            THEN Print("Test 8 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 8 Failed")\0a\0a       /\\ IF 123 \\leq 124\0a            THEN Print("Test 9 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 9 Failed")\0a\0a       /\\ IF 12344 \\geq 12333\0a            THEN Print("Test 10 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 10 Failed")\0a\0a       /\\ IF 145939 = 487 * (145939 \\div 487) + (145939 % 487) \0a            THEN Print("Test 11 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 11 Failed")  \0a\0a       /\\ IF 139982 \\div 1 = 139982 \0a            THEN Print("Test 12 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 12 Failed")\0a\0a       /\\ IF 123099 % 1 = 0\0a            THEN Print("Test 13 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 13 Failed")\0a\0a       /\\ IF 0 % 345 = 0\0a            THEN Print("Test 14 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 14 Failed")  \0a\0a       /\\ IF 24 % 9 = 6\0a            THEN Print("Test 15 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 15 Failed")   \0a\0a       /\\ IF 4566799 = 423 * (4566799 \\div 423) + (4566799 % 423)\0a            THEN Print("Test 16 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 16 Failed")    \0a\0a       /\\ IF 2222222 = 18 * (2222222 \\div 18) + (2222222 % 18)\0a            THEN Print("Test 17 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 17 Failed")   \0a\0a       /\\ IF 3 .. 2 = {}\0a            THEN Print("Test 18 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 18 Failed")\0a\0a       /\\ IF 2..4 = {2, 3, 4}\0a            THEN Print("Test 19 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 19 Failed")\0a\0a=============================================================================\0a']]]
      ['suite/test999' 'test999' %accept ~[['test999' '--------------- MODULE test999  -------------\0a\0a(* Test replacement of and by infix operators and overridden operators. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0a\0aCONSTANT P(_,_), _++_ , Plus(_, _), PLen(_)\0a\0aPlusPlus(a, b) == <<a, b>>\0a\0aPRep(a, b) == {a, b}\0a\0aMCSeq(a) == {a}\0a\0aMCCat(a, b) == a + b\0a\0aInit == /\\ x = 1\0a        /\\ IF P(2, x+3) = {2, 4}\0a             THEN Print("Test 1 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 1 Failed")\0a        /\\ IF (2++(x+3)) = <<2, 4>>\0a             THEN Print("Test 2 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 2 Failed")\0a        /\\ IF PLen(<<1, 2, 3>>) = 3\0a             THEN Print("Test 3 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 3 Failed")\0a        /\\ IF Plus(2, x+3) = 6\0a             THEN Print("Test 4 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 4 Failed")\0a        /\\ IF Seq(22) = {22}\0a             THEN Print("Test 5 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 5 Failed")\0a        /\\ IF 1 \\o 2 = 3                          (* Huh???? *)\0a             THEN Print("Test 6 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 6 Failed")\0a        /\\ LET a \\prec b == a < b\0a           IN  IF 1 \\prec 2\0a                 THEN Print("Test 7 OK", TRUE)\0a                 ELSE Assert(FALSE, "Test 7 Failed")\0a\0aNext == UNCHANGED x\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
      ['suite/testa' 'testa' %reject ~[['testa' '------- MODULE testa -----\0a\0aEXTENDS test, Integers\0a\0a==========================\0a'] ['test' '------------- MODULE Foo  --------------\0aEXTENDS Naturals\0a\0aFoo == \\A x \\in {1} : lab(x) :: x = 1\0a\0aBar == Foo!lab(1)\0a\0aASSUME Bar\0a=============================================\0a']]]
      ['suite/testfoo' 'testfoo' %reject ~[['testfoo' '------------- MODULE test  --------------\0aEXTENDS Naturals\0a\0aVARIABLES x\0a\0aInit == x \\in SUBSET (1..32)\0a        \0aNext == x\' = 1\0a=============================================\0a']]]
      ['suite/testt37' 'testt37' %reject ~[['testt37' '---------------------------- MODULE test37 -----------------------------\0aEXTENDS FiniteSets, TLC\0a\0aVARIABLES x\0a\0aInit == x = 0\0aNext == x\'=x\0aInv  ==\0a       /\\ IF IsFiniteSet({"a", "b"})\0a            THEN Print("Test 1 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 1 Failed")\0a\0a       /\\ IF IsFiniteSet({})\0a            THEN Print("Test 2 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 2 Failed")\0a\0a       /\\ IF Cardinality({}) = 0\0a            THEN Print("Test 3 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 3 Failed")\0a\0a       /\\ IF Cardinality({"a", "b"}) = 2\0a            THEN Print("Test 4 OK", TRUE)\0a            ELSE Assert(FALSE, "Test 4 Failed")\0a\0a\0a=============================================================================\0a']]]
      ['symmetry/April20a' 'April20a' %accept ~[['April20a' '----------------------------- MODULE April20a -----------------------------\0aEXTENDS Integers\0a\0aCONSTANT S\0a\0aVARIABLE x, y\0avars == <<x, y>>\0a\0aInit == (x = 0) /\\ (y=0)\0a\0aNext == \\/ /\\ y=0\0a           /\\ y\'=1\0a           /\\ x\' \\in S\0a        \\/ /\\ y=1\0a           /\\ y\'=2\0a           /\\ x\' \\in S \\ {x} \0a        \\/ /\\ y = 2\0a           /\\ y\'=0\0a           /\\ x\' = 0\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aLive == ~ \\A i \\in S : \\E j \\in S \\ {i} : []<><<x\'=i /\\ x=j>>_x\0a=============================================================================\0a']]]
      ['symmetry/April20aMC' 'April20aMC' %accept ~[['April20aMC' '---- MODULE April20aMC ----\0aEXTENDS April20a, TLC\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0am1, m2\0a----\0a\0a\\* MV CONSTANT definitions S\0aconst_146115895642519000 == \0a{m1, m2}\0a----\0a\0a\\* SYMMETRY definition\0asymm_146115895643520000 == \0aPermutations(const_146115895642519000)\0a----\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_146115895644521000 ==\0aSpec\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_146115895645522000 ==\0aLive\0a----\0a\\* NEGATED PROPERTY definition\0aneg_prop_146115895645522000 ==\0a~(Live)\0a----\0a\0aYReturnsToZero == <>(y = 0)\0a\0aTautology == (vars = vars) ~> (vars = vars)\0a=============================================================================\0a'] ['April20a' '----------------------------- MODULE April20a -----------------------------\0aEXTENDS Integers\0a\0aCONSTANT S\0a\0aVARIABLE x, y\0avars == <<x, y>>\0a\0aInit == (x = 0) /\\ (y=0)\0a\0aNext == \\/ /\\ y=0\0a           /\\ y\'=1\0a           /\\ x\' \\in S\0a        \\/ /\\ y=1\0a           /\\ y\'=2\0a           /\\ x\' \\in S \\ {x} \0a        \\/ /\\ y = 2\0a           /\\ y\'=0\0a           /\\ x\' = 0\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aLive == ~ \\A i \\in S : \\E j \\in S \\ {i} : []<><<x\'=i /\\ x=j>>_x\0a=============================================================================\0a']]]
      ['symmetry/April20b' 'April20b' %accept ~[['April20b' '----------------------------- MODULE April20b -----------------------------\0aEXTENDS Integers, Sequences\0a\0aCONSTANT S\0a\0aVARIABLE x, y\0avars == <<x, y>>\0a\0aInit == (x = << >>) /\\ (y=0)\0a\0aNext == \\/ /\\ y=0\0a           /\\ y\'=1\0a           /\\ \\E s \\in S : x\' = <<s>>\0a        \\/ /\\ y=1\0a           /\\ y\'=2\0a           /\\ \\E s \\in S \\ {x[1]} : x\' = Append(x, s) \0a        \\/ /\\ y = 2\0a           /\\ y\'=0\0a           /\\ x\' = << >>\0a\0aSpec == Init /\\ [][Next]_vars\0a\0aLive == ~ \\A i \\in S : \\E j \\in S \\ {i} : []<>(x = <<i, j>>)\0a=============================================================================\0a']]]
