       endLine |-> 13,\0a\09\09\09\09                   endColumn |-> 18,\0a\09\09\09\09                   module |-> "CodeplexBug8" ] ],\0a\09\09\09\09           <<8, [x |-> 5, b |-> TRUE]>> >>,\0a\09\09\09\09        << <<8, [x |-> 5, b |-> TRUE]>>,\0a\09\09\09\09           [ name |-> "B",\0a\09\09\09\09             location |->\0a\09\09\09\09                 [ beginLine |-> 11,\0a\09\09\09\09                   beginColumn |-> 6,\0a\09\09\09\09                   endLine |-> 13,\0a\09\09\09\09                   endColumn |-> 18,\0a\09\09\09\09                   module |-> "CodeplexBug8" ] ],\0a\09\09\09\09           <<8, [x |-> 5, b |-> TRUE]>> >> } ]\0a\09      /\\ ToTrace(CounterExample) =\0a\09\09    \09      << [x |-> 1, b |-> FALSE],\0a\09\09\09\09\09   [x |-> 2, b |-> TRUE],\0a\09\09\09\09\09   [x |-> 2, b |-> FALSE],\0a\09\09\09\09\09   [x |-> 3, b |-> TRUE],\0a\09\09\09\09\09   [x |-> 3, b |-> FALSE],\0a\09\09\09\09\09   [x |-> 4, b |-> TRUE],\0a\09\09\09\09\09   [x |-> 4, b |-> FALSE],\0a\09\09\09\09\09   [x |-> 5, b |-> TRUE] >> \0a\0aXEventuallyGrows == <>(x >= 4)\0a\0aTautology == (x = x) ~> (x = x)\0a=============================================================================\0a\\* Modification History\0a\\* Created Wed Mar 25 21:34:22 CET 2015 by markus\0a'] ['CodeplexBug8' '---------------------------- MODULE CodeplexBug8 ----------------------------\0aEXTENDS Naturals\0a\0aVARIABLES x, b\0a\0aA == /\\ x < 5\0a     /\\ b\0a     /\\ b\' = ~b\0a     /\\ UNCHANGED x\0a\0aB == /\\ ~b\0a     /\\ b\' = ~b\0a     /\\ x\' = x + 1\0a\0aInit == x \\in 0..3 /\\ b \\in BOOLEAN\0a\0aNext == A \\/ B\0a\0aSpec == Init /\\ [][Next]_<<x, b>> /\\ WF_<<x, b>>(Next)\0a\0a--------------------------------------------------------------------------------\0a\0aXshrinks == x=2 ~> x=1\0a\0a================================================================================']]]
      ['DoInitFunctor/DoInitFunctorEvalException' 'DoInitFunctorEvalException' %accept ~[['DoInitFunctorEvalException' '--------------------------- MODULE DoInitFunctorEvalException ---------------------------\0aEXTENDS Integers\0a\0aVARIABLES x\0avars == <<x>>\0a\0aInit == x \\in 1..10\0a\0aNext == x\' = 0\0a\0aSpec == Init /\\ [][Next]_vars\0a\0a(* This function is used as a model constraint to trigger an EvalException (because it doesn\'t return Bool) *)\0aF(a) == {}\0aconst_4711 == F(x)\0a\0a(* This property is violated by one of the init states *)\0aNotNine == x # 9 \0a=============================================================================\0a']]]
