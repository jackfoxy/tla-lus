      ['suite/test999' 'test999' %accept ~[['test999' '--------------- MODULE test999  -------------\0a\0a(* Test replacement of and by infix operators and overridden operators. *)\0a\0aEXTENDS TLC, Naturals, Sequences\0a\0aVARIABLE x\0a\0aCONSTANT P(_,_), _++_ , Plus(_, _), PLen(_)\0a\0aPlusPlus(a, b) == <<a, b>>\0a\0aPRep(a, b) == {a, b}\0a\0aMCSeq(a) == {a}\0a\0aMCCat(a, b) == a + b\0a\0aInit == /\\ x = 1\0a        /\\ IF P(2, x+3) = {2, 4}\0a             THEN Print("Test 1 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 1 Failed")\0a        /\\ IF (2++(x+3)) = <<2, 4>>\0a             THEN Print("Test 2 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 2 Failed")\0a        /\\ IF PLen(<<1, 2, 3>>) = 3\0a             THEN Print("Test 3 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 3 Failed")\0a        /\\ IF Plus(2, x+3) = 6\0a             THEN Print("Test 4 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 4 Failed")\0a        /\\ IF Seq(22) = {22}\0a             THEN Print("Test 5 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 5 Failed")\0a        /\\ IF 1 \\o 2 = 3                          (* Huh???? *)\0a             THEN Print("Test 6 OK", TRUE)\0a             ELSE Assert(FALSE, "Test 6 Failed")\0a        /\\ LET a \\prec b == a < b\0a           IN  IF 1 \\prec 2\0a                 THEN Print("Test 7 OK", TRUE)\0a                 ELSE Assert(FALSE, "Test 7 Failed")\0a\0aNext == UNCHANGED x\0a\0aInv ==  TRUE\0a\0a=========================================\0a']]]
