  :~
      ['symmetry/May09' 'May09' %accept ~[['May09' '------------------------- MODULE May09 -------------------------\0aEXTENDS Integers\0aCONSTANT S\0a\0aVARIABLES x,y\0avars == <<x,y>>\0a\0aInit == x \\in S /\\ y = 0\0a\0aNextA == /\\ y = 0\0a         /\\ y\' = 1\0a         /\\ x\' = x\0a\0aNextB == /\\ y >= 1\0a         /\\ y < 5\0a         /\\ y\' = y + 1\0a         /\\ x\' = x\0a         \0aNextC == /\\ y = 5\0a         /\\ y\' = 1\0a         /\\ x\' = x\0aSpec == Init /\\ [][NextA \\/ NextB \\/ NextC]_vars /\\ WF_vars(NextA \\/ NextB \\/ NextC)\0a\0aNextD == /\\ y = 5\0a         /\\ y\' = 1\0a         /\\ \\E i \\in (S \\ {x}) : x\' = i\0aSpecD == Init /\\ [][NextA \\/ NextB \\/ NextD]_vars /\\ WF_vars(NextA \\/ NextB \\/ NextD)\0a\0a=============================================================================\0a']]]
      ['symmetry/May09MC' 'May09MC' %accept ~[['May09MC' '---- MODULE May09MC ----\0aEXTENDS May09, TLC\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0aa, b\0a----\0a\0a\\* MV CONSTANT definitions S\0aconst_146183936175119000 == \0a{a, b}\0a----\0a\0a\\* SYMMETRY definition\0asymm_146183936176120000 == \0aPermutations(const_146183936175119000)\0a----\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_146183936177121000 ==\0aSpec\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_146183936178122000 ==\0a[]<>(x=a) /\\ []<>(x=b)\0a----\0a\\* NEGATED PROPERTY definition\0aneg_prop_146183936178122000 ==\0a~([]<>(x=a) /\\ []<>(x=b))\0a----\0a\0aYOneInfOften == []<>(y = 1)\0a\0aTautology == (vars = vars) ~> (vars = vars)\0a=============================================================================\0a'] ['May09' '------------------------- MODULE May09 -------------------------\0aEXTENDS Integers\0aCONSTANT S\0a\0aVARIABLES x,y\0avars == <<x,y>>\0a\0aInit == x \\in S /\\ y = 0\0a\0aNextA == /\\ y = 0\0a         /\\ y\' = 1\0a         /\\ x\' = x\0a\0aNextB == /\\ y >= 1\0a         /\\ y < 5\0a         /\\ y\' = y + 1\0a         /\\ x\' = x\0a         \0aNextC == /\\ y = 5\0a         /\\ y\' = 1\0a         /\\ x\' = x\0aSpec == Init /\\ [][NextA \\/ NextB \\/ NextC]_vars /\\ WF_vars(NextA \\/ NextB \\/ NextC)\0a\0aNextD == /\\ y = 5\0a         /\\ y\' = 1\0a         /\\ \\E i \\in (S \\ {x}) : x\' = i\0aSpecD == Init /\\ [][NextA \\/ NextB \\/ NextD]_vars /\\ WF_vars(NextA \\/ NextB \\/ NextD)\0a\0a=============================================================================\0a']]]
      ['symmetry/May09dMC' 'May09dMC' %accept ~[['May09dMC' '---- MODULE May09dMC ----\0aEXTENDS May09, TLC\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0aa, b\0a----\0a\0a\\* MV CONSTANT definitions S\0aconst_146183936175119000 == \0a{a, b}\0a----\0a\0a\\* SYMMETRY definition\0asymm_146183936176120000 == \0aPermutations(const_146183936175119000)\0a----\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_146183936177121000 ==\0aSpecD\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_146183936178122000 ==\0a[]<>(x=a) /\\ []<>(x=b)\0a----\0a=============================================================================\0a'] ['May09' '------------------------- MODULE May09 -------------------------\0aEXTENDS Integers\0aCONSTANT S\0a\0aVARIABLES x,y\0avars == <<x,y>>\0a\0aInit == x \\in S /\\ y = 0\0a\0aNextA == /\\ y = 0\0a         /\\ y\' = 1\0a         /\\ x\' = x\0a\0aNextB == /\\ y >= 1\0a         /\\ y < 5\0a         /\\ y\' = y + 1\0a         /\\ x\' = x\0a         \0aNextC == /\\ y = 5\0a         /\\ y\' = 1\0a         /\\ x\' = x\0aSpec == Init /\\ [][NextA \\/ NextB \\/ NextC]_vars /\\ WF_vars(NextA \\/ NextB \\/ NextC)\0a\0aNextD == /\\ y = 5\0a         /\\ y\' = 1\0a         /\\ \\E i \\in (S \\ {x}) : x\' = i\0aSpecD == Init /\\ [][NextA \\/ NextB \\/ NextD]_vars /\\ WF_vars(NextA \\/ NextB \\/ NextD)\0a\0a=============================================================================\0a']]]
      ['symmetry/NQ/MC' 'MC' %accept ~[['MC' '---- MODULE MC ----\0aEXTENDS NQSpec, TLC\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0ae1, e2\0a----\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0ai1, i2\0a----\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0ad1\0a----\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0av1, v2\0a----\0a\0a\\* MV CONSTANT definitions EnQers\0aconst_14467714432321108000 == \0a{e1, e2}\0a----\0a\0a\\* MV CONSTANT definitions Ids\0aconst_14467714432421109000 == \0a{i1, i2}\0a----\0a\0a\\* MV CONSTANT definitions DeQers\0aconst_14467714432521110000 == \0a{d1}\0a----\0a\0a\\* MV CONSTANT definitions Data\0aconst_14467714432621111000 == \0a{v1, v2}\0a----\0a\0a\\* SYMMETRY definition\0asymm_14467714432721112000 == \0aPermutations(const_14467714432321108000) \\union Permutations(const_14467714432521110000)\0a----\0a\0a\\* CONSTANT definitions @modelParameterConstants:4InitData\0aconst_14467714432821113000 == \0av1\0a----\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_14467714433421119000 ==\0aSpec\0a----\0a\\* INVARIANT definition @modelCorrectnessInvariants:0\0ainv_14467714433521120000 ==\0aTypeOK\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_14467714433621121000 ==\0a(\\E e \\in elts : e.data = v2) ~> (\\E d \\in DeQers : deq[d] = v2)\0a----\0a=============================================================================\0a\\* Modification History\0a\\* Created Thu Nov 05 16:57:23 PST 2015 by lamport\0a'] ['NQSpec' '------------------------------- MODULE NQSpec -------------------------------\0aEXTENDS Integers, Sequences\0a\0aCONSTANTS EnQers, DeQers, Data, InitData, Ids\0a\0aASSUME InitData \\in Data\0a\0aDone == CHOOSE D : D \\notin Data\0aBusy == CHOOSE D : D \\notin Data\0aNotAnId == CHOOSE i : i \\notin Ids\0aNotData == CHOOSE D : D \\notin Data\0aElements == [data : Data, id : Ids]\0aNotAnElement == CHOOSE E : E \\notin Elements\0a\0aVARIABLES enq, deq, elts, after, adding\0avars == <<enq, deq, elts, after, adding>>\0a\0a\0a\0aTypeOK == /\\ enq \\in [EnQers -> Data \\cup {Done}]\0a          /\\ deq \\in [DeQers -> Data \\cup {Busy}]\0a          /\\ elts \\in SUBSET Elements\0a          /\\ after \\in [elts -> SUBSET elts]\0a          /\\ adding \\in [EnQers -> Elements \\cup {NotAnElement}]\0a\0aInit == /\\ enq = [e \\in EnQers |-> Done]\0a        /\\ deq = [d \\in DeQers |-> InitData]\0a        /\\ elts = {}\0a        /\\ after = << >>\0a        /\\ adding = [e \\in EnQers |-> NotAnElement]\0a-----------------------------------------------------------------------------\0a\0aAssign(var, idx, val) == var\' = [var EXCEPT ![idx] = val]\0a\0aUnusedIds == Ids \\ {el.id : el \\in elts}\0a\0aAddElt(el) == \0a  /\\ elts\' = elts \\cup {el}\0a  /\\ after\' = [x \\in elts\' |-> \0a                 IF x = el THEN elts \\ {adding[e] : e \\in EnQers}\0a                           ELSE after[x] ]\0a                           \0aRemoveElt(el) == \0a  /\\ elts\' = elts \\ {el}\0a  /\\ after\' = [x \\in elts\' |-> after[x] \\ {el}]\0a\0aminimalElts == {el \\in elts : after[el] = {}}\0a      \0aBeginEnq(e) == /\\ enq[e] = Done \0a               /\\ \\E D \\in Data, id \\in UnusedIds : \0a                     LET el == [data |-> D, id |-> id]\0a                     IN  /\\ Assign(enq, e, D)\0a                         /\\ AddElt(el)\0a                         /\\ Assign(adding, e, el)\0a               /\\ UNCHANGED deq\0a                           \0aEndEnq(e) == /\\ enq[e] # Done\0a             /\\ Assign(enq, e, Done)\0a             /\\ Assign(adding, e, NotAnElement)\0a             /\\ UNCHANGED <<deq, elts, after>>\0a\0a\\*  enq, deq, elts, after, adding\0aBeginDeq(d) == /\\ deq[d] # Busy\0a               /\\ Assign(deq, d, Busy)\0a               /\\ UNCHANGED <<enq, elts, after, adding>>\0a               \0aEndDeq(d) == /\\ deq[d] = Busy\0a             /\\ \\E el \\in minimalElts :\0a                  /\\ RemoveElt(el)\0a                  /\\ Assign(deq, d, el.data)\0a             /\\ UNCHANGED <<enq, adding>>\0a             \0aNext == \\/ \\E e \\in EnQers : BeginEnq(e)  \\/ EndEnq(e)\0a        \\/ \\E d \\in DeQers : BeginDeq(d)  \\/ EndDeq(d)\0a\0aLiveness == /\\ \\A e \\in EnQers : WF_vars(BeginEnq(e)  \\/ EndEnq(e))\0a            /\\ \\A d \\in DeQers :  WF_vars(BeginDeq(d)  \\/ EndDeq(d))\0a            \0aSpec == Init /\\ [][Next]_vars /\\ Liveness\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Thu Nov 05 16:16:15 PST 2015 by lamport\0a\\* Created Thu Nov 05 15:07:25 PST 2015 by lamport\0a']]]
      ['symmetry/NQ/MCa' 'MCa' %accept ~[['MCa' '---- MODULE MCa ----\0aEXTENDS NQSpec, TLC\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0ae1, e2\0a----\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0ai1, i2\0a----\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0ad1\0a----\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0av1, v2\0a----\0a\0a\\* MV CONSTANT definitions EnQers\0aconst_14467710209401026000 == \0a{e1, e2}\0a----\0a\0a\\* MV CONSTANT definitions Ids\0aconst_14467710209501027000 == \0a{i1, i2}\0a----\0a\0a\\* MV CONSTANT definitions DeQers\0aconst_14467710209601028000 == \0a{d1}\0a----\0a\0a\\* MV CONSTANT definitions Data\0aconst_14467710209701029000 == \0a{v1, v2}\0a----\0a\0a\\* SYMMETRY definition\0asymm_14467710209801030000 == \0aPermutations(const_14467710209401026000) \\union Permutations(const_14467710209601028000)\0a----\0a\0a\\* CONSTANT definitions @modelParameterConstants:4InitData\0aconst_14467710209901031000 == \0av1\0a----\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_14467710210501037000 ==\0aSpec\0a----\0a\\* INVARIANT definition @modelCorrectnessInvariants:0\0ainv_14467710210601038000 ==\0aTypeOK\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_14467710210701039000 ==\0a(\\E e \\in EnQers : enq[e] = v2) ~> (\\E d \\in DeQers : deq[d] = v2)\0a----\0a\\* NEGATED PROPERTY definition\0aneg_prop_14467710210701039000 ==\0a~((\\E e \\in EnQers : enq[e] = v2) ~> (\\E d \\in DeQers : deq[d] = v2))\0a----\0a\0aEnqueueCompletes == \\A e \\in EnQers : (enq[e] # Done) ~> (enq[e] = Done)\0a\0aTautology == (vars = vars) ~> (vars = vars)\0a=============================================================================\0a\\* Modification History\0a\\* Created Thu Nov 05 16:50:21 PST 2015 by lamport\0a'] ['NQSpec' '------------------------------- MODULE NQSpec -------------------------------\0aEXTENDS Integers, Sequences\0a\0aCONSTANTS EnQers, DeQers, Data, InitData, Ids\0a\0aASSUME InitData \\in Data\0a\0aDone == CHOOSE D : D \\notin Data\0aBusy == CHOOSE D : D \\notin Data\0aNotAnId == CHOOSE i : i \\notin Ids\0aNotData == CHOOSE D : D \\notin Data\0aElements == [data : Data, id : Ids]\0aNotAnElement == CHOOSE E : E \\notin Elements\0a\0aVARIABLES enq, deq, elts, after, adding\0avars == <<enq, deq, elts, after, adding>>\0a\0a\0a\0aTypeOK == /\\ enq \\in [EnQers -> Data \\cup {Done}]\0a          /\\ deq \\in [DeQers -> Data \\cup {Busy}]\0a          /\\ elts \\in SUBSET Elements\0a          /\\ after \\in [elts -> SUBSET elts]\0a          /\\ adding \\in [EnQers -> Elements \\cup {NotAnElement}]\0a\0aInit == /\\ enq = [e \\in EnQers |-> Done]\0a        /\\ deq = [d \\in DeQers |-> InitData]\0a        /\\ elts = {}\0a        /\\ after = << >>\0a        /\\ adding = [e \\in EnQers |-> NotAnElement]\0a-----------------------------------------------------------------------------\0a\0aAssign(var, idx, val) == var\' = [var EXCEPT ![idx] = val]\0a\0aUnusedIds == Ids \\ {el.id : el \\in elts}\0a\0aAddElt(el) == \0a  /\\ elts\' = elts \\cup {el}\0a  /\\ after\' = [x \\in elts\' |-> \0a                 IF x = el THEN elts \\ {adding[e] : e \\in EnQers}\0a                           ELSE after[x] ]\0a                           \0aRemoveElt(el) == \0a  /\\ elts\' = elts \\ {el}\0a  /\\ after\' = [x \\in elts\' |-> after[x] \\ {el}]\0a\0aminimalElts == {el \\in elts : after[el] = {}}\0a      \0aBeginEnq(e) == /\\ enq[e] = Done \0a               /\\ \\E D \\in Data, id \\in UnusedIds : \0a                     LET el == [data |-> D, id |-> id]\0a                     IN  /\\ Assign(enq, e, D)\0a                         /\\ AddElt(el)\0a                         /\\ Assign(adding, e, el)\0a               /\\ UNCHANGED deq\0a                           \0aEndEnq(e) == /\\ enq[e] # Done\0a             /\\ Assign(enq, e, Done)\0a             /\\ Assign(adding, e, NotAnElement)\0a             /\\ UNCHANGED <<deq, elts, after>>\0a\0a\\*  enq, deq, elts, after, adding\0aBeginDeq(d) == /\\ deq[d] # Busy\0a               /\\ Assign(deq, d, Busy)\0a               /\\ UNCHANGED <<enq, elts, after, adding>>\0a               \0aEndDeq(d) == /\\ deq[d] = Busy\0a             /\\ \\E el \\in minimalElts :\0a                  /\\ RemoveElt(el)\0a                  /\\ Assign(deq, d, el.data)\0a             /\\ UNCHANGED <<enq, adding>>\0a             \0aNext == \\/ \\E e \\in EnQers : BeginEnq(e)  \\/ EndEnq(e)\0a        \\/ \\E d \\in DeQers : BeginDeq(d)  \\/ EndDeq(d)\0a\0aLiveness == /\\ \\A e \\in EnQers : WF_vars(BeginEnq(e)  \\/ EndEnq(e))\0a            /\\ \\A d \\in DeQers :  WF_vars(BeginDeq(d)  \\/ EndDeq(d))\0a            \0aSpec == Init /\\ [][Next]_vars /\\ Liveness\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Thu Nov 05 16:16:15 PST 2015 by lamport\0a\\* Created Thu Nov 05 15:07:25 PST 2015 by lamport\0a']]]
      ['symmetry/NQ/NQSpec' 'NQSpec' %accept ~[['NQSpec' '------------------------------- MODULE NQSpec -------------------------------\0aEXTENDS Integers, Sequences\0a\0aCONSTANTS EnQers, DeQers, Data, InitData, Ids\0a\0aASSUME InitData \\in Data\0a\0aDone == CHOOSE D : D \\notin Data\0aBusy == CHOOSE D : D \\notin Data\0aNotAnId == CHOOSE i : i \\notin Ids\0aNotData == CHOOSE D : D \\notin Data\0aElements == [data : Data, id : Ids]\0aNotAnElement == CHOOSE E : E \\notin Elements\0a\0aVARIABLES enq, deq, elts, after, adding\0avars == <<enq, deq, elts, after, adding>>\0a\0a\0a\0aTypeOK == /\\ enq \\in [EnQers -> Data \\cup {Done}]\0a          /\\ deq \\in [DeQers -> Data \\cup {Busy}]\0a          /\\ elts \\in SUBSET Elements\0a          /\\ after \\in [elts -> SUBSET elts]\0a          /\\ adding \\in [EnQers -> Elements \\cup {NotAnElement}]\0a\0aInit == /\\ enq = [e \\in EnQers |-> Done]\0a        /\\ deq = [d \\in DeQers |-> InitData]\0a        /\\ elts = {}\0a        /\\ after = << >>\0a        /\\ adding = [e \\in EnQers |-> NotAnElement]\0a-----------------------------------------------------------------------------\0a\0aAssign(var, idx, val) == var\' = [var EXCEPT ![idx] = val]\0a\0aUnusedIds == Ids \\ {el.id : el \\in elts}\0a\0aAddElt(el) == \0a  /\\ elts\' = elts \\cup {el}\0a  /\\ after\' = [x \\in elts\' |-> \0a                 IF x = el THEN elts \\ {adding[e] : e \\in EnQers}\0a                           ELSE after[x] ]\0a                           \0aRemoveElt(el) == \0a  /\\ elts\' = elts \\ {el}\0a  /\\ after\' = [x \\in elts\' |-> after[x] \\ {el}]\0a\0aminimalElts == {el \\in elts : after[el] = {}}\0a      \0aBeginEnq(e) == /\\ enq[e] = Done \0a               /\\ \\E D \\in Data, id \\in UnusedIds : \0a                     LET el == [data |-> D, id |-> id]\0a                     IN  /\\ Assign(enq, e, D)\0a                         /\\ AddElt(el)\0a                         /\\ Assign(adding, e, el)\0a               /\\ UNCHANGED deq\0a                           \0aEndEnq(e) == /\\ enq[e] # Done\0a             /\\ Assign(enq, e, Done)\0a             /\\ Assign(adding, e, NotAnElement)\0a             /\\ UNCHANGED <<deq, elts, after>>\0a\0a\\*  enq, deq, elts, after, adding\0aBeginDeq(d) == /\\ deq[d] # Busy\0a               /\\ Assign(deq, d, Busy)\0a               /\\ UNCHANGED <<enq, elts, after, adding>>\0a               \0aEndDeq(d) == /\\ deq[d] = Busy\0a             /\\ \\E el \\in minimalElts :\0a                  /\\ RemoveElt(el)\0a                  /\\ Assign(deq, d, el.data)\0a             /\\ UNCHANGED <<enq, adding>>\0a             \0aNext == \\/ \\E e \\in EnQers : BeginEnq(e)  \\/ EndEnq(e)\0a        \\/ \\E d \\in DeQers : BeginDeq(d)  \\/ EndDeq(d)\0a\0aLiveness == /\\ \\A e \\in EnQers : WF_vars(BeginEnq(e)  \\/ EndEnq(e))\0a            /\\ \\A d \\in DeQers :  WF_vars(BeginDeq(d)  \\/ EndDeq(d))\0a            \0aSpec == Init /\\ [][Next]_vars /\\ Liveness\0a\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Thu Nov 05 16:16:15 PST 2015 by lamport\0a\\* Created Thu Nov 05 15:07:25 PST 2015 by lamport\0a']]]
      ['symmetry/NoSymmetryLivenessTableauMC' 'NoSymmetryLivenessTableauMC' %accept ~[['NoSymmetryLivenessTableauMC' '---- MODULE NoSymmetryLivenessTableauMC ----\0aEXTENDS SymmetryLivenessTableau, TLC\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0aa, b\0a----\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0ac, d\0a----\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0ae, f\0a----\0a\0a\\* MV CONSTANT definitions Val\0aconst_144172196716899000 == \0a{a, b}\0a----\0a\0a\\* MV CONSTANT definitions Proc\0aconst_1441721967178100000 == \0a{c, d}\0a----\0a\0a\\* MV CONSTANT definitions Adr\0aconst_1441721967189101000 == \0a{e, f}\0a----\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_1441721967209103000 ==\0aSpec\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_1441721967219104000 ==\0aLiveness\0a----\0a=============================================================================\0a'] ['SymmetryLivenessTableau' '---------------------- MODULE SymmetryLivenessTableau ----------------------\0aVARIABLES mem, ctl, buf\0aVARIABLE memInt\0aCONSTANTS  Proc,  \0a           Adr,  \0a           Val\0a\0aNoVal == CHOOSE x : x \\notin Val \0aInitMemInt == {<<p, NoVal>> : p \\in Proc}\0aSend(p, d, oldMemInt, newMemInt)  ==  newMemInt = <<p, d>>\0aReply(p, d, oldMemInt, newMemInt) ==  newMemInt = <<p, d>>\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0a--------------------------------------------------------------\0aIInit == /\\ mem \\in [Adr->Val]\0a         /\\ ctl = [p \\in Proc |-> "rdy"] \0a         /\\ buf = [p \\in Proc |-> NoVal] \0a         /\\ memInt \\in InitMemInt\0a\0aTypeInvariant == \0a  /\\ mem \\in [Adr->Val]\0a  /\\ ctl \\in [Proc -> {"rdy", "busy","done"}] \0a  /\\ buf \\in [Proc -> MReq \\cup Val \\cup {NoVal}]\0a\0aReq(p) == /\\ ctl[p] = "rdy" \0a          /\\ \\E req \\in  MReq :\0a                /\\ Send(p, req, memInt, memInt\')\0a                /\\ buf\' = [buf EXCEPT ![p] = req]\0a                /\\ ctl\' = [ctl EXCEPT ![p] = "busy"]\0a          /\\ UNCHANGED mem \0a\0aDo(p) == \0a  /\\ ctl[p] = "busy" \0a  /\\ mem\' = IF buf[p].op = "Wr"\0a              THEN [mem EXCEPT ![buf[p].adr] = buf[p].val] \0a              ELSE mem \0a  /\\ buf\' = [buf EXCEPT ![p] = IF buf[p].op = "Wr"\0a                                  THEN NoVal\0a                                  ELSE mem[buf[p].adr]]\0a  /\\ ctl\' = [ctl EXCEPT ![p] = "done"] \0a  /\\ UNCHANGED memInt \0a\0aRsp(p) == /\\ ctl[p] = "done"\0a          /\\ Reply(p, buf[p], memInt, memInt\')\0a          /\\ ctl\' = [ctl EXCEPT ![p]= "rdy"]\0a          /\\ UNCHANGED <<mem, buf>> \0a\0aINext == \\E p \\in Proc: Req(p) \\/ Do(p) \\/ Rsp(p) \0a\0aSpec == IInit  /\\  [][INext]_<<memInt, mem, ctl, buf>>\0a             /\\ \\A p \\in Proc : WF_<<memInt, mem, ctl, buf>>(Do(p) \\/ Rsp(p))\0a \0aLiveness == \\A p \\in Proc : (ctl[p] = "busy") ~> (ctl[p] = "rdy")\0a--------------------------------------------------------------\0aTHEOREM Spec => []TypeInvariant\0a==============================================================']]]
      ['symmetry/OneBitMutex/OneBitMutexMC' 'OneBitMutexMC' %accept ~[['OneBitMutexMC' '---- MODULE OneBitMutexMC ----\0aEXTENDS OneBitMutex, TLC\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0aA, B\0a----\0a\0a\\* MV CONSTANT definitions Procs\0aconst_144491423291817000 == \0a{A, B}\0a----\0a\0a\\* SYMMETRY definition\0asymm_144481269487927000 == \0aPermutations(const_144491423291817000)\0a----\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_144491423292818000 ==\0aSpec\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_144491423293819000 ==\0aStarvationFreedom\0a----\0a\\* NEGATED PROPERTY definition\0aneg_prop_144491423293819000 ==\0a~(StarvationFreedom)\0a----\0a\0aCriticalSectionExits == \\A e \\in Procs : (pc[e] = "cs") ~> (pc[e] = "ncs")\0a\0aTautology == (vars = vars) ~> (vars = vars)\0a=============================================================================\0a'] ['OneBitMutex' '---------------------------- MODULE OneBitMutex ----------------------------\0aEXTENDS Integers\0aCONSTANT Procs\0a\0a(***************************************************************************\0a--algorithm OneBitMutex\0a    { \0a        variable x = [i \\in Procs |-> FALSE];\0a        fair process (p \\in Procs)\0a            variables unchecked = {};\0a            other \\in Procs ;\0a            { \0a                ncs:- while (TRUE)\0a                {\0a                e1: x[self] := TRUE ;\0a                    unchecked := Procs \\ {self};\0a                e2: while (unchecked # {})\0a                        {\0a                        with (i \\in unchecked) { other := i } ;\0a                        unchecked := unchecked \\ {other};\0a                    e3: if (x[other])\0a                        { \0a                            if (TRUE) \\* Changed from "self > other" to "TRUE"\0a                            { \0a                            e4: x[self] := FALSE;\0a                            e5: await ~x[other];\0a                                goto e1;\0a                            }\0a                            else\0a                            { \0a                            e6: await ~x[other];\0a                            }\0a                        };\0a                    } ;\0a                cs: skip;\0a                f: x[self] := FALSE\0a            }\0a    }\0a}\0a ***************************************************************************)\0a\0a\\* BEGIN TRANSLATION\0aVARIABLES x, pc, unchecked, other\0a\0avars == << x, pc, unchecked, other >>\0a\0aProcSet == (Procs)\0a\0aInit == (* Global variables *)\0a        /\\ x = [i \\in Procs |-> FALSE]\0a        (* Process p *)\0a        /\\ unchecked = [self \\in Procs |-> {}]\0a        /\\ other \\in [Procs -> Procs]\0a        /\\ pc = [self \\in ProcSet |-> "ncs"]\0a\0ancs(self) == /\\ pc[self] = "ncs"\0a             /\\ pc\' = [pc EXCEPT ![self] = "e1"]\0a             /\\ UNCHANGED << x, unchecked, other >>\0a\0ae1(self) == /\\ pc[self] = "e1"\0a            /\\ x\' = [x EXCEPT ![self] = TRUE]\0a            /\\ unchecked\' = [unchecked EXCEPT ![self] = Procs \\ {self}]\0a            /\\ pc\' = [pc EXCEPT ![self] = "e2"]\0a            /\\ other\' = other\0a\0ae2(self) == /\\ pc[self] = "e2"\0a            /\\ IF unchecked[self] # {}\0a                  THEN /\\ \\E i \\in unchecked[self]:\0a                            other\' = [other EXCEPT ![self] = i]\0a                       /\\ unchecked\' = [unchecked EXCEPT ![self] = unchecked[self] \\ {other\'[self]}]\0a                       /\\ pc\' = [pc EXCEPT ![self] = "e3"]\0a                  ELSE /\\ pc\' = [pc EXCEPT ![self] = "cs"]\0a                       /\\ UNCHANGED << unchecked, other >>\0a            /\\ x\' = x\0a\0ae3(self) == /\\ pc[self] = "e3"\0a            /\\ IF x[other[self]]\0a                  THEN /\\ IF TRUE\0a                             THEN /\\ pc\' = [pc EXCEPT ![self] = "e4"]\0a                             ELSE /\\ pc\' = [pc EXCEPT ![self] = "e6"]\0a                  ELSE /\\ pc\' = [pc EXCEPT ![self] = "e2"]\0a            /\\ UNCHANGED << x, unchecked, other >>\0a\0ae4(self) == /\\ pc[self] = "e4"\0a            /\\ x\' = [x EXCEPT ![self] = FALSE]\0a            /\\ pc\' = [pc EXCEPT ![self] = "e5"]\0a            /\\ UNCHANGED << unchecked, other >>\0a\0ae5(self) == /\\ pc[self] = "e5"\0a            /\\ ~x[other[self]]\0a            /\\ pc\' = [pc EXCEPT ![self] = "e1"]\0a            /\\ UNCHANGED << x, unchecked, other >>\0a\0ae6(self) == /\\ pc[self] = "e6"\0a            /\\ ~x[other[self]]\0a            /\\ pc\' = [pc EXCEPT ![self] = "e2"]\0a            /\\ UNCHANGED << x, unchecked, other >>\0a\0acs(self) == /\\ pc[self] = "cs"\0a            /\\ TRUE\0a            /\\ pc\' = [pc EXCEPT ![self] = "f"]\0a            /\\ UNCHANGED << x, unchecked, other >>\0a\0af(self) == /\\ pc[self] = "f"\0a           /\\ x\' = [x EXCEPT ![self] = FALSE]\0a           /\\ pc\' = [pc EXCEPT ![self] = "ncs"]\0a           /\\ UNCHANGED << unchecked, other >>\0a\0ap(self) == ncs(self) \\/ e1(self) \\/ e2(self) \\/ e3(self) \\/ e4(self)\0a              \\/ e5(self) \\/ e6(self) \\/ cs(self) \\/ f(self)\0a\0aNext == (\\E self \\in Procs: p(self))\0a\0aSpec == /\\ Init /\\ [][Next]_vars\0a        /\\ \\A self \\in Procs : WF_vars((pc[self] # "ncs") /\\ p(self))\0a\0a\\* END TRANSLATION\0a\0a-----------------------------------------------------------------------------\0aTypeOK == /\\ pc \\in [{0,1} -> {"r", "e1", "e2", "cs"}]\0a          /\\ x \\in [{0,1} -> BOOLEAN]\0a\0aPast(i,j) == \\/ ((pc[i] = "e2") /\\ (j \\notin unchecked[i]))\0a             \\/ /\\ pc[i] \\in {"e3", "e6"}\0a                /\\ j \\notin unchecked[i] \\cup {other[i]}\0a             \\/ pc[i] = "cs"\0a\0aInv == /\\ TypeOK\0a       /\\ \\A i \\in Procs :\0a            /\\ (pc[i] \\in {"e2", "e3", "e6", "cs"}) => x[i]\0a            /\\ \\A j \\in Procs \\ {i} :\0a                        Past(i, j) => ~Past(j, i) /\\ x[i]\0a\0a\0a(***************************************************************************\0a N-process One-Bit mutual exclusion is _not_ starvation free!\0a ***************************************************************************)\0aStarvationFreedom == \\A e \\in Procs : pc[e] = "e2" ~> pc[e] = "cs"\0a\0a \0a=============================================================================\0a']]]
      ['symmetry/SymmetryLiveness3' 'SymmetryLiveness3' %accept ~[['SymmetryLiveness3' '------------------------- MODULE SymmetryLiveness3 -------------------------\0aEXTENDS Integers\0aCONSTANT S\0aOther(n) == CHOOSE x \\in S \\ {n} : TRUE\0a\0aVARIABLES x, y\0a\0aInit == x \\in S /\\ y = 0\0a\0a\\* MCa (SymmetryModelCheckerTest3a)\0aN1 ==   \\/ /\\ y = 0\0a           /\\ y\' = 1\0a           /\\ x\' = x\0a        \\/ /\\ y = 1\0a           /\\ y\' = 0\0a           /\\ x\' = Other(x)\0aSpec1 == Init /\\ [][N1]_<<x, y>> /\\ WF_<<x,y>>(N1) \\* Violates Prop1, but TLC produces bogus trace\0a\0a\\* MC (SymmetryModelCheckerTest3)\0a\\* Contrary to N1, x\' either stays unchanged OR assumes Other(x)\0aN2 ==   \\/ /\\ y = 0\0a           /\\ y\' = 1\0a           /\\ x\' = x\0a        \\/ /\\ y = 1\0a           /\\ y\' = 0\0a           /\\ x\' = x\0a        \\/ /\\ y = 1\0a           /\\ y\' = 0\0a           /\\ x\' = Other(x)\0aSpec2 == Init /\\ [][N2]_<<x, y>> /\\ WF_<<x,y>>(N2) \\* Fails to find error in Prop1\0a\0a\0aProp1 == <>[][x\'=x]_<<x, y>>\0a=============================================================================\0a']]]
      ['symmetry/SymmetryLivenessLong' 'SymmetryLivenessLong' %accept ~[['SymmetryLivenessLong' '------------------------- MODULE SymmetryLivenessLong -------------------------\0aEXTENDS Integers\0aCONSTANT S\0aOther(n) == CHOOSE x \\in S \\ {n} : TRUE\0a\0aVARIABLES x, y\0a\0aInit == x \\in S /\\ y = 0\0a\0a\\* Contrary to SymmetryLiveness3, this produces a long trace which results in LiveWorker#bfsPostFix finding a longer path.\0a\0a\\* MCa (SymmetryModelCheckerTestLonga)\0aN1 ==   \\/ /\\ y = 0\0a           /\\ y\' = 1\0a           /\\ x\' = x\0a        \\/ /\\ y = 1\0a           /\\ y\' = 2\0a           /\\ x\' = x\0a        \\/ /\\ y = 2\0a           /\\ y\' = 3\0a           /\\ x\' = x\0a        \\/ /\\ y = 3\0a           /\\ y\' = 4\0a           /\\ x\' = x\0a        \\/ /\\ y = 4\0a           /\\ y\' = 0\0a           /\\ x\' = Other(x)\0aSpec1 == Init /\\ [][N1]_<<x, y>> /\\ WF_<<x,y>>(N1) \\* Violates Prop1, but TLC produces bogus trace\0a\0a\\* MC (SymmetryModelCheckerTestLong)\0a\\* Contrary to N1, x\' either stays unchanged OR assumes Other(x)\0aN2 ==   \\/ /\\ y = 0\0a           /\\ y\' = 1\0a           /\\ x\' = x\0a        \\/ /\\ y = 1\0a           /\\ y\' = 2\0a           /\\ x\' = x\0a        \\/ /\\ y = 2\0a           /\\ y\' = 3\0a           /\\ x\' = x\0a        \\/ /\\ y = 3\0a           /\\ y\' = 4\0a           /\\ x\' = x\0a        \\/ /\\ y = 4\0a           /\\ y\' = 0\0a           /\\ x\' = x\0a        \\/ /\\ y = 4\0a           /\\ y\' = 0\0a           /\\ x\' = Other(x)\0aSpec2 == Init /\\ [][N2]_<<x, y>> /\\ WF_<<x,y>>(N2) \\* Fails to find error in Prop1\0a\0a\0aProp1 == <>[][x\'=x]_<<x, y>>\0a=============================================================================\0a']]]
      ['symmetry/SymmetryLivenessTableau' 'SymmetryLivenessTableau' %accept ~[['SymmetryLivenessTableau' '---------------------- MODULE SymmetryLivenessTableau ----------------------\0aVARIABLES mem, ctl, buf\0aVARIABLE memInt\0aCONSTANTS  Proc,  \0a           Adr,  \0a           Val\0a\0aNoVal == CHOOSE x : x \\notin Val \0aInitMemInt == {<<p, NoVal>> : p \\in Proc}\0aSend(p, d, oldMemInt, newMemInt)  ==  newMemInt = <<p, d>>\0aReply(p, d, oldMemInt, newMemInt) ==  newMemInt = <<p, d>>\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0a--------------------------------------------------------------\0aIInit == /\\ mem \\in [Adr->Val]\0a         /\\ ctl = [p \\in Proc |-> "rdy"] \0a         /\\ buf = [p \\in Proc |-> NoVal] \0a         /\\ memInt \\in InitMemInt\0a\0aTypeInvariant == \0a  /\\ mem \\in [Adr->Val]\0a  /\\ ctl \\in [Proc -> {"rdy", "busy","done"}] \0a  /\\ buf \\in [Proc -> MReq \\cup Val \\cup {NoVal}]\0a\0aReq(p) == /\\ ctl[p] = "rdy" \0a          /\\ \\E req \\in  MReq :\0a                /\\ Send(p, req, memInt, memInt\')\0a                /\\ buf\' = [buf EXCEPT ![p] = req]\0a                /\\ ctl\' = [ctl EXCEPT ![p] = "busy"]\0a          /\\ UNCHANGED mem \0a\0aDo(p) == \0a  /\\ ctl[p] = "busy" \0a  /\\ mem\' = IF buf[p].op = "Wr"\0a              THEN [mem EXCEPT ![buf[p].adr] = buf[p].val] \0a              ELSE mem \0a  /\\ buf\' = [buf EXCEPT ![p] = IF buf[p].op = "Wr"\0a                                  THEN NoVal\0a                                  ELSE mem[buf[p].adr]]\0a  /\\ ctl\' = [ctl EXCEPT ![p] = "done"] \0a  /\\ UNCHANGED memInt \0a\0aRsp(p) == /\\ ctl[p] = "done"\0a          /\\ Reply(p, buf[p], memInt, memInt\')\0a          /\\ ctl\' = [ctl EXCEPT ![p]= "rdy"]\0a          /\\ UNCHANGED <<mem, buf>> \0a\0aINext == \\E p \\in Proc: Req(p) \\/ Do(p) \\/ Rsp(p) \0a\0aSpec == IInit  /\\  [][INext]_<<memInt, mem, ctl, buf>>\0a             /\\ \\A p \\in Proc : WF_<<memInt, mem, ctl, buf>>(Do(p) \\/ Rsp(p))\0a \0aLiveness == \\A p \\in Proc : (ctl[p] = "busy") ~> (ctl[p] = "rdy")\0a--------------------------------------------------------------\0aTHEOREM Spec => []TypeInvariant\0a==============================================================']]]
      ['symmetry/SymmetryLivenessTableauMC' 'SymmetryLivenessTableauMC' %accept ~[['SymmetryLivenessTableauMC' '---- MODULE SymmetryLivenessTableauMC ----\0aEXTENDS SymmetryLivenessTableau, TLC\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0aa, b\0a----\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0ac, d\0a----\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0ae, f\0a----\0a\0a\\* MV CONSTANT definitions Val\0aconst_144172195407986000 == \0a{a, b}\0a----\0a\0a\\* MV CONSTANT definitions Proc\0aconst_144172195408987000 == \0a{c, d}\0a----\0a\0a\\* MV CONSTANT definitions Adr\0aconst_144172195409988000 == \0a{e, f}\0a----\0a\0a\\* SYMMETRY definition\0asymm_144172195410989000 == \0aPermutations(const_144172195407986000) \\union Permutations(const_144172195408987000) \\union Permutations(const_144172195409988000)\0a----\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_144172195413091000 ==\0aSpec\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_144172195414092000 ==\0aLiveness\0a----\0a\\* NEGATED PROPERTY definition\0aneg_prop_144172195414092000 ==\0a~(Liveness)\0a----\0a\0aProcessingCompletes == \\A p \\in Proc : (ctl[p] = "busy") ~> (ctl[p] = "done")\0a\0aTautology == (mem = mem) ~> (mem = mem)\0a=============================================================================\0a'] ['SymmetryLivenessTableau' '---------------------- MODULE SymmetryLivenessTableau ----------------------\0aVARIABLES mem, ctl, buf\0aVARIABLE memInt\0aCONSTANTS  Proc,  \0a           Adr,  \0a           Val\0a\0aNoVal == CHOOSE x : x \\notin Val \0aInitMemInt == {<<p, NoVal>> : p \\in Proc}\0aSend(p, d, oldMemInt, newMemInt)  ==  newMemInt = <<p, d>>\0aReply(p, d, oldMemInt, newMemInt) ==  newMemInt = <<p, d>>\0a(***************************************************************************)\0a(* We comment out the assumption because TLC cannot handle unbounded       *)\0a(* quantifiers.                                                            *)\0a(***************************************************************************)\0a\\* ASSUME \\A p, d, miOld, miNew : \0a\\*         /\\ Send(p,d,miOld,miNew)  \\in BOOLEAN\0a\\*         /\\ Reply(p,d,miOld,miNew) \\in BOOLEAN  \0a\0a-----------------------------------------------------------------------------\0aMReq == [op : {"Rd"}, adr: Adr] \0a          \\cup [op : {"Wr"}, adr: Adr, val : Val]\0a\0a--------------------------------------------------------------\0aIInit == /\\ mem \\in [Adr->Val]\0a         /\\ ctl = [p \\in Proc |-> "rdy"] \0a         /\\ buf = [p \\in Proc |-> NoVal] \0a         /\\ memInt \\in InitMemInt\0a\0aTypeInvariant == \0a  /\\ mem \\in [Adr->Val]\0a  /\\ ctl \\in [Proc -> {"rdy", "busy","done"}] \0a  /\\ buf \\in [Proc -> MReq \\cup Val \\cup {NoVal}]\0a\0aReq(p) == /\\ ctl[p] = "rdy" \0a          /\\ \\E req \\in  MReq :\0a                /\\ Send(p, req, memInt, memInt\')\0a                /\\ buf\' = [buf EXCEPT ![p] = req]\0a                /\\ ctl\' = [ctl EXCEPT ![p] = "busy"]\0a          /\\ UNCHANGED mem \0a\0aDo(p) == \0a  /\\ ctl[p] = "busy" \0a  /\\ mem\' = IF buf[p].op = "Wr"\0a              THEN [mem EXCEPT ![buf[p].adr] = buf[p].val] \0a              ELSE mem \0a  /\\ buf\' = [buf EXCEPT ![p] = IF buf[p].op = "Wr"\0a                                  THEN NoVal\0a                                  ELSE mem[buf[p].adr]]\0a  /\\ ctl\' = [ctl EXCEPT ![p] = "done"] \0a  /\\ UNCHANGED memInt \0a\0aRsp(p) == /\\ ctl[p] = "done"\0a          /\\ Reply(p, buf[p], memInt, memInt\')\0a          /\\ ctl\' = [ctl EXCEPT ![p]= "rdy"]\0a          /\\ UNCHANGED <<mem, buf>> \0a\0aINext == \\E p \\in Proc: Req(p) \\/ Do(p) \\/ Rsp(p) \0a\0aSpec == IInit  /\\  [][INext]_<<memInt, mem, ctl, buf>>\0a             /\\ \\A p \\in Proc : WF_<<memInt, mem, ctl, buf>>(Do(p) \\/ Rsp(p))\0a \0aLiveness == \\A p \\in Proc : (ctl[p] = "busy") ~> (ctl[p] = "rdy")\0a--------------------------------------------------------------\0aTHEOREM Spec => []TypeInvariant\0a==============================================================']]]
      ['symmetry/TableauSymmetry' 'TableauSymmetry' %accept ~[['TableauSymmetry' '-------------------------- MODULE TableauSymmetry --------------------------\0aCONSTANT Val\0aVARIABLE arr\0a\0aInit == arr = [v \\in Val |-> "ready"]\0a\0aReady(v) == /\\ arr[v] = "ready"\0a            /\\ arr\' = [arr EXCEPT ![v]= "busy"]\0a\0aBusy(v) == /\\ arr[v] = "busy"\0a           /\\ arr\' = [arr EXCEPT ![v]= "done"]\0a\0aDone(v) == /\\ arr[v] = "done"\0a           /\\ arr\' = [arr EXCEPT ![v]= "ready"]\0a\0aNext == \\E v \\in Val : Ready(v) \\/ Busy(v) \\/ Done(v)\0a\0aSpec == Init /\\[][Next]_<<arr>> /\\ WF_<<arr>>(Next)\0a\0aLiveness == \\A v \\in Val : (arr[v] = "busy") ~> (arr[v] = "ready")\0a\0a=============================================================================\0a']]]
      ['symmetry/TableauSymmetryMC' 'TableauSymmetryMC' %accept ~[['TableauSymmetryMC' '---- MODULE TableauSymmetryMC ----\0aEXTENDS TableauSymmetry, TLC\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0aa, b\0a----\0a\0a\\* MV CONSTANT definitions Val\0aconst_144481269486926000 == \0a{a, b}\0a----\0a\0a\\* SYMMETRY definition\0asymm_144481269487927000 == \0aPermutations(const_144481269486926000)\0a----\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_144481269488928000 ==\0aSpec\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_144481269489929000 ==\0aLiveness\0a----\0a\\* NEGATED PROPERTY definition\0aneg_prop_144481269489929000 ==\0a~(Liveness)\0a----\0a\0aAllReady == \\A v \\in Val : []<>(arr[v] = "ready")\0a\0aTautology == (arr = arr) ~> (arr = arr)\0a=============================================================================\0a'] ['TableauSymmetry' '-------------------------- MODULE TableauSymmetry --------------------------\0aCONSTANT Val\0aVARIABLE arr\0a\0aInit == arr = [v \\in Val |-> "ready"]\0a\0aReady(v) == /\\ arr[v] = "ready"\0a            /\\ arr\' = [arr EXCEPT ![v]= "busy"]\0a\0aBusy(v) == /\\ arr[v] = "busy"\0a           /\\ arr\' = [arr EXCEPT ![v]= "done"]\0a\0aDone(v) == /\\ arr[v] = "done"\0a           /\\ arr\' = [arr EXCEPT ![v]= "ready"]\0a\0aNext == \\E v \\in Val : Ready(v) \\/ Busy(v) \\/ Done(v)\0a\0aSpec == Init /\\[][Next]_<<arr>> /\\ WF_<<arr>>(Next)\0a\0aLiveness == \\A v \\in Val : (arr[v] = "busy") ~> (arr[v] = "ready")\0a\0a=============================================================================\0a']]]
      ['symmetry/TwoPhaseCommit/DistributedCommit' 'DistributedCommit' %accept ~[['DistributedCommit' '------------------------- MODULE DistributedCommit -------------------------\0a(***************************************************************************)\0a(* This is a high-level TLA+ specification of a distributed commit         *)\0a(* protocol. A set of nodes individually decide whether they wish to       *)\0a(* commit or abort a transaction. Second, the transaction will be          *)\0a(* committed iff every node wishes to commit.                              *)\0a(***************************************************************************)\0aCONSTANT Participant  \\* set of participating nodes\0a\0aVARIABLE pState  \\* state of each participant\0a\0a(***************************************************************************)\0a(* Possible states of non-coordinator participants.                        *)\0a(***************************************************************************)\0aPState == {"preparing", "readyCommit", "readyAbort", "committed", "aborted"}\0a\0a(***************************************************************************)\0a(* Initially, every participant is preparing the transaction.              *)\0a(***************************************************************************)\0aInit == pState = [p \\in Participant |-> "preparing"]\0a\0a(***************************************************************************)\0a(* A participant decides whether she wishes to commit or abort.            *)\0a(***************************************************************************)\0aDecide(p) ==\0a  /\\ pState[p] = "preparing"\0a  /\\ \\E dec \\in {"readyCommit", "readyAbort"} : \0a        pState\' = [pState EXCEPT ![p] = dec]\0a\0a(***************************************************************************)\0a(* A participant may definitely commit only if all participants wish       *)\0a(* to do so.                                                               *)\0a(***************************************************************************)\0aCommit(p) ==\0a  /\\ \\A q \\in Participant : pState[q] \\in {"readyCommit", "committed"}\0a  /\\ pState\' = [pState EXCEPT ![p] = "committed"]\0a\0a(***************************************************************************)\0a(* A participant aborts if some participant wishes to do so.               *)\0a(***************************************************************************)\0aAbort(p) ==\0a  /\\ \\E q \\in Participant : pState[q] \\in {"readyAbort", "aborted"}\0a  /\\ pState\' = [pState EXCEPT ![p] = "aborted"]\0a\0a(***************************************************************************)\0a(* The next-state relation is the disjunction of the above actions.        *)\0a(***************************************************************************)\0aNext ==\0a  \\E p \\in Participant : Decide(p) \\/ Commit(p) \\/ Abort(p)\0a\0a(***************************************************************************)\0a(* Overall specification.                                                  *)\0a(***************************************************************************)\0aSpec == Init /\\ [][Next]_pState /\\ WF_pState(Next)\0a\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Main safety property: participants may definitely commit only if        *)\0a(* all participants agree.                                                 *)\0a(***************************************************************************)\0aSafety == \0a  \\A p \\in Participant : pState[p] = "committed" =>\0a     \\A q \\in Participant : pState[q] \\in {"readyCommit", "committed"}\0a\0a=============================================================================\0a']]]
      ['symmetry/TwoPhaseCommit/MC' 'MC' %accept ~[['MC' '---- MODULE MC ----\0aEXTENDS TwoPhaseCommit, TLC\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0aanna, berta, charlie, dimitry, eugene\0a----\0a\0a\\* MV CONSTANT definitions Participant\0aconst_146894168642461000 == \0a{anna, berta, charlie, dimitry, eugene}\0a----\0a\0a\\* SYMMETRY definition\0asymm_146894168643562000 == \0aPermutations(const_146894168642461000)\0a----\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_146894168644663000 ==\0aSpec\0a----\0a\\* INVARIANT definition @modelCorrectnessInvariants:0\0ainv_146894168645764000 ==\0aTypeOK\0a----\0a\\* INVARIANT definition @modelCorrectnessInvariants:1\0ainv_146894168646965000 ==\0aCommitOrAbort\0a----\0a\\* INVARIANT definition @modelCorrectnessInvariants:2\0ainv_146894168647966000 ==\0aAbortWins\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_146894168649067000 ==\0aLiveness\0a----\0a=============================================================================\0a'] ['TwoPhaseCommit' '--------------------------- MODULE TwoPhaseCommit ---------------------------\0a(***************************************************************************)\0a(* This is a TLA+ specification of the two-phase commit protocol used for  *)\0a(* distributed data bases. It models only one instance of the protocol,    *)\0a(* i.e. for a single transaction.                                          *)\0a(*                                                                         *)\0a(* We specify only the safety part of the specification: what may occur    *)\0a(* during an execution. This would be complemented by a specification of   *)\0a(* what must eventually occur, specified by suitable fairness conditions.  *)\0a(***************************************************************************)\0a\0aCONSTANT Participant  \\* set of nodes other than the coordinator\0a\0aVARIABLES\0a  cState,     \\* the state of the coordinator\0a  pState,     \\* the state of the non-coordinator participants\0a  committed,  \\* participants that the coordinator knows are OK for committing\0a  msgs        \\* messages sent during the protocol\0a\0avars == <<cState, pState, committed, msgs>>\0a\0a(***************************************************************************)\0a(* Possible states of coordinator.                                         *)\0a(***************************************************************************)\0aCState == {"preparing", "committed", "aborted"}\0a\0a(***************************************************************************)\0a(* Possible states of non-coordinator participants.                        *)\0a(***************************************************************************)\0aPState == {"preparing", "readyCommit", "readyAbort", "committed", "aborted"}\0a\0a(***************************************************************************)\0a(* Messages sent during the protocol.                                      *)\0a(***************************************************************************)\0aMessages ==\0a  \\* participant informs coordinator about its decision\0a  [kind : {"commit", "abort"}, part : Participant] \\cup\0a  \\* coordinator tells participants whether to commit or abort\0a  [kind : {"doCommit", "doAbort"}]\0a\0acommit(p) == [kind |-> "commit", part |-> p]\0aabort(p) == [kind |-> "abort", part |-> p]\0adoCommit == [kind |-> "doCommit"]\0adoAbort == [kind |-> "doAbort"]\0a\0a(***************************************************************************)\0a(* The following predicate specifies what values the variables can take    *)\0a(* during an execution of the protocol.                                    *)\0a(***************************************************************************)\0aTypeOK ==\0a  /\\ cState \\in CState\0a  /\\ pState \\in [Participant -> PState]\0a  /\\ committed \\subseteq Participant\0a  /\\ msgs \\subseteq Messages\0a  \0a(***************************************************************************)\0a(* The initial state of the protocol.                                      *)\0a(***************************************************************************)\0aInit ==\0a  /\\ cState = "preparing"\0a  /\\ pState = [p \\in Participant |-> "preparing"]\0a  /\\ committed = {}\0a  /\\ msgs = {}\0a\0a(***************************************************************************)\0a(* The following action formulas describe the possible transitions of      *)\0a(* the nodes.                                                              *)\0a(***************************************************************************)\0a\0a(***************************************************************************)\0a(* A participant decides and informs the coordinator of its decision.      *)\0a(***************************************************************************)\0aDecide(p) ==\0a  /\\ pState[p] = "preparing"\0a  /\\ \\/ pState\' = [pState EXCEPT ![p] = "readyCommit"] /\\ msgs\' = msgs \\cup {commit(p)}\0a     \\/ pState\' = [pState EXCEPT ![p] = "readyAbort"] /\\ msgs\' = msgs \\cup {abort(p)}\0a  /\\ UNCHANGED <<cState, committed>>\0a\0a(***************************************************************************)\0a(* A participant receives a commit or abort order from the coordinator.    *)\0a(***************************************************************************)\0aExecute(p) ==\0a  /\\ \\/ doCommit \\in msgs /\\ pState\' = [pState EXCEPT ![p] = "committed"]\0a     \\/ doAbort \\in msgs /\\ pState\' = [pState EXCEPT ![p] = "aborted"]\0a  /\\ UNCHANGED <<cState, committed, msgs>>\0a\0a(***************************************************************************)\0a(* The coordinator receives a new commit decision for some participant.    *)\0a(* If all participants wish to commit, it sends an order to commit.        *)\0a(***************************************************************************)\0aRcvCommit == \\E p \\in Participant \\ committed :\0a  /\\ commit(p) \\in msgs\0a  /\\ committed\' = committed \\cup {p}\0a  /\\ IF committed\' = Participant\0a     THEN /\\ cState\' = "committed"\0a          /\\ msgs\' = msgs \\cup {doCommit}\0a     ELSE UNCHANGED <<cState, msgs>> \0a  /\\ pState\' = pState\0a\0a(***************************************************************************)\0a(* The coordinator receives an abort decision and sends an order to abort. *)\0a(***************************************************************************)\0aRcvAbort == \\E p \\in Participant :\0a  /\\ abort(p) \\in msgs\0a  /\\ cState\' = "aborted"\0a  /\\ msgs\' = msgs \\cup {doAbort}\0a  /\\ UNCHANGED <<pState, committed>>\0a\0a(***************************************************************************)\0a(* The overall next-state relation is the disjunction of the action        *)\0a(* formulas defined previously.                                            *)\0a(***************************************************************************)\0aNext ==\0a  \\/ \\E p \\in Participant : Decide(p) \\/ Execute(p)\0a  \\/ RcvCommit\0a  \\/ RcvAbort\0a\0aSpec == Init /\\ [][Next]_vars /\\ WF_vars(Next)\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Correctness properties.                                                 *)\0a(***************************************************************************)\0a\0a(***************************************************************************)\0a(* The coordinator never sends both a doCommit and a doAbort message.      *)\0a(***************************************************************************)\0aCommitOrAbort == ~(doCommit \\in msgs /\\ doAbort \\in msgs)\0a\0a(***************************************************************************)\0a(* The coordinator may commit only if all participants wish to commit and  *)\0a(* no participant wishes to abort.                                         *)\0a(***************************************************************************)\0aAbortWins == \0a  doCommit \\in msgs => \0a    \\A p \\in Participant : \0a       /\\ commit(p) \\in msgs /\\ pState[p] \\in {"readyCommit", "committed"}\0a       /\\ abort(p) \\notin msgs\0a\0aLiveness ==\0a  \\A p \\in Participant : <>(pState[p] \\in {"committed", "aborted"})\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Two-phase commitment implements distributed commitment.                 *)\0a(***************************************************************************)\0aDC == INSTANCE DistributedCommit\0a\0aTHEOREM Spec => DC!Spec\0a=============================================================================\0a'] ['DistributedCommit' '------------------------- MODULE DistributedCommit -------------------------\0a(***************************************************************************)\0a(* This is a high-level TLA+ specification of a distributed commit         *)\0a(* protocol. A set of nodes individually decide whether they wish to       *)\0a(* commit or abort a transaction. Second, the transaction will be          *)\0a(* committed iff every node wishes to commit.                              *)\0a(***************************************************************************)\0aCONSTANT Participant  \\* set of participating nodes\0a\0aVARIABLE pState  \\* state of each participant\0a\0a(***************************************************************************)\0a(* Possible states of non-coordinator participants.                        *)\0a(***************************************************************************)\0aPState == {"preparing", "readyCommit", "readyAbort", "committed", "aborted"}\0a\0a(***************************************************************************)\0a(* Initially, every participant is preparing the transaction.              *)\0a(***************************************************************************)\0aInit == pState = [p \\in Participant |-> "preparing"]\0a\0a(***************************************************************************)\0a(* A participant decides whether she wishes to commit or abort.            *)\0a(***************************************************************************)\0aDecide(p) ==\0a  /\\ pState[p] = "preparing"\0a  /\\ \\E dec \\in {"readyCommit", "readyAbort"} : \0a        pState\' = [pState EXCEPT ![p] = dec]\0a\0a(***************************************************************************)\0a(* A participant may definitely commit only if all participants wish       *)\0a(* to do so.                                                               *)\0a(***************************************************************************)\0aCommit(p) ==\0a  /\\ \\A q \\in Participant : pState[q] \\in {"readyCommit", "committed"}\0a  /\\ pState\' = [pState EXCEPT ![p] = "committed"]\0a\0a(***************************************************************************)\0a(* A participant aborts if some participant wishes to do so.               *)\0a(***************************************************************************)\0aAbort(p) ==\0a  /\\ \\E q \\in Participant : pState[q] \\in {"readyAbort", "aborted"}\0a  /\\ pState\' = [pState EXCEPT ![p] = "aborted"]\0a\0a(***************************************************************************)\0a(* The next-state relation is the disjunction of the above actions.        *)\0a(***************************************************************************)\0aNext ==\0a  \\E p \\in Participant : Decide(p) \\/ Commit(p) \\/ Abort(p)\0a\0a(***************************************************************************)\0a(* Overall specification.                                                  *)\0a(***************************************************************************)\0aSpec == Init /\\ [][Next]_pState /\\ WF_pState(Next)\0a\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Main safety property: participants may definitely commit only if        *)\0a(* all participants agree.                                                 *)\0a(***************************************************************************)\0aSafety == \0a  \\A p \\in Participant : pState[p] = "committed" =>\0a     \\A q \\in Participant : pState[q] \\in {"readyCommit", "committed"}\0a\0a=============================================================================\0a']]]
      ['symmetry/TwoPhaseCommit/TwoPhaseCommit' 'TwoPhaseCommit' %accept ~[['TwoPhaseCommit' '--------------------------- MODULE TwoPhaseCommit ---------------------------\0a(***************************************************************************)\0a(* This is a TLA+ specification of the two-phase commit protocol used for  *)\0a(* distributed data bases. It models only one instance of the protocol,    *)\0a(* i.e. for a single transaction.                                          *)\0a(*                                                                         *)\0a(* We specify only the safety part of the specification: what may occur    *)\0a(* during an execution. This would be complemented by a specification of   *)\0a(* what must eventually occur, specified by suitable fairness conditions.  *)\0a(***************************************************************************)\0a\0aCONSTANT Participant  \\* set of nodes other than the coordinator\0a\0aVARIABLES\0a  cState,     \\* the state of the coordinator\0a  pState,     \\* the state of the non-coordinator participants\0a  committed,  \\* participants that the coordinator knows are OK for committing\0a  msgs        \\* messages sent during the protocol\0a\0avars == <<cState, pState, committed, msgs>>\0a\0a(***************************************************************************)\0a(* Possible states of coordinator.                                         *)\0a(***************************************************************************)\0aCState == {"preparing", "committed", "aborted"}\0a\0a(***************************************************************************)\0a(* Possible states of non-coordinator participants.                        *)\0a(***************************************************************************)\0aPState == {"preparing", "readyCommit", "readyAbort", "committed", "aborted"}\0a\0a(***************************************************************************)\0a(* Messages sent during the protocol.                                      *)\0a(***************************************************************************)\0aMessages ==\0a  \\* participant informs coordinator about its decision\0a  [kind : {"commit", "abort"}, part : Participant] \\cup\0a  \\* coordinator tells participants whether to commit or abort\0a  [kind : {"doCommit", "doAbort"}]\0a\0acommit(p) == [kind |-> "commit", part |-> p]\0aabort(p) == [kind |-> "abort", part |-> p]\0adoCommit == [kind |-> "doCommit"]\0adoAbort == [kind |-> "doAbort"]\0a\0a(***************************************************************************)\0a(* The following predicate specifies what values the variables can take    *)\0a(* during an execution of the protocol.                                    *)\0a(***************************************************************************)\0aTypeOK ==\0a  /\\ cState \\in CState\0a  /\\ pState \\in [Participant -> PState]\0a  /\\ committed \\subseteq Participant\0a  /\\ msgs \\subseteq Messages\0a  \0a(***************************************************************************)\0a(* The initial state of the protocol.                                      *)\0a(***************************************************************************)\0aInit ==\0a  /\\ cState = "preparing"\0a  /\\ pState = [p \\in Participant |-> "preparing"]\0a  /\\ committed = {}\0a  /\\ msgs = {}\0a\0a(***************************************************************************)\0a(* The following action formulas describe the possible transitions of      *)\0a(* the nodes.                                                              *)\0a(***************************************************************************)\0a\0a(***************************************************************************)\0a(* A participant decides and informs the coordinator of its decision.      *)\0a(***************************************************************************)\0aDecide(p) ==\0a  /\\ pState[p] = "preparing"\0a  /\\ \\/ pState\' = [pState EXCEPT ![p] = "readyCommit"] /\\ msgs\' = msgs \\cup {commit(p)}\0a     \\/ pState\' = [pState EXCEPT ![p] = "readyAbort"] /\\ msgs\' = msgs \\cup {abort(p)}\0a  /\\ UNCHANGED <<cState, committed>>\0a\0a(***************************************************************************)\0a(* A participant receives a commit or abort order from the coordinator.    *)\0a(***************************************************************************)\0aExecute(p) ==\0a  /\\ \\/ doCommit \\in msgs /\\ pState\' = [pState EXCEPT ![p] = "committed"]\0a     \\/ doAbort \\in msgs /\\ pState\' = [pState EXCEPT ![p] = "aborted"]\0a  /\\ UNCHANGED <<cState, committed, msgs>>\0a\0a(***************************************************************************)\0a(* The coordinator receives a new commit decision for some participant.    *)\0a(* If all participants wish to commit, it sends an order to commit.        *)\0a(***************************************************************************)\0aRcvCommit == \\E p \\in Participant \\ committed :\0a  /\\ commit(p) \\in msgs\0a  /\\ committed\' = committed \\cup {p}\0a  /\\ IF committed\' = Participant\0a     THEN /\\ cState\' = "committed"\0a          /\\ msgs\' = msgs \\cup {doCommit}\0a     ELSE UNCHANGED <<cState, msgs>> \0a  /\\ pState\' = pState\0a\0a(***************************************************************************)\0a(* The coordinator receives an abort decision and sends an order to abort. *)\0a(***************************************************************************)\0aRcvAbort == \\E p \\in Participant :\0a  /\\ abort(p) \\in msgs\0a  /\\ cState\' = "aborted"\0a  /\\ msgs\' = msgs \\cup {doAbort}\0a  /\\ UNCHANGED <<pState, committed>>\0a\0a(***************************************************************************)\0a(* The overall next-state relation is the disjunction of the action        *)\0a(* formulas defined previously.                                            *)\0a(***************************************************************************)\0aNext ==\0a  \\/ \\E p \\in Participant : Decide(p) \\/ Execute(p)\0a  \\/ RcvCommit\0a  \\/ RcvAbort\0a\0aSpec == Init /\\ [][Next]_vars /\\ WF_vars(Next)\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Correctness properties.                                                 *)\0a(***************************************************************************)\0a\0a(***************************************************************************)\0a(* The coordinator never sends both a doCommit and a doAbort message.      *)\0a(***************************************************************************)\0aCommitOrAbort == ~(doCommit \\in msgs /\\ doAbort \\in msgs)\0a\0a(***************************************************************************)\0a(* The coordinator may commit only if all participants wish to commit and  *)\0a(* no participant wishes to abort.                                         *)\0a(***************************************************************************)\0aAbortWins == \0a  doCommit \\in msgs => \0a    \\A p \\in Participant : \0a       /\\ commit(p) \\in msgs /\\ pState[p] \\in {"readyCommit", "committed"}\0a       /\\ abort(p) \\notin msgs\0a\0aLiveness ==\0a  \\A p \\in Participant : <>(pState[p] \\in {"committed", "aborted"})\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Two-phase commitment implements distributed commitment.                 *)\0a(***************************************************************************)\0aDC == INSTANCE DistributedCommit\0a\0aTHEOREM Spec => DC!Spec\0a=============================================================================\0a'] ['DistributedCommit' '------------------------- MODULE DistributedCommit -------------------------\0a(***************************************************************************)\0a(* This is a high-level TLA+ specification of a distributed commit         *)\0a(* protocol. A set of nodes individually decide whether they wish to       *)\0a(* commit or abort a transaction. Second, the transaction will be          *)\0a(* committed iff every node wishes to commit.                              *)\0a(***************************************************************************)\0aCONSTANT Participant  \\* set of participating nodes\0a\0aVARIABLE pState  \\* state of each participant\0a\0a(***************************************************************************)\0a(* Possible states of non-coordinator participants.                        *)\0a(***************************************************************************)\0aPState == {"preparing", "readyCommit", "readyAbort", "committed", "aborted"}\0a\0a(***************************************************************************)\0a(* Initially, every participant is preparing the transaction.              *)\0a(***************************************************************************)\0aInit == pState = [p \\in Participant |-> "preparing"]\0a\0a(***************************************************************************)\0a(* A participant decides whether she wishes to commit or abort.            *)\0a(***************************************************************************)\0aDecide(p) ==\0a  /\\ pState[p] = "preparing"\0a  /\\ \\E dec \\in {"readyCommit", "readyAbort"} : \0a        pState\' = [pState EXCEPT ![p] = dec]\0a\0a(***************************************************************************)\0a(* A participant may definitely commit only if all participants wish       *)\0a(* to do so.                                                               *)\0a(***************************************************************************)\0aCommit(p) ==\0a  /\\ \\A q \\in Participant : pState[q] \\in {"readyCommit", "committed"}\0a  /\\ pState\' = [pState EXCEPT ![p] = "committed"]\0a\0a(***************************************************************************)\0a(* A participant aborts if some participant wishes to do so.               *)\0a(***************************************************************************)\0aAbort(p) ==\0a  /\\ \\E q \\in Participant : pState[q] \\in {"readyAbort", "aborted"}\0a  /\\ pState\' = [pState EXCEPT ![p] = "aborted"]\0a\0a(***************************************************************************)\0a(* The next-state relation is the disjunction of the above actions.        *)\0a(***************************************************************************)\0aNext ==\0a  \\E p \\in Participant : Decide(p) \\/ Commit(p) \\/ Abort(p)\0a\0a(***************************************************************************)\0a(* Overall specification.                                                  *)\0a(***************************************************************************)\0aSpec == Init /\\ [][Next]_pState /\\ WF_pState(Next)\0a\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Main safety property: participants may definitely commit only if        *)\0a(* all participants agree.                                                 *)\0a(***************************************************************************)\0aSafety == \0a  \\A p \\in Participant : pState[p] = "committed" =>\0a     \\A q \\in Participant : pState[q] \\in {"readyCommit", "committed"}\0a\0a=============================================================================\0a']]]
      ['symmetry/Unsymmetric' 'Unsymmetric' %accept ~[['Unsymmetric' '--------------------------- MODULE Unsymmetric ---------------------------\0aCONSTANT S\0aVARIABLE x\0a\0aInit ==  x \\in S\0a\0aBack == \\/ /\\ x \\in {1,2}\0a           /\\ x\' \\in S\0a\0a\\* A:\0a\\*\0a\\* A honors S being symmetric. TLC finds and\0a\\* prints the correct counter-example.\0a\0atA == CHOOSE a \\in S : TRUE\0a\0aNextA == \\/ /\\ x \\in S\0a            /\\ IF x = tA THEN x\' = 1\0a                         ELSE x\' = 2\0aSpecA == Init /\\ [][NextA \\/ Back]_x /\\ WF_x(NextA \\/ Back)\0a\0a\\* B:\0a\\*\0a\\* \'tb\' breaks symmetry because it explicitly\0a\\* requires an element in S that is different to\0a\\* another S element. This is exactly opposite\0a\\* to what symmetry represents. Hence, the spec\0a\\* is _not_ symmetric and thus TLC fails to find a \0a\\* violation/counter-example (TLC finds the \0a\\* counter-example when S is not declared symmetric.\0a\0atB == LET t1 == CHOOSE a \\in S : TRUE\0a      IN  CHOOSE a \\in S \\ {t1} : TRUE\0a\0a\0aNextB == \\/ /\\ x \\in S\0a            /\\ IF x = tB THEN x\' = 1\0a                         ELSE x\' = 2\0aSpecB == Init /\\ [][NextB \\/ Back]_x /\\ WF_x(NextB \\/ Back)\0a\0a\\* Liveness\0a\0aProp == []<>(x = 2)\0a============================================================================\0a\0a']]]
      ['symmetry/UnsymmetricMCA' 'UnsymmetricMCA' %accept ~[['UnsymmetricMCA' '---- MODULE UnsymmetricMCA ----\0aEXTENDS Unsymmetric, TLC\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0aa, b\0a----\0a\0a\\* MV CONSTANT definitions S\0aconst_1444366015085101000 == \0a{a, b}\0a----\0a\0a\\* SYMMETRY definition\0asymm_1444366015096102000 == \0aPermutations(const_1444366015085101000)\0a----\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_1444366015106103000 ==\0aSpecA\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_1444366015116104000 ==\0aProp\0a----\0a\\* NEGATED PROPERTY definition\0aneg_prop_1444366015116104000 ==\0a~(Prop)\0a----\0a\0aXVisitsIntegers == []<>(x \\in {1, 2})\0a\0aTautology == (x = x) ~> (x = x)\0a=============================================================================\0a'] ['Unsymmetric' '--------------------------- MODULE Unsymmetric ---------------------------\0aCONSTANT S\0aVARIABLE x\0a\0aInit ==  x \\in S\0a\0aBack == \\/ /\\ x \\in {1,2}\0a           /\\ x\' \\in S\0a\0a\\* A:\0a\\*\0a\\* A honors S being symmetric. TLC finds and\0a\\* prints the correct counter-example.\0a\0atA == CHOOSE a \\in S : TRUE\0a\0aNextA == \\/ /\\ x \\in S\0a            /\\ IF x = tA THEN x\' = 1\0a                         ELSE x\' = 2\0aSpecA == Init /\\ [][NextA \\/ Back]_x /\\ WF_x(NextA \\/ Back)\0a\0a\\* B:\0a\\*\0a\\* \'tb\' breaks symmetry because it explicitly\0a\\* requires an element in S that is different to\0a\\* another S element. This is exactly opposite\0a\\* to what symmetry represents. Hence, the spec\0a\\* is _not_ symmetric and thus TLC fails to find a \0a\\* violation/counter-example (TLC finds the \0a\\* counter-example when S is not declared symmetric.\0a\0atB == LET t1 == CHOOSE a \\in S : TRUE\0a      IN  CHOOSE a \\in S \\ {t1} : TRUE\0a\0a\0aNextB == \\/ /\\ x \\in S\0a            /\\ IF x = tB THEN x\' = 1\0a                         ELSE x\' = 2\0aSpecB == Init /\\ [][NextB \\/ Back]_x /\\ WF_x(NextB \\/ Back)\0a\0a\\* Liveness\0a\0aProp == []<>(x = 2)\0a============================================================================\0a\0a']]]
      ['symmetry/UnsymmetricMCB' 'UnsymmetricMCB' %accept ~[['UnsymmetricMCB' '---- MODULE UnsymmetricMCB ----\0aEXTENDS Unsymmetric, TLC\0a\0a\\* MV CONSTANT declarations@modelParameterConstants\0aCONSTANTS\0aa, b\0a----\0a\0a\\* MV CONSTANT definitions S\0aconst_1444366015085101000 == \0a{a, b}\0a----\0a\0a\\* SYMMETRY definition\0asymm_1444366015096102000 == \0aPermutations(const_1444366015085101000)\0a----\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_1444366015106103000 ==\0aSpecB\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_1444366015116104000 ==\0aProp\0a----\0a=============================================================================\0a'] ['Unsymmetric' '--------------------------- MODULE Unsymmetric ---------------------------\0aCONSTANT S\0aVARIABLE x\0a\0aInit ==  x \\in S\0a\0aBack == \\/ /\\ x \\in {1,2}\0a           /\\ x\' \\in S\0a\0a\\* A:\0a\\*\0a\\* A honors S being symmetric. TLC finds and\0a\\* prints the correct counter-example.\0a\0atA == CHOOSE a \\in S : TRUE\0a\0aNextA == \\/ /\\ x \\in S\0a            /\\ IF x = tA THEN x\' = 1\0a                         ELSE x\' = 2\0aSpecA == Init /\\ [][NextA \\/ Back]_x /\\ WF_x(NextA \\/ Back)\0a\0a\\* B:\0a\\*\0a\\* \'tb\' breaks symmetry because it explicitly\0a\\* requires an element in S that is different to\0a\\* another S element. This is exactly opposite\0a\\* to what symmetry represents. Hence, the spec\0a\\* is _not_ symmetric and thus TLC fails to find a \0a\\* violation/counter-example (TLC finds the \0a\\* counter-example when S is not declared symmetric.\0a\0atB == LET t1 == CHOOSE a \\in S : TRUE\0a      IN  CHOOSE a \\in S \\ {t1} : TRUE\0a\0a\0aNextB == \\/ /\\ x \\in S\0a            /\\ IF x = tB THEN x\' = 1\0a                         ELSE x\' = 2\0aSpecB == Init /\\ [][NextB \\/ Back]_x /\\ WF_x(NextB \\/ Back)\0a\0a\\* Liveness\0a\0aProp == []<>(x = 2)\0a============================================================================\0a\0a']]]
