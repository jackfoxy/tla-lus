] = "white"]\0a\0a(* token passing actions controlled by the termination detection algorithm *)\0aSystem == InitiateProbe \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0a(* An active node i may activate another node j by sending it\0a   a message. If j>i (hence activation goes against the direction\0a   of the token being passed), then node i becomes black. *)\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0a(* Any active node may become inactive at any moment. *)\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0a(* actions performed by the underlying algorithm *)\0aEnvironment == \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0a(* next-state relation: disjunction of above actions *)\0aNext == System \\/ Environment\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aSpec == Init /\\ [][Next]_vars /\\ WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Non-properties that can be used for validating the specification.       *)\0a(***************************************************************************)\0aTokenAlwaysBlack == tcolor = "black"\0a\0aNeverChangeColor == [][ UNCHANGED color ]_vars\0a\0a(***************************************************************************)\0a(* Main safety property: if there is a white token at node 0 then every    *)\0a(* node is inactive.                                                       *)\0a(***************************************************************************)\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0a(***************************************************************************)\0a(* Liveness property: termination is eventually detected.                  *)\0a(***************************************************************************)\0aLiveness ==\0a  (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0a(***************************************************************************)\0a(* The following property asserts that when every process always           *)\0a(* eventually terminates then eventually termination will be detected.     *)\0a(* It does not hold since processes can wake up each other.                *)\0a(***************************************************************************)\0aFalseLiveness ==\0a  \\* in this version TLC displays a valid counter-example, however\0a  \\* it prints "back to state 1" below the initial state instead of\0a  \\* below the last state of the finite trace prefix\0a  (\\A i \\in Nodes : []<> ~ active[i]) ~> terminationDetected\0a\0aFalseLiveness2 ==\0a  \\* in this version TLC displays a counter-example that ends in\0a  \\* infinite stuttering, which is invalid since the fairness\0a  \\* property of the spec is not respected\0a  (\\A i \\in Nodes : (active[i] ~> ~ active[i])) ~> terminationDetected\0a\0a\\* This is an alternative way to express the same property: the fairness\0a\\* condition must be added to the spec since TLC doesn\'t allow WF formulas\0a\\* appearing in the property. It returns the same counter-example as the\0a\\* first variant, with the same output problem.\0aSpec2 == Spec /\\ \\A i \\in Nodes : WF_vars(Deactivate(i))\0aFalseLiveness3 == <>terminationDetected\0a\0a(***************************************************************************)\0a(* The following property says that eventually all nodes will terminate    *)\0a(* assuming that from some point onwards no messages are sent. It is       *)\0a(* undesired, but verified for the fairness condition WF_vars(Next).       *)\0a(***************************************************************************)\0aSpec3 == Init /\\ [][Next]_vars /\\ WF_vars(Next)\0aAllNodesTerminateIfNoMessages ==\0a  ~[]<><< \\E i \\in Nodes : SendMsg(i) >>_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0a(***************************************************************************)\0a(* Dijkstra\'s inductive invariant                                          *)\0a(***************************************************************************)\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a(***************************************************************************)\0a(* Use the following specification to check that the predicate             *)\0a(* TypeOK /\\ Inv is inductive for EWD 840: verify that it is an            *)\0a(* (ordinary) invariant of a specification obtained by replacing the       *)\0a(* initial condition by that conjunction.                                  *)\0a(***************************************************************************)\0aCheckInductiveSpec == TypeOK /\\ Inv /\\ [][Next]_vars\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Thu Apr 02 10:49:59 CEST 2015 by markus\0a\\* Last modified Thu Apr 02 09:30:10 CEST 2015 by merz\0a\\* Created Mon Sep 09 11:33:10 CEST 2013 by merz']]]
      ['CodePlexBug08/MC' 'MC' %accept ~[['MC' '---- MODULE MC ----\0aEXTENDS CodeplexBug8, TLC\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_14235897021122000 ==\0aSpec\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_14235897021223000 ==\0aXshrinks\0a----\0a\\* NEGATED PROPERTY definition\0aneg_prop_14235897021223000 ==\0a~(Xshrinks)\0a----\0a\0aXEventuallyGrows == <>(x >= 4)\0a\0aTautology == (x = x) ~> (x = x)\0a=============================================================================\0a\\* Modification History\0a\\* Created Tue Feb 10 18:35:02 CET 2015 by markus\0a'] ['CodeplexBug8' '---------------------------- MODULE CodeplexBug8 ----------------------------\0aEXTENDS Naturals\0a\0aVARIABLES x, b\0a\0aA == /\\ x < 5\0a     /\\ b\0a     /\\ b\' = ~b\0a     /\\ UNCHANGED x\0a\0aB == /\\ ~b\0a     /\\ b\' = ~b\0a     /\\ x\' = x + 1\0a\0aInit == x \\in 0..3 /\\ b \\in BOOLEAN\0a\0aNext == A \\/ B\0a\0aSpec == Init /\\ [][Next]_<<x, b>> /\\ WF_<<x, b>>(Next)\0a\0a--------------------------------------------------------------------------------\0a\0aXshrinks == x=2 ~> x=1\0a\0a================================================================================']]]
      ['CodePlexBug08/MCa' 'MCa' %accept ~[['MCa' '---- MODULE MCa ----\0aEXTENDS CodeplexBug8, TLC, TLCExt\0a\0a\\* SPECIFICATION definition @modelBehaviorSpec:0\0aspec_14273156623644000 ==\0aSpec\0a----\0a\\* PROPERTY definition @modelCorrectnessProperties:0\0aprop_14273156623745000 ==\0ax=1 ~> x=0\0a----\0a\\* NEGATED PROPERTY definition\0aneg_prop_14273156623745000 ==\0a~(x=1 ~> x=0)\0a----\0aPostCondition ==\0a\09/\\ TLCSet(42, TLCGet("generated"))\0a\09/\\ \\/ /\\ CounterExample = \0a\09\09\09\09[ state |->\0a\09\09\09\09      { <<1, [x |-> 1, b |-> FALSE]>>,\0a\09\09\09\09        <<2, [x |-> 2, b |-> TRUE]>>,\0a\09\09\09\09        <<3, [x |-> 2, b |-> FALSE]>>,\0a\09\09\09\09        <<4, [x |-> 3, b |-> TRUE]>>,\0a\09\09\09\09        <<5, [x |-> 3, b |-> FALSE]>>,\0a\09\09\09\09        <<6, [x |-> 4, b |-> TRUE]>>,\0a\09\09\09\09        <<7, [x |-> 4, b |-> FALSE]>>,\0a\09\09\09\09        <<8, [x |-> 5, b |-> TRUE]>> },\0a\09\09\09\09  action |->\0a\09\09\09\09      { << <<1, [x |-> 1, b |-> FALSE]>>,\0a\09\09\09\09           [ name |-> "B",\0a\09\09\09\09             location |->\0a\09\09\09\09                 [ beginLine |-> 11,\0a\09\09\09\09                   beginColumn |-> 6,\0a\09\09\09\09                   endLine |-> 13,\0a\09\09\09\09                   endColumn |-> 18,\0a\09\09\09\09                   module |-> "CodeplexBug8" ] ],\0a\09\09\09\09           <<2, [x |-> 2, b |-> TRUE]>> >>,\0a\09\09\09\09        << <<2, [x |-> 2, b |-> TRUE]>>,\0a\09\09\09\09           [ name |-> "A",\0a\09\09\09\09             location |->\0a\09\09\09\09                 [ beginLine |-> 6,\0a\09\09\09\09                   beginColumn |-> 6,\0a\09\09\09\09                   endLine |-> 9,\0a\09\09\09\09                   endColumn |-> 19,\0a\09\09\09\09                   module |-> "CodeplexBug8" ] ],\0a\09\09\09\09           <<3, [x |-> 2, b |-> FALSE]>> >>,\0a\09\09\09\09        << <<3, [x |-> 2, b |-> FALSE]>>,\0a\09\09\09\09           [ name |-> "B",\0a\09\09\09\0