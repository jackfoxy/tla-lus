      ['AS/AS' 'AS' %accept ~[['AS' '--------------------------------- MODULE AS ---------------------------------\0aEXTENDS Integers, FiniteSets\0a\0aCONSTANT c\0aASSUME c \\in Nat \\ {0}\0a\0aR == -42\0a\0a\0aVARIABLES x, z\0a\0aASTypeOK == /\\ x \\in 1..c \\cup {R}\0a            /\\ z \\subseteq 1..c\0a\0aASInit == /\\ x = R\0a          /\\ z = {}\0a\0aASChoose == /\\ Cardinality(z) # c \0a            /\\ \\E n \\in 1..c \\ z : /\\ x\' = n\0a                                   /\\ z\' = z \\cup {n}\0a\0aASRest == /\\ Cardinality(z) = c\0a          /\\ x\' = R\0a          /\\ z\' = {}\0a\0aASNext == ASChoose \\/ ASRest\0a\0aAS == ASInit /\\ [][ASNext]_<<x, z>>\0a\0a=============================================================================\0a']]]
      ['Bug279/InitStateBug' 'InitStateBug' %accept ~[['InitStateBug' '---------------------------- MODULE InitStateBug ----------------------------\0aEXTENDS Naturals\0a\0aRECURSIVE AllSubs(_)\0aAllSubs(S) ==\0a  IF S = {} THEN {{}} ELSE\0a  LET\0a    c  == CHOOSE c \\in S : TRUE\0a    T  == S \\ {c}\0a    TT == AllSubs(T)\0a  IN\0a    TT \\cup { t \\cup {c} : t \\in TT }\0a\0aRECURSIVE Sum(_)\0aSum(S) ==\0a  IF S = {} THEN 0 ELSE\0a  LET c == CHOOSE c \\in S : TRUE\0a  IN c + Sum(S \\ {c})\0a\0aCh(S) == CHOOSE v \\in S : Sum(v) > 4\0a\0aS1 == SUBSET (1..20) \\* Increased from 1..8 to 1..20 to also test performance with this spec.\0aS2 == AllSubs(1..8)\0a\0aVARIABLE pc, set, fun\0a\0aInit == pc = 0 /\\ set = {} /\\ fun = {}\0a\0aNext ==\0a  CASE\0a  pc = 0 -> pc\' = 1 /\\ set\' = S1 /\\ fun\' = Ch(set\')\0a  []\0a  pc = 1 -> pc\' = 2 /\\ set\' = S2 /\\ fun\' = Ch(set\')\0a  []\0a  OTHER -> FALSE\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Wed Mar 07 10:27:18 PST 2012 by tomr\0a\\* Created Wed Mar 07 10:24:35 PST 2012 by tomr\0a']]]
      ['CodePlexBug08/AgentRing' 'AgentRing' %accept ~[['AgentRing' '---------------------------- MODULE AgentRing -----------------------------------\0a(* An agent circulates on a ring of nodes loaded with tasks and performs a load balancing mission.\0a   TLC\'s counterexample to property Test is weird.\0a*)\0aEXTENDS Naturals, FiniteSets\0a\0aCONSTANTS N                   \\* the number of nodes in the ring\0a\0aASSUME N \\in Nat /\\ N > 1     \\* assume at least 2 nodes\0a\0aVARIABLES\0a  Nodes,                      \\* the state of the nodes\0a  Agent,                      \\* the state of the agent\0a  CanCreate                   \\* whether nodes can create tasks\0a\0avars == <<Nodes, \0a          Agent,\0a          CanCreate>>         \\* the state of the system\0a\0aNodeRange == 0 .. N-1         \\* the set of nodes\0a\0aRightNode(i) == (i+1) % N     \\* the node to the right of node i\0aLeftNode(i) == (i-1) % N      \\* the node to the left of node i\0a\0a--------------------------------------------------------------------------------\0a\0aAgentState ==\0a  [ Loc : NodeRange,          \\* where (which node) the agent is\0a    LastLoad : Nat,           \\* the load (number of tasks) of the last node visited\0a    ReadyToMove : BOOLEAN,    \\* whether the agent is ready to move to the next node\0a    Task : 0 .. 1             \\* the number of tasks carried by the agent\0a  ]\0a\0aNodeState ==\0a  [ Load : Nat                \\* the load of this node\0a  ]\0a\0aTypeInv ==\0a  /\\ Nodes \\in [ NodeRange -> NodeState ]\0a  /\\ Agent \\in AgentState\0a  /\\ CanCreate \\in BOOLEAN\0a\0a\0aSumLoad == \0a  LET RECURSIVE Sum(_)\0a      Sum(n) == IF n = N THEN 0 ELSE Nodes[n].Load + Sum(n+1)\0a  IN  Sum(0) + Agent.Task\0a\0aInit == \0a  /\\ Nodes = [ i \\in NodeRange |-> [ Load |-> 0 ] ]\0a  /\\ Agent = [ Loc |-> 0, LastLoad |-> 0, Task |-> 0, ReadyToMove |-> TRUE ]\0a  /\\ CanCreate = TRUE\0a  /\\ TypeInv\0a\0a--------------------------------------------------------------------------------\0a\0aMove ==\0a  /\\ Agent.ReadyToMove\0a  /\\ Agent\' = [ Agent EXCEPT !.Loc = RightNode(@), !.ReadyToMove = FALSE ]\0a  /\\ UNCHANGED <<Nodes, CanCreate>>\0a  \0aLookAndAct ==\0a  /\\ ~Agent.ReadyToMove\0a  /\\ LET Here == Nodes[Agent.Loc].Load\0a         There == Agent.LastLoad\0a     IN  IF Here > There /\\ Agent.Task = 0 \\* pick up one task\0a         THEN /\\ Agent\' = [ Agent EXCEPT !.Task = 1, !.LastLoad = Here - 1, !.ReadyToMove = TRUE ]\0a              /\\ Nodes\' = [ Nodes EXCEPT ![Agent.Loc].Load = @ - 1 ]\0a         ELSE IF Here < There /\\ Agent.Task = 1 \\* drop one task\0a         THEN /\\ Agent\' = [ Agent EXCEPT !.Task = 0, !.LastLoad = Here + 1, !.ReadyToMove = TRUE ]\0a              /\\ Nodes\' = [ Nodes EXCEPT ![Agent.Loc].Load = @ + 1 ]\0a         ELSE \\* do nothing\0a              /\\ Agent\' = [ Agent EXCEPT !.LastLoad = Here, !.ReadyToMove = TRUE ]\0a              /\\ UNCHANGED Nodes\0a  /\\ UNCHANGED CanCreate\0a\0aStop ==\0a  /\\ CanCreate\' = FALSE\0a  /\\ UNCHANGED <<Nodes, Agent>>\0a\0aCreateTasks ==\0a  /\\ CanCreate\0a  /\\ \\E i \\in NodeRange : Nodes\' = [ Nodes EXCEPT ![i].Load = @ + N ]\0a  /\\ UNCHANGED <<Agent, CanCreate>>\0a\0aNext ==\0a  \\/ Move\0a  \\/ LookAndAct\0a  \\/ Stop\0a  \\/ CreateTasks\0a\0aProg == Init /\\ [][Next]_vars /\\ WF_vars(Move) /\\ WF_vars(LookAndAct) /\\ WF_vars(Stop)\0a\0a--------------------------------------------------------------------------------\0a\0aLimits == SumLoad \\leq N * N\0a\0aTest == LBL:: [](~CanCreate /\\ (\\A i,j \\in NodeRange : Nodes[i].Load = Nodes[j].Load) => [](Agent.Task = 0))\0a\0aTest2 == [][~CanCreate /\\ (\\A i,j \\in NodeRange : Nodes[i].Load = Nodes[j].Load) => Agent\'.Task = 0]_vars\0a\0aTestBogus == CanCreate => <>[](~CanCreate)\0a================================================================================']]]
      ['CodePlexBug08/CodeplexBug8' 'CodeplexBug8' %accept ~[['CodeplexBug8' '---------------------------- MODULE CodeplexBug8 ----------------------------\0aEXTENDS Naturals\0a\0aVARIABLES x, b\0a\0aA == /\\ x < 5\0a     /\\ b\0a     /\\ b\' = ~b\0a     /\\ UNCHANGED x\0a\0aB == /\\ ~b\0a     /\\ b\' = ~b\0a     /\\ x\' = x + 1\0a\0aInit == x \\in 0..3 /\\ b \\in BOOLEAN\0a\0aNext == A \\/ B\0a\0aSpec == Init /\\ [][Next]_<<x, b>> /\\ WF_<<x, b>>(Next)\0a\0a--------------------------------------------------------------------------------\0a\0aXshrinks == x=2 ~> x=1\0a\0a================================================================================']]]
      ['CodePlexBug08/EWD840' 'EWD840' %accept ~[['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0a\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]    \\* status of nodes (active or passive)\0a  /\\ color \\in [Nodes -> Color]       \\* color of nodes\0a  /\\ tpos \\in Nodes                   \\* token position\0a  /\\ tcolor \\in Color                 \\* token color\0a\0a(* Initially the token is black. The other variables may take\0a   any "type-correct" values. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor = "black"\0a\0a(* Node 0 may initiate a probe when it has the token and\0a   when either it is black or the token is black. It passes\0a   a white token to node N-1 and paints itself white. *)\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ active\' = active\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a\0a(* A node i different from 0 that possesses the token may pass\0a   it to node i-1 under the following circumstances:\0a   - node i is inactive or\0a   - node i is colored black or\0a   - the token is black.\0a   Note that the last two conditions will result in an\0a   inconclusive round, since the token will be black.\0a   The token will be stained if node i is black, otherwise \0a   its color is unchanged. Node i will be made white. *)\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i] \\/ color[i] = "black" \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ active\' = active\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a\0a(* token passing actions controlled by the termination detection algorithm *)\0aSystem == InitiateProbe \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0a(* An active node i may activate another node j by sending it\0a   a message. If j>i (hence activation goes against the direction\0a   of the token being passed), then node i becomes black. *)\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0a(* Any active node may become inactive at any moment. *)\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0a(* actions performed by the underlying algorithm *)\0aEnvironment == \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0a(* next-state relation: disjunction of above actions *)\0aNext == System \\/ Environment\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aSpec == Init /\\ [][Next]_vars /\\ WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Non-properties that can be used for validating the specification.       *)\0a(***************************************************************************)\0aTokenAlwaysBlack == tcolor = "black"\0a\0aNeverChangeColor == [][ UNCHANGED color ]_vars\0a\0a(***************************************************************************)\0a(* Main safety property: if there is a white token at node 0 then every    *)\0a(* node is inactive.                                                       *)\0a(***************************************************************************)\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0a(***************************************************************************)\0a(* Liveness property: termination is eventually detected.                  *)\0a(***************************************************************************)\0aLiveness ==\0a  (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0a(***************************************************************************)\0a(* The following property asserts that when every process always           *)\0a(* eventually terminates then eventually termination will be detected.     *)\0a(* It does not hold since processes can wake up each other.                *)\0a(***************************************************************************)\0aFalseLiveness ==\0a  \\* in this version TLC displays a valid counter-example, however\0a  \\* it prints "back to state 1" below the initial state instead of\0a  \\* below the last state of the finite trace prefix\0a  (\\A i \\in Nodes : []<> ~ active[i]) ~> terminationDetected\0a\0aFalseLiveness2 ==\0a  \\* in this version TLC displays a counter-example that ends in\0a  \\* infinite stuttering, which is invalid since the fairness\0a  \\* property of the spec is not respected\0a  (\\A i \\in Nodes : (active[i] ~> ~ active[i])) ~> terminationDetected\0a\0a\\* This is an alternative way to express the same property: the fairness\0a\\* condition must be added to the spec since TLC doesn\'t allow WF formulas\0a\\* appearing in the property. It returns the same counter-example as the\0a\\* first variant, with the same output problem.\0aSpec2 == Spec /\\ \\A i \\in Nodes : WF_vars(Deactivate(i))\0aFalseLiveness3 == <>terminationDetected\0a\0a(***************************************************************************)\0a(* The following property says that eventually all nodes will terminate    *)\0a(* assuming that from some point onwards no messages are sent. It is       *)\0a(* undesired, but verified for the fairness condition WF_vars(Next).       *)\0a(***************************************************************************)\0aSpec3 == Init /\\ [][Next]_vars /\\ WF_vars(Next)\0aAllNodesTerminateIfNoMessages ==\0a  ~[]<><< \\E i \\in Nodes : SendMsg(i) >>_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0a(***************************************************************************)\0a(* Dijkstra\'s inductive invariant                                          *)\0a(***************************************************************************)\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a(***************************************************************************)\0a(* Use the following specification to check that the predicate             *)\0a(* TypeOK /\\ Inv is inductive for EWD 840: verify that it is an            *)\0a(* (ordinary) invariant of a specification obtained by replacing the       *)\0a(* initial condition by that conjunction.                                  *)\0a(***************************************************************************)\0aCheckInductiveSpec == TypeOK /\\ Inv /\\ [][Next]_vars\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Thu Apr 02 10:49:59 CEST 2015 by markus\0a\\* Last modified Thu Apr 02 09:30:10 CEST 2015 by merz\0a\\* Created Mon Sep 09 11:33:10 CEST 2013 by merz']]]
      ['CodePlexBug08/EWD840MC2' 'EWD840MC2' %accept ~[['EWD840MC2' '---- MODULE EWD840MC2 ----\0aEXTENDS EWD840, TLC\0a\0aconst_123 == 4\0a\0aTautology == (vars = vars) ~> (vars = vars)\0a==================='] ['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0a\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]    \\* status of nodes (active or passive)\0a  /\\ color \\in [Nodes -> Color]       \\* color of nodes\0a  /\\ tpos \\in Nodes                   \\* token position\0a  /\\ tcolor \\in Color                 \\* token color\0a\0a(* Initially the token is black. The other variables may take\0a   any "type-correct" values. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor = "black"\0a\0a(* Node 0 may initiate a probe when it has the token and\0a   when either it is black or the token is black. It passes\0a   a white token to node N-1 and paints itself white. *)\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ active\' = active\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a\0a(* A node i different from 0 that possesses the token may pass\0a   it to node i-1 under the following circumstances:\0a   - node i is inactive or\0a   - node i is colored black or\0a   - the token is black.\0a   Note that the last two conditions will result in an\0a   inconclusive round, since the token will be black.\0a   The token will be stained if node i is black, otherwise \0a   its color is unchanged. Node i will be made white. *)\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i] \\/ color[i] = "black" \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ active\' = active\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a\0a(* token passing actions controlled by the termination detection algorithm *)\0aSystem == InitiateProbe \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0a(* An active node i may activate another node j by sending it\0a   a message. If j>i (hence activation goes against the direction\0a   of the token being passed), then node i becomes black. *)\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0a(* Any active node may become inactive at any moment. *)\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0a(* actions performed by the underlying algorithm *)\0aEnvironment == \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0a(* next-state relation: disjunction of above actions *)\0aNext == System \\/ Environment\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aSpec == Init /\\ [][Next]_vars /\\ WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Non-properties that can be used for validating the specification.       *)\0a(***************************************************************************)\0aTokenAlwaysBlack == tcolor = "black"\0a\0aNeverChangeColor == [][ UNCHANGED color ]_vars\0a\0a(***************************************************************************)\0a(* Main safety property: if there is a white token at node 0 then every    *)\0a(* node is inactive.                                                       *)\0a(***************************************************************************)\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0a(***************************************************************************)\0a(* Liveness property: termination is eventually detected.                  *)\0a(***************************************************************************)\0aLiveness ==\0a  (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0a(***************************************************************************)\0a(* The following property asserts that when every process always           *)\0a(* eventually terminates then eventually termination will be detected.     *)\0a(* It does not hold since processes can wake up each other.                *)\0a(***************************************************************************)\0aFalseLiveness ==\0a  \\* in this version TLC displays a valid counter-example, however\0a  \\* it prints "back to state 1" below the initial state instead of\0a  \\* below the last state of the finite trace prefix\0a  (\\A i \\in Nodes : []<> ~ active[i]) ~> terminationDetected\0a\0aFalseLiveness2 ==\0a  \\* in this version TLC displays a counter-example that ends in\0a  \\* infinite stuttering, which is invalid since the fairness\0a  \\* property of the spec is not respected\0a  (\\A i \\in Nodes : (active[i] ~> ~ active[i])) ~> terminationDetected\0a\0a\\* This is an alternative way to express the same property: the fairness\0a\\* condition must be added to the spec since TLC doesn\'t allow WF formulas\0a\\* appearing in the property. It returns the same counter-example as the\0a\\* first variant, with the same output problem.\0aSpec2 == Spec /\\ \\A i \\in Nodes : WF_vars(Deactivate(i))\0aFalseLiveness3 == <>terminationDetected\0a\0a(***************************************************************************)\0a(* The following property says that eventually all nodes will terminate    *)\0a(* assuming that from some point onwards no messages are sent. It is       *)\0a(* undesired, but verified for the fairness condition WF_vars(Next).       *)\0a(***************************************************************************)\0aSpec3 == Init /\\ [][Next]_vars /\\ WF_vars(Next)\0aAllNodesTerminateIfNoMessages ==\0a  ~[]<><< \\E i \\in Nodes : SendMsg(i) >>_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0a(***************************************************************************)\0a(* Dijkstra\'s inductive invariant                                          *)\0a(***************************************************************************)\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a(***************************************************************************)\0a(* Use the following specification to check that the predicate             *)\0a(* TypeOK /\\ Inv is inductive for EWD 840: verify that it is an            *)\0a(* (ordinary) invariant of a specification obtained by replacing the       *)\0a(* initial condition by that conjunction.                                  *)\0a(***************************************************************************)\0aCheckInductiveSpec == TypeOK /\\ Inv /\\ [][Next]_vars\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Thu Apr 02 10:49:59 CEST 2015 by markus\0a\\* Last modified Thu Apr 02 09:30:10 CEST 2015 by merz\0a\\* Created Mon Sep 09 11:33:10 CEST 2013 by merz']]]
      ['CodePlexBug08/EWD840MC3' 'EWD840MC3' %accept ~[['EWD840MC3' '---- MODULE EWD840MC3 ----\0aEXTENDS EWD840, TLC\0a\0aconst_123 == 4\0a==================='] ['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0a\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]    \\* status of nodes (active or passive)\0a  /\\ color \\in [Nodes -> Color]       \\* color of nodes\0a  /\\ tpos \\in Nodes                   \\* token position\0a  /\\ tcolor \\in Color                 \\* token color\0a\0a(* Initially the token is black. The other variables may take\0a   any "type-correct" values. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor = "black"\0a\0a(* Node 0 may initiate a probe when it has the token and\0a   when either it is black or the token is black. It passes\0a   a white token to node N-1 and paints itself white. *)\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ active\' = active\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a\0a(* A node i different from 0 that possesses the token may pass\0a   it to node i-1 under the following circumstances:\0a   - node i is inactive or\0a   - node i is colored black or\0a   - the token is black.\0a   Note that the last two conditions will result in an\0a   inconclusive round, since the token will be black.\0a   The token will be stained if node i is black, otherwise \0a   its color is unchanged. Node i will be made white. *)\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i] \\/ color[i] = "black" \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ active\' = active\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a\0a(* token passing actions controlled by the termination detection algorithm *)\0aSystem == InitiateProbe \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0a(* An active node i may activate another node j by sending it\0a   a message. If j>i (hence activation goes against the direction\0a   of the token being passed), then node i becomes black. *)\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0a(* Any active node may become inactive at any moment. *)\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0a(* actions performed by the underlying algorithm *)\0aEnvironment == \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0a(* next-state relation: disjunction of above actions *)\0aNext == System \\/ Environment\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aSpec == Init /\\ [][Next]_vars /\\ WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Non-properties that can be used for validating the specification.       *)\0a(***************************************************************************)\0aTokenAlwaysBlack == tcolor = "black"\0a\0aNeverChangeColor == [][ UNCHANGED color ]_vars\0a\0a(***************************************************************************)\0a(* Main safety property: if there is a white token at node 0 then every    *)\0a(* node is inactive.                                                       *)\0a(***************************************************************************)\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0a(***************************************************************************)\0a(* Liveness property: termination is eventually detected.                  *)\0a(***************************************************************************)\0aLiveness ==\0a  (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0a(***************************************************************************)\0a(* The following property asserts that when every process always           *)\0a(* eventually terminates then eventually termination will be detected.     *)\0a(* It does not hold since processes can wake up each other.                *)\0a(***************************************************************************)\0aFalseLiveness ==\0a  \\* in this version TLC displays a valid counter-example, however\0a  \\* it prints "back to state 1" below the initial state instead of\0a  \\* below the last state of the finite trace prefix\0a  (\\A i \\in Nodes : []<> ~ active[i]) ~> terminationDetected\0a\0aFalseLiveness2 ==\0a  \\* in this version TLC displays a counter-example that ends in\0a  \\* infinite stuttering, which is invalid since the fairness\0a  \\* property of the spec is not respected\0a  (\\A i \\in Nodes : (active[i] ~> ~ active[i])) ~> terminationDetected\0a\0a\\* This is an alternative way to express the same property: the fairness\0a\\* condition must be added to the spec since TLC doesn\'t allow WF formulas\0a\\* appearing in the property. It returns the same counter-example as the\0a\\* first variant, with the same output problem.\0aSpec2 == Spec /\\ \\A i \\in Nodes : WF_vars(Deactivate(i))\0aFalseLiveness3 == <>terminationDetected\0a\0a(***************************************************************************)\0a(* The following property says that eventually all nodes will terminate    *)\0a(* assuming that from some point onwards no messages are sent. It is       *)\0a(* undesired, but verified for the fairness condition WF_vars(Next).       *)\0a(***************************************************************************)\0aSpec3 == Init /\\ [][Next]_vars /\\ WF_vars(Next)\0aAllNodesTerminateIfNoMessages ==\0a  ~[]<><< \\E i \\in Nodes : SendMsg(i) >>_vars\0a  => <>(\\A i \\in Nodes : ~ active[i])\0a\0a(***************************************************************************)\0a(* Dijkstra\'s inductive invariant                                          *)\0a(***************************************************************************)\0aInv == \0a  \\/ P0:: \\A i \\in Nodes : tpos < i => ~ active[i]\0a  \\/ P1:: \\E j \\in 0 .. tpos : color[j] = "black"\0a  \\/ P2:: tcolor = "black"\0a\0a(***************************************************************************)\0a(* Use the following specification to check that the predicate             *)\0a(* TypeOK /\\ Inv is inductive for EWD 840: verify that it is an            *)\0a(* (ordinary) invariant of a specification obtained by replacing the       *)\0a(* initial condition by that conjunction.                                  *)\0a(***************************************************************************)\0aCheckInductiveSpec == TypeOK /\\ Inv /\\ [][Next]_vars\0a=============================================================================\0a\\* Modification History\0a\\* Last modified Thu Apr 02 10:49:59 CEST 2015 by markus\0a\\* Last modified Thu Apr 02 09:30:10 CEST 2015 by merz\0a\\* Created Mon Sep 09 11:33:10 CEST 2013 by merz']]]
      ['CodePlexBug08/EWD840MC4' 'EWD840MC4' %accept ~[['EWD840MC4' '---- MODULE EWD840MC4 ----\0aEXTENDS EWD840, TLC\0a\0aconst_123 == 4\0a\0aneg_AllNodesTerminateIfNoMessages == ~AllNodesTerminateIfNoMessages\0a\0aTautology == (vars = vars) ~> (vars = vars)\0a==================='] ['EWD840' '------------------------------- MODULE EWD840 -------------------------------\0aEXTENDS Naturals\0a\0aCONSTANT N\0aASSUME NAssumption == N \\in Nat \\ {0}\0a\0aVARIABLES active, color, tpos, tcolor\0a\0aNodes == 0 .. N-1\0aColor == {"white", "black"}\0a\0aTypeOK ==\0a  /\\ active \\in [Nodes -> BOOLEAN]    \\* status of nodes (active or passive)\0a  /\\ color \\in [Nodes -> Color]       \\* color of nodes\0a  /\\ tpos \\in Nodes                   \\* token position\0a  /\\ tcolor \\in Color                 \\* token color\0a\0a(* Initially the token is black. The other variables may take\0a   any "type-correct" values. *)\0aInit ==\0a  /\\ active \\in [Nodes -> BOOLEAN]\0a  /\\ color \\in [Nodes -> Color]\0a  /\\ tpos \\in Nodes\0a  /\\ tcolor = "black"\0a\0a(* Node 0 may initiate a probe when it has the token and\0a   when either it is black or the token is black. It passes\0a   a white token to node N-1 and paints itself white. *)\0aInitiateProbe ==\0a  /\\ tpos = 0\0a  /\\ tcolor = "black" \\/ color[0] = "black"\0a  /\\ tpos\' = N-1\0a  /\\ tcolor\' = "white"\0a  /\\ active\' = active\0a  /\\ color\' = [color EXCEPT ![0] = "white"]\0a\0a(* A node i different from 0 that possesses the token may pass\0a   it to node i-1 under the following circumstances:\0a   - node i is inactive or\0a   - node i is colored black or\0a   - the token is black.\0a   Note that the last two conditions will result in an\0a   inconclusive round, since the token will be black.\0a   The token will be stained if node i is black, otherwise \0a   its color is unchanged. Node i will be made white. *)\0aPassToken(i) == \0a  /\\ tpos = i\0a  /\\ ~ active[i] \\/ color[i] = "black" \\/ tcolor = "black"\0a  /\\ tpos\' = i-1\0a  /\\ tcolor\' = IF color[i] = "black" THEN "black" ELSE tcolor\0a  /\\ active\' = active\0a  /\\ color\' = [color EXCEPT ![i] = "white"]\0a\0a(* token passing actions controlled by the termination detection algorithm *)\0aSystem == InitiateProbe \\/ \\E i \\in Nodes \\ {0} : PassToken(i)\0a\0a(* An active node i may activate another node j by sending it\0a   a message. If j>i (hence activation goes against the direction\0a   of the token being passed), then node i becomes black. *)\0aSendMsg(i) ==\0a  /\\ active[i]\0a  /\\ \\E j \\in Nodes \\ {i} :\0a        /\\ active\' = [active EXCEPT ![j] = TRUE]\0a        /\\ color\' = [color EXCEPT ![i] = IF j>i THEN "black" ELSE @]\0a  /\\ UNCHANGED <<tpos, tcolor>>\0a\0a(* Any active node may become inactive at any moment. *)\0aDeactivate(i) ==\0a  /\\ active[i]\0a  /\\ active\' = [active EXCEPT ![i] = FALSE]\0a  /\\ UNCHANGED <<color, tpos, tcolor>>\0a\0a(* actions performed by the underlying algorithm *)\0aEnvironment == \\E i \\in Nodes : SendMsg(i) \\/ Deactivate(i)\0a\0a(* next-state relation: disjunction of above actions *)\0aNext == System \\/ Environment\0a\0avars == <<active, color, tpos, tcolor>>\0a\0aSpec == Init /\\ [][Next]_vars /\\ WF_vars(System)\0a\0a-----------------------------------------------------------------------------\0a\0a(***************************************************************************)\0a(* Non-properties that can be used for validating the specification.       *)\0a(***************************************************************************)\0aTokenAlwaysBlack == tcolor = "black"\0a\0aNeverChangeColor == [][ UNCHANGED color ]_vars\0a\0a(***************************************************************************)\0a(* Main safety property: if there is a white token at node 0 then every    *)\0a(* node is inactive.                                                       *)\0a(***************************************************************************)\0aterminationDetected ==\0a  /\\ tpos = 0 /\\ tcolor = "white"\0a  /\\ color[0] = "white" /\\ ~ active[0]\0a\0aTerminationDetection ==\0a  terminationDetected => \\A i \\in Nodes : ~ active[i]\0a\0a(***************************************************************************)\0a(* Liveness property: termination is eventually detected.                  *)\0a(***************************************************************************)\0aLiveness ==\0a  (\\A i \\in Nodes : ~ active[i]) ~> terminationDetected\0a\0a(***************************************************************************)\0a(* The following property asserts that when every process always           *)\0a(* eventually terminates then eventually termination will be detected.     *)\0a(* It does not hold since processes can wake up each other.                *)\0a(***************************************************************************)\0aFalseLiveness ==\0a  \\* in this version TLC displays a valid counter-example, however\0a  \\* it prints "back to state 1" below the initial state instead of\0a  \\* below the last state of the finite trace prefix\0a  (\\A i \\in Nodes : []<> ~ active[i]) ~> terminationDetected\0a\0aFalseLiveness2 ==\0a  \\* in this version TLC displays a counter-example that ends in\0a  \\* infinite stuttering, which is invalid since the fairness\0a  \\* property of the spec is not respected\0a  (\\A i \\in Nodes : (active[i] ~> ~ active[i])) ~> terminationDetected\0a\0a\\* This is an alternative way to express the same property: the fairness\0a\\* condition must be added to the spec since TLC doesn\'t allow WF formulas\0a\\* appearing in the property. It returns the same counter-example as the\0a\\* first variant, with the same output problem.\0aSpec2 == Spec /\\ \\A i \\in Nodes : WF_vars(Deactivate(i))\0aFalseLiveness3 == <>terminationDetected\0a\0a(***************************************************************************)\0a(* The following property says that eventually all nodes will terminate   