::  Symmetry reduction (Work Unit 7.5): a state's identity is its orbit
::  representative under the permutation group named by SYMMETRY, so symmetric
::  states collapse to one distinct state. Symmetry with a temporal property is
::  an unsafe combination TLC rejects. Driven through run-check:check (no value
::  crosses the low-budget test core). cfg cords are single-quoted so the `{`
::  of a model-value set is literal (double quotes would interpolate).
/+  *test
/=  check  /lib/check
|%
++  spec
  ^-  @t
  %-  crip
  ;:  weld
    "---- MODULE A ----\0a"
    "EXTENDS Naturals, TLC\0a"
    "CONSTANT P\0a"
    "VARIABLE x\0a"
    "Init == \\E p \\in P : x = p\0a"
    "Next == \\E p \\in P : x' = p\0a"
    "Perms == Permutations(P)\0a"
    "Inv == TRUE\0a"
    "====\0a"
  ==
++  spec-prop
  ^-  @t
  %-  crip
  ;:  weld
    "---- MODULE A ----\0a"
    "EXTENDS Naturals, TLC\0a"
    "CONSTANT P\0a"
    "VARIABLE x\0a"
    "Init == \\E p \\in P : x = p\0a"
    "Next == \\E p \\in P : x' = p\0a"
    "Perms == Permutations(P)\0a"
    "Inv == TRUE\0a"
    "Prop == []Inv\0a"
    "====\0a"
  ==
++  cfg
  ^-  @t
  'CONSTANT P = {a, b}\0aSYMMETRY Perms\0aINIT Init\0aNEXT Next\0aINVARIANT Inv\0a'
++  cfg-prop
  ^-  @t
  'CONSTANT P = {a, b}\0aSYMMETRY Perms\0aINIT Init\0aNEXT Next\0aPROPERTY Prop\0a'
::
::  the two initial states x=a and x=b are one orbit under Permutations({a,b}),
::  so the search finds a single distinct state (TLC reports distinct = 1)
++  test-symmetry-reduced
  =/  r  ^-(result:check -:(run-check:check spec cfg 0))
  %+  expect-eq
    !>  [%.y `@ud`1]
  !>  ?:(?=([%ok *] r) [%.y distinct.stats.r] [%.n 0])
::
::  R2.7.5: symmetry alongside a PROPERTY no longer rejects. `Prop == []Inv` is
::  a BOX-STATE property, folded into the invariant vector by
::  `processConfigProps`, so it never reaches the liveness checker and tlc2
::  prints no 2279 warning for it either -- measured: no warning, `ok`, 1
::  distinct, the same orbit reduction the invariant-only case gets
++  test-symmetry-box-property-runs
  =/  r  ^-(result:check -:(run-check:check spec-prop cfg-prop 0))
  %+  expect-eq
    !>  [%.y `@ud`1]
  !>  ?:(?=([%ok *] r) [%.y distinct.stats.r] [%.n 0])
::
::  a UNION of Permutations over two disjoint model-value sets (R1.5.6). The
::  four states (x,y) with x in {a,b}, y in {c,d} collapse to ONE orbit under
::  the group GENERATED by Permutations(P) \union Permutations(Q) — tlc2 builds
::  the cross product of the two symmetry sets (distinct = 1); the port reaches
::  the same representative by iterating the union to a fixpoint (+canonicalize)
++  spec-union
  ^-  @t
  %-  crip
  ;:  weld
    "---- MODULE A ----\0a"
    "EXTENDS TLC\0a"
    "CONSTANTS P, Q\0a"
    "VARIABLES x, y\0a"
    "Init == (\\E p \\in P : x = p) /\\ (\\E q \\in Q : y = q)\0a"
    "Next == UNCHANGED <<x, y>>\0a"
    "Perms == Permutations(P) \\union Permutations(Q)\0a"
    "Inv == TRUE\0a"
    "====\0a"
  ==
++  cfg-union
  ^-  @t
  'CONSTANT P = {a, b}\0aCONSTANT Q = {c, d}\0aSYMMETRY Perms\0aINIT Init\0aNEXT Next\0aINVARIANT Inv\0a'
++  test-symmetry-union
  =/  r  ^-(result:check -:(run-check:check spec-union cfg-union 0))
  %+  expect-eq
    !>  [%.y `@ud`1]
  !>  ?:(?=([%ok *] r) [%.y distinct.stats.r] [%.n 0])
--
